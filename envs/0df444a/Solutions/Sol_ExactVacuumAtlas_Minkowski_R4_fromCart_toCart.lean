open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Minkowski
open ExactVacuumAtlas
open ExactVacuumAtlas.Minkowski
open ExactVacuumAtlas.Minkowski.R4
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
theorem solution {x : Pt 4} (hx : x ∈ domChart) : fromCart (toCart x) = x := by
  obtain ⟨hr, hθ1, hθ2, hφ1, hφ2⟩ := hx
  have hs : 0 < sin (x 2) := sin_pos_of_pos_of_lt_pi hθ1 hθ2
  have hR : 0 < x 1 * sin (x 2) := mul_pos hr hs
  have hpθ := sin_sq_add_cos_sq (x 2)
  have hpφ := sin_sq_add_cos_sq (x 3)
  -- the two radii
  have e3 : (x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      + (x 1 * cos (x 2)) ^ 2 = x 1 ^ 2 := by
    linear_combination (x 1) ^ 2 * sin (x 2) ^ 2 * hpφ + (x 1) ^ 2 * hpθ
  have e2 : (x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      = (x 1 * sin (x 2)) ^ 2 := by
    linear_combination (x 1 * sin (x 2)) ^ 2 * hpφ
  have hρ3 : √((x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      + (x 1 * cos (x 2)) ^ 2) = x 1 := by
    rw [e3]; exact Real.sqrt_sq hr.le
  have hρ2 : √((x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2)
      = x 1 * sin (x 2) := by
    rw [e2]; exact Real.sqrt_sq hR.le
  -- half-angle data
  have hc1 : cos (x 3) ≠ 1 := by
    intro h
    have := (Real.cos_eq_one_iff_of_lt_of_lt (by linarith) hφ2).mp h
    linarith
  have hsh : 0 < sin (x 3 / 2) := sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
  have hsin : sin (x 3) = 2 * sin (x 3 / 2) * cos (x 3 / 2) := by
    rw [← Real.sin_two_mul]; ring_nf
  have hcos : cos (x 3) = 2 * cos (x 3 / 2) ^ 2 - 1 := by
    rw [← Real.cos_two_mul]; ring_nf
  have hph := sin_sq_add_cos_sq (x 3 / 2)
  have hden : x 1 * sin (x 2) - x 1 * sin (x 2) * cos (x 3) ≠ 0 := by
    have : x 1 * sin (x 2) - x 1 * sin (x 2) * cos (x 3) = x 1 * sin (x 2) * (1 - cos (x 3)) := by
      ring
    rw [this]
    exact mul_ne_zero hR.ne' (sub_ne_zero.mpr hc1.symm)
  have hw : -(x 1 * sin (x 2) * sin (x 3)) / (x 1 * sin (x 2) - x 1 * sin (x 2) * cos (x 3))
      = tan (x 3 / 2 - π / 2) := by
    rw [Real.tan_eq_sin_div_cos, Real.sin_sub_pi_div_two, Real.cos_sub_pi_div_two,
      div_eq_div_iff hden hsh.ne', hsin, hcos]
    linear_combination (-2 * (x 1 * sin (x 2)) * cos (x 3 / 2)) * hph
  funext i
  fin_cases i
  · rfl
  · show √((x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      + (x 1 * cos (x 2)) ^ 2) = x 1
    exact hρ3
  · show arccos (x 1 * cos (x 2) / √((x 1 * sin (x 2) * cos (x 3)) ^ 2
      + (x 1 * sin (x 2) * sin (x 3)) ^ 2 + (x 1 * cos (x 2)) ^ 2)) = x 2
    rw [hρ3, mul_div_cancel_left₀ _ hr.ne']
    exact Real.arccos_cos hθ1.le hθ2.le
  · show π + 2 * arctan (-(x 1 * sin (x 2) * sin (x 3)) /
      (√((x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2)
        - x 1 * sin (x 2) * cos (x 3))) = x 3
    rw [hρ2, hw, Real.arctan_tan (by linarith) (by linarith)]
    ring
