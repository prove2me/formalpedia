-- Source module: NLogN.Zip
/-!
# A generic two-input bit transducer with carry

`zip q a b d e keep f fin` runs least-significant-bit first over the words on top of `a` and `b`
(a missing bit reads as `0`), with a one-bit carry `c`.  At each position it pushes the output
bit of `f x y c` on `d` and continues with the new carry; the bits of `b` are copied onto `e`
when `keep`.  When both words are exhausted it pushes the symbols `fin c` on `d`.
Addition, subtraction, negation and copying are instances.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

@[simp] theorem decide_codeBit_eq_one (c : Bool) : decide (codeBit c = 1) = c := by
  cases c <;> decide

theorem zipδ_length (q a b d e : Fin S) (keep f) (fin : Bool → List Sym) (B : ℕ)
    (hB : ∀ c, (fin c).length ≤ B) (os) : (zipδ q a b d e keep f fin os).length ≤ B + 6 := by
  unfold zipδ; split
  · rename_i c ta tb
    by_cases h : bitOf ta = none ∧ bitOf tb = none
    · rw [if_pos h]; have := hB (decide (c = 1)); simp; omega
    · rw [if_neg h]
      simp only [List.length_append]
      cases (bitOf ta).isSome <;> cases (bitOf tb).isSome <;> cases keep <;> simp
  · simp

theorem runOps_append (l₁ l₂ : List (Op S)) (σ : St S) :
    runOps I (l₁ ++ l₂) σ = runOps I l₂ (runOps I l₁ σ) := by
  induction l₁ generalizing σ with
  | nil => rfl
  | cons o l ih => simp [runOps, ih]

section
variable {q a b d e : Fin S} (hqa : q ≠ a) (hqb : q ≠ b) (hqd : q ≠ d) (hqe : q ≠ e)
  (hab : a ≠ b) (had : a ≠ d) (hae : a ≠ e) (hbd : b ≠ d) (hbe : b ≠ e) (hde : d ≠ e)
  (keep : Bool) (f : Bool → Bool → Bool → Bool × Bool) (fin : Bool → List Sym)
  (ra rb Q : List Sym) (hra : bitOf ra.head? = none) (hrb : bitOf rb.head? = none)

theorem runOps_push_d (σ : St S) (l : List Sym) :
    runOps I (l.map (Op.push d)) σ = σ.set d (l.reverse ++ σ.stk d) := by
  induction l generalizing σ with
  | nil => simp [runOps]
  | cons s l ih =>
    simp only [List.map_cons, runOps, Op.run, ih]
    rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
    simp only [St.set_stk, St.push_stk]; split_ifs <;> simp

include hqa hqb hqd hqe hab had hae hbd hbe hde hra hrb in
theorem zip_reaches (σ : St S) : ∀ (A B : List Bool) (c : Bool) (D E : List Sym),
    Reaches I q [a, b] (zipδ q a b d e keep f fin)
      (zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ (codeBit c) A B D E)
      (zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ hlt [] []
        (pushAll (fin (zipL f c A B).2) (((zipL f c A B).1.map codeBit).reverse ++ D))
        (if keep then (B.map codeBit).reverse ++ E else E))
      (max A.length B.length + 1) := by
  have hqa' := Ne.symm hqa; have hqb' := Ne.symm hqb; have hqd' := Ne.symm hqd
  have hqe' := Ne.symm hqe; have hab' := Ne.symm hab; have had' := Ne.symm had
  have hae' := Ne.symm hae; have hbd' := Ne.symm hbd; have hbe' := Ne.symm hbe
  have hde' := Ne.symm hde
  have htop : ∀ (c : Bool) A B D E, (zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q
      σ (codeBit c) A B D E).top q ≠ some hlt := by
    intro c A B D E
    simp only [zipCfg, St.top_set_same, List.head?_cons, ne_eq, Option.some.injEq]
    exact codeBit_ne_hlt c
  have htops : ∀ (c : Sym) A B D E, (zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q
      σ c A B D E).tops [q, a, b] = [some c, (A.map codeBit ++ ra).head?,
        (B.map codeBit ++ rb).head?] := by
    intro c A B D E
    simp only [St.tops, zipCfg, List.map_cons, List.map_nil, St.top_set, hqa, hqb, hqd, hqe, hab,
      had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde',
      if_true, if_false, List.head?_cons]
  intro A
  induction A with
  | nil =>
    intro B
    induction B with
    | nil =>
      intro c D E
      refine Reaches.step' (htop c [] [] D E) ?_ (Reaches.refl _)
      rw [mstep, htops]
      simp only [List.map_nil, List.nil_append]
      rw [zipδ, if_pos ⟨hra, hrb⟩]
      simp only [runOps_append, decide_codeBit_eq_one, runOps_push_d]
      cases keep <;> simp only [zipL, runOps, Op.run, zipCfg, pushAll, St.push_set_ne, St.pop_set_ne,
        St.pop_set_same, St.push_set_same, List.tail_cons, List.map_nil, List.reverse_nil,
        List.nil_append, if_false, if_true, Bool.false_eq_true] <;>
        rw [St.ext_iff'] <;> refine ⟨fun j => ?_, rfl, rfl⟩ <;> simp only [St.set_stk] <;>
        split_ifs <;> simp_all [St.pop_set_ne, St.push_set_ne, hqa, hqb, hqd, hqe, hab, had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde']
    | cons y B ih =>
      intro c D E
      refine Reaches.step' (σ₁ := zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ
        (codeBit (f false y c).2) [] B (codeBit (f false y c).1 :: D)
        (if keep then codeBit y :: E else E)) (htop c [] (y :: B) D E) ?_ ?_
      · rw [mstep, htops]
        simp only [List.map_nil, List.nil_append, List.map_cons, List.cons_append,
          List.head?_cons]
        rw [zipδ, if_neg (by simp)]
        cases keep <;> simp [runOps, Op.run, zipCfg, St.push_set_ne, St.pop_set_ne, hra,
          hqa, hqb, hqd, hqe, hab, had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde']
      · have := ih (f false y c).2 (codeBit (f false y c).1 :: D)
          (if keep then codeBit y :: E else E)
        cases keep <;> simpa [zipL] using this
  | cons x A ih =>
    intro B
    cases B with
    | nil =>
      intro c D E
      refine Reaches.step' (σ₁ := zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ
        (codeBit (f x false c).2) A [] (codeBit (f x false c).1 :: D) E)
        (htop c (x :: A) [] D E) ?_ ?_
      · rw [mstep, htops]
        simp only [List.map_nil, List.nil_append, List.map_cons, List.cons_append,
          List.head?_cons]
        rw [zipδ, if_neg (by simp)]
        simp [runOps, Op.run, zipCfg, St.push_set_ne, St.pop_set_ne, hrb, hqa, hqb, hqd, hqe, hab, had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde']
      · have := ih [] (f x false c).2 (codeBit (f x false c).1 :: D) E
        cases keep <;> simpa [zipL] using this
    | cons y B =>
      intro c D E
      refine Reaches.step' (σ₁ := zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ
        (codeBit (f x y c).2) A B (codeBit (f x y c).1 :: D)
        (if keep then codeBit y :: E else E)) (htop c (x :: A) (y :: B) D E) ?_ ?_
      · rw [mstep, htops]
        simp only [List.map_cons, List.cons_append, List.head?_cons]
        rw [zipδ, if_neg (by simp)]
        cases keep <;> simp [runOps, Op.run, zipCfg, St.push_set_ne, St.pop_set_ne,
          hqa, hqb, hqd, hqe, hab, had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde']
      · have := ih B (f x y c).2 (codeBit (f x y c).1 :: D)
          (if keep then codeBit y :: E else E)
        cases keep <;> simpa [zipL, Nat.succ_max_succ] using this

include hqa hqb hqd hqe hab had hae hbd hbe hde hra hrb in
theorem Runs.zip (B : ℕ) (hB : ∀ c, (fin c).length ≤ B) (σ : St S) (A Bw : List Bool) (c : Bool)
    (hA : σ.stk a = A.map codeBit ++ ra) (hBw : σ.stk b = Bw.map codeBit ++ rb) :
    Runs I prog (NLogN.zip q a b d e keep f fin c : Stmt S P) σ
      ((((σ.set a ra).set b rb).set d
        (pushAll (fin (zipL f c A Bw).2) (((zipL f c A Bw).1.map codeBit).reverse ++ σ.stk d))).set e
        (if keep then (Bw.map codeBit).reverse ++ σ.stk e else σ.stk e))
      (zipCost B (max A.length Bw.length)) := by
  have h := zip_reaches (I := I) hqa hqb hqd hqe hab had hae hbd hbe hde keep f fin ra rb (σ.stk q)
    hra hrb σ A Bw c (σ.stk d) (σ.stk e)
  have e0 : σ.push q (codeBit c) = zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb
      (σ.stk q) σ (codeBit c) A Bw (σ.stk d) (σ.stk e) := by
    simp only [zipCfg, ← hA, ← hBw, St.set_self, St.push_eq_set]
  rw [← e0] at h
  have := Runs.machine_reach (prog := prog) (B + 6) (zipδ_length q a b d e keep f fin B hB) σ _ _ h
    (by simp [zipCfg, St.top_set_same])
  have e1 : (zipCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb (σ.stk q) σ hlt [] []
      (pushAll (fin (zipL f c A Bw).2) (((zipL f c A Bw).1.map codeBit).reverse ++ σ.stk d))
      (if keep then (Bw.map codeBit).reverse ++ σ.stk e else σ.stk e)).pop q =
      ((((σ.set a ra).set b rb).set d
        (pushAll (fin (zipL f c A Bw).2) (((zipL f c A Bw).1.map codeBit).reverse ++ σ.stk d))).set e
        (if keep then (Bw.map codeBit).reverse ++ σ.stk e else σ.stk e)) := by
    simp only [zipCfg, St.pop_set_same, List.tail_cons, List.map_nil, List.nil_append]
    apply St.set_of_eq
    simp [hqa, hqb, hqd, hqe]
  rw [e1] at this
  exact this.mono (by simp [zipCost]; try ring_nf; try omega)

end

