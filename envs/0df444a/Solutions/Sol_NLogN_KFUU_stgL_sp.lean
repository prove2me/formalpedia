    have e14 : tbl Q (rv.take (k + 1)).reverse = stg Q x.1 x.2 T := by
      rw [htk]; rfl
    by_cases j1 : j = 14
    · subst j1; simp +decide only [stF, Function.update_apply, if_true, if_false, e14]
    by_cases j2 : j = sSA
    · subst j2; simp +decide only [stF, Function.update_apply, if_true, if_false]
    by_cases j3 : j = sSC
    · subst j3; simp +decide only [stF, Function.update_apply, if_true, if_false]
    by_cases j4 : j = sSM
    · subst j4; simp +decide only [stF, Function.update_apply, if_true, if_false, htk]
    by_cases j5 : j = sSAM
    · subst j5; simp +decide only [stF, Function.update_apply, if_true, if_false, htk]
    simp only [stF, Function.update_apply, j1, j2, j3, j4, j5, if_false]

end NLogN.KFUU

