  · have hle : 3328 ≤ q := by omega
    simpa only [Nat.add_sub_of_le hle] using
      case232_blockers1 ⟨q-3328,by omega⟩
private theorem rows_check : certificate232.rows.toList.all (rowB certificate232) = true := by
  decide_cbv
private theorem covers_check : (List.range certificate232.pool.size).all (localCoverB certificate232) = true := by
  decide_cbv
private theorem cost_check : decide (cost certificate232 < certificate232.denominator * (deletedCount certificate232+1)) = true := by
  decide_cbv
theorem solution : CompletionBound (decode 3203) (0 : ZMod 3) := by
  have hs : certificate232.blockers.size = 6561 := by
    simp only [certificate232, binaryBlockers, Array.size_ofFn]
