    exact mul_le_mul h1x hA2 (by positivity) (by linarith [ht.2] : (0:ℝ) ≤ 1 - t)
  have hden' : (0:ℝ) < |(1 - t) * AcK t ^ 2| := lt_of_lt_of_le hdenpos hden
