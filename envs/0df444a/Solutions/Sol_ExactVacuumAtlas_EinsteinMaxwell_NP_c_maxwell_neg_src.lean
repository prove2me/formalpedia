          * cSrc3 M a Q τ x)
      = 2 * phi1 EK x FK * (2 * cPsi3 M a Q τ x - fdir EK 0 (cNu M a Q τ) x + fdir EK 2 (cLambda M a Q τ) x
            + (npPiB gK giK EK ΘK x + npTau gK giK EK ΘK x + 3 * npBeta gK giK EK ΘK x - npAlphaB gK giK EK ΘK x)
              * cLambda M a Q τ x
            - (3 * npEps gK giK EK ΘK x + npEpsB gK giK EK ΘK x + npRho gK giK EK ΘK x - npRhoB gK giK EK ΘK x)
              * cNu M a Q τ x)
        - cNu M a Q τ x * fdir EK 0 (fun z => phi1 EK z FK) x
        + cLambda M a Q τ x * fdir EK 2 (fun z => phi1 EK z FK) x := by
  obtain ⟨⟨_, _, _, _, _, _, hK, ht, hs⟩, ⟨_, _, _, _, _, _, hK', ht', hs'⟩⟩ := hτ.fams
  have eR := lin_maxwell_combo_neg hK ht (hs x hx)
  have eI := lin_maxwell_combo_neg hK' ht' (hs' x hx)
  rw [fdir_cSrc4 hτ hx 3, fdir_cSrc3 hτ hx 1, fdir_cNu hτ hx 0, fdir_cLambda hτ hx 2]
  simp only [cSrc3, cSrc4, cPsi3, cNu, cLambda, cplx]
  linear_combination eR + I * eI
