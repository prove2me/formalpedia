section transport
variable {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f) (n : ℕ)

theorem isTorsionPoint_congr {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (x₁ : SchemeHomOver t₁ f) (x₂ : SchemeHomOver t₂ f) (hx : x₁.1 = x₂.1) :
    L.IsTorsionPoint t₁ n x₁ ↔ L.IsTorsionPoint t₂ n x₂ := by
  subst h
  obtain rfl : x₁ = x₂ := Subtype.ext hx
  exact Iff.rfl

variable {R : Type} [CommRing R]

def tcCast {ι₁ ι₂ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) (χ : L.TorsionCharacter n ι₁) :
    L.TorsionCharacter n ι₂ := by
  subst h; exact χ

theorem tcCast_tcCast {ι₁ ι₂ ι₃ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) (h' : ι₂ = ι₃)
    (χ : L.TorsionCharacter n ι₁) : tcCast L n h' (tcCast L n h χ) = tcCast L n (h.trans h') χ := by
  subst h h'; rfl

theorem tcCast_symm_apply {ι₁ ι₂ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) (χ : L.TorsionCharacter n ι₁) :
    tcCast L n h.symm (tcCast L n h χ) = χ := by
  subst h; rfl

theorem tcCast_apply_symm {ι₁ ι₂ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) (χ : L.TorsionCharacter n ι₂) :
    tcCast L n h (tcCast L n h.symm χ) = χ := by
  subst h; rfl

theorem tcCast_injective {ι₁ ι₂ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) :
    Function.Injective (tcCast L n h) := by
  subst h; exact fun _ _ e => e

theorem tcCast_val {ι₁ ι₂ : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (h : ι₁ = ι₂) (χ : L.TorsionCharacter n ι₁)
    (T : Type) [CommRing T] (κ : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of R))
    (x₂ : SchemeHomOver (κ ≫ ι₂) f) (hx₂ : L.IsTorsionPoint (κ ≫ ι₂) n x₂)
    (x₁ : SchemeHomOver (κ ≫ ι₁) f) (hx₁ : L.IsTorsionPoint (κ ≫ ι₁) n x₁) (hx : x₂.1 = x₁.1) :
    (tcCast L n h χ).val T κ x₂ hx₂ = χ.val T κ x₁ hx₁ := by
  subst h
  obtain rfl : x₂ = x₁ := Subtype.ext hx
  rfl

theorem val_congr {ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)} (χ : L.TorsionCharacter n ι)
    (T : Type) [CommRing T] {κ₁ κ₂ : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of R)} (h : κ₁ = κ₂)
    (x₁ : SchemeHomOver (κ₁ ≫ ι) f) (hx₁ : L.IsTorsionPoint (κ₁ ≫ ι) n x₁)
    (x₂ : SchemeHomOver (κ₂ ≫ ι) f) (hx₂ : L.IsTorsionPoint (κ₂ ≫ ι) n x₂) (hx : x₁.1 = x₂.1) :
    χ.val T κ₁ x₁ hx₁ = χ.val T κ₂ x₂ hx₂ := by
  subst h
  obtain rfl : x₁ = x₂ := Subtype.ext hx
  rfl

