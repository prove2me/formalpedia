-- title:
--   Nine rational theta translates and interpolation tables
-- statement:
--   The weights are (9,58,223,441,447,229,61,8,1)/1024 at shifts -1,-1/2,0,1/2,1,3/2,2,5/2,3. The signed integer rows store endpoint values and affine interpolation error radii in units of 10^-8 on mesh 1/16. The definitions include exact rational tests for curvature, truncation and weights.
-- source:
--   Masullo fixed-Gaussian approximation route. The witness uses the mission theta function, rational interval arithmetic and the published finite theta truncation. The energy estimate is unconditional. https://prove2.me/definitions/56288084-20c7-4a74-8ace-7f6e0e9ebe9f https://prove2.me/definitions/301c9181-2bf8-5b2d-8998-b54d3a671ea6

import Definitions.Def_MasulloRH_InteriorEvaluator
import Definitions.Def_MasulloRH_FixedGaussianTest

namespace MasulloRH.NineShift
open CentralInterval InteriorEvaluator GaussianApproximation

structure Row where
  l : ℤ
  r : ℤ
  e : ℤ
  deriving DecidableEq, Repr, Inhabited

def value (n : ℤ) : ℚ := n / 100000000
def grid (j : ℤ) : ℚ := j / 16
def cellB (j : ℤ) : Box := (grid j,grid (j+1))
def refl (j : ℤ) : Bool := decide (j < -12)
def unitFactor : Box := (56418958354/100000000000,56418958356/100000000000)
def uv (z : Box) := mulB unitFactor (expB (negB (sqB z)))
def ud (z : Box) := mulB (subB (mulB (point 4) (sqB z)) (point 2)) (uv z)
def deviation (v : Box) (k : ℤ) : ℚ := mag (subB v (point (value k)))
def thetaCheck (j : ℤ) (row : Row) : Bool :=
  let b := refl j
  let d := params b (cellB j)
  let f := fun i : ℤ => thetaV (params b (point (grid i)))
  decide (0 < tailDen d ∧
    max (deviation (f j) row.l) (deviation (f (j+1)) row.r) +
    mag (thetaD b d)/2048 + tailU d ≤ value row.e)
def pulseCheck (j : ℤ) (row : Row) : Bool :=
  let f := fun i : ℤ => uv (point (grid i))
  decide (max (deviation (f j) row.l) (deviation (f (j+1)) row.r) +
    mag (ud (cellB j))/2048 ≤ value row.e)

noncomputable def line (p : Row) (s : ℝ) : ℝ := (1-s)*(value p.l : ℝ)+s*(value p.r : ℝ)
def Approx (f : ℝ → ℂ) (j : ℤ) (p : Row) : Prop :=
  ∀ s : ℝ, 0 ≤ s → s ≤ 1 → ‖f ((grid j : ℝ)+s/16) - (line p s : ℂ)‖ ≤ (value p.e : ℝ)

def numerator (i : Fin 9) : ℤ := ![9,58,223,441,447,229,61,8,1] i
def coeff (i : Fin 9) : ℚ := numerator i / 1024
def offset (i : Fin 9) : ℤ := 8*(i.val : ℤ)-16
def shift (i : Fin 9) : ℚ := grid (offset i)
noncomputable def err := residual 0 (fun i => (coeff i : ℂ)) (fun i => (shift i : ℝ))

