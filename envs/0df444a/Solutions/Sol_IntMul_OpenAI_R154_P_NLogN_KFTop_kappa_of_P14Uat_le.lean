theorem p14Need_mono {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e14 : Fin Pp}
    {dS14 : Fin HS} {A A' : ℕ} {C₀ : ℝ} (h : A ≤ A') (H : P14Need Isym tbl e14 dS14 A C₀) :
    P14Need Isym tbl e14 dS14 A' C₀ := by
  intro K r Z P D S ρ p w hρ h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
  have hE := EwB_mono h D
  exact H hρ h1 h2 h3 h4 h5 h6 h7 h8 h9 (le_trans hE h10) (lt_of_le_of_lt (by omega) h11) h12 h13

/-- **Monotonicity in `A`.** -/
theorem p14Uat_mono {A A' : ℕ} (H : P14Uat A) (h : A ≤ A') : P14Uat A' := by
  obtain ⟨nU, U, e, d, C, h1, h2, h3⟩ := H
  exact ⟨nU, U, e, d, C, h1, h2, fun E ext idx hi Isym => p14Need_mono h (h3 E ext idx hi Isym)⟩

