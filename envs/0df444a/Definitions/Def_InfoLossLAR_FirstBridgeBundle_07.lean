set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace InfoLossLAR.WorstCase
open AFT
open scoped BigOperators

/-- A direct integer prefix algorithm for the path-incidence preimage. -/
def pathPrefix : (n : ℕ) → (Fin (n+1) → ℤ) → (Fin n → ℤ)
  | 0,_ => Fin.elim0
  | n+1,load => Fin.cons (load 0)
      (pathPrefix n (fun i => load i.succ + if i=0 then load 0 else 0))



/-- The public integer carry direction computed without choosing an inverse. -/
def computableRoundingDirectionInteger (n q : ℕ) (column : Fin (n+1) → ℤ) :
    (Fin n → ℤ) × ℤ :=
  (_root_.InfoLossLAR.WorstCase.pathPrefix n ((q : ℤ) • (Pi.single (0 : Fin (n+1)) (1 : ℤ))-column),1)





/-- The literal modular preprocessing direction, using the same edge-then-last
coordinate order as the actual platform matrix. -/
def computableFixedRoundingDirection (q n : ℕ) (amount : ZMod q) : Fin (n+1) → ZMod q :=
  let integer := _root_.InfoLossLAR.WorstCase.computableRoundingDirectionInteger n q (_root_.AFT.injectionColumn n q)
  Fin.lastCases (amount*(integer.2 : ZMod q)) (fun j => amount*(integer.1 j : ZMod q))



/-- The platform represents the scalar label as a vector with one coordinate. -/
def computableFixedVectorDirection (q n : ℕ) : (Fin 1 → ZMod q) → Fin (n+1) → ZMod q :=
  fun label => _root_.InfoLossLAR.WorstCase.computableFixedRoundingDirection q n (label 0)

noncomputable def fixedVectorDirection (q n : ℕ) [NeZero q] (hq : q ≤ n+1) :
    (Fin 1 → ZMod q) →+ (Fin (n+1) → ZMod q) where
  toFun label := _root_.InfoLossLAR.WorstCase.fixedRoundingDirection q n hq (label 0)
  map_zero' := by simp
  map_add' first second := by simp





end InfoLossLAR.WorstCase

end

