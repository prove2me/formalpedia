-- Source module: Solutions.J6PipeDisc2
/-!
# `PipeDisc6`, part 2: one `B₀` line keeps the disc, and the theorem

* `b0seg_disc`: from `FitSpec6` (`‖B_i‖ ≤ 1/2` and the `≤ 9` error of `B0seg`) and `18 ≤ 2^p`,
  every row of the `B₀` line of a `DiscL p` line of length `t_i` has modulus `≤ 2^p`
  (rows `l ≥ s_i` are `0`);
* **`pipeDisc6_all`**: `∀ P, P.Ok → PipeDisc6 P`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex
open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

namespace J6Seg

/-- The disc bound for the padded function of a disc line. -/
lemma getD_disc {p : ℕ} {X : List GI} (hX : DiscL p X) (k : ℕ) :
    ‖IntMul.HvdH.P47.toC (X.getD k (0, 0))‖ ≤ 2 ^ p := by
  by_cases hk : k < X.length
  · rw [List.getD_eq_getElem _ _ hk]
    exact hX _ (List.getElem_mem _)
  · rw [List.getD_eq_default _ _ (by omega)]
    simp [IntMul.HvdH.P47.toC]

/-- **One `B₀` row of a disc line is in the disc.** -/
theorem b0seg_row_disc {p s t : ℕ} [NeZero s] [NeZero t] (F : (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ))
    (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)) (hB : ‖B‖ ≤ 1 / 2) (hp : 18 ≤ (2 : ℝ) ^ p)
    (hErr : ∀ W : ℕ → ℤ × ℤ, (∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ p) →
      ∀ l : ZMod s, ‖IntMul.HvdH.P47.toC (F W l.val) -
        2 ^ p * B (fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ p) l‖ ≤ 9)
    (hge : ∀ W l, s ≤ l → F W l = (0, 0))
    (W : ℕ → ℤ × ℤ) (hW : ∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ p) (l : ℕ) :
    ‖IntMul.HvdH.P47.toC (F W l)‖ ≤ 2 ^ p := by
  have h2p : (0 : ℝ) < 2 ^ p := by positivity
  by_cases hl : l < s
  · have hv : (((l : ℕ) : ZMod s)).val = l := by
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hl]
    have e := hErr W hW (l : ZMod s)
    rw [hv] at e
    set v : ZMod t → ℂ := fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ p with hvdef
    have hvn : ‖v‖ ≤ 1 := by
      refine (pi_norm_le_iff_of_nonneg zero_le_one).2 fun k => ?_
      simp only [hvdef, norm_div, norm_pow, Complex.norm_ofNat]
      rw [div_le_one h2p]; exact hW _
    have hBv : ‖B v (l : ZMod s)‖ ≤ 1 / 2 := by
      calc ‖B v (l : ZMod s)‖ ≤ ‖B v‖ := norm_le_pi_norm _ _
        _ ≤ ‖B‖ * ‖v‖ := B.le_opNorm v
        _ ≤ 1 / 2 * 1 := mul_le_mul hB hvn (norm_nonneg _) (by norm_num)
        _ = 1 / 2 := by norm_num
    have hm : ‖(2 : ℂ) ^ p * B v (l : ZMod s)‖ ≤ 2 ^ p * (1 / 2) := by
      rw [norm_mul, norm_pow, Complex.norm_ofNat]
      exact mul_le_mul_of_nonneg_left hBv h2p.le
    calc ‖IntMul.HvdH.P47.toC (F W l)‖
        ≤ ‖IntMul.HvdH.P47.toC (F W l) - 2 ^ p * B v (l : ZMod s)‖ +
            ‖(2 : ℂ) ^ p * B v (l : ZMod s)‖ := norm_le_norm_sub_add _ _
      _ ≤ 9 + 2 ^ p * (1 / 2) := add_le_add e hm
      _ ≤ 2 ^ p := by linarith
  · rw [hge W l (by omega)]
    simp [IntMul.HvdH.P47.toC]

set_option maxHeartbeats 1000000 in
/-- **The axis maps keep the disc** (`PipeDisc6`). -/
theorem pipeDisc6_all_sol_aux (P : Prm) (hP : P.Ok) : PipeDisc6 P := by
  obtain ⟨n₁, h⟩ := r6_axis_nat P hP
  obtain ⟨n₂, hfit⟩ := r6_fitSpec P hP
  obtain ⟨n₃, hme⟩ := r6_maps_eq P hP
  refine ⟨max n₁ (max n₂ n₃), fun n hn src hsrc D hD k hkD L hL hdisc => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hk' : k < D + 1 := by omega
  have hax : ∀ i : Fin (D + 1), 0 < sD6 src D i ∧ sD6 src D i < tD6 P n D i := by
    intro i
    have hi : i.val < dP6 P n := by have := i.isLt; omega
    obtain ⟨hs0, hst, -⟩ := h n hn1 src hsrc i.val hi
    exact ⟨hs0, hst⟩
  haveI : ∀ i, NeZero (sD6 src D i) := fun i => ⟨(hax i).1.ne'⟩
  haveI : ∀ i, NeZero (tD6 P n D i) := fun i => ⟨by have := hax i; omega⟩
  obtain ⟨M, hM⟩ := hfit n hn2 src hsrc D hD
  obtain ⟨hmaps, hdv⟩ := hme n hn3 src hsrc D hD
  have hp18 : 18 ≤ (2 : ℝ) ^ pP6 P n := by
    obtain ⟨-, -, -, -, -, h48, hαp, -, -, hd1⟩ := h n hn1 src hsrc 0 (by omega)
    have h1 := Nat.one_le_pow 2 (dP6 P n) (by omega)
    have h5 : 5 ≤ pP6 P n := by omega
    have : (2 : ℝ) ^ 5 ≤ 2 ^ pP6 P n := pow_le_pow_right₀ (by norm_num) h5
    norm_num at this; linarith
  set dims := List.ofFn (tD6 P n D) with hdims
  have hdl : dims.length = D + 1 := by simp [dims]
  have hget : ∀ i (hi : i < D + 1), dims.getD i 1 = tD6 P n D ⟨i, hi⟩ :=
    fun i hi => ofFn_getD _ ⟨i, hi⟩ 1
  have hgets : ∀ i (hi : i < D + 1), (List.ofFn (sD6 src D)).getD i 1 = sD6 src D ⟨i, hi⟩ :=
    fun i hi => ofFn_getD _ ⟨i, hi⟩ 1
  have hpos : ∀ u ∈ dims, 0 < u := by
    intro u hu
    simp only [dims, List.mem_ofFn] at hu
    obtain ⟨i, rfl⟩ := hu
    exact Nat.pos_of_ne_zero (NeZero.ne _)
  set F : ℕ → List GI → List GI := fun i => ((mapsLine6 P n src D).getD i (0, id)).2 with hFdef
  have hFA : ∀ i < D + 1, F i = fun X => (List.range (dims.getD i 1)).map
      (B0ax (pP6 P n) (pP6 P n / 7) (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n)
        (segPF (pP6 P n) (dP6 P n)) (sD6 src D) (tD6 P n D) i fun j => X.getD j (0, 0)) := by
    intro i hi
    simp only [hFdef]
    rw [hmaps, List.getD_eq_getElem (mapsBs _ _ _ _ _ _ _ _) _ (by simp [mapsBs]; omega)]
    simp [mapsBs, dims]
  have hFlen : ∀ X : List GI, X.length = dims.getD k 1 → (F k X).length = dims.getD k 1 := by
    intro X _
    rw [hFA k hk']; simp
  have hk : k < dims.length := by omega
  obtain ⟨hdvk, hstk⟩ := hdv ⟨k, hk'⟩
  have hprod := prod_split3 dims k hk
  have hp0 : 0 < (dims.drop (k + 1)).prod :=
    List.prod_pos (fun u hu => hpos u (List.mem_of_mem_drop hu))
  have hn0 : 0 < dims.getD k 1 := by rw [hget k hk']; exact Nat.pos_of_ne_zero (NeZero.ne _)
  have hFp : pipe6 P n src D k L = axisL (dims.getD k 1) (dims.drop (k + 1)).prod (F k) L := by
    have et : tI6 P n D k = tD6 P n D ⟨k, hk'⟩ := hget k hk'
    have es : sI6 src D k = sD6 src D ⟨k, hk'⟩ := hgets k hk'
    have ht0 : 0 < tD6 P n D ⟨k, hk'⟩ := Nat.pos_of_ne_zero (NeZero.ne _)
    have hl1 : 1 ≤ lamP (dP6 P n) := lamP_pos _
    have hN : tI6 P n D k / lamP (dP6 P n) * lamP (dP6 P n) = tI6 P n D k := by
      rw [et]; exact Nat.div_mul_cancel hdvk
    have hnc : 0 < tI6 P n D k / lamP (dP6 P n) := by
      rcases Nat.eq_zero_or_pos (tI6 P n D k / lamP (dP6 P n)) with h0 | h0
      · rw [h0, zero_mul, et] at hN; omega
      · exact h0
    have hGm : (LJ (sI6 src D k) (tI6 P n D k) (lamP (dP6 P n)) (wF (dP6 P n))).length ≤
        GJ6 P n src D k := Nat.le_pow_clog (by norm_num) _
    refine Eq.trans (axisPipe_eq (p := pP6 P n) (P := segPF (pP6 P n) (dP6 P n) (sI6 src D k))
      (R := pP6 P n / 7) (α := αN6 P n) (K := wF (dP6 P n))
      (pre := ((List.ofFn (tD6 P n D)).take k).prod) hl1 hnc (by rw [es, et]; exact hstk) hN hGm
      (Nat.two_pow_pos _) hp0 L (by rw [hL, hprod, hN]; rfl)) ?_
    have hF' : F k = lineB (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sI6 src D k)) (pP6 P n / 7)
        (sI6 src D k) (tI6 P n D k) (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n) (wF (dP6 P n))
        (tI6 P n D k / lamP (dP6 P n)) := by
      simp only [hFdef]
      rw [List.getD_eq_getElem (mapsLine6 P n src D) _ (by simp [mapsLine6]; omega)]
      simp [mapsLine6, sI6, tI6]
    rw [hF', hN]
    rfl
  rw [hFp]
  have hLlen : L.length = (dims.take k).prod * (dims.getD k 1 * (dims.drop (k + 1)).prod) := by
    rw [hL, ← hprod]
  refine ⟨by rw [length_axisL _ _ hn0 hp0 _ _ _ hLlen, hLlen], ?_⟩
  refine mem_axisL (fun z : GI => ‖gC z‖ ≤ 2 ^ pP6 P n) (by show ‖gC ((0, 0) : GI)‖ ≤ _; rw [gC_zero', norm_zero]; positivity) _ _ hn0 hp0 (F k)
    hFlen ?_ L _ hLlen hdisc
  intro X hXl hXd z hz
  rw [hFA k hk'] at hz
  simp only [List.mem_map, List.mem_range] at hz
  obtain ⟨l, -, rfl⟩ := hz
  have eB : B0ax (pP6 P n) (pP6 P n / 7) (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n)
      (segPF (pP6 P n) (dP6 P n)) (sD6 src D) (tD6 P n D) k =
      B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D ⟨k, hk'⟩)) (pP6 P n / 7)
        (lamP (dP6 P n)) (wF (dP6 P n)) (sD6 src D ⟨k, hk'⟩) (tD6 P n D ⟨k, hk'⟩) (αN6 P n) :=
    B0F_eq (pP6 P n) (pP6 P n / 7) (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n)
      (segPF (pP6 P n) (dP6 P n)) (sD6 src D) (tD6 P n D) ⟨k, hk'⟩
  rw [eB]
  obtain ⟨hB, -, hErr, -⟩ := hM ⟨k, hk'⟩
  exact b0seg_row_disc _ (M.B ⟨k, hk'⟩) hB hp18 hErr (fun W l hl => B0seg_ge W hl) _
    (getD_disc hXd) l

end J6Seg

