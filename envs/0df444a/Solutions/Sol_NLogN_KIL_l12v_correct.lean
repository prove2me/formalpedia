section
-- Source module: Solutions.AModelL12
/-!
# Lemma 12 (arbitrary-width interchange), array model: the procedure and its denotation

Radix-`q` layer. The array lives on `qShape Pre G Suf q e = Pre ++ [q]*e ++ G ++ [q]*e ++ Suf`
(prefix, chunk `h`, gap, chunk `d`, suffix; the chunks are `e` radix-`q` digits each).
The procedure `l12q` (paper, proof of Lemma 12):
1. interchange the top `ρ` digits of the two chunks one pair at a time (`highSwaps`, `ρ` primitive
   single-digit swaps);
2. join: move `h⁺` next to `d⁺` (a field rotation; the result lives on `joinShape`);
3. reshape (free): prefix ↦ one field `P = vol Pre`, `d⁺h⁺` ↦ one row field `R = q^(2ρ)`;
4. pad the row field to `R' = padRows W Kp R` (a multiple of `W ^ Kp`, zero rows appended);
5. write `n = e - ρ` in base `m` and call the Prop. 11 oracle `child j` on each corresponding pair of
   pieces of width `m ^ j` (`pieceLevels`, `runPieces`), all with the shared row field `R'`;
6. unpad (scan away the padded rows), reshape back, reverse the joining rotation.
If `ρ > e` (bounded widths) the procedure does `e` single-digit interchanges instead.

Main theorem `l12q_correct`: for every Prop.-11 oracle `child` satisfying the block-swap spec
(as `prop11`'s first conjunct gives it, when `W ^ j ∣ rows`), `l12q` is the pull by the full
chunk interchange `blockSwap a (a + e + |G|) e`.

Binary layer (`l12bin`): pad each `[2^u]` chunk numerically to `[q^e]` (`embed`, zero outside),
run `l12q` on the radix-`q` digits (reshape is free), extract. `l12bin_correct`: the result is
the pull by the single-field interchange `swapPos a (a + 1 + |G|)` on
`Pre ++ [2^u] ++ G ++ [2^u] ++ Suf` — the paper's `(p,h,g,d,z) ↦ (p,d,g,h,z)`.
-/

namespace AModelL12

open AModel

/-! ## 1. Shapes -/

section Shapes

lemma length_restShape (G Suf : Shape) (q n : ℕ) :
    (restShape G Suf q n).length = n + G.length + n + Suf.length := by
  simp [restShape]; omega

lemma length_qShape (Pre G Suf : Shape) (q e : ℕ) :
    (qShape Pre G Suf q e).length = Pre.length + e + G.length + e + Suf.length := by
  simp [qShape, length_restShape]; omega

lemma getD_replicate_lt {n q k : ℕ} (hk : k < n) : (List.replicate n q).getD k 0 = q := by
  rw [List.getD_eq_getElem _ _ (by simpa using hk), List.getElem_replicate]

lemma restShape_getD (G Suf : Shape) (q n : ℕ) {k : ℕ} (hk : k < n) :
    (restShape G Suf q n).getD k 0 = q ∧
      (restShape G Suf q n).getD (n + G.length + k) 0 = q := by
  unfold restShape
  constructor
  · rw [List.getD_append _ _ _ _ (by simpa using hk), getD_replicate_lt hk]
  · rw [List.getD_append_right _ _ _ _ (by simp; omega), List.length_replicate,
      List.getD_append_right _ _ _ _ (by omega),
      List.getD_append _ _ _ _ (by simp; omega), getD_replicate_lt (by omega)]

lemma qShape_getD (Pre G Suf : Shape) (q e : ℕ) {k : ℕ} (hk : k < e) :
    (qShape Pre G Suf q e).getD (Pre.length + k) 0 =
      (qShape Pre G Suf q e).getD (Pre.length + e + G.length + k) 0 := by
  unfold qShape
  rw [List.getD_append_right _ _ _ _ (by omega), List.getD_append_right _ _ _ _ (by omega),
    Nat.add_sub_cancel_left, show Pre.length + e + G.length + k - Pre.length = e + G.length + k
      by omega, (restShape_getD G Suf q e hk).1, (restShape_getD G Suf q e hk).2]

lemma rowShape_getD (P R : ℕ) (G Suf : Shape) (q n : ℕ) {k : ℕ} (hk : k < n) :
    (rowShape P R G Suf q n).getD (2 + k) 0 = (rowShape P R G Suf q n).getD (n + G.length + 2 + k) 0 := by
  have h := restShape_getD G Suf q n hk
  simp only [rowShape, show 2 + k = k + 1 + 1 by omega,
    show n + G.length + 2 + k = n + G.length + k + 1 + 1 by omega, List.getD_cons_succ]
  rw [h.1, h.2]

lemma length_rowShape (P R : ℕ) (G Suf : Shape) (q n : ℕ) :
    (rowShape P R G Suf q n).length = n + G.length + n + Suf.length + 2 := by
  simp [rowShape, length_restShape]

lemma le_padRows {W K R : ℕ} (hW : 1 ≤ W) : R ≤ padRows W K R := by
  unfold padRows
  have hp : 0 < W ^ K := by positivity
  have := Nat.div_add_mod (R + W ^ K - 1) (W ^ K)
  have := Nat.mod_lt (R + W ^ K - 1) hp
  have : W ^ K * ((R + W ^ K - 1) / W ^ K) + (R + W ^ K - 1) % W ^ K = R + W ^ K - 1 := by
    omega
  omega

lemma dvd_padRows {W K j R : ℕ} (hj : j ≤ K) : W ^ j ∣ padRows W K R :=
  (pow_dvd_pow W hj).trans (dvd_mul_right _ _)

/-- `S ≤ T` for the row padding. -/
lemma shapeLE_rowShape {P R R' : ℕ} (G Suf : Shape) (q n : ℕ) (h : R ≤ R') :
    ShapeLE (rowShape P R G Suf q n) (rowShape P R' G Suf q n) := by
  refine ⟨by simp [rowShape], fun k h₁ h₂ => ?_⟩
  rcases k with _ | _ | k
  · simp [rowShape]
  · simpa [rowShape] using h
  · simp [rowShape]

end Shapes

/-! ## 2. The pieces -/

section PiecesDef

lemma sum_flatMap_replicate {M : Type*} [Semiring M] (a : ℕ → ℕ) (F : ℕ → M) (N : ℕ) :
    (((List.range N).flatMap fun j => List.replicate (a j) j).map F).sum =
      ∑ j ∈ Finset.range N, (a j : M) * F j := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [List.range_succ, List.flatMap_append, List.map_append, List.sum_append, ih,
      Finset.sum_range_succ]
    simp [List.sum_replicate, nsmul_eq_mul]

lemma sum_pieceLevels (m n : ℕ) : ((pieceLevels m n).map fun j => m ^ j).sum = n := by
  rw [pieceLevels, sum_flatMap_replicate]
  exact digit_decomposition m n

end PiecesDef

/-! ## 3. The procedure -/

/-! ## 4. Correctness -/

section Correct

variable {α : Type*}

/-- The `r` single-digit swaps compose to the block swap. -/
theorem highSwaps_eq {sh : Shape} {i j r : ℕ} (hij : i + r ≤ j) (hj : j + r ≤ sh.length)
    (hsz : ∀ k < r, sh.getD (i + k) 0 = sh.getD (j + k) 0) (d : α) {xs : List α}
    (hxs : xs.length = vol sh) :
    highSwaps sh i j r d xs = pull sh sh (blockSwap i j r) d xs := by
  induction r with
  | zero =>
    simp only [highSwaps, List.range_zero, List.foldl_nil]
    rw [pull_congr (g' := id) (fun a _ => blockSwap_zero _ _ a), pull_id d hxs]
  | succ r ih =>
    have ih' := ih (by omega) (by omega) (fun k hk => hsz k (by omega))
    simp only [highSwaps, List.range_succ, List.foldl_append, List.foldl_cons,
      List.foldl_nil] at ih' ⊢
    rw [ih', pull_comp _ _ (fun a ha => valid_swapPos (by omega) (by omega) (hsz r (by omega)) ha)]
    apply pull_congr
    intro a ha
    exact blockSwap_swapPos (by omega) (by rw [ha.length_eq]; omega)

/-- The child's shape at a piece is the padded row shape. -/
lemma hdShape_piece (G Suf : Shape) (q n o w : ℕ) (h : o + w ≤ n) :
    hdShape (List.replicate o q) (List.replicate (n - o - w) q ++ (G ++ List.replicate o q))
      (List.replicate (n - o - w) q ++ Suf) w q = restShape G Suf q n := by
  obtain ⟨r, rfl⟩ : ∃ r, n = o + w + r := ⟨n - o - w, by omega⟩
  simp only [show o + w + r - o - w = r by omega, hdShape, restShape, List.replicate_add,
    List.append_assoc]

/-- **Middle part.** Padding, the piece calls, and unpadding together are the pull by the
interchange of the two remaining chunks on the (unpadded) row shape. -/
theorem middle_eq {child : Oracle α} {d : α} {W m q Kp : ℕ} (hspec : OracleSpec child d W m q Kp)
    (hm : 2 ≤ m) (hW : 1 ≤ W) (P R : ℕ) (G Suf : Shape) {n : ℕ} (hn : n ≤ m ^ Kp)
    (ys : List α) :
    extract (rowShape P R G Suf q n) (rowShape P (padRows W Kp R) G Suf q n) d
        (runPieces (pieceStep child P (padRows W Kp R) G Suf q m n) (fun j => m ^ j) 0
          (pieceLevels m n) (embed (rowShape P R G Suf q n)
            (rowShape P (padRows W Kp R) G Suf q n) d ys)) =
      pull (rowShape P R G Suf q n) (rowShape P R G Suf q n)
        (blockSwap 2 (n + G.length + 2) n) d ys := by
  set S := rowShape P R G Suf q n
  set T := rowShape P (padRows W Kp R) G Suf q n
  have hrun := runPieces_eq (T := T) (c := 2) (c' := n + G.length + 2) (n := n) (by omega)
    (by simp [T, length_rowShape]; omega) (fun k hk => rowShape_getD _ _ G Suf q n hk)
    (pieceStep child P (padRows W Kp R) G Suf q m n) (fun j => m ^ j) d
    (fun o j ys' ho hys' => by
      have hj : j ≤ Kp := by
        by_contra hc
        have : m ^ Kp < m ^ j := Nat.pow_lt_pow_right (by omega) (by omega)
        omega
      have hsh := hdShape_piece G Suf q n o (m ^ j) ho
      unfold pieceStep
      rw [hspec j hj _ _ _ _ _ ys' (dvd_padRows hj) (by rw [hys', hsh]; rfl), hsh]
      congr 2 <;> simp <;> omega)
    (pieceLevels m n) 0 (embed S T d ys) (by rw [sum_pieceLevels]; omega) (by simp)
  rw [sum_pieceLevels] at hrun
  simp only [Nat.add_zero] at hrun
  rw [hrun]
  exact extract_pull_embed (shapeLE_rowShape G Suf q n (le_padRows hW)) _
    (fun a ha => valid_blockSwap (by omega) (by simp [length_rowShape]; omega)
      (fun k hk => rowShape_getD _ _ G Suf q n hk) ha) d ys

end Correct

/-! ## 5. Binary chunks: numeric padding `[2^u] → [q^e]` -/

section Binary

variable {α : Type*}

lemma length_binShape (Pre G Suf : Shape) (F : ℕ) :
    (binShape Pre G Suf F).length = Pre.length + G.length + Suf.length + 2 := by
  simp [binShape]; omega

lemma vol_binShape_q (Pre G Suf : Shape) (q e : ℕ) :
    vol (binShape Pre G Suf (q ^ e)) = vol (qShape Pre G Suf q e) := by
  simp [binShape, qShape, restShape, vol_append, vol_replicate]

lemma shapeLE_of_forall₂ {S T : Shape} (h : List.Forall₂ (· ≤ ·) S T) : ShapeLE S T := by
  rw [List.forall₂_iff_get] at h
  exact ⟨h.1, fun k h₁ h₂ => h.2 k h₁ h₂⟩

lemma shapeLE_binShape (Pre G Suf : Shape) {F F' : ℕ} (h : F ≤ F') :
    ShapeLE (binShape Pre G Suf F) (binShape Pre G Suf F') := by
  have refl : ∀ X : Shape, List.Forall₂ (· ≤ ·) X X := fun X =>
    List.forall₂_same.2 fun x _ => le_refl x
  apply shapeLE_of_forall₂
  exact List.rel_append (refl Pre) (List.Forall₂.cons h
    (List.rel_append (refl G) (List.Forall₂.cons h (refl Suf))))

lemma binShape_getD (Pre G Suf : Shape) (F : ℕ) :
    (binShape Pre G Suf F).getD Pre.length 0 = F ∧
      (binShape Pre G Suf F).getD (Pre.length + 1 + G.length) 0 = F := by
  unfold binShape
  constructor
  · rw [List.getD_append_right _ _ _ _ (by omega)]; simp
  · rw [List.getD_append_right _ _ _ _ (by omega),
      show Pre.length + 1 + G.length - Pre.length = G.length + 1 by omega, List.getD_cons_succ,
      List.getD_append_right _ _ _ _ (by omega)]
    simp

lemma mergeShape2_qShape (Pre G Suf : Shape) (q e : ℕ) :
    mergeShape2 (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) e =
      binShape Pre G Suf (q ^ e) := by
  have h1 : qShape Pre G Suf q e =
      (Pre ++ (List.replicate e q ++ G)) ++ (List.replicate e q ++ Suf) := by
    simp [qShape, restShape]
  have h2 : (Pre ++ (List.replicate e q ++ G)) ++ (vol (List.replicate e q) :: Suf) =
      Pre ++ (List.replicate e q ++ (G ++ (q ^ e :: Suf))) := by
    simp [vol_replicate]
  unfold mergeShape2
  rw [h1, mergeShape_append _ _ _ (by simp; omega) (by simp), h2,
    mergeShape_append _ _ _ rfl (by simp)]
  simp [binShape, vol_replicate]

/-- The digit-level chunk interchange is the single-field interchange after merging (reshape). -/
theorem pull_qShape_eq_swap (Pre G Suf : Shape) (q e : ℕ) (d : α) (ys : List α) :
    pull (qShape Pre G Suf q e) (qShape Pre G Suf q e)
        (blockSwap Pre.length (Pre.length + e + G.length) e) d ys =
      pull (binShape Pre G Suf (q ^ e)) (binShape Pre G Suf (q ^ e))
        (swapPos Pre.length (Pre.length + 1 + G.length)) d ys := by
  rw [pull_blockSwap (by omega) (by rw [length_qShape]; omega)
      (fun k hk => qShape_getD Pre G Suf q e hk), mergeShape2_qShape,
    show Pre.length + e + G.length + 1 - e = Pre.length + 1 + G.length by omega]

end Binary

end AModelL12

end

section
-- Source module: Solutions.KIL6Den
/-!
# KIL6: Lemma 12 as a uniform IL program — the list denotations

The IL program of KIL6 realises the Lemma 12 interchange with the following data flow (array
model, `AModelL12`):

1. **binary padding** `binShape … (2^u) → binShape … (q^e)`: two one-field paddings
   (`padL`, `embed_binShape`);
2. **high swaps**: `r = min ρ e` single-digit interchanges (`highSwaps`);
3. if `n = e - r > 0`, the **middle part** `l12mid`: the row field is the prefix
   `Pre ++ [q]^r` (volume `vol Pre · q^r`), padded to `padRows W Kp (q^r)` rows (`padL`); the
   Prop. 11 oracle runs on the pieces (`runPieces … pieceLevels`), with the gap
   `G ++ [q]^r` (the already interchanged high digits of the second chunk belong to the gap);
   the padding is scanned away (`unpadL`);
4. **binary extraction** (two `unpadL`).

Compared with `AModelL12.l12q` this variant needs no joining rotation: the interchanged high
digits `d⁺` simply stay inside the gap.  `l12v_correct` proves that it is the interchange
`swapPos` of the two `[2^u]` fields, from the same oracle specification `OracleSpec`.

The list functions `padL` / `unpadL` are the one-field embeddings / extractions in the chunk
form the IL loops produce (`embed_eq_padL`, `extract_eq_unpadL`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open AModel AModelL12

/-! ## One-field padding and extraction in chunk form -/

section Pad

variable {α : Type*}

/-! ## Composing embeddings and extractions -/

end Pad

/-! ## The binary and row paddings in chunk form -/

/-! ## The variant procedure and its correctness -/

section Variant

variable {α : Type*}

lemma qShape_split (Pre G Suf : Shape) (q r n : ℕ) :
    qShape Pre G Suf q (r + n) = (Pre ++ List.replicate r q) ++
      restShape (G ++ List.replicate r q) Suf q n := by
  simp only [qShape, restShape, List.replicate_add, List.append_assoc]

/-- The middle part is the interchange of the low `n` digits of the two chunks. -/
theorem l12mid_eq {child : Oracle α} {d : α} {W m q Kp : ℕ} (hspec : OracleSpec child d W m q Kp)
    (hm : 2 ≤ m) (hW : 1 ≤ W) (Pre G Suf : Shape) (r : ℕ) {n : ℕ} (hn : n ≤ m ^ Kp)
    (ys : List α) :
    l12mid child W m q Kp r Pre G Suf n d ys =
      pull (qShape Pre G Suf q (r + n)) (qShape Pre G Suf q (r + n))
        (blockSwap (Pre.length + r) (Pre.length + (r + n) + G.length + r) n) d ys := by
  unfold l12mid
  rw [middle_eq hspec hm hW (vol Pre) (q ^ r) (G ++ List.replicate r q) Suf hn ys]
  have hX : vol (Pre ++ List.replicate r q) = vol [vol Pre, q ^ r] := by
    simp [vol_append, vol_replicate]
  have H := pull_blockSwap_prefix (Pre ++ List.replicate r q) [vol Pre, q ^ r]
    (restShape (G ++ List.replicate r q) Suf q n) hX 0 (n + (G ++ List.replicate r q).length) n d ys
  rw [← qShape_split] at H
  rw [show rowShape (vol Pre) (q ^ r) (G ++ List.replicate r q) Suf q n =
    [vol Pre, q ^ r] ++ restShape (G ++ List.replicate r q) Suf q n from rfl]
  simp only [List.length_cons, List.length_nil, List.length_append, List.length_replicate] at H ⊢
  rw [show 2 = 0 + 1 + 1 + 0 from rfl, show n + (G.length + r) + 2 = 0 + 1 + 1 + (n + (G.length + r))
    by omega, ← H]
  congr 2 <;> omega

/-- **Correctness of the variant**: it is the interchange of the two `[2^u]` fields. -/
theorem l12v_correct_sol_aux {child : Oracle α} {d : α} {W m q Kp : ℕ}
    (hspec : OracleSpec child d W m q Kp) (hm : 2 ≤ m) (hW : 1 ≤ W) (ρ : ℕ)
    (Pre G Suf : Shape) {e u : ℕ} (he : e ≤ m ^ Kp) (hu : 2 ^ u ≤ q ^ e) (xs : List α) :
    l12v child W m q Kp ρ e u Pre G Suf d xs =
      pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
        (swapPos Pre.length (Pre.length + 1 + G.length)) d xs := by
  set ys := embed (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d xs
  have hys : ys.length = vol (qShape Pre G Suf q e) := by rw [length_embed, vol_binShape_q]
  have hlen := length_qShape Pre G Suf q e
  have hsz : ∀ k < e, (qShape Pre G Suf q e).getD (Pre.length + k) 0 =
      (qShape Pre G Suf q e).getD (Pre.length + e + G.length + k) 0 :=
    fun k hk => qShape_getD Pre G Suf q e hk
  obtain ⟨r, hr⟩ : ∃ r, min ρ e = r := ⟨_, rfl⟩
  have hre : r ≤ e := hr ▸ min_le_right _ _
  have H1 := highSwaps_eq (sh := qShape Pre G Suf q e) (i := Pre.length)
    (j := Pre.length + e + G.length) (r := r) (by omega) (by omega)
    (fun k hk => hsz k (by omega)) d hys
  have key : (if e - r = 0 then
      highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) r d ys
      else l12mid child W m q Kp r Pre G Suf (e - r) d
        (highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) r d ys)) =
      pull (qShape Pre G Suf q e) (qShape Pre G Suf q e)
        (blockSwap Pre.length (Pre.length + e + G.length) e) d ys := by
    rw [H1]
    split_ifs with h0
    · rw [show r = e by omega]
    · obtain ⟨n, hn⟩ : ∃ n, e = r + n := ⟨e - r, by omega⟩
      have hn' : e - r = n := by omega
      rw [hn', l12mid_eq hspec hm hW Pre G Suf r (by omega)]
      subst hn
      rw [pull_comp _ _ (fun a ha => valid_blockSwap (by omega) (by omega)
        (fun k hk => by
          have := hsz (r + k) (by omega)
          rw [show Pre.length + (r + k) = Pre.length + r + k by omega,
            show Pre.length + (r + n) + G.length + (r + k) = Pre.length + (r + n) + G.length + r + k
              by omega] at this
          exact this) ha)]
      apply pull_congr
      intro a ha
      simp only [Function.comp_apply]
      rw [blockSwap_blockSwap_adj (by omega) (by rw [ha.length_eq, hlen]; omega)]
  unfold l12v
  rw [hr, key, pull_qShape_eq_swap]
  have hg := binShape_getD Pre G Suf (2 ^ u)
  exact extract_pull_embed (shapeLE_binShape Pre G Suf hu) _
    (fun a ha => valid_swapPos (by rw [length_binShape]; omega)
      (by rw [length_binShape]; omega) (hg.1.trans hg.2.symm) ha) d xs

end Variant

