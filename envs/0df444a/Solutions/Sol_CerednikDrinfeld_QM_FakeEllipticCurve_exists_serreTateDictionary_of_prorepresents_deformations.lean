theorem clause_res (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) :
    resA.comp (Φ coord θ₀ resR Xu wu resA H hs hc E g hg).toRingHom = resR := by
  obtain ⟨X, θ, w, hrig, hP⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E g hg
  exact hP.1

theorem clause_iso (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E E' : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (g' : u₀.1.A ⟶ E'.A)
    (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) (hg' : FakeEllipticCurve.IsPullbackVia resA E' u₀.1 g')
    (e : E.A ≅ E'.A) (hge : g ≫ e.hom = g') (he : e.hom ≫ E'.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    (hact : ∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E'.act x) :
    Φ coord θ₀ resR Xu wu resA H hs hc E g hg = Φ coord θ₀ resR Xu wu resA H hs hc E' g' hg' := by
  obtain ⟨X, θ, w, hrig, hP⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E g hg
  exact (Φ_eq H hs hc hg' (hrig.iso hge hmul hact) hP).symm

theorem mapPt_refl {S : Type} [CommRing S] {A₁ : Scheme.{0}} {f : A₁ ⟶ Spec (CommRingCat.of S)}
    (h : (Iso.refl A₁).hom ≫ f = f) {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)} (P : SchemeHomOver t f) :
    mapPt (Iso.refl A₁).hom h P = P :=
  Subtype.ext (Category.comp_id _)

theorem clause_inj (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E E' : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (g' : u₀.1.A ⟶ E'.A)
    (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) (hg' : FakeEllipticCurve.IsPullbackVia resA E' u₀.1 g')
    (heq : Φ coord θ₀ resR Xu wu resA H hs hc E g hg = Φ coord θ₀ resR Xu wu resA H hs hc E' g' hg') :
    ∃ e : E.A ≅ E'.A, g ≫ e.hom = g' ∧
      ∃ he : e.hom ≫ E'.f = E.f,
        (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
          mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q)) ∧
        (∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E'.act x) ∧
        (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P : SchemeHomOver t E.f),
          FactorsThrough E.lev P ↔ FactorsThrough E'.lev (mapPt e.hom he P)) := by
  letI instAk : Algebra A (ResidueField O) := resA.toAlgebra
  haveI : IsNoetherianRing A := inferInstance
  have hqA := isNilpotent_natCast H.hqO resA hs hc

  obtain ⟨X, θ, w, hrig, hP⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E g hg
  obtain ⟨X', θ', w', hrig', hP'⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E' g' hg'
  rw [← heq] at hP'
  set χ := Φ coord θ₀ resR Xu wu resA H hs hc E g hg with hχ_def
  obtain ⟨-, v, hviso, hv⟩ := hP
  obtain ⟨-, v', hv'iso, hv'⟩ := hP'
  obtain ⟨vinv, hv₁, hv₂, hvinv⟩ := HomAux.IsIso.exists_inv hviso

  set T : X.Hom X' := v'.comp vinv with hT_def
  have hTiso : T.IsIso := HomAux.IsIso.comp hv'iso hvinv

  have hwT : w'.comp (T.map resA) = w := by
    apply FormalODModule.Hom.ext
    have h1 : w'.comp (T.map resA) = (w'.comp (v'.map resA)).comp (vinv.map resA) := by
      rw [hT_def, HomAux.map_comp, HomAux.comp_assoc]
    have h2 : w = (w.comp (v.map resA)).comp (vinv.map resA) := by
      rw [HomAux.comp_assoc, ← HomAux.map_comp, hv₂, HomAux.map_id, HomAux.comp_id]
    rw [h1, h2, HomAux.toSeries_comp, HomAux.toSeries_comp (w.comp (v.map resA)), hv', hv]
  obtain ⟨hXθ, hwiso, hred⟩ := hrig
  obtain ⟨hXθ', hw'iso, hred'⟩ := hrig'
  have he₀f : (Iso.refl u₀.1.A).hom ≫ u₀.1.f = u₀.1.f := Category.id_comp _
  obtain ⟨e, ⟨hge, he, hemul, heact, helev, -⟩, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.existsUnique_iso_lift_of_isFormalModuleVia_of_one_mem
      coord H.hcoord H.h1 A (ResidueField O) hs (isNilpotent_ker resA hs) hqA
      (by rw [Nat.cast_one]; exact isUnit_one)
      E E' X X' θ θ' hXθ hXθ' u₀.1 u₀.1 g g' hg hg' (Iso.refl _) he₀f
      (fun t P₁ Q₁ => by rw [mapPt_refl, mapPt_refl, mapPt_refl])
      (fun x => by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
      (fun t P₁ => by rw [mapPt_refl])
      T hTiso
      (by
        intro B'' _ instAB _ _ J n hJ s hs' p₀ hp₀

        have hinst : instAB = ((algebraMap (ResidueField O) B'').comp resA).toAlgebra :=
          Algebra.algebra_ext _ _ fun r => IsScalarTower.algebraMap_apply A (ResidueField O) B'' r
        subst hinst
        letI : Algebra A B'' := ((algebraMap (ResidueField O) B'').comp resA).toAlgebra
        rw [Iso.refl_hom, Category.id_comp]

        have hp₀' : p₀ = θ₀ B'' (fun i => MvFormalGroup.nilEval n (w.toSeries i) s) := by
          apply pt_ext hg
          rw [hp₀, hred B'' J n hJ s hs']

        have hTs : (fun i => MvFormalGroup.nilEval n (T.toSeries i) s) =
            fun i => MvFormalGroup.nilEval n ((T.map resA).toSeries i) s := by
          funext i
          exact (nilEval_map_toAlgebra resA n (T.toSeries i) s).symm
        have hTsmem : ∀ i, MvFormalGroup.nilEval n ((T.map resA).toSeries i) s ∈ J :=
          fun i => nilEval_mem J n _ ((T.map resA).isODHom.constantCoeff i) s hs'
        have hpt : (fun i => MvFormalGroup.nilEval n (w.toSeries i) s) =
            fun i => MvFormalGroup.nilEval n (w'.toSeries i)
              (fun j => MvFormalGroup.nilEval n ((T.map resA).toSeries j) s) := by
          funext i
          rw [← nilEval_comp J n hJ hs' _ _ (T.map resA).isODHom.constantCoeff i, ← HomAux.toSeries_comp, hwT]
        rw [hp₀', hTs, ← hred' B'' J n hJ _ hTsmem, hpt])
  refine ⟨e, ?_, he, hemul, heact, helev⟩
  rw [hge, Iso.refl_hom, Category.id_comp]

theorem clause_surj (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    [IsAlgClosed (ResidueField O)]
    (χ : R →ₐ[O] A) (hχ : resA.comp χ.toRingHom = resR) :
    ∃ (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g),
      Φ coord θ₀ resR Xu wu resA H hs hc E g hg = χ := by
  letI instAk : Algebra A (ResidueField O) := resA.toAlgebra
  have hqA := isNilpotent_natCast H.hqO resA hs hc

  haveI : IsAlgClosed (ResidueField A) := by
    have e : ResidueField A ≃+* ResidueField O :=
      (Ideal.quotEquivOfEq (ker_eq_maximalIdeal resA hs).symm).trans (RingHom.quotientKerEquivOfSurjective hs)
    exact IsAlgClosed.of_ringEquiv (ResidueField O) (ResidueField A) e.symm

  set X : FormalODModule q A := Xu.map χ.toRingHom with hX_def
  have hXk : X.map resA = Xu.map resR := by rw [hX_def, FormalODModule.map_map, hχ]
  obtain ⟨wuinv, hwu₁, -, hwuinv⟩ := HomAux.IsIso.exists_inv H.hwu

  obtain ⟨θ₀', hθ₀', hrel⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleVia_and_apply_nilEval_eq_of_isFormalModuleVia_of_isIso
      coord (ResidueField O) u₀.1 X₀.toFormalODModule (Xu.map resR) θ₀ H.hX₀ wuinv hwuinv

  have hrel' : ∀ (B'' : Type) [CommRing B''] [Algebra (ResidueField O) B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ r : Fin 2 → B'', (∀ i, r i ∈ J) →
        θ₀' B'' r = θ₀ B'' (fun i => MvFormalGroup.nilEval n (wu.toSeries i) r) := by
    intro B'' _ _ J n hJ r hr
    have hmem : ∀ i, MvFormalGroup.nilEval n (wu.toSeries i) r ∈ J :=
      fun i => nilEval_mem J n _ (wu.isODHom.constantCoeff i) r hr
    rw [← hrel B'' J n hJ _ hmem]
    congr 1
    funext i
    rw [← nilEval_comp J n hJ hr _ _ wu.isODHom.constantCoeff i, ← HomAux.toSeries_comp, hwu₁]
    exact (nilEval_id J n hJ hr i).symm

  have h₀ : u₀.1.IsFormalModuleVia coord (X.map (algebraMap A (ResidueField O))) θ₀' := by
    rw [RingHom.algebraMap_toAlgebra, hXk]; exact hθ₀'
  obtain ⟨E, g, θ, hg, hEθ, hred⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_lift_of_isFormalModuleVia_of_isArtinianRing_of_isAlgClosed_of_one_mem
      coord H.hcoord H.h1 A (ResidueField O) hs (isNilpotent_ker resA hs) hqA (by rw [Nat.cast_one]; exact isUnit_one)
      u₀.1 X θ₀' h₀

  have hrig : Rig coord θ₀ resA E g X θ (HomAux.cast hXk.symm rfl wu) := by
    refine ⟨hEθ, HomAux.IsIso.cast hXk.symm rfl H.hwu, ?_⟩
    intro B'' _ _ _ _ J n hJ s hs'
    rw [HomAux.cast_toSeries, ← hrel' B'' J n hJ s hs']
    exact hred B'' s fun i => isNilpotent_of_mem (isNilpotent_of_pow_succ_eq_bot hJ) (hs' i)
  have hP : P resR Xu wu resA X (HomAux.cast hXk.symm rfl wu) χ := by
    refine ⟨hχ, FormalODModule.Hom.id X, HomAux.isIso_id, ?_⟩
    rw [HomAux.map_id, HomAux.comp_id, HomAux.cast_toSeries]
  exact ⟨E, g, hg, Φ_eq H hs hc hg hrig hP⟩

theorem clause_nat (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {A' : Type} [CommRing A'] [IsLocalRing A'] [IsArtinianRing A'] [Algebra O A']
    (resA' : A' →+* ResidueField O) (hs' : Function.Surjective resA') (hc' : resA'.comp (algebraMap O A') = residue O)
    (f : A →ₐ[O] A') (hf : resA'.comp f.toRingHom = resA)
    (E : FakeEllipticCurve Λ 1 A) (E' : FakeEllipticCurve Λ 1 A') (k : E'.A ⟶ E.A)
