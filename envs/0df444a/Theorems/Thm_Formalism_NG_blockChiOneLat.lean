    Fintype.card d = 1 →
    (∀ g (m : LatQ O d ρ), uElt r χ g • m = m) →
    (∀ m : LatQ O d ρ, e₁ • m = 0) → (∀ m : LatQ O d ρ, E • m = δO • m) →
    (∀ m : LatQ O d ρ, δ • m = δO • m) →
    (∀ l, ∃ g ∈ D (colIdx l), ∃ c : O, IsUnit c ∧
      ∀ m : LatQ O d ρ, k0 l g • m = ((ℓ : O) ^ e' (colIdx l) * δO * c) • m) →
