import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_diaz_iff_single_relation_of_weak_schanuel

open Complex ComplexConjugate

/-! # Diaz's modulus conjecture from weak Schanuel and the kernel form of Schanuel

Under the weak Schanuel hypothesis (n = 2), `diaz_iff_single_relation_of_weak_schanuel` reduces
Diaz's conjecture to one relation: for real `t ≠ 0` with `e^t` algebraic, `t² + π²` is
transcendental. Suppose instead `t² + π²` is algebraic. The real number `t ≠ 0` is not a rational
multiple of `2πi` (compare real parts), so the kernel form of Schanuel gives
`trdeg ℚ ℚ[π, t, e^t] ≥ 2`. But every generator is algebraic over `ℚ[π]`: `π` trivially, `e^t`
because it is algebraic over `ℚ`, and `t` because `t² = (t² + π²) − π²` is. A subalgebra
generated by elements algebraic over `ℚ[π]` has transcendence degree at most one, which is the
contradiction. The step from the kernel form of Schanuel to the single relation is standard; the transcendence-degree
helpers are those of R7. -/

namespace R11_kernelSC

/-- A subalgebra generated by elements all algebraic over `K[x]` has transcendence degree
at most one (copied from the accepted node `Transcendence.trdeg_adjoin_le_one_of_isAlgebraic_adjoin`). -/
theorem trdeg_le_one_of_adjoin_singleton {K L : Type*} [Field K] [Field L] [Algebra K L]
    {B : Subalgebra K L} {x : L} (hxB : x ∈ B)
    (halg : ∀ y ∈ B, IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) y) :
    Algebra.trdeg K ↥B ≤ 1 := by
  set x' : (↥B) := ⟨x, hxB⟩ with hx'
  have hmap : Subalgebra.map B.val (Algebra.adjoin K ({x'} : Set ↥B))
      = Algebra.adjoin K ({x} : Set L) := by
    rw [AlgHom.map_adjoin]
    congr 1
    simp [hx']
  let e : ↥(Algebra.adjoin K ({x'} : Set ↥B)) ≃ₐ[K] ↥(Algebra.adjoin K ({x} : Set L)) :=
    (Subalgebra.equivMapOfInjective _ B.val Subtype.val_injective).trans
      (Subalgebra.equivOfEq _ _ hmap)
  have : Algebra.IsAlgebraic ↥(Algebra.adjoin K ({x'} : Set ↥B)) ↥B := by
    constructor
    intro y
    refine IsAlgebraic.of_ringHom_of_comp_eq (f := (e : _ →+* _))
      (g := (B.val : ↥B →+* L)) (halg y y.2) e.surjective Subtype.val_injective ?_
    ext c
    rfl
  simpa using Algebra.IsAlgebraic.trdeg_le_cardinalMk K ({x'} : Set ↥B)

/-- `Algebra.adjoin K S` has transcendence degree at most one when every element of `S` is
algebraic over `K[x]`. -/
theorem trdeg_adjoin_le_one {K L : Type*} [Field K] [Field L] [Algebra K L] (x : L) (S : Set L)
    (hS : ∀ s ∈ S, IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) s) :
    Algebra.trdeg K ↥(Algebra.adjoin K S) ≤ 1 := by
  let E : Subalgebra K L :=
    (Subalgebra.algebraicClosure ↥(Algebra.adjoin K ({x} : Set L)) L).restrictScalars K
  have hxE : x ∈ E := by
    show IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) x
    have h : x = algebraMap ↥(Algebra.adjoin K ({x} : Set L)) L
        ⟨x, Algebra.subset_adjoin rfl⟩ := rfl
    rw [h]
    exact isAlgebraic_algebraMap _
  have hle : Algebra.adjoin K S ≤ E := Algebra.adjoin_le fun s hs => hS s hs
  exact (trdeg_le_of_injective (Subalgebra.inclusion hle)
    (Subalgebra.inclusion_injective hle)).trans
    (trdeg_le_one_of_adjoin_singleton hxE (fun _ hy => hy))

/-- The single relation, under the kernel form of Schanuel. -/
theorem single_relation
    (hSCk : ∀ a : ℂ, (∀ q : ℚ, a ≠ (q : ℂ) * (2 * ((Real.pi : ℝ) : ℂ) * Complex.I)) →
      2 ≤ Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({((Real.pi : ℝ) : ℂ), a, Complex.exp a} : Set ℂ)))
    (t : ℝ) (ht : t ≠ 0) (he : IsAlgebraic ℚ ((Real.exp t : ℝ) : ℂ)) :
    Transcendental ℚ ((t ^ 2 + Real.pi ^ 2 : ℝ) : ℂ) := by
  intro hA
  set R := Algebra.adjoin ℚ ({((Real.pi : ℝ) : ℂ)} : Set ℂ)
  have hext : ∀ z : ℂ, IsAlgebraic ℚ z → IsAlgebraic R z :=
    fun z hz => hz.extendScalars (algebraMap ℚ _).injective
  have hpi : IsAlgebraic R ((Real.pi : ℝ) : ℂ) :=
    isAlgebraic_algebraMap (⟨_, Algebra.subset_adjoin rfl⟩ : R)
  have ht2 : IsAlgebraic R ((t : ℂ) ^ 2) := by
    have h : (t : ℂ) ^ 2 = ((t ^ 2 + Real.pi ^ 2 : ℝ) : ℂ) - ((Real.pi : ℝ) : ℂ) ^ 2 := by
      push_cast; ring
    rw [h]
    exact (Subalgebra.algebraicClosure R ℂ).sub_mem (hext _ hA)
      ((Subalgebra.algebraicClosure R ℂ).pow_mem hpi 2)
  have htr := trdeg_adjoin_le_one (K := ℚ) ((Real.pi : ℝ) : ℂ)
    ({((Real.pi : ℝ) : ℂ), (t : ℂ), Complex.exp (t : ℂ)} : Set ℂ) (by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl
      · exact hpi
      · exact ht2.of_pow two_pos
      · rw [← Complex.ofReal_exp]; exact hext _ he)
  have hne : ∀ q : ℚ, (t : ℂ) ≠ (q : ℂ) * (2 * ((Real.pi : ℝ) : ℂ) * Complex.I) := by
    intro q hq
    have := congrArg Complex.re hq
    simp at this
    exact ht this
  exact absurd ((hSCk _ hne).trans htr) (by norm_num)

end R11_kernelSC

open DiazModulus R11_kernelSC in
theorem solution
    (hWSC : ∀ a b : ℂ,
      Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({a, b, Complex.exp a, Complex.exp b} : Set ℂ)) < 2 →
      ∃ m n k : ℤ, (m ≠ 0 ∨ n ≠ 0) ∧
        (m : ℂ) * a + (n : ℂ) * b = 2 * ((Real.pi : ℝ) : ℂ) * Complex.I * (k : ℂ))
    (hSCk : ∀ a : ℂ, (∀ q : ℚ, a ≠ (q : ℂ) * (2 * ((Real.pi : ℝ) : ℂ) * Complex.I)) →
      2 ≤ Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({((Real.pi : ℝ) : ℂ), a, Complex.exp a} : Set ℂ))) :
    DiazModulusConjecture :=
  (diaz_iff_single_relation_of_weak_schanuel hWSC).2 (single_relation hSCk)
