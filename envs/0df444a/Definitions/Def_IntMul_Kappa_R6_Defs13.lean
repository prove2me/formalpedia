set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE NLogN.KFB NLogN.KFL NLogN.KFW NLogN.KFH
  NLogN.KFX AModel Butterfly

/-! ## The row-addition parameters for label dimension `m` -/

/-- The row-addition parameters `[m^k, K, e, t, S0, B, r, H, i, j]`. -/
def rowVals (m k K e t S0 B r H : ℕ) (i j : Fin m) : Fin 10 → ℤ :=
  ![((m ^ k : ℕ) : ℤ), (K : ℤ), (e : ℤ), (t : ℤ), (S0 : ℤ), (B : ℤ), (r : ℤ), (H : ℤ),
    ((i : ℕ) : ℤ), ((j : ℕ) : ℤ)]

/-- The register assignment of a row addition. -/
def rowσ (m k K e t S0 B r H : ℕ) (i j : Fin m) : Fin HS → Option ℤ := fun x =>
  if h : 36 ≤ x.val ∧ x.val < 46 then
    some (rowVals m k K e t S0 B r H i j ⟨x.val - 36, by omega⟩)
  else none

/-- The background holds the row-addition parameters in the registers `rowR`. -/
def rowQ (m k K e t S0 B r H : ℕ) (i j : Fin m) (s : IState HS) : Prop :=
  Agree (rowσ m k K e t S0 B r H i j) s

/-- The bit positions of a node at level `k + 1` (row `a`, bit `c`). -/
def posR (m K e k : ℕ) : Fin m × Fin (m ^ k) → ℕ := fun p => e - K * (p.2.val + m ^ k * p.1.val)

/-! ## The shape factors -/

/-- `sR` of row `s` at level `k`. -/
abbrev srw (m K e k s : ℕ) : ℕ := KFR.sR K (m ^ k) e s

def N0R (m k K e T B i j : ℕ) : ℕ := B * 2 ^ (T - srw m K e k (s0R i j) - m ^ k * K)
def N1R (m k K e i j : ℕ) : ℕ := 2 ^ (srw m K e k (s0R i j) - srw m K e k (s1R i j) - m ^ k * K)
def N2R (m k K e i j : ℕ) : ℕ := 2 ^ (srw m K e k (s1R i j) - srw m K e k (s2R i j) - m ^ k * K)
def N3R (m k K e S0 i j : ℕ) : ℕ := 2 ^ srw m K e k (s2R i j) * S0

/-! ## Specifications of the parameter expressions -/

/-- The admissibility facts of a row-addition parameter set. -/
structure PF (m k K e T S0 B r : ℕ) : Prop where
  k1 : 1 ≤ K
  he : K * (m ^ (k + 1) - 1) ≤ e
  ht : e - e % K + K ≤ T
  s0 : 1 ≤ S0
  b : 1 ≤ B
  r : 1 ≤ r
  k6 : 6 ≤ K
  m16 : 16 ≤ m
  mle : m ≤ 1000000

end IntMul.Kappa.R6.IL2

end

