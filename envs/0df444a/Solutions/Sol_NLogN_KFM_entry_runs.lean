variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## One product through `MulOK` -/

theorem mulC_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M) (k i j : Fin HS)
    (hk : k.val < 55) (hi : i.val < 55) (hj : j.val < 55) (s : IState HS) (a c : ℤ)
    (Li Lj : List Item) (hA : s.G i = .int a :: Li) (hC : s.G j = .int c :: Lj)
    (hd : M.dom c a) :
    IRuns I iprog (mulC pM k i j) s (s.upd k (.int (c * a) :: s.G k)) (cMulC M a c) := by
  have ha : s.top i = a := IState.top_eq hA
  have hc : s.top j = c := IState.top_eq hC
  have h := RM.mul_runs (I := I) (iprog := iprog) M pM (fun _ => pM) hM k i j s
    ⟨hk, hi, hj, ⟨Li, by rw [ha]; exact hA⟩, ⟨Lj, by rw [hc]; exact hC⟩, by rw [ha, hc]; exact hd⟩
  simp only [RM.run, RM.cost, RM.mulCost, ha, hc] at h
  exact h

/-! ## Combining two products: `(u ± v).tdiv 2^Δ` pushed on `pO` -/

theorem drops4_runs (s : IState HS) (a b c d : ℤ) (L1 L2 L3 L4 : List Item)
    (h1 : s.G pX1 = .int a :: L1) (h2 : s.G pX2 = .int b :: L2) (h3 : s.G pX3 = .int c :: L3)
    (h4 : s.G pX4 = .int d :: L4) :
    IRuns I iprog (.seq (.op (.drop pX1)) (.seq (.op (.drop pX2)) (.seq (.op (.drop pX3))
      (.op (.drop pX4))))) s ((((s.upd pX1 L1).upd pX2 L2).upd pX3 L3).upd pX4 L4)
      (2 * zsz a + 2 * zsz b + 2 * zsz c + 2 * zsz d + 8) := by
  have d1 := IRuns.drop (I := I) (iprog := iprog) h1
  have d2 := IRuns.drop (I := I) (iprog := iprog) (s := s.upd pX1 L1) (i := pX2) (a := b) (L := L2)
    (by simp +decide [h2])
  have d3 := IRuns.drop (I := I) (iprog := iprog) (s := (s.upd pX1 L1).upd pX2 L2) (i := pX3)
    (a := c) (L := L3) (by simp +decide [h3])
  have d4 := IRuns.drop (I := I) (iprog := iprog) (s := ((s.upd pX1 L1).upd pX2 L2).upd pX3 L3)
    (i := pX4) (a := d) (L := L4) (by simp +decide [h4])
  exact (d1.seq (d2.seq (d3.seq d4))).mono (by omega)

/-! ## One entry -/

theorem cMulC_le {M : MulSpec} {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    {a c : ℤ} (ha : zsz a ≤ w) (hc : zsz c ≤ w) : cMulC M a c ≤ φ + 1000 * (w + 1) := by
  have h1 := dupCost_le (zsz a); have h2 := dupCost_le (zsz c)
  have h3 := moveIntCost_le (zsz (c * a)); have h4 := zsz_mul_le c a
  have h5 := hΦ c a hc ha
  unfold cMulC; omega

