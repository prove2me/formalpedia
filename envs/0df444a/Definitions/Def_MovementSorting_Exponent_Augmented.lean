-- title:
--   The augmented model of Section 4.1 and the orders P_t
-- statement:
--   The augmented model of Section 4.1: after round $j$, for $1 \le j \le r-2$, the label of the scale-$b_{j-1}$ block of every position (0-based: $\pi x / b_{j-1}$, with $b_j$ the dyadic schedule) is revealed at no cost, and the route of each later round and the output may depend on the revealed labels (`AugAlg`). Nothing is revealed when $r \le 2$. Well-formedness and correctness are as in the plain model. $P_t$ (`Pord A π t`) is the partial order generated by the relations $x < y$ for the cells $\{x,y\}$ compared (visited) in rounds $1,\dots,t$ with $\pi x < \pi y$ (the transitive closure). `SectionFourStanding d r m` is the standing assumption of Section 4: $g = b_{r-2} \ge 2$ and $b_{j-1} \ge 2 b_j$ for $1 \le j \le r-2$.
-- source:
--   Wang (2026), The Movement Complexity of Sorting, arXiv:2611.01157 (held copy SHA-256 90e3d9df…), Section 4.1, pp. 12–13

import Definitions.Def_MovementSorting_Exponent_Geometry
import Definitions.Def_MovementSorting_Exponent_Beta

set_option autoImplicit false

namespace MovementSorting.Exponent

/-! # The augmented model and the orders `P_t` (Wang 2026, §4.1, pp. 12–13)

After round `j`, for `1 ≤ j ≤ r - 2`, the label of the scale-`b_{j-1}` block of every position is
revealed at no cost (`b_j` the dyadic schedule `dyadicScale`); later routes may depend on the
revealed labels. Labels are 0-based: the label of `x` at scale `b` is `π x / b`. -/

/-- The label functions revealed before round `t + 1` (0-based `t`): the scale-`b_{i}` labels for
`i < min t (r - 2)`, i.e. those revealed after rounds `1, …, min t (r-2)`. Empty when `r ≤ 2`. -/
noncomputable def revealedLabels (d r m : ℕ) (π : Input d m) (t : ℕ) : List (Pos d m → ℕ) :=
  (List.range (min t (r - 2))).map (fun i x => (π x : ℕ) / dyadicScale d r m i)

/-- A deterministic `r`-round algorithm of the augmented model: the route of round `t + 1`
depends on the outcome lists of the earlier rounds and on the labels revealed so far; the output
on all outcome lists and all revealed labels. -/
structure AugAlg (d m r : ℕ) where
  route : ℕ → List (List Bool) → List (Pos d m → ℕ) → List (Config d m)
  output : List (List Bool) → List (Pos d m → ℕ) → List (Pos d m)

namespace AugAlg

variable {d m r : ℕ}

/-- The outcome lists of the first `t` rounds on input `π`. -/
noncomputable def history (A : AugAlg d m r) (π : Input d m) : ℕ → List (List Bool)
  | 0 => []
  | t + 1 => A.history π t ++
      [outcomes π (A.route t (A.history π t) (revealedLabels d r m π t))]

/-- The route of round `t + 1` (0-based `t`) on input `π`. -/
noncomputable def runRoute (A : AugAlg d m r) (π : Input d m) (t : ℕ) : List (Config d m) :=
  A.route t (A.history π t) (revealedLabels d r m π t)

/-- The output on input `π`. -/
noncomputable def result (A : AugAlg d m r) (π : Input d m) : List (Pos d m) :=
  A.output (A.history π r) (revealedLabels d r m π r)

/-- Well formed: every round runs a route starting at the current configuration. -/
def WellFormed (A : AugAlg d m r) : Prop :=
  ∀ π : Input d m, ∀ t < r, IsRoute (A.runRoute π t) ∧
    StartsAt (if t = 0 then none else (A.runRoute π (t - 1)).getLast?) (A.runRoute π t)

/-- Correct on every input. -/
def Correct (A : AugAlg d m r) : Prop :=
  ∀ π : Input d m, A.result π = DetAlg.sortedPositions π

/-- The generating relation of `P_t`: `x < y` when the cell `{x, y}` is compared in one of the
rounds `1, …, t` and `rk(x) < rk(y)`. -/
def precRel (A : AugAlg d m r) (π : Input d m) (t : ℕ) (x y : Pos d m) : Prop :=
  (∃ s < t, ∃ z ∈ A.runRoute π s, s(z.1, z.2) = s(x, y)) ∧ π x < π y

/-- `P_t`: the partial order generated by `precRel` (its transitive closure). -/
def Pord (A : AugAlg d m r) (π : Input d m) (t : ℕ) : Pos d m → Pos d m → Prop :=
  Relation.TransGen (A.precRel π t)

end AugAlg

/-- The standing assumption of Section 4 (p. 12), for finite `r ≥ 2`: `g = b_{r-2} ≥ 2` and
`b_{j-1} ≥ 2 b_j` for `1 ≤ j ≤ r - 2` (dyadic schedule). -/
def SectionFourStanding (d r m : ℕ) : Prop :=
  2 ≤ dyadicScale d r m (r - 2) ∧
  ∀ j : ℕ, 1 ≤ j → j ≤ r - 2 → 2 * dyadicScale d r m j ≤ dyadicScale d r m (j - 1)

end MovementSorting.Exponent


