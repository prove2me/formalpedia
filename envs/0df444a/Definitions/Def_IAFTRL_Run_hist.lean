-- title:
--   Observation σ-algebra $\mathcal F_{t-1}$
-- statement:
--   The **observation σ-algebra** before round $t$ is generated by the actions and the feedback of all earlier rounds:
--   $$
--   \mathcal F=\sigma(A_s,Y_s:\ s<t).
--   $$
--   It is the learner's information when it chooses $p_t$.
--
--   **Formalization Note** With 0-based rounds, the Lean σ-algebra at round $t$ is the paper's $\mathcal F_t$, the information before its round $t+1$.
-- source:
--   Zhao–Tan, Best-of-Both-Worlds FTRL for Linear Bandits, arXiv:2611.01299, Section 1.1, p.5

import Mathlib
import Definitions.Def_IAFTRL_Run

namespace IAFTRL

/-- **The observation σ-algebra `F_{t−1}`.** Zhao–Tan, *Best-of-Both-Worlds FTRL for Linear Bandits*, arXiv:2611.01299, Section 1.1, p.5: "We denote by `F_t` the
σ-algebra generated by `{A_1, Y_1, …, A_t, Y_t}`."

`R.hist t` is generated by the actions and feedback of the (0-based) rounds `s < t`; it is the
paper's `F_t`, the information of the learner before its round `t + 1`. -/
def Run.hist {d K : ℕ} {Ω : Type*} (R : Run d K Ω) (t : ℕ) : MeasurableSpace Ω :=
  ⨆ s, ⨆ (_ : s < t), MeasurableSpace.comap (fun ω => (R.A s ω, R.Y s ω)) inferInstance

end IAFTRL


