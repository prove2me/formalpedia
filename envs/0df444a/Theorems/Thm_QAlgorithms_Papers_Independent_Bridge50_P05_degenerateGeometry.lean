  (nu superopTensor UniversalMultiplicative rowKraus indexedKrausDilation)

open QAlgorithms.Papers.Independent.Information100.P67 (complementaryChannel)

attribute [local instance] Classical.propDecidable Classical.decEq

variable {d : ℕ} [NeZero d]

/-- Section 2, PDF pp.6--7: the actual G_psi is a subgroup of size at most d;
degenerate sets have common UNIT eigenvectors and the equality case is maximal. -/
theorem degenerateGeometry :
    (∀ psi : EuclideanSpace ℂ (ZMod d), ‖psi‖ = 1 →
      (∃ G : AddSubgroup (WeylLabel d), (G : Set (WeylLabel d)) = eigenSet psi) ∧
      (eigenSet psi).ncard ≤ d) ∧
    (∀ F : Set (WeylLabel d), Degenerate F →
      (∀ u ∈ F, ∀ v ∈ F, W u * W v = W v * W u) ∧
      Degenerate (AddSubgroup.closure F : Set (WeylLabel d)) ∧
      (∃ psi : EuclideanSpace ℂ (ZMod d), ‖psi‖ = 1 ∧ F ⊆ eigenSet psi) ∧
      F.ncard ≤ d ∧
      (F.ncard = d → ∃ G : AddSubgroup (WeylLabel d), (G : Set (WeylLabel d)) = F ∧
        MaximalDegenerate G)) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

end
