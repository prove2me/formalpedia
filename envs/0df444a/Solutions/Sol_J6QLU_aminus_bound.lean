theorem j6_qpoch_bounds (q : ℝ) (hq0 : 0 ≤ q) (hq : 2 * q ≤ 1) (n : ℕ) :
    1 - 2 * q + 2 * q ^ (n + 1) ≤ J6QLU.qpoch q n ∧ J6QLU.qpoch q n ≤ 1 := by
  induction n with
  | zero => simp [J6QLU.qpoch]
  | succ n ih =>
    have hP : J6QLU.qpoch q (n + 1) = J6QLU.qpoch q n * (1 - q ^ (n + 1)) := by
      simp [J6QLU.qpoch, Finset.prod_range_succ]
    rw [hP]
    have h1 : q ^ (n + 1) ≤ 1 := pow_le_one₀ hq0 (by linarith)
    have h2 : 0 ≤ q ^ (n + 1) := pow_nonneg hq0 _
    have h3 : q ^ (n + 2) = q * q ^ (n + 1) := by ring
    obtain ⟨ih1, ih2⟩ := ih
    have hPpos : 0 ≤ J6QLU.qpoch q n := by nlinarith
    constructor
    · rw [h3]; nlinarith
    · nlinarith

theorem j6_qR_small (α σ : ℝ) (hα : 2 ≤ α) (hσ : 1 ≤ σ) :
    0 < J6QLU.qR α σ ∧ 2.0002 * J6QLU.qR α σ ≤ 0.0001 := by
  unfold J6QLU.qR
  refine ⟨Real.exp_pos _, ?_⟩
  have hx : 24 ≤ 2 * Real.pi * α ^ 2 * σ := by
    have := Real.pi_gt_three
    have : 4 ≤ α ^ 2 := by nlinarith
    have : 12 ≤ Real.pi * α ^ 2 := by nlinarith
    nlinarith
  have h1 : Real.exp (-(2 * Real.pi * α ^ 2 * σ)) ≤ Real.exp (-24) := Real.exp_le_exp.mpr (by linarith)
  have h2 : (65536 : ℝ) ≤ Real.exp 24 := by
    have h3 : (4:ℝ) ≤ Real.exp 3 := by linarith [Real.add_one_le_exp (3:ℝ)]
    have : Real.exp 24 = Real.exp 3 ^ 8 := by rw [← Real.exp_nat_mul]; norm_num
    rw [this]
    calc (65536:ℝ) = 4 ^ 8 := by norm_num
      _ ≤ _ := pow_le_pow_left₀ (by norm_num) h3 8
  have h4 : Real.exp (-24) = (Real.exp 24)⁻¹ := Real.exp_neg 24
  have h5 : Real.exp (-24) ≤ 1 / 65536 := by
    rw [h4, ← one_div]; exact one_div_le_one_div_of_le (by norm_num) h2
  nlinarith

theorem j6_bound (α σ c θ : ℝ) (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hθ : θ ≤ c) (h : ℕ) :
    |(-1) ^ h * Real.exp (-(Real.pi * α ^ 2 * c * h)) / J6QLU.qpoch (J6QLU.qR α σ) h| ≤
      1.0001 * Real.exp (-(Real.pi * α ^ 2 * θ * h)) := by
  obtain ⟨hq0, hq⟩ := j6_qR_small α σ hα hσ
  obtain ⟨hP1, -⟩ := j6_qpoch_bounds (J6QLU.qR α σ) hq0.le (by linarith) h
  have hpow : 0 ≤ (J6QLU.qR α σ) ^ (h + 1) := pow_nonneg hq0.le _
  set P := J6QLU.qpoch (J6QLU.qR α σ) h
  have hPpos : 1 / 1.0001 ≤ P := by
    rw [div_le_iff₀ (by norm_num)]; nlinarith
  have hP0 : 0 < P := lt_of_lt_of_le (by norm_num) hPpos
  rw [abs_div, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul, abs_of_pos (Real.exp_pos _),
    abs_of_pos hP0, div_le_iff₀ hP0]
  have he : Real.exp (-(Real.pi * α ^ 2 * c * h)) ≤ Real.exp (-(Real.pi * α ^ 2 * θ * h)) := by
    apply Real.exp_le_exp.mpr
    have : 0 ≤ Real.pi * α ^ 2 * (h:ℝ) := by positivity
    nlinarith
  have hE : 0 < Real.exp (-(Real.pi * α ^ 2 * θ * h)) := Real.exp_pos _
  have : 1 ≤ 1.0001 * P := by rw [div_le_iff₀ (by norm_num)] at hPpos; linarith
  nlinarith
theorem solution (α σ b θ : ℝ) (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hθ : θ ≤ σ - 2 * |b|) (h : ℕ) :
    |aminus α σ b h| ≤ 1.0001 * exp (-(π * α ^ 2 * θ * h)) := by
  unfold aminus
  exact j6_bound α σ (σ - 2 * b) θ hα hσ (by linarith [le_abs_self b]) h
