-- title:
--   The automorphism 2-group of the circle has trivial reduction
-- statement:
--   Identify the Lie-group automorphisms of the circle $S^1$ with $\mathbb Z/2$, acting by the identity at $0$ and by inversion at $1$. Let $[\mathbb Z/2,S^1]$ be the ordinary subgroup generated by $z^{-1}\alpha(a,z)$ for $a\in\mathbb Z/2$ and $z\in S^1$. Then
--   $$[\mathbb Z/2,S^1]=S^1,\qquad \operatorname{AUT}(S^1)_{\mathrm{red}}=S^1/[\mathbb Z/2,S^1]\cong\{1\}.$$
--   This is the explicit circle calculation; it does not require the preceding general inner-automorphism criterion in Example 5.2.3(c).
-- source:
--   Connections on non-abelian Gerbes and their Holonomy, arXiv:0808.1923v3, PDF p. 50, Example 5.2.3(c), circle calculation

import Definitions.Def_QAlgorithms_Papers_Independent_Bridge50_P09

namespace QAlgorithms.Papers.Independent.Bridge50.P09

open scoped Manifold ContDiff

/-- Example 5.2.3(c), PDF p. 50, circle subcase only.
The action of `Aut(S¹) = Z/2` generates the whole circle; its reduction
is the trivial group. This does not use the preceding incorrect general
inner-automorphism biconditional printed in the same example. -/
theorem circleAutomorphism_reduction :
    actionCommutatorSubgroup circleAutomorphismAction = ⊤ ∧
      Nonempty ((Circle ⧸ actionCommutatorSubgroup circleAutomorphismAction) ≃* PUnit) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P09
