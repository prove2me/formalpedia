-- title:
--   Commuting correspondence scalarity and coprime slope-split cyclic Krylov spanning
-- statement:
--   Two linear-algebraic criteria used in the variation-symmetry and $p$-adic Frobenius cyclic-rank analyses of `four-plus-two-residual`:
--
--   1. **Commuting correspondence scalarity:** If $\ker(C - c I) = K \cdot v$, chosen powers $D^{e_i} v$ span $V$, and $Y$ commutes with both $C$ and $D$, then $Y = a I$ for some scalar $a \in K$.
--
--   2. **Coprime slope-split cyclic spanning:** Suppose $V = W_0 \sqcup W_1$, $W_0$ lies in the $T$-cyclic span of $a_0$, $W_1$ lies in the $T$-cyclic span of $a_1$, and coprime polynomials $P_0, P_1 \in K[X]$ satisfy $P_0(T) a_0 = 0$ and $P_1(T) a_1 = 0$ (as holds for ordinary crystalline Frobenius blocks of distinct $p$-adic slopes). Then the $T$-cyclic subspace generated by $a_0 + a_1$ is all of $V$.
-- source:
--   Hodge.computer Atlas instance `four-plus-two-residual` and GitHub Discussion #120, https://github.com/hodge-computer/sextics/discussions/120

import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.RingTheory.Coprime.Basic

theorem HodgeComputer.FourPlusTwoResidual.scalar_and_slopeSplit_cyclicRank :
    (∀ {K V ι : Type} [Field K] [AddCommGroup V] [Module K V]
      (exponent : ι → ℕ) (C D Y : Module.End K V) (c : K) (v : V),
      LinearMap.ker (C - c • 1) = Submodule.span K {v} →
      Submodule.span K (Set.range fun i ↦ (D ^ exponent i) v) = ⊤ →
      Commute C Y → Commute Y D →
      ∃ a : K, Y = a • (1 : Module.End K V)) ∧
    (∀ {K V : Type} [Field K] [AddCommGroup V] [Module K V]
      (T : Module.End K V) (W₀ W₁ : Submodule K V)
      (P₀ P₁ : Polynomial K) (a₀ a₁ : V),
      W₀ ⊔ W₁ = ⊤ →
      W₀ ≤ Submodule.span K (Set.range fun n : ℕ ↦ (T ^ n) a₀) →
      W₁ ≤ Submodule.span K (Set.range fun n : ℕ ↦ (T ^ n) a₁) →
      (Polynomial.aeval T P₀) a₀ = 0 →
      (Polynomial.aeval T P₁) a₁ = 0 →
      IsCoprime P₀ P₁ →
      Submodule.span K (Set.range fun n : ℕ ↦ (T ^ n) (a₀ + a₁)) = ⊤) := by sorry
