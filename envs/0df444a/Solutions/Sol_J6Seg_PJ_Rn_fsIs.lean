`fmE x y` (`fmul`), `fdE x y` (`fdiv`) with `2^P` on `9`, `2^(P+1)` on `10`; `mx0E` (`max · 0`);
`sgE` (`(-1)^h`); `bOfE` (`bOf s t l`, `s` on `22`, `t` on `23`); indicators `ltE`, `eqE`;
value lemmas, and size bounds for `fmul` / `fdiv`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

namespace E

end E

open E

section vals
variable {v : Vr} {P : ℕ}

theorem den_fdE (h9 : v 9 = 2 ^ P) (x y : E) :
    (fdE x y).den v = fdiv P (x.den v) (y.den v) := by
  simp only [fdE, E.den, h9, fdiv, rq] <;> (congr 1 <;> ring)

theorem den_ltE (x y : E) : (ltE x y).den v = if x.den v < y.den v then 1 else 0 := by
  simp only [ltE, E.den]; split_ifs <;> omega

end vals

/-! ## Size bounds -/

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD1
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D1: the pattern elimination stage (data part)

* `matL f m`: an `m × m` matrix, row-major, entry `(0,0)` first (`matL_length`, `matL_getD`,
  `matL_get2`);
* `bSE` (indicator of `bandS mw cB`, `mw` on `11`, `cB` on `12`), `flE` (the `stepI` condition at
  `(x / m, x % m)` for pivot `q` on `1`, `x` on `2`, `m` on `28`);
* `elB`: the straight-line body that pushes `Mseq (q + 1)` at position `x` onto stack `16`
  (`elB_run`, `elB_ok`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-! ## Row-major matrices -/

theorem matL_getD (f : ℕ → ℕ → ℤ) {m x : ℕ} (hx : x < m * m) :
    (matL f m).getD x 0 = f (x / m) (x % m) := by
  rw [List.getD_eq_getElem _ _ (by simpa using hx)]; simp [matL]

theorem idx_lt {m i k : ℕ} (hi : i < m) (hk : k < m) : i * m + k < m * m := by
  have : (i + 1) * m ≤ m * m := Nat.mul_le_mul_right _ hi
  nlinarith

theorem matL_get2 (f : ℕ → ℕ → ℤ) {m i k : ℕ} (hi : i < m) (hk : k < m) :
    (matL f m).getD (i * m + k) 0 = f i k := by
  rw [matL_getD f (idx_lt hi hk)]
  have hm : 0 < m := by omega
  congr 1
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt hk]; simp
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hk]

theorem matL_mem_bnd {f : ℕ → ℕ → ℤ} {m : ℕ} {V : ℤ} (h : ∀ i < m, ∀ k < m, |f i k| ≤ V) :
    ∀ x ∈ matL f m, |x| ≤ V := by
  intro y hy
  simp only [matL, List.mem_map, List.mem_range] at hy
  obtain ⟨x, hx, rfl⟩ := hy
  have hm : 0 < m := by rcases Nat.eq_zero_or_pos m with h | h <;> simp_all
  exact h _ (Nat.div_lt_of_lt_mul hx) _ (Nat.mod_lt _ hm)

/-! ## Expressions -/

theorem den_bSE {v : Vr} {mw cB a b : ℕ} (h11 : v 11 = mw) (h12 : v 12 = cB) {x y : E}
    (hx : x.den v = a) (hy : y.den v = b) :
    (bSE x y).den v = if bandS mw cB a b then 1 else 0 := by
  simp only [bSE, E.den, den_ltE, hx, hy, h11, h12, bandS]
  split_ifs <;> omega

section run
variable {v : Vr} {c : Cs} {Q m q x mw cB : ℕ} {L : List ℕ} {F : ℕ → ℕ → ℤ}

theorem castL_getD (L : List ℕ) (i : ℕ) : (L.map (fun j : ℕ => (j : ℤ))).getD i 0 = (Lg L i : ℤ) := by
  have := List.getD_map L 0 (n := i) (fun j : ℕ => (j : ℤ)); simpa only [Lg, Nat.cast_zero] using this

end run

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD4
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D4: the straight-line pieces of `serP`

For each instruction list of `serP` (`bHead`, `czI`, `czT`, `bMid`, `wbI`, `cbI`, `bTail`,
`fHead`, `cnI`, `fMid`, `fsI`, `fTail`): its run on the register file, as an `Rn` with the
registers it sets, the stack it pushes onto (`41`), and the registers it leaves alone.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem den_selB {w : Vr} {mw cB a b : ℕ} (h4 : w 4 = a) (h7 : w 7 = b) (h11 : w 11 = mw)
    (h12 : w 12 = cB) (x : E) :
    (E.sel (.sub (bSE (.r 4) (.r 7)) (.k 1)) (.k 0) x).den w =
      if bandS mw cB a b then x.den w else 0 := by
  have := den_bSE (v := w) (x := .r 4) (y := .r 7) h11 h12 h4 h7
  simp only [E.den, this]; split_ifs <;> simp_all

section pieces
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {u : Vr} {c : Cs}

theorem BdS.two (h : BdS W m L Mf) : (2 : ℕ) ≤ 2 ^ W :=
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) h.1

theorem BdS.Lb (h : BdS W m L Mf) : ∀ y ∈ L.map (fun j : ℕ => (j : ℤ)), |y| ≤ 2 ^ W := by
  intro y hy; simp only [List.mem_map] at hy; obtain ⟨j, hj, rfl⟩ := hy
  simp only [Nat.abs_cast]; exact_mod_cast h.2.2.1 j hj

theorem BdS.Mb (h : BdS W m L Mf) : ∀ y ∈ matL Mf m, |y| ≤ 2 ^ W := matL_mem_bnd h.2.2.2

/-- **Forward push step.** -/
theorem Rn.fsIs_sol_aux (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r cw i : ℕ} (h5 : u 5 = r) (h3 : u 3 = cw) (h2 : u 2 = i)
    (hi : i < cw) (hcw : cw ≤ r) (hr : r < m) (h4 : u 4 = Lg L r) :
    Rn (progL fsI) u c (fun u' => (∀ i ∉ ([6, 7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update c 41 ((if bandS mw cB (Lg L r) (Lg L (r - cw + i)) then
          fdiv Q (Mf r (r - cw + i)) (Mf (r - cw + i) (r - cw + i)) else 0) :: c 41))
      (costL W (m * m + m) fsI) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  obtain ⟨hM, hL⟩ := hS
  have h2W := hB.two
  have hq : r - cw + i < m := by omega
  have eq : (r : ℤ) - cw + i = ((r - cw + i : ℕ) : ℤ) := by omega
  have ei : (r : ℤ) * m + ((r - cw + i : ℕ) : ℤ) = ((r * m + (r - cw + i)) : ℕ) := by push_cast; ring
  have ei2 : ((r - cw + i : ℕ) : ℤ) * m + ((r - cw + i : ℕ) : ℤ) =
      (((r - cw + i) * m + (r - cw + i)) : ℕ) := by push_cast; ring
  have g1 : (matL Mf m).getD (r * m + (r - cw + i)) 0 = Mf r (r - cw + i) := matL_get2 Mf hr hq
  have g2 : (matL Mf m).getD ((r - cw + i) * m + (r - cw + i)) 0 = Mf (r - cw + i) (r - cw + i) :=
    matL_get2 Mf hq hq
  have hok : OkL W (m * m + m) fsI (u, c) := by
    simp (disch := decide) only [fsI, OkL, runL, Ins.run, Ins.ok, E.den, qfE, update_of_ne,
      update_self, h5, h2, h3, f28, hM, hL, eq, ei, ei2, Int.toNat_natCast, castL_getD, g1, g2,
      matL_length, List.length_map, hLm]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    all_goals first | exact hB.Mb | exact hB.Lb | exact_mod_cast idx_lt hr hq | exact_mod_cast idx_lt hq hq | skip
    done
  have h := Rn.insL hB.2.1 fsI hv hok
  have hc : (runL fsI (u, c)).2 = update c 41 ((if bandS mw cB (Lg L r) (Lg L (r - cw + i)) then
          fdiv Q (Mf r (r - cw + i)) (Mf (r - cw + i) (r - cw + i)) else 0) :: c 41) := by
    simp (disch := decide) only [fsI, runL, Ins.run, qfE]
    rw [den_selB (mw := mw) (cB := cB) (a := Lg L r) (b := Lg L (r - cw + i)), den_fdE (P := Q)]
    · simp (disch := decide) only [E.den, update_of_ne, update_self, h5, h2, h3, f28, hM, eq, ei,
        ei2, Int.toNat_natCast, g1, g2]
    · simp (disch := decide) only [update_of_ne, update_self, f9]
    · simp (disch := decide) only [update_of_ne, update_self, h4]
    · simp (disch := decide) only [E.den, update_of_ne, update_self, h5, h2, h3, hL, eq,
        Int.toNat_natCast, castL_getD]
    · simp (disch := decide) only [update_of_ne, update_self, f11]
    · simp (disch := decide) only [update_of_ne, update_self, f12]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, hb⟩
  intro i hi
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
  obtain ⟨i6, i7, i8, i29⟩ := hi
  simp only [fsI, runL, Ins.run, update_apply, i6, i7, i8, i29, if_false]

end pieces

end J6Seg.PJ

end

theorem solution : type_of% @J6Seg.PJ.Rn.fsIs_sol_aux := @J6Seg.PJ.Rn.fsIs_sol_aux
