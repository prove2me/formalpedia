    (hAn_tube : ∀ (s : ↥W) (ℓ : CuspidalType.ProjLine q), ∀ P ∈ (𝒞.An ℓ s).dom, (∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
