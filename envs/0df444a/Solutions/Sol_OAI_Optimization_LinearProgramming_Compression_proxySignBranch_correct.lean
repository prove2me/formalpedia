theorem proxyLargeIndices_empty_iff {n : ℕ} (fuel prec : ℕ) (mag : Fin n → ℚ) :
    proxyLargeIndices fuel prec mag = [] ↔ ∀ i, logProxyNumerator fuel prec (mag i) ≠ none := by
