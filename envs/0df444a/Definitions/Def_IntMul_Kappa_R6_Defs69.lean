/-- The pushed source list after `j` iterations. -/
def saL (P : Prm) (n j : ℕ) : List ℤ := ((List.range j).map fun i => (src6 P n i : ℤ)).reverse

/-- The pushed inverse list after `j` iterations. -/
def maL (P : Prm) (n j : ℕ) : List ℤ :=
  ((List.range j).map fun i => (muR6 (src6 P n) i : ℤ)).reverse

/-! ## The body -/

/-- One axis. -/
def jB : RS :=
  .seq (.push 39 (.pow2 (.add (.reg 33) (.sel (.add (.add (.reg 25) (.neg (.reg 48)))
    (.neg (.reg 34))) (.lit 0) (.lit 1)))))
  (.seq (.push 40 (.ndiv (.reg 39) (.mul (.lit 8) (.mul (.reg 25) (.reg 25)))))
  (.seq (.push 41 (.add (.reg 39) (.neg (.add (.reg 40) (.reg 40)))))
  (.seq (.push 42 (.lit 0))
  (.seq candR
  (.seq (.push 45 (.nmod (.reg 36) (.reg 42)))
  (.seq (.push 46 (.lit 0))
  (.seq (sumR 50 42 45 46)
  (.seq (.push 37 (.reg 42))
  (.seq (.push 38 (.reg 46))
  (.seq (.asg 36 (.mul (.reg 36) (.reg 42)))
  (.seq (.pop 46) (.seq (.pop 45) (.seq (.pop 42) (.seq (.pop 41) (.seq (.pop 40)
    (.pop 39))))))))))))))))

/-- The source loop. -/
def jR : RS := .rep 48 (.reg 25) jB

/-- The cost of one body. -/
def cJ (cm : ℕ) : ℕ := cm * (22 * cm + 52) + 60

