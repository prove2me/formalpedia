theorem isNilpotent_natCast (p : ℕ) (hpO : ((p : ℕ) : O) ∈ maximalIdeal O)
    (B : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B] [Algebra O B]
    (ρ : B →+* ResidueField O) (hρO : ρ.comp (algebraMap O B) = residue O) : IsNilpotent (p : B) := by
  have hmem : (p : B) ∈ maximalIdeal B := by
    have hsurj : Function.Surjective ρ := fun y => by
      obtain ⟨o, rfl⟩ := residue_surjective (R := O) y
      exact ⟨algebraMap O B o, by rw [← RingHom.comp_apply, hρO]⟩
    rw [← IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ρ hsurj), RingHom.mem_ker]
    have : ρ (algebraMap O B p) = 0 := by
      rw [← RingHom.comp_apply, hρO, residue_eq_zero_iff]; exact hpO
    rwa [map_natCast] at this
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := B)
  rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top] at hn
  refine ⟨n, ?_⟩
  have := Ideal.pow_mem_pow hmem n
  rw [hn, Ideal.zero_eq_bot, Ideal.mem_bot] at this
  exact this

theorem charP_residueField (p : ℕ) [Fact p.Prime] (hpO : ((p : ℕ) : O) ∈ maximalIdeal O) : CharP (ResidueField O) p := by
  refine (CharP.charP_iff_prime_eq_zero Fact.out).mpr ?_
  rw [← map_natCast (residue O), residue_eq_zero_iff]
  exact hpO

