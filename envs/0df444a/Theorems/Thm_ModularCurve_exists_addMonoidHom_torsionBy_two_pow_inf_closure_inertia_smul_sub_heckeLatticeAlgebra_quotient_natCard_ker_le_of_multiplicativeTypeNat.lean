theorem ModularCurve.exists_addMonoidHom_torsionBy_two_pow_inf_closure_inertia_smul_sub_heckeLatticeAlgebra_quotient_natCard_ker_le_of_multiplicativeTypeNat
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∃ C : ℕ, ∀ m : ℕ,
      ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
        (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
          ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ m) = 1 → σ ζ = ζ ^ n σ) →
        MultiplicativeTypeNat (B.inertiaSubgroupIn ℚ) n
          ((Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
            {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
              ∃ x ∈ eisensteinTorsionBar p 2 M, y = σ • x - x}) →
      ∃ ι : ↥((Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
            {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
              ∃ x ∈ eisensteinTorsionBar p 2 M, y = σ • x - x}) →+
          (↥(heckeLatticeAlgebra p ∅) ⧸
            Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}),
        (∀ (t : HeckeAlg)
            (x : ↥((Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
              {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x' ∈ eisensteinTorsionBar p 2 M, y = σ • x' - x'}))
            (htx : t • (x : JZero p) ∈ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
              {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x' ∈ eisensteinTorsionBar p 2 M, y = σ • x' - x'}),
          ι ⟨t • (x : JZero p), htx⟩ =
            Ideal.Quotient.mk (Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m})
              (((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) t) * ι x) ∧
        Nat.card ↥ι.ker ≤ 2 ^ C := by sorry
