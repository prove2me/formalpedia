  have hB1 : NLogN.KFU.cMv VT (p + 2) + 1 ≤ 10 ^ 6 * (T * p) := by
    unfold NLogN.KFU.cMv NLogN.KFC.kap; rw [hVT]
    have hT1 : 1 ≤ T := Nat.one_le_two_pow
