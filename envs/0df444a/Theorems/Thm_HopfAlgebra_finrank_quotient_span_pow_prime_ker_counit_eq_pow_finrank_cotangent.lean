-- title:
--   Order of the Frobenius kernel over 𝔽ₚ
-- statement:
--   Let $p$ be a prime (carried as a `Fact` instance) and let $A$ be a commutative ring equipped with the structure of a Hopf algebra over $\mathbb{Z}/p$ which is finite as a $\mathbb{Z}/p$-module. Write $\varepsilon =$ `Bialgebra.counitAlgHom (ZMod p) A` for the counit, viewed as an algebra homomorphism $A \to \mathbb{Z}/p$, and let $I = \ker \varepsilon$ be its kernel ideal (the augmentation ideal). Let $I^{[p]}$ denote the ideal of $A$ generated by the set $\{a^p : a \in I\}$, that is, the span of the image of $I$ under the $p$-th power map. The theorem asserts the equality of natural numbers
--   $$\dim_{\mathbb{Z}/p} \bigl(A / I^{[p]}\bigr) \;=\; p^{\,\dim_{\mathbb{Z}/p} (I/I^2)},$$
--   where the exponent is the $\mathbb{Z}/p$-rank of the cotangent module `Ideal.Cotangent` of $I$, i.e. of $I/I^2$, and both ranks are `Module.finrank`. No cocommutativity hypothesis is imposed, and $A$ is not assumed connected or local.
--
--   In geometric language: if $G = \operatorname{Spec} A$ is a finite commutative group scheme over $\mathbb{F}_p$, the Frobenius kernel $\ker(F : G \to G^{(p)})$ has coordinate ring $A/I^{[p]}$ and order $p^{d}$ with $d = \dim \operatorname{Lie} G$ the dimension of the cotangent space at the identity. It is used in the comparison of the kernel of Frobenius with the cokernel of Verschiebung on Dieudonné modules, and in the computation of ranks of quotients by powers of the augmentation ideal for $p$-divisible groups.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_HopfAlgebra_finrank_quotient_span_pow_prime_ker_counit_eq_pow_finrank_cotangent.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe v

theorem HopfAlgebra.finrank_quotient_span_pow_prime_ker_counit_eq_pow_finrank_cotangent
    (p : ℕ) [Fact p.Prime] (A : Type v) [CommRing A] [HopfAlgebra (ZMod p) A]
    [Module.Finite (ZMod p) A] :
    Module.finrank (ZMod p) (A ⧸ Ideal.span ((fun a : A => a ^ p) ''
          (RingHom.ker (Bialgebra.counitAlgHom (ZMod p) A) : Set A))) =
      p ^ Module.finrank (ZMod p) (RingHom.ker (Bialgebra.counitAlgHom (ZMod p) A)).Cotangent := by sorry
