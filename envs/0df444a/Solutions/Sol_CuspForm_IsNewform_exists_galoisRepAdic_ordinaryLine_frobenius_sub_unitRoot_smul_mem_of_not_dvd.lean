      calc π (ρ.ρ σ x) = π (ρ.ρ σ (b.repr x 0 • b 0 + π x • b 1)) := by rw [← hx]
        _ = b.repr x 0 * π (ρ.ρ σ (b 0)) + π x * π (ρ.ρ σ (b 1)) := by
