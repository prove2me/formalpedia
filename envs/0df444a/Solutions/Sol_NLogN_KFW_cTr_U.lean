/-!
# KFW C-layer 17: the local cost pieces in the unit `U = Yu r Zr H`

Every frame, test, `S_D` pass, scalar kernel, truncation and padding move costs at most a fixed
multiple of `U` or of `n U` (`n = P 2^{K D} S` records).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

section Pieces

variable {r Zr H : ℕ}

/-- **The truncation and its frame.** -/
theorem cTr_U_sol_aux {n Z w2 E : ℕ} (hn : 1 ≤ n) (hZ : Z ≤ Zr) (hZr : Zr + 2 ≤ r) (hw : w2 ≤ H + 2)
    (hE : E ≤ H) (hEZ : zsz (E : ℤ) ≤ Z) :
    cTrP E Z + 400 * (cTrunc w2 E (2 * (n * r)) Z + 0) + (2 * (2 * (E + Z + 1) + 2) + 1) ≤
      (10 ^ 9 * (eL.size + 2)) * (n * Yu r Zr H) := by
  have hY1 := yu_r r Zr H
  have hY2 := yu_z2 r Zr H
  have hY0 := yu_z1 r Zr H
  have h8 := yu_8 r Zr H
  have hp := pow2Cost_Y (r := r) (Z := Z) (H := H) hE hEZ (by omega)
  have hYZ : Yu r Z H ≤ Yu r Zr H := yu_monoZ hZ
  have hz2 : (Z + 2) ^ 2 ≤ (Zr + 2) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  set U := Yu r Zr H
  have hnU : U ≤ n * U := Nat.le_mul_of_pos_left _ hn
  have hrU : n * (r * (2 * H + 21)) ≤ n * U := Nat.mul_le_mul_left _ hY1
  have hEU : E + Z + 2 ≤ U := by
    have h1 : (Zr + 2) * (2 * H + 21) ≤ r * (2 * H + 21) := Nat.mul_le_mul_right _ hZr
    have h2 : H + Zr + 2 ≤ (Zr + 2) * (2 * H + 21) := by nlinarith
    omega
  have a1 : eL.size * 10 ^ 7 * (Z + 2) ^ 2 ≤ eL.size * 10 ^ 7 * U :=
    Nat.mul_le_mul_left _ (le_trans hz2 hY2)
  have a2 : 1 * 10 ^ 7 * (Z + 2) ^ 2 ≤ 10 ^ 7 * U := by
    have := le_trans hz2 hY2; nlinarith
  have a3 : cTrunc w2 E (2 * (n * r)) Z ≤ 100000 * (n * (r * (2 * H + 21))) + 10000 * U := by
    unfold cTrunc
    have b1 : 2 * (n * r) * (8100 * (w2 + E + 3) + 2100) ≤ 50000 * (n * (r * (2 * H + 21))) := by
      have : 8100 * (w2 + E + 3) + 2100 ≤ 25000 * (2 * H + 21) := by omega
      calc 2 * (n * r) * (8100 * (w2 + E + 3) + 2100) ≤ 2 * (n * r) * (25000 * (2 * H + 21)) :=
            Nat.mul_le_mul_left _ this
        _ = 50000 * (n * (r * (2 * H + 21))) := by ring
    have b2 : 2 * (n * r) * (250 * w2 + 2600) ≤ 50000 * (n * (r * (2 * H + 21))) := by
      have : 250 * w2 + 2600 ≤ 25000 * (2 * H + 21) := by omega
      calc 2 * (n * r) * (250 * w2 + 2600) ≤ 2 * (n * r) * (25000 * (2 * H + 21)) :=
            Nat.mul_le_mul_left _ this
        _ = 50000 * (n * (r * (2 * H + 21))) := by ring
    have hZU : Z + 2 ≤ U := le_trans (by omega) hY0
    linarith
  have hmZ : moveCost Z ≤ 50 * U := le_trans (moveCost_Y Z r H) (Nat.mul_le_mul_left _ hYZ)
  have hmE : moveCost (E + Z + 1) ≤ 50 * U := by unfold moveCost; omega
  have hsz : 1 ≤ eL.size + 2 := by omega
  have g : 10 ^ 9 * (eL.size + 2) * (n * U) = 10 ^ 9 * eL.size * (n * U) + 2 * 10 ^ 9 * (n * U) := by
    ring
  have a1' : eL.size * 10 ^ 7 * U ≤ 10 ^ 9 * eL.size * (n * U) := by
    have : eL.size * 10 ^ 7 * U ≤ eL.size * 10 ^ 7 * (n * U) := Nat.mul_le_mul_left _ hnU
    calc eL.size * 10 ^ 7 * U ≤ eL.size * 10 ^ 7 * (n * U) := this
      _ ≤ 10 ^ 9 * eL.size * (n * U) := by
        have : eL.size * 10 ^ 7 ≤ 10 ^ 9 * eL.size := by nlinarith
        exact Nat.mul_le_mul_right _ this
  unfold cTrP
  rw [g]
  have e7 : (10 : ℕ) ^ 7 = 10000000 := by norm_num
  have e9 : (10 : ℕ) ^ 9 = 1000000000 := by norm_num
  rw [e7] at a1 a2 a1'
  rw [e9] at a1' ⊢
  rw [e7]
  omega

end Pieces

