-- Source module: Solutions.J6SegILPreJD8
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D8: what `serP` pushes is the `jBody` layout

With `Mf = Mseq Q (bandS mw cB) L A m` (the eliminated matrix) and `L.length = m`:
* `serL_rev`: `(serL …).reverse = flatT (fsOf Q L mw cB A) ++ flatB k (bsOf Q L mw cB A)`;
* `flN_eq`: `flN cB L m = nBd (bsOf Q L mw cB A)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem range_reverse_eq (n : ℕ) : (List.range n).reverse = (List.range n).map (fun j => n - 1 - j) := by
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp only [List.getElem_reverse, List.getElem_range, List.getElem_map, List.length_range]

theorem filterMap_ite {α β : Type*} (P : α → Prop) [DecidablePred P] (g : α → β) :
    ∀ l : List α, l.filterMap (fun q => if P q then some (g q) else none) = (l.filter P).map g
  | [] => rfl
  | a :: l => by
    by_cases h : P a <;> simp [List.filterMap_cons, List.filter_cons, h, filterMap_ite P g l]

theorem card_filter_range (p : ℕ → Prop) [DecidablePred p] :
    ∀ n, ((Finset.range n).filter p).card = ((List.range n).filter p).length
  | 0 => by simp
  | n + 1 => by
    rw [Finset.range_add_one, Finset.filter_insert, List.range_succ, List.filter_append,
      List.length_append, ← card_filter_range p n]
    by_cases h : p n
    · rw [if_pos h, Finset.card_insert_of_notMem (by simp)]; simp [h]
    · rw [if_neg h]; simp [h]

section bridge
variable {Q kk m mw cB : ℕ} {L : List ℕ} {A : ℕ → ℕ → ℤ}

theorem wbN_eq (hLm : L.length = m) (r : ℕ) : wbN m mw L r = WbOf L mw r := by
  unfold wbN WbOf
  rw [hLm]
  have : (Finset.Ioo r m).filter (fun q => L.getD q 0 ≤ L.getD r 0 + mw) =
      (Finset.range m).filter (fun q => wbC mw L r q) := by
    ext q
    simp only [Finset.mem_filter, Finset.mem_Ioo, Finset.mem_range]
    exact ⟨fun ⟨⟨a, b⟩, c⟩ => ⟨b, a, c⟩, fun ⟨b, a, c⟩ => ⟨⟨a, b⟩, c⟩⟩
  rw [this, card_filter_range]

theorem cwN_eq (hLm : L.length = m) {r : ℕ} (hr : r < m) : cwN m mw cB L r = cfOf L mw cB r := by
  unfold cwN cfOf
  by_cases h1 : cB ≤ L.getD r 0
  · rw [if_pos (show cB ≤ Lg L r from h1), if_pos h1]
  · rw [if_neg (show ¬ cB ≤ Lg L r from h1), if_neg h1]
    have : (Finset.range m).filter (fun q => cwC mw L r q) =
        (Finset.range r).filter (fun q => L.getD r 0 ≤ L.getD q 0 + mw) := by
      ext q
      simp only [Finset.mem_filter, Finset.mem_range]
      exact ⟨fun ⟨_, a, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨by omega, a, b⟩⟩
    rw [← card_filter_range, this]

theorem fsP_rev (hLm : L.length = m) {r : ℕ} (hr : r < m) :
    (fsP Q m mw cB L (Mseq Q (bandS mw cB) L A m) r).reverse =
      fsW Q (bandS mw cB) L A r (cfOf L mw cB r) := by
  have hcw := cwN_eq (cB := cB) (mw := mw) hLm hr
  have hcl : cwN m mw cB L r ≤ r := cwN_le m mw cB L r
  unfold fsP fsW
  rw [← List.map_reverse, range_reverse_eq, List.map_map, ← hcw]
  apply List.map_congr_left
  intro i hi
  simp only [List.mem_range] at hi
  simp only [Function.comp, fsF, fco]
  have hq : r - cwN m mw cB L r + (cwN m mw cB L r - 1 - i) = r - 1 - i := by omega
  rw [hq]
  have hqr : r - 1 - i < r := by omega
  rw [Mseq_fin Q (bandS mw cB) L A (by omega) hr (by omega : r - 1 - i < m),
    Mseq_fin Q (bandS mw cB) L A (by omega) (by omega : r - 1 - i < m) (by omega : r - 1 - i < m),
    min_eq_right hqr.le, min_self]
  rfl

theorem cbP_rev (hLm : L.length = m) {r : ℕ} (hr : r < m) :
    (cbP m mw cB L (Mseq Q (bandS mw cB) L A m) r).reverse =
      cbOf Q (bandS mw cB) L A (cB ≤ ·) (WbOf L mw r) r := by
  have hwb := wbN_eq (mw := mw) hLm r
  have hwl : wbN m mw L r ≤ m - 1 - r := wbN_le m mw L r
  unfold cbP cbOf
  rw [← List.map_reverse, range_reverse_eq, List.map_map, ← hwb]
  apply List.map_congr_left
  intro i hi
  simp only [List.mem_range] at hi
  simp only [Function.comp, cbF]
  have hq : r + 1 + (wbN m mw L r - 1 - (wbN m mw L r - 1 - i)) = r + 1 + i := by omega
  rw [hq]
  have hqm : r + 1 + i < m := by omega
  rw [Mseq_fin Q (bandS mw cB) L A (by omega) hr hqm, min_eq_left (by omega)]
  simp only [J6Seg.Lg, hLm, hqm, true_and]
  exact if_congr Iff.rfl rfl rfl

theorem czP_eq (hLm : L.length = m) {r : ℕ} (hr : r < m) :
    czP m mw cB L (Mseq Q (bandS mw cB) L A m) r =
      (czOf Q (bandS mw cB) L A (cB ≤ ·) r).reverse := by
  set g : ℕ → ℤ := fun q => if bandS mw cB (Lg L r) (Lg L q) then
    Mseq Q (bandS mw cB) L A m r q else 0 with hg
  have h1 : czP m mw cB L (Mseq Q (bandS mw cB) L A m) r =
      (((List.range m).filter (fun q => r < q ∧ cB ≤ Lg L q)).map g).reverse := by
    unfold czP
    have : czF m mw cB L (Mseq Q (bandS mw cB) L A m) r =
        (fun q => if r < q ∧ cB ≤ Lg L q then some (g q) else none) ∘ (fun j => m - 1 - j) := rfl
    rw [this, ← List.filterMap_map, ← range_reverse_eq, filterMap_ite, List.filter_reverse,
      List.map_reverse]
  rw [h1]
  congr 1
  unfold czOf bIdx
  have hsplit : List.range m = List.range' 0 (r + 1) ++ List.range' (r + 1) (L.length - (r + 1)) := by
    have := List.range'_append_1 (s := 0) (m := r + 1) (n := m - (r + 1))
    rw [Nat.zero_add, Nat.add_sub_cancel' (by omega)] at this
    rw [hLm, List.range_eq_range', this]
  rw [hsplit, List.filter_append, List.map_append]
  have e1 : (List.range' 0 (r + 1)).filter (fun q => r < q ∧ cB ≤ Lg L q) = [] := by
    rw [List.filter_eq_nil_iff]; intro q hq; simp [List.mem_range'] at hq; simp; omega
  rw [e1, List.map_nil, List.nil_append]
  have e2 : (List.range' (r + 1) (L.length - (r + 1))).filter (fun q => r < q ∧ cB ≤ Lg L q) =
      (List.range' (r + 1) (L.length - (r + 1))).filter (fun q => flOf L (cB ≤ ·) q = 1) := by
    apply List.filter_congr
    intro q hq
    simp only [List.mem_range'] at hq
    rw [decide_eq_decide]; unfold flOf
    by_cases h : cB ≤ L.getD q 0
    · rw [if_pos h]; exact ⟨fun _ => rfl, fun _ => ⟨by omega, h⟩⟩
    · rw [if_neg h]; exact ⟨fun h' => absurd h'.2 h, fun h' => absurd h' (by decide)⟩
  rw [e2]
  apply List.map_congr_left
  intro q hq
  simp only [List.mem_filter, List.mem_range'] at hq
  simp only [hg, J6Seg.Lg]
  rw [Mseq_fin Q (bandS mw cB) L A (by omega) hr (by omega), min_eq_left (by omega)]
  rfl

theorem recP_rev (hLm : L.length = m) {r : ℕ} (hr : r < m) :
    (recP kk m mw cB L (Mseq Q (bandS mw cB) L A m) r).reverse =
      JK.recT kk (cbOf Q (bandS mw cB) L A (cB ≤ ·) (WbOf L mw r) r,
        czOf Q (bandS mw cB) L A (cB ≤ ·) r, Aseq Q (bandS mw cB) L A r (L.getD r 0) (L.getD r 0),
        flOf L (cB ≤ ·) r) := by
  have h1 := cbP_rev (Q := Q) (mw := mw) (cB := cB) (A := A) hLm hr
  have h2 := czP_eq (Q := Q) (mw := mw) (cB := cB) (A := A) hLm hr
  have h3 := wbN_eq (mw := mw) hLm r
  have h4 : Mseq Q (bandS mw cB) L A m r r = Aseq Q (bandS mw cB) L A r (L.getD r 0) (L.getD r 0) := by
    rw [Mseq_fin Q (bandS mw cB) L A (by omega) hr hr, min_self]; rfl
  have hl : (cbOf Q (bandS mw cB) L A (cB ≤ ·) (WbOf L mw r) r).length = WbOf L mw r := by
    simp [cbOf]
  unfold recP JK.recT JK.rowT
  simp only [List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
    List.append_assoc, List.cons_append, List.singleton_append, h1, h2, h4, List.reverse_reverse,
    List.length_reverse, hl, h3]
  rfl

theorem rowP_rev (hLm : L.length = m) {r : ℕ} (hr : r < m) :
    (rowP Q m mw cB L (Mseq Q (bandS mw cB) L A m) r).reverse =
      JK.rowT (fsW Q (bandS mw cB) L A r (cfOf L mw cB r)) := by
  have h1 := fsP_rev (Q := Q) (cB := cB) (mw := mw) (A := A) hLm hr
  have h2 := cwN_eq (cB := cB) (mw := mw) hLm hr
  have hl : (fsW Q (bandS mw cB) L A r (cfOf L mw cB r)).length = cfOf L mw cB r := by simp [fsW]
  unfold rowP JK.rowT
  rw [List.reverse_append, h1, hl, h2]; rfl

/-- **The pushed list is the `jBody` layout** (without the coupling windows). -/
theorem serL_rev (hLm : L.length = m) :
    (serL Q kk m mw cB L (Mseq Q (bandS mw cB) L A m)).reverse =
      JK.flatT (fsOf Q L mw cB A) ++ JK.flatB kk (bsOf Q L mw cB A) := by
  unfold serL
  rw [List.reverse_append]
  congr 1
  · rw [List.reverse_flatMap, range_reverse_eq, List.flatMap_map]
    unfold JK.flatT fsOf
    rw [hLm, List.flatMap_map]
    apply List.flatMap_congr
    intro r hr
    simp only [List.mem_range] at hr
    simp only [Function.comp]
    rw [show m - 1 - (m - 1 - r) = r by omega]
    exact rowP_rev hLm hr
  · rw [List.reverse_flatMap]
    unfold JK.flatB bsOf
    rw [hLm, List.flatMap_map]
    apply List.flatMap_congr
    intro r hr
    simp only [List.mem_reverse, List.mem_range] at hr
    exact recP_rev hLm hr

/-- **The border count is `nBd`.** -/
theorem flN_eq (hLm : L.length = m) : (flN cB L m : ℤ) = (JK.nBd (bsOf Q L mw cB A) : ℤ) := by
  congr 1
  unfold flN JK.nBd bsOf
  rw [hLm, List.filter_map, List.length_map, List.filter_reverse, List.length_reverse]
  congr 1
  apply List.filter_congr
  intro r _
  apply decide_eq_decide.mpr
  show cB ≤ L.getD r 0 ↔ flOf L (cB ≤ ·) r = 1
  unfold flOf
  by_cases h : cB ≤ L.getD r 0
  · rw [if_pos h]; exact ⟨fun _ => rfl, fun _ => h⟩
  · rw [if_neg h]; exact ⟨fun h' => absurd h' h, fun h' => absurd h' (by decide)⟩

end bridge

end J6Seg.PJ

end

