private lemma setIntegral_slice_right_Icc {β : Type*} [MeasureSpace β] [SFinite (volume : Measure β)]
    {S : Set β} (hS : MeasurableSet S) {lo hi : β → ℝ} (hlo : ∀ y ∈ S, lo y ≤ hi y)
    {f : ℝ × β → ℝ}
    (hmeas : MeasurableSet {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)})
    (hint : IntegrableOn f {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)} volume) :
    ∫ p in {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)}, f p =
      ∫ y in S, (∫ x in (lo y)..(hi y), f (x, y)) := by
  change ∫ p in {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)}, f p ∂(volume.prod volume) = _
  have hint' : IntegrableOn f {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)} (volume.prod volume) := hint
  rw [← integral_indicator hmeas, MeasureTheory.integral_prod_symm _ (hint'.integrable_indicator hmeas)]
  have heq : (fun y => ∫ x, {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)}.indicator f (x, y)) =
      S.indicator (fun y => ∫ x in (lo y)..(hi y), f (x, y)) := by
    ext y
    by_cases hy : y ∈ S
    · simp only [indicator_of_mem hy]
      rw [intervalIntegral.integral_of_le (hlo y hy), ← MeasureTheory.integral_Icc_eq_integral_Ioc,
          ← integral_indicator measurableSet_Icc]
      congr 1; ext x
      by_cases hx : x ∈ Icc (lo y) (hi y)
      · have hxy : (x, y) ∈ {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)} := ⟨hy, hx⟩
        rw [indicator_of_mem hxy, indicator_of_mem hx]
      · have hnxy : (x, y) ∉ {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)} := fun h => hx h.2
        rw [indicator_of_notMem hnxy, indicator_of_notMem hx]
    · simp only [indicator_of_notMem hy]
      have h0 : ∀ x, {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)}.indicator f (x, y) = 0 :=
        fun x => indicator_of_notMem (show (x, y) ∉ {p : ℝ × β | p.2 ∈ S ∧ p.1 ∈ Icc (lo p.2) (hi p.2)} from fun h => hy h.1) f
      simp only [h0, integral_zero]
  rw [heq, integral_indicator hS]

