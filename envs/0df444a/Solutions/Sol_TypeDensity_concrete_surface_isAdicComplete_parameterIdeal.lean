namespace TypeDensity

/-- The ideal `(T, X)` is the span of the two variables of `O[[T,X]]`. -/
private theorem variableIdeal_eq_span_range_X (O : Type) [CommRing O] :
    variableIdeal O = Ideal.span (Set.range (MvPowerSeries.X : Fin 2 → TwoSeries O)) := by
  unfold variableIdeal
  congr 1
  ext x
  simp [axisT, axisX, Fin.exists_fin_two, eq_comm]

/-- `O[[T,X]]` is complete for the ideal `(T, X)`. -/
private theorem twoSeries_isAdicComplete_variableIdeal (O : Type) [CommRing O] :
    IsAdicComplete (variableIdeal O) (TwoSeries O) := by
  rw [variableIdeal_eq_span_range_X]
  infer_instance

/-- Over a nontrivial ring, `(T, X)` is a proper ideal of `O[[T,X]]`. -/
private theorem variableIdeal_ne_top (O : Type) [CommRing O] [Nontrivial O] :
    variableIdeal O ≠ ⊤ := by
  intro h
  have h1 : (1 : TwoSeries O) ∈ variableIdeal O := h ▸ Submodule.mem_top
  rw [variableIdeal, axisT, axisX, mvPowerSeries_fin_two_mem_variableIdeal_iff] at h1
  simp at h1

end TypeDensity

open TypeDensity

theorem solution (O : Type) [CommRing O] [IsLocalRing O]
    [IsNoetherianRing O] (pi : O) (u : (TypeDensity.TwoSeries O)ˣ) (a b : ℕ) :
    IsAdicComplete (TypeDensity.surfaceParameterIdeal O pi u a b) (TypeDensity.ConcreteSurface O pi u a b) := by
  have := TypeDensity.twoSeries_isAdicComplete_variableIdeal O
  have e : TypeDensity.surfaceParameterIdeal O pi u a b =
      (TypeDensity.variableIdeal O).map (Ideal.Quotient.mk (TypeDensity.surfaceIdeal O pi u a b)) := by
    unfold TypeDensity.surfaceParameterIdeal TypeDensity.variableIdeal
    rw [Ideal.map_span, Set.image_pair]
    rfl
  exact e ▸ TypeDensity.isAdicComplete_quotient_of_iInf_sup_pow (TypeDensity.TwoSeries O) (TypeDensity.variableIdeal O)
    (TypeDensity.surfaceIdeal O pi u a b)
    (TypeDensity.iInf_sup_pow_eq_of_isLocalRing (TypeDensity.TwoSeries O) _ _ (TypeDensity.variableIdeal_ne_top O))
