-- Source module: Solutions.AModelShear
/-!
# Shears and interchanges in the array model (Lemma 10 / end of Prop. 11)

Active fields are indexed by `Fin (m + m)`: the `H` fields are `Fin.castAdd m i` (the first `m`),
the `D` fields are `Fin.natAdd m j` (the last `m`). With a `Layout` (strictly increasing
positions) every `H` field therefore precedes every `D` field.
-/

namespace AModel

open Matrix

section Blocks

variable {m Q : ℕ}

lemma blk_mulVec (P B C D : Matrix (Fin m) (Fin m) (ZMod Q)) (x : Fin (m + m) → ZMod Q) :
    hv (blk P B C D *ᵥ x) = P *ᵥ hv x + B *ᵥ dv x ∧
    dv (blk P B C D *ᵥ x) = C *ᵥ hv x + D *ᵥ dv x := by
  have key : blk P B C D *ᵥ x =
      (fromBlocks P B C D *ᵥ (x ∘ finSumFinEquiv)) ∘ finSumFinEquiv.symm := by
    rw [blk, reindex_apply, submatrix_mulVec_equiv]; rfl
  have e1 : (x ∘ finSumFinEquiv) ∘ Sum.inl = hv x := by funext i; simp [hv]
  have e2 : (x ∘ finSumFinEquiv) ∘ Sum.inr = dv x := by funext i; simp [dv]
  refine ⟨?_, ?_⟩ <;> funext i <;>
    simp [hv, dv, key, fromBlocks_mulVec, e1, e2, -Fin.natAdd_eq_addNat]

end Blocks

