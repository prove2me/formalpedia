theorem solution (n : ℕ) (ε : Bool) :
    TypeDensity.LawSafe (TypeDensity.globalLaw ε n) := by
  have normSafe : (TypeDensity.Expr.inv (if ε then TypeDensity.projectiveNormalizer n else .pow .var n)).allSafe := by
    intro q hq
    cases ε with
    | true =>
      refine ⟨?_, ne_of_gt (TypeDensity.projective_normalizer_positive n q (by positivity))⟩
      refine TypeDensity.expression_sum_safe _ _ ?_
