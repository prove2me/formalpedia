theorem positiveRoot_sum_sub_smul {r : ℕ} {V : Type*}
    [AddCommGroup V] [Module ℝ V]
    (f g : PositiveRoot r → ℝ) (v : PositiveRoot r → V) :
    (∑ γ : PositiveRoot r, (f γ - g γ) • v γ) =
