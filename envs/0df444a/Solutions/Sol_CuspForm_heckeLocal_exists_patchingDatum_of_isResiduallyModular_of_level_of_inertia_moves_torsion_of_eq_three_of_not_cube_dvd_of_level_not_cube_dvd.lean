      refine ⟨h1, h2, h3, ?_⟩
      rcases hkind with ⟨-, h⟩ | ⟨-, h⟩ | ⟨-, h⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr h)
    have hNpK3 : ∀ k, k ≤ n → ¬ p ^ 2 ∣ Nf k ∧ (p ∣ Nf k ↔ p ∣ Nf n) := fun k _ =>
