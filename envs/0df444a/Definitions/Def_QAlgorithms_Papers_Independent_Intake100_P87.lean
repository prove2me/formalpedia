-- title:
--   Definitions for Parallel Transport and Functors
-- statement:
--   The objects the formalized statements of *Parallel Transport and Functors* (arXiv:0705.0452) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `SmoothManifold`: An ordinary finite-dimensional real smooth manifold, including the empty manifold. The Hausdorff and second-countability conventions are those of Sections 1–2, PDF pp. 3–11.
--   - `manifoldModel`: The boundaryless real model of a paper-local manifold.
--   - `SittingPath`: Definition 2.1, PDF p. 7: a sitting-instant path, extended constantly outside the unit interval. The extension is canonical because the path is already constant near each endpoint.
--   - `constantSittingPath`: The constant path of Definition 2.1, PDF p. 7.
--   - `PathExpression`: Expressions for actual sitting paths, using exactly constant paths, half-speed concatenation, and reversal from PDF pp. 7–8. Expressions retain representatives before taking thin classes.
--   - `PathExpression.eval`: Evaluation of path expressions by the source's formulas, PDF pp. 7–8. In `compose later earlier`, the earlier path is traversed first.
--   - `ThinHomotopy`: Definition 2.2, PDF p. 8: a smooth square with both uniform collars and differential rank ≤ 1. Sitting instants allow the square to be extended constantly across its four boundary faces. The rank restriction is imposed at every point of the closed unit square.
--   - `ThinPathClass`: Thin classes of the evaluated expressions, Definition 2.2, PDF p. 8. `Quot` takes the equivalence relation generated by the stated geometric thin homotopies.
--   - `pathClass`: Projection of a representative expression to its thin class, PDF p. 8.
--   - `SmoothFunction`: Smooth functions between the ordinary manifolds, Section 7.1, PDF pp. 48–49.
--   - `SmoothSurjectiveSubmersion`: A smooth surjective submersion, PDF p. 11. For these finite-dimensional manifolds, submersion means a surjective derivative at every point. No global smooth section is included.
--   - `identityCover`: The identity cover, permitted by the degree-zero local-trivialization definition, PDF p. 48.
--   - `ZeroDescent`: Degree-zero descent condition (7.3), PDF p. 49. The target is only a set.
--   - `ZeroTrivialization`: Degree-zero locally trivialized maps, PDF pp. 48–49. Smoothness is not imposed here.
--   - `zeroExtract`: The actual extraction map Ex_pi of Section 7.1, PDF p. 49.
--   - `SmoothZeroDescent`: Smooth degree-zero descent data, Section 7.1, PDF p. 49.
--   - `zeroSmoothPullback`: The specified local-descent comparison: pull a global smooth function back along pi, Section 7.1, PDF p. 49.
--   - `IsZeroTransport`: Degree-zero transport, Section 7.1, PDF pp. 48–49: a set-valued map has a smooth local G-lift on some smooth surjective submersion. Neither T nor i has smooth structure.
--   - `ZeroTransport`: Transport 0-functors as the actual set of locally smoothly lifted maps, PDF p. 49.
--   - `zeroTransportOfSmooth`: The canonical comparison sends a smooth G-valued function f to i composed with f, Section 7.1, PDF p. 49.
-- source:
--   Parallel Transport and Functors, arXiv:0705.0452v5, https://arxiv.org/abs/0705.0452v5

import Mathlib

/-!
Paper-local definitions for Schreiber–Waldorf, arXiv:0705.0452v5.
Only the three target declarations below have omitted proofs.
The remaining planned targets are explicitly inventoried in HARD.md and GAPS.json.
-/

noncomputable section

open scoped ContDiff Manifold

namespace QAlgorithms.Papers.Independent.Intake100.P87

universe u v

/-- An ordinary finite-dimensional real smooth manifold, including the empty manifold.
The Hausdorff and second-countability conventions are those of Sections 1–2, PDF pp. 3–11. -/
structure SmoothManifold where
  carrier : Type u
  dimension : ℕ
  [topology : TopologicalSpace carrier]
  [charted : ChartedSpace (EuclideanSpace ℝ (Fin dimension)) carrier]
  [smooth : IsManifold (𝓘(ℝ, EuclideanSpace ℝ (Fin dimension))) ∞ carrier]
  [hausdorff : T2Space carrier]
  [secondCountable : SecondCountableTopology carrier]

attribute [instance] SmoothManifold.topology SmoothManifold.charted
  SmoothManifold.smooth SmoothManifold.hausdorff SmoothManifold.secondCountable

/-- The boundaryless real model of a paper-local manifold. -/
abbrev manifoldModel (M : SmoothManifold.{u}) :=
  𝓘(ℝ, EuclideanSpace ℝ (Fin M.dimension))

/-- Definition 2.1, PDF p. 7: a sitting-instant path, extended constantly outside the unit interval.
The extension is canonical because the path is already constant near each endpoint. -/
structure SittingPath (M : SmoothManifold.{u}) (x y : M.carrier) where
  toFun : ℝ → M.carrier
  smooth : ContMDiff (𝓘(ℝ, ℝ)) (manifoldModel M) ∞ toFun
  epsilon : ℝ
  epsilon_pos : 0 < epsilon
  epsilon_lt : epsilon < 1 / 2
  source_collar : ∀ t, t ≤ epsilon → toFun t = x
  target_collar : ∀ t, 1 - epsilon ≤ t → toFun t = y

/-- The constant path of Definition 2.1, PDF p. 7. -/
def constantSittingPath (M : SmoothManifold.{u}) (x : M.carrier) : SittingPath M x x where
  toFun := fun _ => x
  smooth := contMDiff_const
  epsilon := 1 / 4
  epsilon_pos := by norm_num
  epsilon_lt := by norm_num
  source_collar := by intros; rfl
  target_collar := by intros; rfl

example (M : SmoothManifold.{u}) (x : M.carrier) (t : ℝ) :
    (constantSittingPath M x).toFun t = x := rfl

/-- Expressions for actual sitting paths, using exactly constant paths, half-speed concatenation,
and reversal from PDF pp. 7–8. Expressions retain representatives before taking thin classes. -/
inductive PathExpression (M : SmoothManifold.{u}) : M.carrier → M.carrier → Type u
  | path {x y : M.carrier} (gamma : SittingPath M x y) : PathExpression M x y
  | constant (x : M.carrier) : PathExpression M x x
  | compose {x y z : M.carrier} (later : PathExpression M y z)
      (earlier : PathExpression M x y) : PathExpression M x z
  | reverse {x y : M.carrier} (gamma : PathExpression M x y) : PathExpression M y x

/-- Evaluation of path expressions by the source's formulas, PDF pp. 7–8.
In `compose later earlier`, the earlier path is traversed first. -/
def PathExpression.eval {M : SmoothManifold.{u}} {x y : M.carrier} :
    PathExpression M x y → ℝ → M.carrier
  | .path gamma => gamma.toFun
  | .constant x => fun _ => x
  | .compose later earlier => fun t =>
      if t ≤ 1 / 2 then earlier.eval (2 * t) else later.eval (2 * t - 1)
  | .reverse gamma => fun t => gamma.eval (1 - t)

example (M : SmoothManifold.{u}) (x : M.carrier) (t : ℝ) :
    (PathExpression.reverse (PathExpression.constant (M := M) x)).eval t = x := rfl

/-- Definition 2.2, PDF p. 8: a smooth square with both uniform collars and differential rank ≤ 1.
Sitting instants allow the square to be extended constantly across its four boundary faces.
The rank restriction is imposed at every point of the closed unit square. -/
def ThinHomotopy {M : SmoothManifold.{u}} {x y : M.carrier}
    (gamma delta : PathExpression M x y) : Prop :=
  ∃ h : ℝ × ℝ → M.carrier,
    ContMDiff (𝓘(ℝ, ℝ × ℝ)) (manifoldModel M) ∞ h ∧
    ∃ epsilon : ℝ, 0 < epsilon ∧ epsilon < 1 / 2 ∧
      (∀ s t, t ≤ epsilon → h (s, t) = x) ∧
      (∀ s t, 1 - epsilon ≤ t → h (s, t) = y) ∧
      (∀ s t, s ≤ epsilon → h (s, t) = gamma.eval t) ∧
      (∀ s t, 1 - epsilon ≤ s → h (s, t) = delta.eval t) ∧
      (∀ s t : ℝ, 0 ≤ s → s ≤ 1 → 0 ≤ t → t ≤ 1 →
        Module.finrank ℝ
          (LinearMap.range
            (mfderiv (𝓘(ℝ, ℝ × ℝ)) (manifoldModel M) h (s, t)).toLinearMap) ≤ 1)

example (M : SmoothManifold.{u}) (x : M.carrier) :
    ThinHomotopy (PathExpression.constant (M := M) x) (.constant x) := by
  refine ⟨(fun _ => x), contMDiff_const, 1 / 4, by norm_num, by norm_num,
    ?_, ?_, ?_, ?_, ?_⟩
  · intros; rfl
  · intros; rfl
  · intros; rfl
  · intros; rfl
  · intro s t hs0 hs1 ht0 ht1
    have hzero : mfderiv (𝓘(ℝ, ℝ × ℝ)) (manifoldModel M)
        (fun _ : ℝ × ℝ => x) (s, t) = 0 := mfderiv_const
    change Module.finrank ℝ (LinearMap.range
      (mfderiv (𝓘(ℝ, ℝ × ℝ)) (manifoldModel M)
        (fun _ : ℝ × ℝ => x) (s, t)).toLinearMap) ≤ 1
    rw [hzero, ContinuousLinearMap.toLinearMap_zero]
    rw [LinearMap.range_zero]
    rw [finrank_bot]
    exact Nat.zero_le 1

/-- Thin classes of the evaluated expressions, Definition 2.2, PDF p. 8.
`Quot` takes the equivalence relation generated by the stated geometric thin homotopies. -/
def ThinPathClass (M : SmoothManifold.{u}) (x y : M.carrier) :=
  Quot (fun gamma delta : PathExpression M x y => ThinHomotopy gamma delta)

/-- Projection of a representative expression to its thin class, PDF p. 8. -/
def pathClass {M : SmoothManifold.{u}} {x y : M.carrier}
    (gamma : PathExpression M x y) : ThinPathClass M x y := Quot.mk _ gamma

/-- Smooth functions between the ordinary manifolds, Section 7.1, PDF pp. 48–49. -/
def SmoothFunction (M N : SmoothManifold.{u}) :=
  {f : M.carrier → N.carrier // ContMDiff (manifoldModel M) (manifoldModel N) ∞ f}

/-- A smooth surjective submersion, PDF p. 11.
For these finite-dimensional manifolds, submersion means a surjective derivative at every point.
No global smooth section is included. -/
structure SmoothSurjectiveSubmersion (Y M : SmoothManifold.{u}) where
  toFun : Y.carrier → M.carrier
  smooth : ContMDiff (manifoldModel Y) (manifoldModel M) ∞ toFun
  surjective : Function.Surjective toFun
  derivative_surjective : ∀ y, Function.Surjective
    (mfderiv (manifoldModel Y) (manifoldModel M) toFun y)

/-- The identity cover, permitted by the degree-zero local-trivialization definition, PDF p. 48. -/
def identityCover (M : SmoothManifold.{u}) : SmoothSurjectiveSubmersion M M where
  toFun := id
  smooth := contMDiff_id
  surjective := Function.surjective_id
  derivative_surjective := by
    intro x
    rw [mfderiv_id]
    intro v
    exact ⟨v, rfl⟩

example (M : SmoothManifold.{u}) (x : M.carrier) : (identityCover M).toFun x = x := rfl

/-- Degree-zero descent condition (7.3), PDF p. 49. The target is only a set. -/
def ZeroDescent {Y M G : SmoothManifold.{u}} {T : Type v}
    (pi : SmoothSurjectiveSubmersion Y M) (i : G.carrier → T) :=
  {triv : Y.carrier → G.carrier //
    ∀ y z, pi.toFun y = pi.toFun z → i (triv y) = i (triv z)}

/-- Degree-zero locally trivialized maps, PDF pp. 48–49. Smoothness is not imposed here. -/
def ZeroTrivialization {Y M G : SmoothManifold.{u}} {T : Type v}
    (pi : SmoothSurjectiveSubmersion Y M) (i : G.carrier → T) :=
  {data : (M.carrier → T) × (Y.carrier → G.carrier) //
    ∀ y, data.1 (pi.toFun y) = i (data.2 y)}

/-- The actual extraction map Ex_pi of Section 7.1, PDF p. 49. -/
def zeroExtract {Y M G : SmoothManifold.{u}} {T : Type v}
    (pi : SmoothSurjectiveSubmersion Y M) (i : G.carrier → T)
    (data : ZeroTrivialization pi i) : ZeroDescent pi i :=
  ⟨data.val.2, by
    intro y z h
    rw [← data.property y, ← data.property z, h]⟩

/-- Smooth degree-zero descent data, Section 7.1, PDF p. 49. -/
def SmoothZeroDescent {Y M G : SmoothManifold.{u}} {T : Type v}
    (pi : SmoothSurjectiveSubmersion Y M) (i : G.carrier → T) :=
  {data : ZeroDescent pi i //
    ContMDiff (manifoldModel Y) (manifoldModel G) ∞ data.val}

/-- The specified local-descent comparison: pull a global smooth function back along pi,
Section 7.1, PDF p. 49. -/
def zeroSmoothPullback {Y M G : SmoothManifold.{u}} {T : Type v}
    (pi : SmoothSurjectiveSubmersion Y M) (i : G.carrier → T)
    (f : SmoothFunction M G) : SmoothZeroDescent pi i :=
  ⟨⟨f.val ∘ pi.toFun, by
      intro y z h
      change i (f.val (pi.toFun y)) = i (f.val (pi.toFun z))
      rw [h]⟩,
    f.property.comp pi.smooth⟩

/-- Degree-zero transport, Section 7.1, PDF pp. 48–49: a set-valued map has a smooth local
G-lift on some smooth surjective submersion. Neither T nor i has smooth structure. -/
def IsZeroTransport {M G : SmoothManifold.{u}} {T : Type v}
    (i : G.carrier → T) (f : M.carrier → T) : Prop :=
  ∃ (Y : SmoothManifold.{u}) (pi : SmoothSurjectiveSubmersion Y M)
    (triv : SmoothFunction Y G), ∀ y, f (pi.toFun y) = i (triv.val y)

/-- Transport 0-functors as the actual set of locally smoothly lifted maps, PDF p. 49. -/
def ZeroTransport (M G : SmoothManifold.{u}) {T : Type v} (i : G.carrier → T) :=
  {f : M.carrier → T // IsZeroTransport i f}

/-- The canonical comparison sends a smooth G-valued function f to i composed with f,
Section 7.1, PDF p. 49. -/
def zeroTransportOfSmooth {M G : SmoothManifold.{u}} {T : Type v}
    (i : G.carrier → T) (f : SmoothFunction M G) : ZeroTransport M G i :=
  ⟨i ∘ f.val, ⟨M, identityCover M, f, by intro y; rfl⟩⟩

example {M G : SmoothManifold.{u}} {T : Type v} (i : G.carrier → T)
    (f : SmoothFunction M G) (x : M.carrier) :
    (zeroTransportOfSmooth i f).val x = i (f.val x) := rfl

end QAlgorithms.Papers.Independent.Intake100.P87


