open Matrix Finset ProbabilityTheory
open scoped NNReal

namespace ResolvingNRM.FRLower.ProofPlan

/-! ### Finite Poisson Convolution and Binomial-Poisson Splitting -/

lemma poissonPMFReal_conv (lam mu : ℝ≥0) (k : ℕ) :
    (∑ a ∈ Finset.range (k + 1),
      poissonPMFReal lam a * poissonPMFReal mu (k - a)) =
      poissonPMFReal (lam + mu) k := by
  unfold poissonPMFReal
  rw [NNReal.coe_add, neg_add, Real.exp_add, add_pow]
  rw [Finset.mul_sum, Finset.sum_div]
  refine Finset.sum_congr rfl fun a ha => ?_
  have hale : a ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
  have hfac : (Nat.choose k a : ℝ) * (a.factorial : ℝ) * ((k - a).factorial : ℝ) =
      (k.factorial : ℝ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial hale
  have haf : (a.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero a)
  have hbf : ((k - a).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero (k - a))
  have hkf : (k.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero k)
  field_simp [haf, hbf, hkf]
  rw [← hfac]
  ring

lemma binom_poisson2_split (N a : ℕ) (ha : a ≤ N) :
    poissonPMFReal 2 N * (Nat.choose N a : ℝ) * ((1 : ℝ) / 2) ^ N =
      poissonPMFReal 1 a * poissonPMFReal 1 (N - a) := by
  unfold poissonPMFReal
  have hexp : Real.exp (-(2 : ℝ≥0)) = Real.exp (-(1 : ℝ≥0)) * Real.exp (-(1 : ℝ≥0)) := by
    rw [← Real.exp_add]
    congr 1; norm_num
  have hpow : ((2 : ℝ≥0) : ℝ) ^ N * ((1 : ℝ) / 2) ^ N = 1 := by
    rw [← mul_pow]; norm_num
  have hfac : (Nat.choose N a : ℝ) * (a.factorial : ℝ) * ((N - a).factorial : ℝ) =
      (N.factorial : ℝ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial ha
  have haf : (a.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero a)
  have hbf : ((N - a).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero (N - a))
  have hNf : (N.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero N)
  rw [hexp]
  simp only [NNReal.coe_one, one_pow, mul_one]
  calc
    Real.exp (-1) * Real.exp (-1) * ((2 : ℝ≥0) : ℝ) ^ N / (N.factorial : ℝ) *
        (Nat.choose N a : ℝ) * (1 / 2) ^ N
        = Real.exp (-1) * Real.exp (-1) * (((2 : ℝ≥0) : ℝ) ^ N * (1 / 2) ^ N) *
            (Nat.choose N a : ℝ) / (N.factorial : ℝ) := by ring
    _ = Real.exp (-1) * Real.exp (-1) * (Nat.choose N a : ℝ) / (N.factorial : ℝ) := by
        rw [hpow]; ring
    _ = (Real.exp (-1) / (a.factorial : ℝ)) * (Real.exp (-1) / ((N - a).factorial : ℝ)) := by
        field_simp [haf, hbf, hNf]
        rw [← hfac]

lemma card_cls_zeros (N a : ℕ) (_ha : a ≤ N) :
    (Finset.univ.filter (fun cls : Fin N → Fin 2 =>
      (Finset.univ.filter (fun i : Fin N => cls i = 0)).card = a)).card =
      Nat.choose N a := by
  have hbij :
      (Finset.univ.filter (fun cls : Fin N → Fin 2 =>
        (Finset.univ.filter (fun i : Fin N => cls i = 0)).card = a)).card =
      (Finset.powersetCard a (Finset.univ : Finset (Fin N))).card := by
    refine Finset.card_bij
      (fun cls _ => Finset.univ.filter (fun i : Fin N => cls i = 0))
      (fun cls hcls => ?_) (fun cls₁ _ cls₂ _ heq => ?_) (fun S hS => ?_)
    · rw [Finset.mem_powersetCard]
      exact ⟨Finset.subset_univ _, (Finset.mem_filter.mp hcls).2⟩
    · ext i
      have hi := Finset.ext_iff.mp heq i
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi
      rcases fin2_eq_or (cls₁ i) with h1 | h1 <;> rcases fin2_eq_or (cls₂ i) with h2 | h2
      · rw [h1, h2]
      · exfalso; exact absurd (hi.mp h1) (by rw [h2]; decide)
      · exfalso; exact absurd (hi.mpr h2) (by rw [h1]; decide)
      · rw [h1, h2]
    · refine ⟨fun i => if i ∈ S then 0 else 1, ?_, ?_⟩
      · rw [Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        have hsub : Finset.univ.filter (fun i : Fin N => (if i ∈ S then (0 : Fin 2) else 1) = 0) = S := by
          ext i; by_cases hi : i ∈ S <;> simp [hi]
        rw [hsub]
        exact (Finset.mem_powersetCard.mp hS).2
      · ext i; by_cases hi : i ∈ S <;> simp [hi]
  rw [hbij, Finset.card_powersetCard, Finset.card_fin]

/-! ### Antidiagonal Reindexing & Double Poisson Series -/

private lemma sigma_fin_eq {N M : ℕ} (hNM : N = M) (a : ℕ) (haN : a < N + 1) (haM : a < M + 1) :
    (⟨N, ⟨a, haN⟩⟩ : Σ k : ℕ, Fin (k + 1)) = ⟨M, ⟨a, haM⟩⟩ := by
  subst hNM; rfl

private def antidiagEquiv : (Σ N : ℕ, Fin (N + 1)) ≃ ℕ × ℕ where
  toFun x := (x.2.1, x.1 - x.2.1)
  invFun p := ⟨p.1 + p.2, ⟨p.1, Nat.lt_succ_of_le (Nat.le_add_right _ _)⟩⟩
  left_inv := fun ⟨N, ⟨a, ha⟩⟩ =>
    sigma_fin_eq (Nat.add_sub_of_le (Nat.lt_succ_iff.mp ha)) a _ ha
  right_inv := fun ⟨a, b⟩ => by ext <;> simp

lemma summable_poisson_prod_bdd (lam mu : ℝ≥0) (f : ℕ → ℕ → ℝ)
    (B : ℝ) (_hB : 0 ≤ B) (hf : ∀ a b, |f a b| ≤ B) :
    Summable (Function.uncurry (fun a b => poissonPMFReal lam a * poissonPMFReal mu b * f a b)) := by
  have h1 : Summable (poissonPMFReal lam) := summable_poissonPMFReal lam
  have h2 : Summable (poissonPMFReal mu) := summable_poissonPMFReal mu
  have hprod : Summable (fun p : ℕ × ℕ => poissonPMFReal lam p.1 * poissonPMFReal mu p.2) :=
    Summable.mul_of_nonneg h1 h2 (fun _ => poissonPMFReal_nonneg) (fun _ => poissonPMFReal_nonneg)
  refine (hprod.mul_right B).of_norm_bounded fun p => ?_
  rw [Real.norm_eq_abs]
  dsimp only [Function.uncurry]
  rw [abs_mul, abs_mul,
    abs_of_nonneg poissonPMFReal_nonneg, abs_of_nonneg poissonPMFReal_nonneg]
  exact mul_le_mul_of_nonneg_left (hf p.1 p.2)
    (mul_nonneg poissonPMFReal_nonneg poissonPMFReal_nonneg)

lemma summable_poisson_single_bdd (lam : ℝ≥0) (g : ℕ → ℝ)
    (B : ℝ) (_hB : 0 ≤ B) (hg : ∀ a, |g a| ≤ B) :
    Summable (fun a : ℕ => poissonPMFReal lam a * g a) := by
  refine ((summable_poissonPMFReal lam).mul_right B).of_norm_bounded fun a => ?_
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg poissonPMFReal_nonneg]
  exact mul_le_mul_of_nonneg_left (hg a) poissonPMFReal_nonneg

lemma abs_tsum_poisson_bdd (lam : ℝ≥0) (g : ℕ → ℝ)
    (B : ℝ) (hB : 0 ≤ B) (hg : ∀ a, |g a| ≤ B) :
    |∑' a : ℕ, poissonPMFReal lam a * g a| ≤ B := by
  have hs := summable_poisson_single_bdd lam g B hB hg
  have hnorm := norm_tsum_le_tsum_norm hs.norm
  rw [Real.norm_eq_abs] at hnorm
  refine le_trans hnorm ?_
  have hle : ∀ a : ℕ, ‖poissonPMFReal lam a * g a‖ ≤ poissonPMFReal lam a * B := by
    intro a
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg poissonPMFReal_nonneg]
    exact mul_le_mul_of_nonneg_left (hg a) poissonPMFReal_nonneg
  refine le_trans (Summable.tsum_le_tsum hle hs.norm
    ((summable_poissonPMFReal lam).mul_right B)) ?_
  have h1 := (hasSum_poissonPMFReal lam).mul_right B
  rw [one_mul] at h1
  exact le_of_eq h1.tsum_eq

lemma tsum_antidiag_eq_tsum_prod (H : ℕ → ℕ → ℝ)
    (hH : Summable (Function.uncurry H)) :
    (∑' N : ℕ, ∑ a ∈ Finset.range (N + 1), H a (N - a)) =
      ∑' a : ℕ, ∑' b : ℕ, H a b := by
  have hSigma : Summable (fun x : Σ N : ℕ, Fin (N + 1) => H x.2.1 (x.1 - x.2.1)) :=
    antidiagEquiv.summable_iff.mpr hH
  have h1 := antidiagEquiv.tsum_eq (Function.uncurry H)
  have h2 := hSigma.tsum_sigma' (fun _ => hasSum_fintype _ |>.summable)
  have h3 := hH.tsum_prod' (fun a => hH.prod_factor a)
  calc
    (∑' N : ℕ, ∑ a ∈ Finset.range (N + 1), H a (N - a))
        = ∑' N : ℕ, ∑' a : Fin (N + 1), H a.1 (N - a.1) := by
          congr 1; ext N
          rw [tsum_fintype, Fin.sum_univ_eq_sum_range (fun a => H a (N - a)) (N + 1)]
    _ = ∑' x : Σ N : ℕ, Fin (N + 1), H x.2.1 (x.1 - x.2.1) := h2.symm
    _ = ∑' p : ℕ × ℕ, H p.1 p.2 := h1
    _ = ∑' a : ℕ, ∑' b : ℕ, H a b := h3

/-! ### Single-Window Offered-Count Splitting -/

noncomputable def poissonPairExp (lam : ℝ≥0) (f : ℕ → ℕ → ℝ) : ℝ :=
  ∑' a : ℕ, poissonPMFReal lam a * (∑' b : ℕ, poissonPMFReal lam b * f a b)

lemma poissonPairExp_eq_double_tsum (lam : ℝ≥0) (f : ℕ → ℕ → ℝ) :
    poissonPairExp lam f =
      ∑' a : ℕ, ∑' b : ℕ, poissonPMFReal lam a * poissonPMFReal lam b * f a b := by
  unfold poissonPairExp
  congr 1; ext a
  rw [← tsum_mul_left]
  congr 1; ext b; ring

lemma abs_poissonPairExp_bdd (lam : ℝ≥0) (f : ℕ → ℕ → ℝ)
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ a b, |f a b| ≤ B) :
    |poissonPairExp lam f| ≤ B := by
  unfold poissonPairExp
  refine abs_tsum_poisson_bdd lam _ B hB fun a => ?_
  exact abs_tsum_poisson_bdd lam _ B hB (fun b => hf a b)

lemma stepExp_offered_pair (p : Fin 2 → ℝ) {f : ℕ → ℕ → ℝ}
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ a b, |f a b| ≤ B) :
    stepExp p (fun w => f (winOffered 0 w) (winOffered 1 w)) =
      poissonPairExp 1 f := by
  rw [poissonPairExp_eq_double_tsum]
  unfold stepExp
  let H : ℕ → ℕ → ℝ := fun a b => poissonPMFReal 1 a * poissonPMFReal 1 b * f a b
  have hH : Summable (Function.uncurry H) := summable_poisson_prod_bdd 1 1 f B hB hf
  have hN : ∀ N : ℕ,
      poissonPMFReal 2 N *
        (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
          markWeight p N cls coin *
            f (winOffered 0 ⟨N, (cls, coin)⟩) (winOffered 1 ⟨N, (cls, coin)⟩)) =
      ∑ a ∈ Finset.range (N + 1), H a (N - a) := by
    intro N
    have hcoin : ∀ cls : Fin N → Fin 2,
        (∑ coin : Fin N → Bool,
          markWeight p N cls coin *
            f (winOffered 0 ⟨N, (cls, coin)⟩) (winOffered 1 ⟨N, (cls, coin)⟩)) =
        ((1 : ℝ) / 2) ^ N *
          f (Finset.univ.filter (fun i : Fin N => cls i = 0)).card
            (N - (Finset.univ.filter (fun i : Fin N => cls i = 0)).card) := by
      intro cls
      have h0 : ∀ coin : Fin N → Bool,
          winOffered 0 ⟨N, (cls, coin)⟩ =
            (Finset.univ.filter (fun i : Fin N => cls i = 0)).card :=
        fun coin => winOffered_eq_card_filter 0 ⟨N, (cls, coin)⟩
      have h1 : ∀ coin : Fin N → Bool,
          winOffered 1 ⟨N, (cls, coin)⟩ =
            N - (Finset.univ.filter (fun i : Fin N => cls i = 0)).card := by
        intro coin
        have hadd := winOffered_add ⟨N, (cls, coin)⟩
        dsimp only at hadd
        rw [h0 coin] at hadd
        omega
      simp_rw [h0, h1, ← Finset.sum_mul, sum_coin_markWeight]
    simp_rw [hcoin]
    let cnt : (Fin N → Fin 2) → ℕ := fun cls =>
      (Finset.univ.filter (fun i : Fin N => cls i = 0)).card
    have hmaps : ∀ cls ∈ (Finset.univ : Finset (Fin N → Fin 2)),
        cnt cls ∈ Finset.range (N + 1) := by
      intro cls _
      rw [Finset.mem_range, Nat.lt_succ_iff]
      exact le_trans (Finset.card_le_univ _) (by simp)
    rw [← Finset.sum_fiberwise_of_maps_to hmaps, Finset.mul_sum]
    refine Finset.sum_congr rfl fun a ha => ?_
    have hale : a ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
    have hfib :
        (∑ cls ∈ Finset.univ.filter (fun cls : Fin N → Fin 2 => cnt cls = a),
          ((1 : ℝ) / 2) ^ N * f (cnt cls) (N - cnt cls)) =
        (Nat.choose N a : ℝ) * ((1 : ℝ) / 2) ^ N * f a (N - a) := by
      calc
        (∑ cls ∈ Finset.univ.filter (fun cls : Fin N → Fin 2 => cnt cls = a),
            ((1 : ℝ) / 2) ^ N * f (cnt cls) (N - cnt cls))
            = ∑ _cls ∈ Finset.univ.filter (fun cls : Fin N → Fin 2 => cnt cls = a),
                ((1 : ℝ) / 2) ^ N * f a (N - a) := by
              refine Finset.sum_congr rfl fun cls hcls => ?_
              rw [(Finset.mem_filter.mp hcls).2]
        _ = ((Finset.univ.filter (fun cls : Fin N → Fin 2 => cnt cls = a)).card : ℝ) *
              (((1 : ℝ) / 2) ^ N * f a (N - a)) := by
              simp [Finset.sum_const, nsmul_eq_mul]
        _ = (Nat.choose N a : ℝ) * ((1 : ℝ) / 2) ^ N * f a (N - a) := by
              rw [card_cls_zeros N a hale]; ring
    rw [hfib]
    dsimp [H]
    calc
      poissonPMFReal 2 N * ((Nat.choose N a : ℝ) * ((1 : ℝ) / 2) ^ N * f a (N - a))
          = (poissonPMFReal 2 N * (Nat.choose N a : ℝ) * ((1 : ℝ) / 2) ^ N) * f a (N - a) := by
            ring
      _ = poissonPMFReal 1 a * poissonPMFReal 1 (N - a) * f a (N - a) := by
            rw [binom_poisson2_split N a hale]
  simp_rw [hN]
  exact tsum_antidiag_eq_tsum_prod H hH

/-! ### Multi-Window Offered-Count Law & `hindsightValue` Bridge -/

private lemma poisson_conv_1d (lam mu : ℝ≥0) (g : ℕ → ℝ)
    (B : ℝ) (hB : 0 ≤ B) (hg : ∀ n, |g n| ≤ B) :
    (∑' a : ℕ, poissonPMFReal lam a * (∑' b : ℕ, poissonPMFReal mu b * g (a + b))) =
      ∑' s : ℕ, poissonPMFReal (lam + mu) s * g s := by
  let H : ℕ → ℕ → ℝ := fun a b => poissonPMFReal lam a * poissonPMFReal mu b * g (a + b)
  have hH : Summable (Function.uncurry H) :=
    summable_poisson_prod_bdd lam mu (fun a b => g (a + b)) B hB (fun a b => hg (a + b))
  have hanti := tsum_antidiag_eq_tsum_prod H hH
  have h_rhs : (∑' a : ℕ, ∑' b : ℕ, H a b) =
      ∑' a : ℕ, poissonPMFReal lam a * (∑' b : ℕ, poissonPMFReal mu b * g (a + b)) := by
    congr 1; ext a
    rw [← tsum_mul_left]
    congr 1; ext b; dsimp [H]; ring
  have h_lhs : (∑' s : ℕ, ∑ a ∈ Finset.range (s + 1), H a (s - a)) =
      ∑' s : ℕ, poissonPMFReal (lam + mu) s * g s := by
    congr 1; ext s
    have hsum : (∑ a ∈ Finset.range (s + 1), H a (s - a)) =
        (∑ a ∈ Finset.range (s + 1), poissonPMFReal lam a * poissonPMFReal mu (s - a)) * g s := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun a ha => ?_
      have hale : a ≤ s := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
      dsimp [H]
      rw [Nat.add_sub_of_le hale]
    rw [hsum, poissonPMFReal_conv]
  rw [← h_rhs, ← hanti, h_lhs]

lemma poissonPairExp_conv_one (k : ℕ) {f : ℕ → ℕ → ℝ}
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ a b, |f a b| ≤ B) :
    poissonPairExp 1 (fun a₁ b₁ => poissonPairExp (k : ℝ≥0) (fun a₂ b₂ => f (a₁ + a₂) (b₁ + b₂))) =
      poissonPairExp ((k + 1 : ℕ) : ℝ≥0) f := by
  unfold poissonPairExp
  have hk1 : (1 : ℝ≥0) + (k : ℝ≥0) = ((k + 1 : ℕ) : ℝ≥0) := by
    ext; push_cast; ring
  have hb_conv : ∀ a₁ : ℕ,
      (∑' b₁ : ℕ, poissonPMFReal 1 b₁ *
        (∑' a₂ : ℕ, poissonPMFReal (k : ℝ≥0) a₂ *
          (∑' b₂ : ℕ, poissonPMFReal (k : ℝ≥0) b₂ * f (a₁ + a₂) (b₁ + b₂)))) =
      ∑' a₂ : ℕ, poissonPMFReal (k : ℝ≥0) a₂ *
        (∑' t : ℕ, poissonPMFReal ((k + 1 : ℕ) : ℝ≥0) t * f (a₁ + a₂) t) := by
    intro a₁
    let inner : ℕ → ℕ → ℝ := fun b₁ a₂ =>
      ∑' b₂ : ℕ, poissonPMFReal (k : ℝ≥0) b₂ * f (a₁ + a₂) (b₁ + b₂)
    have hinner_bdd : ∀ b₁ a₂, |inner b₁ a₂| ≤ B := fun b₁ a₂ =>
      abs_tsum_poisson_bdd (k : ℝ≥0) _ B hB (fun b₂ => hf (a₁ + a₂) (b₁ + b₂))
    let M : ℕ → ℕ → ℝ := fun b₁ a₂ => poissonPMFReal 1 b₁ * poissonPMFReal (k : ℝ≥0) a₂ * inner b₁ a₂
    have hM : Summable (Function.uncurry M) :=
      summable_poisson_prod_bdd 1 (k : ℝ≥0) inner B hB hinner_bdd
    calc
      (∑' b₁ : ℕ, poissonPMFReal 1 b₁ *
          (∑' a₂ : ℕ, poissonPMFReal (k : ℝ≥0) a₂ * inner b₁ a₂))
          = ∑' b₁ : ℕ, ∑' a₂ : ℕ, M b₁ a₂ := by
            congr 1; ext b₁
            rw [← tsum_mul_left]
            congr 1; ext a₂; dsimp [M]; ring
      _ = ∑' a₂ : ℕ, ∑' b₁ : ℕ, M b₁ a₂ :=
            (hM.tsum_comm' (fun b₁ => hM.prod_factor b₁) (fun a₂ => hM.prod_symm.prod_factor a₂)).symm
      _ = ∑' a₂ : ℕ, poissonPMFReal (k : ℝ≥0) a₂ *
            (∑' b₁ : ℕ, poissonPMFReal 1 b₁ * inner b₁ a₂) := by
            congr 1; ext a₂
            rw [← tsum_mul_left]
            congr 1; ext b₁; dsimp [M]; ring
      _ = ∑' a₂ : ℕ, poissonPMFReal (k : ℝ≥0) a₂ *
            (∑' t : ℕ, poissonPMFReal ((k + 1 : ℕ) : ℝ≥0) t * f (a₁ + a₂) t) := by
            congr 1; ext a₂; congr 1
            have hc := poisson_conv_1d 1 (k : ℝ≥0) (fun t => f (a₁ + a₂) t) B hB
              (fun t => hf (a₁ + a₂) t)
            rwa [hk1] at hc
  simp_rw [hb_conv]
  have hgt_bdd : ∀ s : ℕ,
      |∑' t : ℕ, poissonPMFReal ((k + 1 : ℕ) : ℝ≥0) t * f s t| ≤ B := fun s =>
    abs_tsum_poisson_bdd ((k + 1 : ℕ) : ℝ≥0) _ B hB (fun t => hf s t)
  have hc := poisson_conv_1d 1 (k : ℝ≥0)
    (fun s => ∑' t : ℕ, poissonPMFReal ((k + 1 : ℕ) : ℝ≥0) t * f s t) B hB hgt_bdd
  rwa [hk1] at hc

lemma poissonPairExp_zero (f : ℕ → ℕ → ℝ) :
    poissonPairExp 0 f = f 0 0 := by
  unfold poissonPairExp
  have hp0 : ∀ n : ℕ, poissonPMFReal 0 n = if n = 0 then 1 else 0 := by
    intro n
    cases n with
    | zero => simp [poissonPMFReal]
    | succ m => simp [poissonPMFReal]
  simp_rw [hp0]
  have hinner : ∀ a : ℕ,
      (∑' b : ℕ, (if b = 0 then (1 : ℝ) else 0) * f a b) = f a 0 := by
    intro a
    have : (fun b : ℕ => (if b = 0 then (1 : ℝ) else 0) * f a b) =
        (fun b : ℕ => if b = 0 then f a 0 else 0) := by
      ext b; by_cases hb : b = 0 <;> simp [hb]
    rw [this, tsum_ite_eq]
  simp_rw [hinner]
  have hout : (fun a : ℕ => (if a = 0 then (1 : ℝ) else 0) * f a 0) =
      (fun a : ℕ => if a = 0 then f 0 0 else 0) := by
    ext a; by_cases ha : a = 0 <;> simp [ha]
  rw [hout, tsum_ite_eq]

/-- Over `k` windows from any starting history `h`, offered counts distribute as independent
`Poisson(k)` increments added to `histOffered _ h`, regardless of the adaptive policy `p`! -/
theorem treeExp_offered_pair (p : Policy) (k : ℕ) (h : History)
    {f : ℕ → ℕ → ℝ} (B : ℝ) (hB : 0 ≤ B) (hf : ∀ a b, |f a b| ≤ B) :
    treeExp p k h (fun h' => f (histOffered 0 h') (histOffered 1 h')) =
      poissonPairExp (k : ℝ≥0) (fun da db =>
        f (histOffered 0 h + da) (histOffered 1 h + db)) := by
  induction k generalizing h with
  | zero =>
    simp [treeExp, poissonPairExp_zero]
  | succ k ih =>
    simp only [treeExp]
    have hchild : ∀ w : Window,
        treeExp p k (h ++ [w]) (fun h' => f (histOffered 0 h') (histOffered 1 h')) =
          poissonPairExp (k : ℝ≥0) (fun da db =>
            f (histOffered 0 h + (winOffered 0 w + da))
              (histOffered 1 h + (winOffered 1 w + db))) := by
      intro w
      rw [ih (h ++ [w])]
      simp only [histOffered_append, histOffered_singleton, Nat.add_assoc]
    simp_rw [hchild]
    have hpair_bdd : ∀ a₁ b₁ : ℕ,
        |poissonPairExp (k : ℝ≥0) (fun da db =>
          f (histOffered 0 h + (a₁ + da)) (histOffered 1 h + (b₁ + db)))| ≤ B :=
      fun a₁ b₁ => abs_poissonPairExp_bdd (k : ℝ≥0) _ B hB
        (fun da db => hf (histOffered 0 h + (a₁ + da)) (histOffered 1 h + (b₁ + db)))
    rw [stepExp_offered_pair (p h) B hB hpair_bdd]
    exact poissonPairExp_conv_one k B hB (fun a b => hf (histOffered 0 h + a) (histOffered 1 h + b))

/-- Single-class specialization: offered high-fare increment `histOffered 0 h' - histOffered 0 h`
over `k` windows has expectation `∑' a, poissonPMFReal k a * g a`, independent of `h` and `p`! -/
theorem treeExp_offered_high_inc (p : Policy) (k : ℕ) (h : History)
    {g : ℕ → ℝ} (B : ℝ) (hB : 0 ≤ B) (hg : ∀ a, |g a| ≤ B) :
    treeExp p k h (fun h' => g (histOffered 0 h' - histOffered 0 h)) =
      ∑' a : ℕ, poissonPMFReal (k : ℝ≥0) a * g a := by
  have hpair := treeExp_offered_pair p k h B hB
    (f := fun x _ => g (x - histOffered 0 h)) (fun x _ => hg (x - histOffered 0 h))
  rw [hpair]
  unfold poissonPairExp
  congr 1; ext a
  simp only [Nat.add_sub_cancel_left, tsum_mul_right,
    (hasSum_poissonPMFReal (k : ℝ≥0)).tsum_eq, one_mul]

private def fin2NatEquiv : (Fin 2 → ℕ) ≃ ℕ × ℕ where
  toFun k := (k 0, k 1)
  invFun q := ![q.1, q.2]
  left_inv k := by
    ext j; rcases fin2_eq_or j with rfl | rfl <;> simp
  right_inv := fun ⟨_, _⟩ => by simp

/-- Exact bridge from `hindsightValue` to `treeExp` on the same `canonicalPolicy T` tree! -/
theorem hindsightValue_eq_treeExp_piValue
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (p : Policy) (T : ℕ) :
    hindsightValue (tcInst r₁ r₂ hr₂ hr) (T : ℝ) (initialCapacity T) =
      treeExp p T [] (fun h' =>
        RLPBidPrice.Unbiased.piValue
          (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
          ![(histOffered 0 h' : ℝ), (histOffered 1 h' : ℝ)]) := by
  have hr₁ : 0 < r₁ := lt_trans hr₂ hr
  let f : ℕ → ℕ → ℝ := fun a b =>
    RLPBidPrice.Unbiased.piValue
      (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
      ![(a : ℝ), (b : ℝ)]
  have hf_bdd : ∀ a b, |f a b| ≤ r₁ * (T : ℝ) := by
    intro a b
    have hy₀ : 0 ≤ (![(a : ℝ), (b : ℝ)] : Fin 2 → ℝ) := by
      intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
    rw [abs_of_nonneg (piValue_tcInst_nonneg r₁ r₂ hr₂ hr T _ hy₀)]
    exact piValue_tcInst_le r₁ r₂ hr₂ hr T _ hy₀
  have htree := treeExp_offered_pair p T [] (r₁ * (T : ℝ)) (by positivity) hf_bdd
  simp only [histOffered_nil, Nat.zero_add] at htree
  rw [htree, poissonPairExp_eq_double_tsum]
  unfold hindsightValue
  have hsum := summable_poisson_prod_bdd (T : ℝ≥0) (T : ℝ≥0) f (r₁ * (T : ℝ)) (by positivity) hf_bdd
  have hprod_eq := hsum.tsum_prod' (fun a => hsum.prod_factor a)
  dsimp only [Function.uncurry] at hprod_eq
  rw [← hprod_eq, ← fin2NatEquiv.tsum_eq]
  congr 1; ext k
  have hrate : ∀ j : Fin 2,
      ((tcInst r₁ r₂ hr₂ hr).lam j * (T : ℝ)).toNNReal = (T : ℝ≥0) := by
    intro j
    rcases fin2_eq_or j with rfl | rfl <;> { ext; simp [tcInst, twoClass] }
  have hvec : (fun j : Fin 2 => (k j : ℝ)) = ![(k 0 : ℝ), (k 1 : ℝ)] := by
    ext j; rcases fin2_eq_or j with rfl | rfl <;> simp
  simp only [Fin.prod_univ_two, hrate, fin2NatEquiv, Equiv.coe_fn_mk, hvec, f, Function.uncurry]

