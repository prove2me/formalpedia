variable {F : Type} [Field F]

theorem getD_append_single_lt {α : Type} (l : List α) (x d : α) {n : ℕ} (h : n < l.length) :
    (l ++ [x]).getD n d = l.getD n d := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_append, if_pos h]

theorem getD_append_single_length {α : Type} (l : List α) (x d : α) :
    (l ++ [x]).getD l.length d = x := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_append, if_neg (by omega), Nat.sub_self]
  simp

theorem getD_append_pair_lt {α : Type} (l : List α) (x y d : α) {n : ℕ} (h : n < l.length) :
    (l ++ [x, y]).getD n d = l.getD n d := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_append, if_pos h]

theorem getD_append_pair_left {α : Type} (l : List α) (x y d : α) :
    (l ++ [x, y]).getD l.length d = x := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_append, if_neg (by omega), Nat.sub_self]
  simp

theorem getD_append_pair_right {α : Type} (l : List α) (x y d : α) :
    (l ++ [x, y]).getD (l.length + 1) d = y := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_append, if_neg (by omega),
    show l.length + 1 - l.length = 1 from by omega]
  simp

theorem slpEval_single (vals : List F) (o : Bool × ℕ × ℕ) :
    slpEval vals [o] = vals ++ [opVal vals o] := rfl

theorem slpEval_append (vals : List F) (o1 o2 : List (Bool × ℕ × ℕ)) :
    slpEval vals (o1 ++ o2) = slpEval (slpEval vals o1) o2 := by
  simp only [slpEval, List.foldl_append]

theorem opVal_append_single (vals : List F) (x : F) (o : Bool × ℕ × ℕ)
    (h1 : o.2.1 < vals.length) (h2 : o.2.2 < vals.length) :
    opVal (vals ++ [x]) o = opVal vals o := by
  simp only [opVal]
  rw [getD_append_single_lt vals x 0 h1, getD_append_single_lt vals x 0 h2]

/-- Two instructions whose operands both point into the list computed so far. -/
theorem slpEval_pair (vals : List F) (o1 o2 : Bool × ℕ × ℕ)
    (h1 : o1.2.1 < vals.length) (h2 : o1.2.2 < vals.length)
    (h3 : o2.2.1 < vals.length) (h4 : o2.2.2 < vals.length) :
    slpEval vals [o1, o2] = vals ++ [opVal vals o1, opVal vals o2] := by
  rw [show [o1, o2] = [o1] ++ [o2] from rfl, slpEval_append, slpEval_single, slpEval_single,
    opVal_append_single vals _ o2 h3 h4, List.append_assoc]
  rfl

theorem opN_zero (t : ℕ) : opN t 0 = [(true, 0, 0)] := rfl

theorem pwN_zero (t : ℕ) : pwN t 0 = 0 := rfl

theorem opN_succ (t n : ℕ) :
    opN t (n + 1) = opN t n ++ [(false, n + 1, pwN t n), (true, t + 1, pwN t n)] := rfl

theorem pwN_succ (t n : ℕ) : pwN t (n + 1) = t + 3 + 2 * n := rfl

theorem opN_length (t n : ℕ) : (opN t n).length = 1 + 2 * n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [opN_succ, List.length_append, ih]
      simp
      omega

theorem pwN_lt (t n : ℕ) : pwN t n < t + 2 + 2 * n := by
  induction n with
  | zero => rw [pwN_zero]; omega
  | succ n ih => rw [pwN_succ]; omega

/-- The value of the first `t + 1` entries of the list `a :: s`. -/
theorem getD_cons_ofFn {t : ℕ} (a : F) (s : Fin t → F) (m : Fin t) :
    (a :: List.ofFn s).getD ((m : ℕ) + 1) 0 = s m := by
  rw [List.getD_cons_succ, List.getD_eq_getElem?_getD, List.getElem?_ofFn]
  simp [m.isLt]

theorem slpAux_spec (t n : ℕ) (hn : n ≤ t) (a : F) (s : Fin t → F) :
    SlpInv t a s n (slpEval (a :: List.ofFn s) (opN t n)) := by
  revert hn
  induction n with
  | zero =>
      intro _hn
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · rw [opN_zero, slpEval_single, List.length_append]
        simp
      · intro m
        rw [opN_zero, slpEval_single, getD_append_single_lt _ _ _ (by simp), getD_cons_ofFn]
      · rw [opN_zero, slpEval_single]
        have hin : (a :: List.ofFn s).length = t + 1 := by simp
        rw [← hin, getD_append_single_length]
        simp [opVal, pow_two]
      · rw [opN_zero, pwN_zero, slpEval_single]
        rw [getD_append_single_lt _ _ _ (by simp), List.getD_cons_zero]
        simp
      · intro j hj
        omega
  | succ n ih =>
      intro hn
      have hn' : n ≤ t := by omega
      obtain ⟨h1, h2, h3, h4, h5⟩ := ih hn'
      have hlen : (slpEval (a :: List.ofFn s) (opN t n)).length = t + 2 + 2 * n := h1
      have hstep : slpEval (a :: List.ofFn s) (opN t (n + 1)) =
          slpEval (a :: List.ofFn s) (opN t n) ++
            [opVal (slpEval (a :: List.ofFn s) (opN t n)) (false, n + 1, pwN t n),
             opVal (slpEval (a :: List.ofFn s) (opN t n)) (true, t + 1, pwN t n)] := by
        rw [opN_succ, slpEval_append]
        exact slpEval_pair _ _ _
          (by show n + 1 < (slpEval (a :: List.ofFn s) (opN t n)).length; rw [hlen]; omega)
          (by show pwN t n < (slpEval (a :: List.ofFn s) (opN t n)).length
              rw [hlen]; exact pwN_lt t n)
          (by show t + 1 < (slpEval (a :: List.ofFn s) (opN t n)).length; rw [hlen]; omega)
          (by show pwN t n < (slpEval (a :: List.ofFn s) (opN t n)).length
              rw [hlen]; exact pwN_lt t n)
      have hnt : n < t := by omega
      have hadd : opVal (slpEval (a :: List.ofFn s) (opN t n)) (false, n + 1, pwN t n)
          = s ⟨n, hnt⟩ + a ^ (2 * n + 1) := by
        have h2n : (slpEval (a :: List.ofFn s) (opN t n)).getD (n + 1) 0 = s ⟨n, hnt⟩ := by
          simpa using h2 ⟨n, hnt⟩
        simp only [opVal]
        rw [if_neg (by simp), h2n, h4]
      have hmul : opVal (slpEval (a :: List.ofFn s) (opN t n)) (true, t + 1, pwN t n)
          = a ^ (2 * (n + 1) + 1) := by
        simp only [opVal]
        rw [if_pos trivial, h3, h4, ← pow_add]
        congr 1
        omega
      rw [hstep]
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · rw [List.length_append]
        simp only [List.length_cons, List.length_nil]
        omega
      · intro m
        rw [getD_append_pair_lt _ _ _ _ (by rw [hlen]; have := m.isLt; omega)]
        exact h2 m
      · rw [getD_append_pair_lt _ _ _ _ (by rw [hlen]; omega)]
        exact h3
      · rw [pwN_succ]
        rw [show t + 3 + 2 * n = (slpEval (a :: List.ofFn s) (opN t n)).length + 1 by
          rw [hlen]; omega]
        rw [getD_append_pair_right]
        exact hmul
      · intro j hj
        by_cases hjn : (j : ℕ) < n
