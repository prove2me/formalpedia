theorem roundB_runs (Δ : ℕ) (h : ℤ) (s : IState HS) (LR LH : List Item)
    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hH : s.G pX2 = .int h :: LH)
    (st : IState HS) (x : ℤ) (L0 : List Item) (hF : Fixd s st) (h0 : st.G 0 = .int x :: L0) :
    IRuns I iprog roundB st ((st.upd 0 L0).upd pO (.int ((x + h).tdiv (2 ^ Δ)) :: st.G pO))
      (110 * (zsz x + 1) + 300 * (zsz h + 1) + 1000 * (zsz x + zsz h + Δ + 3)) := by
  have hR' : st.G pR = .int (2 ^ Δ) :: LR := by
    rw [hF pR (by decide) (by decide) (by decide) (by decide) (by decide), hR]
  have hH' : st.G pX2 = .int h :: LH := by
    rw [hF pX2 (by decide) (by decide) (by decide) (by decide) (by decide), hH]
