theorem exists_pos_pow_forall_apply_eq {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω]
    (K' : IntermediateField K Ω) [FiniteDimensional K ↥K'] (σ : Ω ≃ₐ[K] Ω) :
    ∃ M : ℕ, 0 < M ∧ ∀ x : Ω, x ∈ K' → (σ ^ M) x = x := by
  classical
  let F : ℕ → (↥K' →ₐ[K] Ω) := fun n => ((σ ^ n : Ω ≃ₐ[K] Ω) : Ω →ₐ[K] Ω).comp K'.val
  obtain ⟨i, j, hij, hF⟩ := Finite.exists_ne_map_eq_of_infinite F

  have key : ∀ i j : ℕ, i < j → F i = F j → ∀ x : Ω, x ∈ K' → (σ ^ (j - i)) x = x := by
    intro i j h hF x hx
    have h1 : (σ ^ i) x = (σ ^ j) x := AlgHom.congr_fun hF ⟨x, hx⟩
    have e : σ ^ j = σ ^ i * σ ^ (j - i) := by rw [← pow_add, Nat.add_sub_cancel' h.le]
    rw [e, AlgEquiv.mul_apply] at h1
    exact ((σ ^ i).injective h1).symm
  rcases lt_or_gt_of_ne hij with h | h
  · exact ⟨j - i, Nat.sub_pos_of_lt h, key i j h hF⟩
  · exact ⟨i - j, Nat.sub_pos_of_lt h, key j i h hF.symm⟩

theorem mem_inertiaSubgroupIn_iff {F Ω : Type} [Field F] [Field Ω] [Algebra F Ω]
    (A : ValuationSubring Ω) (σ : Ω ≃ₐ[F] Ω) :
    σ ∈ A.inertiaSubgroupIn F ↔
      ∃ h : σ ∈ A.decompositionSubgroup F, (⟨σ, h⟩ : ↥(A.decompositionSubgroup F)) ∈ A.inertiaSubgroup F := by
  rw [ValuationSubring.inertiaSubgroupIn, Subgroup.mem_map]
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g.2, hg⟩
  · rintro ⟨h, hg⟩
    exact ⟨⟨σ, h⟩, hg, rfl⟩

theorem mem_decompositionSubgroup_iff {F Ω : Type} [Field F] [Field Ω] [Algebra F Ω]
    (A : ValuationSubring Ω) (σ : Ω ≃ₐ[F] Ω) :
    σ ∈ A.decompositionSubgroup F ↔ ∀ x : Ω, (∃ a : Ω, a ∈ A ∧ σ a = x) ↔ x ∈ A := by
  rw [MulAction.mem_stabilizer_iff, SetLike.ext_iff]
  refine forall_congr' fun x => ?_
  rw [ValuationSubring.mem_smul_pointwise_iff_exists]
  rfl

theorem mem_inertiaSubgroup_iff {F Ω : Type} [Field F] [Field Ω] [Algebra F Ω]
    (A : ValuationSubring Ω) (g : ↥(A.decompositionSubgroup F)) :
    g ∈ A.inertiaSubgroup F ↔
      ∀ a : ↥A, IsLocalRing.residue ↥A (g • a) = IsLocalRing.residue ↥A a := by
  rw [ValuationSubring.inertiaSubgroup, MonoidHom.mem_ker]
  constructor
  · intro h a
    have := RingEquiv.congr_fun h (IsLocalRing.residue ↥A a)
    rw [RingAut.one_apply] at this
    rw [IsLocalRing.ResidueField.residue_smul]
    exact this
  · intro h
    apply RingEquiv.ext
    intro z
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective z
    rw [RingAut.one_apply]
    have := h a
    rw [IsLocalRing.ResidueField.residue_smul] at this
    exact this

theorem restrictScalars_mem_inertiaSubgroupIn_iff {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω]
    (K' : IntermediateField K Ω) (A : ValuationSubring Ω) (τ : Ω ≃ₐ[↥K'] Ω) :
    τ.restrictScalars K ∈ A.inertiaSubgroupIn K ↔ τ ∈ A.inertiaSubgroupIn ↥K' := by
  have hdec : τ.restrictScalars K ∈ A.decompositionSubgroup K ↔ τ ∈ A.decompositionSubgroup ↥K' := by
    rw [mem_decompositionSubgroup_iff, mem_decompositionSubgroup_iff]
    rfl
  rw [mem_inertiaSubgroupIn_iff, mem_inertiaSubgroupIn_iff]
  constructor
  · rintro ⟨hd, hi⟩
    refine ⟨hdec.mp hd, ?_⟩
    rw [mem_inertiaSubgroup_iff] at hi ⊢
    intro a
    have := hi a
    exact this
  · rintro ⟨hd, hi⟩
    refine ⟨hdec.mpr hd, ?_⟩
    rw [mem_inertiaSubgroup_iff] at hi ⊢
    intro a
    have := hi a
    exact this

def toAlgEquivOver {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω] (K' : IntermediateField K Ω)
    (σ : Ω ≃ₐ[K] Ω) (hσ : ∀ x : Ω, x ∈ K' → σ x = x) : Ω ≃ₐ[↥K'] Ω :=
  { σ.toRingEquiv with commutes' := fun x => hσ x x.2 }

@[scoped simp] theorem coe_toAlgEquivOver {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω] (K' : IntermediateField K Ω)
    (σ : Ω ≃ₐ[K] Ω) (hσ : ∀ x : Ω, x ∈ K' → σ x = x) :
    ((toAlgEquivOver K' σ hσ : Ω ≃ₐ[↥K'] Ω) : Ω →+* Ω) = (σ : Ω →+* Ω) := rfl

theorem restrictScalars_toAlgEquivOver {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω] (K' : IntermediateField K Ω)
    (σ : Ω ≃ₐ[K] Ω) (hσ : ∀ x : Ω, x ∈ K' → σ x = x) :
    (toAlgEquivOver K' σ hσ).restrictScalars K = σ := AlgEquiv.ext fun _ => rfl

theorem nsmul_eq_pow {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (x : SchemeHomOver t f) :
    L.nsmul t n x = (letI := L.pointGroup t; x ^ n) := by
  letI := L.pointGroup t
  induction n with
  | zero => rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, pow_succ, ih]; rfl

theorem isTorsionPoint_map {R₁ R₂ : Type} [CommRing R₁] [CommRing R₂]
    {A₁ : Scheme.{0}} {f₁ : A₁ ⟶ Spec (CommRingCat.of R₁)} (L₁ : RelativeGroupLaw R₁ f₁)
    {A₂ : Scheme.{0}} {f₂ : A₂ ⟶ Spec (CommRingCat.of R₂)} (L₂ : RelativeGroupLaw R₂ f₂)
    {T : Scheme.{0}} (t₁ : T ⟶ Spec (CommRingCat.of R₁)) (t₂ : T ⟶ Spec (CommRingCat.of R₂))
    (Φ : SchemeHomOver t₁ f₁ → SchemeHomOver t₂ f₂) (hΦ : ∀ x y, Φ (L₁.mul t₁ x y) = L₂.mul t₂ (Φ x) (Φ y))
    (n : ℕ) (x : SchemeHomOver t₁ f₁) (hx : L₁.IsTorsionPoint t₁ n x) : L₂.IsTorsionPoint t₂ n (Φ x) := by
  letI := L₁.pointGroup t₁
  letI := L₂.pointGroup t₂
  let h : SchemeHomOver t₁ f₁ →* SchemeHomOver t₂ f₂ := MonoidHom.mk' Φ hΦ
  rw [RelativeGroupLaw.isTorsionPoint_def, nsmul_eq_pow] at hx ⊢
  show h x ^ n = 1
  rw [← map_pow, show x ^ n = 1 from hx, map_one]

theorem isTorsionPoint_of_map {R₁ R₂ : Type} [CommRing R₁] [CommRing R₂]
    {A₁ : Scheme.{0}} {f₁ : A₁ ⟶ Spec (CommRingCat.of R₁)} (L₁ : RelativeGroupLaw R₁ f₁)
    {A₂ : Scheme.{0}} {f₂ : A₂ ⟶ Spec (CommRingCat.of R₂)} (L₂ : RelativeGroupLaw R₂ f₂)
    {T : Scheme.{0}} (t₁ : T ⟶ Spec (CommRingCat.of R₁)) (t₂ : T ⟶ Spec (CommRingCat.of R₂))
    (Φ : SchemeHomOver t₁ f₁ → SchemeHomOver t₂ f₂) (hΦ : ∀ x y, Φ (L₁.mul t₁ x y) = L₂.mul t₂ (Φ x) (Φ y))
    (hinj : Function.Injective Φ)
