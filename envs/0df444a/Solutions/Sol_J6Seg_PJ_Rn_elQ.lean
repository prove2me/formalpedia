    (e : c' = c'') : Rn p v c Q c'' C := e ▸ h

/-- `mvK` of the first `n` entries. -/
theorem Rn.mv {v : Vr} {c : Cs} {X Y C : Fin HS} (hX : X ∉ rg) (hY : Y ∉ rg) (hXY : X ≠ Y)
    (hXC : X ≠ C) (hYC : Y ≠ C) (hX5 : X.val < 56) (hY5 : Y.val < 56) (hC5 : C.val < 56)
    {r : Fin HS} (hr : r ∈ rg) {L l : List ℤ} (hcX : c X = L ++ l) (hn : v r = L.length) {B : ℕ}
    (hvr : (L.length : ℤ).natAbs < 2 ^ B) (hL : ∀ x ∈ L, |x| < 2 ^ B) :
    Rn (mvK X Y C (.reg r)) v c (· = v)
      (Function.update (Function.update c X l) Y (L.reverse ++ c Y))
      (2 * 2000 * (B + 2) + L.length * (14000 * (B + 2)) + 32) := by
  refine ⟨v, rfl, fun s => ?_⟩
  have h := sMv s v c hX hY hXY hXC hYC hX5 hY5 hC5 (Rd_reg (Or.inl hr)) (clean_of_lt (rg_lt hr))
    (okR_reg (Or.inl hr)) trivial hcX (by rw [ev_reg hr, hn]) (V := (L.length : ℤ).natAbs)
    (fun j hj => by simp [Ex.regs] at hj; subst hj; simp [tp, hr, hn]) (by simp [mg]; exact hvr)
