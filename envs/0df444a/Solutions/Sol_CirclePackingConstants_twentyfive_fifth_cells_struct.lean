open TwentyFiveStruct in
theorem solution (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5)
    (hd : ∀ i j k l, (i, j) ≠ (k, l) → (1 : ℝ) / 16 < sqDist (p i j) (p k l)) : False := by
  obtain ⟨ev, -, hev⟩ := Finset.exists_max_image (Finset.univ : Finset (Fin 5 × Fin 4))
    (fun e => |(p e.1 e.2.succ).1 - (p e.1 e.2.castSucc).1|) Finset.univ_nonempty
  obtain ⟨eh, -, heh⟩ := Finset.exists_max_image (Finset.univ : Finset (Fin 4 × Fin 5))
    (fun e => |(p e.1.succ e.2).2 - (p e.1.castSucc e.2).2|) Finset.univ_nonempty
  have hev' : ∀ e : Fin 5 × Fin 4, |(p e.1 e.2.succ).1 - (p e.1 e.2.castSucc).1| ≤
      |(p ev.1 ev.2.succ).1 - (p ev.1 ev.2.castSucc).1| := fun e => hev e (Finset.mem_univ _)
  have heh' : ∀ e : Fin 4 × Fin 5, |(p e.1.succ e.2).2 - (p e.1.castSucc e.2).2| ≤
      |(p eh.1.succ eh.2).2 - (p eh.1.castSucc eh.2).2| := fun e => heh e (Finset.mem_univ _)
  generalize hmvdef : |(p ev.1 ev.2.succ).1 - (p ev.1 ev.2.castSucc).1| = mv at hev'
  generalize hmhdef : |(p eh.1.succ eh.2).2 - (p eh.1.castSucc eh.2).2| = mh at heh'
  have hmv0 : 0 ≤ mv := by rw [← hmvdef]; exact abs_nonneg _
  have hmh0 : 0 ≤ mh := by rw [← hmhdef]; exact abs_nonneg _
  -- small vertical shears force a strictly smaller maximal horizontal shear
  have key1 : mv ≤ 47/400 → mh < mv := by
    intro hmv
    have hδ : ∀ (i : Fin 5) (j : Fin 4),
        1/4 - ((p i j.succ).2 - (p i j.castSucc).2) < 100/47 * mv^2 := by
      intro i j
      have hcv := hev' (i, j)
      have k := key _ _ (vEdge p hc hd i j).1 (hcv.trans hmv) (vEdge p hc hd i j).2
      have : ((p i j.succ).1 - (p i j.castSucc).1)^2 ≤ mv^2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hcv 2
      linarith only [k, mul_le_mul_of_nonneg_left this (by norm_num : (0:ℝ) ≤ 100/47)]
    have := stairH p hc _ hδ eh
    rw [hmhdef] at this
    nlinarith only [this, mul_nonneg hmv0 (sub_nonneg.2 hmv)]
  -- small horizontal shears force a strictly smaller maximal vertical shear
  have key2 : mh ≤ 47/400 → mv < mh := by
    intro hmh
    have hα : ∀ (i : Fin 4) (j : Fin 5),
        1/4 - ((p i.succ j).1 - (p i.castSucc j).1) < 100/47 * mh^2 := by
      intro i j
      have hbv := heh' (i, j)
      have k := key _ _ (hEdge p hc hd i j).1 (hbv.trans hmh) (hEdge p hc hd i j).2
      have : ((p i.succ j).2 - (p i.castSucc j).2)^2 ≤ mh^2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hbv 2
      linarith only [k, mul_le_mul_of_nonneg_left this (by norm_num : (0:ℝ) ≤ 100/47)]
    have := stairV p hc _ hα ev
    rw [hmvdef] at this
    nlinarith only [this, mul_nonneg hmh0 (sub_nonneg.2 hmh)]
  have hv : mv ≤ 47/400 := by
    rw [← hmvdef]; exact vertical_shear_small p hc hd ev.1 ev.2
  have h1 := key1 hv
  have h2 := key2 (by linarith only [h1, hv])
  linarith only [h1, h2]

