    -(TaoFivePrimes_RHLocalRationalPolynomial TaoFivePrimes_RH128RoundedCoefficients14 (10^14)
      40 (256/2) s).re =
      CertifiedLocalPolynomial.bivariatePowerValue 10 21 a
        (4*(s.re-1/2)^2) ((5/3)*(s.im-(649/5))) := by
  have h := complex_identity (s.re-1/2) (s.im-256/2)
  have hw : -Complex.I*(s-RH1000Analytic.CertifiedLocalXi.center (256/2)) =
      ((s.im-256/2:ℝ):ℂ)-Complex.I*((s.re-1/2:ℝ):ℂ) := by
    apply Complex.ext <;> simp [RH1000Analytic.CertifiedLocalXi.center] <;> ring
  unfold TaoFivePrimes_RHLocalRationalPolynomial
  simp only [hw]
  have hr := congrArg Complex.re h
  simp only [Complex.sub_re,Complex.neg_re,Complex.ofReal_re,Complex.mul_re,
    Complex.I_re,Complex.I_im,Complex.ofReal_im,zero_mul,mul_zero,sub_zero] at hr
  have he : (5/3:ℝ)*(s.im-256/2-(9/5))=(5/3)*(s.im-(649/5)) := by ring
  rw [he] at hr
  simp only [c,Complex.ofReal_div,Complex.ofReal_intCast] at hr
