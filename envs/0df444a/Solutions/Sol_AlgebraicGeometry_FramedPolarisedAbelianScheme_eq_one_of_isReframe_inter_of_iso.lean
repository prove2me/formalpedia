theorem solution
    (g N n : ℕ) (δ : Fin g → ℕ) [hδ : ∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = N + 1)
    (e : Fin (N + 1) ≃ ((i : Fin g) → ZMod (δ i)))
    (B : Type) [CommRing B] (hd : IsUnit ((N + 1 : ℕ) : B))
    (ζ : B) (hζ : ζ ^ (N + 1) = 1) (hζu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - ζ ^ j))
    (ω : B) (hω : ω ^ 2 = ζ)
    (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : B))
    (hint : ∀ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), ∃ U : Matrix (Fin (N + 1)) (Fin (N + 1)) B, ThetaLevel.IsIntertwiner δ (N + 1) B ω e γ.1 U)
    {S : Type} [CommRing S] [Nontrivial S] (φB : B →+* S) (γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)))
    (X X' : FramedPolarisedAbelianScheme g N n S) (hX : X.IsThetaAdapted δ e)
    (hre : X.IsReframe ((Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1)).map φB) X') (hiso : FramedPolarisedAbelianScheme.Iso X' X) :
    γ = 1 := by
  classical

  obtain ⟨P', h₁, h₂, rfl, hσ'⟩ := hre

  obtain ⟨eI, he, hproj, hmul, hP, hpol⟩ := hiso

  have hn'S : IsUnit ((n : ℕ) : S) := by simpa using hn'.map φB
  have hid : eI.hom = 𝟙 X.A :=
    AlgebraicGeometry.PolarisedAbelianScheme.iso_hom_eq_id_of_three_le hn hn'S X.toPolarisedAbelianScheme eI he hmul hP hpol
  rw [hid, Category.id_comp] at hproj

  have hΓ : Function.Bijective fun r : S => X.f.appTop ((Scheme.ΓSpecIso (.of S)).inv r) := by
    have h := GoodReductionJacobian.AbelianSchemePropertyBundle.bijective_specIso_inv_comp_appTop_of_isPullback X.bundle
      (RingHom.id S) X.f (𝟙 X.A) (by
        rw [CommRingCat.ofHom_id, Spec.map_id]
        exact IsPullback.of_id_fst)
    exact h

  obtain ⟨c, hc⟩ := Scheme.Modules.ProjPresentation.exists_unit_appTop_smul_eq_of_toProj_eq_of_bijective X.frame P' hproj hΓ
  have hb : X.f.appLE ⊤ ⊤ le_top = X.f.appTop := Scheme.Hom.appLE_eq_app X.f

  set M : Matrix (Fin (N + 1)) (Fin (N + 1)) S :=
    (Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1)).map φB with hMdef
  have hM : M = ((c : S) • (1 : Matrix (Fin (N + 1)) (Fin (N + 1)) S)) := by
    funext i
    apply X.frame_basis.1

    show (∑ j, ((X.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom (M i j))) • X.frame.σ j) =
      ∑ j, ((X.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom (((c : S) • (1 : Matrix _ _ S)) i j))) • X.frame.σ j
    rw [← hσ' i, hc i]
    have h1 : ∀ j, ((X.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom
        (((c : S) • (1 : Matrix (Fin (N + 1)) (Fin (N + 1)) S)) i j))) • X.frame.σ j =
        if i = j then (X.f.appTop ((Scheme.ΓSpecIso (.of S)).inv (c : S))) • X.frame.σ j else 0 := by
      intro j
      rw [Matrix.smul_apply, Matrix.one_apply]
      split_ifs
      · rw [smul_eq_mul, mul_one, hb]
      · rw [smul_zero, map_zero, map_zero, zero_smul]
    rw [Finset.sum_congr rfl fun j _ => h1 j, Finset.sum_ite_eq]
    simp

  have hI : (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1).map φB = (c : S) • (1 : Matrix (Fin (N + 1)) (Fin (N + 1)) S) := by
    have ht := congrArg Matrix.transpose hM
    rw [hMdef, Matrix.transpose_map, Matrix.transpose_transpose, Matrix.transpose_smul, Matrix.transpose_one] at ht
    exact ht

