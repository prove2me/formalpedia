set_option autoImplicit false
open scoped BigOperators
namespace DerivativeChainGini
noncomputable section

def vertex : Fin 5 → ℂ := ![1, -1, Complex.I, -Complex.I, 0]
def parentMultiplicity : Fin 5 → ℕ := ![4, 4, 4, 4, 0]
def childMultiplicity : Fin 5 → ℕ := ![3, 3, 3, 3, 3]
def parentMass (i : Fin 5) : ℝ := parentMultiplicity i / 16
def childMass (i : Fin 5) : ℝ := childMultiplicity i / 15

def cost (i j : Fin 5) : ℝ := ‖vertex i - vertex j‖
def gini (mass : Fin 5 → ℝ) : ℝ := ∑ i, ∑ j, mass i * mass j * cost i j

def IsCoupling (q : Fin 5 → Fin 5 → ℝ) : Prop :=
  (∀ i j, 0 ≤ q i j) ∧ (∀ i, ∑ j, q i j = parentMass i) ∧
    (∀ j, ∑ i, q i j = childMass j)
def transportCost (q : Fin 5 → Fin 5 → ℝ) : ℝ := ∑ i, ∑ j, q i j * cost i j
def optimalW1 : ℝ := sInf {t : ℝ | ∃ q, IsCoupling q ∧ transportCost q = t}

def radialCoupling : Fin 5 → Fin 5 → ℝ :=
  ![![1/5, 0, 0, 0, 1/20], ![0, 1/5, 0, 0, 1/20],
    ![0, 0, 1/5, 0, 1/20], ![0, 0, 0, 1/5, 1/20], ![0, 0, 0, 0, 0]]



















open Polynomial

def source : ℂ[X] := (X^4 - 1)^4
def normalizedChild : ℂ[X] := X^3 * (X^4 - 1)^3










































end
end DerivativeChainGini


