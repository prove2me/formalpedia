section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pD : Fin P) (hP : iprog pD = NLogN.difBody pD) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (s : NLogN.IState NLogN.NS) (A : List ℤ) (R LL LE LN LF : List NLogN.Item) (E : ℕ),
      A.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → NLogN.Canon (2 ^ n + 1) A →
      s.G NLogN.DX = NLogN.ints A ++ R → s.G NLogN.DL = .int (2 ^ j) :: LL → s.G NLogN.DE = .int (2 ^ E) :: LE →
      s.G NLogN.RN = .int (2 ^ n) :: LN → s.G NLogN.RF = .int (2 ^ n + 1) :: LF →
      NLogN.IRuns I iprog (.call pD) s (s.upd NLogN.DX (NLogN.ints (NLogN.difZ (2 ^ n + 1) E j A) ++ R)) (NLogN.difCost n j) := by
  intro j
  induction j with
  | zero =>
    intro s A R LL LE LN LF E hA _ _ hX hL _ _ _
    refine NLogN.IRuns.mono (NLogN.IRuns.call (c := 6030) ?_) (by simp only [NLogN.difCost]; omega)
    rw [hP]
    have h1 := NLogN.difTest_runs (I := I) (iprog := iprog) s 1 LL 1 (by simpa using hL) (by simp [NLogN.zsz_one])
    have h2 : NLogN.IRuns I iprog (.ite NLogN.CC (fun c => c == .zero) (.op (.drop NLogN.CC))
        (.seq (.op (.drop NLogN.CC)) (NLogN.difMain pD))) (s.upd NLogN.CC (.int (1 + -1) :: s.G NLogN.CC)) s 30 := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, NLogN.zsz_zero]
    exact (NLogN.IRuns.seq h1 h2).mono' (by simp [NLogN.difZ, hX]) (by omega)
  | succ j ih =>
    intro s A R LL LE LN LF E hA hjE hcA hX hL hDE hN hF
    have hjE' : 2 ^ j * E = n := by
      rcases hjE with h | h
      · omega
      · rw [pow_succ] at h; linarith
    obtain ⟨h, hh⟩ : ∃ h, h = 2 ^ j := ⟨_, rfl⟩
    have hA2 : A.length = 2 * h := by rw [hA, hh, pow_succ, mul_comm]
    rw [← hh] at hjE'
    have hE1 : 1 ≤ E := by
      rcases Nat.eq_zero_or_pos E with h0 | h0
      · rw [h0] at hjE'; omega
      · exact h0
    have hhn : h ≤ n := by nlinarith
    have hjn : j + 1 ≤ n := by
      have : j < 2 ^ j := Nat.lt_two_pow_self
      omega
    have hh1 : 1 ≤ h := by rw [hh]; exact Nat.one_le_two_pow
    set lo := A.take h with hlo
    set hi := A.drop h with hhi
    have hAlh : A = lo ++ hi := (List.take_append_drop h A).symm
    have hlol : lo.length = h := by rw [List.length_take, hA2]; omega
    have hhil : hi.length = h := by rw [List.length_drop, hA2]; omega
    have hclo : NLogN.Canon (2 ^ n + 1) lo := fun a ha => hcA a (List.mem_of_mem_take ha)
    have hchi : NLogN.Canon (2 ^ n + 1) hi := fun a ha => hcA a (List.mem_of_mem_drop ha)
    have hzh : NLogN.zsz (h : ℤ) ≤ n := le_trans (NLogN.zsz_natCast_le_self h) hhn
    set tops := NLogN.bflyT (2 ^ n + 1) lo hi with htops
    set bots := NLogN.bflyB (2 ^ n + 1) E 0 lo hi with hbots
    have htl : tops.length = h := by rw [htops, NLogN.length_bflyT _ lo hi (by omega), hlol]
    have hbl : bots.length = h := by rw [hbots, NLogN.length_bflyB _ E 0 lo hi (by omega), hlol]
    -- test and branch
    have hz2 : NLogN.zsz ((2 : ℤ) ^ (j + 1)) ≤ n + 1 := by rw [NLogN.zsz_two_pow]; omega
    have h1 := NLogN.difTest_runs (I := I) (iprog := iprog) s (2 ^ (j + 1)) LL (n + 1) hL hz2
    have hne : (2 : ℤ) ^ (j + 1) + -1 ≠ 0 := by
      have : (2 : ℤ) ≤ 2 ^ (j + 1) := by
        calc (2 : ℤ) = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (j + 1) := pow_le_pow_right₀ (by norm_num) (by omega)
      linarith
    -- segment A
    set s1 := s.upd NLogN.HH (.int (h : ℤ) :: s.G NLogN.HH) with hs1
    have hA' : NLogN.IRuns I iprog (.seq (.op (.drop NLogN.CC)) NLogN.difSegA)
        (s.upd NLogN.CC (.int (2 ^ (j + 1) + -1) :: s.G NLogN.CC)) s1 (10000 * (n + 3)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.difSegA, NLogN.IStmt.run, NLogN.IOp.run, hL, NLogN.zsz_zero, NLogN.two_pow_succ_div',
        NLogN.two_pow_succ_mod']
      have e3 : ((h : ℕ) : ℤ) = 2 ^ j := by rw [hh]; push_cast; rfl
      refine ⟨by rw [hs1, e3]; clear * - hL; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := NLogN.zsz_add_le ((2 : ℤ) ^ (j + 1)) (-1)
