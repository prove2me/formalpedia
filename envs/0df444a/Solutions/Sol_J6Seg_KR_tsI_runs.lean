lemma gflat_replicate0 (m : ℕ) : gflat (List.replicate m ((0 : ℤ), (0 : ℤ))) = List.replicate (2 * m) 0 := by
  induction m with
  | zero => rfl
  | succ m ih =>
    rw [List.replicate_succ, gflat_cons, ih, show 2 * (m + 1) = (2 * m + 1) + 1 by ring,
      List.replicate_succ, List.replicate_succ]

lemma gflat_padG {r : ℕ} {t : List GI} (h : 2 * t.length = r) :
    gflat (padG r t) = gflat t ++ List.replicate (2 * t.length) 0 := by
  rw [padG, gflat_append, gflat_replicate0]; congr 2; omega

lemma gflat_realG {r n : ℕ} {am : List ℤ} (ham : am.length = n) (h : 2 * n = r) :
    gflat (realG r n am) = gflat (am.map fun v => (v, 0)) ++ List.replicate (2 * n) 0 := by
  rw [realG, gflat_append, gflat_replicate0, List.take_of_length_le (le_of_eq ham)]; congr 2; omega

