theorem omL_relabel (hσ : ∀ A, σ (σ A) = A) (hη : ∀ A B, etaNull (σ A) (σ B) = etaNull A B)
    (g gi : Metric 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (C A B : Fin 4) (x : Pt 4) :
    omL g gi (NP.relabel σ E) (NP.relabel σ Θ) C A B x = omL g gi E Θ (σ C) (σ A) (σ B) x := by
  simp only [omL, Omega_relabel]
  have e : ∀ K, etaNull C K = etaNull (σ C) (σ K) := fun K => (hη C K).symm
  simp only [e]
  exact Fintype.sum_equiv (Equiv.mk σ σ hσ hσ) _ _ fun K => rfl

theorem weylF_relabel (g gi : Metric 4) (E : Fin 4 → Fin 4 → Pt 4 → ℂ) (I J A B : Fin 4) (x : Pt 4) :
    weylF g gi (NP.relabel σ E) I J A B x = weylF g gi E (σ I) (σ J) (σ A) (σ B) x := rfl

