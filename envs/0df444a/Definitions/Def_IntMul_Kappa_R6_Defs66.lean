-- Source module: Solutions.J6SegKs0
/-!
# B3′ (chunk kernel with in-kernel Kronecker constants), part 0: the table layout

The block header no longer carries `kG b (2n) 2^pk` and `(2^b)^(4n)`. It carries
`[n, 2n, j, 2nb]` with `j = clog₂(2n)`, and the kernel computes the constants by doubling
(`j` steps) and `pow2`. All table entries are then `O(pk + b + log λ)` bits.

* `blkHdr2 n b = [n, 2n, clog 2 (2n), 2 n b]`;
* `encD2 b d = blkHdr2 d.1 b ++ am ++ ap`, `dsEnc2 b ds`;
* `tabK2 P pk b λ di gi gam dd ds`: the same header as `tabK`
  (`[λ, 2^P, 2^(P+1), |ds|, |tab|, 2^pk, 2^b, 2(λ − Σn)]`), then `di.rev ++ gi.rev ++ gam.rev ++
  dd.rev ++ dsEnc2 b ds`.
-/

namespace J6Seg.KR

/-- The new block header. -/
def blkHdr2 (n b : ℕ) : List ℤ :=
  [(n : ℤ), ((2 * n : ℕ) : ℤ), ((Nat.clog 2 (2 * n) : ℕ) : ℤ), ((2 * n * b : ℕ) : ℤ)]

/-- One block descriptor. -/
def encD2 (b : ℕ) (d : ℕ × List ℤ × List ℤ) : List ℤ := blkHdr2 d.1 b ++ d.2.1 ++ d.2.2

/-- The block descriptors. -/
def dsEnc2 (b : ℕ) (ds : List (ℕ × List ℤ × List ℤ)) : List ℤ := ds.flatMap (encD2 b)

/-- **The chunk table (new layout).** -/
def tabK2 (P pk b lam : ℕ) (di gi gam dd : List ℤ) (ds : List (ℕ × List ℤ × List ℤ)) : List ℤ :=
  [(lam : ℤ), 2 ^ P, 2 ^ (P + 1), (ds.length : ℤ),
   ((8 + 4 * lam + (dsEnc2 b ds).length : ℕ) : ℤ), 2 ^ pk, 2 ^ b,
   ((2 * (lam - sumN ds) : ℕ) : ℤ)] ++ di.reverse ++ gi.reverse ++ gam.reverse ++ dd.reverse ++
    dsEnc2 b ds

end J6Seg.KR

end

section
-- Source module: Solutions.J6SegILJKer1
/-!
# B-line IL, the `J` kernel (B4), part 1: list model and arithmetic

The `J` kernel `jKer` (J6SegSw3) of a padded `G`-row `v` is

  `jKer v = W ++ 0^{G-m}`, `W_r = dotF (cc_r) ((zext K z).drop r)`,
  `z = bwdK bs (fwdK fs (v.take m) []) [] []`

for the coefficient streams `fs = fsOf …`, `bs = bsOf …`, `cc_r = ccL … r`. This file gives

* the generic kernel `jKerG P K G m fs bs cc v` (any streams) and the step forms of `fwdK`
  (`fA_succ`), `bwdK` (`bwdS_succ`) and `dotF` on prefixes (`dotF_take_succ`);
* the arithmetic of the IL: `ediv_of_tdiv` (floor division from `tdiv`/`tmod`), `rs_eq`
  (`rs P x = ⌊(2x + 2^P) / 2^{P+1}⌋`) and **`fdiv_recip`**: with `|2 a 2^P + pv| < 2^k` and
  `pv > 0`, `fdiv P a pv` is `q₀ + δ` where `q₀ = ⌊N iv / 2^k⌋` (`iv = ivOf k pv = ⌊2^k / 2pv⌋`)
  and the correction `δ ∈ {-1,0,1}` is read off the signs of `N - q₀ D` and `N - q₀ D - D`
  (`N = 2 a 2^P + pv`, `D = 2 pv`): two multiplications instead of a long division.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.JK

open Finset

/-! ## Arithmetic -/

/-- The reciprocal of a pivot: `⌊2^k / 2pv⌋`. -/
def ivOf (k : ℕ) (pv : ℤ) : ℤ := 2 ^ k / (2 * pv)

/-- The correction of the reciprocal quotient. -/
def corr (r D : ℤ) : ℤ := if r < 0 then -1 else if r - D < 0 then 0 else 1

/-! ## `dotF` on prefixes -/

/-! ## The forward kernel by steps -/

/-- The forward accumulator after `r` rows. -/
def fA (P : ℕ) (fs : List (List ℤ)) (v : List ℤ) (r : ℕ) : List ℤ := fwdK P (fs.take r) (v.take r) []

/-! ## The backward kernel by steps -/

/-- One backward step on the record `(cb, cz, pv, fl)` and the value `bt`. -/
def stepB (P : ℕ) (rc : List ℤ × List ℤ × ℤ × ℤ) (bt : ℤ) (st : List ℤ × List ℤ) :
    List ℤ × List ℤ :=
  (J6Seg.fdiv P (bt - dotF P rc.1 st.1 - dotF P rc.2.1 st.2) rc.2.2.1 :: st.1,
    if rc.2.2.2 = 1 then J6Seg.fdiv P (bt - dotF P rc.1 st.1 - dotF P rc.2.1 st.2) rc.2.2.1 :: st.2
    else st.2)

/-- The fold of the backward steps. -/
def bwdF (P : ℕ) (l : List ((List ℤ × List ℤ × ℤ × ℤ) × ℤ)) (st : List ℤ × List ℤ) :
    List ℤ × List ℤ :=
  l.foldl (fun st x => stepB P x.1 x.2 st) st

/-- The backward state after `j` records. -/
def bwdS (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) (j : ℕ) : List ℤ × List ℤ :=
  bwdF P ((bs.take j).zip (bts.take j)) ([], [])

/-! ## The generic kernel -/

/-- **The generic `J` kernel** on one real row. -/
def jKerG (P K G m : ℕ) (fs : List (List ℤ)) (bs : List (List ℤ × List ℤ × ℤ × ℤ))
    (cc : List (List ℤ)) (v : List ℤ) : List ℤ :=
  (List.range m).map (fun r => dotF P (cc.getD r [])
    ((zext K (bwdK P bs (fwdK P fs (v.take m) []) [] [])).drop r)) ++ List.replicate (G - m) 0

end J6Seg.JK

end

