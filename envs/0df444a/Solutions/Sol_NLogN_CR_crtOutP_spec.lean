theorem rmPos_congr : ∀ (s : List ℕ) (j j' : ℕ → ℕ), (∀ i < s.length, j i = j' i) →
    rmPos s j = rmPos s j'
  | [], _, _, _ => rfl
  | n :: ns, j, j', h => by
    simp only [rmPos]
    rw [h 0 (by simp), rmPos_congr ns _ _ (fun i hi => h (i + 1) (by simp; omega))]

theorem rmPos_lt : ∀ (s : List ℕ) (j : ℕ → ℕ), (∀ i < s.length, j i < s.getD i 1) →
    rmPos s j < s.prod
  | [], _, _ => by simp [rmPos]
  | n :: ns, j, h => by
    simp only [rmPos, List.prod_cons]
    have h0 : j 0 < n := by simpa using h 0 (by simp)
    have h1 := rmPos_lt ns (fun i => j (i + 1)) (fun i hi => by simpa using h (i + 1) (by simp; omega))
    have : (j 0 + 1) * ns.prod ≤ n * ns.prod := Nat.mul_le_mul_right _ h0
    nlinarith

theorem rmPos_unrk : ∀ (s : List ℕ) (q : ℕ), q < s.prod → rmPos s (unrk s q) = q
  | [], q, h => by simp at h; simp [rmPos]; omega
  | n :: ns, q, h => by
    simp only [rmPos, unrk, if_pos rfl]
    have hp : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
      · simp [List.prod_cons, h0] at h
      · exact h0
    have e := rmPos_unrk ns (q % ns.prod) (Nat.mod_lt _ hp)
    have e2 : rmPos ns (fun i => if i + 1 = 0 then q / ns.prod else unrk ns (q % ns.prod) (i + 1 - 1))
        = rmPos ns (unrk ns (q % ns.prod)) := rmPos_congr _ _ _ (fun i _ => by simp)
    rw [e2, e]
    exact Nat.div_add_mod' q ns.prod

theorem unrk_lt : ∀ (s : List ℕ) (q : ℕ), q < s.prod → ∀ i < s.length, unrk s q i < s.getD i 1
  | [], _, _, i, hi => by simp at hi
  | n :: ns, q, h, i, hi => by
    have hp : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
      · simp [List.prod_cons, h0] at h
      · exact h0
    rcases i with _ | i
    · simp only [unrk, List.getD_cons_zero, if_true]
      rw [Nat.div_lt_iff_lt_mul hp]; simpa [List.prod_cons] using h
    · simp only [unrk, List.getD_cons_succ, Nat.add_sub_cancel]
      simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, if_false]
