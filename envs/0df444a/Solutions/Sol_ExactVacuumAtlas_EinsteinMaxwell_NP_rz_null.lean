theorem rzGc_symm {ε : ℝ} (y : Pt 4) (μ ν : Fin 4) : rzGc U E0 Θ0 B ε μ ν y = rzGc U E0 Θ0 B ε ν μ y := by
  simp only [rzGc]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by rw [etaNull_symm]; ring

