theorem ModularCurve.heckeOperatorBar_comm_of_heckeExchangeAt (N ℓ ℓ' M : ℕ) [NeZero N] [Fact ℓ.Prime] [Fact ℓ'.Prime] [NeZero M] (hM : M = N * ℓ * ℓ') (hM' : M = N * ℓ' * ℓ) [HasPrincipalDivisors (AlgebraicClosure ℚ) (modularFunctionFieldBar (N * ℓ))] [HasPrincipalDivisors (AlgebraicClosure ℚ) (modularFunctionFieldBar (N * ℓ'))] [HasPrincipalDivisors (AlgebraicClosure ℚ) (modularFunctionFieldBar M)] (hex : HeckeExchangeAt (AlgebraicClosure ℚ) N ℓ ℓ' M hM) (hex' : HeckeExchangeAt (AlgebraicClosure ℚ) N ℓ' ℓ M hM') : heckeOperatorBar N ⟨ℓ, Fact.out⟩ * heckeOperatorBar N ⟨ℓ', Fact.out⟩ = heckeOperatorBar N ⟨ℓ', Fact.out⟩ * heckeOperatorBar N ⟨ℓ, Fact.out⟩ := by sorry
