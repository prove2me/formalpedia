open ModularCurve AlgebraicCurve

theorem solution (N : ℕ) [NeZero N] (m : ℤ) (hm : m ≠ 0) :
    Function.Surjective (fun x : JZero N => m • x) := by
  intro y
  haveI : IsCurveOver (AlgebraicClosure ℚ) (modularFunctionFieldBar N) :=
    isCurveOver_modularFunctionFieldBar N
  obtain ⟨z, hz⟩ := AlgebraicCurve.Pic0.exists_nsmul_eq
    (AlgebraicClosure ℚ) (modularFunctionFieldBar N)
    (exists_transcendental_finiteDimensional_modularFunctionFieldBar N)
    m.natAbs (Int.natAbs_ne_zero.mpr hm) y
  rcases Int.natAbs_eq m with hp | hn
  · exact ⟨z, by simp only; rw [hp, natCast_zsmul]; exact hz⟩
  · exact ⟨-z, by simp only; rw [hn, neg_smul_neg, natCast_zsmul]; exact hz⟩

end S_ModularCurve_jZero_zsmul_surjective
