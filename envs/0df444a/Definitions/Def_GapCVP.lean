    List (Clause T S) :=
  (fiveFamilyRowMajorTimePositionSlots T).flatMap fun position =>
    (fiveFamilyRowMajorSymbolPairs S).map fun symbols =>
      if symbols.1 < symbols.2 then
        atMostOneClause position.1 position.2 symbols.1 symbols.2
