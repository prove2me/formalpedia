    mp72a102_t3_residueHat_congr_of_depth_one v (by rw [h, _root_.map_zero])
  rwa [S.residueHat_lift, _root_.map_zero] at hres

theorem mp72a103_t2_taylor_coeff_eq_zero_of_depth (v : Place K F)
    (S : Lg37CompletionSection v) :
