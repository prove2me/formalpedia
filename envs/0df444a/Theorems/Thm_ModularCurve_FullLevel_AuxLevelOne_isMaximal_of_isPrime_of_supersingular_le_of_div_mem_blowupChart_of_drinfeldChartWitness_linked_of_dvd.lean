          (∀ (c : ↥(chartAlgFin A (↥K) j)) (hc : ((c : ↥(chartAlgFin A (↥K) j)) : ↥K) ∈ Ba), c ∈ y → (⟨((c : ↥(chartAlgFin A (↥K) j)) : ↥K), hc⟩ : ↥Ba) ∈ Q) →
          (∀ ht : algebraMap A ↥K ϖt * (((a : ↥(chartAlgFin A (↥K) j)) : ↥K))⁻¹ ∈ Ba, (⟨_, ht⟩ : ↥Ba) ∈ Q) →
