set_option autoImplicit false
open QEC QEC.Coding QEC.Coding.BalancedProduct QEC.Coding.BalancedProduct.PKDistance
open QEC.Coding
universe u v w

theorem QEC.Coding.BalancedProduct.PKDistance.horizontalPart_boundary2_primitiveTwoChain
    {G aRow aCol : Type} [CommGroup G] [Fintype G] [DecidableEq G]
    [Fintype aRow] [DecidableEq aRow]
    [Fintype aCol] [DecidableEq aCol]
    (A : Matrix aRow aCol (MonoidAlgebra (ZMod 2) G)) (x : G)
    (h : Word (ZMod 2) (aCol × G)) :
    horizontalPart
        (LiftedProduct.boundary2 (Cyclic.liftedProductData A x)
          (primitiveTwoChain h)) =
      h + cyclicShift x h := by sorry
