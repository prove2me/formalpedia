theorem inversePower3_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 (parameter (-3)) inverseSum3) z = eval k inversePower3 z := by
  have he := eval_eq_of_degrees 24 k inversePower3_raw inversePower3 z
    (degreeBound_sound inversePower3_raw_bound) (degreeBound_sound inversePower3_result_bound)
    inversePower3_degrees
  change eval k (normalize inversePower3_raw) z = eval k inversePower3 z
  rw [eval_normalize]
  exact he

theorem inversePower3_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^3) inversePower3 := by
  have h23 := (lossPower23_approximates hk hklog).scale (300 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (276 : ℚ)).addAppend h23
  have h21 := ((lossPower21_approximates hk hklog).scale (253 : ℚ)).addAppend h22
  have h20 := ((lossPower20_approximates hk hklog).scale (231 : ℚ)).addAppend h21
  have h19 := ((lossPower19_approximates hk hklog).scale (210 : ℚ)).addAppend h20
  have h18 := ((lossPower18_approximates hk hklog).scale (190 : ℚ)).addAppend h19
  have h17 := ((lossPower17_approximates hk hklog).scale (171 : ℚ)).addAppend h18
  have h16 := ((lossPower16_approximates hk hklog).scale (153 : ℚ)).addAppend h17
  have h15 := ((lossPower15_approximates hk hklog).scale (136 : ℚ)).addAppend h16
  have h14 := ((lossPower14_approximates hk hklog).scale (120 : ℚ)).addAppend h15
  have h13 := ((lossPower13_approximates hk hklog).scale (105 : ℚ)).addAppend h14
  have h12 := ((lossPower12_approximates hk hklog).scale (91 : ℚ)).addAppend h13
  have h11 := ((lossPower11_approximates hk hklog).scale (78 : ℚ)).addAppend h12
  have h10 := ((lossPower10_approximates hk hklog).scale (66 : ℚ)).addAppend h11
  have h9 := ((lossPower9_approximates hk hklog).scale (55 : ℚ)).addAppend h10
  have h8 := ((lossPower8_approximates hk hklog).scale (45 : ℚ)).addAppend h9
  have h7 := ((lossPower7_approximates hk hklog).scale (36 : ℚ)).addAppend h8
  have h6 := ((lossPower6_approximates hk hklog).scale (28 : ℚ)).addAppend h7
  have h5 := ((lossPower5_approximates hk hklog).scale (21 : ℚ)).addAppend h6
  have h4 := ((lossPower4_approximates hk hklog).scale (15 : ℚ)).addAppend h5
  have h3 := ((lossPower3_approximates hk hklog).scale (10 : ℚ)).addAppend h4
  have h2 := ((lossPower2_approximates hk hklog).scale (6 : ℚ)).addAppend h3
  have h1 := ((lossPower1_approximates hk hklog).scale (3 : ℚ)).addAppend h2
  have h0 := ((lossPower0_approximates hk hklog).scale (1 : ℚ)).addAppend h1
  have hraw := h0.replacePolynomial (inverseSum3_eval k)
  have ht : Approximates 24 k (fun z => eval k seed3 (lossFunction k z,0)) inverseSum3 := by
    convert hraw using 1
    funext z
    norm_num [seed3,eval,evalTerm]
    <;> ring
  have hu := (loss_approximates hk hklog).comp_finite (Approximates.const 24 k 0)
    (loss_zero hk hklog) (by simp) (seed3_approximates hk) ht
  have hh := ((Approximates.parameter 24 k (-3)).mul hk hu).replacePolynomial
    (inversePower3_eval k)
  convert hh using 1
  funext z
  rw [mean_inverse_eq hk, mul_pow]
  simp only [Rat.cast_zero,zpow_neg,zpow_natCast,inv_pow] <;> rfl

end GeneralCK.Reflection.SmallBiasBivariateInverse

