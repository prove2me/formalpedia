-- title:
--   Exact equality of fixed-support and local-sum invariant groups
-- statement:
--   Let $d\ge2$, $n\ge1$, and $1\le k\le n$. Let $\mathcal L_k$ be the Hermitian $SU(d)$-invariant Hamiltonians supported on one fixed subset of at most $k$ sites, allowing the subset to vary between Hamiltonians. Let $V_k$ be generated by their exponentials and let $V'_k$ be generated by exponentials of arbitrary finite real linear combinations of elements of $\mathcal L_k$. Then
--
--   $$V_k=V'_k.$$
--
--   Both sides mean exact finite products, with the actual collective $g^{\otimes n}$ symmetry. The equality is stronger than equality of topological closures or of generated Lie algebras.
-- source:
--   Speeding up Learning Quantum States through Group Equivariant Convolutional Quantum Ansätze, arXiv:2112.07611v3, PDF p. 24, Unnumbered SM §III remark: equality V_k=V_k prime

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P10

noncomputable section

open scoped Matrix

open QAlgorithms

open QAlgorithms.Schur

open QAlgorithms.Papers.Independent.Information100.P44 (matrixUnit)

namespace QAlgorithms.Papers.Independent.Extend50.P10

attribute [local instance] Classical.propDecidable

/-- PDF p.24, SM §III remark: V_k=V'_k as algebraically generated groups,
not merely equality after closure or equality of their Lie algebras. -/
theorem localSum_groupEquality (d n k : ℕ) (_hd : 2 ≤ d) (_hn : 1 ≤ n)
    (_hk : 1 ≤ k) (_hkn : k ≤ n) :
    invariantLocalGroup d n k = invariantLocalSumGroup d n k := by sorry

end QAlgorithms.Papers.Independent.Extend50.P10

end
