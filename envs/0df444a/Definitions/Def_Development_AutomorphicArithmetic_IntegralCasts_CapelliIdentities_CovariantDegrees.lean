    {A : ValuationSubring Ω} (hj : ∀ x : Ω, x ∈ A ↔ ‖j x‖ ≤ 1)
    (σ : UpperTheory.Reformulated.B.CovariantDegrees.GQ l) (hσ : σ ∈ (UpperTheory.Reformulated.B.CovariantDegrees.KwF (E := E) j).fixingSubgroup) :
    UpperTheory.Reformulated.B.CovariantDegrees.resE j σ hσ ∈ UpperTheory.Reformulated.B.CovariantDegrees.Dec A := by
  have hn : ∀ x, ‖j (UpperTheory.Reformulated.B.CovariantDegrees.resE j σ hσ x)‖ = ‖j x‖ := fun x => by
    rw [UpperTheory.Reformulated.B.CovariantDegrees.j_resE]
    exact (spectralNorm_eq_of_equiv σ (j x)).symm
  refine MulAction.mem_stabilizer_iff.2 (SetLike.ext fun x => ?_)
  rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, hj, hj, ← hn]
  simp
