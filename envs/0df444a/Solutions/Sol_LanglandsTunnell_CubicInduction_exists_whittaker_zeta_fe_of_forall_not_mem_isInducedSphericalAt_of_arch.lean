private theorem eq_prod_mul_mul_of_factorisation {ι : Type*} (T : Finset ι) {Z ZT A PA AF Λ LF : ℂ} {L z P : ι → ℂ}
    (hZT : Z = ZT * ∏' v : {v // v ∉ T}, L v) (hT : ZT = A * ∏ v ∈ T, z v)
    (hz : ∀ v ∈ T, z v = L v * P v) (hA : A = PA * AF) (hΛ : Λ = AF * LF)
    (hmul : Multipliable fun v : {v // v ∉ T} => L v) (hLF : ∏' v, L v = LF) :
    Z = (∏ v ∈ T, P v) * PA * Λ := by
  have hre : (∏ v ∈ T, L v) * ∏' v : {v // v ∉ T}, L v = LF := by
    rw [StripAssembly.prod_mul_tprod_subtype_eq_tprod T hmul, hLF]
  have hzT : ∏ v ∈ T, z v = (∏ v ∈ T, L v) * ∏ v ∈ T, P v := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl hz
  calc Z = A * ((∏ v ∈ T, L v) * ∏ v ∈ T, P v) * ∏' v : {v // v ∉ T}, L v := by rw [hZT, hT, hzT]
    _ = (∏ v ∈ T, P v) * PA * (AF * ((∏ v ∈ T, L v) * ∏' v : {v // v ∉ T}, L v)) := by rw [hA]; ring
    _ = (∏ v ∈ T, P v) * PA * Λ := by rw [hre, ← hΛ]

private theorem exists_fun_of_forall_mem_exists {ι β : Type*} [Inhabited β] (T : Finset ι) {p : ι → β → Prop}
    (H : ∀ v ∈ T, ∃ x, p v x) : ∃ f : ι → β, ∀ v ∈ T, p v (f v) := by
  classical
  refine ⟨fun v => if h : v ∈ T then Classical.choose (H v h) else default, fun v hv => ?_⟩
  simp only [dif_pos hv]
  exact Classical.choose_spec (H v hv)

private theorem exists_forall_mem_le (ι : Type*) (T : Finset ι) (σ : ι → ℝ) : ∃ c : ℝ, ∀ v ∈ T, σ v ≤ c :=
  ⟨∑ v ∈ T, |σ v|, fun v hv =>
    (le_abs_self (σ v)).trans (Finset.single_le_sum (f := fun v => |σ v|) (fun _ _ => abs_nonneg _) hv)⟩

private theorem exists_forall_mem_lt (ι : Type*) (T : Finset ι) (σ : ι → ℝ) (σ₀ : ℝ) :
    ∃ c : ℝ, σ₀ ≤ c ∧ ∀ v ∈ T, σ v ≤ c := by
  obtain ⟨c, hc⟩ := exists_forall_mem_le ι T σ
  exact ⟨max σ₀ c, le_max_left _ _, fun v hv => (hc v hv).trans (le_max_right _ _)⟩

end

