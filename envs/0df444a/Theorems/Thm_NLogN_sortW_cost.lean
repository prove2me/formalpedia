theorem NLogN.sortW_cost (w kb : ℕ) (t : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L54 L3 : List Item)
    (h0 : t.G 0 = ints R.flatten ++ Rest) (h54 : t.G 54 = .int R.length :: L54)
    (h3 : t.G 3 = .int kb :: L3)
    (B : ℕ) (hBe : ∀ r ∈ R, Bnd B r) (hBN : zsz ((R.length * w : ℕ) : ℤ) ≤ B)
    (hBk : kb + 2 ≤ B) (hBw : zsz (w : ℤ) ≤ B) :
    (sortW w).cost t ≤ 200000 * (kb + 1) * (R.length * w + 1) * (B + 2) + 9000 * (B + 2) := by sorry
