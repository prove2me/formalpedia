/-- A conditional expectation can be pulled back through a measure-preserving
map when the information is pulled back through the same map. -/
private theorem condExp_pullback {A B : Type*} [mA : MeasurableSpace A] [mB : MeasurableSpace B]
    (μ : Measure A) [IsProbabilityMeasure μ] (ν : Measure B) [IsProbabilityMeasure ν]
    (p : A → B) (hp : MeasurePreserving p μ ν)
    (m : MeasurableSpace B) (hm : m ≤ mB)
    (f : B → ℝ) (hf : Integrable f ν) :
    μ[f ∘ p | m.comap p] =ᵐ[μ] (ν[f | m]) ∘ p := by
  letI : MeasurableSpace B := mB
  let g := ν[f | m]
  have hmg : StronglyMeasurable[m] g := stronglyMeasurable_condExp
  have hgi : Integrable g ν := integrable_condExp
  have hmapped {k : B → ℝ} (hk : Integrable k ν) : Integrable k (μ.map p) := by
    rw [hp.map_eq]
    exact hk
  have hgp : Integrable (g ∘ p) μ := (hmapped hgi).comp_measurable hp.measurable
  have hfp : Integrable (f ∘ p) μ := (hmapped hf).comp_measurable hp.measurable
  have hmp : m.comap p ≤ mA := (MeasurableSpace.comap_mono hm).trans hp.measurable.comap_le
  have hpg : Measurable[m.comap p, m] p := measurable_iff_comap_le.mpr le_rfl
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq hmp hfp
    (fun _ _ _ => hgp.integrableOn) ?_ (hmg.comp_measurable hpg).aestronglyMeasurable
  rintro _ ⟨s, hs, rfl⟩ _
  have hs' : MeasurableSet s := hm s hs
  have hg' : AEStronglyMeasurable g (μ.map p) := hp.map_eq ▸ hgi.aestronglyMeasurable
  have hf' : AEStronglyMeasurable f (μ.map p) := hp.map_eq ▸ hf.aestronglyMeasurable
  change (∫ x in p ⁻¹' s, g (p x) ∂μ) = ∫ x in p ⁻¹' s, f (p x) ∂μ
  rw [← setIntegral_map hs' hg' hp.measurable.aemeasurable,
      ← setIntegral_map hs' hf' hp.measurable.aemeasurable, hp.map_eq]
  exact setIntegral_condExp hm hf hs

/-- The next transcript is obtained by appending the observation from an
independent draw. This describes the same law as the observation kernel. -/
theorem map_product_append {A B H Y : Type*} [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace H] [MeasurableSpace Y] (μ : Measure A) (ν : Measure B)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] (past : A → H) (hp : Measurable past)
    (observe : H × B → Y) (ho : Measurable observe)
    (κ : Kernel H Y) [IsMarkovKernel κ]
    (hk : ∀ x, κ x = ν.map (fun b => observe (x, b))) :
    (μ.prod ν).map (fun x : A × B => (past x.1, observe (past x.1, x.2))) =
      μ.map past ⊗ₘ κ := by
  let f (x : A × B) := (past x.1, observe (past x.1, x.2))
  have hm : Measurable f :=
    (hp.comp measurable_fst).prodMk (ho.comp ((hp.comp measurable_fst).prodMk measurable_snd))
  ext s hs
  change ((μ.prod ν).map f) s = _
  rw [Measure.map_apply hm hs, Measure.prod_apply (hm hs), Measure.compProd_apply hs,
    lintegral_map (Kernel.measurable_kernel_prodMk_left hs) hp]
  apply lintegral_congr
  intro a
  rw [hk]
  have hx : Measurable (fun b => observe (past a, b)) := ho.comp measurable_prodMk_left
  rw [Measure.map_apply hx (measurable_prodMk_left hs)]
  rfl

theorem condExp_step {α : Type} [MeasurableSpace α] (P : Measure α) [IsProbabilityMeasure P]
    {T t : ℕ} (ht : t < T) (f : TrialTape.{u} α (t + 1) → ℝ) (hf : Measurable f)
    (hi : Integrable f (law P (t + 1))) :
    let pre := take (Nat.succ_le_of_lt ht)
    (law P T)[f ∘ pre | filtration (α := α) T t] =ᵐ[law P T]
      fun p => ∫ b, f ((pre p).1, b) ∂P := by
  intro pre
  let μ := law P T
  let ν := law P (t + 1)
  letI : IsProbabilityMeasure μ := probabilityLaw P T
  letI : IsProbabilityMeasure ν := probabilityLaw P (t + 1)
  have hp : MeasurePreserving pre μ ν := ⟨measurable_take _, take_law P _⟩
  have he : filtration (α := α) T t =
      ((measurableSpace t).comap (Prod.fst : TrialTape α (t + 1) → TrialTape α t)).comap pre := by
    rw [filtration_eq ht.le]
    change (measurableSpace t).comap (take ht.le) = _
    rw [← take_comp (Nat.le_succ t) (Nat.succ_le_of_lt ht)]
    rw [take_succ (le_refl t), take_refl, Function.id_comp]
    exact MeasurableSpace.comap_comp.symm
  rw [he]
  refine (condExp_pullback μ ν pre hp
    ((measurableSpace t).comap (Prod.fst : TrialTape α (t + 1) → TrialTape α t))
    measurable_fst.comap_le f hi).trans ?_
  have h := condExp_product_past (law P t) P f hf hi
  change (ν[f | (measurableSpace t).comap (Prod.fst : TrialTape α (t+1) → TrialTape α t)]) =ᵐ[ν]
    (fun p => ∫ b, f (p.1, b) ∂P) at h
  refine ae_of_ae_map hp.aemeasurable
    (p := fun p =>
      (ν[f | (measurableSpace t).comap (Prod.fst : TrialTape α (t+1) → TrialTape α t)]) p =
        ∫ b, f (p.1, b) ∂P) ?_
  rwa [hp.map_eq]

/-- Interleave a learner's random draws and an independent environment tape. -/
def zip {α β : Type} : (t : ℕ) → TrialTape.{u} α t × TrialTape.{u} β t →
    TrialTape.{u} (α × β) t
  | 0, _ => ULift.up ()
  | t + 1, p => (zip t (p.1.1, p.2.1), p.1.2, p.2.2)

private theorem measurePreserving_shuffle
    {α β γ δ : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [MeasurableSpace γ] [MeasurableSpace δ]
    (a : Measure α) (b : Measure β) (c : Measure γ) (d : Measure δ)
    [IsFiniteMeasure a] [IsFiniteMeasure b] [IsFiniteMeasure c] [IsFiniteMeasure d] :
    MeasurePreserving (fun p : (α × β) × (γ × δ) =>
      ((p.1.1, p.2.1), (p.1.2, p.2.2))) ((a.prod b).prod (c.prod d))
        ((a.prod c).prod (b.prod d)) := by
  let h₁ := measurePreserving_prodAssoc a b (c.prod d)
  let h₂ := (MeasurePreserving.id a).prod
    ((measurePreserving_prodAssoc b c d).symm MeasurableEquiv.prodAssoc)
  let h₃ := (MeasurePreserving.id a).prod
    ((Measure.measurePreserving_swap (μ := b) (ν := c)).prod (MeasurePreserving.id d))
  let h₄ := (MeasurePreserving.id a).prod (measurePreserving_prodAssoc c b d)
  let h₅ := (measurePreserving_prodAssoc a c (b.prod d)).symm MeasurableEquiv.prodAssoc
  exact h₅.comp (h₄.comp (h₃.comp (h₂.comp h₁)))

theorem measurePreserving_zip {α β : Type} [MeasurableSpace α] [MeasurableSpace β]
    (P : Measure α) (Q : Measure β) [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    (t : ℕ) : MeasurePreserving (zip.{u} t) ((law P t).prod (law Q t)) (law (P.prod Q) t) := by
  induction t with
  | zero =>
    letI : IsProbabilityMeasure (law.{u} P 0) := probabilityLaw P 0
    letI : IsProbabilityMeasure (law.{u} Q 0) := probabilityLaw Q 0
    refine ⟨measurable_const, ?_⟩
    change (Measure.map (fun _ : TrialTape.{u} α 0 × TrialTape.{u} β 0 =>
      (ULift.up () : TrialTape.{u} (α × β) 0)) ((law P 0).prod (law Q 0))) = law (P.prod Q) 0
    rw [Measure.map_const, measure_univ, one_smul]
    rfl
  | succ t ih =>
    exact (ih.prod (MeasurePreserving.id (P.prod Q))).comp
      (measurePreserving_shuffle (law P t) P (law Q t) Q)

@[simp] theorem read_zip {α β : Type} {t : ℕ} (i : Fin t)
    (a : TrialTape.{u} α t) (b : TrialTape.{u} β t) :
    read i (zip t (a,b)) = (read i a, read i b) := by
  induction t with
  | zero => exact Fin.elim0 i
  | succ t ih =>
    refine Fin.lastCases ?_ (fun j => ?_) i
    · rw [read_last, read_last, read_last]
      rfl
    · rw [read_castSucc, read_castSucc, read_castSucc]
      exact ih j a.1 b.1

end TrialTape

