section
variable {R F : Type} [CommRing R] [IsLocalRing R] [Field F] [Algebra R F]

theorem exists_algHom_residueField_forall_apply_eq_zero_iff
    (hres : IsAlgClosed (ResidueField R)) (j : F) [Fact (j ≠ 0)]
    (y : Ideal ↥(chartAlgFin R F j)) (hy : y.IsMaximal)
    (hmy : ∀ r ∈ maximalIdeal R, algebraMap R ↥(chartAlgFin R F j) r ∈ y) :
    ∃ ψ : ↥(chartAlgFin R F j) →ₐ[R] ResidueField R, ∀ c, ψ c = 0 ↔ c ∈ y := by
  classical
  haveI := hy

  let κ := ResidueField R
  let Cy := ↥(chartAlgFin R F j) ⧸ y
  have hker : ∀ r ∈ maximalIdeal R, (Ideal.Quotient.mk y) (algebraMap R ↥(chartAlgFin R F j) r) = 0 :=
    fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (hmy r hr)
  let θ : κ →+* Cy := Ideal.Quotient.lift (maximalIdeal R) ((Ideal.Quotient.mk y).comp (algebraMap R _))
    (fun r hr => hker r hr)
  have hθ : ∀ r : R, θ (residue R r) = Ideal.Quotient.mk y (algebraMap R _ r) := fun r => rfl

  have hθinj : Function.Injective θ := θ.injective
  have hθsurj : Function.Surjective θ := by
    intro b
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem_of_isMaximal_chartAlgFin hres j y hy hmy b
    refine ⟨residue R c, ?_⟩
    rw [hθ, eq_comm, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact hc
  let θe : κ ≃+* Cy := RingEquiv.ofBijective θ ⟨hθinj, hθsurj⟩

  let ψ₀ : ↥(chartAlgFin R F j) →+* κ := (θe.symm : Cy →+* κ).comp (Ideal.Quotient.mk y)
  have hψ₀A : ∀ r : R, ψ₀ (algebraMap R _ r) = algebraMap R κ r := by
    intro r
    show θe.symm (Ideal.Quotient.mk y (algebraMap R _ r)) = residue R r
    rw [← hθ]
    exact θe.symm_apply_apply (residue R r)
  let ψ : ↥(chartAlgFin R F j) →ₐ[R] κ :=
    { ψ₀ with commutes' := hψ₀A }
  refine ⟨ψ, fun c => ?_⟩
  show θe.symm (Ideal.Quotient.mk y c) = 0 ↔ c ∈ y
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  constructor
  · intro h
    exact θe.symm.injective (h.trans (map_zero θe.symm).symm)
  · intro h; rw [h, map_zero]

theorem algHom_apply_eq_of_forall_sub_algebraMap_mem_iff
    (j : F) [Fact (j ≠ 0)]
    (y₁ y₂ : Ideal ↥(chartAlgFin R F j))
    (ψ₁ ψ₂ : ↥(chartAlgFin R F j) →ₐ[R] ResidueField R)
    (hψ₁ : ∀ c, ψ₁ c = 0 ↔ c ∈ y₁) (hψ₂ : ∀ c, ψ₂ c = 0 ↔ c ∈ y₂)
    (c : ↥(chartAlgFin R F j))
    (h : ∀ a : R, c - algebraMap R _ a ∈ y₁ ↔ c - algebraMap R _ a ∈ y₂) :
    ψ₁ c = ψ₂ c := by
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (ψ₁ c)

  have hA : ∀ (ψ : ↥(chartAlgFin R F j) →ₐ[R] ResidueField R) (a : R), ψ (algebraMap R _ a) = Ideal.Quotient.mk _ a :=
    fun ψ a => ψ.commutes a
  have h1 : c - algebraMap R _ a ∈ y₁ := by
    rw [← hψ₁, map_sub, hA, ← ha, sub_self]
  have h2 : ψ₂ (c - algebraMap R _ a) = 0 := (hψ₂ _).mpr ((h a).mp h1)
  rw [map_sub, hA, sub_eq_zero] at h2
  rw [h2, ← ha]

end

