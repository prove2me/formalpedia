private theorem hHalf_levelOne (q : ℕ) (hq : q.Prime)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q) :
    haveI : NeZero q := ⟨hq.ne_zero⟩
    ∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ x : JZero (1 * q), PrimeToTorsion q x →
      σ • x - x ∈ inertiaInvariants A (1 * q) := by
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI : Fact q.Prime := ⟨hq⟩

  haveI : CharP (ResidueField ↥A) q := ValuationSubring.charP_residueField_of_liesOverPrime_def hq hA
  haveI : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField A
  letI : DecidableEq (ResidueField ↥A) := instDecidableEqResidueFieldSemistable A
  letI := instAlgebraResidueFieldModularFunctionFieldCSemistable A 1

  obtain ⟨data⟩ := ModularCurve.nonempty_modularPolynomialData q
  have hKr := ModularCurve.kroneckerCongruence q data
  have hα := ModularCurve.heckeAlphaBarIntegral_of_prime (AlgebraicClosure ℚ) 1 q
  have hβ := ModularCurve.heckeBetaBarIntegral_of_prime (AlgebraicClosure ℚ) 1 q

  have hWfin : (ssPlaces q 1 (ResidueField ↥A)).Finite := ModularCurve.ssPlaces_finite q 1 (ResidueField ↥A)
  have hW : ∀ w, w ∈ hWfin.toFinset ↔ w ∈ ssPlaces q 1 (ResidueField ↥A) :=
    fun w => Set.Finite.mem_toFinset hWfin

  obtain ⟨P', R, hR, hRL, hNV, hO⟩ :=
    ModularCurve.PlaceSpecialization.exists_prolongationTuple_isModel_and_orderLawFixed_level_one
      (A := A) (red := IsLocalRing.residue ↥A) (data := data) (hKr := hKr) (hα := hα) (hβ := hβ)
