  have S₃ := S₂.next fun a ha => hkept₃ a (by omega)
  -- res := scanPairsAE(out, qi + lo, qj + lo, w, fl, ab, bc, ac, n, c0, len)
  have hself : withMarks μ₃ fl (X.n * X.n) (X.marks t) = μ₃ := withMarks_self fun q hq => by
    rw [S₃.kept (fl + q) (by omega)]
