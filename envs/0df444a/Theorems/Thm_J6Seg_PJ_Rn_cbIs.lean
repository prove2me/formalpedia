variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {u : Vr} {c : Cs}

theorem J6Seg.PJ.Rn.cbIs (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r Wb i : ℕ} (h1 : u 1 = r) (h3 : u 3 = Wb) (h2 : u 2 = i)
    (hi : i < Wb) (hrW : r + Wb < m) (h4 : u 4 = Lg L r) :
    Rn (progL cbI) u c (fun u' => (∀ i ∉ ([7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update c 41 ((if ¬ cB ≤ Lg L (r + 1 + (Wb - 1 - i)) ∧
          bandS mw cB (Lg L r) (Lg L (r + 1 + (Wb - 1 - i)))
        then Mf r (r + 1 + (Wb - 1 - i)) else 0) :: c 41))
      (costL W (m * m + m) cbI) := by sorry
