    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N m : ℕ) [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hNsq : Squarefree N) (hm : 3 ≤ m)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪))
    (h3 : IsUnit ((3 : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪))
    {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of 𝒪)}
    {ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM}
    (hM : IsFineModuli Λ N m M πM ptF)
    {G : Type} [Group G] [Finite G] {ρ : G →* Aut M} {χ : G → ↥Λ} (hρ : IsLevelTwistAction Λ N m M πM ptF G ρ χ)
    (X : Scheme.{0}) (πX : X ⟶ Spec (CommRingCat.of 𝒪)) (π : M ⟶ X) (hπX : π ≫ πX = πM)
    (hπ : ∀ g : G, (ρ g).hom ≫ π = π)
    (hint : IsIntegralHom π) (haff : IsAffineHom π) (hsurj : Function.Surjective π.base)
    (horbit : ∀ x x' : M, π.base x = π.base x' ↔ ∃ g : G, (ρ g).hom.base x = x')
    (hsec : ∀ V : X.Opens, Function.Injective (π.app V))
    (hinv : ∀ V : X.Opens, Set.range (π.app V) =
      {s | ∀ g : G, (ρ g).hom.appLE (π ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← Scheme.Hom.comp_preimage, hπ g]) s = s})
    (hopen : ∀ U : M.Opens, IsAffineOpen U → (∀ g : G, (ρ g).hom ⁻¹ᵁ U = U) → ∃ V : X.Opens, IsAffineOpen V ∧ π ⁻¹ᵁ V = U)
    (hcat : ∀ (T : Scheme.{0}) (f : M ⟶ T), (∀ g : G, (ρ g).hom ≫ f = f) → ∃! f' : X ⟶ T, π ≫ f' = f)
    {pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)), FakeEllipticCurve Λ N S → SchemeHomOver s πX}
    (hX : IsCoarseModuli Λ N X πX pt) (hsep : IsSeparated πX) :
    IsIntegral X ∧ Flat πX ∧ LocallyOfFiniteType πX := by
  obtain ⟨hflat, hlft⟩ := CerednikDrinfeld.QM.IsFineModuli.flat_and_locallyOfFiniteType_of_quotient_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm 𝒪 hN hm' h2 h3 hM hρ G (MonoidHom.id G) (fun _ _ h => h)
    X πX π hπX hπ hint haff hsurj horbit hsec hinv hopen hcat

  let K := FractionRing 𝒪
  let k := AlgebraicClosure K
  have hiK : Function.Injective (algebraMap 𝒪 K) := IsFractionRing.injective 𝒪 K
  haveI : CharZero K := charZero_of_injective_algebraMap hiK
  let i : 𝒪 →+* k := (algebraMap K k).comp (algebraMap 𝒪 K)
  have hi : Function.Injective i := (algebraMap K k).injective.comp hiK
  obtain ⟨ptk, hXk⟩ :=
    CerednikDrinfeld.QM.IsCoarseModuli.exists_isCoarseModuli_pullback_of_injective_of_isUnit_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N 𝒪 hN h2 h3 m hm hm'
      hX hsep hlft k i hi
  have hk : IsIntegral (Limits.pullback πX (Spec.map (CommRingCat.ofHom i))) :=
    CerednikDrinfeld.QM.IsCoarseModuli.isIntegral_of_isAlgClosed_of_not_dvd_of_squarefree hqq' hB Λ hΛ N hqN hq'N hNsq k _ _ ptk hXk (MorphismProperty.pullback_snd _ _ hsep)
      (MorphismProperty.pullback_snd _ _ hlft)
  have hK : IsIntegral (Limits.pullback πX (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)))) :=
    AlgebraicGeometry.isIntegral_pullback_of_isIntegral_pullback_algebraicClosure πX K hk
  haveI := hflat
  haveI := hK
  exact ⟨AlgebraicGeometry.isIntegral_of_flat_of_isIntegral_pullback_specMap_of_isFractionRing K πX, hflat, hlft⟩

end ReduceINT

