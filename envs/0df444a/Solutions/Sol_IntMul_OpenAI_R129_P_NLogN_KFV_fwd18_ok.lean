theorem twistU_run (s : IState HS) (f : Fin HS → List ℤ) {L : LP} {h U W : ℕ} (fl : List Bool)
    (op : Bool) (H : GRegs s f L h) (hL : L.OK)
    (hgT : f NLogN.KFV.gT = []) (hg2 : f gT2 = []) (hgV : f NLogN.KFV.gV = []) (hgQ : f tbQ = []) (hgN : f tbN = [])
    (hgM : f tbM = []) (hgR : f gRk = []) (hgA : f NLogN.KFV.gA = []) (hgI : f NLogN.KFV.gI = [])
    (hgC : f tbC = []) (hgK : f tbK = []) (hgL : f tbL = []) (hW : ∀ x ∈ tbWork, f x = [])
    (hqX : f qX = []) (hqB : f NLogN.KFV.qB = []) (hqZ : f qZ = [])
    (hfl : fl.length = L.D) (hcnt : fl.count true ≤ L.n) (hDU : L.D ≤ U)
    (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 3 * 2 ^ (L.ℓ + 1) ≤ U) (h2n : 2 ^ L.n + 1 ≤ U)
    (hmU : L.D * h ≤ U) {rG rG2 : List ℤ} (hG : f gLG = fl.map fv ++ rG) (hG2 : f gLG2 = rG2)
    (zs : List GI) (l : List ℤ) (hzs : zs.length = 2 ^ L.n * 2 ^ L.ℓ) (h0 : f 0 = gflat zs ++ l)
    (hb : NLogN.KFB.GB W zs) :
    IRuns I iprog (twistU op) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (gflat (twZ (2 ^ L.ℓ) (2 ^ L.n)
        (svN (2 ^ (L.ℓ + 1)) (genG L fl op h).reverse) zs) ++ l)))
      (cTwistU L.n L.ℓ L.D h (genG L fl op h).length W (zsz (U : ℤ))) := by
  set Q := 2 ^ (L.ℓ + 1)
  set N := 2 ^ L.n
  set r := 2 ^ L.ℓ
  set T := (genG L fl op h).reverse
  have hQr : Q = 2 * r := by simp only [Q, r, pow_succ]; ring
  have hQ0 : 0 < Q := by positivity
  have R1 := FSp.irun (I := I) (iprog := iprog) (fok_twA op)
    (twA_fsp s f fl op H hL hgT hg2 hgV hgQ hgN hgM hgR hgA hgI hgC hgK hgL hW hqX hqB hqZ hfl hcnt
      hDU hhl hnU h2l h2n hmU hG hG2)
  set fT := Function.update (Function.update (Function.update (Function.update f 14
    (tabG L fl op h ++ f 14)) qX [((N : ℕ) : ℤ)]) NLogN.KFV.qB [((Q : ℕ) : ℤ)]) qZ [((Q : ℕ) : ℤ)]
  have e14 : tabG L fl op h = (List.range N).map fun p => ((svN Q T p : ℕ) : ℤ) := by
    simp only [tabG]
    apply List.map_congr_left; intro j _; rw [svN_cast hQ0]
  have R2 := twCU_runs (I := I) (iprog := iprog) N r W (by positivity) (svN Q T)
