lemma bitGram_mulVec {h : ℕ} (x : Fin h → K) :
    bitGram K h *ᵥ x = x - ((9 : K)⁻¹ * ∑ i, x i) • (fun _ => (1 : K)) := by
  rw [bitGram, Matrix.sub_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec]
  congr 1
  funext i
  simp [Matrix.mulVec, dotProduct, Finset.mul_sum]

lemma bf_bitGram {h : ℕ} (x y : Fin h → K) :
    bf (bitGram K h) x y = x ⬝ᵥ y - (9 : K)⁻¹ * (∑ i, x i) * (∑ i, y i) := by
  rw [bf, bitGram_mulVec, dotProduct_sub, dotProduct_smul, smul_eq_mul]
  have : x ⬝ᵥ (fun _ => (1 : K)) = ∑ i, x i := by simp [dotProduct]
  rw [this]; ring

