def torsionByProdEquiv (M N : Type) [AddCommGroup M] [AddCommGroup N] (m : ℤ) :
    ↥(Submodule.torsionBy ℤ (M × N) m) ≃ ↥(Submodule.torsionBy ℤ M m) × ↥(Submodule.torsionBy ℤ N m) where
  toFun x := (⟨x.1.1, by have := (Submodule.mem_torsionBy_iff _ _).mp x.2; exact (Submodule.mem_torsionBy_iff _ _).mpr (congrArg Prod.fst this)⟩,
    ⟨x.1.2, by have := (Submodule.mem_torsionBy_iff _ _).mp x.2; exact (Submodule.mem_torsionBy_iff _ _).mpr (congrArg Prod.snd this)⟩)
  invFun y := ⟨(y.1.1, y.2.1), (Submodule.mem_torsionBy_iff _ _).mpr (Prod.ext ((Submodule.mem_torsionBy_iff _ _).mp y.1.2) ((Submodule.mem_torsionBy_iff _ _).mp y.2.2))⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem natCard_torsionBy_prod (M N : Type) [AddCommGroup M] [AddCommGroup N] (m : ℤ) :
    Nat.card ↥(Submodule.torsionBy ℤ (M × N) m) = Nat.card ↥(Submodule.torsionBy ℤ M m) * Nat.card ↥(Submodule.torsionBy ℤ N m) := by
  rw [Nat.card_congr (torsionByProdEquiv M N m), Nat.card_prod]

