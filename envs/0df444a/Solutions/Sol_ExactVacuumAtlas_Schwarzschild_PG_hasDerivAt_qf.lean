open Real
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.PG
theorem solution {M r : ℝ} (hM : 0 ≤ M) (hr : 0 < r) :
    HasDerivAt (fun u => qf M u) (-(qf M r) / (2 * r)) r := by
  rcases hM.lt_or_eq with hM' | rfl
  · have h1 : HasDerivAt (fun u : ℝ => 2 * M / u) (-(2 * M) / r ^ 2) r :=
      Deriv.div_self_prime (2 * M) r hr.ne'
    have hpos : 0 < 2 * M / r := by positivity
    have h2 := h1.sqrt hpos.ne'
    have hs : Real.sqrt (2 * M / r) ≠ 0 := (Real.sqrt_pos.mpr hpos).ne'
    have hsq : Real.sqrt (2 * M / r) ^ 2 = 2 * M / r := Real.sq_sqrt hpos.le
    unfold qf
    refine h2.congr_deriv ?_
    generalize Real.sqrt (2 * M / r) = Q at hs hsq ⊢
    have hM2 : 2 * M = Q ^ 2 * r := by field_simp at hsq; linarith
    rw [hM2]
    field_simp
    try ring
  · simp only [qf_zero, neg_zero, zero_div]
    exact hasDerivAt_const r 0
