theorem agree_pushSt {σ : Fin HS → Option ℤ} (t : IState HS) (l : List (Fin HS × ℤ))
    (hnd : (l.map Prod.fst).Nodup) (hσ : ∀ i v, σ i = some v → (i, v) ∈ l) : Agree σ (pushSt t l) := by
  intro i v hv
  have hm := hσ i v hv
  clear hσ
  refine ⟨t.G i, ?_⟩
  rw [pushSt_G]
  have hf : l.filter (fun p => p.1 = i) = [(i, v)] := by
    induction l with
    | nil => simp at hm
    | cons p l ih =>
      obtain ⟨j, u⟩ := p
      simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnd
      rcases List.mem_cons.1 hm with h | h
      · cases h
        rw [List.filter_cons_of_pos (by simp), List.filter_eq_nil_iff.2]
        intro q hq hq'
        exact hnd.1 ⟨q, hq, by simpa using hq'⟩
      · have hj : j ≠ i := fun e => hnd.1 ⟨(i, v), h, by simp [e]⟩
        rw [List.filter_cons_of_neg (by simpa using hj)]
        exact ih hnd.2 h
  rw [hf]; simp [ints]

