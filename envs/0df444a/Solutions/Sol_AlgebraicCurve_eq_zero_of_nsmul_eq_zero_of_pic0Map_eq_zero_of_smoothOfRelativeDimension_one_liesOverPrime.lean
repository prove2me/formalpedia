  have compat : ∀ c : Pic0 (AlgebraicClosure ℚ) F, ptsk (r c) = redk (ext (ptsQ c)) := by

    have Ψ₁_add : ∀ x y : Pic0 (AlgebraicClosure ℚ) F, ptsk (r (x + y)) = ptsk (r x) * ptsk (r y) := by
      intro x y; rw [map_add, hptsk_add]; rfl
    have Ψ₂_add : ∀ x y : Pic0 (AlgebraicClosure ℚ) F, redk (ext (ptsQ (x + y))) = redk (ext (ptsQ x)) * redk (ext (ptsQ y)) := by
      intro x y; rw [hptsQ_add]; show redH (extH (ptsQ x * ptsQ y)) = _; rw [map_mul, map_mul]; rfl
    let S : AddSubgroup (Pic0 (AlgebraicClosure ℚ) F) :=
      { carrier := {c | ptsk (r c) = redk (ext (ptsQ c))}
        add_mem' := fun {x y} hx hy => by
          simp only [Set.mem_setOf_eq] at hx hy ⊢
          rw [Ψ₁_add, Ψ₂_add, hx, hy]
        zero_mem' := by
          simp only [Set.mem_setOf_eq]
          rw [map_zero, ptsk_zero, ptsQ_zero]; show (1 : SchemeHomOver sk f) = redH (extH 1); rw [map_one, map_one]
        neg_mem' := fun {x} hx => by
          simp only [Set.mem_setOf_eq] at hx ⊢
          have h1 : ptsk (r (-x)) * ptsk (r x) = 1 := by rw [← Ψ₁_add, neg_add_cancel, map_zero, ptsk_zero]
