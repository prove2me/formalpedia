-- Source module: Solutions.J6SegKr1
/-!
# B3 (chunk kernel), part 1: the Gaussian stages as list maps

The chunk kernel on a Gaussian row is `liftG (chunkK q)`. Here it is rewritten in the form the
IL computes:

* `liftG_comp`, `liftG_append`: `liftG` commutes with composition / concatenation of
  length-preserving maps;
* `dgG c z`: the diagonal stage on pairs (`liftG (dgL P c) = dgG P c`);
* **`kmulD_toep`**: the zero-padded Kronecker record product with `Δ = 0` gives the exact
  lower-triangular Toeplitz sums `convL` of both parts (`2 n ≤ r + 1`);
* `lwG`, `upG`: the Toeplitz stages on pairs from `kmulD` (`liftG (lwL P c) = lwG`, …);
* `blkG`, `chunkG`: the block solve and the chunk kernel on pairs (`liftG (chunkL …) = chunkG …`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg

open IntMul NLogN NLogN.KFV

/-! ## `liftG` algebra -/

theorem liftG_reverse (f : List ℤ → List ℤ) (z : List (ℤ × ℤ))
    (hf : ∀ y : List ℤ, (f y).length = y.length) :
    liftG (fun y => (f y.reverse).reverse) z = (liftG f z.reverse).reverse := by
  unfold liftG
  beta_reduce
  rw [List.map_reverse, List.map_reverse, List.zip_eq_zipWith, List.zip_eq_zipWith,
    List.reverse_zipWith (by rw [hf, hf]; simp)]

lemma getD_map_of_lt {α β : Type*} {l : List α} {f : α → β} {k : ℕ} (h : k < l.length) (d : β)
    (d' : α) : (l.map f).getD k d = f (l.getD k d') := by
  rw [List.getD_eq_getElem _ _ (by simpa using h), List.getElem_map, List.getD_eq_getElem _ _ h]

theorem liftG_compL (f g : List ℤ → List ℤ) (z : List (ℤ × ℤ)) (hg : LPres g) :
    liftG (f ∘ g) z = liftG f (liftG g z) := by
  have h : (g (z.map Prod.fst)).length = (g (z.map Prod.snd)).length := hg _ _ (by simp)
  have e : liftG f (liftG g z) =
      List.zip (f ((liftG g z).map Prod.fst)) (f ((liftG g z).map Prod.snd)) := rfl
  rw [e, liftG_fst g z h, liftG_snd g z h]
  rfl

theorem liftG_append (f g : List ℤ → List ℤ) {n : ℕ} {z : List (ℤ × ℤ)} (hf : LPres f) :
    liftG (fun y => f (y.take n) ++ g (y.drop n)) z =
      liftG f (z.take n) ++ liftG g (z.drop n) := by
  unfold liftG
  rw [List.zip_append (hf _ _ (by simp)), List.map_take, List.map_take, List.map_drop,
    List.map_drop]

/-! ## The diagonal stage -/

section stages
variable (P : ℕ)

theorem liftG_dgL : ∀ (c : List ℤ) (z : List (ℤ × ℤ)), z.length ≤ c.length →
    liftG (dgL P c) z = dgG P c z
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], _ => by simp [liftG, dgL, dgG]
  | a :: c, w :: z, h => by
    simp only [List.length_cons] at h
    have ih := liftG_dgL c z (by omega)
    simp only [liftG, dgL, dgG, List.map_cons, List.zipWith_cons_cons, List.zip_cons_cons] at ih ⊢
    rw [ih]

lemma length_dgG {c : List ℤ} {z : List (ℤ × ℤ)} (h : z.length ≤ c.length) :
    (dgG P c z).length = z.length := by simp [dgG]; omega

/-! ## Toeplitz sums by one record product -/

/-! ## Toeplitz stages on pairs -/

lemma length_kmulD (r Δ : ℕ) (zx zy : List (ℤ × ℤ)) : (kmulD r Δ zx zy).length = r := by
  simp [kmulD]

lemma length_lwG {r : ℕ} {c : List ℤ} {z : List (ℤ × ℤ)} (hr : z.length ≤ r) :
    (lwG P r c z).length = z.length := by
  simp [lwG, length_kmulD]; omega

theorem liftG_lwL {r : ℕ} (c : List ℤ) (z : List (ℤ × ℤ)) (hc : z.length ≤ c.length)
    (hr : 2 * z.length ≤ r + 1) : liftG (lwL P c) z = lwG P r c z := by
  have hzr : z.length ≤ r := by omega
  apply ext_getD' (by
    rw [length_lwG P hzr, length_liftG _ z.length (fun y hy => by rw [length_lwL, hy]) z rfl])
  intro k hk
  rw [length_liftG _ z.length (fun y hy => by rw [length_lwL, hy]) z rfl] at hk
  unfold liftG
  rw [getD_zip_of_lt (by simp [length_lwL]; exact hk) (by simp [length_lwL]; exact hk)]
  rw [List.getD_eq_getElem (lwG P r c z) _ (by rw [length_lwG P hzr]; exact hk)]
  unfold lwG
  simp only [List.getElem_map, List.getElem_take]
  have e := kmulD_toep (r := r) c z hc hr hk
  rw [List.getD_eq_getElem _ _ (by simp [length_kmulD]; omega)] at e
  rw [e]
  unfold lwL
  rw [getD_map_of_lt (l := convL c (z.map Prod.fst)) (by rw [length_convL]; simpa using hk) _ 0,
    getD_map_of_lt (l := convL c (z.map Prod.snd)) (by rw [length_convL]; simpa using hk) _ 0]

theorem liftG_upL {r : ℕ} (c : List ℤ) (z : List (ℤ × ℤ)) (hc : z.length ≤ c.length)
    (hr : 2 * z.length ≤ r + 1) : liftG (upL P c) z = upG P r c z := by
  have e : upL P c = fun y => (lwL P c y.reverse).reverse := rfl
  rw [e, liftG_reverse (lwL P c) z (fun y => length_lwL P c y), upG,
    liftG_lwL P c z.reverse (by simpa using hc) (by simpa using hr)]

/-! ## The block solve and the chunk kernel on pairs -/

theorem liftG_blkL {r : ℕ} {di gi gam dd am ap : List ℤ} (z : List (ℤ × ℤ))
    (h1 : z.length ≤ di.length) (h2 : z.length ≤ gi.length) (h3 : z.length ≤ gam.length)
    (h4 : z.length ≤ dd.length) (h5 : z.length ≤ am.length) (h6 : z.length ≤ ap.length)
    (hr : 2 * z.length ≤ r + 1) :
    liftG (blkL P di gi gam dd am ap) z = blkG P r di gi gam dd am ap z := by
  have hz : z.length ≤ r := by omega
  have e : blkL P di gi gam dd am ap = (dgL P dd) ∘ (dgL P gi) ∘ (upL P ap) ∘ (dgL P gam) ∘
      (lwL P am) ∘ (dgL P gi) ∘ (dgL P di) := rfl
  -- the stages preserve lengths on short enough inputs; work with `liftG` step by step
  have l1 : (dgG P di z).length = z.length := length_dgG P h1
  have l2 : (dgG P gi (dgG P di z)).length = z.length := by rw [length_dgG P (by omega), l1]
  have l3 : (lwG P r am (dgG P gi (dgG P di z))).length = z.length := by
    rw [length_lwG P (by omega), l2]
  have l4 : (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))).length = z.length := by
    rw [length_dgG P (by omega), l3]
  have l5 : (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z))))).length = z.length := by
    simp only [upG, List.length_reverse]; rw [length_lwG P (by simp; omega)]; simp [l4]
  have l6 : (dgG P gi (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))))).length =
      z.length := by rw [length_dgG P (by omega), l5]
  unfold blkG
  rw [e]
  rw [liftG_compL, liftG_compL, liftG_compL, liftG_compL, liftG_compL, liftG_compL]
  all_goals try (intro y y' h; simp [Function.comp, dgL, length_lwL, length_upL, h]; done)
  rw [liftG_dgL P di z h1]
  rw [liftG_dgL P gi (dgG P di z) (by rw [l1]; exact h2)]
  rw [liftG_lwL P (r := r) am (dgG P gi (dgG P di z)) (by rw [l2]; exact h5) (by rw [l2]; exact hr)]
  rw [liftG_dgL P gam (lwG P r am (dgG P gi (dgG P di z))) (by rw [l3]; exact h3)]
  rw [liftG_upL P (r := r) ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))) (by rw [l4]; exact h6)
    (by rw [l4]; exact hr)]
  rw [liftG_dgL P gi (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))))
    (by rw [l5]; exact h2)]
  rw [liftG_dgL P dd (dgG P gi (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z))))))
    (by rw [l6]; exact h4)]

lemma lp_blkL (di gi gam dd am ap : List ℤ) : LPres (blkL P di gi gam dd am ap) := by
  intro y y' h; simp [blkL, upL, dgL, length_lwL, h]

end stages

end J6Seg

