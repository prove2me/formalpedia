theorem case_D_parent_count :
    ∀ (SC : SpernerCube) {n1 : ℕ} {hn1 : n1 + 1 = SC.n} (I : Fin (n1 + 1) → SC.G),
  simplex SC n1 I →
    case_D SC I → Finset.card (α := Fin (SC.n + 1) → SC.G) {J : Fin (SC.n + 1) → SC.G | is_face SC I J} = 2
:= by sorry
