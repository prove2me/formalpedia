theorem stage4_replay {k : ℂ} {f : ℂ × ℂ → ℂ}
    (hk : k ≠ 0) (hklog : k = (Real.log 2 : ℂ))
    (hf : Approximates 24 k f stage3) (hf0 : f 0 = 0) :
    Approximates 24 k (fun z => z.1 * ComplexEntropy.entropyExt (f z)) stage4 := by
  have h2 : Approximates 24 k (fun z => f z ^ 2) replay4p2 := by
    convert (hf.mul hk hf).replacePolynomial (equalityCheck_sound replay4p2_checked k) using 1
    funext z
    ring
  have h4 : Approximates 24 k (fun z => f z ^ 4) replay4p4 := by
    convert (h2.mul hk h2).replacePolynomial (equalityCheck_sound replay4p4_checked k) using 1
    funext z
    ring
  have h6 : Approximates 24 k (fun z => f z ^ 6) replay4p6 := by
    convert (h2.mul hk h4).replacePolynomial (equalityCheck_sound replay4p6_checked k) using 1
    funext z
    ring
  have h8 : Approximates 24 k (fun z => f z ^ 8) replay4p8 := by
    convert (h2.mul hk h6).replacePolynomial (equalityCheck_sound replay4p8_checked k) using 1
    funext z
    ring
  have h10 : Approximates 24 k (fun z => f z ^ 10) replay4p10 := by
    convert (h2.mul hk h8).replacePolynomial (equalityCheck_sound replay4p10_checked k) using 1
    funext z
    ring
  have h12 : Approximates 24 k (fun z => f z ^ 12) replay4p12 := by
    convert (h2.mul hk h10).replacePolynomial (equalityCheck_sound replay4p12_checked k) using 1
    funext z
    ring
  have h14 : Approximates 24 k (fun z => f z ^ 14) replay4p14 := by
    convert (h2.mul hk h12).replacePolynomial (equalityCheck_sound replay4p14_checked k) using 1
    funext z
    ring
  have h16 : Approximates 24 k (fun z => f z ^ 16) replay4p16 := by
    convert (h2.mul hk h14).replacePolynomial (equalityCheck_sound replay4p16_checked k) using 1
    funext z
    ring
  have h18 : Approximates 24 k (fun z => f z ^ 18) replay4p18 := by
    convert (h2.mul hk h16).replacePolynomial (equalityCheck_sound replay4p18_checked k) using 1
    funext z
    ring
  have h20 : Approximates 24 k (fun z => f z ^ 20) replay4p20 := by
    convert (h2.mul hk h18).replacePolynomial (equalityCheck_sound replay4p20_checked k) using 1
    funext z
    ring
  have h22 : Approximates 24 k (fun z => f z ^ 22) replay4p22 := by
    convert (h2.mul hk h20).replacePolynomial (equalityCheck_sound replay4p22_checked k) using 1
    funext z
    ring
  have he0 := Approximates.parameter 24 k 1
  have he1 := (he0.add (h2.scale (-1 / 2 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e1_checked k)
  have he2 := (he1.add (h4.scale (-1 / 12 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e2_checked k)
  have he3 := (he2.add (h6.scale (-1 / 30 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e3_checked k)
  have he4 := (he3.add (h8.scale (-1 / 56 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e4_checked k)
  have he5 := (he4.add (h10.scale (-1 / 90 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e5_checked k)
  have he6 := (he5.add (h12.scale (-1 / 132 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e6_checked k)
  have he7 := (he6.add (h14.scale (-1 / 182 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e7_checked k)
  have he8 := (he7.add (h16.scale (-1 / 240 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e8_checked k)
  have he9 := (he8.add (h18.scale (-1 / 306 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e9_checked k)
  have he10 := (he9.add (h20.scale (-1 / 380 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e10_checked k)
  have he11 := (he10.add (h22.scale (-1 / 462 : ℚ))).replacePolynomial
    (equalityCheck_sound replay4e11_checked k)
  have hfinite : Approximates 24 k (fun z => eval k entropySeed (f z,0)) replay4e11 := by
    convert he11 using 1
    funext z
    norm_num [entropySeed, eval, evalTerm]
    <;> ring
  have he := hf.entropy_of_finite hk hklog hf0 hfinite
  exact ((Approximates.coordinateA 24 k).mul hk he).replacePolynomial
    (equalityCheck_sound replay4_final_checked k)

