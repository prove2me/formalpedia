variable {S : Type} [CommRing S] {L : Type} [CommRing L] [Algebra S L] {G : Type} [AddMonoid G]

theorem convMul_apply_single (c c' : WithConv (AddMonoidAlgebra S G →ₐ[S] L)) (v : G) :
    (c * c') (AddMonoidAlgebra.single v 1) =
      c (AddMonoidAlgebra.single v 1) * c' (AddMonoidAlgebra.single v 1) := by
  rw [AlgHom.convMul_apply, AddMonoidAlgebra.comul_single, CommSemiring.comul_apply, TensorProduct.map_tmul,
    Algebra.TensorProduct.lift_tmul]
  simp

theorem convOne_apply_single (v : G) :
    (1 : WithConv (AddMonoidAlgebra S G →ₐ[S] L)) (AddMonoidAlgebra.single v 1) = 1 := by
  rw [AlgHom.convOne_apply, AddMonoidAlgebra.counit_single, CommSemiring.counit_apply, map_one]

theorem convPow_apply_single (c : WithConv (AddMonoidAlgebra S G →ₐ[S] L)) (v : G) (n : ℕ) :
    (c ^ n) (AddMonoidAlgebra.single v 1) = c (AddMonoidAlgebra.single v 1) ^ n := by
  induction n with
  | zero => rw [pow_zero, pow_zero, convOne_apply_single]
  | succ n ih => rw [pow_succ, convMul_apply_single, ih, pow_succ]

theorem conv_ext {c c' : WithConv (AddMonoidAlgebra S G →ₐ[S] L)}
    (h : ∀ v, c (AddMonoidAlgebra.single v 1) = c' (AddMonoidAlgebra.single v 1)) : c = c' := by
  have : c.ofConv = c'.ofConv := AddMonoidAlgebra.algHom_ext h (Subsingleton.elim _ _)
  exact congrArg WithConv.toConv this

theorem convPow_eq_one (c : WithConv (AddMonoidAlgebra S G →ₐ[S] L)) (n : ℕ) (hn : ∀ v : G, n • v = 0) :
    c ^ n = 1 := by
  refine conv_ext (fun v => ?_)
  rw [convPow_apply_single, convOne_apply_single, ← map_pow, AddMonoidAlgebra.single_pow, hn, one_pow]
  exact map_one c.ofConv

end conv

section CharBound

variable {t m : ℕ} [NeZero m] {M : Type} [CommMonoid M]

theorem ofAdd_eq_prod_pow (v : Fin t → ZMod m) :
    Multiplicative.ofAdd v = ∏ i, (Multiplicative.ofAdd (Pi.single i (1 : ZMod m))) ^ (v i).val := by
  conv_lhs => rw [← Finset.univ_sum_single v]
  rw [ofAdd_sum]
  refine Finset.prod_congr rfl (fun i _ => ?_)
  rw [← ofAdd_nsmul, ← Pi.single_smul', nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

theorem monoidHom_ext_single {φ ψ : Multiplicative (Fin t → ZMod m) →* M}
    (h : ∀ i, φ (Multiplicative.ofAdd (Pi.single i 1)) = ψ (Multiplicative.ofAdd (Pi.single i 1))) : φ = ψ := by
  refine MonoidHom.ext (fun x => ?_)
  obtain ⟨v, rfl⟩ := Multiplicative.ofAdd.surjective x
  rw [ofAdd_eq_prod_pow, map_prod, map_prod]
  exact Finset.prod_congr rfl (fun i _ => by rw [map_pow, map_pow, h i])

end CharBound

theorem castOver_mul {R : Type} [CommRing R] {X T : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {ι ι' : T ⟶ Spec (CommRingCat.of R)} (h : ι = ι') (x y : SchemeHomOver ι f) :
    castOver h (L.mul ι x y) = L.mul ι' (castOver h x) (castOver h y) := by
  subst h; rfl

section Object

variable {N₀ p : ℕ} [NeZero N₀] [Fact p.Prime] [NeZero p] {hpN₀ : ¬ p ∣ N₀}
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime p} {Λ : LevelData N₀ p A}
  (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)

theorem genOfBaseChangePt_mul
    (y y' : SchemeHomOver (barPt A) (RelativeGroupLaw.baseChangeStr Λ.σA O.g)) :
    genOfBaseChangePt Λ.hσA ((O.L.baseChange Λ.σA).mul _ y y') =
      O.L.mul _ (genOfBaseChangePt Λ.hσA y) (genOfBaseChangePt Λ.hσA y') := by
  unfold genOfBaseChangePt
  rw [RelativeGroupLaw.baseChangePointToBase_mul]
  exact castOver_mul O.L Λ.hσA _ _

theorem toricPoint_mul {m : ℕ} (hm : 0 < m)
    (χ χ' : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)) :
    O.toricPoint m hm (χ * χ').ofConv = O.toricPoint m hm χ.ofConv + O.toricPoint m hm χ'.ofConv := by
  apply O.pts.injective
  rw [O.pts_add]
  unfold toricPoint
  rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply, O.toricLift_mul m hm χ χ',
    genOfBaseChangePt_mul]

def toricPointHom {m : ℕ} (hm : 0 < m) :
    WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ) →* Multiplicative (JZero (N₀ * p)) where
  toFun χ := Multiplicative.ofAdd (O.toricPoint m hm χ.ofConv)
  map_one' := by
    have h := toricPoint_mul O hm 1 1
    rw [mul_one] at h
    have h0 : O.toricPoint m hm
        (1 : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)).ofConv = 0 := by
      have := congrArg (fun z => z - O.toricPoint m hm
        (1 : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)).ofConv) h
      simpa using this.symm
    rw [h0]; rfl
  map_mul' χ χ' := by rw [← ofAdd_add, ← toricPoint_mul]

theorem toricPoint_one {m : ℕ} (hm : 0 < m) :
    O.toricPoint m hm (1 : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)).ofConv = 0 :=
  congrArg Multiplicative.toAdd (toricPointHom O hm).map_one

theorem nsmul_toricPoint {m : ℕ} (hm : 0 < m)
    (χ : muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ) (n : ℕ) :
    n • O.toricPoint m hm χ = O.toricPoint m hm ((WithConv.toConv χ) ^ n).ofConv := by
  have h := congrArg Multiplicative.toAdd ((toricPointHom O hm).map_pow (WithConv.toConv χ) n)
  simpa [toricPointHom] using h.symm

def rangeSubgroup {m : ℕ} (hm : 0 < m) : AddSubgroup (JZero (N₀ * p)) where
  carrier := Set.range (O.toricPoint m hm)
  add_mem' := by
    rintro _ _ ⟨χ, rfl⟩ ⟨χ', rfl⟩
    exact ⟨(WithConv.toConv χ * WithConv.toConv χ').ofConv, toricPoint_mul O hm _ _⟩
  zero_mem' := ⟨(1 : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)).ofConv, toricPoint_one O hm⟩
  neg_mem' := by
    rintro _ ⟨χ, rfl⟩
    have hm0 : m • O.toricPoint m hm χ = 0 := by
      rw [nsmul_toricPoint, convPow_eq_one _ m (fun v => ?_), toricPoint_one]
      funext i; simp
    have h0 : (m - 1) • O.toricPoint m hm χ + O.toricPoint m hm χ = 0 := by
      rw [← succ_nsmul, Nat.sub_add_cancel hm, hm0]
    rw [← (eq_neg_of_add_eq_zero_left h0), nsmul_toricPoint]
    exact ⟨_, rfl⟩

theorem toricPts_eq_rangeSubgroup {m : ℕ} (hm : 0 < m) : O.toricPts m = rangeSubgroup O hm := by
  apply le_antisymm
  · rw [toricPts, dif_pos hm, AddSubgroup.closure_le]
    exact fun x hx => hx
  · intro x hx
    rw [toricPts, dif_pos hm]
    exact AddSubgroup.subset_closure hx

theorem exists_toricPoint_eq_of_mem {m : ℕ} (hm : 0 < m) {x : JZero (N₀ * p)} (hx : x ∈ O.toricPts m) :
    ∃ χ : muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ, O.toricPoint m hm χ = x := by
  rw [toricPts_eq_rangeSubgroup O hm] at hx
  exact hx

theorem toricPoint_mem {m : ℕ} (hm : 0 < m) (χ : muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ) :
    O.toricPoint m hm χ ∈ O.toricPts m := by
  rw [toricPts_eq_rangeSubgroup O hm]
  exact ⟨χ, rfl⟩

theorem genOfBaseChangePt_injective :
    Function.Injective (genOfBaseChangePt (f := O.g) Λ.hσA) := by
  intro y y' h
  have h1 : (genOfBaseChangePt Λ.hσA y).1 = (genOfBaseChangePt Λ.hσA y').1 := congrArg Subtype.val h
  change (RelativeGroupLaw.baseChangePointToBase Λ.σA y).1 = (RelativeGroupLaw.baseChangePointToBase Λ.σA y').1 at h1
  rw [RelativeGroupLaw.baseChangePointToBase_coe, RelativeGroupLaw.baseChangePointToBase_coe] at h1
  apply Subtype.ext
  apply Limits.pullback.hom_ext h1
  rw [y.2, y'.2]

theorem toricPoint_injective {m : ℕ} (hm : 0 < m) : Function.Injective (O.toricPoint m hm) := by
  intro χ χ' h
  unfold toricPoint at h
  have h1 := genOfBaseChangePt_injective O (O.pts.symm.injective h)
  have h2 := congrArg Subtype.val h1
  rw [NeronModelInfra.schemeHomOverComp_coe, NeronModelInfra.schemeHomOverComp_coe] at h2
  haveI := O.toricLift_isClosedImmersion m hm
  have h3 : (muPt A O.toricRank m χ).1 = (muPt A O.toricRank m χ').1 := (cancel_mono (O.toricLift m hm).1).mp h2
  change Spec.map (CommRingCat.ofHom χ.toRingHom) = Spec.map (CommRingCat.ofHom χ'.toRingHom) at h3
  have h4 : CommRingCat.ofHom χ.toRingHom = CommRingCat.ofHom χ'.toRingHom := Spec.map_injective h3
  have h5 : χ.toRingHom = χ'.toRingHom := congrArg CommRingCat.Hom.hom h4
  exact AlgHom.coe_ringHom_injective h5

theorem mem_jZeroTorsion_iff {M : ℕ} [NeZero M] (m : ℕ) (x : JZero M) :
    x ∈ jZeroTorsion M m ↔ (m : ℤ) • x = 0 :=
  Submodule.mem_torsionBy_iff _ _

theorem toricPts_le_jZeroTorsion (m : ℕ) : O.toricPts m ≤ jZeroTorsion (N₀ * p) m := by
  refine (O.toricPts_le_finPts m).trans ?_
  unfold finPts
  rw [AddSubgroup.closure_le]
  exact fun x hx => hx.1

variable (hΛ : Λ.IsJacobian)

include hΛ in
theorem finite_toricPts {m : ℕ} (hm : 0 < m) : Finite ↥(O.toricPts m) := by
  apply Nat.finite_of_card_ne_zero
  rw [ModularCurve.JZeroNeronObjectAtP.natCard_toricPts N₀ p hpN₀ A hA Λ hΛ O m hm]
  exact pow_ne_zero _ hm.ne'

def redAlgHom (t : ℕ) {m m' : ℕ} (h : m ∣ m') : muCoord ↥A t m' →ₐ[↥A] muCoord ↥A t m :=
  AddMonoidAlgebra.mapDomainAlgHom ↥A ↥A
    (AddMonoidHom.pi fun i => ((ZMod.castHom h (ZMod m)).toAddMonoidHom).comp
      (Pi.evalAddMonoidHom (fun _ : Fin t => ZMod m') i))

theorem toricPoint_comp_redAlgHom {m m' : ℕ} (hm : 0 < m) (hm' : 0 < m') (h : m ∣ m')
    (χ : muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ) :
    O.toricPoint m' hm' (χ.comp (redAlgHom (A := A) O.toricRank h)) = O.toricPoint m hm χ := by
  unfold toricPoint
  congr 2
  apply Subtype.ext
  rw [NeronModelInfra.schemeHomOverComp_coe, NeronModelInfra.schemeHomOverComp_coe,
    ← O.toricLift_compat m m' hm hm' h, ← Category.assoc]
  congr 1
  change Spec.map (CommRingCat.ofHom (χ.comp (redAlgHom (A := A) O.toricRank h)).toRingHom) =
    Spec.map (CommRingCat.ofHom χ.toRingHom) ≫ Spec.map _
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rfl

theorem toricPts_mono {m m' : ℕ} (h : m ∣ m') (hm' : 0 < m') : O.toricPts m ≤ O.toricPts m' := by
  have hm : 0 < m := Nat.pos_of_dvd_of_pos h hm'
  intro x hx
  obtain ⟨χ, rfl⟩ := exists_toricPoint_eq_of_mem O hm hx
  rw [← toricPoint_comp_redAlgHom O hm hm' h χ]
  exact toricPoint_mem O hm' _

include hΛ in

theorem toricPts_eq_inf {m m' : ℕ} (h : m ∣ m') (hm' : 0 < m') :
    O.toricPts m = O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m := by
  classical
  have hm : 0 < m := Nat.pos_of_dvd_of_pos h hm'
  haveI : NeZero m := ⟨hm.ne'⟩
  haveI : Finite ↥(O.toricPts m') := finite_toricPts O hΛ hm'
  haveI : Finite ↥(O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m) :=
    Finite.of_injective _ (AddSubgroup.inclusion_injective (inf_le_left : O.toricPts m' ⊓ _ ≤ _))
  refine AddSubgroup.eq_of_le_of_card_ge (le_inf (toricPts_mono O h hm') (toricPts_le_jZeroTorsion O m)) ?_

  have key : ∀ x : ↥(O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m),
      ∃ χ : muCoord ↥A O.toricRank m' →ₐ[↥A] AlgebraicClosure ℚ,
        O.toricPoint m' hm' χ = x ∧ (WithConv.toConv χ) ^ m = 1 := by
    rintro ⟨x, hxT, hxm⟩
    obtain ⟨χ, rfl⟩ := exists_toricPoint_eq_of_mem O hm' hxT
    refine ⟨χ, rfl, ?_⟩
    have h0 : O.toricPoint m' hm' ((WithConv.toConv χ) ^ m).ofConv =
        O.toricPoint m' hm' (1 : WithConv (muCoord ↥A O.toricRank m' →ₐ[↥A] AlgebraicClosure ℚ)).ofConv := by
      rw [← nsmul_toricPoint, toricPoint_one, ← natCast_zsmul]
      exact (mem_jZeroTorsion_iff m _).mp hxm
    exact congrArg WithConv.toConv (toricPoint_injective O hm' h0)
  choose χ hχ hχm using key

  let f : ↥(O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m) → (Fin O.toricRank → rootsOfUnity m (AlgebraicClosure ℚ)) :=
    fun x i => rootsOfUnity.mkOfPowEq ((χ x) (AddMonoidAlgebra.single (Pi.single i 1) 1)) (by
      have h1 := convPow_apply_single (WithConv.toConv (χ x)) (Pi.single i (1 : ZMod m')) m
      rw [hχm x, convOne_apply_single] at h1
      exact h1.symm)
  have hf : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    rw [← hχ x, ← hχ y]
    congr 1
    apply (AddMonoidAlgebra.lift ↥A (AlgebraicClosure ℚ) (Fin O.toricRank → ZMod m')).symm.injective
    haveI : NeZero m' := ⟨hm'.ne'⟩
    refine monoidHom_ext_single (fun i => ?_)
    have h1 := congrArg (fun g => (((g i : rootsOfUnity m (AlgebraicClosure ℚ)) : (AlgebraicClosure ℚ)ˣ) :
      AlgebraicClosure ℚ)) hxy
    simpa only [f, rootsOfUnity.val_mkOfPowEq_coe, AddMonoidAlgebra.lift_symm_apply, toAdd_ofAdd] using h1
  calc Nat.card ↥(O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m)
      ≤ Nat.card (Fin O.toricRank → rootsOfUnity m (AlgebraicClosure ℚ)) := Nat.card_le_card_of_injective f hf
    _ = Nat.card (rootsOfUnity m (AlgebraicClosure ℚ)) ^ O.toricRank := by
        rw [Nat.card_fun]; simp
    _ ≤ m ^ O.toricRank := Nat.pow_le_pow_left (card_rootsOfUnity (AlgebraicClosure ℚ) m) _
    _ = Nat.card ↥(O.toricPts m) :=
        (ModularCurve.JZeroNeronObjectAtP.natCard_toricPts N₀ p hpN₀ A hA Λ hΛ O m hm).symm

end Object

end ToricTower

theorem solution
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m m' : ℕ) (h : m ∣ m') (hm' : 0 < m') :
    O.toricPts m = O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m :=
  ToricTower.toricPts_eq_inf O hΛ h hm'

end
end S_ModularCurve_JZeroNeronObjectAtP_toricPts_eq_inf
end P2MW
