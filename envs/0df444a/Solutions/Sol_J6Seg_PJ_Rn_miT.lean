  set tv := tV w n (a - c) uu with htvd
  have tun : tu < n := tU_lt hua huu
  have tvn : tv < n := tV_lt hua huu
  have hua' : uaE.den u = ((a - c : ℕ) : ℤ) := den_uaE h1 h7 hca
  have d1 : (ixGE tUE).den u = ((lam - 1 - tu : ℕ) : ℤ) :=
    den_ixGE h24 (den_tUE h1 h2 h3 h7 h26 hca huu) (by omega)
  obtain ⟨w1, hw1⟩ : ∃ w1 : Vr, w1 = update (update u 29 ((lam - 1 - tu : ℕ) : ℤ)) 4
