-- title:
--   Theorem 4.2: identifying content with a generative model
-- statement:
--   Let $1\le n_c$ and $1\le n_s$, and let $\mathcal Z=\mathcal C\times\mathcal S\subseteq\mathbb{R}^{n_c}\times\mathbb{R}^{n_s}$ be open and simply connected. Let pairs $(x,\tilde x)$ be generated by (2)–(3) from $(p_z,p_A,p_{\tilde s\mid s,A},f)$ satisfying Assumptions 3.1–3.2 and conditions (i)–(iii):
--
--   1. $f$ is a diffeomorphism of $\mathcal Z$ onto $\mathcal X=f(\mathcal Z)\subseteq\mathbb{R}^d$;
--   2. $p_z$ is a smooth density on $\mathcal Z$ with $p_z>0$ almost everywhere;
--   3. every style index $l$ lies in some $A$ with $p_A(A)>0$ such that $p(\tilde s_A\mid s_A)$ is smooth in $(s_A,\tilde s_A)$ and, for every $s_A$, positive on an open set containing $s_A$.
--
--   Let $(\hat p_z,\hat p_A,\hat p_{\tilde s\mid s,A},\hat f)$ be a generative model of the same form on $\mathcal Z$, also satisfying (i)–(iii), with $\hat f(\mathcal Z)=\mathcal X$. Suppose it matches the data likelihood,
--
--   $$p_{x,\tilde x}=\hat p_{x,\tilde x}.$$
--
--   Then $g=\hat f^{-1}$ block-identifies the true content: there is a map $h$, injective on $\mathcal C$, with
--
--   $$g(f(c,s))_{1:n_c}=h(c)\qquad\text{for all }(c,s)\in\mathcal Z.$$
--
--   So maximum-likelihood generative modelling of pairs of views recovers the content block up to an invertible reparametrisation.
--
--   **Formalization Note** Equality of likelihoods is stated as equality of the laws of $(x,\tilde x)$ on Borel sets. Block-identification is stated pointwise on $\mathcal Z$, with $h$ injective on $\mathcal C$ (Definition 4.1).
-- source:
--   von Kügelgen, Sharma, Gresele, Brendel, Schölkopf, Besserve and Locatello, Self-Supervised Learning with Data Augmentations Provably Isolates Content from Style, NeurIPS 2021, arXiv:2106.04619v4, Section 4.1, Theorem 4.2, p. 6; proof in Appendix A.1, pp. 17-19

import Mathlib
import Definitions.Def_ContentStyle_Basic

open MeasureTheory
open scoped ContDiff

namespace ContentStyle

theorem generative_block_identifies {nc ns d : ℕ} (hnc : 1 ≤ nc) (hns : 1 ≤ ns)
    (C : Set (Fin nc → ℝ)) (S : Set (Fin ns → ℝ)) (hZ : IsLatentSpace C S)
    (M : LatentModel nc ns) (f : Latent nc ns → Obs d)
    (hM : IsAugModel C S M) (hi : CondI C S f) (hii : CondII C S M) (hiii : CondIII S M)
    (Mhat : LatentModel nc ns) (fhat : Latent nc ns → Obs d)
    (hMhat : IsAugModel C S Mhat) (hihat : CondI C S fhat) (hiihat : CondII C S Mhat)
    (hiiihat : CondIII S Mhat)
    (hX : fhat '' (C ×ˢ S) = f '' (C ×ˢ S))
    (hmatch : ∀ E : Set (Obs d × Obs d), MeasurableSet E →
      obsPairProb C S M f E = obsPairProb C S Mhat fhat E) :
    BlockIdentifies C S f (fun x => (Function.invFunOn fhat (C ×ˢ S) x).1) := by sorry

end ContentStyle
