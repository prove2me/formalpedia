/-!
# B-line IL, the `J` kernel (B4), part 5: the forward loop

The forward table `flatT fs = ⋃_r (|cs_r| :: cs_r)` lies on `dTJ`; row `r` reads its count,
runs the dot loop on the accumulator `A = fA P fs v r` and pushes `v_r - dotF P cs_r (fA r)`
(`fA_succ`). After `m = |fs|` rows (`m` on `HM`), `A = fA P fs v m` and the table has moved
(reversed) onto `TT` (`fwdP_spec`). Cost `(∑_r (|cs_r| + 3) + 1) · uC`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

theorem flatT_drop {l : List (List ℤ)} {r : ℕ} (h : r < l.length) :
    flatT (l.drop r) = (l[r].length : ℤ) :: (l[r] ++ flatT (l.drop (r + 1))) := by
  simp only [flatT]; rw [List.drop_eq_getElem_cons h, List.flatMap_cons]; rfl

theorem flatT_take {l : List (List ℤ)} {r : ℕ} (h : r < l.length) :
    (flatT (l.take (r + 1))).reverse = l[r].reverse ++ (l[r].length : ℤ) :: (flatT (l.take r)).reverse := by
  have e : l.take (r + 1) = l.take r ++ [l[r]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem h]; rfl
  rw [e]
  simp only [flatT, List.flatMap_append, List.flatMap_cons, List.flatMap_nil, List.append_nil,
    List.reverse_append, rowT, List.reverse_cons]
  simp [List.append_assoc]

end J6Seg.JK

end

