theorem GlobalTheory.TateMatrices.ev_expand {O : LAlg R₀} {g : ℕ} (gb : Module.Basis (Fin g) R₀ B.gg)
    (h : B.gg →ₗ[R₀] (O : Type)) (b : B.gg ⊗[R₀] (O : Type)) :
    B.ev h b = ∑ a, (Module.Basis.baseChange (O : Type) gb).repr
      (TensorProduct.comm R₀ B.gg (O : Type) b) a * h (gb a) := by sorry
