/-- One-sided tail bound for the mean of the first `n` observations (sign `σ = ±1`). -/
lemma tail {K C : ℕ} [NeZero K] {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (R : ℕ → Ω → Fin K → Fin C → ℝ)
    (hR : IsStochRewards P R) (G : Fin K → Fin C → Fin C → Prop)
    (ctx : ℕ → Fin C) (T : ℕ) (hT : 2 ≤ T) (I : ℕ → Ω → Fin K)
    (hI : IsUCB1CLProcess R T G ctx I) (i : Fin K) (c : Fin C) (n : ℕ) (hn : 1 ≤ n)
    (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) :
    P {ω | n ≤ obsCount G ctx (fun s => I s ω) T i c ∧
        Real.sqrt (2 * Real.log T / n)
          ≤ σ * (firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n - mu P R i c)}
      ≤ ENNReal.ofReal (Real.exp (-4 * Real.log T)) := by
  classical
  set L := Real.log T with hLdef
  have hL : 0 ≤ L := Real.log_natCast_nonneg T
  set μ := mu P R i c with hμ
  set ε := Real.sqrt (2 * L / n) with hε
  have hnR : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hε2 : ε ^ 2 = 2 * L / n := Real.sq_sqrt (by positivity)
  have hε0 : 0 ≤ ε := Real.sqrt_nonneg _
  set l := 4 * ε with hl
  set β := l ^ 2 / 8 with hβ
  have hσ2 : σ * σ = 1 := by rcases hσ with h | h <;> rw [h] <;> norm_num
  have hσabs : |σ| = 1 := by rcases hσ with h | h <;> rw [h] <;> norm_num
  -- the clamped reward
  let cl : (Fin K → Fin C → ℝ) → ℝ := fun v => max 0 (min (v i c) 1)
  have hclm : Measurable cl :=
    measurable_const.max (((measurable_pi_apply c).comp (measurable_pi_apply i)).min
      measurable_const)
  have hcl : ∀ t ω, cl (R t ω) = R t ω i c := by
    intro t ω
    have h := hR.mem_Icc t ω i c
    simp only [cl]
    rw [min_eq_left h.2, max_eq_right h.1]
  have hcl01 : ∀ v, cl v ∈ Set.Icc (0 : ℝ) 1 := by
    intro v
    simp only [cl]
    exact ⟨le_max_left _ _, max_le zero_le_one (min_le_right _ _)⟩
  let ψ : (Fin K → Fin C → ℝ) → ℝ := fun v => l * (σ * (cl v - μ))
  have hψm : Measurable ψ :=
    measurable_const.mul (measurable_const.mul (hclm.sub_const μ))
  have hψB : ∀ v, |ψ v| ≤ |l| * (1 + |μ|) := by
    intro v
    show |l * (σ * (cl v - μ))| ≤ _
    rw [abs_mul l, abs_mul σ, hσabs, one_mul]
    apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
    have := hcl01 v
    calc |cl v - μ| ≤ |cl v| + |μ| := abs_sub _ _
      _ ≤ 1 + |μ| := by rw [abs_of_nonneg this.1]; linarith [this.2]
  have hmeas := hR.measurable
  have hXm : ∀ k, Measurable (fun ω => R k ω i c) := fun k =>
    (measurable_pi_apply c).comp ((measurable_pi_apply i).comp (hmeas k))
  have hψ : ∀ k, ∫ ω, Real.exp (ψ (R k ω) - β) ∂P ≤ 1 := by
    intro k
    have hEX : ∫ ω, R k ω i c ∂P = μ := (hR.identDistrib k i c).integral_eq
    let Y : Ω → ℝ := fun ω => σ * R k ω i c
    have hYm : Measurable Y := measurable_const.mul (hXm k)
    have hEY : ∫ ω, Y ω ∂P = σ * μ := by
      simp only [Y]; rw [integral_const_mul, hEX]
    have hb : ∀ ω, Y ω ∈ Set.Icc (if σ = 1 then (0 : ℝ) else -1)
        ((if σ = 1 then (0 : ℝ) else -1) + 1) := by
      intro ω
      have h := hR.mem_Icc k ω i c
      rcases hσ with hs | hs
      · rw [if_pos hs]
        simp only [Y, hs]
        exact ⟨by linarith [h.1], by linarith [h.2]⟩
      · rw [if_neg (by rw [hs]; norm_num)]
        simp only [Y, hs]
        exact ⟨by linarith [h.2], by linarith [h.1]⟩
    have := hoeffding_mgf P Y hYm _ hb l
    rw [hEY] at this
    calc ∫ ω, Real.exp (ψ (R k ω) - β) ∂P
        = ∫ ω, Real.exp (l * (Y ω - σ * μ) - l ^ 2 / 8) ∂P := by
          congr 1; funext ω
          simp only [ψ, Y, β, hcl]
          ring_nf
      _ ≤ 1 := this
  -- the selector
  let a : ℕ → Ω → ℝ := fun s ω => sel G ctx i c n s (fun j => I j ω)
  have ha01 : ∀ k ω, a k ω = 0 ∨ a k ω = 1 := by
    intro k ω
    simp only [a, sel]
    split_ifs <;> simp
  have ham : ∀ k, Measurable[past R k] (a k) := by
    intro k
    exact measurable_past_of_dep R I hI.adapted k (sel G ctx i c n k)
      (fun J J' h => sel_dep G ctx i c n k J J' h)
  have hamA : ∀ k, Measurable (a k) := fun k => (ham k).mono (past_le R hmeas k) le_rfl
  have hsup := exp_sum_le_one P R hmeas hR.indep ψ hψm _ hψB β hψ a ha01 ham T
  have hint := exp_sum_integrable P R hmeas ψ hψm _ hψB β a ha01 hamA T
  set W : Ω → ℝ := fun ω => ∑ s ∈ Finset.range T, a s ω * (ψ (R s ω) - β) with hW
  -- on the event, `W ≥ 4 L`
  have hsub : {ω | n ≤ obsCount G ctx (fun s => I s ω) T i c ∧
        ε ≤ σ * (firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n - μ)}
      ⊆ {ω | Real.exp (4 * L) ≤ Real.exp (W ω)} := by
    intro ω ⟨h1, h2⟩
    simp only [Set.mem_setOf_eq]
    apply Real.exp_le_exp.2
    obtain ⟨hs1, hs2⟩ := sel_sums G ctx (fun s => I s ω) (fun s => R s ω) i c n T hn
      (by omega) h1
    set xb := firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n
    have hWeq : W ω = (n : ℝ) * (l * (σ * (xb - μ)) - β) := by
      simp only [hW, ψ, hcl]
      have : ∀ s ∈ Finset.range T, a s ω * (l * (σ * (R s ω i c - μ)) - β)
          = (l * σ) * (a s ω * R s ω i c) - (l * σ * μ + β) * a s ω := by
        intro s _; ring
      rw [Finset.sum_congr rfl this, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
      simp only [a]
      rw [hs1, hs2]
      ring
    rw [hWeq]
    have hl0 : 0 ≤ l := by positivity
    have : l * ε ≤ l * (σ * (xb - μ)) := mul_le_mul_of_nonneg_left h2 hl0
    have hkey : (n : ℝ) * (l * ε - β) = 4 * L := by
      simp only [hl, hβ]
      have : (n : ℝ) * (4 * ε * ε - (4 * ε) ^ 2 / 8) = 2 * n * ε ^ 2 := by ring
      rw [this, hε2]; field_simp; ring
    nlinarith
  -- Markov's inequality
  have hmark := mul_meas_ge_le_integral_of_nonneg (μ := P)
    (ae_of_all _ (fun ω => (Real.exp_pos (W ω)).le)) hint (Real.exp (4 * L))
  have hreal : P.real {ω | Real.exp (4 * L) ≤ Real.exp (W ω)} ≤ Real.exp (-4 * L) := by
    have h1 : Real.exp (4 * L) * P.real {ω | Real.exp (4 * L) ≤ Real.exp (W ω)} ≤ 1 :=
      hmark.trans hsup
    have hpos := Real.exp_pos (4 * L)
    rw [show -4 * L = -(4 * L) by ring, Real.exp_neg]
    rw [inv_eq_one_div, le_div_iff₀ hpos]
    linarith
  calc P {ω | n ≤ obsCount G ctx (fun s => I s ω) T i c ∧
        ε ≤ σ * (firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n - μ)}
      ≤ P {ω | Real.exp (4 * L) ≤ Real.exp (W ω)} := measure_mono hsub
    _ = ENNReal.ofReal (P.real {ω | Real.exp (4 * L) ≤ Real.exp (W ω)}) :=
        (ofReal_measureReal (measure_ne_top _ _)).symm
    _ ≤ ENNReal.ofReal (Real.exp (-4 * L)) := ENNReal.ofReal_le_ofReal hreal

end UCB1CLHoefAux

open CrossLearnCB.UCB1CL in
theorem solution {K C : ℕ} [NeZero K] [NeZero C] {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (R : ℕ → Ω → Fin K → Fin C → ℝ)
    (hR : IsStochRewards P R) (G : Fin K → Fin C → Fin C → Prop) (hG : HasSelfLoops G)
    (ctx : ℕ → Fin C) (T : ℕ) (hT : 2 ≤ T) (I : ℕ → Ω → Fin K)
    (hI : IsUCB1CLProcess R T G ctx I) (i : Fin K) (c : Fin C) (n : ℕ) (hn : 1 ≤ n) :
    P {ω | n ≤ obsCount G ctx (fun s => I s ω) T i c ∧
        firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n
          ≤ mu P R i c - Real.sqrt (2 * Real.log T / n)}
        ≤ ENNReal.ofReal (Real.exp (-4 * Real.log T)) ∧
    P {ω | n ≤ obsCount G ctx (fun s => I s ω) T i c ∧
        mu P R i c + Real.sqrt (2 * Real.log T / n)
          ≤ firstNMean G ctx (fun s => I s ω) (fun s => R s ω) i c n}
        ≤ ENNReal.ofReal (Real.exp (-4 * Real.log T)) := by
  constructor
  · refine le_trans (measure_mono ?_)
      (UCB1CLHoefAux.tail P R hR G ctx T hT I hI i c n hn (-1) (Or.inr rfl))
    intro ω ⟨h1, h2⟩
    exact ⟨h1, by linarith⟩
  · refine le_trans (measure_mono ?_)
      (UCB1CLHoefAux.tail P R hR G ctx T hT I hI i c n hn 1 (Or.inl rfl))
    intro ω ⟨h1, h2⟩
    exact ⟨h1, by linarith⟩
