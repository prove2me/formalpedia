open GlobalTheory.AnArc
variable {O : Type} [CommRing O] [StarRing O] (A : AnArc O)
variable {A} {T₀ : ℝ} (hT : A.IsConvLine T₀) {j : ℕ} {α : A.X} {th : (Fin A.gB → ℂ) → ℂ}
include hT

theorem GlobalTheory.AnArc.locally_normal_right (hj : j ≠ 0) (h : th ∈ A.Theta j α) {w : ℂ} (hw : T₀ < w.im) (v : A.V) :
    ∃ t ∈ 𝓝 v, ∃ u : A.X → ℝ, Summable u ∧ ∀ μ, ∀ v' ∈ t,
      ‖A.term j α th μ v' * eTwoPi (w * A.exponent j α μ)‖ ≤ u μ := by sorry
