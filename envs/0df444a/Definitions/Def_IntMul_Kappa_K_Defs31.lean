-- Source module: Solutions.KFMSet18c
/-!
# KFM Set18c: the teardown of Proposition 18, and `Setup18Need`

* `tdRS`: pop the flags on `gLG` (a counted loop of `D` pops), then pop the thirteen scalar
  registers (`popAll`). **`spTd`**: `encK s (o0 v ++ regs18) ⟶ encK s (update f 0 v)`.
* **`setup18Need : KFV.Setup18Need`** with `setup = setupRS.code`, `teardown = tdRS.code`,
  `Cs = 10^11`: both register programs cost `≤ 100 · D · U B` with `A = 2^(X+4)`,
  `B = 4(X+4)+1`, `X = D + ℓ + K + zsz p + 2`, hence `≤ 10^11 X^4`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2000000

namespace NLogN.KFV.S18M

open IntMul KIL RS Function Synth

/-- Pop each register of a list once. -/
def popAll : List (Fin HS) → RS
  | [] => .skip
  | i :: L => .seq (.pop i) (popAll L)

/-- The scalar registers of the frame. -/
def scal18 : List (Fin HS) := [NLogN.KFV.gD, gLl, gKk, gBb, gQq, gNL, gLst, gNn, gH, gMk, gPp, gWw, gZz]

/-- **The teardown program.** -/
def tdRS : RS := .seq (.rep cS18 (.reg NLogN.KFV.gD) (.pop gLG)) (popAll scal18)

section PopAll

variable (s : IState HS) {A B : ℕ} (hA : 2 ≤ A) (hAB : A ^ 4 < 2 ^ B)
include hA hAB

end PopAll

section Td

variable (s : IState HS) {A B : ℕ} (hA : 2 ≤ A) (hAB : A ^ 4 < 2 ^ B)
  (p ℓ K : ℕ) (ts : List ℕ) (f : Fin HS → List ℤ)
  (hf : ∀ j, j ≠ 0 → j ≠ dS18 → f j = [])
  (hℓ : 2 ≤ ℓ) (hK : 1 ≤ K)
  (hts : ∀ t ∈ ts, t = 2 ^ ℓ ∨ 2 * t = 2 ^ ℓ)
  (hpA : p + 2 ≤ A) (hℓA : 2 ^ ℓ ≤ A) (hKA : K ≤ A) (hDA : 2 ^ ts.length ≤ A)
  (hnA : n18 ℓ K ts + ℓ + 8 ≤ A)
include hA hAB hf hℓ hK hts hpA hℓA hKA hDA hnA

end Td

/-! ## `Setup18Need` -/

end NLogN.KFV.S18M

