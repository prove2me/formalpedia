theorem sharp_moment_bound_e (p : CardinalData) (ell : ℕ) {s : ℝ} (hs : 0 ≤ s) :
    |K p ell s| ≤
      (|p.c₀|+|p.d₀|+‖p.x‖)*(∑ j : Fin 6, densityCap j*pieceL j s*(Real.pi*zCap ⟨j.val,by omega⟩)^ell)
      +|p.C| *(∑ j : Fin 7, atomL j s*(Real.pi*zCap j)^ell) := by
  sorry

end SharpPlanar

