theorem solution (q : ℂ) (_hq : ‖q‖ < 1) : rrJInf 0 q = 1 := by
  simp only [rrJInf]
  have : (fun n => rrJTerm 0 q n) = (fun n => if n = 0 then (1 : ℂ) else 0) := by
    ext n; cases n with
    | zero => simp [rrJTerm, qPochhammer]
    | succ n => simp [rrJTerm]
  rw [this, tsum_ite_eq]
