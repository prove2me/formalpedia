variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def clientGradient (A : Run P ν S K T ηl ηg init) (r k : ℕ) (i : Fin N)
    (ω : Ω) : Space d := gradient (P.f i) (A.y r k i ω)

def clientNoise (A : Run P ν S K T ηl ηg init) (r k : ℕ) (i : Fin N)
    (ω : Ω) : Space d := A.g r k i ω - clientGradient A r k i ω

theorem Problem.norm_gradient_le (P : Problem d N) (i : Fin N) (x : Space d) :
    ‖gradient (P.f i) x‖ ≤ P.β * ‖x‖ + ‖gradient (P.f i) 0‖ := by
  calc
    ‖gradient (P.f i) x‖ ≤
        ‖gradient (P.f i) x - gradient (P.f i) 0‖ + ‖gradient (P.f i) 0‖ :=
      norm_le_norm_sub_add _ _
    _ ≤ P.β * ‖x‖ + ‖gradient (P.f i) 0‖ := by
      simpa using add_le_add_right (P.smooth i x 0) ‖gradient (P.f i) 0‖

theorem Problem.norm_f_le (P : Problem d N) (i : Fin N) (x : Space d) :
    ‖P.f i x‖ ≤ ‖P.f i 0‖ + ‖gradient (P.f i) 0‖ * ‖x‖ + P.β * ‖x‖ ^ 2 := by
  have hb : ∀ y ∈ Metric.closedBall (0 : Space d) ‖x‖,
      ‖InnerProductSpace.toDual ℝ (Space d) (gradient (P.f i) y)‖ ≤
        P.β * ‖x‖ + ‖gradient (P.f i) 0‖ := by
    intro y hy
    simp only [Metric.mem_closedBall, dist_zero_right] at hy
    simpa using (P.norm_gradient_le i y).trans
      (add_le_add (mul_le_mul_of_nonneg_left hy P.smoothness_pos.le) le_rfl)
  have hmv : ‖P.f i x - P.f i 0‖ ≤
      (P.β * ‖x‖ + ‖gradient (P.f i) 0‖) * ‖x - 0‖ :=
    (convex_closedBall (0 : Space d) ‖x‖).norm_image_sub_le_of_norm_hasFDerivWithin_le
      (fun y _ ↦ (P.hasGradient i y).hasFDerivAt.hasFDerivWithinAt) hb
      (by simp) (by simp)
  have ht := norm_le_norm_sub_add (P.f i x) (P.f i 0)
  simp only [sub_zero] at hmv
  nlinarith

omit [StandardBorelSpace Ω] in
theorem Problem.f_integrable_comp (P : Problem d N) (i : Fin N) {X : Ω → Space d}
    (hX : MemLp X 2 ν) : Integrable (fun ω ↦ P.f i (X ω)) ν := by
