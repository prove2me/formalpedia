variable {K : Type} [Field K] [NumberField K] [StarRing K]

theorem Formalism.DivisionValues.StepBAux.gram_change {d m : ℕ} (X : InfinitePlace K → Matrix (Fin d) (Fin d) ℂ)
    (v : InfinitePlace K) (e : Fin m → Fin d → K) (γ : Matrix (Fin m) (Fin m) K) :
    (gram X v (fun i => ∑ k, γ k i • e k)).det =
      star (v.embedding γ.det) * v.embedding γ.det * (gram X v e).det := by sorry
