        Nat.card (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) d) =
          (classSetDegeneracyData R₁ n₁).w
            (εE (Quotient.mk (MulAction.orbitRel (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) d)))) := by sorry
