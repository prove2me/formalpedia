      rw [← TypeDensity.monicPolyO_map_fraction, Polynomial.map_map, Polynomial.map_map]
      congr 1
      exact RingHom.ext hι
    have hdvd : B.map (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ))) ∣
        ((TypeDensity.monicPolyO a).map (algebraMap O (AdjoinRoot Φ))).map
          (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ))) :=
      Polynomial.map_dvd _ (by rw [AdjoinRoot.algebraMap_eq]; exact hBdvd)
