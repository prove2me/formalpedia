-- title:
--   Coefficient base-change homomorphism of projective Weierstrass models
-- statement:
--   Let $T$ and $T'$ be commutative rings (in a fixed universe), let $W$ be a projective Weierstrass cubic over $T$ (a `WeierstrassCurve.Projective T`), and let $f : T \to T'$ be a ring homomorphism. For a projective Weierstrass cubic $V$ over a ring $R$, write $\mathrm{ProjModelRingCR}\,V$ for the quotient of $R[X_0,X_1,X_2] =$ `MvPolynomial (Fin 3) R` by the ideal generated by the homogeneous Weierstrass polynomial $V.\mathrm{polynomial}$, and `projModelGradingCR V` for the induced grading, whose degree-$i$ piece is the image of the $R$-submodule of degree-$i$ homogeneous polynomials under the quotient map. The assertion is that there exists a graded ring homomorphism $\varphi :$ `projModelGradingCR W` $\to$ `projModelGradingCR (W.map f)` (a ring homomorphism of the underlying quotient rings carrying each graded piece into the corresponding one) such that, first, the irrelevant homogeneous ideal of `projModelGradingCR (W.map f)` is contained in the image under $\varphi$ of the irrelevant homogeneous ideal of `projModelGradingCR W`, and second, `IsCoefficientHom W f φ` holds, i.e. $\varphi$ sends the class of a constant $C(a)$, $a \in T$, to the class of $C(f(a))$, and the class of $X_i$ to the class of $X_i$ for each $i \in \mathrm{Fin}\,3$.
--
--   This is the base-change (coefficient) morphism between the homogeneous coordinate rings of a projective Weierstrass model and of its image under a ring map, packaged together with the surjectivity-type condition on irrelevant ideals required to induce a morphism of the associated $\mathrm{Proj}$ schemes. It is used as an input to the representability statements for the full-level and $\Gamma_1$-type moduli problems on Weierstrass data.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WeierstrassProjModel_exists_isCoefficientHom.lean

import Mathlib
import Definitions.Def_WeierstrassCurve_ProjModel
import Definitions.Def_WeierstrassCurve_DrinfeldBasisGlobal
import Definitions.Def_WeierstrassCurve_DrinfeldTransportPin

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open AlgebraicGeometry CategoryTheory WeierstrassProjModel WeierstrassCurve.DrinfeldGlobal

attribute [local instance] MvPolynomial.gradedAlgebra

theorem WeierstrassProjModel.exists_isCoefficientHom
    {T T' : Type u} [CommRing T] [CommRing T'] (W : WeierstrassCurve.Projective T) (f : T →+* T') :
    ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map f))
      (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map f)) ≤
        (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
      IsCoefficientHom W f φ := by sorry
