theorem Light.Filter2.params_spec {P : Program} {d : ℕ} {pLog pSqrt pPow pDiv : ℕ}
    (HP : Light.Filter2.ParamProcs P pLog pSqrt pPow pDiv) {x : AEInst} {fr : ℕ} {μ : ℕ → ℤ}
    (hn : 1 ≤ x.n) (hU : 1 ≤ x.U) (hw : (lim.space : ℤ) ≤ lim.word)
    (hsp : Light.Filter2.aTOP x.n fr ≤ lim.space) (hword : (Light.Filter2.filterWord x.n x.U : ℤ) ≤ lim.word)
    (hdep : d < lim.depth) :
    Ends lim P d (Light.Filter2.paramsStmt pLog pSqrt pPow pDiv)
      ⟨Light.frame [x.n, x.U, x.ab, x.bc, x.ac, x.out, fr], μ⟩ (Light.Filter2.tParams x.n x.U)
      fun σ' => σ' = ⟨Light.frame (Light.Filter2.topFrame x fr), μ⟩ := by sorry
