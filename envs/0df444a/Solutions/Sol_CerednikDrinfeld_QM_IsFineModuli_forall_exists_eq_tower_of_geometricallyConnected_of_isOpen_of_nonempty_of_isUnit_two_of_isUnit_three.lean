  haveI : Surjective pℓ := ⟨hpsurj⟩
  obtain ⟨x, hx⟩ := AlgebraicGeometry.Scheme.Hom.exists_comp_eq_of_isIntegralHom_of_surjective pℓ k y.1
  let yM : (Scheme.nilpPoints fMℓ).obj k := ⟨x, by rw [← hpℓg, ← Category.assoc, hx]; exact y.2⟩
  obtain ⟨P, g', hg'⟩ := partA k hk ψ yM
