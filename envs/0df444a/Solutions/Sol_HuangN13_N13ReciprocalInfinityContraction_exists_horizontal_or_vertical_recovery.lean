      N13IntegralInfinityReduction.integralBaseClass p := by
  let f : R₂[X] →+* InfinityCurve :=
    (aeval N13IntegralInfinityChart.tClass).toRingHom
  let g : R₂[X] →+* InfinityCurve :=
