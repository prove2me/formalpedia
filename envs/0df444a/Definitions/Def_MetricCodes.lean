    reverseInterlacingHarmonicBranch (n := n) low mu hlow p
  let target : HarmonicYoungSpace (n := n + 1)
      (raiseWeight low row) :=
    reverseInterlacingHarmonicBranch (n := n)
      (raiseWeight low row) mu hhigh p
