theorem sol_u173 (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu173.lin : ℝ) ≤ (S : ℝ) * logProd gu173.lo) :
    (gu173.lfin : ℝ) ≤ (S : ℝ) * logProd gu173.top ∧
      (∀ x : ℝ, (gu173.lo : ℝ) < x → x ≤ (gu173.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) :=
  grp_solution gu173 check_u173 wf_u173 hγ hstate



theorem child39_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu170.lin : ℝ) ≤ (S : ℝ) * logProd gu170.lo) :
    (gu173.lfin : ℝ) ≤ (S : ℝ) * logProd gu173.top ∧
      (∀ x : ℝ, (gu170.lo : ℝ) < x → x ≤ (gu173.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u170 hγ hstate
  have s1 := sol_u171 hγ (by simpa [gu170, gu171] using s0.1)
  have s2 := sol_u172 hγ (by simpa [gu171, gu172] using s1.1)
  have s3 := sol_u173 hγ (by simpa [gu172, gu173] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu170.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu171.lo : ℝ) < x := by
        have hb : (gu170.top : ℝ) = (gu171.lo : ℝ) := by simp [gu170, gu171]
        linarith
    by_cases h1 : x ≤ (gu171.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu172.lo : ℝ) < x := by
          have hb : (gu171.top : ℝ) = (gu172.lo : ℝ) := by simp [gu171, gu172]
          linarith
      by_cases h2 : x ≤ (gu172.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu173.lo : ℝ) < x := by
            have hb : (gu172.top : ℝ) = (gu173.lo : ℝ) := by simp [gu172, gu173]
            linarith
        exact s3.2 x hx3 htop

theorem solution (hγ : Real.eulerMascheroniConstant < (RosserLower.gammaUpS : ℝ) / (RosserLower.S : ℝ))
    (hstate : (3488916032968464 : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd 96779954) :
    (3490229237583226 : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd 99147537 ∧
      (∀ x : ℝ, (96779954 : ℝ) < x → x ≤ (99147537 : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < RosserProductCertificate.eulerProduct ⌊x⌋₊) := by
  have hs : (gu170.lin : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd gu170.lo := by
    simpa only [gu170, Nat.cast_ofNat] using hstate
  simpa only [gu170, gu173, Nat.cast_ofNat] using child39_solution hγ hs
