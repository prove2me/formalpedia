      ∀ j, j ∉ stTg → ((push i e).run σ).G j = s0.G j := by
  obtain ⟨c1, c2, c3, c4, c5⟩ := hF e he
  obtain ⟨g1, g2, g3, g4⟩ := good_congr hA hσ e he
  have hi5 : i.val < 56 := by
    simp only [stTg, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  refine ⟨⟨hi5, c1, g2.2 c3⟩, ?_, ?_⟩
  · have := pushCost_le_lin e s0 B c2 c4
    simp only [RS.cost, g1, g3]
    refine le_trans this ?_
    exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by omega))
  · intro j hj
    have : j ≠ i := fun h => hj (h ▸ hi)
    simp [RS.run_push_G, this, hσ j hj]

