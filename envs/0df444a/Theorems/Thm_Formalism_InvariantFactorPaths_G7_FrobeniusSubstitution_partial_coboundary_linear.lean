variable {K : Type} [Field K]

theorem Formalism.InvariantFactorPaths.G7.FrobeniusSubstitution.partial_coboundary_linear {F : MvPowerSeries (Fin 2) K} (hF0 : MvPowerSeries.constantCoeff F = 0) (k q : K)
