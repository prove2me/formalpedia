noncomputable def sectionFamily {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) : M.sections :=
  PresheafOfModules.sectionsMk (M := M.val)
    (fun U => M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op s)
    (fun U V f => by
      change M.presheaf.map f (M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op s) =
        M.presheaf.map (homOfLE (le_top : V.unop ≤ ⊤)).op s
      rw [← CategoryTheory.ConcreteCategory.comp_apply, ← Functor.map_comp]
      congr 1)

theorem sectionFamily_val_top {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) :
    (sectionFamily M s).val (op ⊤) = s := by
  change M.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op s = s
  have : (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op = 𝟙 (op ⊤) := Subsingleton.elim _ _
  rw [this, CategoryTheory.Functor.map_id]
  rfl

theorem exists_hom_unit_ne_zero {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) (hs : s ≠ 0) :
    ∃ φ : (SheafOfModules.unit Y.ringCatSheaf : Y.Modules) ⟶ M, φ ≠ 0 := by
  refine ⟨M.unitHomEquiv.symm (sectionFamily M s), fun hφ => hs ?_⟩
  have h1 : sectionFamily M s = M.unitHomEquiv 0 := by
    rw [← hφ, Equiv.apply_symm_apply]
  have h2 := congrArg (fun t : M.sections => t.val (op ⊤)) h1
  simp only [sectionFamily_val_top, SheafOfModules.unitHomEquiv_apply_coe] at h2
  rw [h2]
  rfl

