open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.Kerr
open ExactVacuumAtlas.Kerr.In
theorem solution (a θ r : ℝ) (h : r ^ 2 + a ^ 2 * cos θ ^ 2 ≠ 0) :
    HasDerivAt (fun u => Ui a u θ) (-2 * r * Ui a r θ ^ 2) r := by
  have h1 : HasDerivAt (fun u : ℝ => u ^ 2 + a ^ 2 * cos θ ^ 2) (2 * r) r := by
    simpa using (hasDerivAt_pow 2 r).add_const (a ^ 2 * cos θ ^ 2)
  have h2 := h1.inv h
  unfold Ui
  refine h2.congr_deriv ?_
  rw [div_eq_mul_inv, ← inv_pow]; try ring
