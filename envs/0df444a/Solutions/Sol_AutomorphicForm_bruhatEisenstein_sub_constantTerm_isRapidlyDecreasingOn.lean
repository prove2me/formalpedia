      1 ≤ t → ∀ {H : InfiniteAdeleRing F → ℂ},
        H = (fun u => φ (unipotentGL2 w₀ * diagGL2 t₁ t₂ * kpt) + bigCellArch φ ι (unipotentGL2 w₀ * diagGL2 t₁ t₂ * kpt) u) →
        IsKerPeriodic (adelicTorusMap F 𝔫 h𝔫) H → Continuous H → ∀ m : LevelIndex F 𝔫 h𝔫 → ℤ,
