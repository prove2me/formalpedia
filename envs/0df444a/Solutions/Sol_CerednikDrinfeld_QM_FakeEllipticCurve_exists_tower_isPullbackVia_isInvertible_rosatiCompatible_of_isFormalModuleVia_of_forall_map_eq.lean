theorem pow_ne_top (O' : Type) [CommRing O'] [IsLocalRing O'] (n : ℕ) : maximalIdeal O' ^ (n + 1) ≠ ⊤ := fun h =>
  (maximalIdeal.isMaximal O').ne_top (top_le_iff.mp (h ▸ Ideal.pow_le_self (Nat.succ_ne_zero n)))

scoped instance nontrivial_quot (O' : Type) [CommRing O'] [IsLocalRing O'] (n : ℕ) :
    Nontrivial (O' ⧸ maximalIdeal O' ^ (n + 1)) :=
  ⟨⟨0, 1, fun h => pow_ne_top O' n (Ideal.Quotient.zero_eq_one_iff.mp h)⟩⟩

scoped instance isLocalRing_quot (O' : Type) [CommRing O'] [IsLocalRing O'] (n : ℕ) :
    IsLocalRing (O' ⧸ maximalIdeal O' ^ (n + 1)) :=
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

scoped instance isArtinianRing_quot (O' : Type) [CommRing O'] [IsLocalRing O'] [IsNoetherianRing O'] (n : ℕ) :
    IsArtinianRing (O' ⧸ maximalIdeal O' ^ (n + 1)) := by
  rw [isArtinianRing_iff_isNilpotent_maximalIdeal,
    ← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk (maximalIdeal O' ^ (n + 1)))
      Ideal.Quotient.mk_surjective]
  exact ⟨n + 1, by rw [← Ideal.map_pow, Ideal.map_quotient_self, Ideal.zero_eq_bot]⟩

scoped instance isAlgClosed_residueField_quot (O' : Type) [CommRing O'] [IsLocalRing O'] [IsAlgClosed (ResidueField O')]
    (n : ℕ) : IsAlgClosed (ResidueField (O' ⧸ maximalIdeal O' ^ (n + 1))) := by
  haveI := IsLocalHom.of_surjective (Ideal.Quotient.mk (maximalIdeal O' ^ (n + 1))) Ideal.Quotient.mk_surjective
  let φ := IsLocalRing.ResidueField.map (Ideal.Quotient.mk (maximalIdeal O' ^ (n + 1)))
  have hφs : Function.Surjective φ := by
    intro y
    obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨IsLocalRing.residue O' x, rfl⟩
  exact IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective φ ⟨φ.injective, hφs⟩)

