theorem NLogN.KFW.cPhU_Y {Bn t S0 r Z H x sz : ℕ} (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (hx : x ≤ 2 * H + 16)
    (εE : Ex HS) (hsz : εE.size ≤ sz) :
    cPhU x (Bn * (S0 * r * 2 ^ t)) t Bn Z (S0 * r) (xPh εE Z Z) ≤
