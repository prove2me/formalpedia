      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hbV : IsIntegral ↥V b := hb.map_of_comp_eq φ (RingHom.id F) (by ext; rfl)
  obtain ⟨v, hv⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hbV
