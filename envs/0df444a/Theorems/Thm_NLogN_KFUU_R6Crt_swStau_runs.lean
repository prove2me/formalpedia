open IntMul NLogN.KIL NLogN.KFB NLogN.KFC NLogN.KFT NLogN.KFU AModel AModelL12 NLogN.KFUU
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

theorem NLogN.KFUU.R6Crt.swStau_runs {eSw : Fin P} {dS : Fin HS} {K : ℝ} (hK : SwOKτ τ I iprog eSw dS K) (hdS : dS ≠ 0)
    {Dsc : Fin HS} (hD : Dsc = 18 ∨ Dsc = 19) (hDd : Dsc ≠ dS)
    {u w a m c2 Z : ℕ} (hu : 1 ≤ u) (ha : 1 ≤ a) (hm : 1 ≤ m) (hc : 1 ≤ c2) (hZ3 : 3 ≤ Z)
    (zw : zsz (w : ℤ) ≤ Z) (zu : zsz (u : ℤ) ≤ Z) (za : zsz (a : ℤ) ≤ Z) (zm : zsz (m : ℤ) ≤ Z)
    (zc : zsz (c2 : ℤ) ≤ Z) (zU : zsz ((2 ^ u : ℕ) : ℤ) ≤ Z)
    (t : IState HS) (xs : List ℤ) (R : List Item) (h0 : t.G 0 = ints xs ++ R)
    (hlen : xs.length = vol [a, 2 ^ u, m, 2 ^ u, c2] * 2) (hx : Bnd w xs)
    {LW LU LA L2 LM LB : List Item}
    (hW : t.G rW = .int (w : ℤ) :: LW) (hUu : t.G rU = .int (u : ℤ) :: LU)
    (hA : t.G rA = .int (a : ℤ) :: LA) (h2 : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: L2)
    (hM : t.G rM = .int (m : ℤ) :: LM) (hB : t.G rB = .int (c2 : ℤ) :: LB) :
    ∃ c : ℕ, IRuns I iprog (swS eSw dS Dsc) t
      (t.upd 0 (ints (pull [a, 2 ^ u, m, 2 ^ u, c2 * 2] [a, 2 ^ u, m, 2 ^ u, c2 * 2] (swapPos 1 3) 0 xs)
        ++ R)) c ∧
      (c : ℝ) ≤ cSwNτ τ K w u [a, 2 ^ u, m, 2 ^ u, c2] + 30 * cU Z + 3 := by sorry
