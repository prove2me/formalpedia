namespace QEC.Distillation
theorem _root_.solution (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    (axisCircle axis t : SingleQubitMatrix).det = 1 := by
  let z : Complex := AddCircle.toCircle t
  have haxis : (axis.x : Complex) ^ 2 + (axis.y : Complex) ^ 2 +
      (axis.z : Complex) ^ 2 = 1 := by
    exact_mod_cast axis.norm_sq
  have hcircle_real : z.re ^ 2 + z.im ^ 2 = 1 := by
    dsimp [z]
    simpa [Complex.normSq_apply, pow_two] using (AddCircle.toCircle t).normSq_coe
  have hcircle : (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 = 1 := by
    exact_mod_cast hcircle_real
  change (axisCircleMatrix axis z).det = 1
  rw [Matrix.det_fin_two]
  simp [axisCircleMatrix, axisLinearMatrix, axisPauliMatrix]
  calc
    _ = (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 *
        ((axis.x : Complex) ^ 2 + (axis.y : Complex) ^ 2 + (axis.z : Complex) ^ 2) := by
      ring_nf
      rw [Complex.I_sq, Complex.I_pow_four]
      ring
    _ = (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 := by rw [haxis, mul_one]
    _ = 1 := hcircle
end QEC.Distillation
