theorem contDiffOn_amp {V : Pt 4 → ℂ} {u : (Fin 2 → ℝ) → ℂ} (hV : ContDiffOn ℝ ∞ V (domKN p.M p.a p.Q))
    (hm : ∀ y ∈ domKN p.M p.a p.Q, V y = phaseP om mm y * u (toRT y)) : ContDiffOn ℝ ∞ u (Hintz2026.U p) := by
  have hc : ContDiffOn ℝ ∞ (fun z => V (embRT z) / phaseP om mm (embRT z)) (Hintz2026.U p) :=
