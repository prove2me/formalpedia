theorem chunkArith_sol_aux {h Lst n : ℕ} (hK : 0 < K) (hD : 1 ≤ D) (hb : bb ℓ K ≤ h) (hh : h < ℓ - 1)
    (hn : n = Lst + D * qq ℓ K * K) :
    1 ≤ qq ℓ K ∧ qq ℓ K * K ≤ n ∧ qq ℓ K ≤ n ∧ K ≤ n ∧ D ≤ n ∧ bb ℓ K ≤ ℓ ∧ Lst ≤ n ∧
    eIdx ℓ K h + 1 + (h - bb ℓ K) = qq ℓ K * K ∧ eIdx ℓ K h ≤ n ∧
    eIdx ℓ K h / K < qq ℓ K ∧ eIdx ℓ K h / K ≤ n ∧ eIdx ℓ K h / K * D ≤ n ∧
    eIdx ℓ K h / K * D * K ≤ n ∧ Lst + eIdx ℓ K h / K * D * K + 1 ≤ n ∧
    (qq ℓ K - 1 - eIdx ℓ K h / K) * D ≤ n ∧ (qq ℓ K - 1 - eIdx ℓ K h / K) * D * K + 1 ≤ n := by
  have hbq : bb ℓ K + qq ℓ K * K = ℓ - 1 := by
    unfold bb qq; rw [Nat.mul_comm]; exact Nat.mod_add_div _ _
  set q := qq ℓ K
  set b := bb ℓ K
  have hq1 : 1 ≤ q := by
    rcases Nat.eq_zero_or_pos q with h0 | h0
    · rw [h0, Nat.zero_mul] at hbq; omega
    · exact h0
  have hqK : q * K ≤ D * q * K := by
    rw [Nat.mul_assoc D]; exact Nat.le_mul_of_pos_left _ hD
  have hDq : D ≤ D * q * K := by
    have : D * 1 * 1 ≤ D * q * K := Nat.mul_le_mul (Nat.mul_le_mul_left _ hq1) hK
    simpa using this
  have hK1 : K ≤ q * K := Nat.le_mul_of_pos_left _ hq1
  have hqn : q ≤ q * K := Nat.le_mul_of_pos_right _ hK
  have heq : eIdx ℓ K h + 1 + (h - b) = q * K := by
    have : eIdx ℓ K h = q * K - 1 - (h - b) := rfl
    omega
  set e := eIdx ℓ K h
  set j := e / K
  have hjq : j < q := (Nat.div_lt_iff_lt_mul hK).2 (by omega)
  have hje : j ≤ e := Nat.div_le_self e K
  have hqDK : (q - 1) * D * K + D * K = D * q * K := by
    have : q - 1 + 1 = q := by omega
    calc (q - 1) * D * K + D * K = (q - 1 + 1) * D * K := by ring
      _ = D * q * K := by rw [this]; ring
  have hjDK : j * D * K ≤ (q - 1) * D * K :=
    Nat.mul_le_mul (Nat.mul_le_mul (by omega) le_rfl) le_rfl
  have hjD : j * D ≤ j * D * K := Nat.le_mul_of_pos_right _ hK
  have hm2 : (q - 1 - j) * D * K ≤ (q - 1) * D * K :=
    Nat.mul_le_mul (Nat.mul_le_mul (Nat.sub_le _ _) le_rfl) le_rfl
  have hm1 : (q - 1 - j) * D ≤ (q - 1 - j) * D * K := Nat.le_mul_of_pos_right _ hK
  have hDK1 : 1 ≤ D * K := Nat.mul_pos hD hK
  refine ⟨hq1, by omega, by omega, by omega, by omega, by omega, by omega, heq, by omega, hjq,
    by omega, by omega, by omega, by omega, by omega, by omega⟩

