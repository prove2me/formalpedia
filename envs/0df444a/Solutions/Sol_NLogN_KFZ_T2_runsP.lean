section
-- Source module: Solutions.KFZWrap
/-!
# KFZ Wrap: the table and pass procedures on managed states

Every procedure spec of KFMU1/KFMU2/KFZPass restated on states `encK s F` (the list `F j` of
integers on top of each stack `j`, over an arbitrary `s`), so that runs compose by updating `F`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem rsW {p : RS} {s : IState HS} {F F' : Fin HS → List ℤ} {c : ℕ}
    (h : Sp p (encK s F) (encK s F') c) : IRuns I iprog p.code (encK s F) (encK s F') c := by
  obtain ⟨c', hc, hr⟩ := h.irun (I := I) (iprog := iprog)
  exact hr.mono hc

theorem roundW (g w : ℕ) (s : IState HS) (F : Fin HS → List ℤ) (L R0 LR LH LX : List ℤ)
    (h0 : F 0 = L ++ R0) (hR : F pR = (2 ^ g : ℤ) :: LR) (hH : F pX2 = 0 :: LH)
    (hw : ∀ x ∈ L, zsz x ≤ w) (hw0 : zsz (0 : ℤ) ≤ w) (hX : F nX = (L.length : ℤ) :: LX) :
    IRuns I iprog (itemPU roundB) (encK s F)
      (encK s (Function.update F 0 (L.map (fun x => x.tdiv (2 ^ g)) ++ R0)))
      (cItem L.length (3000 * (w + g + 3)) (2 * w + 1) + 2 * cCnt L.length) := by
  refine (roundPU_runs g w 0 (encK s F) L (ints R0 ++ s.G 0) (ints LR ++ s.G pR)
    (ints LH ++ s.G pX2) (by rw [encK_G, h0, ints_append, List.append_assoc]) (by rw [encK_G, hR] <;> rfl) (by rw [encK_G, hH] <;> rfl) hw hw0
    (ints LX ++ s.G nX) (by rw [encK_G, hX] <;> rfl)).mono' ?_ ?_
  · simp only [add_zero]
    ((apply IState.ext' <;> intros <;> simp +decide only [encK_G, encK_ip, encK_out, IState.upd_G, IState.upd_ip, IState.upd_out, Function.update_apply, ints_append] <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide [ints_append])))
  · exact le_refl _

theorem mv2W (X Y CN : Fin HS) (hXY : X ≠ Y) (hXU : X ≠ pU) (hYU : Y ≠ pU) (hX : NC X)
    (hY : NC Y) (hCN : CN ≠ pA) (hCX : CN ≠ X) (hCU : CN ≠ pU) (L : List ℤ) (B : ℕ)
    (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (F : Fin HS → List ℤ) (RX LC : List ℤ)
    (h0 : F X = L ++ RX) (hC : F CN = (L.length : ℤ) :: LC) :
    IRuns I iprog (mv2 X Y CN) (encK s F)
      (encK s (Function.update (Function.update F X RX) Y (L ++ F Y))) (2 * cMvX L.length B) := by
  refine (mv2_runs X Y CN hXY hXU hYU hX hY hCN hCX hCU L B hB (encK s F) (ints RX ++ s.G X)
    (ints LC ++ s.G CN) (by rw [encK_G, h0, ints_append, List.append_assoc]) (by rw [encK_G, hC] <;> rfl)).mono' ?_ ?_
  · ((apply IState.ext' <;> intros <;> simp +decide only [encK_G, encK_ip, encK_out, IState.upd_G, IState.upd_ip, IState.upd_out, Function.update_apply, ints_append] <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide [ints_append])))
  · exact le_refl _

end Gen

end NLogN.KFZ

end

section
-- Source module: Solutions.KFZProc
/-!
# KFZ Proc: the table phases of the chirp procedure

The managed contents during the chirp procedure are described by **`St`**: the five registers
`p, h, d, σ, K`, the chirp-table descriptor `td` (stack `35`), stack `0` (`z`), the output stack
`pW` (`w`), and the four tables `tb, ta, tt, ti` on the stacks `56, 57, 59, 63`; everything
else is as in `F0`.

Each phase pushes its parameters (`pushes l`), runs one table or pass procedure, and pops the
parameters again (`wP`). The lemmas `T1_runs … T7_runs` give the exact final `St`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM

/-! ## The table stacks and the managed contents -/

section St

variable (F0 : Fin HS → List ℤ) (p h d σ K : ℕ) (td z w tb ta tt ti : List ℤ)

theorem St_regs : Regs (St F0 p h d σ K td z w tb ta tt ti) p h d σ K :=
  ⟨by simp +decide [St], by simp +decide [St], by simp +decide [St], by simp +decide [St],
    by simp +decide [St]⟩

@[simp] theorem St_0 : St F0 p h d σ K td z w tb ta tt ti 0 = z := by simp [St]
@[simp] theorem St_pW : St F0 p h d σ K td z w tb ta tt ti pW = w := by simp +decide [St]

@[simp] theorem St_qB : St F0 p h d σ K td z w tb ta tt ti qB = tb := by simp +decide [St]

theorem St_upd_z (z' : List ℤ) : Function.update (St F0 p h d σ K td z w tb ta tt ti) 0 z' =
    St F0 p h d σ K td z' w tb ta tt ti := by
  funext j; by_cases hj : j = 0
  · subst hj; simp [St]
  · simp only [Function.update_of_ne hj, St, hj, if_false]

theorem St_upd_w (w' : List ℤ) : Function.update (St F0 p h d σ K td z w tb ta tt ti) pW w' =
    St F0 p h d σ K td z w' tb ta tt ti := by
  funext j; by_cases hj : j = pW
  · subst hj; simp +decide [St]
  · simp only [Function.update_of_ne hj, St, hj, if_false]

theorem St_upd_tb (tb' : List ℤ) : Function.update (St F0 p h d σ K td z w tb ta tt ti) qB tb' =
    St F0 p h d σ K td z w tb' ta tt ti := by
  funext j; by_cases hj : j = qB
  · subst hj; simp +decide [St]
  · simp only [Function.update_of_ne hj, St, hj, if_false]

end St

/-! ## Phases with pushed parameters -/

theorem wP_runs {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} (l : List (Fin HS × Ex HS))
    (inner : IStmt HS P) {s : IState HS} {F F' : Fin HS → List ℤ} {vs : List (Fin HS × ℤ)}
    {c1 c2 c3 : ℕ} (h1 : Sp (pushes l) (encK s F) (encK s (pushF F vs)) c1)
    (h2 : IRuns I iprog inner (encK s (pushF F vs)) (encK s (pushF F' vs)) c2)
    (h3 : Sp (popsL (l.map Prod.fst)) (encK s (pushF F' vs)) (encK s F') c3) :
    IRuns I iprog (wP l inner) (encK s F) (encK s F') (c1 + (c2 + c3)) :=
  (rsW h1).seq (h2.seq (rsW h3))

/-- A parameter on top of its stack after the pushes. -/
theorem pf_top {F : Fin HS → List ℤ} {vs : List (Fin HS × ℤ)} {i : Fin HS} {v : ℤ}
    (hn : (vs.map Prod.fst).Nodup) (hm : (i, v) ∈ vs) : pushF F vs i = v :: F i :=
  pushF_apply_mem F vs i v hn hm

/-! ## The table phases -/

/-! ## The pointwise products -/

end NLogN.KFZ

