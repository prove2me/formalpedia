theorem wF_le_NF (d s : ℕ) : wF d ≤ NF d s := by
  unfold NF
  calc wF d ≤ 2 * wF d + 1 := by omega
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) :=
        Nat.le_mul_of_pos_left _ (by positivity)
    _ ≤ _ := Nat.le_mul_of_pos_right _ (by positivity)

theorem NF_le {d s t : ℕ} (hd : 1 ≤ d) (hs : s < t) : NF d s ≤ 3654000 * d ^ 7 * t ^ 2 := by
  have hk : kF d ≤ d + 1 := by unfold kF; have := Nat.sqrt_le_self d; omega
  have hl : lamF d ≤ 2 * d ^ 2 := by
    unfold lamF
    calc d * kF d ≤ d * (d + 1) := Nat.mul_le_mul_left _ hk
      _ ≤ 2 * d ^ 2 := by nlinarith
  have hd2 : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd
  have hd4 : 1 ≤ d ^ 4 := Nat.one_le_pow _ _ hd
  have e1 : lamF d + 1 ≤ 3 * d ^ 2 := by omega
  have e2 : (lamF d + 1) * (3 * lamF d + 3) + 1 ≤ 28 * d ^ 4 := by
    calc (lamF d + 1) * (3 * lamF d + 3) + 1 = 3 * ((lamF d + 1) * (lamF d + 1)) + 1 := by ring
      _ ≤ 3 * ((3 * d ^ 2) * (3 * d ^ 2)) + 1 := by gcongr
      _ = 27 * d ^ 4 + 1 := by ring
      _ ≤ 28 * d ^ 4 := by omega
  have e3 : 2 * wF d + 1 ≤ 29 * d := by unfold wF; omega
  have e4 : (s + 1) ^ 2 ≤ t ^ 2 := Nat.pow_le_pow_left (by omega) 2
  unfold NF
  calc 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      ≤ 1500 * (28 * d ^ 4) * (3 * d ^ 2) * (29 * d) * t ^ 2 := by gcongr
    _ = 3654000 * d ^ 7 * t ^ 2 := by ring

theorem parBig_lt {kA kC wA wC k pre post s t p α d T W : ℕ}
    (hk : k ≤ T) (hpre : pre ≤ T) (hpost : post ≤ T) (hs : s ≤ T) (ht : t ≤ T) (hα : α ≤ T)
    (hp : p ≤ T) (hd : d ≤ T) (hTQ : T < 2 ^ segPF p d s)
    (hW : (1 + 2 * kA + wA) * segPF p d s + 2 * kC + wC + 1514 ≤ W) :
    parBig kA kC wA wC k pre post s t p α d < 2 ^ W := by
