/-! ### Gaussian shift identity -/

lemma gauss_shift (v : ℝ≥0) (hv : v ≠ 0) (k : ℝ → ℝ≥0∞) (hk : Measurable k) (c : ℝ) :
    ∫⁻ z, k (z + c) ∂(gaussianReal 0 v)
      = ∫⁻ w, k w * ENNReal.ofReal (Real.exp (c * w / v - c ^ 2 / (2 * v))) ∂(gaussianReal 0 v) := by
  rw [← lintegral_map hk (measurable_add_const c), gaussianReal_map_add_const, zero_add,
    gaussianReal_of_var_ne_zero _ hv, gaussianReal_of_var_ne_zero _ hv,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_gaussianPDF _ _) hk,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_gaussianPDF _ _)
      (show Measurable (fun w => k w * ENNReal.ofReal (Real.exp (c * w / v - c ^ 2 / (2 * v))))
        by fun_prop)]
  refine lintegral_congr fun w => ?_
  simp only [Pi.mul_apply, gaussianPDF, gaussianPDFReal]
  rw [mul_comm (k w) (ENNReal.ofReal (Real.exp _)), ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity)]
  congr 2
  rw [mul_assoc _ (Real.exp _), ← Real.exp_add]
  congr 2
  have : (v : ℝ) ≠ 0 := by exact_mod_cast hv
  field_simp
  ring

/-! ### Independence and iterated integration -/

lemma lintegral_indep {Ω α : Type*} [MeasurableSpace Ω] [MeasurableSpace α] (P : Measure Ω)
    [IsProbabilityMeasure P] (X : Ω → α) (Y : Ω → ℝ) (hX : Measurable X) (hY : Measurable Y)
    (hind : IndepFun X Y P) (G : α × ℝ → ℝ≥0∞) (hG : Measurable G) :
    ∫⁻ ω, G (X ω, Y ω) ∂P = ∫⁻ ω, ∫⁻ y, G (X ω, y) ∂(P.map Y) ∂P := by
  have h1 : ∫⁻ ω, G (X ω, Y ω) ∂P = ∫⁻ p, G p ∂(P.map fun ω => (X ω, Y ω)) :=
    (lintegral_map hG (hX.prodMk hY)).symm
  rw [h1, (indepFun_iff_map_prod_eq_prod_map_map hX.aemeasurable hY.aemeasurable).mp hind,
    lintegral_prod _ hG.aemeasurable]
  exact lintegral_map (hG.lintegral_prod_right') hX


/-! ### The price process and its natural filtration -/

lemma helper_hist {Ω : Type*} [MeasurableSpace Ω] (M : Model) (β : ℝ) {t : ℕ}
    (p e : Fin t → Ω → ℝ) (hp : ∀ i, Measurable (p i)) (he : ∀ i, Measurable (e i)) :
    Measurable (fun ω => fun i : Fin t => (M.DHat + β * (p i ω - M.pHat) + e i ω, p i ω)) :=
  measurable_pi_lambda _ fun i =>
    ((measurable_const.add (measurable_const.mul ((hp i).sub measurable_const))).add
      (he i)).prodMk (hp i)

section Process

variable (M : Model) (π : Policy M.l M.u) {Ω : Type*} [MeasurableSpace Ω] (ε : ℕ → Ω → ℝ)

noncomputable def pp (β : ℝ) (t : ℕ) (ω : Ω) : ℝ := pricePath M π β (fun s => ε s ω) t

noncomputable def hist (β : ℝ) (t : ℕ) (ω : Ω) : Fin t → ℝ × ℝ :=
  fun i => (M.DHat + β * (pp M π ε β i ω - M.pHat) + ε i ω, pp M π ε β i ω)

lemma pp_eq (β : ℝ) (t : ℕ) (ω : Ω) : pp M π ε β t ω = π.rule t (hist M π ε β t ω) := by
  unfold pp hist; rw [pricePath]; rfl

lemma pp_mem (β : ℝ) (t : ℕ) (ω : Ω) : pp M π ε β t ω ∈ Set.Icc M.l M.u := by
  rw [pp_eq]; exact π.rule_mem _ _

/-- the past sigma-algebra generated by `ε 0, …, ε (t-1)` -/
def Fp (t : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ {i : ℕ | i < t}, MeasurableSpace.comap (ε i) inferInstance

lemma Fp_le (hε : ∀ i, Measurable (ε i)) (t : ℕ) : Fp ε t ≤ ‹MeasurableSpace Ω› :=
  iSup₂_le fun i _ => (hε i).comap_le

lemma meas_eps_Fp {i t : ℕ} (h : i < t) : Measurable[Fp ε t] (ε i) :=
  (comap_measurable (ε i)).mono (le_iSup₂ (f := fun i (_ : i ∈ {i : ℕ | i < t}) =>
    MeasurableSpace.comap (ε i) inferInstance) i h) le_rfl

/-- one step of the history recursion -/
noncomputable def step (β : ℝ) (t : ℕ) (h : Fin t → ℝ × ℝ) (z : ℝ) : Fin (t + 1) → ℝ × ℝ :=
  fun i => if hi : (i : ℕ) < t then h ⟨i, hi⟩
    else (M.DHat + β * (π.rule t h - M.pHat) + z, π.rule t h)

lemma measurable_step (β : ℝ) (t : ℕ) :
    Measurable (fun p : (Fin t → ℝ × ℝ) × ℝ => step M π β t p.1 p.2) := by
  refine measurable_pi_lambda _ fun i => ?_
  unfold step
  by_cases hi : (i : ℕ) < t
  · simp only [hi, dite_true]
    exact (measurable_pi_apply _).comp measurable_fst
  · simp only [hi, dite_false]
    have hr : Measurable (fun p : (Fin t → ℝ × ℝ) × ℝ => π.rule t p.1) :=
      (π.measurable_rule t).comp measurable_fst
    exact ((measurable_const.add (measurable_const.mul (hr.sub measurable_const))).add
      measurable_snd).prodMk hr

lemma hist_succ (β : ℝ) (t : ℕ) (ω : Ω) :
    hist M π ε β (t + 1) ω = step M π β t (hist M π ε β t ω) (ε t ω) := by
  funext i
  unfold step
  by_cases hi : (i : ℕ) < t
  · simp only [hi, dite_true]; rfl
  · simp only [hi, dite_false]
    have : (i : ℕ) = t := by omega
    rw [← pp_eq]
    simp only [hist, this]

lemma meas_pp_Fp (hε : ∀ i, Measurable (ε i)) (β : ℝ) :
    ∀ s t, s < t → Measurable[Fp ε t] (pp M π ε β s) := by
  intro s
  induction s using Nat.strong_induction_on with
  | _ s ih =>
    intro t hst
    have : pp M π ε β s = fun ω => π.rule s (hist M π ε β s ω) := funext (pp_eq M π ε β s)
    rw [this]
    exact (π.measurable_rule s).comp (@helper_hist Ω (Fp ε t) M β s
      (fun i ω => pp M π ε β i ω) (fun i ω => ε i ω)
      (fun i => ih i i.isLt t (by omega)) (fun i => meas_eps_Fp ε (by omega)))

lemma meas_hist_Fp (hε : ∀ i, Measurable (ε i)) (β : ℝ) (t : ℕ) :
    Measurable[Fp ε t] (hist M π ε β t) := by
  exact @helper_hist Ω (Fp ε t) M β t
      (fun i ω => pp M π ε β i ω) (fun i ω => ε i ω)
      (fun i => meas_pp_Fp M π ε hε β i t i.isLt) (fun i => meas_eps_Fp ε i.isLt)

lemma meas_pp_Fp' (hε : ∀ i, Measurable (ε i)) (β : ℝ) (s : ℕ) :
    Measurable[Fp ε s] (pp M π ε β s) := by
  have : pp M π ε β s = fun ω => π.rule s (hist M π ε β s ω) := funext (pp_eq M π ε β s)
  rw [this]
  exact (π.measurable_rule s).comp (meas_hist_Fp M π ε hε β s)

lemma indep_past (P : Measure Ω) (σ : ℝ) (hε : GaussianNoise σ P ε) (t : ℕ) :
    Indep (Fp ε t) (MeasurableSpace.comap (ε t) inferInstance) P := by
  have h := indep_iSup_of_disjoint (fun i => (hε.measurable i).comap_le)
    ((iIndepFun_iff_iIndep _ _ _).mp hε.indep) (S := {i : ℕ | i < t}) (T := {t})
    (by rw [Set.disjoint_singleton_right]; simp)
  simpa [Fp] using h

lemma indepFun_past {α : Type*} [MeasurableSpace α] (P : Measure Ω) (σ : ℝ)
    (hε : GaussianNoise σ P ε) (t : ℕ) (X : Ω → α) (hX : Measurable[Fp ε t] X) :
    IndepFun X (ε t) P := by
  rw [IndepFun_iff_Indep]
  exact indep_of_indep_of_le_left (indep_past ε P σ hε t) hX.comap_le

/-- log-likelihood-ratio process -/
noncomputable def S (β β' : ℝ) (v : ℝ≥0) (t : ℕ) (ω : Ω) : ℝ :=
  ∑ s ∈ Finset.range t, ((β' - β) * (pp M π ε β s ω - M.pHat) * ε s ω / v
    - ((β' - β) * (pp M π ε β s ω - M.pHat)) ^ 2 / (2 * v))

lemma helper_lin {Ω : Type*} [MeasurableSpace Ω] (a c : ℝ) (f : Ω → ℝ) (hf : Measurable f) :
    Measurable (fun ω => a * (f ω - c)) :=
  measurable_const.mul (hf.sub measurable_const)

lemma helper_S {Ω : Type*} [MeasurableSpace Ω] (a c v : ℝ) (t : ℕ)
    (p e : ℕ → Ω → ℝ) (hp : ∀ s < t, Measurable (p s)) (he : ∀ s < t, Measurable (e s)) :
    Measurable (fun ω => ∑ s ∈ Finset.range t, (a * (p s ω - c) * e s ω / v
      - (a * (p s ω - c)) ^ 2 / (2 * v))) := by
  refine Finset.measurable_sum _ fun s hs => ?_
  have h1 := hp s (Finset.mem_range.mp hs)
  have h2 := he s (Finset.mem_range.mp hs)
  exact (((measurable_const.mul (h1.sub measurable_const)).mul h2).div_const _).sub
    (((measurable_const.mul (h1.sub measurable_const)).pow_const 2).div_const _)

lemma meas_S_Fp (hε : ∀ i, Measurable (ε i)) (β β' : ℝ) (v : ℝ≥0) (t : ℕ) :
    Measurable[Fp ε t] (S M π ε β β' v t) :=
  @helper_S Ω (Fp ε t) (β' - β) M.pHat v t (fun s ω => pp M π ε β s ω) ε
    (fun s hs => meas_pp_Fp M π ε hε β s t hs) (fun s hs => meas_eps_Fp ε hs)

/-- shift coefficient as a function of the history -/
noncomputable def cf (β β' : ℝ) (t : ℕ) (h : Fin t → ℝ × ℝ) : ℝ :=
  (β' - β) * (π.rule t h - M.pHat)

lemma step_shift (β β' : ℝ) (t : ℕ) (h : Fin t → ℝ × ℝ) (z : ℝ) :
    step M π β' t h z = step M π β t h (z + cf M π β β' t h) := by
  funext i
  unfold step cf
  split_ifs
  · rfl
  · congr 1; ring

theorem girsanov (P : Measure Ω) [IsProbabilityMeasure P] (σ : ℝ) (hσ : σ ≠ 0)
    (hε : GaussianNoise σ P ε) (β β' : ℝ) :
    ∀ t (F : (Fin t → ℝ × ℝ) → ℝ≥0∞), Measurable F →
      ∫⁻ ω, F (hist M π ε β' t ω) ∂P
        = ∫⁻ ω, F (hist M π ε β t ω) *
            ENNReal.ofReal (Real.exp (S M π ε β β' (σ ^ 2).toNNReal t ω)) ∂P := by
  set v : ℝ≥0 := (σ ^ 2).toNNReal with hv_def
  have hv : v ≠ 0 := by
    rw [hv_def]; simp only [ne_eq, Real.toNNReal_eq_zero, not_le]; positivity
  have hεm := hε.measurable
  intro t
  induction t with
  | zero =>
    intro F _
    have h0 : ∀ ω, hist M π ε β' 0 ω = hist M π ε β 0 ω := fun ω => funext fun i => i.elim0
    simp [h0, S]
  | succ t ih =>
    intro F hF
    have hmh : ∀ b, Measurable (hist M π ε b t) := fun b =>
      (meas_hist_Fp M π ε hεm b t).mono (Fp_le ε hεm t) le_rfl
    have hFs : ∀ b, Measurable (fun q : (Fin t → ℝ × ℝ) × ℝ => F (step M π b t q.1 q.2)) :=
      fun b => hF.comp (measurable_step M π b t)
    have hcf : Measurable (cf M π β β' t) := by
      unfold cf; exact measurable_const.mul ((π.measurable_rule t).sub measurable_const)
    let G2 : (Fin t → ℝ × ℝ) × ℝ → ℝ≥0∞ := fun q =>
      F (step M π β t q.1 q.2) *
        ENNReal.ofReal (Real.exp (cf M π β β' t q.1 * q.2 / v - cf M π β β' t q.1 ^ 2 / (2 * v)))
    have hG2 : Measurable G2 := by
      refine (hFs β).mul (ENNReal.measurable_ofReal.comp (Real.measurable_exp.comp ?_))
      exact (((hcf.comp measurable_fst).mul measurable_snd).div_const _).sub
        (((hcf.comp measurable_fst).pow_const 2).div_const _)
    let Gt : (Fin t → ℝ × ℝ) → ℝ≥0∞ := fun h => ∫⁻ w, G2 (h, w) ∂(gaussianReal 0 v)
    have hGt : Measurable Gt := hG2.lintegral_prod_right'
    have hL : ∫⁻ ω, F (hist M π ε β' (t + 1) ω) ∂P = ∫⁻ ω, Gt (hist M π ε β' t ω) ∂P := by
      simp_rw [hist_succ]
      rw [lintegral_indep P (hist M π ε β' t) (ε t) (hmh β') (hεm t)
        (indepFun_past ε P σ hε t _ (meas_hist_Fp M π ε hεm β' t)) _ (hFs β'), hε.law t]
      refine lintegral_congr fun ω => ?_
      simp only [Gt, G2]
      simp_rw [step_shift M π β β' t]
      exact gauss_shift v hv (fun w => F (step M π β t (hist M π ε β' t ω) w))
        (hF.comp ((measurable_step M π β t).comp (measurable_const.prodMk measurable_id))) _
    have hR : ∫⁻ ω, F (hist M π ε β (t + 1) ω) *
          ENNReal.ofReal (Real.exp (S M π ε β β' v (t + 1) ω)) ∂P
        = ∫⁻ ω, Gt (hist M π ε β t ω) * ENNReal.ofReal (Real.exp (S M π ε β β' v t ω)) ∂P := by
      have hpt : ∀ ω, F (hist M π ε β (t + 1) ω) *
            ENNReal.ofReal (Real.exp (S M π ε β β' v (t + 1) ω))
          = (fun q : ((Fin t → ℝ × ℝ) × ℝ) × ℝ => G2 (q.1.1, q.2) * ENNReal.ofReal (Real.exp q.1.2))
              ((hist M π ε β t ω, S M π ε β β' v t ω), ε t ω) := by
        intro ω
        simp only [G2]
        rw [hist_succ, mul_assoc, ← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add]
        congr 3
        simp only [S, Finset.sum_range_succ, cf, ← pp_eq]
        ring
      rw [lintegral_congr hpt]
      have hX : Measurable[Fp ε t] (fun ω => (hist M π ε β t ω, S M π ε β β' v t ω)) :=
        (meas_hist_Fp M π ε hεm β t).prodMk (meas_S_Fp M π ε hεm β β' v t)
      rw [lintegral_indep P _ (ε t) (hX.mono (Fp_le ε hεm t) le_rfl) (hεm t)
        (indepFun_past ε P σ hε t _ hX)
        (fun q : ((Fin t → ℝ × ℝ) × ℝ) × ℝ => G2 (q.1.1, q.2) * ENNReal.ofReal (Real.exp q.1.2))
        ((hG2.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd)).mul
          (ENNReal.measurable_ofReal.comp (Real.measurable_exp.comp
            (measurable_snd.comp measurable_fst)))), hε.law t]
      refine lintegral_congr fun ω => ?_
      simp only [Gt]
      exact lintegral_mul_const _ (hG2.comp (measurable_const.prodMk measurable_id))
    rw [hL, hR]
    exact ih Gt hGt

end Process

/-! ### Two-point bound -/

section TwoPoint

variable (M : Model) (π : Policy M.l M.u) {Ω : Type*} [MeasurableSpace Ω] (ε : ℕ → Ω → ℝ)
  (P : Measure Ω) [IsProbabilityMeasure P]

lemma meas_pp (hεm : ∀ i, Measurable (ε i)) (β : ℝ) (t : ℕ) : Measurable (pp M π ε β t) :=
  (meas_pp_Fp M π ε hεm β t (t + 1) (by omega)).mono (Fp_le ε hεm _) le_rfl

lemma abs_x_le (β : ℝ) (t : ℕ) (ω : Ω) : |pp M π ε β t ω - M.pHat| ≤ M.u - M.l := by
  have h1 := pp_mem M π ε β t ω
  have h2 := M.pHat_mem
  rw [abs_le]; constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

lemma eps_integrable (σ : ℝ) (hε : GaussianNoise σ P ε) (s : ℕ) : Integrable (ε s) P := by
  have h : Integrable id (gaussianReal 0 (σ ^ 2).toNNReal) :=
    (memLp_id_gaussianReal 1).integrable le_rfl
  rw [← hε.law s] at h
  exact (integrable_map_measure h.aestronglyMeasurable (hε.measurable s).aemeasurable).mp h

lemma eps_mean (σ : ℝ) (hε : GaussianNoise σ P ε) (s : ℕ) : ∫ ω, ε s ω ∂P = 0 := by
  have h : ∫ x, x ∂(P.map (ε s)) = ∫ ω, ε s ω ∂P :=
    integral_map (hε.measurable s).aemeasurable aestronglyMeasurable_id
  rw [← h, hε.law s, integral_id_gaussianReal]

lemma int_xsq (hεm : ∀ i, Measurable (ε i)) (β : ℝ) (s : ℕ) :
    Integrable (fun ω => (pp M π ε β s ω - M.pHat) ^ 2) P := by
  refine Integrable.of_bound (((meas_pp M π ε hεm β s).sub measurable_const).pow_const 2
    ).aestronglyMeasurable ((M.u - M.l) ^ 2) (Filter.Eventually.of_forall fun ω => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs]
  exact pow_le_pow_left₀ (abs_nonneg _) (abs_x_le M π ε β s ω) 2

lemma integral_S (σ : ℝ) (hε : GaussianNoise σ P ε) (β β' : ℝ) (v : ℝ≥0) (t : ℕ) :
    Integrable (S M π ε β β' v t) P ∧
    ∫ ω, S M π ε β β' v t ω ∂P
      = -((β' - β) ^ 2 / (2 * v)) * ∫ ω, ∑ s ∈ Finset.range t, (pp M π ε β s ω - M.pHat) ^ 2 ∂P := by
  have hεm := hε.measurable
  have hx : ∀ s, Measurable (fun ω => (β' - β) * (pp M π ε β s ω - M.pHat)) := fun s =>
    measurable_const.mul ((meas_pp M π ε hεm β s).sub measurable_const)
  have hbd : ∀ s ω, ‖(β' - β) * (pp M π ε β s ω - M.pHat)‖ ≤ |β' - β| * (M.u - M.l) := by
    intro s ω
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_left (abs_x_le M π ε β s ω) (abs_nonneg _)
  have hi1 : ∀ s, Integrable (fun ω => (β' - β) * (pp M π ε β s ω - M.pHat) * ε s ω) P :=
    fun s => (eps_integrable ε P σ hε s).bdd_mul (hx s).aestronglyMeasurable
      (Filter.Eventually.of_forall (hbd s))
  have hi2 : ∀ s, Integrable (fun ω => ((β' - β) * (pp M π ε β s ω - M.pHat)) ^ 2) P := by
    intro s
    have := (int_xsq M π ε P hεm β s).const_mul ((β' - β) ^ 2)
    refine this.congr (Filter.Eventually.of_forall fun ω => ?_)
    simp only; ring
  have hterm : ∀ s, Integrable (fun ω => (β' - β) * (pp M π ε β s ω - M.pHat) * ε s ω / v
      - ((β' - β) * (pp M π ε β s ω - M.pHat)) ^ 2 / (2 * v)) P := fun s =>
    ((hi1 s).div_const _).sub ((hi2 s).div_const _)
  have hint : Integrable (S M π ε β β' v t) P := by
    unfold S; exact integrable_finset_sum _ fun s _ => hterm s
  refine ⟨hint, ?_⟩
  unfold S
  rw [integral_finsetSum _ fun s _ => hterm s,
    integral_finsetSum _ fun s _ => int_xsq M π ε P hεm β s, Finset.mul_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [integral_sub ((hi1 s).div_const _) ((hi2 s).div_const _), integral_div, integral_div]
  have hind : IndepFun (fun ω => (β' - β) * (pp M π ε β s ω - M.pHat)) (ε s) P :=
    indepFun_past ε P σ hε s _
      (@helper_lin Ω (Fp ε s) (β' - β) M.pHat _ (meas_pp_Fp' M π ε hεm β s))
  rw [hind.integral_fun_mul_eq_mul_integral (hx s).aestronglyMeasurable
      (hεm s).aestronglyMeasurable, eps_mean ε P σ hε s, mul_zero, zero_div, zero_sub]
  have : ∫ ω, ((β' - β) * (pp M π ε β s ω - M.pHat)) ^ 2 ∂P
      = (β' - β) ^ 2 * ∫ ω, (pp M π ε β s ω - M.pHat) ^ 2 ∂P := by
    rw [← integral_const_mul]; congr 1; funext ω; ring
  rw [this]; ring

lemma pw_bound (a ψ ψ' S : ℝ) :
    (ψ - ψ') ^ 2 / 2 * (3 / 4 + S / 2 - Real.exp S / 4)
      ≤ (a - ψ) ^ 2 + (a - ψ') ^ 2 * Real.exp S := by
  set y := Real.exp (S / 2) with hy
  have hy0 : 0 < y := Real.exp_pos _
  have hyS : Real.exp S = y ^ 2 := by
    rw [hy, sq, ← Real.exp_add]; congr 1; ring
  have h1 : S / 2 + 1 ≤ y := Real.add_one_le_exp _
  set m := min 1 (Real.exp S) with hm
  have hm0 : 0 ≤ m := le_min zero_le_one (Real.exp_pos _).le
  have hm1 : m ≤ 1 := min_le_left _ _
  have hmL : m ≤ Real.exp S := min_le_right _ _
  have hmy : y - (1 + y ^ 2) / 4 ≤ m := by
    rcases le_total 1 (Real.exp S) with h | h
    · rw [hm, min_eq_left h]; nlinarith [sq_nonneg (y - 2)]
    · rw [hm, min_eq_right h, hyS]; nlinarith [sq_nonneg (5 * y - 2)]
  have hD : (ψ - ψ') ^ 2 / 2 ≤ (a - ψ) ^ 2 + (a - ψ') ^ 2 := by
    nlinarith [sq_nonneg (2 * a - ψ - ψ')]
  have hD0 : 0 ≤ (ψ - ψ') ^ 2 / 2 := by positivity
  have hA : m * ((a - ψ) ^ 2 + (a - ψ') ^ 2) ≤ (a - ψ) ^ 2 + (a - ψ') ^ 2 * Real.exp S := by
    nlinarith [sq_nonneg (a - ψ), sq_nonneg (a - ψ'),
      mul_le_mul_of_nonneg_left hm1 (sq_nonneg (a - ψ)),
      mul_le_mul_of_nonneg_left hmL (sq_nonneg (a - ψ'))]
  have hB : (ψ - ψ') ^ 2 / 2 * (3 / 4 + S / 2 - Real.exp S / 4) ≤ (ψ - ψ') ^ 2 / 2 * m := by
    apply mul_le_mul_of_nonneg_left _ hD0
    rw [hyS]; linarith
  calc _ ≤ (ψ - ψ') ^ 2 / 2 * m := hB
    _ ≤ m * ((a - ψ) ^ 2 + (a - ψ') ^ 2) := by
        rw [mul_comm]; exact mul_le_mul_of_nonneg_left hD hm0
    _ ≤ _ := hA

theorem two_point (σ : ℝ) (hσ : σ ≠ 0) (hε : GaussianNoise σ P ε) (β β' ψ ψ' : ℝ) (t : ℕ) :
    (ψ - ψ') ^ 2 / 2 * (1 / 2 - (β' - β) ^ 2 *
        (∫ ω, ∑ s ∈ Finset.range t, (pp M π ε β s ω - M.pHat) ^ 2 ∂P) / (4 * σ ^ 2))
      ≤ (∫ ω, (pp M π ε β t ω - M.pHat - ψ) ^ 2 ∂P)
        + ∫ ω, (pp M π ε β' t ω - M.pHat - ψ') ^ 2 ∂P := by
  have hεm := hε.measurable
  set v : ℝ≥0 := (σ ^ 2).toNNReal with hv_def
  have hvR : (v : ℝ) = σ ^ 2 := Real.coe_toNNReal _ (sq_nonneg _)
  have hσ2 : 0 < σ ^ 2 := by positivity
  set Λ : Ω → ℝ := fun ω => Real.exp (S M π ε β β' v t ω) with hΛ
  have hSm : Measurable (S M π ε β β' v t) :=
    (meas_S_Fp M π ε hεm β β' v t).mono (Fp_le ε hεm t) le_rfl
  have hΛm : Measurable Λ := Real.measurable_exp.comp hSm
  have hΛl : ∫⁻ ω, ENNReal.ofReal (Λ ω) ∂P = 1 := by
    have := girsanov M π ε P σ hσ hε β β' t (fun _ => 1) measurable_const
    simp only [one_mul, lintegral_const, measure_univ, mul_one] at this
    exact this.symm
  have hΛi : Integrable Λ P := by
    have := integrable_toReal_of_lintegral_ne_top
      (show AEMeasurable (fun ω => ENNReal.ofReal (Λ ω)) P from
        (ENNReal.measurable_ofReal.comp hΛm).aemeasurable)
      (show ∫⁻ ω, ENNReal.ofReal (Λ ω) ∂P ≠ ⊤ by rw [hΛl]; exact ENNReal.one_ne_top)
    refine this.congr (Filter.Eventually.of_forall fun ω => ?_)
    simp [Λ, (Real.exp_pos _).le]
  have hΛint : ∫ ω, Λ ω ∂P = 1 := by
    rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun ω => (Real.exp_pos _).le)
      hΛm.aestronglyMeasurable, hΛl]
    simp
  obtain ⟨hSi, hSint⟩ := integral_S M π ε P σ hε β β' v t
  -- the second expectation via change of measure
  set g : (Fin t → ℝ × ℝ) → ℝ := fun h => (π.rule t h - M.pHat - ψ') ^ 2 with hg
  have hgm : Measurable g := (((π.measurable_rule t).sub measurable_const).sub
    measurable_const).pow_const 2
  have hhm : ∀ b, Measurable (hist M π ε b t) := fun b =>
    (meas_hist_Fp M π ε hεm b t).mono (Fp_le ε hεm t) le_rfl
  have hB : ∫ ω, (pp M π ε β' t ω - M.pHat - ψ') ^ 2 ∂P
      = ∫ ω, g (hist M π ε β t ω) * Λ ω ∂P := by
    have e1 : (fun ω => (pp M π ε β' t ω - M.pHat - ψ') ^ 2) = fun ω => g (hist M π ε β' t ω) := by
      funext ω; simp only [g, pp_eq]
    rw [e1, integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun ω => sq_nonneg _)
      (hgm.comp (hhm β')).aestronglyMeasurable,
      integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun ω =>
        mul_nonneg (sq_nonneg _) (Real.exp_pos _).le)
      ((hgm.comp (hhm β)).mul hΛm).aestronglyMeasurable,
      girsanov M π ε P σ hσ hε β β' t (fun h => ENNReal.ofReal (g h))
        (ENNReal.measurable_ofReal.comp hgm)]
    congr 1
    refine lintegral_congr fun ω => ?_
    rw [ENNReal.ofReal_mul (sq_nonneg _)]
  have hbd : ∀ (c : ℝ) (b : ℝ) ω, ‖(pp M π ε b t ω - M.pHat - c) ^ 2‖ ≤ (M.u - M.l + |c|) ^ 2 := by
    intro c b ω
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs]
    refine pow_le_pow_left₀ (abs_nonneg _) ?_ 2
    calc |pp M π ε b t ω - M.pHat - c| ≤ |pp M π ε b t ω - M.pHat| + |c| := abs_sub _ _
      _ ≤ _ := by linarith [abs_x_le M π ε b t ω]
  have hfi : Integrable (fun ω => (pp M π ε β t ω - M.pHat - ψ) ^ 2) P :=
    Integrable.of_bound ((((meas_pp M π ε hεm β t).sub measurable_const).sub
      measurable_const).pow_const 2).aestronglyMeasurable _
      (Filter.Eventually.of_forall (hbd ψ β))
  have hgi : Integrable (fun ω => g (hist M π ε β t ω) * Λ ω) P := by
    refine hΛi.bdd_mul (c := (M.u - M.l + |ψ'|) ^ 2) (hgm.comp (hhm β)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ω => ?_)
    have := hbd ψ' β ω
    simp only [g, ← pp_eq]
    exact this
  rw [hB, ← integral_add hfi hgi]
  have hlow : ∫ ω, (ψ - ψ') ^ 2 / 2 * (3 / 4 + S M π ε β β' v t ω / 2 - Λ ω / 4) ∂P
      ≤ ∫ ω, ((pp M π ε β t ω - M.pHat - ψ) ^ 2 + g (hist M π ε β t ω) * Λ ω) ∂P := by
    refine integral_mono ?_ (hfi.add hgi) fun ω => ?_
    · exact ((((integrable_const _).add (hSi.div_const _)).sub (hΛi.div_const _)).const_mul _)
    · have := pw_bound (pp M π ε β t ω - M.pHat) ψ ψ' (S M π ε β β' v t ω)
      simp only [g, Λ, ← pp_eq]
      simp only [sub_sub] at this ⊢
      exact this
  refine le_trans (le_of_eq ?_) hlow
  have hI : ∫ ω, (3 / 4 + S M π ε β β' v t ω / 2 - Λ ω / 4) ∂P
      = 3 / 4 + (∫ ω, S M π ε β β' v t ω ∂P) / 2 - (∫ ω, Λ ω ∂P) / 4 := by
    have h1 : Integrable (fun ω => 3 / 4 + S M π ε β β' v t ω / 2) P :=
      (integrable_const _).add (hSi.div_const _)
    have h2 : Integrable (fun ω => Λ ω / 4) P := hΛi.div_const _
    rw [integral_sub h1 h2, integral_add (integrable_const _) (hSi.div_const _), integral_div,
      integral_div, integral_const]
    simp only [measure_univ, Measure.real, ENNReal.toReal_one, smul_eq_mul, one_mul]
    rw [integral_div]
  rw [integral_const_mul, hI, hΛint, hSint, hvR]
  field_simp
  ring

lemma sqErr_eq (β : ℝ) (t : ℕ) :
    sqErr M P ε π β t = ∫ ω, (pp M π ε β t ω - M.pHat - M.optDev β) ^ 2 ∂P := rfl

lemma expInfo_eq (β : ℝ) (t : ℕ) :
    expInfo M P ε π β t = ∫ ω, ∑ s ∈ Finset.range t, (pp M π ε β s ω - M.pHat) ^ 2 ∂P := rfl

lemma optDev_sub_sq (β β' : ℝ) (hβ : β ∈ M.B) (hβ' : β' ∈ M.B) :
    (|M.DHat| / (2 * M.bMin ^ 2)) ^ 2 * (β' - β) ^ 2 ≤ (M.optDev β - M.optDev β') ^ 2 := by
  have hb0 : β < 0 := lt_of_le_of_lt hβ.2 M.bMax_neg
  have hb0' : β' < 0 := lt_of_le_of_lt hβ'.2 M.bMax_neg
  have hm0 : M.bMin < 0 := lt_trans M.bMin_lt_bMax M.bMax_neg
  have hne := hb0.ne; have hne' := hb0'.ne
  have e : M.optDev β - M.optDev β' = M.DHat * (β - β') / (2 * β * β') := by
    simp only [Model.optDev]; field_simp; ring
  rw [e, div_pow, div_pow, sq_abs]
  have h1 : β ^ 2 ≤ M.bMin ^ 2 := by nlinarith [hβ.1]
  have h2 : β' ^ 2 ≤ M.bMin ^ 2 := by nlinarith [hβ'.1]
  have hpos : 0 < (2 * β * β') ^ 2 := by
    have : 0 < β * β' := mul_pos_of_neg_of_neg hb0 hb0'; positivity
  have hle : (2 * β * β') ^ 2 ≤ (2 * M.bMin ^ 2) ^ 2 := by
    have : (2 * β * β') ^ 2 = 4 * (β ^ 2 * β' ^ 2) := by ring
    rw [this, show (2 * M.bMin ^ 2) ^ 2 = 4 * (M.bMin ^ 2 * M.bMin ^ 2) by ring]
    have := mul_le_mul h1 h2 (sq_nonneg _) (sq_nonneg _)
    linarith
  rw [show (M.DHat * (β - β')) ^ 2 = M.DHat ^ 2 * (β' - β) ^ 2 by ring]
  calc M.DHat ^ 2 / (2 * M.bMin ^ 2) ^ 2 * (β' - β) ^ 2
      = M.DHat ^ 2 * (β' - β) ^ 2 / (2 * M.bMin ^ 2) ^ 2 := by ring
    _ ≤ M.DHat ^ 2 * (β' - β) ^ 2 / (2 * β * β') ^ 2 :=
        div_le_div_of_nonneg_left (by positivity) hpos hle

theorem pair_bound (hε : GaussianNoise M.σ P ε) (β β' : ℝ) (hβ : β ∈ M.B) (hβ' : β' ∈ M.B)
    (t : ℕ) (J : ℝ) (hJ : expInfo M P ε π β t ≤ J) (hh : (β' - β) ^ 2 * J ≤ M.σ ^ 2) :
    (|M.DHat| / (2 * M.bMin ^ 2)) ^ 2 * (β' - β) ^ 2 / 8
      ≤ sqErr M P ε π β t + sqErr M P ε π β' t := by
  have h := two_point M π ε P M.σ M.σ_pos.ne' hε β β' (M.optDev β) (M.optDev β') t
  rw [sqErr_eq, sqErr_eq]
  rw [← expInfo_eq] at h
  have hσ2 : 0 < M.σ ^ 2 := by have := M.σ_pos; positivity
  have hf : 1 / 4 ≤ 1 / 2 - (β' - β) ^ 2 * expInfo M P ε π β t / (4 * M.σ ^ 2) := by
    have : (β' - β) ^ 2 * expInfo M P ε π β t ≤ M.σ ^ 2 :=
      le_trans (mul_le_mul_of_nonneg_left hJ (sq_nonneg _)) hh
    rw [div_le_iff₀ (by positivity)] at *
    have : (β' - β) ^ 2 * expInfo M P ε π β t / (4 * M.σ ^ 2) ≤ 1 / 4 := by
      rw [div_le_iff₀ (by positivity)]; linarith
    linarith
  have hd := optDev_sub_sq M β β' hβ hβ'
  refine le_trans ?_ h
  calc (|M.DHat| / (2 * M.bMin ^ 2)) ^ 2 * (β' - β) ^ 2 / 8
      = (|M.DHat| / (2 * M.bMin ^ 2)) ^ 2 * (β' - β) ^ 2 / 2 * (1 / 4) := by ring
    _ ≤ (M.optDev β - M.optDev β') ^ 2 / 2 * (1 / 4) := by gcongr
    _ ≤ _ := mul_le_mul_of_nonneg_left hf (by positivity)

end TwoPoint

/-! ### Averaging over a grid -/

lemma grid_sum (a : ℕ → ℝ) (ha : ∀ k, 0 ≤ a k) (N m : ℕ) (hm : m ≤ N) (c : ℝ)
    (hc : ∀ k, k ≤ N - m → c ≤ a k + a (k + m)) :
    ((N - m + 1 : ℕ) : ℝ) * c ≤ 2 * ∑ k ∈ Finset.range (N + 1), a k := by
  have h1 : ∑ k ∈ Finset.range (N - m + 1), a k ≤ ∑ k ∈ Finset.range (N + 1), a k :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_subset_range.mpr (by omega))
      fun k _ _ => ha k
  have h2 : ∑ k ∈ Finset.range (N - m + 1), a (k + m) ≤ ∑ k ∈ Finset.range (N + 1), a k := by
    have : ∑ k ∈ Finset.range (N - m + 1), a (k + m) = ∑ k ∈ Finset.Ico m (N + 1), a k := by
      rw [Finset.sum_Ico_eq_sum_range, show N + 1 - m = N - m + 1 by omega]
      exact Finset.sum_congr rfl fun k _ => by rw [add_comm]
    rw [this]
    exact Finset.sum_le_sum_of_subset_of_nonneg (fun x hx => by
      simp only [Finset.mem_Ico, Finset.mem_range] at hx ⊢; omega) fun k _ _ => ha k
  have h3 : ((N - m + 1 : ℕ) : ℝ) * c ≤ ∑ k ∈ Finset.range (N - m + 1), (a k + a (k + m)) := by
    have := Finset.sum_le_sum fun k (hk : k ∈ Finset.range (N - m + 1)) =>
      hc k (by simp at hk; omega)
    simpa using this
  rw [Finset.sum_add_distrib] at h3
  linarith

end KZILB4

namespace KZILB4

section Final

variable (M : Model) (π : Policy M.l M.u) {Ω : Type*} [MeasurableSpace Ω] (ε : ℕ → Ω → ℝ)
  (P : Measure Ω) [IsProbabilityMeasure P]

lemma sqErr_nonneg (β : ℝ) (t : ℕ) : 0 ≤ sqErr M P ε π β t :=
  integral_nonneg fun _ => sq_nonneg _

lemma sqErr_le (β : ℝ) (hβ : β ∈ M.B) (t : ℕ) : sqErr M P ε π β t ≤ (M.u - M.l) ^ 2 := by
  rw [sqErr_eq]
  have hi := M.interior β hβ
  have : ∫ ω, (pp M π ε β t ω - M.pHat - M.optDev β) ^ 2 ∂P ≤ ∫ _ω, (M.u - M.l) ^ 2 ∂P := by
    refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ω => sq_nonneg _)
      (integrable_const _) (Filter.Eventually.of_forall fun ω => ?_)
    have h1 := pp_mem M π ε β t ω
    have h2 : |pp M π ε β t ω - M.pHat - M.optDev β| ≤ M.u - M.l := by
      simp only [Model.optDev]
      rw [abs_le]; constructor <;> nlinarith [h1.1, h1.2, hi.1, hi.2]
    have := pow_le_pow_left₀ (abs_nonneg _) h2 2
    rwa [sq_abs] at this
  simpa using this

lemma expInfo_le (β : ℝ) (t : ℕ) : expInfo M P ε π β t ≤ (M.u - M.l) ^ 2 * t := by
  rw [expInfo_eq]
  have : ∫ ω, ∑ s ∈ Finset.range t, (pp M π ε β s ω - M.pHat) ^ 2 ∂P
      ≤ ∫ _ω, ∑ s ∈ Finset.range t, (M.u - M.l) ^ 2 ∂P := by
    refine integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun ω => Finset.sum_nonneg fun s _ => sq_nonneg _)
      (integrable_const _) (Filter.Eventually.of_forall fun ω => ?_)
    refine Finset.sum_le_sum fun s _ => ?_
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (abs_x_le M π ε β s ω) 2
  refine this.trans (le_of_eq ?_)
  simp [mul_comm]

end Final

end KZILB4

open KZILB4 in
theorem solution (M : Model) :
    ∃ c₀ : ℝ, 0 < c₀ ∧ ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (ε : ℕ → Ω → ℝ), GaussianNoise M.σ P ε →
      ∀ (π : Policy M.l M.u) (T : ℕ),
        ∑ t ∈ Finset.Ico 1 T, c₀ / (c₁ + ⨆ β : M.B, expInfo M P ε π (β : ℝ) t)
          ≤ ⨆ β : M.Bexcl, ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t := by
  set κ : ℝ := |M.DHat| / (2 * M.bMin ^ 2) with hκ
  set L : ℝ := M.bMax - M.bMin with hL
  have hm0 : M.bMin < 0 := lt_trans M.bMin_lt_bMax M.bMax_neg
  have hκ0 : 0 < κ := by
    have h1 := abs_pos.mpr M.DHat_ne_zero
    have h2 : 0 < M.bMin ^ 2 := by nlinarith
    exact div_pos h1 (by positivity)
  have hL0 : 0 < L := by rw [hL]; linarith [M.bMin_lt_bMax]
  have hσ2 : 0 < M.σ ^ 2 := by have := M.σ_pos; positivity
  refine ⟨κ ^ 2 * M.σ ^ 2 / 128, by positivity, 1 + 16 * M.σ ^ 2 / L ^ 2, by positivity, ?_⟩
  intro Ω _ P _ ε hε π T
  obtain ⟨J, hJdef⟩ : ∃ J : ℕ → ℝ, J = fun t => ⨆ β : M.B, expInfo M P ε π (β : ℝ) t :=
    ⟨_, rfl⟩
  have hJt : ∀ t, (⨆ β : M.B, expInfo M P ε π (β : ℝ) t) = J t := by
    intro t; rw [hJdef]
  simp_rw [hJt]
  have hJ0 : ∀ t, 0 ≤ J t := fun t => (hJt t) ▸ Real.iSup_nonneg fun β =>
    integral_nonneg fun ω => Finset.sum_nonneg fun s _ => sq_nonneg _
  have hJle : ∀ (β : ℝ) (hβ : β ∈ M.B) t, expInfo M P ε π β t ≤ J t := by
    intro β hβ t
    rw [← hJt]
    refine le_ciSup (f := fun β : M.B => expInfo M P ε π (β : ℝ) t) ?_ ⟨β, hβ⟩
    exact ⟨(M.u - M.l) ^ 2 * t, by rintro _ ⟨b, rfl⟩; exact expInfo_le M π ε P b t⟩
  -- step sizes
  obtain ⟨q, hq⟩ : ∃ q : ℕ → ℝ, q = fun t => min (L ^ 2 / 16) (M.σ ^ 2 / (J t + 1)) := ⟨_, rfl⟩
  have hqle1 : ∀ t, q t ≤ L ^ 2 / 16 := fun t => by rw [hq]; exact min_le_left _ _
  have hqle2 : ∀ t, q t ≤ M.σ ^ 2 / (J t + 1) := fun t => by rw [hq]; exact min_le_right _ _
  have hqge : ∀ t, ∀ x, x ≤ L ^ 2 / 16 → x ≤ M.σ ^ 2 / (J t + 1) → x ≤ q t :=
    fun t x h1 h2 => by rw [hq]; exact le_min h1 h2
  have hq0 : ∀ t, 0 < q t := fun t => by
    rw [hq]; exact lt_min (by positivity) (by have := hJ0 t; positivity)
  obtain ⟨hs, hhs⟩ : ∃ hs : ℕ → ℝ, hs = fun t => Real.sqrt (q t) := ⟨_, rfl⟩
  have hs0 : ∀ t, 0 < hs t := fun t => by rw [hhs]; exact Real.sqrt_pos.mpr (hq0 t)
  have hs_sq : ∀ t, hs t ^ 2 = q t := fun t => by rw [hhs]; exact Real.sq_sqrt (hq0 t).le
  have hsL : ∀ t, hs t ≤ L / 4 := by
    intro t
    rw [hhs]
    rw [show L / 4 = Real.sqrt ((L / 4) ^ 2) from (Real.sqrt_sq (by positivity)).symm]
    exact Real.sqrt_le_sqrt (le_trans (hqle1 t) (le_of_eq (by ring)))
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = (Finset.range T).sup (fun t => ⌈L / hs t⌉₊) + 1 := ⟨_, rfl⟩
  have hN1 : 1 ≤ N := by omega
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN1
  have hNt : ∀ t ∈ Finset.range T, L / hs t ≤ N := by
    intro t ht
    have h1 : ⌈L / hs t⌉₊ ≤ (Finset.range T).sup (fun t => ⌈L / hs t⌉₊) :=
      Finset.le_sup (f := fun t => ⌈L / hs t⌉₊) ht
    have h2 := Nat.le_ceil (L / hs t)
    have h3 : ((⌈L / hs t⌉₊ : ℕ) : ℝ) ≤ N := by exact_mod_cast (show _ ≤ N by omega)
    linarith
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = L / (2 * N) := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδ]; positivity
  have hNδ : (N : ℝ) * δ = L / 2 := by rw [hδ]; field_simp
  -- choice of the grid offset
  have hψ : ∀ b : ℝ, b ∈ M.B → (M.optDev b = 0 ↔ M.pHat * b = -M.DHat) := by
    intro b hb
    have hb0 : b ≠ 0 := (lt_of_le_of_lt hb.2 M.bMax_neg).ne
    simp only [Model.optDev]
    constructor
    · intro h; field_simp at h; linarith
    · intro h; field_simp; linarith
  have hgridB : ∀ (a0 : ℝ), M.bMin ≤ a0 → a0 ≤ M.bMin + δ / 2 → ∀ k ≤ N,
      a0 + k * δ ∈ M.B := by
    intro a0 h1 h2 k hk
    have hk' : (k : ℝ) * δ ≤ N * δ := mul_le_mul_of_nonneg_right (by exact_mod_cast hk) hδ0.le
    have hδL : δ ≤ L / 2 := by
      rw [← hNδ]; nlinarith [show (1 : ℝ) ≤ N by exact_mod_cast hN1]
    constructor
    · nlinarith [show (0 : ℝ) ≤ k * δ by positivity]
    · rw [hL] at hNδ hδL; linarith
  obtain ⟨a0, ha1, ha2, hgrid⟩ : ∃ a0 : ℝ, M.bMin ≤ a0 ∧ a0 ≤ M.bMin + δ / 2 ∧
      ∀ k ≤ N, a0 + k * δ ∈ M.Bexcl := by
    by_cases hbad : ∃ k ≤ N, M.optDev (M.bMin + k * δ) = 0
    · obtain ⟨k, hk, hk0⟩ := hbad
      refine ⟨M.bMin + δ / 2, by linarith, le_rfl, fun j hj => ⟨hgridB _ (by linarith) le_rfl j hj,
        fun hj0 => ?_⟩⟩
      have e1 := (hψ _ (hgridB _ le_rfl (by linarith) k hk)).mp hk0
      have e2 := (hψ _ (hgridB _ (by linarith) le_rfl j hj)).mp hj0
      have hp : M.pHat ≠ 0 := by
        intro h; rw [h, zero_mul] at e1; exact M.DHat_ne_zero (by linarith)
      have e3 : M.bMin + k * δ = M.bMin + δ / 2 + j * δ :=
        mul_left_cancel₀ hp (by rw [e1, e2])
      have e4 : (2 * k : ℝ) = 2 * j + 1 := by
        have : (k : ℝ) * δ = (j + 1 / 2) * δ := by linarith
        have := mul_right_cancel₀ hδ0.ne' this
        linarith
      have e5 : 2 * k = 2 * j + 1 := by exact_mod_cast e4
      omega
    · push Not at hbad
      exact ⟨M.bMin, le_rfl, by linarith, fun k hk => ⟨hgridB _ le_rfl (by linarith) k hk,
        hbad k hk⟩⟩
  obtain ⟨bk, hbk⟩ : ∃ bk : ℕ → ℝ, bk = fun k : ℕ => a0 + (k : ℝ) * δ := ⟨_, rfl⟩
  have hbkB : ∀ k ≤ N, bk k ∈ M.B := fun k hk => by rw [hbk]; exact (hgrid k hk).1
  -- per-period averaged lower bound
  have hper : ∀ t ∈ Finset.Ico 1 T,
      ((N + 1 : ℕ) : ℝ) * (κ ^ 2 * M.σ ^ 2 / 128 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t))
        ≤ ∑ k ∈ Finset.range (N + 1), sqErr M P ε π (bk k) t := by
    intro t ht
    have htT : t ∈ Finset.range T := by
      simp only [Finset.mem_Ico, Finset.mem_range] at ht ⊢; omega
    have hNt' := hNt t htT
    have hδs : δ ≤ hs t / 2 := by
      rw [hδ, div_le_iff₀ (by positivity)]
      rw [div_le_iff₀ (hs0 t)] at hNt'
      nlinarith
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m = ⌊hs t / δ⌋₊ := ⟨_, rfl⟩
    have hm1 : (m : ℝ) * δ ≤ hs t := by
      have := Nat.floor_le (show 0 ≤ hs t / δ by have := hs0 t; positivity)
      rw [← hm, le_div_iff₀ hδ0] at this; exact this
    have hm2 : hs t / 2 ≤ (m : ℝ) * δ := by
      have := Nat.lt_floor_add_one (hs t / δ)
      rw [← hm, div_lt_iff₀ hδ0] at this
      linarith
    have hmN2 : (m : ℝ) ≤ N / 2 := by
      have : (m : ℝ) * δ ≤ N / 2 * δ := by
        have := hsL t; nlinarith
      exact le_of_mul_le_mul_right this hδ0
    have hmN : m ≤ N := by
      have : (m : ℝ) ≤ N := by linarith [show (0 : ℝ) ≤ N by positivity]
      exact_mod_cast this
    have hpair : ∀ k, k ≤ N - m → κ ^ 2 * q t / 32
        ≤ sqErr M P ε π (bk k) t + sqErr M P ε π (bk (k + m)) t := by
      intro k hk
      have hb1 := hbkB k (by omega)
      have hb2 := hbkB (k + m) (by omega)
      have hdiff : bk (k + m) - bk k = m * δ := by rw [hbk]; push_cast; ring
      have hsq : (m * δ) ^ 2 ≤ q t := by
        rw [← hs_sq t]; exact pow_le_pow_left₀ (by positivity) hm1 2
      have hsq2 : q t / 4 ≤ (m * δ) ^ 2 := by
        rw [← hs_sq t]; nlinarith [hs0 t]
      have hJq : (bk (k + m) - bk k) ^ 2 * J t ≤ M.σ ^ 2 := by
        rw [hdiff]
        have hq2 : q t ≤ M.σ ^ 2 / (J t + 1) := hqle2 t
        have hJ1 : 0 < J t + 1 := by linarith [hJ0 t]
        have : (m * δ) ^ 2 * (J t + 1) ≤ M.σ ^ 2 := by
          have := le_trans hsq hq2
          rwa [le_div_iff₀ hJ1] at this
        nlinarith [hJ0 t, sq_nonneg ((m : ℝ) * δ)]
      have := pair_bound M π ε P hε (bk k) (bk (k + m)) hb1 hb2 t (J t)
        (hJle _ hb1 t) hJq
      rw [hdiff] at this
      refine le_trans ?_ this
      have : κ ^ 2 * q t / 32 ≤ κ ^ 2 * (m * δ) ^ 2 / 8 := by
        have := mul_le_mul_of_nonneg_left hsq2 (sq_nonneg κ); linarith
      simpa [hκ] using this
    have hgs := grid_sum (fun k => sqErr M P ε π (bk k) t)
      (fun k => sqErr_nonneg M π ε P _ t) N m hmN _ hpair
    have hcast : ((N - m + 1 : ℕ) : ℝ) = N - m + 1 := by push_cast [Nat.cast_sub hmN]; ring
    rw [hcast] at hgs
    have hqlow : M.σ ^ 2 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t) ≤ q t := by
      have hJ := hJ0 t
      apply hqge
      · rw [div_le_iff₀ (by positivity)]
        have : L ^ 2 / 16 * (1 + 16 * M.σ ^ 2 / L ^ 2 + J t) = L ^ 2 / 16 + M.σ ^ 2 + L ^ 2 / 16 * J t := by
          field_simp
        rw [this]; nlinarith [sq_nonneg L]
      · apply div_le_div_of_nonneg_left hσ2.le (by positivity)
        have : 0 ≤ 16 * M.σ ^ 2 / L ^ 2 := by positivity
        linarith
    have hN' : ((N + 1 : ℕ) : ℝ) = N + 1 := by push_cast; ring
    rw [hN']
    have hkey : (N + 1) / 2 * (κ ^ 2 * q t / 32) ≤ 2 * ∑ k ∈ Finset.range (N + 1),
        sqErr M P ε π (bk k) t := by
      refine le_trans ?_ hgs
      apply mul_le_mul_of_nonneg_right _ (by have := hq0 t; positivity)
      linarith
    have : κ ^ 2 * M.σ ^ 2 / 128 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t)
        = κ ^ 2 / 128 * (M.σ ^ 2 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t)) := by ring
    rw [this]
    have h5 : κ ^ 2 / 128 * (M.σ ^ 2 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t)) ≤ κ ^ 2 / 128 * q t :=
      mul_le_mul_of_nonneg_left hqlow (by positivity)
    nlinarith [hNpos, h5]
  -- the supremum dominates the grid average
  have hbdd : BddAbove (Set.range fun β : M.Bexcl =>
      ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t) := by
    refine ⟨∑ t ∈ Finset.Ico 1 T, (M.u - M.l) ^ 2, ?_⟩
    rintro _ ⟨β, rfl⟩
    exact Finset.sum_le_sum fun t _ => sqErr_le M π ε P β β.2.1 t
  have hsup : ∀ k ≤ N, ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (bk k) t
      ≤ ⨆ β : M.Bexcl, ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t := fun k hk =>
    le_ciSup (f := fun β : M.Bexcl => ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t) hbdd
      ⟨bk k, by rw [hbk]; exact hgrid k hk⟩
  have htot : ((N + 1 : ℕ) : ℝ) * ∑ t ∈ Finset.Ico 1 T,
      κ ^ 2 * M.σ ^ 2 / 128 / (1 + 16 * M.σ ^ 2 / L ^ 2 + J t)
      ≤ ((N + 1 : ℕ) : ℝ) * ⨆ β : M.Bexcl, ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t := by
    rw [Finset.mul_sum]
    calc _ ≤ ∑ t ∈ Finset.Ico 1 T, ∑ k ∈ Finset.range (N + 1), sqErr M P ε π (bk k) t :=
          Finset.sum_le_sum hper
      _ = ∑ k ∈ Finset.range (N + 1), ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (bk k) t :=
          Finset.sum_comm
      _ ≤ ∑ k ∈ Finset.range (N + 1),
            ⨆ β : M.Bexcl, ∑ t ∈ Finset.Ico 1 T, sqErr M P ε π (β : ℝ) t :=
          Finset.sum_le_sum fun k hk => hsup k (by simp at hk; omega)
      _ = _ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have hpos : (0 : ℝ) < ((N + 1 : ℕ) : ℝ) := by positivity
  exact le_of_mul_le_mul_left htot hpos
