theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_filtered_lifts_coordinates_integral_repair6
    {d : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (g : Fin m → MvPolynomial (Fin d) Complex)
    (hbound : ∀ j, ∀ a ∈ (g j).support,
      ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real))
    (hfinite : Module.Finite
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j))))
      (MvPolynomial (Fin d) Complex))
    (i : Fin d) :
    IsIntegral (Algebra.adjoin Complex (Set.range g) : Subalgebra Complex (MvPolynomial (Fin d) Complex))
      (MvPolynomial.X i : MvPolynomial (Fin d) Complex) := by sorry
