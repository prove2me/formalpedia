theorem solution {R : ℝ} (hR : 3 < R) : Hc (1 / R) = R * Lg R := by
  have hR0 : (0:ℝ) < R := by linarith
  have hR1 : (1:ℝ) < R := by linarith
  have hRne : (R:ℝ) ≠ 0 := ne_of_gt hR0
