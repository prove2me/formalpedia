    have hmul : 11 * x.L * (i + 1) ≤ 11 * x.L * x.leaves.length := Nat.mul_le_mul_left _ hi
    have hcap : x.T.length + 11 * x.L * x.leaves.length ≤ x.cap := by
      have hroom := H.room
