open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections (contract2)
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry.KSData
variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (a p : Fin 5) :
    ∑ q, ksC b bi v k a p q x * k x q =
      (dprof v k x * k x a * lowerK b k x p + v x * accel b bi k x a * lowerK b k x p
        + v x * k x a * accL b bi k x p) / 2 := by
  simp only [hD.ksC_eq hx]
  have e : ∑ q, (∑ d, ksInverse bi v k a d x *
      ((nablaH b bi v k x q d p + nablaH b bi v k x p d q - nablaH b bi v k x d p q) / 2)) * k x q
      = ∑ d, ksInverse bi v k a d x * ((∑ q, nablaH b bi v k x q d p * k x q
          + ∑ q, nablaH b bi v k x p d q * k x q - ∑ q, nablaH b bi v k x d p q * k x q) / 2) := by
    simp only [Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, Finset.sum_div, Finset.mul_sum]
    exact Finset.sum_congr rfl fun q _ => by ring
  rw [e]
  simp only [nablaH_first, hD.nablaH_last hx, add_zero, sub_zero]
  have e2 : ∑ d, ksInverse bi v k a d x * ((dprof v k x * lowerK b k x d * lowerK b k x p
      + v x * accL b bi k x d * lowerK b k x p + v x * lowerK b k x d * accL b bi k x p) / 2) =
      (dprof v k x * (∑ d, ksInverse bi v k a d x * lowerK b k x d) * lowerK b k x p
        + v x * (∑ d, ksInverse bi v k a d x * accL b bi k x d) * lowerK b k x p
        + v x * (∑ d, ksInverse bi v k a d x * lowerK b k x d) * accL b bi k x p) / 2 := by
    simp only [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_add_distrib, Finset.sum_div]
    exact Finset.sum_congr rfl fun d _ => by ring
  rw [e2, hD.ksInverse_lower hx, hD.inv_accL hx]
