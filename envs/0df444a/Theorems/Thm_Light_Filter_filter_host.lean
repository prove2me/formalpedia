set_option autoImplicit false
set_option relaxedAutoImplicit false

open ThreeSumApsp
open Light
open Light.Filter
open ThreeSumApsp.Spec Light.Sec3
variable {lim : Limits}

theorem Light.Filter.filter_host :
    (∀ (P : Program) (po : ℕ) (To : List ℕ → ℕ) (needo : List ℕ → Light.Need),
      SolvesN oracleTask P po To needo →
      ∃ (R : Program) (p' : ℕ), Solves aeTask (P ++ R) p' (filterTime To) (filterNeed needo)) ∧
    (∀ needo, PolyNeedN needo → PolyNeed (filterNeed needo)) := by sorry
