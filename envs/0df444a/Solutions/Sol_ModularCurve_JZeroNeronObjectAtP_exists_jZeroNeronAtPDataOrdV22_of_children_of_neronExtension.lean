    (RelativeGroupLaw.baseChangePointToBase Λ'.shStr (RelativeGroupLaw.baseChangePointOfBase Λ'.shStr _))
    (RelativeGroupLaw.baseChangePointToBase Λ'.shStr (RelativeGroupLaw.baseChangePointOfBase Λ'.shStr _)))
  rw [RelativeGroupLaw.baseChangePointToBase_ofBase, RelativeGroupLaw.baseChangePointToBase_ofBase]

