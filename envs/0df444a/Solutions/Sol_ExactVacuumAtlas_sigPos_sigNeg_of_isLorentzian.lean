open Matrix
open ExactVacuumAtlas
theorem solution {n : ℕ} {G : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
    (h : IsLorentzian G) : sigPos G.toQuadraticForm' = n ∧ sigNeg G.toQuadraticForm' = 1 := by
  obtain ⟨E, hE, hEG⟩ := h
  letI : Invertible E := Matrix.invertibleOfIsUnitDet E hE
  set e := Matrix.toLinearEquiv' E this
  have hcomp : G.toQuadraticForm'.comp (e : (Fin (n + 1) → ℝ) →ₗ[ℝ] Fin (n + 1) → ℝ) =
      QuadraticMap.weightedSumSquares ℝ (fun i : Fin (n + 1) => if i = 0 then (-1 : ℝ) else 1) := by
    rw [← eta_toQuadraticForm_prime, ← hEG, toQuadraticForm_prime_congr]
    rfl
  have hequiv : QuadraticMap.Equivalent G.toQuadraticForm'
      (QuadraticMap.weightedSumSquares ℝ (fun i : Fin (n + 1) => if i = 0 then (-1 : ℝ) else 1)) := by
    rw [← hcomp]
    exact ⟨QuadraticMap.isometryEquivOfCompLinearEquiv _ e⟩
  refine ⟨?_, ?_⟩
  · rw [QuadraticForm.sigPos_of_equiv_weightedSumSquares hequiv, ncard_pos_weights]
  · rw [QuadraticForm.sigNeg_of_equiv_weightedSumSquares hequiv, ncard_neg_weights]
