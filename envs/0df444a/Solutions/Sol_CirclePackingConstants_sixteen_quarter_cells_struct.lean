open CirclePackingConstants in
theorem solution (p : Fin 4 → Fin 4 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 4 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 4 ∧
      (j.val : ℝ) / 4 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 4)
    (hd : ∀ i j k l, (i, j) ≠ (k, l) → (1 : ℝ) / 9 < sqDist (p i j) (p k l)) : False := by
  rcases hr : CPQ.checkS CPQ.leafOK CPQ.sc16.length (CPQ.ordsOf CPQ.sc16) 1000 (CPQ.unpackAll20 CPQ.structStream) (CPQ.initS CPQ.sc16) with _ | rest
  · have := CPQ.struct_chk; rw [hr] at this; simp at this
  · exact CPQ.struct_main p hc hd _ rest hr
