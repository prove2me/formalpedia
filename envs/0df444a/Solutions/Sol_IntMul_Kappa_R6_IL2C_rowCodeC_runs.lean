theorem rp_row {m F K e T S0 B r G : ℕ} {i j : Fin m} (hp : IL3F.PF m F K e T S0 B r)
    (hij : (i : ℕ) ≠ j) (hK : 6 ≤ K) (hG : 1 ≤ G) (hGK : G < K)
    (hdB : 2 ^ (2 * ((F - 1) * G)) ∣ B) (hdS : 2 ^ ((F - 1) * G) ∣ S0) :
    RP (IL3F.N0R m F K e T B i j) (IL3F.N1R m F K e i j) (IL3F.N2R m F K e i j)
      (IL3F.N3R m F K e S0 i j) K F (e % K) G (pxR i j) (pyR i j) := by
  have hBp : 0 < B := hp.b
  have hS0p : 0 < S0 := hp.s0
  refine ⟨pxR_ne_pyR hij, hK, Nat.mod_lt _ (by omega), hp.f1, hG, hGK, ?_,
    by simp only [IL3F.N1R]; positivity, by simp only [IL3F.N2R]; positivity, ?_⟩
  · obtain ⟨a, ha⟩ := hdB
    have ha0 : 0 < a := by
      rcases Nat.eq_zero_or_pos a with h0 | h0
      · rw [h0, mul_zero] at ha; omega
      · exact h0
    refine ⟨a * 2 ^ (T - IL3F.srw m K e F (s0R i j) - F * K), Nat.mul_pos ha0 (by positivity), ?_⟩
    simp only [IL3F.N0R, Qc]; rw [ha, ← pow_mul, ← pow_add]
    rw [show G * (F - 1) + G * (F - 1) = 2 * ((F - 1) * G) by ring]; ring
  · obtain ⟨b, hb⟩ := hdS
    have hb0 : 0 < b := by
      rcases Nat.eq_zero_or_pos b with h0 | h0
      · rw [h0, mul_zero] at hb; omega
      · exact h0
    refine ⟨2 ^ IL3F.srw m K e F (s2R i j) * b, Nat.mul_pos (by positivity) hb0, ?_⟩
    simp only [IL3F.N3R, Qc]; rw [hb, ← pow_mul, show G * (F - 1) = (F - 1) * G by ring]
    ring

section Run

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ} {m : ℕ}

set_option maxHeartbeats 8000000 in
theorem rowCodeC_runs_sol_aux {Ksw : ℝ} (hKsw : 0 ≤ Ksw) (HSw : SwOK tab l12 τ Ksw) {I : List Sym}
    {F K e T S0 B r H G : ℕ} {i j : Fin m} (hij : (i : ℕ) ≠ j) (hK : 6 ≤ K)
    (hp : IL3F.PF m F K e T S0 B r) (hG : 1 ≤ G) (hGK : G < K)
    (hdB : 2 ^ (2 * ((F - 1) * G)) ∣ B) (hdS : 2 ^ ((F - 1) * G) ∣ S0)
    {u : IState HS} (hAC : Agree (IL3H.rowσC m F K e T S0 B r H G i j) u)
    (zs : List GI) (R0 : List Item) (hg0 : u.G 0 = ints (gflat zs) ++ R0)
    (hl : zs.length = B * 2 ^ T * S0 * r) (hGB : GB H zs) :
    ∃ c, IRuns I tab (rowCodeC l12) u
        (u.upd 0 (ints (gflat (permRecs (rect (IL3F.N0R m F K e T B i j) (IL3F.N1R m F K e i j)
          (IL3F.N2R m F K e i j) (IL3F.N3R m F K e S0 i j) (F * K))
          (rowAddAddr K (e % K) F (pxR i j) (pyR i j)) r zs)) ++ R0)) c ∧
      (c : ℝ) ≤ cL13 Ksw τ (IL3F.N0R m F K e T B i j) (IL3F.N1R m F K e i j)
          (IL3F.N2R m F K e i j) (IL3F.N3R m F K e S0 i j) K F (e % K) G r H (pxR i j) (pyR i j) +
        3 * (cHd (zsz ((VbR T S0 B r H : ℕ) : ℤ)) : ℝ) := by
  set Bb := zsz ((VbR T S0 B r H : ℕ) : ℤ) with hBbd
  have hBb : zsz ((VbR T S0 B r H : ℕ) : ℤ) ≤ Bb := le_rfl
  have hA0 := agree_rowσ hAC
  have hTB := IL3F.TB hp hBb
  have hKT := hp.KT
  have hf1 := hp.f1
  have hm3 : 3 ≤ m := by have := hp.m16; omega
  have hVg := IL3F.VbR_ge (H := H) hp
  have hnV := IL3F.nV (H := H) hp
  have hS0p : 0 < S0 := hp.s0
  have hBp : 0 < B := hp.b
  have hFG : 2 ^ ((F - 1) * G) ≤ S0 := Nat.le_of_dvd hS0p hdS
  have zpow : ∀ x, 2 ^ x ≤ VbR T S0 B r H → x + 1 ≤ Bb := fun x hx => by
    have h1 := IL3F.zVn hBb hx
    have e2 : zsz (((2 ^ x : ℕ)) : ℤ) = x + 1 := by push_cast; exact zsz_two_pow x
    omega
  set V := VbR T S0 B r H with hV
  -- the compact header on the row background
  have eG : ESp (.reg 46) u Bb (G : ℤ) := ESp.ofAgree hAC (by unfold IL3H.rowσC; simp) (by decide)
    (IL3F.zT hp hBb (by omega) (by exact_mod_cast (show G ≤ T by omega)))
  have eF := IL3F.sFp hp hA0 hBb
  have eFm : ESp gFm u Bb (((F - 1 : ℕ)) : ℤ) :=
    ESp.of_eq (ESp.sub eF (ESp.lit (c := 1) (by rw [zsz_one]; omega))
      (IL3F.zT hp hBb (by have := hp.fT; omega) (by have := hp.fT; omega)))
      (by rw [Nat.cast_sub hf1, Nat.cast_one])
  have hNGV : (F - 1) * G ≤ V := le_trans (Nat.lt_two_pow_self).le (hFG.trans hVg.1)
  have eNG : ESp (.mul gFm (.reg 46)) u Bb (((F - 1) * G : ℕ) : ℤ) :=
    ESp.mulN eFm eG (IL3F.zVn hBb hNGV)
  have eQC : ESp (.pow2 (.mul gFm (.reg 46))) u Bb ((2 ^ ((F - 1) * G) : ℕ) : ℤ) :=
    ESp.pow2 eNG (zpow _ (hFG.trans hVg.1))
  have eRR : ESp (.pow2 (.reg 46)) u Bb ((2 ^ G : ℕ) : ℤ) := ESp.pow2 eG (by omega)
  have hi := i.isLt
  have hj := j.isLt
  have h2TS : 2 ^ T * S0 ≤ V := le_trans (by
    rw [mul_assoc B]; exact Nat.le_mul_of_pos_left _ hBp) hnV
  have eSX : ESp (.mul (.pow2 (eSRe (pr 8))) (pr 4)) u Bb
      ((2 ^ IL3F.srw m K e F i * S0 : ℕ) : ℤ) := by
    have h1 := IL3F.srw_top hp hi
    refine ESp.mulN (IL3F.sPow hp hBb (IL3F.sSRe hp hA0 hBb (IL3F.sIp hp hA0 hBb) hi) (by omega))
      (IL3F.sSp hp hA0 hBb) (IL3F.zVn hBb (le_trans ?_ h2TS))
    exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega))
  have eSY : ESp (.mul (.pow2 (eSRe (pr 9))) (pr 4)) u Bb
      ((2 ^ IL3F.srw m K e F j * S0 : ℕ) : ℤ) := by
    have h1 := IL3F.srw_top hp hj
    refine ESp.mulN (IL3F.sPow hp hBb (IL3F.sSRe hp hA0 hBb (IL3F.sJp hp hA0 hBb) hj) (by omega))
      (IL3F.sSp hp hA0 hBb) (IL3F.zVn hBb (le_trans ?_ h2TS))
    exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega))
  have eMM : ESp (.mul (.mul (pr 5) (.pow2 (pr 3))) (pr 4)) u Bb ((B * 2 ^ T * S0 : ℕ) : ℤ) :=
    ESp.mulN (ESp.mulN (IL3F.sBp hp hA0 hBb) (IL3F.sPow hp hBb (IL3F.sTp hp hA0 hBb) le_rfl)
      (IL3F.zVn hBb (le_trans (Nat.le_mul_of_pos_right _ hS0p) hnV)))
      (IL3F.sSp hp hA0 hBb) (IL3F.zVn hBb hnV)
  have hq : e % K + (F - 1) * K ≤ e := by
    have h1 : (F - 1) * K ≤ e := by
      refine le_trans ?_ hp.he'
      rw [mul_comm]
      exact Nat.mul_le_mul_left K (by
        have : F ≤ F * m := Nat.le_mul_of_pos_right _ (by omega)
        omega)
    have h2 : F - 1 ≤ e / K := (Nat.le_div_iff_mul_le (by omega)).2 h1
    have h3 := Nat.mod_add_div e K
    have h4 := Nat.mul_le_mul_right K h2
    rw [mul_comm (e / K) K] at h4
    omega
  have heT := hp.eT
  have eJ2 : ESp (.pow2 (.add eRho (.mul gFm (pr 1)))) u Bb
      ((2 ^ (e % K + (F - 1) * K) : ℕ) : ℤ) := by
    have eFK := ESp.mulN eFm (IL3F.sKp hp hA0 hBb)
      (IL3F.zT hp hBb (by omega) (by exact_mod_cast (show (F - 1) * K ≤ T by omega)))
    have eq' := ESp.add (IL3F.sRho hp hA0 hBb) eFK
      (by rw [← Nat.cast_add]; exact IL3F.zT hp hBb (by omega) (by exact_mod_cast (show _ ≤ T by omega)))
    rw [← Nat.cast_add] at eq'
    exact IL3F.sPow hp hBb eq' (by omega)
  have eFl : ESp (eSub (pr 9) (pr 8)) u Bb (((j : ℕ) : ℤ) - ((i : ℕ) : ℤ)) :=
    ESp.sub (IL3F.sJp hp hA0 hBb) (IL3F.sIp hp hA0 hBb)
      (IL3F.zT hp hBb (by have := hp.mCT; omega) (by have := hp.mCT; omega))
  have hEG : ∀ p ∈ hdrG, ∃ v, ESp p.2 u Bb v := by
    intro p hm
    simp only [hdrG, List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, eRR⟩, ⟨_, eFm⟩, ⟨_, eQC⟩, ⟨_, eSX⟩, ⟨_, eSY⟩, ⟨_, eMM⟩, ⟨_, eJ2⟩, ⟨_, eNG⟩,
      ⟨_, eFl⟩]
  have hOKG : PushOK u Bb hdrG := pushOK_of hdrG_low hdrG_regs hEG
  set u1 := pushSt u (evalP u hdrG) with hu1
  have U1 : ∀ x ex, (x, ex) ∈ hdrG → u1.G x = .int (ex.eval u) :: u.G x := fun x ex hm =>
    pushSt_G_mem u _ (by rw [evalP_fst']; exact hdrG_nodup)
      (by rw [evalP_eq]; exact List.mem_map.2 ⟨(x, ex), hm, rfl⟩)
  have U1' : ∀ x, x ∉ hdrG.map Prod.fst → u1.G x = u.G x := fun x hx =>
    pushSt_G_of_not_mem u x _ (by rwa [evalP_fst'])
  have hA : Agree (IL3F.rowσ m F K e T S0 B r H i j) u1 := agree_of_eq hA0 (fun x v hx =>
    U1' x (notMem_of_ge (rowσ_dom hx).1 hdrG_lt36))
  -- the frozen header, as in `IL3F.rowCodeU_runs`
  have hE : ∀ p ∈ hdrL, ∃ v, ESp p.2 u1 Bb v := by
    intro p hm
    simp only [hdrL, List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, IL3F.xW hp hA hBb⟩, ⟨_, IL3F.xNt hp hA hBb⟩, ⟨_, IL3F.xFa hp hA hBb hij⟩,
      ⟨_, IL3F.xFb hp hA hBb hij⟩, ⟨_, IL3F.xQ hp hA hBb⟩, ⟨_, IL3F.xBp hp hA hBb⟩,
      ⟨_, IL3F.xR2 hp hA hBb⟩, ⟨_, IL3F.xGx hp hA hBb hij⟩, ⟨_, IL3F.xN0 hp hA hBb hij⟩,
      ⟨_, IL3F.xN1 hp hA hBb hij⟩, ⟨_, IL3F.xN2 hp hA hBb hij⟩, ⟨_, IL3F.xN3 hp hA hBb hij⟩,
      ⟨_, IL3F.xK2 hp hA hBb⟩]
  have hOK1 : PushOK u1 Bb hdrL := pushOK_of hdrL_low hdrL_regs hE
  set t1 := pushSt u1 (evalP u1 hdrL) with ht1
  have T1 : ∀ x ex, (x, ex) ∈ hdrL → t1.G x = .int (ex.eval u1) :: u1.G x := fun x ex hm =>
    pushSt_G_mem u1 _ (by rw [evalP_fst']; exact hdrL_nodup)
      (by rw [evalP_eq]; exact List.mem_map.2 ⟨(x, ex), hm, rfl⟩)
  have T1' : ∀ x, x ∉ hdrL.map Prod.fst → t1.G x = u1.G x := fun x hx =>
    pushSt_G_of_not_mem u1 x _ (by rwa [evalP_fst'])
  set N0 := IL3F.N0R m F K e T B i j with hN0
  set N1 := IL3F.N1R m F K e i j with hN1
  set N2 := IL3F.N2R m F K e i j with hN2
  set N3 := IL3F.N3R m F K e S0 i j with hN3
  have hvol := IL3F.vol_rowRect hij hp
  have gNt := T1 mNt eNtp (by simp [hdrL])
  rw [(IL3F.xNt hp hA hBb).ev] at gNt
  have gW := T1 mW (pr 7) (by simp [hdrL])
  rw [(IL3F.xW hp hA hBb).ev] at gW
  have hNtV : 2 * (B * 2 ^ T * S0 * r) ≤ V := by
    rw [hV]; unfold VbR
    calc 2 * (B * 2 ^ T * S0 * r) = 2 * (B * 2 ^ T * S0) * r * 1 := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ (by omega)
  have eVv : ESp eVx t1 Bb ((V : ℕ) : ℤ) := by
    have a := ESp.ofG gNt (by decide) (IL3F.zVn hBb hNtV)
    have b := ESp.ofG gW (by decide) (IL3F.zVn hBb (by have := hVg.2.2.2.1; omega))
    have c := ESp.add b (ESp.lit (c := 1) (by rw [zsz_one]; omega))
      (by have := IL3F.zVn hBb (show H + 1 ≤ V from hVg.2.2.2.1); push_cast at this; exact this)
    exact ESp.of_eq (ESp.mul a c (by
      have : ((2 * (B * 2 ^ T * S0 * r) : ℕ) : ℤ) * ((H : ℤ) + 1) = ((V : ℕ) : ℤ) := by
        rw [hV]; unfold VbR; push_cast; ring
      rw [this])) (by rw [hV]; unfold VbR; push_cast; ring)
  have hE2 : ∀ p ∈ zL, ∃ v, ESp p.2 t1 Bb v := by
    intro p hm
    simp only [zL, List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl
    exacts [⟨_, ESp.lit (by rw [zsz_zero]; omega)⟩, ⟨_, eVv⟩]
  have S2 := (Sp.pushes Bb zL t1 (pushOK_of (by decide) zL_regs hE2)).toIRuns
    (I := I) (iprog := tab)
  have e2 : pushSt t1 (zL.map fun p => (p.1, p.2.eval t1)) = ssZ t1 V 0 := by
    simp only [zL, List.map_cons, List.map_nil, pushSt, eVv.ev, Ex.eval]
    apply IState.ext' <;> intros <;> simp [ssZ, IState.upd_G, mA_ne_rX, Ne.symm mA_ne_rX]
  rw [e2] at S2
  have hV2 : 2 ≤ Bb := by have := hp.mCT; have := hp.m16; omega
  have S3 := loopZ_runs (I := I) (iprog := tab) t1 V Bb le_rfl hV2
  set M := zsz ((V : ℕ) : ℤ) with hMd
  set t3 := ssZ t1 V M with ht3
  have t3G : ∀ x, x ≠ mA → x ≠ KFX.rX → t3.G x = t1.G x := fun x h1 h2 => by
    simp [t3, ssZ, h1, h2]
  -- the register facts at `t3`
  have gL3 : ∀ x ex v, (x, ex) ∈ hdrL → x ≠ mA → x ≠ KFX.rX → ESp ex u1 Bb v →
      t3.G x = .int v :: u1.G x := fun x ex v hm h1 h2 hs => by
    rw [t3G x h1 h2, T1 x ex hm, hs.ev]
  have gG3 : ∀ x ex v, (x, ex) ∈ hdrG → x ∉ hdrL.map Prod.fst → x ≠ mA → x ≠ KFX.rX →
      ESp ex u Bb v → t3.G x = .int v :: u.G x := fun x ex v hm h0 h1 h2 hs => by
    rw [t3G x h1 h2, T1' x h0, U1 x ex hm, hs.ev]
  have q3 := gL3 mQ eQp _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xQ hp hA hBb)
  have n13 := gL3 mN1 eN1 _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xN1 hp hA hBb hij)
  have n23 := gL3 mN2 eN2 _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xN2 hp hA hBb hij)
  have n33 := gL3 mN3 eN3 _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xN3 hp hA hBb hij)
  have k23 := gL3 mK2 eK2p _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xK2 hp hA hBb)
  have r23 := gL3 mR2 eR2p _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xR2 hp hA hBb)
  have b3 := gL3 mB NLogN.KFX.eBp _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xBp hp hA hBb)
  have nt3 := gL3 mNt eNtp _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xNt hp hA hBb)
  have w3 := gL3 mW (pr 7) _ (by simp [hdrL]) (by decide) (by decide) (IL3F.xW hp hA hBb)
  have rr3 := gG3 kRR _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eRR
  have nn3 := gG3 kN _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eFm
  have qc3 := gG3 kQC _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eQC
  have sx3 := gG3 kSX _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eSX
  have sy3 := gG3 kSY _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eSY
  have m3 := gG3 kM _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eMM
  have j23 := gG3 kJ2 _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eJ2
  have ng3 := gG3 kNG _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eNG
  have fl3 := gG3 kF _ _ (by simp [hdrG]) (by decide) (by decide) (by decide) eFl
  have a3 : t3.G mA = .int (M : ℤ) :: t1.G mA := ssZ_G_mA t1 V M
  -- the geometry
  have N1p : 0 < N1 := by simp only [N1, IL3F.N1R]; positivity
  have N2p : 0 < N2 := by simp only [N2, IL3F.N2R]; positivity
  have N3p : 0 < N3 := by simp only [N3, IL3F.N3R]; exact Nat.mul_pos (by positivity) hS0p
  have hRP : RP N0 N1 N2 N3 K F (e % K) G (pxR i j) (pyR i j) := rp_row hp hij hK hG hGK hdB hdS
  have hok := hRP.ok
  set l := layR N0 N1 N2 N3 (F * K) G (F - 1) (pxR i j) (pyR i j) with hl'
  have hlM : l.M = B * 2 ^ T * S0 := by
    rw [← hvol]; exact (vol_rect (R := r) (w := H)).symm
  have hsU : l.sU = 2 ^ (F * K) * 2 ^ (F * K) * (2 ^ (F * K) * N1 * (N2 * N3)) := by
    simp only [l, layR, IL2C.gR, Geo.S0, Geo.S1, Geo.S2]; ring
  have hUM : l.QC * l.sU ≤ l.M := by
    obtain ⟨kM, hkM, eM⟩ := hok.kMT
    obtain ⟨a, ha, eA⟩ := hok.kTU
    have hqc : 0 < l.QC := hok.qc
    rw [eM, eA]
    calc l.QC * l.sU = l.QC * l.sU * 1 := by ring
      _ ≤ l.QC * l.sU * (l.QC * a * kM) := Nat.mul_le_mul_left _ (Nat.mul_pos (Nat.mul_pos hqc ha) hkM)
      _ = _ := by ring
  have hUV : l.QC * l.sU ≤ V := le_trans hUM (by rw [hlM]; exact hnV)
  have hsUV : l.sU ≤ V := le_trans (Nat.le_mul_of_pos_left _ hok.qc) hUV
  -- the compact header after the masters
  have hqp : 0 < 2 ^ (F * K) := by positivity
  set q := 2 ^ (F * K) with hqd
  have hPp : 0 < q * q * (q * N1 * (N2 * N3)) := hsU ▸ hok.pU
  have dvl : ∀ {x : ℕ}, x ∣ q * q * (q * N1 * (N2 * N3)) → x ≤ V := fun h =>
    le_trans (Nat.le_of_dvd hPp h) (hsU ▸ hsUV)
  have eQ3 : ESp (.reg mQ) t3 Bb ((q : ℕ) : ℤ) := ESp.ofG q3 (by decide)
    (IL3F.zVn hBb (dvl ⟨q * (q * N1 * (N2 * N3)), by ring⟩))
  have eN13 : ESp (.reg mN1) t3 Bb ((N1 : ℕ) : ℤ) := ESp.ofG n13 (by decide)
    (IL3F.zVn hBb (dvl ⟨q * q * q * (N2 * N3), by ring⟩))
  have eN23 : ESp (.reg mN2) t3 Bb ((N2 : ℕ) : ℤ) := ESp.ofG n23 (by decide)
    (IL3F.zVn hBb (dvl ⟨q * q * q * N1 * N3, by ring⟩))
  have eN33 : ESp (.reg mN3) t3 Bb ((N3 : ℕ) : ℤ) := ESp.ofG n33 (by decide)
    (IL3F.zVn hBb (dvl ⟨q * q * q * N1 * N2, by ring⟩))
  have eQQ := ESp.mulN eQ3 eQ3 (IL3F.zVn hBb (dvl ⟨q * N1 * (N2 * N3), by ring⟩))
  have eQN1 := ESp.mulN eQ3 eN13 (IL3F.zVn hBb (dvl ⟨q * q * (N2 * N3), by ring⟩))
  have eN23' := ESp.mulN eN23 eN33 (IL3F.zVn hBb (dvl ⟨q * q * (q * N1), by ring⟩))
  have eR := ESp.mulN eQN1 eN23' (IL3F.zVn hBb (dvl ⟨q * q, by ring⟩))
  have eSU3 : ESp eSU t3 Bb ((l.sU : ℕ) : ℤ) := by
