-- Source module: NLogN.ILang
/-!
# The item language

Programs over `S` stacks of items (integers and marks), compiled to stack programs over `S + 4`
stacks (the last four are scratch).  `compile_correct` turns item-level executions into
`Runs` of the compiled program, with the same cost.
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

structure IState (S : ℕ) where
  G : Fin S → List Item
  ip : ℕ
  out : List Bool

def IState.upd (s : IState S) (i : Fin S) (L : List Item) : IState S :=
  { s with G := Function.update s.G i L }

@[simp] theorem IState.upd_G (s : IState S) (i : Fin S) (L : List Item) (j : Fin S) :
    (s.upd i L).G j = if j = i then L else s.G j := by
  simp [IState.upd, Function.update_apply]

@[simp] theorem IState.upd_ip (s : IState S) (i : Fin S) (L : List Item) : (s.upd i L).ip = s.ip :=
  rfl
@[simp] theorem IState.upd_out (s : IState S) (i : Fin S) (L : List Item) :
    (s.upd i L).out = s.out := rfl

/-! ## Stacks of the compiled program -/

def ι (i : Fin S) : Fin (S + 4) := Fin.castAdd 4 i
def sq (S : ℕ) : Fin (S + 4) := ⟨S, by omega⟩
def s1 (S : ℕ) : Fin (S + 4) := ⟨S + 1, by omega⟩
def s2 (S : ℕ) : Fin (S + 4) := ⟨S + 2, by omega⟩
def s3 (S : ℕ) : Fin (S + 4) := ⟨S + 3, by omega⟩

/-- The machine state of an item state: scratch stacks empty. -/
def encI (s : IState S) : St (S + 4) :=
  ⟨fun x => if h : x.val < S then NLogN.encL (s.G ⟨x.val, h⟩) else [], s.ip, s.out⟩

@[simp] theorem enc_ip (s : IState S) : (encI s).ip = s.ip := rfl
@[simp] theorem enc_out (s : IState S) : (encI s).out = s.out := rfl

@[simp] theorem bitOf_none' : bitOf none = none := rfl

/-! ## Operations -/

inductive IOp (S : ℕ) where
  | add (i j k : Fin S)
  | neg (i : Fin S)
  | dup (i j : Fin S)
  | drop (i : Fin S)
  | mv (i j : Fin S)
  | const (i : Fin S) (c : ℤ)
  | mark (i : Fin S)
  | unmark (i : Fin S)
  | shl (i j : Fin S)
  | split (i j k : Fin S)
  | read (i j : Fin S) (stop : Sym)
  | write (i j : Fin S)
  | cat (i j k : Fin S)

def IOp.stmt : IOp S → Stmt (S + 4) P
  | .add i j k => addInt (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)
  | .neg i => negInt (ι i)
  | .dup i j => dupInt (sq S) (ι i) (ι j) (s1 S) (s2 S)
  | .drop i => popInt (ι i)
  | .mv i j => moveInt (sq S) (ι i) (ι j) (s1 S)
  | .const i c => constI (ι i) c
  | .mark i => .push (ι i) hdMark
  | .unmark i => .pop (ι i)
  | .shl i j => shlR (sq S) (ι i) (ι j) (s1 S) (s2 S)
  | .split i j k => splitR (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)
  | .read i j stop => readR (sq S) (ι i) (ι j) (s1 S) (s2 S) (s3 S) stop
  | .write i j => outR (sq S) (ι i) (ι j) (s1 S)
  | .cat i j k => catR (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)

/-- Item-level semantics of the operations, with costs. -/
inductive IOp.Step (I : List Sym) : IOp S → IState S → IState S → ℕ → Prop
  | add {s : IState S} {i j k : Fin S} {a b : ℤ} {Li Lj : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: Li) (hj : s.G j = .int b :: Lj) :
      Step I (.add i j k) s
        (((s.upd i Li).upd j Lj).upd k (.int (a + b) :: ((s.upd i Li).upd j Lj).G k))
        (addIntCost (zsz a + zsz b))
  | neg {s : IState S} {i : Fin S} {a : ℤ} {L : List Item} (hi : s.G i = .int a :: L) :
      Step I (.neg i) s (s.upd i (.int (-a) :: L)) 20
  | dup {s : IState S} {i j : Fin S} {a : ℤ} {L : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: L) :
      Step I (.dup i j) s (s.upd j (.int a :: s.G j)) (dupCost (zsz a) + 17)
  | drop {s : IState S} {i : Fin S} {a : ℤ} {L : List Item} (hi : s.G i = .int a :: L) :
      Step I (.drop i) s (s.upd i L) (2 * zsz a + 2)
  | mv {s : IState S} {i j : Fin S} {a : ℤ} {L : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: L) :
      Step I (.mv i j) s ((s.upd i L).upd j (.int a :: s.G j)) (2 * moveCost (zsz a) + 19)
  | const {s : IState S} {i : Fin S} (c : ℤ) :
      Step I (.const i c) s (s.upd i (.int c :: s.G i)) (zsz c + 2)
  | mark {s : IState S} {i : Fin S} : Step I (.mark i) s (s.upd i (.mark :: s.G i)) 1
  | unmark {s : IState S} {i : Fin S} {L : List Item} (hi : s.G i = .mark :: L) :
      Step I (.unmark i) s (s.upd i L) 1
  | shl {s : IState S} {i j : Fin S} {a : ℤ} {m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.shl i j) s (s.upd i (.int (a * 2 ^ m) :: Li)) (shlCost m)
  | split {s : IState S} {i j k : Fin S} {a : ℤ} {m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hik : i ≠ k) (hjk : j ≠ k) (hi : s.G i = .int a :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.split i j k) s
        ((s.upd i (.int (sg a (a.natAbs / 2 ^ m)) :: Li)).upd k
          (.int (sg a (a.natAbs % 2 ^ m)) :: s.G k)) (splitCost m + 17)
  | read {s : IState S} {i j : Fin S} {stop : Sym} (W : List Bool) (hij : i ≠ j) (hs0 : stop ≠ 0)
      (hs1 : stop ≠ 1) (hk : ∀ k (hk : k < W.length), I.getD (s.ip + k) codeEnd = codeBit W[k])
      (hstop : I.getD (s.ip + W.length) codeEnd = stop) :
      Step I (.read i j stop) s
        { (s.upd i (.int (val W : ℤ) :: s.G i)).upd j
            (.int (2 ^ W.length) :: (s.upd i (.int (val W : ℤ) :: s.G i)).G j) with
          ip := s.ip + W.length + 1 }
        (readRCost W.length)
  | write {s : IState S} {i j : Fin S} {n m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hn : n < 2 ^ m) (hi : s.G i = .int (n : ℤ) :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.write i j) s { (s.upd i Li).upd j Lj with out := s.out ++ bin m n } (outRCost m)
  | cat {s : IState S} {i j k : Fin S} {a : ℤ} {b m : ℕ} {Li Lj Lk : List Item} (hij : i ≠ j)
      (hik : i ≠ k) (hjk : j ≠ k) (ha : a ≠ 0) (hb : b < 2 ^ m) (hi : s.G i = .int a :: Li)
      (hj : s.G j = .int (2 ^ m) :: Lj) (hk : s.G k = .int (b : ℤ) :: Lk) :
      Step I (.cat i j k) s ((s.upd i (.int (sg a (a.natAbs * 2 ^ m + b)) :: Li)).upd k Lk)
        (catCost m)

variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

end NLogN

end

