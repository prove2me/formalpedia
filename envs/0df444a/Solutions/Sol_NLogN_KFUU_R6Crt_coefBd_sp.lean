-- Source module: Solutions.KIL6Loop
/-!
# KIL6: counted loops whose body is item-language code (with procedure calls)

`irep C n body` is the item-language counterpart of `RS.rep C n b` for an arbitrary
`IStmt` body (which may contain `.call`s): push the count `n` on the counter stack `C`, run
`body; C := C - 1` while the top of `C` is nonzero, pop `C`.  `IRuns.irep` is the analogue of
`Sp.rep` on managed states.

Also: `Sp.asgQ` (assignment of a general expression, quadratic cost) and the conversion of a
stack-`0` specification on `t.upd 0 …` states to managed states (`Sp.top0`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

/-- An assignment of an arbitrary expression on a managed state (quadratic cost). -/
theorem Sp.asgQ (s : IState HS) (f : Fin HS → List ℤ) {i : Fin HS} {e : Ex HS} {a : ℤ}
    {l : List ℤ} {B : ℕ} (hi : i.val < 56) (hf : f i = a :: l) (ha : zsz a ≤ B) (hc : e.Clean)
    (hok : e.ok (encK s f)) (hB : e.Bnd (encK s f) B) :
    Sp (.asg i e) (encK s f) (encK s (Function.update f i (e.eval (encK s f) :: l)))
      ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  refine ⟨⟨hi, hc, hok, isInt_encK hf⟩, ?_, ?_⟩
  · simp only [RS.run]
    rw [← encK_upd]; simp [hf, ints]
  · exact asgCost_le i e _ B hB (by rw [top_encK hf]; exact ha)

end NLogN.KIL

end

