variable {k : Type} [Field k] [IsAlgClosed k] {n : ℕ}

theorem GlobalTheory.CharpolyPow.det_aeval_prod (M : Matrix (Fin n) (Fin n) k) (s : Multiset k) :
    (aeval M (s.map (fun a => C a - X)).prod).det
      = (M.charpoly.roots.map (fun z => eval z (s.map (fun a => C a - X)).prod)).prod := by sorry
