/-! ## Splitting a tensor power -/

section Split

variable {ι κ₁ κ₂ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ₁] [DecidableEq κ₁]
  [Fintype κ₂] [DecidableEq κ₂]

/-- **`tens A` on two complementary subfamilies.** -/
theorem tens_split {g₁ : κ₁ → ι} {g₂ : κ₂ → ι} (h₁ : Function.Injective g₁)
    (h₂ : Function.Injective g₂) (hcov : ∀ i, (∃ k, g₁ k = i) ∨ (∃ k, g₂ k = i))
    (hdis : ∀ k₁ k₂, g₁ k₁ ≠ g₂ k₂) (A : Butterfly.M2) :
    subOp g₂ (Butterfly.tens A : Matrix (κ₂ → Fin 2) (κ₂ → Fin 2) ℂ) *
      subOp g₁ (Butterfly.tens A : Matrix (κ₁ → Fin 2) (κ₁ → Fin 2) ℂ) =
      (Butterfly.tens A : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) := by
  rw [subOp_tens h₂, subOp_tens h₁, ← tensF_mul]
  unfold Butterfly.tens
  congr 1
  funext i
  rcases hcov i with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · have hn : ¬ ∃ k', g₂ k' = g₁ k := fun ⟨k', hk'⟩ => hdis k k' hk'.symm
    rw [if_neg hn, if_pos ⟨k, rfl⟩, one_mul]
  · have hn : ¬ ∃ k', g₁ k' = g₂ k := fun ⟨k', hk'⟩ => hdis k' k hk'
    rw [if_pos ⟨k, rfl⟩, if_neg hn, mul_one]

end Split

/-! ## The node and chain subfamilies -/

theorem gC0_inj {E : ℕ} (hE : 1 ≤ E) : Function.Injective (gC0 hE) := by
  intro i j _
  exact Subsingleton.elim (α := Fin 1) i j

theorem gC1_inj {E : ℕ} (hE : 1 ≤ E) : Function.Injective (gC1 hE) := by
  intro i j h
  simp only [gC1, Fin.mk.injEq] at h
  exact Fin.ext (by omega)

/-- **The chain split** of `tens A` on `E ≥ 1` bits. -/
theorem tens_chain {E : ℕ} (hE : 1 ≤ E) (A : Butterfly.M2) :
    subOp (gC1 hE) (Butterfly.tens A : Matrix (Fin (E - 1) → Fin 2) (Fin (E - 1) → Fin 2) ℂ) *
      subOp (gC0 hE) (Butterfly.tens A : Matrix (Fin (mC ^ 0) → Fin 2) (Fin (mC ^ 0) → Fin 2) ℂ) =
      (Butterfly.tens A : Matrix (Fin E → Fin 2) (Fin E → Fin 2) ℂ) := by
  refine tens_split (gC0_inj hE) (gC1_inj hE) (fun i => ?_) (fun p j => ?_) A
  · by_cases hi : i.val = 0
    · left; exact ⟨⟨0, by simp⟩, Fin.ext (by simp [gC0, hi])⟩
    · right; exact ⟨⟨i.val - 1, by omega⟩, Fin.ext (by simp only [gC1]; omega)⟩
  · intro h
    have := congrArg Fin.val h
    simp only [gC0, gC1] at this
    omega

/-! ## Strides -/

theorem st_gC0 {K e E S0 : ℕ} (hE : 1 ≤ E) :
    (fun i : Fin E => 2 ^ (e - K * i.val) * S0) ∘ gC0 hE =
      fun i : Fin (mC ^ 0) => 2 ^ (e - K * i.val) * S0 := by
  funext i
  have : i.val = 0 := by have h : i.val < mC ^ 0 := i.isLt; simp only [pow_zero] at h; omega
  simp only [Function.comp, gC0, this]

theorem st_gC1 {K e E S0 : ℕ} (hE : 1 ≤ E) :
    (fun i : Fin E => 2 ^ (e - K * i.val) * S0) ∘ gC1 hE =
      fun j : Fin (E - 1) => 2 ^ ((e - K) - K * j.val) * S0 := by
  funext j; simp only [Function.comp, gC1, mul_add, mul_one, Nat.sub_sub, add_comm K]

