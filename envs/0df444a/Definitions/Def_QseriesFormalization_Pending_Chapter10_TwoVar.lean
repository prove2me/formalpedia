          simpa [expQXY] using h2
    refine hrange.mono (Set.iUnion_subset (fun p => ?_))
    intro g hg
    refine ⟨p, ?_⟩
    have hgeq : g = expQXY (p.1 ^ 2 + p.2 ^ 2) 0 p.2 := HahnSeries.support_single_subset hg
    rw [hgeq]
