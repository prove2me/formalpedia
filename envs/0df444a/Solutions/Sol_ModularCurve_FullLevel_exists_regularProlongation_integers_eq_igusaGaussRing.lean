  obtain ⟨OIg', R, hR, hinf', -, -, -, -⟩ := exists_igusaValuationSubrings q hq M' hqM' A hA ζ
  refine ⟨R, ?_⟩
  rw [hR]
  ext f
  rw [hinf', hIg_inf]

