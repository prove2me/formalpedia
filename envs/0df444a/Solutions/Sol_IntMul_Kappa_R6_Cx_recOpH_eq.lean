/-!
# §5.1 Phase-frame identities and tensor products on selected bits

The `2 × 2` matrices of §5.1 of the OpenAI preprint "Integer multiplication below n log n":
`H0 = ½[[1,1],[1,-1]]`, `S = diag(1,i)`, `Z = diag(1,-1)`, `X = [[0,1],[1,0]]`,
`C = HSH = aI + bX` with `a = (1+i)/2`, `b = (1-i)/2`, and the identities (13), (14), (17), (18).

Tensor products over an arbitrary finite set `ι` of selected bits:
`tensF A x y = ∏ i, A i (x i) (y i)` for a family `A : ι → M₂`.
-/

namespace Butterfly

open Matrix Complex Finset

/-! ## Tensor products on selected bits -/

section Tensor

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Tensor product of a pointwise product of a list of families = product of the tensors.
Used for slots, pieces and individual kernels: disjoint blocks commute and multiply. -/
theorem tensF_list_prod (Ls : List (ι → M2)) :
    tensF (fun i => (Ls.map (fun A => A i)).prod) = (Ls.map tensF).prod := by
  induction Ls with
  | nil => simpa using tensF_one
  | cons A Ls ih =>
    simp only [List.map_cons, List.prod_cons]
    rw [tensF_mul A (fun i => (Ls.map (fun A => A i)).prod), ih]

end Tensor

