theorem isBoundedUnder_nhdsNE_smul_iff (g : GL (Fin 2) ℝ) (τ : UpperHalfPlane) (f : UpperHalfPlane → ℝ) :
    Filter.IsBoundedUnder (· ≤ ·) (𝓝[≠] (g • τ)) f ↔
      Filter.IsBoundedUnder (· ≤ ·) (𝓝[≠] τ) (fun z => f (g • z)) := by
  rw [show g • τ = Homeomorph.smul g τ from rfl, ← (Homeomorph.smul g).map_punctured_nhds_eq τ]
  unfold Filter.IsBoundedUnder
  rw [Filter.map_map]
  rfl

