-- title:
--   Multi-resource input ABI, sparse table snapshot and charged queries
-- statement:
--   The published primitive exact real-RAM machine is reused without extending its instruction set. Its natural input cells contain $n,m,s,k$ followed by edge endpoint pairs; real cells contain $\varepsilon$, the $k-1$ budgets, and $k$ resource values per edge, objective first. The output snapshot contains header parameters, retained coordinate identities, sparse target records, actual computed table values, tick/predecessor labels, extraction ranks, selected-edge generating functions and ordinary-branch parents. Table cells store $1-T(v,i)$ so untouched zero memory can represent missing isolated states.
--
--   The asserted work scales are
--   $$
--   F_k(I,\varepsilon)=\frac{\max(1,m)(1+\log\max(2,n))(1+\log(\max(2,n)W))}{\varepsilon^{4k+1}},
--   \qquad
--   Q_k(\varepsilon,P)=(q+1)^k(|P|+1).
--   $$
--   A query shares the preprocessing snapshot without copying, receives target $t$ in natural register zero, and writes its path vertices to natural memory. Its output has a presence flag, vertex count and base address. An absent path has zero vertex count for the work bound. The snapshot predicate specifies exact encoding of computed objects; it contains no successful-execution, approximation or time assumption.
--
--   **Formalization Note** Every real constant, copy, field operation, comparison and exp instruction costs one. Natural constants, copies, addition, truncated subtraction and comparisons each cost one, as do jumps and halt. Each indirect memory load/store and input-cell read costs one; operand register access is included in an arithmetic instruction. There is no floor, real-to-integer conversion, logarithm, heap, Poisson, table or shortest-path primitive. Coefficient generation, counted loop bounds, heap work, coordinate scans, address computation and path writing must all execute these instructions. Probabilities may be generated by $p_0=e^{-\mu}$, $p_{h+1}=p_h\mu/(h+1)$ with charged real arithmetic and counters.
-- source:
--   Vikrant Ashvinkumar, STOC 2027 submission #289 (October 2026), p.3 real-RAM and compact representation convention; Sections 4–6 pp.6–12; Appendix B p.14

import Definitions.Def_NearLinearRSP_TwoResources_Supplement_Outer
import Definitions.Def_NearLinearRSP_TwoResources_Machine

set_option autoImplicit false

namespace NearLinearRSP.TwoResources.Supplement

/-- Natural input: n,m,s,k followed by edge endpoint pairs. Real input: epsilon,
k-1 budgets, followed by k resource values per edge (objective first). -/
noncomputable def multiInput {k : ℕ} (I : MultiInstance k) (ε : ℝ) : RAMInput where
  naturals a := if a = 0 then I.graph.n else if a = 1 then I.graph.edges.length else
    if a = 2 then I.source else if a = 3 then k else
      let e := I.graph.edges[(a - 4) / 2]?.getD (0, 0)
      if (a - 4) % 2 = 0 then e.1 else e.2
  reals a := if ha : a = 0 then ε else
    if h : a < k then I.budget ⟨a - 1, by omega⟩ else
      match I.graph.edges[(a - k) / k]? with
      | none => 0
      | some e =>
        if h : (a - k) % k < k then coordinateWeight I ⟨(a - k) % k, h⟩ e.1 e.2 else 0

/-- Shared snapshot, without copying. Query target is in natural register 0. -/
noncomputable def multiQueryStart (S : RAMState) (t : ℕ) : RAMState :=
  ⟨0, false, Function.update (fun _ => 0) 0 t, fun _ => 0, S.nm, S.rm⟩

def targetSlot (k t : ℕ) : ℕ := 32 + 2 * k + 4 * t
noncomputable def multiQ (k : ℕ) (ε : ℝ) : ℕ := ticks k (ε / 4)

def vectorIndex {d : ℕ} (q : ℕ) (i : Fin d → ℕ) : ℕ :=
  ∑ r, i r * q ^ (d - 1 - r.val)

noncomputable def callBase {k : ℕ} (I : MultiInstance k) (ε : ℝ) (r : ℕ) : ℕ :=
  32 + 2 * k + 8 * I.graph.n +
    r * (4 + ((clockCoordinates I).length + 4) * I.graph.n *
      multiQ k ε ^ (clockCoordinates I).length)

noncomputable def cellSlot {k : ℕ} (I : MultiInstance k) (ε : ℝ) (r v : ℕ)
    (i : Fin (clockCoordinates I).length → ℕ) : ℕ :=
  callBase I ε r + 4 + ((clockCoordinates I).length + 4) *
    (vectorIndex (multiQ k ε) i * I.graph.n + v)

def multiParentTag : MultiParent → ℕ
  | .none => 0
  | .tick _ => 1
  | .edge _ => 2

def multiParentPayload : MultiParent → ℕ
  | .none => 0
  | .tick r => r
  | .edge u => u

def outputTag : OutputBranch → ℕ
  | .absent => 0
  | .source => 1
  | .ordinary => 2
  | .table _ => 3

/-- Sparse image of the actual construction. No path guarantee, success, or work
bound occurs in this encoding predicate. Missing isolated targets keep zero flags. -/
noncomputable def EncodesMultiOutput {k : ℕ} (I : MultiInstance k) (ε : ℝ)
    (S : RAMState) : Prop :=
  S.nm 0 = multiQ k ε ∧ S.nm 1 = I.source ∧ S.nm 2 = I.graph.n ∧ S.nm 3 = k ∧
  S.nm 4 = (clockCoordinates I).length ∧ S.nm 5 = (outerCalls I ε).length ∧
  S.rm 0 = (1 + ε / 8) / (1 + ε / 4) ∧ S.rm 1 = 1 / (8 * (k : ℝ)) ∧
  (∀ r : Fin (clockCoordinates I).length, S.nm (8 + r.val) = ((clockCoordinates I).get r).val) ∧
  (∀ t < I.graph.n,
    S.nm (targetSlot k t) = outputTag (selectedBranch I ε t) ∧
    (∀ d, selectedDistance I ε t = some d → S.rm (targetSlot k t) = d) ∧
    (∀ r, selectedBranch I ε t = .table r →
      S.nm (targetSlot k t + 1) = callBase I ε r)) ∧
  (hasPositiveBudget I = false → ∀ v ∈ incidentVertices I,
    S.nm (targetSlot k v + 2) = (((shortestTree I v).parent.map (· + 1)).getD 0)) ∧
  (∀ r A, (outerCalls I ε)[r]? = some A →
    S.rm (callBase I ε r) = A.L ∧ S.nm (callBase I ε r) = (if A.zeroOnly then 1 else 0) ∧
    ∀ v ∈ incidentVertices I, ∀ i : Fin A.d → ℕ, (∀ j, i j < A.q) →
      let addr := callBase I ε r + 4 + (A.d + 4) * (vectorIndex A.q i * I.graph.n + v)
      let c := constructTable A v i
      S.rm addr = 1 - c.value ∧ S.nm addr = multiParentTag c.parent ∧
      S.nm (addr + 1) = multiParentPayload c.parent ∧ S.nm (addr + 2) = c.rank ∧
      (∀ u, c.parent = .edge u → ∀ j : Fin A.d, S.rm (addr + 4 + j.val) = clockPGF A j u v))

noncomputable def multiDistance (S : RAMState) (t : ℕ) : Option ℝ :=
  if S.nm (targetSlot (S.nm 3) t) = 0 then none else some (S.rm (targetSlot (S.nm 3) t))

/-- Query flag in nr[1], vertex count in nr[2], output base in nr[3].
Path vertices must actually be written by charged store instructions. -/
def multiQueryPath (S : RAMState) : Option (List ℕ) :=
  if S.nr 1 = 0 then none else
    some ((List.range (S.nr 2)).map (fun j => S.nm (S.nr 3 + j)))

noncomputable def multiRetrievalScale (k : ℕ) (ε : ℝ) (P : Option (List ℕ)) : ℝ :=
  ((multiQ k ε + 1 : ℕ) : ℝ) ^ k * ((P.getD []).length + 1 : ℕ)

end NearLinearRSP.TwoResources.Supplement


