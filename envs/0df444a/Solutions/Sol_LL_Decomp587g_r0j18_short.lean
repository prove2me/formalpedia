  unfold checkW at hW; obtain ⟨hWlen, hWspec⟩ := checkWGo_spec hW
  unfold checkH at hH; obtain ⟨hHlen, hHspec⟩ := checkHGo_spec hH
  have hSspec := checkSlices_spec hS
  set d := nSlices - 1 - p
  have hd_lt : d < nSlices := by omega
  have hdot_le : dotList W_cert (H_cert.drop (d * mult)) 0 ≤ TARGET_S2 := hSspec d hd_lt
  have hW_cont : ContinuousOn W_real (Icc (2 * aR) (2 * bR)) := by
    have hun : Icc (2 * aR) (2 * bR) = Icc (2 * aR) (aR + bR) ∪ Icc (aR + bR) (2 * bR) := by
      have hab : aR ≤ bR := by unfold aR bR; norm_num
