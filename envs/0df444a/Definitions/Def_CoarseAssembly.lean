abbrev Module (X H : Type*) [NormedAddCommGroup H] := lp (fun _ : X => H) 2

abbrev Operator (X H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  Module X H →L[ℂ] Module X H

def insert (x : X) : H →L[ℂ] Module X H :=
  lp.singleContinuousLinearMap ℂ (fun _ : X => H) 2 x

def coordinate (x : X) : Module X H →L[ℂ] H :=
  lp.evalCLM ℂ (fun _ : X => H) 2 x

def entry (T : Operator X H) (x y : X) : H →L[ℂ] H :=
  coordinate x ∘L T ∘L insert y

def CompactEntries (T : Operator X H) : Prop :=
  ∀ x y, IsCompactOperator (entry T x y)

variable [CompleteSpace H] [PseudoMetricSpace X]

local instance operatorScalarTower : IsScalarTower ℂ (Operator X H) (Operator X H) where
  smul_assoc c T S := by ext h; simp

local instance operatorScalarComm : SMulCommClass ℂ (Operator X H) (Operator X H) where
  smul_comm c T S := by ext h; simp

def PropagationLE (r : ℝ) (T : Operator X H) : Prop :=
  ∀ x y, r < dist x y → entry T x y = 0

def Generator (T : Operator X H) : Prop :=
  (∃ r : ℝ, 0 ≤ r ∧ PropagationLE r T) ∧ CompactEntries T ∧ CompactEntries (star T)

def algebra : NonUnitalStarSubalgebra ℂ (Operator X H) :=
  (NonUnitalStarAlgebra.adjoin ℂ {T : Operator X H | Generator T}).topologicalClosure

