  obtain ⟨hS, hinv, hnum, hnon⟩ := end_facts O Ba P hPmax hO
  obtain ⟨hS', hinv', hnum', hnon'⟩ := end_facts O' Ba' P' hPmax' hO'

  have hdivBa : ∀ i : ↥C, i ∈ J → (i : K) * ((a : K))⁻¹ ∈ Ba := by
