-- title:
--   Eichler–Deuring count of supersingular places at level N
-- statement:
--   Let $q$ be a prime and $N$ a nonzero natural number with $q \nmid N$, and let $k$ be an algebraically closed field of characteristic $q$. Consider the field $\mathtt{modularFunctionFieldC } k\, N$, the intermediate field of the Laurent series field over $k$ generated by the two series `jqModC k` (the $q$-expansion of $j$, with leading term $q^{-1}$) and `jqNModC k N` (its $N$-fold $q$-expansion rescaling), and the places of this field over $k$ in the sense of [`AlgebraicCurve.Place`](def/AlgebraicCurve_DivisorClassGroup.html#L22): valuation subrings containing the image of $k$, distinct from the whole field, whose valuation ring is a principal ideal ring. Let $W$ be a finite set of such places whose members are exactly the elements of $\mathtt{ssPlaces } q\, N\, k$, that is, the places $w$ that are rational ($w.\mathrm{deg} = 1$), satisfy the predicate `IsAffineGeomPlace k N`, and whose value $w.\mathrm{evalAt}$ at the generator `jGeomGen k N` lies in the set `ssJSet q k`. Then the cardinality of $W$, viewed in $\mathbb{Q}$, equals
--   $$\frac{(q-1)\,\psi(N)}{12} + \frac{(2-\nu_2(q))\,\nu_2(N)}{4} + \frac{(2-\nu_3(q))\,\nu_3(N)}{3},$$
--   where $\psi(N)$ is `dedekindPsi N`, $\nu_2(M)$ is the number of $x \in \mathbb{Z}/M$ with $x^2+1=0$ and $\nu_3(M)$ the number with $x^2+x+1=0$; the first summand is `eichlerMass N q` and the whole right-hand side is `ssCountFormula N q`.
--
--   This is the Eichler–Deuring mass formula for the level-$N$ modular curve in characteristic $q \nmid N$, with the contributions of the points above $j = 0$ and $j = 1728$ made explicit. It feeds the genus computations for the reduction of the modular curves, being cited in the determination of the genus of the level-$H$ and level-$N$ function fields and in the degree computation for the weight divisor minus the index places.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_card_eq_ssCountFormula_of_ssPlaces.lean

import Mathlib
import Definitions.Def_ModularCurve_SupersingularNodePlaces
import Definitions.Def_ModularCurve_EichlerMass

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicCurve ModularCurve

theorem ModularCurve.card_eq_ssCountFormula_of_ssPlaces
    (q N : ℕ) [Fact q.Prime] [NeZero N] (hqN : ¬ q ∣ N)
    (k : Type*) [Field k] [CharP k q] [IsAlgClosed k] [DecidableEq k]
    (W : Finset (Place k (modularFunctionFieldC k N))) (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q N k) :
    (W.card : ℚ) = ssCountFormula N q := by sorry
