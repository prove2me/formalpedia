def latticeCharge (u v : LatticeVertex) : ℤ :=
  if u.2 < 0 ∧ v.2 = 0 ∧ 0 < v.1 then 1
  else if v.2 < 0 ∧ u.2 = 0 ∧ 0 < u.1 then -1 else 0

end CoarseAssembly

