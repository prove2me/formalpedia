    (h : ∃ (P : List EndStatement.Instr) (b : ℕ) (C : ℝ), ThreeSumApsp.WordRam.Solves prob P b dom fun x => C * f x)
    (hdom : ∀ x, dom' x → dom x) (hf : Dominated dom' f f')
    (hf0 : ∀ x, dom' x → 0 ≤ f x := by intro _ _; positivity) :
    ∃ (P : List EndStatement.Instr) (b : ℕ) (C : ℝ), ThreeSumApsp.WordRam.Solves prob P b dom' fun x => C * f' x := by
  obtain ⟨P, b, C, h⟩ := h
