    have hgA := ModularCurve.baseAut_arithmeticGalois_mem_iff (xHFunctionField (q ^ 2 * M') (levelH q M')) A hτ
    have hresA := ModularCurve.residue_baseAut_arithmeticGalois (xHFunctionField (q ^ 2 * M') (levelH q M')) A hτ
