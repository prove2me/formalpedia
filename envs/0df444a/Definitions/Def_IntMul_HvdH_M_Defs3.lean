section
-- Source module: NLogN.HFW7
/-!
# Fermat-ring convolution machine, part 7: pointwise products and scaling

Reduction modulo `F = 2^n + 1` with linear operations: `x = lo + 2^n hi ≡ lo - hi`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

/-! ## Pointwise products -/

abbrev TMP : Fin HS := 24

/-- `lo - hi` for `x = lo + 2^n hi` on `TMP`. -/
def dE : Ex HS := .add (.rem (.reg TMP) (.reg NLogN.FW.XN)) (.neg (.quo (.reg TMP) (.reg NLogN.FW.XN)))

/-- `x mod (2^n + 1)` for `0 ≤ x ≤ 2^{2n}`. -/
def redE : Ex HS := .sel dE (.add dE (.reg XF)) dE

def pmBody : RM :=
  RM.seqL [.mul TMP XD YC, .rs (.push NLogN.FW.ZB redE), .rs (.pop TMP), .rs (.pop XD), .rs (.pop YC)]

def pmL : RM := .seq (.rep C0 (.reg NN) pmBody) (.rs (mvList NLogN.FW.ZB XD C2 (.reg NN)))

def pmSt (n : ℕ) (A B : List ℤ) (s : IState HS) (RD RY : List Item) (k : ℕ) : IState HS :=
  ((s.upd XD (ints (B.drop k) ++ RD)).upd YC (ints (A.drop k) ++ RY)).upd NLogN.FW.ZB
    (ints (Ref.pmulZ (2 ^ n + 1) (A.take k) (B.take k)).reverse ++ s.G NLogN.FW.ZB)

/-- Cost of `N` pointwise products. -/
def pmCost (N W Φm : ℕ) : ℕ :=
  N * (Φm + 110000 * (W + 2)) + N * (14000 * (W + 2) + 30) + 8000 * (W + 2) + 64

end NLogN.FW

end


