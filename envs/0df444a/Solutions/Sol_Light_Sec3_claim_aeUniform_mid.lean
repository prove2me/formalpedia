      arrAB := ⟨hpre.lenAB, sAB, hpre.leAB, hpre.belowAB.trans hok.cells⟩
      arrBC := ⟨hpre.lenBC, sBC, hpre.leBC, hpre.belowBC.trans hok.cells⟩
