noncomputable def unitaryLinearIsometryEquiv
    {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (U : unitary (H →L[ℂ] H)) :
    H ≃ₗᵢ[ℂ] H where
