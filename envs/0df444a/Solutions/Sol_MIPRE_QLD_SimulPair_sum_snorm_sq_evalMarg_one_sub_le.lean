        xSqNorm P.Φ (aOp (hatMats MA W u a)) (aOp (hatMats MB W u a))
      ≤ 172 * ε := by
  have htr : ∀ (u : Point F m) (a : F),
      xSqNorm P.Φ (aOp (hatMats MA W u a)) (aOp (hatMats MB W u a))
      = xSqNorm (hatVec (F := F) (m := m) ψ) (hatMats MA W u a) (hatMats MB W u a) := fun u a =>
    P.xSqNorm_aOp (hatMats_conjTranspose MA W u a) _
