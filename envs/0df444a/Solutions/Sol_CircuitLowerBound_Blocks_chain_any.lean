open CircuitLowerBound CircuitLowerBound.Blocks
open ENP Groundwork
namespace CircuitLowerBound.Blocks
theorem _root_.solution (v : ℕ → Bool) (off init len : ℕ) (p : ℕ → Bool) (h : ∀ i < len, v (off + i) = (v (prevW off init i) || p i)) :
    ∀ m ≤ len, v (prevW off init m) = (v init || decide (∃ i < m, p i = true)) := by
  intro m
  induction m with
  | zero => intro _; simp [prevW]
  | succ m ih =>
    intro hm
    rw [prevW_succ, h m hm, ih (by omega), Bool.or_assoc]
    congr 1
    rw [Bool.eq_iff_iff]
    simp only [Bool.or_eq_true, decide_eq_true_eq]
    constructor
    · rintro (⟨i, hi, h1⟩ | h2)
      · exact ⟨i, by omega, h1⟩
      · exact ⟨m, by omega, h2⟩
    · rintro ⟨i, hi, h1⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 hi with h | rfl
      · exact .inl ⟨i, h, h1⟩
      · exact .inr h1
end CircuitLowerBound.Blocks
