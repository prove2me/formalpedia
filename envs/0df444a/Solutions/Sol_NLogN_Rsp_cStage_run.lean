theorem bandRound_length (R : ℤ) (X : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ) :
    (bandRound R X Dl Wi acc).length = acc.length := by simp [bandRound]

theorem bandF_length (R : ℤ) (Dl : List ℕ) :
    ∀ (Ws : List (List ℤ)) (X acc : List ℤ), (bandF R Dl Ws X acc).length = acc.length
  | [], _, _ => rfl
  | Wi :: Ws, X, acc => by rw [bandF, bandF_length R Dl Ws, bandRound_length]

theorem bandF_getD (R : ℤ) (Dl : List ℕ) :
    ∀ (Ws : List (List ℤ)) (X acc : List ℤ) (k : ℕ), k < acc.length →
    (bandF R Dl Ws X acc).getD k 0 = acc.getD k 0 +
      ∑ i ∈ Finset.range Ws.length,
        ((Ws.getD i []).getD k 0 * X.getD (NLogN.Rsp.pre Dl (k + 1) + i) 0).tdiv R
  | [], _, _, _, _ => by simp [bandF]
  | Wi :: Ws, X, acc, k, hk => by
    rw [bandF, bandF_getD R Dl Ws (X.drop 1) _ k (by rw [bandRound_length]; exact hk)]
    rw [List.length_cons, Finset.sum_range_succ']
    have h1 : (bandRound R X Dl Wi acc).getD k 0 =
        acc.getD k 0 + (Wi.getD k 0 * X.getD (NLogN.Rsp.pre Dl (k + 1)) 0).tdiv R := by
      simp [bandRound, List.getD_eq_getElem?_getD, hk]
    have h2 : ∀ i, (X.drop 1).getD (NLogN.Rsp.pre Dl (k + 1) + i) 0 = X.getD (NLogN.Rsp.pre Dl (k + 1) + (i + 1)) 0 :=
      fun i => by simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]; congr 2; ring
    simp only [h1, h2, List.getD_cons_succ, List.getD_cons_zero, add_zero]
    ring

theorem pre_succ (Dl : List ℕ) (k : ℕ) (hk : k < Dl.length) :
    NLogN.Rsp.pre Dl (k + 1) = NLogN.Rsp.pre Dl k + Dl[k] := by
  unfold NLogN.Rsp.pre; rw [← List.take_concat_get' Dl k hk, List.sum_append, List.sum_singleton]

end NLogN.Rsp

end

