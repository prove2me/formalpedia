theorem solution {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) :
    ((List.ofFn (NLogN.KFM.tB n)).rotate k).headD 1 = 2 ^ (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k) := by
  have hl : k < (List.ofFn (NLogN.KFM.tB n)).length := by simpa using hk
  rw [NLogN.KFY.rotate_head_cons _ k hl]
  simp only [List.headD_cons, List.getElem_ofFn]
  rw [NLogN.KFY.tB_eq hn k hk]; rfl
end
