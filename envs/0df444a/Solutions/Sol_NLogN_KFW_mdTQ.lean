    by rw [hne _ (by decide)]; exact h.hρ, by rw [hne _ (by decide)]; exact h.hk,
    by rw [hne _ (by decide)]; exact h.hq, by rw [hne _ (by decide)]; exact h.hD',
    by rw [hne _ (by decide)]; exact h.hm⟩

