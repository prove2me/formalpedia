theorem BianchiIX.volume_gaussCylinder_prefix (a : ℕ → ℕ+) (n : ℕ) :
    volume (gaussCylinder (digitPrefix a n)) = ENNReal.ofReal (gaussPrefixLength a n) := by sorry
