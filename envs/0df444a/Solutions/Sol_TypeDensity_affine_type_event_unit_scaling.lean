    (∀ (a : Fin (n+1) → O) (u : O), IsUnit u → (u • a ∈ TypeDensity.affineTypeEvent O n σ ↔ a ∈ TypeDensity.affineTypeEvent
      O n σ)) ∧ ∀ (G : Fin (n+1) → IsLocalRing.ResidueField O) (μ : Fin (n+1)), G μ = 1 → ∀ a ∈
      TypeDensity.projectiveCell O n G, (TypeDensity.insertOne μ (TypeDensity.projectiveNormalize O n G μ a) ∈ TypeDensity.affineTypeEvent O n σ ↔
      a ∈ TypeDensity.affineTypeEvent O n σ) := by
  have key : ∀ (a : Fin (n+1) → O) (u : O), IsUnit u →
      (u • a ∈ TypeDensity.affineTypeEvent O n σ ↔ a ∈ TypeDensity.affineTypeEvent O n σ) := by
    intro a u hu
    have hu0 : u ≠ 0 := hu.ne_zero
    have hι : algebraMap O (TypeDensity.BaseField O) u ≠ 0 := by
      intro h
      exact hu0 (IsFractionRing.injective O (TypeDensity.BaseField O) (by simpa using h))
    have hP : TypeDensity.affinePolynomial O (u • a) = Polynomial.C (algebraMap O (TypeDensity.BaseField O) u) *
        TypeDensity.affinePolynomial O a := by
      unfold TypeDensity.affinePolynomial
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc]
    have hlast : (u • a) (Fin.last n) ≠ 0 ↔ a (Fin.last n) ≠ 0 := by
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [Ne, Ne, mul_eq_zero]; simp [hu0]
    have hn : Polynomial.C (algebraMap O (TypeDensity.BaseField O) ((u • a) (Fin.last n)))⁻¹ *
          TypeDensity.affinePolynomial O (u • a) =
        Polynomial.C (algebraMap O (TypeDensity.BaseField O) (a (Fin.last n)))⁻¹ * TypeDensity.affinePolynomial O a := by
      rw [hP]
      simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_inv]
      rw [← mul_assoc, mul_assoc (Polynomial.C (algebraMap O (TypeDensity.BaseField O) u)⁻¹),
        mul_comm (Polynomial.C (algebraMap O (TypeDensity.BaseField O) (a (Fin.last n)))⁻¹),
        ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hι]
      simp [mul_comm]
    exact ⟨fun ⟨h1, h2⟩ ↦ ⟨hlast.1 h1, by rwa [hn] at h2⟩, fun ⟨h1, h2⟩ ↦ ⟨hlast.2 h1, by rwa [hn]⟩⟩
  refine ⟨key, fun G μ hG a ha ↦ ?_⟩
  have ⟨_, c, hc, hres⟩ := ha
  have hres' : IsLocalRing.residue O (a μ) = c := by simpa [TypeDensity.residueVector, hG] using congrFun hres μ
  have hunit : IsUnit (a μ) := by
