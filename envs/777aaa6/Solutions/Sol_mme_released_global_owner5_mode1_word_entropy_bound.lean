private theorem log_bounds (j : Fin 9) (w : Word)
    (hp : 0 < x j w / ∑ v, x j v) :
    (lower j w : ℝ) ≤ Real.log ((x j w / ∑ v, x j v : ℚ) : ℝ) ∧
      Real.log ((x j w / ∑ v, x j v : ℚ) : ℝ) ≤ (upper j w : ℝ) := by
  apply mme_rational_log_series_certificate _ hp (logScale j w) 16
  all_goals revert j w; decide +kernel

