    (hU : s0.G CU = ints u ++ RU) (hKs : s0.G Ks = .int (u.length : ℤ) :: LKs)
    (hKa : s0.G Ka = .int (a : ℤ) :: LKa) (hKN : s0.G KN = .int ((u.length + NR : ℕ) : ℤ) :: LKN)
    (hR : s0.G BR = .int R :: LR) (hN : s0.G BN = .int n :: LN) (hNR : s0.G BNR = .int NR :: LNR)
