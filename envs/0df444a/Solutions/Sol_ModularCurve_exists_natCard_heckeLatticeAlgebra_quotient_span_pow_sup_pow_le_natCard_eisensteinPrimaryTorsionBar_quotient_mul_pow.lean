theorem finite_quotient_of_natCast_mem {S : Type*} [CommRing S] [inst : Module ℤ S]
    [Module.Finite ℤ S] (I : Ideal S) (n : ℕ) (hn : n ≠ 0) (hI : (n : S) ∈ I) :
    Finite (S ⧸ I) := by
  obtain rfl : inst = AddCommGroup.toIntModule S := Subsingleton.elim _ _
  haveI : Module.Finite ℤ (S ⧸ I) := Module.Finite.quotient ℤ I
  refine Module.finite_of_fg_torsion (S ⧸ I) fun x => ?_
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hn' : (n : ℤ) ∈ nonZeroDivisors ℤ :=
    mem_nonZeroDivisors_of_ne_zero (Int.natCast_ne_zero.mpr hn)
  refine ⟨⟨n, hn'⟩, ?_⟩
  show (n : ℤ) • Ideal.Quotient.mk I s = 0
  rw [show ((n : ℤ) • Ideal.Quotient.mk I s) = Ideal.Quotient.mk I ((n : ℤ) • s) from rfl,
    zsmul_eq_mul, Int.cast_natCast, Ideal.Quotient.eq_zero_iff_mem]
  exact I.mul_mem_right s hI

theorem natCast_mem_map {R S : Type*} [Semiring R] [Semiring S] (f : R →+* S)
    (I : Ideal R) (n : ℕ) (h : (n : R) ∈ I) : (n : S) ∈ I.map f :=
  map_natCast f n ▸ Ideal.mem_map_of_mem f h

theorem exists_step_eq_of_mono_bounded (f : ℕ → ℕ) (hmono : Monotone f) (B : ℕ)
    (hbound : ∀ M, f M ≤ B) (start : ℕ) :
    ∃ M, start ≤ M ∧ f (M + 1) = f M := by
  by_contra h
  push Not at h

  have step : ∀ k, f start + k ≤ f (start + k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have hne : f (start + k + 1) ≠ f (start + k) :=
        h (start + k) (Nat.le_add_right _ _)
      have hle : f (start + k) ≤ f (start + k + 1) := hmono (Nat.le_succ _)
      have hac : start + (k + 1) = start + k + 1 := by omega
      rw [hac]; omega
  have := step (B + 1)
  have := hbound (start + (B + 1))
  have := hbound start
  omega

theorem submodule_eq_of_le_of_card_eq {R J : Type*} [Ring R] [AddCommGroup J] [Module R J]
    {S T : Submodule R J} [Finite T] (hST : S ≤ T) (hcard : Nat.card T ≤ Nat.card S) :
    S = T := by
  have hfS : Finite S := Finite.Set.subset _ hST
  have hbij : Function.Bijective (Submodule.inclusion hST) :=
    (Nat.bijective_iff_injective_and_card _).mpr
      ⟨Submodule.inclusion_injective _, le_antisymm (Nat.card_le_card_of_injective _
        (Submodule.inclusion_injective hST)) hcard⟩
  refine le_antisymm hST (fun x hx => ?_)
  obtain ⟨y, hy⟩ := hbij.2 ⟨x, hx⟩
  have hyx : (y : J) = x := congrArg Subtype.val hy
  exact hyx ▸ y.2

theorem ideal_eq_of_le_of_card_quotient_eq {R : Type*} [CommRing R]
    {I J : Ideal R} [Finite (R ⧸ I)] (hIJ : I ≤ J)
    (hcard : Nat.card (R ⧸ I) ≤ Nat.card (R ⧸ J)) :
    I = J := by

  let π : R ⧸ I →+* R ⧸ J := Ideal.Quotient.factor hIJ
  have hπsurj : Function.Surjective π := Ideal.Quotient.factor_surjective hIJ
  haveI hfJ : Finite (R ⧸ J) := Finite.of_surjective π hπsurj
  have hbij : Function.Bijective π :=
    (Nat.bijective_iff_surjective_and_card _).mpr
      ⟨hπsurj, le_antisymm hcard (Nat.card_le_card_of_surjective π hπsurj)⟩
  refine le_antisymm hIJ (fun x hx => ?_)
  have h0 : π (Ideal.Quotient.mk I x) = 0 := by
    simp only [π, Ideal.Quotient.factor_mk]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
  have : Ideal.Quotient.mk I x = 0 := hbij.1 (by rw [h0, map_zero])
  exact Ideal.Quotient.eq_zero_iff_mem.mp this

theorem exists_step_eq_two_mono (f g : ℕ → ℕ) (hfmono : Monotone f) (hgmono : Monotone g)
    (Bf Bg : ℕ) (hfb : ∀ M, f M ≤ Bf) (hgb : ∀ M, g M ≤ Bg) (start : ℕ) :
    ∃ M, start ≤ M ∧ f (M + 1) = f M ∧ g (M + 1) = g M := by
  obtain ⟨M, hMs, hsum⟩ :=
    exists_step_eq_of_mono_bounded (fun M => f M + g M)
      (fun a b hab => Nat.add_le_add (hfmono hab) (hgmono hab))
      (Bf + Bg) (fun M => Nat.add_le_add (hfb M) (hgb M)) start
  have hf1 : f M ≤ f (M + 1) := hfmono (Nat.le_succ M)
  have hg1 : g M ≤ g (M + 1) := hgmono (Nat.le_succ M)
  have hs : f (M + 1) + g (M + 1) = f M + g M := hsum
  exact ⟨M, hMs, by omega, by omega⟩

theorem core₂ {A' B : Type*} [AddCommGroup A'] [AddCommGroup B] [Finite B]
    {M : Type*} [CommMonoid M] (hM : ∀ n : ℕ, n ≠ 0 → HasEnoughRootsOfUnity M n)
    (φ : A' → (Multiplicative B →* Mˣ)) (hφinj : Function.Injective φ)
    (hφadd : ∀ a b, φ (a + b) = φ a * φ b) :
    ∃ g : A' →+ B, Function.Injective g := by
  haveI : Finite (Multiplicative B) := Finite.of_equiv B Multiplicative.ofAdd
  haveI := hM (Monoid.exponent (Multiplicative B)) Monoid.exponent_ne_zero_of_finite
  obtain ⟨e⟩ := CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity (Multiplicative B) M
  refine ⟨{ toFun := fun a => Multiplicative.toAdd (e (φ a))
            map_zero' := ?_
            map_add' := ?_ }, ?_⟩
  · have hφ0 : φ 0 = 1 := by
      have h := hφadd 0 0; rw [add_zero] at h
      exact mul_right_cancel (h.symm.trans (one_mul (φ 0)).symm)
    simp [hφ0]
  · intro a b; simp [hφadd, map_mul]
  · intro a b hab
    exact hφinj (e.injective (Multiplicative.toAdd.injective hab))

theorem algClosure_hasEnough (n : ℕ) (hn : n ≠ 0) :
    HasEnoughRootsOfUnity (AlgebraicClosure ℚ) n := by
  haveI : NeZero n := ⟨hn⟩; infer_instance

theorem dual_of_injective_toAdditive {T : Type*} [AddCommGroup T] [Finite T]
    {A' : Type*} [AddCommGroup A']
    (φ : A' →+ (T →+ Additive (AlgebraicClosure ℚ)ˣ)) (hφinj : Function.Injective φ) :
    ∃ ι : A' →+ T, Function.Injective ι := by
  refine core₂ (M := AlgebraicClosure ℚ) algClosure_hasEnough
    (fun a => AddMonoidHom.toMultiplicativeLeft (φ a))
    (fun a b h => hφinj (AddMonoidHom.toMultiplicativeLeft.injective h)) ?_
  intro a b
  refine MonoidHom.ext fun x => ?_
  show Additive.toMul (φ (a + b) (Multiplicative.toAdd x)) =
    Additive.toMul (φ a (Multiplicative.toAdd x)) * Additive.toMul (φ b (Multiplicative.toAdd x))
  rw [map_add, AddMonoidHom.add_apply, toMul_add]

