/-! ### Genuine first derivatives on the open `U` -/

/-- **Background metric compatibility along the null field:** `Σ_a ℓ_a (∇̄_c k)^a = 0` on `U`. -/
theorem lower_covD_null {x : Pt 5} (hx : x ∈ U) (c : Fin 5) :
    ∑ a, lowerK b k x a * covD (christoffel b bi) k x c a = 0 := by
  have hS : ∑ a, lowerK b k x a * covD (christoffel b bi) k x c a =
      ∑ a, lowerK b k x a * pd c (fun y => k y a) x
        + ∑ a, lowerK b k x a * ∑ l, christoffel b bi a c l x * k x l := by
    unfold covD
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun a _ => by ring
  rw [hS, hD.sum_lower_chr hx c]
  have := hD.null_deriv hx c
  linarith

/-! ### The lowered difference connection -/

theorem lower_dot_accel {x : Pt 5} (hx : x ∈ U) :
    ∑ j, lowerK b k x j * accel b bi k x j = 0 := by
  simp only [accel_eq_sum_covD, Finset.mul_sum]
  rw [Finset.sum_comm]
  have : ∀ c, ∑ j, lowerK b k x j * (k x c * covD (christoffel b bi) k x c j) =
