        C.r = HahnSeries.C (-(12 : ↥k₀)⁻¹) ∧ C.s = HahnSeries.C (-(2 : ↥k₀)⁻¹) ∧ C.t = HahnSeries.C ((24 : ↥k₀)⁻¹)) ∧

      r.curve.map (algebraMap ↥K (LaurentSeries ↥k₀)) = C • ModularCurve.tateBase ↥k₀ (q * ℓ') ∧

      (∀ (p : ↥M'.primeFactors) (F' : Type) [Field F'] (f : ↥k₀ →+* F') (ζ : F'),
