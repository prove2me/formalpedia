theorem mem_maximalIdeal_of_valuationSubring_eq {F : Type*} [Field F] {O₁ O₂ : ValuationSubring F}
    (e : O₁ = O₂) {x : F} (h₁ : x ∈ O₁) (h₂ : x ∈ O₂) (hm : (⟨x, h₁⟩ : O₁) ∈ maximalIdeal ↥O₁) :
    (⟨x, h₂⟩ : O₂) ∈ maximalIdeal ↥O₂ := by
  subst e; exact hm

