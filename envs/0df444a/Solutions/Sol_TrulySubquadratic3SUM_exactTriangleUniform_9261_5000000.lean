                                         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                                 List.sum_cons, List.sum_nil, ])
                                             (first
                                               | omega
                                               | ((ring_nf); (omega))))
                                         | omega
                                         |
                                           (simp [] <;>
                                               first
                                               | omega
                                               | ((ring_nf); (omega))))) :
    Ends lim P d (.store a e) ⟨Light.frame l, μ⟩ T Q := by
  obtain ⟨⟨ha, hav⟩, ⟨he, hev⟩, hb⟩ := he
  refine Ends.store ha he ?_ hT ?_
  · rw [hav]
    exact ⟨Int.natCast_nonneg b, by exact_mod_cast hb⟩
  · rw [hav, hev, Int.toNat_natCast]
