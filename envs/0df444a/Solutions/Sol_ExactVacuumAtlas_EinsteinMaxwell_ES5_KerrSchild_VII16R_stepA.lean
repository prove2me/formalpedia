theorem e1_onshell (hx : x ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0)
    (h0 : paE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ = 0) :
