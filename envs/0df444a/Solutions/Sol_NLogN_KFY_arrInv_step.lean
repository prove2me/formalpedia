open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
theorem solution {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n)
    (f : List NLogN.KFB.GI → List NLogN.KFB.GI)
    (hf : ∀ X : List NLogN.KFB.GI, X.length = NLogN.KFY.tN n k → (f X).length = NLogN.KFY.tN n k)
    (hd : ∀ X, NLogN.KFY.DiscL (IntMul.OpenAI.Glue.pP n) X → NLogN.KFY.DiscL (IntMul.OpenAI.Glue.pP n) (f X)) (X : List NLogN.KFB.GI)
    (hX : NLogN.KFY.ArrInv n X) : NLogN.KFY.ArrInv n (NLogN.KFY.stepL ((List.ofFn (NLogN.KFM.tB n)).rotate k) f X) := by
  refine ⟨?_, NLogN.KFY.stepL_disc _ f hd hX.2⟩
  rw [NLogN.KFY.stepL_length _ f (NLogN.KFY.rot_ne_nil hn k) (by rw [NLogN.KFY.rot_head hn k hk]; positivity)
    (by rw [NLogN.KFY.rot_head hn k hk]; exact hf), (List.rotate_perm _ _).prod_eq]
end
