  haveI : Localization.AtPrime.IsLiesOverAlgebra (𝔔.under (Polynomial A)) 𝔔 := ⟨rfl⟩
  obtain ⟨-, -, -, hiff⟩ :=
    Algebra.isUnramifiedAt_iff_map_maximalIdeal_eq_and_isSeparable_of_height_eq_one (O := Polynomial A) (C := ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K₀) j₀)) 𝔔 h𝔔
