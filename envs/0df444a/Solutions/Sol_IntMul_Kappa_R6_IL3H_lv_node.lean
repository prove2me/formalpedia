  refine ⟨fun i hi => ?_, fun i hi => ?_, fun i u hu => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.off i hi
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.offp i hi
  · rcases σPush_cases _ _ _ _ hu with ⟨p, hp, rfl⟩ | h'
    · simp only [List.mem_singleton] at hp; subst hp; simp only []; decide
    · exact hL.lt i u h'
  · rw [ne _ (by decide)]; exact hL.hK
  · rw [ne _ (by decide)]; exact hL.ht
  · rw [ne _ (by decide)]; exact hL.hS
  · rw [ne _ (by decide)]; exact hL.hr
  · rw [ne _ (by decide)]; exact hL.hH
  · rw [ne _ (by decide)]; exact hL.hk
  · rw [ne _ (by decide)]; exact hL.hE
  · rw [ne _ (by decide)]; exact hL.hB
  · rw [ne _ (by decide)]; exact hL.hX

