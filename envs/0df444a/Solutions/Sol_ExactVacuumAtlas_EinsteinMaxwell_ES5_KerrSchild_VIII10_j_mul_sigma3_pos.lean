/-- **M3, the far-field coefficient is strictly positive**: `5/3072 ≤ σ₃(1)`. -/
theorem sigma3_one_ge : (5 / 3072 : ℝ) ≤ sigma3 1 := by
  have hlim := cj_lim 1
  have hle : ∀ᶠ R : ℝ in atTop, 5 / 3072 ≤ R * cj 1 R := by
    filter_upwards [eventually_gt_atTop (3:ℝ)] with R hR
    have h := cj_one_ge hR
    have hR0 : (0:ℝ) < R := by linarith
    rw [show (5:ℝ) / 3072 = R * (5 / (3072 * R)) by field_simp]
    exact mul_le_mul_of_nonneg_left h (le_of_lt hR0)
  exact ge_of_tendsto hlim hle

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII10
