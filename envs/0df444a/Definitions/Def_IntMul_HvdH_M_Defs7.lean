  (∃ R, st.G aD = ints ((sDel s t).map (Nat.cast : ℕ → ℤ)) ++ R)

/-! ## Entry bounds of the `S` table -/

/-! ## Output bounds -/

/-! ## The relocated `sapP` -/

/-! ## The slice program as a `GL.LProg` -/

/-- Arithmetic side conditions of the `S̃` slice (input bound `Bi`, output bound `Bo`,
multiplication operand bound `mm`, accumulator bound `Bacc`, list-move bound `Q`). -/
structure SapHyp (p s t α Bi Bo mm Bacc Q : ℕ) : Prop where
  hs : 0 < s
  hst : s ≤ t
  hBi : Bi ≤ mm
  hW : (4 * p + 35) * 2 ^ (2 * p) < 2 ^ mm
