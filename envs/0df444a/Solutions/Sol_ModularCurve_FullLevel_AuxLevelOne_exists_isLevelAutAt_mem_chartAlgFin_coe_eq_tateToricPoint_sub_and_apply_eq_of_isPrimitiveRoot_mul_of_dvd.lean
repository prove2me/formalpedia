theorem isUnit_one_sub_of_pow_eq_one {A : Type} [CommRing A] [IsLocalRing A] (c : A) (n : ℕ) (hn : IsUnit ((n : ℕ) : A))
    (hc : c ^ n = 1) (hc1 : c ≠ 1) : IsUnit (1 - c) := by
  by_contra hnu
  have hm : 1 - c ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
  have hgs : (Finset.range n).sum (fun i => c ^ i) * (c - 1) = 0 := by rw [geom_sum_mul, hc, sub_self]
  have hsum : IsUnit ((Finset.range n).sum (fun i => c ^ i)) := by
    by_contra hsu
    have hsm : (Finset.range n).sum (fun i => c ^ i) ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hsu)
    have hmem : ((n : ℕ) : A) ∈ IsLocalRing.maximalIdeal A := by
      have e : ((n : ℕ) : A) = (Finset.range n).sum (fun i => c ^ i) + (Finset.range n).sum (fun i => (1 - c ^ i)) := by
        rw [← Finset.sum_add_distrib]; simp
      rw [e]
      refine Ideal.add_mem _ hsm (Ideal.sum_mem _ fun i _ => ?_)
      exact Ideal.mem_of_dvd _ (one_sub_dvd_one_sub_pow c i) hm
    exact (IsLocalRing.mem_maximalIdeal _ |>.mp hmem) hn
  have : c - 1 = 0 := (hsum.mul_right_eq_zero).mp hgs
  exact hc1 (sub_eq_zero.mp this)

theorem quot_cancel {F : Type} [Field F] (w r a b c : F) (hw : w ≠ 0) :
    (w * (a - r) - w * (b - r)) * (w * (c - r) - w * (b - r))⁻¹ = (a - b) * (c - b)⁻¹ := by
  have e1 : w * (a - r) - w * (b - r) = w * (a - b) := by ring
  have e2 : w * (c - r) - w * (b - r) = w * (c - b) := by ring
  rw [e1, e2, mul_inv, show w * (a - b) * (w⁻¹ * (c - b)⁻¹) = (w * w⁻¹) * ((a - b) * (c - b)⁻¹) by ring,
    mul_inv_cancel₀ hw, one_mul]

