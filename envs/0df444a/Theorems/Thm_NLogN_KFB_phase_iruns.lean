theorem NLogN.KFB.phase_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (hm : 0 < m) (hn : 0 < n) (T : Butterfly.Op (Fin n))
    (w : Fin W) (k₀ k₁ : ℕ) (a : Fin m → ℕ) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB wb zs) :
    ∃ zs', Rep zs' ((P8Lift.RStep.den T (P8Lift.RStep.phase w k₀ k₁ a)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      IRuns I iprog (fcode (phaseProg m n w.val k₀ k₁ a)) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l)))
        ((m * n + 1) * NLogN.KFB.cPass wb (2 ^ (m * n)) (w.val * 2 ^ (m * n))
          (zsz (((4 * (3 * 2 ^ (m * n) + w.val * 2 ^ (m * n))) : ℕ) : ℤ))) := by sorry
