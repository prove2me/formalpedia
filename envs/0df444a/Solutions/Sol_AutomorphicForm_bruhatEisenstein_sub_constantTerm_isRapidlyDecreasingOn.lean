  rw [hφ _ (incl_mem_adelicBorel F w (torusGL_mem_borelSubgroup_c hw r₁ r₂)) g,
    borelDiagFst_incl_torusGL_c hw r₁ r₂, borelDiagSnd_incl_torusGL_c hw r₁ r₂]

private theorem continuous_chi_complexIdeleAt_of_apply_ne_zero {χ₁ χ₂ : 𝔸ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ) {g₀ : AdelicGL2 (𝓞 F) F} (h0 : φ g₀ ≠ 0) :
    (Continuous fun r : ℂˣ => ((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ)) ∧
      (Continuous fun r : ℂˣ => ((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ)) := by
  have hb : ∀ r₁ r₂ : ℂˣ, ((χ₁ (complexIdeleAt hw r₁) : ℂˣ) : ℂ) * ((χ₂ (complexIdeleAt hw r₂) : ℂˣ) : ℂ)
      = φ (adelicArchGLInclAt F w (ofComplexGL hw (torusGL r₁ r₂)) * g₀) * (φ g₀)⁻¹ := fun r₁ r₂ => by
    rw [apply_incl_torusGL_mul_c hw hφ, mul_inv_cancel_right₀ h0]
  have h1 : (fun r : ℂˣ => ((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ))
      = fun r => φ (adelicArchGLInclAt F w (ofComplexGL hw (torusGL r (1 : ℂˣ))) * g₀) * (φ g₀)⁻¹ := by
    funext r
    rw [← hb r 1, map_one, map_one, Units.val_one, mul_one]
  have h2 : (fun r : ℂˣ => ((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ))
      = fun r => φ (adelicArchGLInclAt F w (ofComplexGL hw (torusGL (1 : ℂˣ) r)) * g₀) * (φ g₀)⁻¹ := by
    funext r
    rw [← hb 1 r, map_one, map_one, Units.val_one, one_mul]
  refine ⟨?_, ?_⟩
  · rw [h1]
    exact (hφc.comp (((continuous_adelicArchGLInclAt F w).comp
      ((continuous_ofComplexGL hw).comp continuous_torusGL_fst_c)).mul continuous_const)).mul continuous_const
  · rw [h2]
    exact (hφc.comp (((continuous_adelicArchGLInclAt F w).comp
      ((continuous_ofComplexGL hw).comp continuous_torusGL_snd_c)).mul continuous_const)).mul continuous_const

private theorem distribHaarChar_complexIdeleAt (r : ℂˣ) :
    ((distribHaarChar 𝔸 (complexIdeleAt hw r) : ℝ≥0) : ℝ) = ‖(r : ℂ)‖ ^ 2 := by
  have hmult : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hw⟩
  rw [NumberField.AdeleRing.distribHaarChar_eq_prod_norm_pow_mult_of_snd_eq_one F (complexIdeleAt hw r)
      (complexIdeleAt_snd hw r),
    Finset.prod_eq_single w (fun v _ hvw => by rw [complexIdeleAt_fst_of_ne hw r hvw, norm_one, one_pow])
      (fun h => absurd (Finset.mem_univ w) h),
    norm_complexIdeleAt_fst_self hw, hmult]

omit [NumberField F] in

private theorem norm_sq_rpow_eq (r : ℂˣ) (x : ℝ) : (‖(r : ℂ)‖ ^ 2) ^ (2⁻¹ * x) = ‖(r : ℂ)‖ ^ x := by
  rw [← Real.rpow_natCast ‖(r : ℂ)‖ 2, ← Real.rpow_mul (norm_nonneg _)]
  congr 1
  push_cast
  ring

private theorem norm_etaFst_complexIdeleAt (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ))
    (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    {μ : 𝔸ˣ →* ℂˣ} (hμ : IsUnitaryChar (𝓞 F) F μ) (s : ℂ) (r : ℂˣ) :
    ‖((etaFst μ α hα s (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ = ‖(r : ℂ)‖ ^ (2 * s.re + 1) := by
  have hx : s.re + 1 / 2 = 2⁻¹ * (2 * s.re + 1) := by ring
  rw [norm_etaFst_apply_of_unitary hμ α hα s, hαΔ, distribHaarChar_complexIdeleAt hw, hx, norm_sq_rpow_eq]

private theorem norm_etaSnd_complexIdeleAt (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ))
    (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    {ν : 𝔸ˣ →* ℂˣ} (hν : IsUnitaryChar (𝓞 F) F ν) (s : ℂ) (r : ℂˣ) :
    ‖((etaSnd ν α hα s (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ = ‖(r : ℂ)‖ ^ (-(2 * s.re + 1)) := by
  have hx : -(s.re + 1 / 2) = 2⁻¹ * (-(2 * s.re + 1)) := by ring
  rw [etaSnd_apply, Units.val_mul, norm_mul, hν, one_mul, norm_cpowChar_apply, hαΔ, distribHaarChar_complexIdeleAt hw,
    Complex.neg_re, re_add_half, hx, norm_sq_rpow_eq]

end ComplexTwins
