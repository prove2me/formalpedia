  intro α _ pad evX fam m nb β rb tb hp he hf hm hnb hβ hrb htb
  have h1 : PolyT fun p : α × List (List ℕ) × ℕ => roundD (evX p.1) (fam p.1) (m p.1) (nb p.1) (β p.1) (rb p.1) (tb p.1) p.2.1 :=
