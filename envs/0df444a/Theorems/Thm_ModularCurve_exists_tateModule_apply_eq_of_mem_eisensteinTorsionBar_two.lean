open ModularCurve

theorem ModularCurve.exists_tateModule_apply_eq_of_mem_eisensteinTorsionBar_two
    (p : ℕ) [Fact p.Prime] :
    ∀ (m M : ℕ) (x₀ : JZero p), x₀ ∈ eisensteinTorsionBar p 2 M → 2 ^ m • x₀ = 0 →
      ∃ x : TateModule 2 (JZero p),
        (∀ n : ℕ, ∃ M' : ℕ, (x : ℕ → JZero p) n ∈ eisensteinTorsionBar p 2 M') ∧
        (x : ℕ → JZero p) m = x₀ := by sorry
