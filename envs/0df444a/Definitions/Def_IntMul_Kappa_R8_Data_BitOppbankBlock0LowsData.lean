theorem count_pos_of_mem {a : Nat} {l : List Nat} (h : a ∈ l) : 0 < l.count a :=
  List.count_pos_iff.mpr h

theorem length_eq_count_add_filter (A : List Nat) (a : Nat) :
    A.length = A.count a + (A.filter (fun x => x != a)).length := by
  induction A with
  | nil => simp
  | cons b A ih =>
    rw [List.count_cons, List.filter_cons, List.length_cons]
    by_cases hb : b = a
    · subst hb
      simp [ih]
      omega
    · have hb' : (b == a) = false := beq_false_of_ne hb
      have hne : (b != a) = true := by simp [bne, hb']
      simp [hb', hne, ih]
      omega

theorem count_filter_of_ne {A : List Nat} {b x : Nat} (h : x ≠ b) :
    (A.filter (fun y => y != b)).count x = A.count x := by
  induction A with
  | nil => simp
  | cons a A ih =>
    rw [List.filter_cons]
    by_cases ha : a = b
    · have hdrop : (a != b) = false := by simp [ha]
      have hx : (a == x) = false := by
        have : a ≠ x := ha ▸ (Ne.symm h)
        exact beq_false_of_ne this
      rw [hdrop]
      simp [List.count_cons, hx, ih]
    · have hkeep : (a != b) = true := by simp [bne, beq_false_of_ne ha]
      rw [hkeep]
      simp [List.count_cons, ih]

theorem sum_count_le_length {A B : List Nat} (hB : B.Nodup) :
    (B.map A.count).sum ≤ A.length := by
  induction B generalizing A with
  | nil => simp
  | cons b B ih =>
    have hb := List.nodup_cons.mp hB
    have ih' := ih (A := A.filter (fun x => x != b)) hb.2
    have hmap : B.map (A.filter (fun x => x != b)).count = B.map A.count := by
      apply List.map_congr_left
      intro x hx
      have hxne : x ≠ b := fun heq => hb.1 (heq ▸ hx)
      exact count_filter_of_ne hxne
    rw [List.map_cons, List.sum_cons, ← hmap]
    have hlen := length_eq_count_add_filter A b
    omega

theorem sum_ge_length_of_one_le {l : List Nat} (h : ∀ x ∈ l, 1 ≤ x) :
    l.length ≤ l.sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha : 1 ≤ a := h a (List.mem_cons.mpr (Or.inl rfl))
    have ih' : l.length ≤ l.sum := ih (fun x hx => h x (List.mem_cons.mpr (Or.inr hx)))
    simp [List.sum_cons]
    omega

theorem all_eq_one_of_sum_eq_length {l : List Nat}
    (hle : ∀ x ∈ l, 1 ≤ x) (hsum : l.sum = l.length) : ∀ x ∈ l, x = 1 := by
  induction l with
  | nil => intro x hx; cases hx
  | cons a l ih =>
    have ha : 1 ≤ a := hle a (List.mem_cons.mpr (Or.inl rfl))
    have hle' : ∀ x ∈ l, 1 ≤ x := fun x hx => hle x (List.mem_cons.mpr (Or.inr hx))
    have hge : l.length ≤ l.sum := sum_ge_length_of_one_le hle'
    simp [List.sum_cons] at hsum
    have ha1 : a = 1 := by omega
    have hrest : l.sum = l.length := by omega
    intro x hx
    simp at hx
    rcases hx with rfl | hx
    · exact ha1
    · exact ih hle' hrest x hx

theorem count_eq_one_of_supset {A B : List Nat}
    (hB : B.Nodup) (hsub : ∀ x ∈ B, x ∈ A) (hlen : A.length = B.length) :
    ∀ x ∈ B, A.count x = 1 := by
  have hcounts_one : ∀ n ∈ B.map A.count, 1 ≤ n := by
    intro n hn
    rcases List.mem_map.mp hn with ⟨x, hx, rfl⟩
    exact count_pos_of_mem (hsub x hx)
  have hge : B.length ≤ (B.map A.count).sum := by
    simpa [List.length_map] using sum_ge_length_of_one_le (l := B.map A.count) hcounts_one
  have hle := sum_count_le_length (A := A) (B := B) hB
  have hsum : (B.map A.count).sum = (B.map A.count).length := by
    simp [List.length_map]; omega
  have hones := all_eq_one_of_sum_eq_length (l := B.map A.count) hcounts_one hsum
  intro x hx
  exact hones (A.count x) (List.mem_map.mpr ⟨x, hx, rfl⟩)

theorem map_count_cons_notin {A B : List Nat} {a : Nat} (ha : a ∉ B) :
    B.map (a :: A).count = B.map A.count := by
  apply List.map_congr_left
  intro x hx
  have hne : x ≠ a := fun heq => ha (heq ▸ hx)
  rw [List.count_cons, beq_false_of_ne (Ne.symm hne)]
  simp

theorem map_count_cons_of_mem {A B : List Nat} {a : Nat}
    (hB : B.Nodup) (ha : a ∈ B) :
    (B.map (a :: A).count).sum = (B.map A.count).sum + 1 := by
  induction B with
  | nil => cases ha
  | cons b B ih =>
    have hb := List.nodup_cons.mp hB
    rw [List.map_cons, List.map_cons, List.sum_cons, List.sum_cons, List.count_cons]
    rcases List.mem_cons.mp ha with rfl | ha'
    · have hmap := map_count_cons_notin (A := A) (B := B) hb.1
      rw [hmap, beq_self_eq_true]
      simp
      omega
    · have hne : b ≠ a := fun heq => hb.1 (heq ▸ ha')
      have hbeq : (a == b) = false := beq_false_of_ne (Ne.symm hne)
      simp [hbeq]
      have ih' := ih hb.2 ha'
      omega

theorem subset_of_sum_count_eq_length {A B : List Nat}
    (hB : B.Nodup) (hsum : (B.map A.count).sum = A.length) :
    ∀ y ∈ A, y ∈ B := by
  induction A with
  | nil => intro y hy; cases hy
  | cons a A ih =>
    intro y hy
    by_cases ha : a ∈ B
    · have hsum' : (B.map A.count).sum = A.length := by
        have hs := map_count_cons_of_mem (A := A) (B := B) hB ha
        simp at hsum
        omega
      have ih' := ih hsum'
      simp at hy
      rcases hy with rfl | hy
      · exact ha
      · exact ih' y hy
    · have hmap := map_count_cons_notin (A := A) (B := B) ha
      rw [hmap] at hsum
      have hle := sum_count_le_length (A := A) (B := B) hB
      simp at hsum
      omega

theorem nodup_of_count_le_one {l : List Nat} (h : ∀ x, l.count x ≤ 1) : l.Nodup := by
  induction l with
  | nil => exact List.nodup_nil
  | cons a l ih =>
    refine List.nodup_cons.mpr ⟨?_, ?_⟩
    · intro hin
      have hpos : 0 < l.count a := count_pos_of_mem hin
      have hx := h a
      rw [List.count_cons] at hx
      simp at hx
      omega
    · apply ih
      intro x
      have hx := h x
      rw [List.count_cons] at hx
      by_cases hxa : a = x
      · simp [hxa] at hx
        omega
      · have : (a == x) = false := beq_false_of_ne hxa
        simp [this] at hx
        exact hx

theorem nodup_of_supset_nodup_length {A B : List Nat}
    (hB : B.Nodup) (hsub : ∀ x ∈ B, x ∈ A) (hlen : A.length = B.length) :
    A.Nodup := by
  have hones := count_eq_one_of_supset hB hsub hlen
  have hcounts_one : ∀ n ∈ B.map A.count, 1 ≤ n := by
    intro n hn
    rcases List.mem_map.mp hn with ⟨x, hx, rfl⟩
    exact count_pos_of_mem (hsub x hx)
  have hge : B.length ≤ (B.map A.count).sum := by
    simpa [List.length_map] using sum_ge_length_of_one_le (l := B.map A.count) hcounts_one
  have hle := sum_count_le_length (A := A) (B := B) hB
  have hsum : (B.map A.count).sum = A.length := by
    omega
  have hAsub := subset_of_sum_count_eq_length (A := A) (B := B) hB hsum
  apply nodup_of_count_le_one
  intro x
  by_cases hx : x ∈ B
  · have := hones x hx
    omega
  · have : A.count x = 0 := List.count_eq_zero.mpr (fun hin => hx (hAsub x hin))
    omega

def isStrictSorted : List Nat → Bool
  | [] => true
  | [_] => true
  | a :: b :: cs => decide (a < b) && isStrictSorted (b :: cs)

theorem isStrictSorted_lt {l : List Nat} {a x : Nat}
    (h : isStrictSorted (a :: l) = true) (hx : x ∈ l) : a < x := by
  induction l generalizing a with
  | nil => cases hx
  | cons b cs ih =>
    have hand : decide (a < b) = true ∧ isStrictSorted (b :: cs) = true := by
      simpa [isStrictSorted, Bool.and_eq_true] using h
    have hlt : a < b := of_decide_eq_true hand.1
    rcases List.mem_cons.mp hx with rfl | hx
    · exact hlt
    · exact Nat.lt_trans hlt (ih hand.2 hx)

theorem nodup_singleton (a : Nat) : List.Nodup [a] :=
  List.nodup_cons.mpr ⟨List.not_mem_nil, List.nodup_nil⟩

theorem isStrictSorted_nodup : ∀ l, isStrictSorted l = true → List.Nodup l
  | [], _ => List.nodup_nil
  | [a], _ => nodup_singleton a
  | a :: b :: cs, h => by
    have hs : isStrictSorted (a :: b :: cs) = true := h
    have hand : decide (a < b) = true ∧ isStrictSorted (b :: cs) = true := by
      simpa [isStrictSorted, Bool.and_eq_true] using h
    have hnd := isStrictSorted_nodup (b :: cs) hand.2
    refine List.nodup_cons.mpr ⟨?_, hnd⟩
    intro hin
    exact Nat.lt_irrefl a (isStrictSorted_lt hs hin)

theorem isStrictSorted_append {A B : List Nat}
    (hA : isStrictSorted A = true) (hB : isStrictSorted B = true)
    (hgap : ∀ a ∈ A, ∀ b ∈ B, a < b) :
    isStrictSorted (A ++ B) = true := by
  induction A with
  | nil => simpa
  | cons a A ih =>
    cases A with
    | nil =>
      cases B with
      | nil => simp [isStrictSorted]
      | cons b B' =>
        have hab : a < b := hgap a (List.mem_cons.mpr (Or.inl rfl)) b (List.mem_cons.mpr (Or.inl rfl))
        have heq : isStrictSorted (a :: b :: B') =
            (decide (a < b) && isStrictSorted (b :: B')) := rfl
        rw [List.singleton_append, heq, Bool.and_eq_true]
        exact ⟨decide_eq_true hab, hB⟩
    | cons a' A' =>
      have hand : decide (a < a') = true ∧ isStrictSorted (a' :: A') = true := by
        simpa [isStrictSorted, Bool.and_eq_true] using hA
      have hlt : a < a' := of_decide_eq_true hand.1
      have ih' := ih hand.2 (fun x hx b hb =>
        hgap x (List.mem_cons.mpr (Or.inr hx)) b hb)
      have heq : isStrictSorted (a :: a' :: (A' ++ B)) =
          (decide (a < a') && isStrictSorted (a' :: (A' ++ B))) := rfl
      have hABdef : (a :: a' :: A') ++ B = a :: a' :: (A' ++ B) := by simp
      rw [hABdef, heq, Bool.and_eq_true]
      exact ⟨decide_eq_true hlt, ih'⟩

theorem le_getLast_of_sorted {l : List Nat} (hn : l ≠ [])
    (h : isStrictSorted l = true) : ∀ x ∈ l, x ≤ l.getLast hn := by
  induction l with
  | nil => exact (hn rfl).elim
  | cons a l ih =>
    intro x hx
    cases l with
    | nil =>
      have : x = a := by
        simpa using hx
      subst this
      exact Nat.le_refl _
    | cons b l' =>
      have hand : decide (a < b) = true ∧ isStrictSorted (b :: l') = true := by
        simpa [isStrictSorted, Bool.and_eq_true] using h
      have hne : b :: l' ≠ [] := List.cons_ne_nil _ _
      have hlast : (a :: b :: l').getLast hn = (b :: l').getLast hne := rfl
      rw [hlast]
      rcases List.mem_cons.mp hx with hxa | hx'
      · rw [hxa]
        have : a < (b :: l').getLast hne :=
          isStrictSorted_lt h (List.getLast_mem hne)
        exact Nat.le_of_lt this
      · exact ih (List.cons_ne_nil _ _) hand.2 x hx'

theorem head_le_of_sorted {l : List Nat} (hn : l ≠ [])
    (h : isStrictSorted l = true) : ∀ x ∈ l, l.head hn ≤ x := by
  intro x hx
  cases l with
  | nil => exact (hn rfl).elim
  | cons a l' =>
    change a ≤ x
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact Nat.le_refl _
    · exact Nat.le_of_lt (isStrictSorted_lt h hx')

theorem all_lt_of_sorted_gap {A B : List Nat}
    (hAne : A ≠ []) (hBne : B ≠ [])
    (hA : isStrictSorted A = true) (hB : isStrictSorted B = true)
    (hgap : A.getLast hAne < B.head hBne) :
    ∀ a ∈ A, ∀ b ∈ B, a < b := by
  intro a ha b hb
  have ha' : a ≤ A.getLast hAne := le_getLast_of_sorted hAne hA a ha
  have hb' : B.head hBne ≤ b := head_le_of_sorted hBne hB b hb
  omega

theorem getElem!_mem {l : List Nat} {i : Nat} (h : i < l.length) : l[i]! ∈ l := by
  have h? : l[i]? = some (l[i]'h) := List.getElem?_eq_getElem h
  have h! : l[i]! = l[i]'h := List.getElem!_of_getElem? h?
  rw [h!]
  exact List.getElem_mem h

theorem all_lt_of_all_true {l : List Nat} {n : Nat}
    (h : l.all (fun i => decide (i < n)) = true) : ∀ i ∈ l, i < n := by
  induction l with
  | nil => intro i hi; cases hi
  | cons a l ih =>
    have hand : decide (a < n) = true ∧ l.all (fun i => decide (i < n)) = true := by
      simpa [List.all_cons, Bool.and_eq_true] using h
    intro i hi
    rcases List.mem_cons.mp hi with rfl | hi
    · exact of_decide_eq_true hand.1
    · exact ih hand.2 i hi

theorem mem_of_map_getElem! {ix l : List Nat}
    (hix : ∀ i ∈ ix, i < l.length) {x : Nat}
    (hx : x ∈ ix.map (fun i => l[i]!)) : x ∈ l := by
  rcases List.mem_map.mp hx with ⟨i, hi, rfl⟩
  exact getElem!_mem (hix i hi)


theorem append_ne_nil_right {A B : List Nat} (hB : B ≠ []) : A ++ B ≠ [] := by
  cases A with
  | nil => simpa
  | cons a A => exact List.cons_ne_nil _ _

theorem getLast_cons_of_ne {a : Nat} {l : List Nat} (hl : l ≠ []) :
    (a :: l).getLast (List.cons_ne_nil a l) = l.getLast hl := by
  cases l with
  | nil => exact (hl rfl).elim
  | cons b l' => rfl

theorem getLast_append_right {A B : List Nat} (hB : B ≠ []) :
    (A ++ B).getLast (append_ne_nil_right (A := A) hB) = B.getLast hB := by
  induction A with
  | nil =>
    simp
  | cons a A ih =>
    have hAB : A ++ B ≠ [] := append_ne_nil_right (A := A) hB
    change (a :: (A ++ B)).getLast _ = B.getLast hB
    rw [getLast_cons_of_ne hAB]
    exact ih

theorem getLast_proof_irrel {l : List Nat} (h1 h2 : l ≠ []) :
    l.getLast h1 = l.getLast h2 := rfl


