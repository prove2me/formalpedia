variable {F : Type} [Field F] {w : InfinitePlace F} (hw : w.IsComplex) [NumberField F]

local notation "𝔸" => AdeleRing (𝓞 F) F
local notation "ι" => algebraMap F (AdeleRing (𝓞 F) F)

private theorem pow_mul_norm_le_of_pairFreq_eq_zero (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥)
    {m : LevelIndex F 𝔫 h𝔫 → ℤ} (hm : pairFreq hw 𝔫 h𝔫 m = 0) {k : ℕ} (hk : k ≠ 0)
    (τn : ℝ) (v : ℂ) {C B : ℝ} (hC : 0 ≤ C) (hB : 0 ≤ B) :
    (τn * (2 * π * pairFreq hw 𝔫 h𝔫 m)) ^ k * ‖v‖ ≤ C * B := by
  rw [hm, mul_zero, mul_zero, zero_pow hk, zero_mul]
  exact mul_nonneg hC hB

section DockCSmooth

p2m_open "Complex Function.Complex AutomorphicForm.ComplexIwasawa P2MW.S_AutomorphicForm_bruhatEisenstein_sub_constantTerm_isRapidlyDecreasingOn.M4aP3B.PlaceSplit P2MW.S_AutomorphicForm_bruhatEisenstein_sub_constantTerm_isRapidlyDecreasingOn.M4aP3B.AutoSmooth"

private theorem contDiffAt_zero_of_window {χ₁ χ₂ : 𝔸ˣ →* ℂˣ} (hΨ : IsOneParamGroup (psiWC hw χ₁ χ₂))
    {g : Matrix (Fin 2) (Fin 2) ℂ} (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) {aw bw : ℝ} (haw : aw < 0) (hbw : 0 < bw)
    {slice K : ℝ → ℂ} {c₀ : ℂ}
    (hslice : ∀ u : ℝ, slice u
      = c₀ * psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I)))) * K u)
    {ψ₀ : AdelicGL2 (𝓞 F) F → ℂ} {N : ℕ} {kv₀ : Fin N → AdelicGL2 (𝓞 F) F} {A B Cf D₀ E₀ : Fin N → ℝ → ℂ}
    (hsm : ∀ i, ContDiff ℝ ∞ (A i) ∧ ContDiff ℝ ∞ (B i) ∧ ContDiff ℝ ∞ (Cf i) ∧ ContDiff ℝ ∞ (D₀ i) ∧
      ContDiff ℝ ∞ (E₀ i))
    (hpen : ∀ (α β γ δ ε : ℝ) (y : AdelicGL2 (𝓞 F) F),
      ψ₀ (y * dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε)
        = ∑ i, A i α * B i β * Cf i γ * D₀ i δ * E₀ i ε * ψ₀ (y * kv₀ i))
    {y₀ : AdelicGL2 (𝓞 F) F} {μf ψf δf : ℝ → ℝ} (hμ : ContDiff ℝ ∞ μf) (hψ : ContDiff ℝ ∞ ψf)
    (hδ : ContDiff ℝ ∞ δf)
    (hwin : ∀ u ∈ Set.Icc aw bw, K u
      = ψ₀ (y₀ * dPhiW hw (μf u / 2) * rhoCW hw (ψf u / 2) * dPhiW hw (δf u)
          * rhoCW hw (ψf u / 2 + Real.pi / 2) * dPhiW hw (μf u / 2))) :
    ContDiffAt ℝ ∞ slice 0 := by
  have hΨcd := contDiff_psiWC_line hw hΨ hg z₀ θ
  have hwcd : ∀ i, ContDiff ℝ ∞ fun u => A i (μf u / 2) * B i (ψf u / 2) * Cf i (δf u)
      * D₀ i (ψf u / 2 + Real.pi / 2) * E₀ i (μf u / 2) := fun i =>
    contDiff_coeffWord (hsm i).1 (hsm i).2.1 (hsm i).2.2.1 (hsm i).2.2.2.1 (hsm i).2.2.2.2 hμ hψ hδ
  have hsum : ContDiff ℝ ∞ fun u : ℝ => ∑ i, c₀ * ψ₀ (y₀ * kv₀ i)
      * (psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I))))
        * (A i (μf u / 2) * B i (ψf u / 2) * Cf i (δf u) * D₀ i (ψf u / 2 + Real.pi / 2) * E₀ i (μf u / 2))) :=
    ContDiff.sum fun i _ => contDiff_const.mul (hΨcd.mul (hwcd i))
  refine hsum.contDiffAt.congr_of_eventuallyEq ?_
  filter_upwards [Icc_mem_nhds haw hbw] with u hu
  rw [hslice u, hwin u hu, hpen, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

private theorem contDiff_slice_line_c {χ₁ χ₂ : 𝔸ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    (hc₁ : Continuous fun r : ℂˣ => ((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℂˣ => ((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ))
    (E : ℝ → ℝ → 𝔸)
    (hEw : ∀ θ t : ℝ, (E θ t).1 w
      = (ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I)))
    (hEv : ∀ (θ t : ℝ) (v : InfinitePlace F), v ≠ w → (E θ t).1 v = 0)
    (hE2 : ∀ θ t : ℝ, (E θ t).2 = 0) (x : AdelicGL2 (𝓞 F) F) (a : 𝔸) (θ : ℝ) :
    ContDiff ℝ ∞ fun t : ℝ => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x) := by

  obtain ⟨N₁, kv₁, A₁, B₁, C₁, D₁, E₁, -, hsm₁, -, hpen₁⟩ := exists_expansion_penta hw hφc hK
  have hφ'c : Continuous fun y => φ (y * rhoCW hw (-(Real.pi / 2))) := hφc.comp (continuous_mul_const _)
  have hK' : IsArchKFiniteAt F w fun y => φ (y * rhoCW hw (-(Real.pi / 2))) :=
    rightTranslatesSpanFinite_mul hK (rhoCW_mem hw (-(Real.pi / 2)))
  obtain ⟨N₂, kv₂, A₂, B₂, C₂, D₂, E₂, -, hsm₂, -, hpen₂⟩ := exists_expansion_penta hw hφ'c hK'
  have hΨ : IsOneParamGroup (psiWC hw χ₁ χ₂) := isOneParamGroup_psiWC hw hc₁ hc₂
  have hg : (gOfC hw x).det ≠ 0 := gOfC_det_ne_zero hw x
  obtain ⟨w₀, hw₀, hwindow⟩ :=
    exists_uniform_window hw (S := {x}) isCompact_singleton (m := (1 : ℝ) / 4) (by norm_num)

  have core : ∀ a' : 𝔸,
      ContDiffAt ℝ ∞ (fun h : ℝ => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a' + E θ h) * x)) 0 := by
    intro a'
    obtain ⟨z₀, hz₀⟩ : ∃ z₀ : ℂ, z₀ = ringEquivComplexOfIsComplex hw (a'.1 w) := ⟨_, rfl⟩
    obtain ⟨y₀, hy₀⟩ : ∃ y₀ : AdelicGL2 (𝓞 F) F,
        y₀ = awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a' * x) := ⟨_, rfl⟩
    have hslice : ∀ u : ℝ, φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a' + E θ u) * x)
        = ((χ₁ (complexIdeleAt hw (detUnitC hw x)) : ℂˣ) : ℂ)
            * psiWC hw χ₁ χ₂ (Real.log (radC (gOfC hw x) (z₀ + u * Complex.exp (θ * Complex.I))))
            * φ (y₀ * kCW hw x (z₀ + u * Complex.exp (θ * Complex.I))) := by
      intro u
      rw [hz₀, hy₀]
      exact slice_translate_eq_c hw hφ x a' (hEw θ) (hEv θ) (hE2 θ) u
    have haw : -(w₀ / 2) < 0 := by linarith
    have hbw : 0 < w₀ / 2 := by linarith
    have hη : 0 < w₀ / 2 := hbw
    have hdefect : ∀ u ∈ Set.Icc (-(w₀ / 2) - w₀ / 2) (w₀ / 2 + w₀ / 2),
        |lineQSq (gOfC hw x) z₀ θ u - lineQSq (gOfC hw x) z₀ θ 0| ≤ 1 / 4 := fun u hu =>
      hwindow x (Set.mem_singleton x) z₀ θ u (abs_le.2 ⟨by linarith [hu.1], by linarith [hu.2]⟩)
    rcases lineQSq_ge_half_or hg z₀ θ 0 with hQ | hP
    ·
      have hguard : ∀ u ∈ Set.Icc (-(w₀ / 2) - w₀ / 2) (w₀ / 2 + w₀ / 2),
          1 / 2 - 1 / 4 ≤ lineQSq (gOfC hw x) z₀ θ u := fun u hu => by
        have h := abs_le.1 (hdefect u hu)
        linarith [h.1]
      obtain ⟨μf, ψf, δf, hμs, hψs, hδs, hword, -, -, -, -, -⟩ :=
        exists_chart_angles hg z₀ θ (m := (1 : ℝ) / 4) (by norm_num) (by norm_num) hη
          (by linarith : -(w₀ / 2) ≤ w₀ / 2) hguard
      have hwin : ∀ u ∈ Set.Icc (-(w₀ / 2)) (w₀ / 2),
          φ (y₀ * kCW hw x (z₀ + u * Complex.exp (θ * Complex.I)))
            = φ (y₀ * dPhiW hw (μf u / 2) * rhoCW hw (ψf u / 2) * dPhiW hw (δf u)
                * rhoCW hw (ψf u / 2 + Real.pi / 2) * dPhiW hw (μf u / 2)) := by
        intro u hu
        rw [kCW_eq_word hw x (hword u hu)]
        simp only [mul_assoc]
      exact contDiffAt_zero_of_window hw (ψ₀ := φ) (kv₀ := kv₁) hΨ hg z₀ θ haw hbw hslice hsm₁ hpen₁
        hμs hψs hδs hwin
    ·
      have hguard : ∀ u ∈ Set.Icc (-(w₀ / 2) - w₀ / 2) (w₀ / 2 + w₀ / 2),
          1 / 2 - 1 / 4 ≤ normSq (linePhat (gOfC hw x) z₀ θ u) := fun u hu => by
        have h := abs_le.1 (hdefect u hu)
        have hu' := normSq_linePhat_add_lineQSq hg z₀ θ u
        have h0' := normSq_linePhat_add_lineQSq hg z₀ θ 0
        linarith [h.2]
      obtain ⟨μf, ψf, δf, hμs, hψs, hδs, hword, -, -, -, -, -⟩ :=
        exists_chart_angles_P hg z₀ θ (m := (1 : ℝ) / 4) (by norm_num) (by norm_num) hη
          (by linarith : -(w₀ / 2) ≤ w₀ / 2) hguard
      have hwin : ∀ u ∈ Set.Icc (-(w₀ / 2)) (w₀ / 2),
          φ (y₀ * kCW hw x (z₀ + u * Complex.exp (θ * Complex.I)))
            = (fun y => φ (y * rhoCW hw (-(Real.pi / 2))))
                (y₀ * dPhiW hw (μf u / 2) * rhoCW hw (ψf u / 2) * dPhiW hw (δf u)
                  * rhoCW hw (ψf u / 2 + Real.pi / 2) * dPhiW hw (μf u / 2)) := by
        intro u hu
        rw [kCW_eq_word_mul_rhoCW hw x (hword u hu)]
        simp only [mul_assoc]
      exact contDiffAt_zero_of_window hw (ψ₀ := fun y => φ (y * rhoCW hw (-(Real.pi / 2)))) (kv₀ := kv₂)
        hΨ hg z₀ θ haw hbw hslice hsm₂ hpen₂ hμs hψs hδs hwin

  refine contDiff_iff_contDiffAt.2 fun t₀ => ?_
  obtain ⟨g, hgdef⟩ : ∃ g : ℝ → ℂ,
      g = fun h : ℝ => φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ h) * x) := ⟨_, rfl⟩
  have hg0 : ContDiffAt ℝ ∞ g 0 := by
    rw [hgdef]
    exact core (a + E θ t₀)
  have hrebase : (fun t : ℝ => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x))
      = fun t : ℝ => g (t - t₀) := by
    funext t
    rw [hgdef]
    show φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)
      = φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ (t - t₀)) * x)
    rw [add_assoc, ← lineFamily_add hw hEw hEv hE2 θ t₀ (t - t₀), show t₀ + (t - t₀) = t by ring]
  rw [hrebase]
  exact ContDiffAt.comp (g := g) (f := fun t : ℝ => t - t₀) t₀ (by simpa only [sub_self] using hg0)
    (contDiffAt_id.sub contDiffAt_const)

