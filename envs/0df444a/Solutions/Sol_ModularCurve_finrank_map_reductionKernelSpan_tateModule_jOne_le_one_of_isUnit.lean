    have hu : Module.finrank K ↥(LinearMap.ker (Polynomial.aeval
          (phiK p K (JOne M) (MvPolynomial.X (Sum.inl ⟨p, Fact.out⟩))) (Pu.map (algebraMap ℤ_[p] K)))) =
        2 * (Module.finrank K (K ⊗[ℤ_[p]] TateModule p (JOne M)) -
