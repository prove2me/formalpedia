namespace MIPRE.LowDegree.BinaryLinear.IsPivotBasis
variable {n t : ℕ}
attribute [local instance] MIPRE.LowDegree.BinaryLinear.instFactPrimeOfNatNat_mIPRE
theorem _root_.solution {b : List (Pivot n t)} (hb : IsPivotBasis b)
    (r : Row n t) (j : Fin n) (hj : (typedReduce b r).1 j = 1) :
    IsPivotBasis (b ++ [(j, typedReduce b r)]) := by
  have hz := typedReduce_pivots_zero b hb r
  generalize typedReduce b r = s at hj hz ⊢
  induction b with
  | nil => exact ⟨hj, by simp, trivial⟩
  | cons p b ih =>
    refine ⟨hb.1, ?_, ih hb.2.2 (fun q hq => hz q (by simp [hq]))⟩
    intro q hq
    rcases List.mem_append.mp hq with hq | hq
    · exact hb.2.1 q hq
    · obtain rfl := List.mem_singleton.mp hq
      exact hz p (by simp)
end MIPRE.LowDegree.BinaryLinear.IsPivotBasis
