-- title:
--   Regularity of the pole chart over the fraction field
-- statement:
--   Let $R$ be a Noetherian integral domain, let $K_0$ be a field that is a fraction field of $R$, and let $F$ be a field equipped with compatible $R$- and $K_0$-algebra structures (a scalar tower $R \to K_0 \to F$). Let $j \in F$ be nonzero and transcendental over $R$, and assume that $F$ is finite-dimensional and separable over the intermediate field $K_0(j) =$ `IntermediateField.adjoin K₀ {j}`. Write $A_\infty$ for `chartAlgInf R F j`, the $R$-subalgebra of $F$ consisting of those elements of $F$ that are integral over the $R$-subalgebra generated by $j^{-1}$; that is, the integral closure of $R[j^{-1}]$ in $F$. The assertion is that for every maximal ideal $\mathfrak m$ of the tensor product $K_0 \otimes_R A_\infty$, the localisation $(K_0 \otimes_R A_\infty)_{\mathfrak m}$ is a regular local ring and its Krull dimension, as an element of $\mathbb{N}_\infty$ (extended by a bottom element), equals $1$.
--
--   This is the statement that the generic fibre of the two-chart integral model of the relevant curve is regular of dimension one on the chart given by the integral closure of $R[j^{-1}]$, the counterpart of the same assertion for the $j$-finite chart. It feeds into the computation of the stalks of [`AlgebraicCurve.TwoChartIntegralModel`](def/AlgebraicCurve_TwoChartIntegralModel.html#L236) above the generic point of $\operatorname{Spec} R$, via [`AlgebraicCurve.TwoChartIntegralModel.isRegularLocalRing_stalk_of_asIdeal_eq_bot`](thm.html#AlgebraicCurve.TwoChartIntegralModel.isRegularLocalRing_stalk_of_asIdeal_eq_bot).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_TwoChartIntegralModel_isRegularLocalRing_localization_fractionRing_tensor_chartAlgInf.lean

import Mathlib
import Definitions.Def_AlgebraicCurve_TwoChartIntegralModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open scoped TensorProduct

theorem AlgebraicCurve.TwoChartIntegralModel.isRegularLocalRing_localization_fractionRing_tensor_chartAlgInf
    (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    (K₀ : Type u) [Field K₀] [Algebra R K₀] [IsFractionRing R K₀]
    (F : Type u) [Field F] [Algebra R F] [Algebra K₀ F] [IsScalarTower R K₀ F]
    (j : F) [Fact (j ≠ 0)] (htj : Transcendental R j)
    (hFD : FiniteDimensional ↥(IntermediateField.adjoin K₀ ({j} : Set F)) F)
    (hsep : Algebra.IsSeparable ↥(IntermediateField.adjoin K₀ ({j} : Set F)) F)
    (m : Ideal (K₀ ⊗[R] ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgInf R F j))) [m.IsMaximal] :
    IsRegularLocalRing (Localization.AtPrime m) ∧
      ringKrullDim (Localization.AtPrime m) = (1 : ℕ∞) := by sorry
