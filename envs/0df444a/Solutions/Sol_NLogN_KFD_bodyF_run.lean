variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (N : ℕ) [NeZero N] (P L' : ℕ)
  (A B Cs : Shape) {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem permT_ok : SrcOK W (NLogN.KIL.permT C) := by
  intro n hn
  simp only [NLogN.KIL.permT, dif_pos hn]
  exact ⟨fun w' hw' => by simp at hw'; rw [hw']; exact (C.ρ _).2,
    by simp; exact NeZero.pos W⟩

theorem length_runC {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
    (child : Fin n → Fin n → List (ZMod 2) → List (ZMod 2)) :
    ∀ (steps : List (Step n Q)),
    (∀ a b, Step.swap a b ∈ steps → ∀ ys, ys.length = vol sh → (child a b ys).length = vol sh) →
    ∀ (xs : List (ZMod 2)), xs.length = vol sh → (runC Λ child 0 steps xs).length = vol sh
  | [], _, _, h => h
  | s :: rest, hch, xs, h => by
    show (runC Λ child 0 rest (stepC Λ child 0 xs s)).length = vol sh
    apply length_runC Λ child rest (fun a b hab => hch a b (List.mem_cons_of_mem _ hab))
    cases s with
    | shift i u c => simp [stepC, Step.arr]
    | swap a b => exact hch a b List.mem_cons_self xs h

end Level

