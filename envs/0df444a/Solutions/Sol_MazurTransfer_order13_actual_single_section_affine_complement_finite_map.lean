variable (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]

omit [IsDomain R] [IsNoetherianRing R] in
theorem ordinaryInfinityChartMap_overlap_factorization :
    Spec.map (CommRingCat.ofHom (ordinaryOverlapToInfinity R).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (CoordinateRing R) (OrdinaryOverlapRing R))) =
        ordinaryInfinityChartMap R := by
  change Spec.map (CommRingCat.ofHom (ordinaryOverlapToInfinity R).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (CoordinateRing R) (OrdinaryOverlapRing R))) =
    Spec.map (CommRingCat.ofHom (algebraMap (CoordinateRing R) (ordinaryInfinityLocalization R)))
  rw [← Spec.map_comp]
  apply congrArg Spec.map
  apply CommRingCat.hom_ext
  apply RingHom.ext
  exact ordinaryOverlapToInfinity_algebraMap R

theorem ordinaryInfinityToReciprocalPatch_overlap_factorization (h104 : IsUnit (104 : R)) :
    ordinaryInfinityToReciprocalPatch R h104 ≫ reciprocalPatchInclusion R =
      Spec.map (CommRingCat.ofHom (ordinaryOverlapToInfinity R).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (reciprocalToOrdinaryBase R).toRingHom) := by
  change Spec.map (CommRingCat.ofHom
      ((infinityLocalizedInclusion R).comp (recoveredReciprocalPatchEquiv R h104).toAlgHom).toRingHom) ≫
    Spec.map (CommRingCat.ofHom (algebraMap (ReciprocalRing R) (Order13SingleSectionReciprocalPatch.PatchRing R))) =
      Spec.map (CommRingCat.ofHom (ordinaryOverlapToInfinity R).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (reciprocalToOrdinaryBase R).toRingHom)
  rw [← Spec.map_comp,← Spec.map_comp]
  apply congrArg Spec.map
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro a
  change infinityLocalizedInclusion R
    (recoveredReciprocalPatch R (two_isUnit_of_104 R h104)
      (algebraMap (ReciprocalRing R) (Order13SingleSectionReciprocalPatch.PatchRing R) a)) =
    ordinaryOverlapToInfinity R (reciprocalToOrdinaryBase R a)
  rw [recoveredReciprocalPatch_algebraMap]
  exact DFunLike.congr_fun (recovered_reciprocal_ordinary_comparison_square R) a

omit [IsDomain R] [IsNoetherianRing R] in
theorem ordinary_reciprocal_glue_base :
    Spec.map (CommRingCat.ofHom (algebraMap (CoordinateRing R) (OrdinaryOverlapRing R))) ≫
      ordinaryChartMap R =
    Spec.map (CommRingCat.ofHom (reciprocalToOrdinaryBase R).toRingHom) ≫ reciprocalChartMap R := by
  have he : Spec.map (CommRingCat.ofHom (reciprocalToOrdinaryBase R).toRingHom) =
      Spec.map (CommRingCat.ofHom (reciprocalToOrdinary R).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap (ReciprocalRing R) (ReciprocalOverlapRing R))) := by
    rw [← Spec.map_comp]
    apply congrArg Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    exact (reciprocalToOrdinary_algebraMap R a).symm
  rw [he,Category.assoc]
  exact Order13ActualCurveBaseChange.ordinary_reciprocal_glue R

theorem finiteScheme_concrete_overlap_curve_compatibility (h104 : IsUnit (104 : R)) :
    ordinaryInfinityChartMap R ≫ ordinaryChartMap R =
      ordinaryInfinityToReciprocalPatch R h104 ≫ reciprocalPatchChartMap R := by
  rw [← ordinaryInfinityChartMap_overlap_factorization,Category.assoc,
    ordinary_reciprocal_glue_base]
  rw [reciprocalPatchChartMap]
  simpa only [Category.assoc] using congrArg (fun f => f ≫ reciprocalChartMap R)
