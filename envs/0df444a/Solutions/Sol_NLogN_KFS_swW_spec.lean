theorem solution :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (Pre G Suf : AModel.Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (xs : List ℤ) (R : List NLogN.Item),
      t.G 0 = NLogN.ints xs ++ R → xs.length = AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) →
      (∀ x ∈ xs, NLogN.zsz x ≤ w) →
      ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFS.swW q w Pre G Suf u) t
        (t.upd 0 (NLogN.ints (AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (2 ^ u))
          (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs) ++ R)) c ∧
        (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ τS := by
  obtain ⟨T, q₀, H⟩ := NLogN.KFL.swI_spec
  refine ⟨q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  refine ⟨2 * 10 ^ 4 + K, by positivity, fun u w Pre G Suf hu hPre hG hS I t xs R h0 hxl hxw => ?_⟩
  set sh := AModelL12.binShape Pre G Suf (2 ^ u) with hsh
  set N := AModel.vol sh
  set pp := Pre.length
  set qq := Pre.length + 1 + G.length
  obtain ⟨hp, hq'⟩ := NLogN.KFS.binShape_len_ok Pre G Suf (2 ^ u)
  have hs := NLogN.KFS.binShape_getD_eq Pre G Suf (2 ^ u)
  -- 1. to bits
  have S1 := NLogN.KFL.toBitsI_spec (I := I) (iprog := NLogN.KFL.l12prog) t xs w hxw R h0
  rw [hxl] at S1
  set xb := NLogN.KFL.bitsL w xs
  set t1 := t.upd 0 (NLogN.ints xb ++ R)
  -- 2. Lemma 12 on the bit array
  have hSuf' : ∀ a ∈ Suf ++ [w + 1], 1 ≤ a := by
    intro a ha; simp only [List.mem_append, List.mem_singleton] at ha
    rcases ha with ha | rfl
    · exact hS a ha
    · omega
  have hxbb : NLogN.KFL.Bits xb := NLogN.KFL.bits_bitsL w xs
  set xz : List (ZMod 2) := xb.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hxz : NLogN.KIL.enc2 xz = xb := NLogN.KFL.bits_enc2 xb hxbb
  have hxzl : xz.length = AModel.vol (AModelL12.binShape Pre G (Suf ++ [w + 1]) (2 ^ u)) := by
    rw [List.length_map, NLogN.KFL.length_bitsL, hxl, NLogN.KFS.vol_binShape_snoc]
  obtain ⟨c2, S2, hc2⟩ := HK u Pre G (Suf ++ [w + 1]) hu hPre hG hSuf' I t1 xz R
    (by simp [t1, hxz]) hxzl
  rw [hxz, NLogN.KFS.binShape_snoc, ← NLogN.KFS.bitsL_pull_swapPos sh hp hq' hs w xs hxl] at S2
  have ev : AModel.vol (Suf ++ [w + 1]) = AModel.vol Suf * (w + 1) := by rw [AModel.vol_append]; simp
  rw [ev] at S2
  set ys := AModel.pull sh sh (AModel.swapPos pp qq) 0 xs
  set t2 := t1.upd 0 (NLogN.ints (NLogN.KFL.bitsL w ys) ++ R)
  -- 3. back to integers
  have hval : ∀ a, AModel.Valid sh a → AModel.Valid sh (AModel.swapPos pp qq a) := fun a ha =>
    AModel.valid_swapPos hp hq' hs ha
  have hyw : ∀ y ∈ ys, NLogN.zsz y ≤ w := fun y hy => hxw y (NLogN.KFS.mem_pull_of_valid hval hxl hy)
  have hyl : ys.length = N := AModel.length_pull _ _ _ _ _
  have S3 := NLogN.KFL.fromBitsI_spec (I := I) (iprog := NLogN.KFL.l12prog) t2 ys w hyw R (by simp [t2])
  rw [hyl] at S3
  refine ⟨_, (S1.seq (S2.seq S3)).mono' ?_ le_rfl, ?_⟩
  · simp [t2, t1]
  · rw [NLogN.KFS.vol_binShape_snoc] at hc2
    exact NLogN.KFS.cost_comb hK (Real.one_le_rpow (by exact_mod_cast hu) (by norm_num)) (NLogN.KFL.cTo_le N w)
      (NLogN.KFL.cFrom_le N w) hc2
