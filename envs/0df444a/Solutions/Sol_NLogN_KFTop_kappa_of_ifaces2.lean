  have h3 := mvLoop_runs (I := I) (iprog := iprog) X Y hXY B L s1 R hB hX1
  set s2 := (s1.upd X (.mark :: R)).upd Y (ints L.reverse ++ s1.G Y) with hs2
  have hX2 : s2.G X = .mark :: R := by simp [hs2, hXY]
  have h4 := IRuns.unmark (I := I) (iprog := iprog) hX2
