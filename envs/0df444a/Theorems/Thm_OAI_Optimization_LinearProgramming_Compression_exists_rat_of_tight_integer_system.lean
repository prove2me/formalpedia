theorem exists_rat_of_tight_integer_system {K : Type*} [Field K] [CharZero K]
    (A : Matrix ι ι ℤ) (b : ι → ℤ) {B : ℕ}
    (hA : ∀ i j, (A i j).natAbs ≤ B) (hb : ∀ i, (b i).natAbs ≤ B)
    (hdet : A.det ≠ 0) (x : ι → K)
    (hx : (A.map (fun z : ℤ => (z : K))) *ᵥ x = fun i => (b i : K)) :
