-- title:
--   §IV, pp. 187–188 — the w-process: transition probabilities (4.1)–(4.2), distribution paths, problem P.2 and its functional (4.4)
-- statement:
--   This module defines the process of conditional state distributions of §IV and problem P.2.
--
--   1. **Transition probabilities** (4.1)–(4.2): from the distribution $y$ under the control $u$,
--   $$
--   P(y,\Gamma,u)=\sum_{k\in K}\|z^k(u,y)\|,\qquad K=\Big\{k:\ \frac{z^k(u,y)}{\|z^k(u,y)\|}\in\Gamma\Big\}.
--   $$
--   2. **Distribution paths**: under the Markov law $u(t)=c^0(w(t),t)$, the path $(w(1),\dots,w(n))$ generated by the outputs $\eta(n)$, and the probability that this path has a given property, computed from the joint law of states and outputs.
--   3. **Problem P.2**: a P.2 law chooses $u(t)$ from the history $w(1),\dots,w(t)$, and is admissible if $u(t)\in U$ for $t=1,\dots,N$. The functional (4.4) is $E\sum_{t=1}^N\big(g(u(t),t),w(t)\big)$ with $g(u,t)=(g(u,1,t),\dots,g(u,n,t))$ (4.3), the expectation being over the $w$-process: $w(1)$ is the posterior after $\eta_1=j$ with probability $P(y_1=j)$, and from $w(t)$ the process moves to $z^j/\|z^j\|$ with probability $\|z^j\|$. P.2 asks for an admissible law whose value of (4.4) is no larger than that of any admissible P.2 law.
--   4. **The P.2 law** $u(t)=c^0(w(t),t)$, which uses only the current distribution.
--
--   P.2 is a control problem with complete state information on the space of probability distributions over the states; Theorem 3 says it is equivalent to P.1.
--
--   **Formalization Note** The expectation (4.4) is written branch by branch, summing over the outputs $j$ with weight $\|z^j\|$; branches with the same next distribution are not merged, which gives the same value as the expectation under (4.1) (the grouping identity of the mission). The paper lets $u(t)$ depend also on $w(0)$, which is deterministic and is omitted.
-- source:
--   Åström, Optimal Control of Markov Processes with Incomplete State Information, J. Math. Anal. Appl. 10(1):174–205 (1965), DOI 10.1016/0022-247X(65)90154-X, pp. 187–188, §IV, (4.1)–(4.4), Lemma 1, problem P.2

import Mathlib
import Definitions.Def_AstromPOMDP_Reduction_Belief

namespace AstromPOMDP.Reduction

open Classical in
/-- (4.1)–(4.2): the transition probability of the `w`-process,
`P(y, Γ, u) = Σ_{k ∈ K} ‖z^k(u, y)‖` with `K = {k ; z^k(u, y)/‖z^k(u, y)‖ ∈ Γ}`, from the current
distribution `w = y` at time `t` under the control `u`. -/
noncomputable def kernelProb {St Obs : Type*} [Fintype St] [Fintype Obs] {r : ℕ}
    (M : Model St Obs r) (u : Fin r → ℝ) (t : ℕ) (w : St → ℝ) (Γ : Set (St → ℝ)) : ℝ :=
  ∑ j, if bayesNext M u t w j ∈ Γ then l1 (zvec M u t w j) else 0

variable {St Obs : Type*} [Fintype St] [DecidableEq St] [Fintype Obs] {r : ℕ}

/-- The path `(w(1), …, w(n))` of conditional distributions generated by (3.25) under the Markov
law `u(t) = c⁰(w(t), t)` along the outputs `η = (η₁, …, η_n)`; entry `s` is `w(s + 1)`. -/
noncomputable def beliefPath (M : Model St Obs r) (c₀ : (St → ℝ) → ℕ → (Fin r → ℝ)) (n : ℕ)
    (η : Fin n → Obs) : Fin n → St → ℝ :=
  fun s => markovBelief M c₀ (s.val + 1) (Fin.take (s.val + 1) s.isLt η)

open Classical in
/-- Under the Markov law `u(t) = c⁰(w(t), t)`, the probability that the path `(w(1), …, w(n))`
of conditional distributions has the property `E`: the sum of `P(y₁ = η₁, …, y_n = η_n)`, computed
from the joint law of states and outputs, over the output sequences whose path has property `E`. -/
noncomputable def beliefEventProb (M : Model St Obs r) (c₀ : (St → ℝ) → ℕ → (Fin r → ℝ)) (n : ℕ)
    (E : (Fin n → St → ℝ) → Prop) : ℝ :=
  ∑ η : Fin n → Obs, if E (beliefPath M c₀ n η) then obsProb M (markovLaw M c₀) n η else 0

/-- A control law for problem P.2 (p. 188): `d t h` is the control `u(t)` chosen from the history
`h = (w(1), …, w(t))` of conditional distributions ("The value of u at time t may depend on
w(0), w(1), …, w(t)"; `w(0)` is deterministic and is omitted). -/
abbrev BeliefLaw (St : Type*) (r : ℕ) : Type _ := (t : ℕ) → (Fin t → St → ℝ) → (Fin r → ℝ)

/-- A P.2 law is admissible if `u(t) ∈ U` for `t = 1, …, N` and every history. -/
def BeliefAdmissible (M : Model St Obs r) (d : BeliefLaw St r) : Prop :=
  ∀ t : ℕ, 1 ≤ t → t ≤ M.N → ∀ h : Fin t → St → ℝ, d t h ∈ M.U

/-- The expected cost of the remaining `n` steps of the `w`-process under the P.2 law `d`, when the
history at time `t + 1` is `h = (w(1), …, w(t + 1))`: the step cost `(g(u, t + 1), w(t + 1))`
(4.3) plus, for each output `j`, the probability `‖z^j(u, w(t + 1))‖` of moving to
`z^j/‖z^j‖` times the expected remaining cost from there ((4.1), branch by branch). -/
noncomputable def p2Tail (M : Model St Obs r) (d : BeliefLaw St r) :
    (n t : ℕ) → (Fin (t + 1) → St → ℝ) → ℝ
  | 0, _, _ => 0
  | n + 1, t, h =>
      ∑ i, M.g (d (t + 1) h) i (t + 1) * h (Fin.last t) i +
        ∑ j, l1 (zvec M (d (t + 1) h) (t + 1) (h (Fin.last t)) j) *
          p2Tail M d n (t + 1)
            (Fin.snoc h (bayesNext M (d (t + 1) h) (t + 1) (h (Fin.last t)) j))

/-- (4.4): the functional `E Σ_{t=1}^N (g(u(t), t), w(t))` of the P.2 law `d`, the expectation
being over the `w`-process started from `w(1) = bayes1 j` with probability `P(y₁ = j)`. -/
noncomputable def p2Cost (M : Model St Obs r) (d : BeliefLaw St r) : ℝ :=
  ∑ j, prob1 M j * p2Tail M d M.N 0 (fun _ => bayes1 M j)

/-- Problem P.2 (p. 188): `d` is admissible and (4.4) is no larger under `d` than under every
admissible P.2 law. -/
def IsOptimalP2 (M : Model St Obs r) (d : BeliefLaw St r) : Prop :=
  BeliefAdmissible M d ∧ ∀ d' : BeliefLaw St r, BeliefAdmissible M d' → p2Cost M d ≤ p2Cost M d'

/-- The P.2 law `u(t) = c⁰(w(t), t)` that uses only the current distribution `w(t)` (the last
entry of the history). At `t = 0` (empty history, never used) it takes the value `c⁰(p₁, 0)`. -/
noncomputable def markovBeliefLaw (M : Model St Obs r) (c₀ : (St → ℝ) → ℕ → (Fin r → ℝ)) :
    BeliefLaw St r
  | 0, _ => c₀ M.p₁ 0
  | t + 1, h => c₀ (h (Fin.last t)) (t + 1)

end AstromPOMDP.Reduction


