-- Source module: Solutions.R6CxMerge
/-!
# NC3: the PR #15 whole-residual merge

For a linearly independent family `v₁, …, v_ρ` in `𝔽₂^m` (e.g. an orthonormal residual basis of
a Proposition 8 edge) and signs `ε_k = ±1`, the edge operator
`∏_k (aI + bX_{v_k})^{ε_k}` (on every column: `colT (∏ Tk ε_k v_k)`) is conjugate, by a word of
binary row additions `P` (an element of `GL_m(𝔽₂)` sending `v_k ↦ e_{h_k}`), to
`(-i)^{|N||κ|} Z_N C^{⊗(S × κ)} Z_N` with `S = {h_k}` (`|S| = ρ`) and `N = {h_k : ε_k = -1}`:
**one** forward child call of width `ρ`.

* `conj_rowAdds`: conjugation of a kernel product by row additions (15).
* `kernels_single`: kernels on distinct unit vectors `e_{h_k}` = the slot family (they live on
  distinct slots and commute).
* `exists_rowAdds`: every independent family is sent to distinct unit vectors by a word of row
  additions (basis extension + `gl_f2_row_additions`).
* **`merge_identity`** (operator form) and **`merge_chunk`** (step form: row additions, one
  child `child w S neg`, row additions reversed).
* `mergedChunk`, `mergedChunk_den`, `mergedChunk_widths`: the chosen chunk for a kernel list
  `L` (in `P8Lift.frameSteps` form) with independent vectors; `mergedChunk_den_frameSteps`:
  same denotation as the single-slot chunks `frameSteps w L`, but child widths `[|L|]`
  instead of `|L|` ones. Orthonormal version `lin_indep_of_orthonormal`.
* `edgeStepsH`: the merged frame change of a Proposition 8 edge (`EdgeP`): denotation
  `wireOp w (PhiK (qL V - qL U))` as `P8Lift.edgeSteps`, one child of width `Fd V U`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-! ## Row-addition words -/

/-! ## Kernels on distinct unit vectors -/

/-! ## Existence of the row-addition word -/

/-! ## The merge identity -/

/-! ## Step form -/

section Steps

variable {R : Type} [Fintype R] [DecidableEq R]

theorem mergedChunk_den (w : R) (L : List (ℤ × (Fin m → ZMod 2)))
    (hε : ∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) (hL : LIndep L) :
    denListH (chEx (κ := κ)) (mergedChunk w L) = wireOp w (colT (L.map fun p => Tk p.1 p.2).prod) := by
  by_cases h0 : L = []
  · subst h0; simp [mergedChunk, colT_one, wireOp_one]
  have hc : L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L := ⟨h0, hε, hL⟩
  unfold mergedChunk
  rw [dif_pos hc]
  rw [(Classical.choose_spec (merge_chunk w (fun k => (L.get k).1)
      (fun k => hc.2.1 _ (List.get_mem L k)) _ hc.2.2)).2 κ, prod_finRange_get]

theorem mergedChunk_widths (w : R) (L : List (ℤ × (Fin m → ZMod 2)))
    (hε : ∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) (hL : LIndep L) :
    (mergedChunk w L).filterMap HStep.width = if L = [] then [] else [L.length] := by
  by_cases h0 : L = []
  · subst h0; simp [mergedChunk]
  have hc : L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L := ⟨h0, hε, hL⟩
  unfold mergedChunk
  rw [dif_pos hc, if_neg h0]
  exact (Classical.choose_spec (merge_chunk w (fun k => (L.get k).1)
      (fun k => hc.2.1 _ (List.get_mem L k)) _ hc.2.2)).1

/-- Orthonormal residual bases are independent. -/
theorem lin_indep_of_orthonormal (L : List (ℤ × (Fin m → ZMod 2))) (B : Finset (Fin m → ZMod 2))
    (hB : NetComplexOrtho.Orthonormal2 B) (hLB : L.map Prod.snd = B.toList) : LIndep L := by
  have hli := NetComplexOrtho.orthonormal_linearIndependent hB
  have hmem : ∀ k : Fin L.length, (L.get k).2 ∈ B := by
    intro k
    rw [← Finset.mem_toList, ← hLB]
    exact List.mem_map_of_mem (List.get_mem L k)
  have hnd : (L.map Prod.snd).Nodup := by rw [hLB]; exact Finset.nodup_toList B
  have hinj : Function.Injective fun k : Fin L.length => (⟨(L.get k).2, hmem k⟩ : B) := by
    intro k k' hk
    have e : (L.get k).2 = (L.get k').2 := congrArg Subtype.val hk
    have e' : (L.map Prod.snd)[k.val]'(by simp) = (L.map Prod.snd)[k'.val]'(by simp) := by
      simp only [List.getElem_map]; exact e
    exact Fin.ext ((hnd.getElem_inj_iff).1 e')
  have h2 := hli.comp _ hinj
  unfold LIndep
  convert h2 using 1
  funext k; rfl

end Steps

/-! ## Merged Proposition 8 edges -/

end IntMul.Kappa.R6.Cx

