  obtain ⟨n₂, h'⟩ := r6_axis_fit P hP
  obtain ⟨n₃, h''⟩ := eventually_d_ge P hP 14
  refine ⟨max n₁ (max n₂ n₃), fun n hn src hsrc D hD _ _ M hM ys y hrep hy => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
