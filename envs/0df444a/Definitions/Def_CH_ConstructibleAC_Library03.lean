    triple a b c ∈ F3 x r ↔ b ∈ x ∧ ZFSet.pair a c ∈ r := by
  rw [mem_F3_iff]
  constructor
  · rintro ⟨a', b', c', hb', hac', h⟩
    rcases ZFSet.pair_inj.mp h with ⟨rfl, htail⟩
    rcases ZFSet.pair_inj.mp htail with ⟨rfl, rfl⟩
    exact ⟨hb', hac'⟩
  · rintro ⟨hb, hac⟩
    exact ⟨a, b, c, hb, hac, rfl⟩

