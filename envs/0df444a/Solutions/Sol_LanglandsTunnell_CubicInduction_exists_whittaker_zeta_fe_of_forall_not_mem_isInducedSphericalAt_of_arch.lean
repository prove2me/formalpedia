  rw [prod_stdRootNumberAt_mul_of_hasConductorExponentAt_zero v ν a hν hνu (localChar χ v) hχ0 hχu, hθ, hθμ, hsum,
    finprod_mem_congr rfl hR, finprod_mem_mul_distrib hF, ← hF.coe_toFinset, finsum_mem_coe_finset,
    finprod_mem_coe_finset, finprod_mem_coe_finset, zpow_sum_eq_prod_zpow _ hz]

private theorem hasConductorExponentAt_mul_eq (v : HeightOneSpectrum (𝓞 ℚ)) (ν χ : (v.adicCompletion ℚ)ˣ →* ℂˣ)
    (a a' : ℕ) (hχ : HasConductorExponentAt ℚ v χ 0) (h : HasConductorExponentAt ℚ v ν a)
    (h' : HasConductorExponentAt ℚ v (ν * χ) a') : a' = a := by
  exact hasConductorExponentAt_unique ℚ v h'
    (hasConductorExponentAt_mul_of_hasConductorExponentAt_zero ℚ v ν χ a h hχ)

