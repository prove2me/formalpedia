import Definitions.Def_QFS_Renormalization
import Definitions.Def_QFS_FirstJump
import Mathlib

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option maxSynthPendingDepth 3

open Real Set Metric

open QFS

variable {V : Type*} {G : SimpleGraph V}

theorem QFS.exists_walk_of_reflTransGen_lt {r : V → V → Prop} {S : Set V}
    (hSfin : S.Finite) (hadj : ∀ a b, r a b → a = b ∨ G.Adj a b)
    (hmem : ∀ a b, r a b → a ∈ S ∧ b ∈ S)
    {a b : V} (ha : a ∈ S) (h : Relation.ReflTransGen r a b) :
    ∃ w : G.Walk a b, (∀ v ∈ w.support, v ∈ S) ∧ w.length < S.ncard := by sorry
