theorem glue_S2_chain
    (q : ℕ)
    (W₀ : Type) [CommRing W₀] [IsDomain W₀] [IsDiscreteValuationRing W₀] [IsAdicComplete (maximalIdeal W₀) W₀]
    (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})
    (S₀ : Type) [CommRing S₀] [IsLocalRing S₀] [IsNoetherianRing S₀] [Algebra W₀ S₀]
    (e₀ : S₀ ≃ₐ[W₀] PowerSeries W₀)
    (S : Type) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [IsAdicComplete (maximalIdeal S) S]
    [Algebra W₀ S] [Algebra S₀ S] [IsScalarTower W₀ S₀ S] [Module.Finite S₀ S]
    (hinj : Function.Injective (algebraMap S₀ S))
    (hres : Function.Surjective (⇑(residue S) ∘ ⇑(algebraMap W₀ S)))
    (Φ₁ : S →ₐ[W₀] DualNumber (ResidueField S)) (hΦ₁ : ∀ r : S, (Φ₁ r).fst = residue S r)
    (hdim : ∀ Φ : S →ₐ[W₀] DualNumber (ResidueField S), (∀ r : S, (Φ r).fst = residue S r) →
      ∃ c : ResidueField S, ∀ r : S, (Φ r).snd = c * (Φ₁ r).snd) :
    ∃ (y : S) (_ : IsDomain S) (_ : IsRegularLocalRing S) (e : PowerSeries W₀ ≃ₐ[W₀] S),
      e PowerSeries.X = y ∧ y ∈ maximalIdeal S ∧ ringKrullDim S = 2 ∧
      maximalIdeal S = Ideal.span {algebraMap W₀ S q, y} := by
  classical

  obtain ⟨y, hy, hcot⟩ :=
    IsLocalRing.exists_maximalIdeal_le_span_sup_sq_sup_map_of_forall_algHom_dualNumber (Λ := W₀) (R := S)
      hres Φ₁ hΦ₁ hdim

  have hmap : (maximalIdeal W₀).map (algebraMap W₀ S) = Ideal.span {algebraMap W₀ S q} := by
    rw [hW₀, Ideal.map_span, Set.image_singleton]
  have hgen : maximalIdeal S ≤ Ideal.span {algebraMap W₀ S q, y} ⊔ maximalIdeal S ^ 2 := by
    intro s hs
    have := hcot hs
    rw [hmap] at this
    have hle : Ideal.span {y} ⊔ maximalIdeal S ^ 2 ⊔ Ideal.span {algebraMap W₀ S (q : W₀)} ≤
        Ideal.span {algebraMap W₀ S q, y} ⊔ maximalIdeal S ^ 2 := by
      refine sup_le (sup_le ?_ le_sup_right) ?_
      · exact le_sup_of_le_left (Ideal.span_mono (by simp))
      · exact le_sup_of_le_left (Ideal.span_mono (by simp))
    exact hle this
  have hqS : algebraMap W₀ S (q : W₀) ∈ maximalIdeal S := by
    set f : W₀ →+* ResidueField S := (residue S).comp (algebraMap W₀ S) with hf_def
    have hf : Function.Surjective f := hres
    have hker : RingHom.ker f ≠ ⊥ := by
      intro hbot
      have hinj : Function.Injective f := (RingHom.injective_iff_ker_eq_bot f).mpr hbot
      have : IsField W₀ :=
        MulEquiv.isField (Field.toIsField (ResidueField S)) (RingEquiv.ofBijective f ⟨hinj, hf⟩).toMulEquiv
      exact IsDiscreteValuationRing.not_isField W₀ this
    haveI : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
    have hmax : (RingHom.ker f).IsMaximal := IsPrime.to_maximal_ideal hker
    have hkq : (q : W₀) ∈ RingHom.ker f := by
      rw [IsLocalRing.eq_maximalIdeal hmax, hW₀]; exact Ideal.mem_span_singleton_self _
    have : residue S (algebraMap W₀ S (q : W₀)) = 0 := hkq
    rwa [residue_eq_zero_iff] at this

  haveI : IsDomain S₀ := e₀.toRingEquiv.toMulEquiv.isDomain_iff.mpr inferInstance
  have hdim₀ : ringKrullDim S₀ = 2 := by
    rw [ringKrullDim_eq_of_ringEquiv e₀.toRingEquiv,
      ← ringKrullDim_eq_of_ringEquiv (MvPowerSeries.renameEquiv W₀ finOneEquiv).toRingEquiv,
      MvPowerSeries.ringKrullDim_fin_eq_of_isDiscreteValuationRing W₀ 1]
    norm_num
  obtain ⟨hreg, hdimS, h𝔪⟩ :=
    IsLocalRing.isRegularLocalRing_and_ringKrullDim_eq_two_of_finite_of_maximalIdeal_le_span_pair_sup_sq
      S₀ hdim₀ S hinj (algebraMap W₀ S q) y hgen hqS hy
  haveI := hreg
  haveI hdom : IsDomain S := IsRegularLocalRing.isDomain S
  obtain ⟨e, he⟩ :=
    IsLocalRing.exists_powerSeries_algEquiv_apply_X_eq_of_maximalIdeal_eq_span_pair_of_ringKrullDim_eq_two
      W₀ (q : W₀) hW₀ S hres y h𝔪 hdimS
  exact ⟨y, hdom, hreg, e, he, hy, hdimS, h𝔪⟩

end ChainS2_sec

