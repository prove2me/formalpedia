section s390
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma qualityBody_eval (s : Data) : Eval qualityBody s 2 (qualityAdvanced s) := eval_sequence_atoms qualityBodyAtoms s
lemma qualityAdvanced_fields (s : Data) (h1 : s.realReg 444 = 1) (h2 : s.realReg 446 = 2) :
    (qualityAdvanced s).realReg 440 = s.realReg 440+1 ∧
    (qualityAdvanced s).realReg 442 = 2*s.realReg 442 ∧
    (qualityAdvanced s).realReg 438 = s.realReg 438 ∧
    (qualityAdvanced s).realReg 444 = 1 ∧ (qualityAdvanced s).realReg 446 = 2 := by
  simp only [qualityAdvanced,qualityBodyAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  simp only [h1,h2]
  ring_nf
  trivial
lemma qualityLoop_eval (E : ℕ) (s : Data) (h : QualityRep E s) :
    ∃ t cost, Eval qualityLoop s cost t ∧ t.realReg 442 = (2 : ℝ)^E ∧
      cost ≤ 4*(E-⌊s.realReg 440⌋₊)+2 := by
  have hbody : ∀ s, QualityRep E s → (Test.realLess 440 438).holds s →
      ∃ t cost, Eval qualityBody s cost t ∧ QualityRep E t ∧
        E-⌊t.realReg 440⌋₊ < E-⌊s.realReg 440⌋₊ ∧ cost ≤ 2 := by
    intro s hs htest
    obtain ⟨j,hj,hcounter,hpower,hlimit,h1,h2⟩ := hs
    have hjlt : j < E := by
      change s.realReg 440 < s.realReg 438 at htest
      rw [hcounter,hlimit] at htest
      exact_mod_cast htest
    obtain ⟨hc,hp,hl,hu,ht⟩ := qualityAdvanced_fields s h1 h2
    have hc' : (qualityAdvanced s).realReg 440 = ((j+1 : ℕ) : ℝ) := by rw [hc,hcounter,Nat.cast_add,Nat.cast_one]
    have hrep : QualityRep E (qualityAdvanced s) := by
      refine ⟨j+1,by omega,hc',?_,hl.trans hlimit,hu,ht⟩
      rw [hp,hpower,pow_succ]
      ring
    refine ⟨qualityAdvanced s,2,qualityBody_eval s,hrep,?_,le_rfl⟩
    rw [hc',hcounter,Nat.floor_natCast,Nat.floor_natCast]
    omega
  obtain ⟨t,cost,he,ht,hcost⟩ := loop_bounded (.realLess 440 438) qualityBody (QualityRep E)
    (fun s => E-⌊s.realReg 440⌋₊) 2 hbody s h
  obtain ⟨j,hj,hcounter,hpower,hlimit,h1,h2⟩ := ht
  have hstop := eval_loop_stops (.realLess 440 438) qualityBody cost s t he
  have hjge : E ≤ j := by
    change ¬t.realReg 440 < t.realReg 438 at hstop
    rw [hcounter,hlimit] at hstop
    exact_mod_cast not_lt.mp hstop
  have heq : j = E := le_antisymm hj hjge
  exact ⟨t,cost,he,by rwa [heq] at hpower,hcost⟩
end DecrAlmostLinearSSSP.Decremental.CutQualityNative
