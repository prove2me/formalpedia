theorem GlobalTheory.Cyc.Procyclic.twHom_apply (i : ℤ) {r : ℕ} (U : GQ l → Matrix (Fin r) (Fin r) (PadicComplex l))
    (σ : GQ l) (y : Fin r → PadicComplex l) (a : Fin r) :
    twHom act χ i U σ y a = chiC χ i σ * ∑ b, U σ a b * act σ (y b) := by sorry
