lemma g53d_ptB_herm {A B : Type} {X : Matrix (A × B) (A × B) ℂ} (hX : X.IsHermitian) :
    (partialTransposeB X).IsHermitian := by
  ext a b
  simp only [Matrix.conjTranspose_apply, partialTransposeB,
    QAlgorithms.Entanglement.partialTransposeFirst, Matrix.of_apply]
  rw [← Matrix.conjTranspose_apply X, hX.eq]

/-- Lemma 12, arXiv:1706.06221v3, PDF p.19: semidefinite representation of PPT-prime.
Auxiliary positive operators need not have orthogonal support or trace one. -/
theorem solution {A B : Type} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B] [Nonempty A] [Nonempty B]
    (sigma : Matrix (A × B) (A × B) ℂ) :
    pptPrime sigma ↔ sigma.PosSemidef ∧
      ∃ plus minus : Matrix (A × B) (A × B) ℂ,
        plus.PosSemidef ∧ minus.PosSemidef ∧ partialTransposeB sigma = plus - minus ∧
        (plus + minus).trace.re ≤ 1 := by
  constructor
  · rintro ⟨hs, ht⟩
    refine ⟨hs, cfc (fun t : ℝ => max t 0) (partialTransposeB sigma),
      cfc (fun t : ℝ => max (-t) 0) (partialTransposeB sigma),
      g53_cfc_psd _ _ (fun t => le_max_right _ _), g53_cfc_psd _ _ (fun t => le_max_right _ _),
      (g53_parts _ (g53d_ptB_herm hs.1)).symm, ?_⟩
    rw [Matrix.trace_add, Complex.add_re, ← g53_traceNorm_herm (g53d_ptB_herm hs.1)]
    exact ht
  · rintro ⟨hs, P, M, hP, hM, he, ht⟩
    refine ⟨hs, ?_⟩
    have := g53d_tn_le (g53d_ptB_herm hs.1) hP hM he
    rw [Matrix.trace_add, Complex.add_re] at ht
    linarith

end
