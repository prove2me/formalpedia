def rawMonomial {p n : ℕ} (H : CMatrix) (A : Matrix (Fin p) (Fin n) ℤ)
    (ρ : Fin p ↪ Coord) (κ : Fin n → Coord) : ℂ :=
  ∏ i, ∏ j, H (ρ i) (κ j) ^ A i j

end MUB6

