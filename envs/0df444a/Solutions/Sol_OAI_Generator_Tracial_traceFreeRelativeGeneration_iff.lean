theorem mem_subalgebra_of_baseVector_mem {Q : VonNeumannAlgebra H}
    (hQM : Q ≤ M) (x : M.toStarSubalgebra)
    (hx : baseVector τ x ∈ vectorOrbitClosure Q.toStarSubalgebra τ.vector) :
