theorem hσ (x : Q.Xp) : Q.δ (Q.σ x) = Q.η • x := by
  rw [η_smul_Xp, famX_T_s]
  show Q.δ₀ (Q.σ₀ x) = (id (Q.compS (Q.compS x)) : Q.Xp) - x

  set x₁ : V → ℤ := ((x.1 : ↥(characterLattice V)) : V → ℤ) with hx₁
  set x₂ : V → ℤ := ((x.2 : ↥(characterLattice V)) : V → ℤ) with hx₂
  have hσ : ((Q.σ₀ x : ↥(characterLattice E)) : E → ℤ) =
      Q.padj 0 (-x₁) + Q.padj 1 ((Q.TV Q.s).mulVec x₁ - x₂) := rfl
  apply Prod.ext
  · apply Subtype.ext
    show (degeneracyMatrix Q.D.a).mulVec ((Q.σ₀ x : ↥(characterLattice E)) : E → ℤ) =
      (Q.TV Q.s).mulVec ((Q.TV Q.s).mulVec x₁ - x₂) - (((Q.s : ℕ) : ℤ) • x₁) - x₁
    rw [hσ, Matrix.mulVec_add, c3_deg0, Q.c3_ab]
    rw [add_smul, one_smul, smul_neg]
    abel
  · apply Subtype.ext
    show (degeneracyMatrix Q.D.b).mulVec ((Q.σ₀ x : ↥(characterLattice E)) : E → ℤ) =
      ((Q.s : ℕ) : ℤ) • ((Q.TV Q.s).mulVec x₁ - x₂) - x₂
    rw [hσ, Matrix.mulVec_add, Q.c3_ba, c3_deg1, Matrix.mulVec_neg, add_smul, one_smul]
    abel

