/-!
# Register programs with multiplication calls

`RM` extends the register programs `RS` by `mul k i j`, which pushes `top j * top i` onto `k`
by calling the multiplication procedure `pM` with the calling convention

  `ARG = 55 : a :: b :: L  ↦  (a * b) :: L`,

all other stacks unchanged.  The cost of a call and the inputs on which it may be used are a
parameter `M : MulSpec`; `RM.code_runs` holds whenever the procedure meets `MulOK M`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RM

open RS (decSt decE asgCost)

/-! ## Frame -/

theorem ne55 {i : Fin HS} (hi : i.val < 55) : i ≠ ARGM := by
  intro h; rw [h] at hi; exact absurd hi (by decide)

theorem mul_runs (M : MulSpec) (pM : Fin P) (pc : ℕ → Fin P) (hM : MulOK I iprog pM M) (k i j : Fin HS)
    (s : IState HS) (h : (mul k i j).ok M s) :
    IRuns I iprog ((mul k i j).code pM pc) s ((mul k i j).run s) ((mul k i j).cost M s) := by
  obtain ⟨hk, hi, hj, ⟨Li, hLi⟩, ⟨Lj, hLj⟩, hd⟩ := h
  have hk' := ne55 hk; have hi' := ne55 hi; have hj' := ne55 hj
  have h1 := IRuns.dup (I := I) (iprog := iprog) (s := s) (i := i) (j := ARGM) hi' hLi
  have h2 := IRuns.dup (I := I) (iprog := iprog) (s := s.upd ARGM (.int (s.top i) :: s.G ARGM))
    (i := j) (j := ARGM) hj' (a := s.top j) (L := Lj) (by simp [IState.upd_G, hj', hLj])
  have h3 := hM ((s.upd ARGM (.int (s.top i) :: s.G ARGM)).upd ARGM
    (.int (s.top j) :: (s.upd ARGM (.int (s.top i) :: s.G ARGM)).G ARGM)) (s.top j) (s.top i)
    (s.G ARGM) hd (by simp [IState.upd_G])
  have h4 := IRuns.mv (I := I) (iprog := iprog)
    (s := ((s.upd ARGM (.int (s.top i) :: s.G ARGM)).upd ARGM
    (.int (s.top j) :: (s.upd ARGM (.int (s.top i) :: s.G ARGM)).G ARGM)).upd ARGM
      (.int (s.top j * s.top i) :: s.G ARGM)) (i := ARGM) (j := k) (a := s.top j * s.top i)
    (L := s.G ARGM) (Ne.symm hk') (by simp [IState.upd_G])
  refine (h1.seq (h2.seq (h3.seq h4))).mono' ?_ ?_
  · simp only [run]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all
  · simp only [cost, mulCost]; omega

theorem code_runs_sol_aux (M : MulSpec) (pM : Fin P) (pc : ℕ → Fin P) (hM : MulOK I iprog pM M) :
    ∀ (p : RM), PrcOK I iprog pc p → ∀ (s : IState HS), p.ok M s →
    IRuns I iprog (p.code pM pc) s (p.run s) (p.cost M s)
  | rs p, _, s, h => RS.code_runs p s h
  | mul k i j, _, s, h => mul_runs M pM pc hM k i j s h
  | seq a b, hP, s, ⟨ha, hb⟩ => by
    exact ((code_runs_sol_aux M pM pc hM a hP.1 s ha).seq (code_runs_sol_aux M pM pc hM b hP.2 _ hb)).mono' rfl
      (by simp [cost])
  | prc q f c pre w hf hio, hP, s, h => hP s h
  | ite c a b, hP, s, ⟨hcc, hoc, hab⟩ => by
    have h1 := Ex.code_runs (I := I) (iprog := iprog) c s hcc hoc
    have h2 := IRuns.mv (I := I) (iprog := iprog) (s := s.upd 56 (.int (c.eval s) :: s.G 56))
      (i := zX.V) (j := zX.A) (a := c.eval s) (L := s.G 56) (by decide) (by simp)
    set s2 := ((s.upd 56 (.int (c.eval s) :: s.G 56)).upd zX.V (s.G 56)).upd zX.A
      (.int (c.eval s) :: (s.upd 56 (.int (c.eval s) :: s.G 56)).G zX.A)
    have hd := IRuns.drop (I := I) (iprog := iprog) (s := s2) (i := zX.A) (a := c.eval s)
      (L := s.G 57) (by simp [s2])
    have e3 : s2.upd zX.A (s.G 57) = s := by simp only [s2]; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))
    rw [e3] at hd
    by_cases hneg : c.eval s < 0
    · have hx := code_runs_sol_aux M pM pc hM a hP.1 s (by simpa [hneg] using hab)
      have hi := IRuns.iteT (I := I) (iprog := iprog) (i := zX.A) (f := fun k => k == .neg)
        (q := .seq (.op (.drop zX.A)) (b.code pM pc))
        (by rw [cl_int s2 zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; omega)
        (hd.seq hx)
      refine (h1.seq (h2.seq hi)).mono' (by simp [run, hneg]) ?_
      simp only [cost, if_pos hneg]; omega
    · have hy := code_runs_sol_aux M pM pc hM b hP.2 s (by simpa [hneg] using hab)
      have hi := IRuns.iteF (I := I) (iprog := iprog) (i := zX.A) (f := fun k => k == .neg)
        (p := .seq (.op (.drop zX.A)) (a.code pM pc))
        (by rw [cl_int s2 zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; split_ifs <;> simp)
        (hd.seq hy)
      refine (h1.seq (h2.seq hi)).mono' (by simp [run, hneg]) ?_
      simp only [cost, if_neg hneg]; omega
  | rep i n b, hP, s, ⟨hi, hc, hok, hn0, hw, hb⟩ => by
    have hne := RS.ne56 hi
    have hne' := Ne.symm hne
    have h1 := Ex.code_runs (I := I) (iprog := iprog) n s hc hok
    have h2 := IRuns.mv (I := I) (iprog := iprog)
      (s := s.upd 56 (.int (n.eval s) :: s.G 56)) (i := zX.V) (j := i) (a := n.eval s)
      (L := s.G 56) (by simpa using hne) (by simp [IState.upd_G])
    have e0 : ((s.upd 56 (.int (n.eval s) :: s.G 56)).upd zX.V (s.G 56)).upd i
        (.int (n.eval s) :: (s.upd 56 (.int (n.eval s) :: s.G 56)).G i) = repSt i n b s 0 := by
      simp only [repSt, Function.iterate_zero, id]
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all
    rw [e0] at h2
    set N := (n.eval s).toNat with hN
    have hNv : n.eval s = N := by omega
    have hG := repSt_G i n b s hw
    have hloop := IRuns.loop (I := I) (iprog := iprog) (i := i) (f := fun c => c != .zero)
      (p := .seq (b.code pM pc) (.seq ((decE i).code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i)))))
      (repSt i n b s)
      (fun k => b.cost M (repSt i n b s k) + asgCost i (decE i) (b.run (repSt i n b s k))) N
      (fun k hk => by
        rw [cl_int _ i _ _ (hG k)]
        have : n.eval s - k ≠ 0 := by omega
        simp [this]; split_ifs <;> simp)
      (by rw [cl_int _ i _ _ (hG N)]; simp [hNv])
      (fun k hk => by
        have hbk := code_runs_sol_aux M pM pc hM b hP (repSt i n b s k) (hb k hk)
        have hGb := run_G_of_not_mem b (repSt i n b s k) i hw
        rw [hG k] at hGb
        have hd := RS.asg_runs (I := I) (iprog := iprog) i (decE i) (b.run (repSt i n b s k)) hi
          (by intro j hj; simp only [decE, Ex.regs, List.append_nil] at hj
              exact RS.clean_of_lt hi j hj)
          (by simp only [decE, Ex.ok, and_true]; exact IState.isInt_of hGb)
          (IState.isInt_of hGb)
        refine (hbk.seq hd).mono' ?_ le_rfl
        simp only [repSt, Function.iterate_succ_apply']
        simp only [repSt] at hGb
        simp only [decSt, decE, Ex.eval, sub_eq_add_neg])
    have hdrop := IRuns.drop (I := I) (iprog := iprog) (s := repSt i n b s N) (i := i)
      (a := n.eval s - N) (L := s.G i) (hG N)
    refine ((h1.seq h2).seq (hloop.seq hdrop)).mono' ?_ ?_
    · have hGN := hG N
      simp only [repSt] at hGN
      simp only [run, repSt, ← hN]
      rw [hGN]; rfl
    · have hz : zsz (n.eval s - N) = 0 := by rw [hNv, sub_self, zsz_zero]
      rw [hz]
      simp only [cost, ← hN]
      omega
  | op o, _, s, h => by
    simp only [ok, Option.isSome_iff_exists] at h
    obtain ⟨r, hr⟩ := h
    have := IRuns.op (I := I) (iprog := iprog) (IOp.run_step (I := I) hr)
    simp only [run, cost, hr]; exact this

