theorem hideOp_commute_next (P : CL.CLFun F ι ℓ) (k : ℕ)
    (h : P.SupportedOn Finset.univ) (a b : HideLabel F ι) :
    Commute (hideOp P k h a) (hideOp P (k + 1) h b) :=
