section weyl4

variable {g gi : Metric 4} {U : Set (Pt 4)}

theorem sum_gi_g_mul (hm : MetricData g gi U) {y : Pt 4} (hy : y ∈ U) (d : Fin 4) (v : Fin 4 → ℝ) :
    ∑ a, ∑ c, gi a c y * g a d y * v c = v d := by
  rw [Finset.sum_comm]
  have h : ∀ c, ∑ a, gi a c y * g a d y * v c = (1 : Matrix (Fin 4) (Fin 4) ℝ) c d * v c := by
    intro c
    rw [← gi_g_apply hm hy c d, Finset.sum_mul]
    exact Finset.sum_congr rfl fun a _ => by rw [gi_symm hm hy a c]
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem sum_gi_g_mul' (hm : MetricData g gi U) {y : Pt 4} (hy : y ∈ U) (b : Fin 4) (v : Fin 4 → ℝ) :
    ∑ a, ∑ c, gi a c y * g b c y * v a = v b := by
  have h : ∀ a, ∑ c, gi a c y * g b c y * v a = (1 : Matrix (Fin 4) (Fin 4) ℝ) a b * v a := by
    intro a
    rw [← gi_g_apply hm hy a b, Finset.sum_mul]
    exact Finset.sum_congr rfl fun c _ => by rw [hm.symm y hy b c]
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-- **The Weyl tensor is trace-free**, `g^{ac} C_{abcd} = 0`, with no field equation (`Ric ≠ 0` allowed). -/
theorem weyl_trace (hm : MetricData g gi U) {y : Pt 4} (hy : y ∈ U) (b d : Fin 4) :
    ∑ a, ∑ c, gi a c y * weyl g gi a b c d y = 0 := by
  have S1 := (ricciOf_eq_riemLow_contr hm hy b d).symm
  have S2 := trace_ginv_g (fun i j => hm.symm y hy i j) (hm.inv y hy)
  have S3 := sum_gi_g_mul hm hy d (fun c => ricciOf g gi b c y)
  have S4 := sum_gi_g_mul' hm hy b (fun a => ricciOf g gi a d y)
  have S6 := sum_gi_g_mul hm hy d (fun c => g b c y)
  have S5 : ∑ a, ∑ c, gi a c y * ricciOf g gi a c y = ricciScalar g gi y := rfl
  simp only [Fin.sum_univ_four] at S1 S2 S3 S4 S5 S6 ⊢
  simp only [weyl]
  linear_combination S1 - (ricciOf g gi b d y * S2 - S3 - S4 + g b d y * S5) / 2
    + ricciScalar g gi y * (g b d y * S2 - S6) / 6

end weyl4

