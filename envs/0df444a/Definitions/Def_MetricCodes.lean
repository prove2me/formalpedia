                  (MetricCodes.Boolean.raiseAt a
                    (MetricCodes.Boolean.lowerAt a f))
                  (MetricCodes.Boolean.raiseAt a
                    (MetricCodes.Boolean.lowerAt a g)) := by
                  rw [johnsonBooleanDot_sub_right,
