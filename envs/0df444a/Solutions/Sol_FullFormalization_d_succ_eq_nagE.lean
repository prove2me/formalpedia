theorem solution (k : ℕ) :
    d (k + 1) = nagE (k + 1) + mom k * (nagE (k + 1) - nagE k) := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk
    simp [nagE, d_zero, d_one, mom_zero]
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk)
    show d (j + 1 + 1) = nagE (j + 1 + 1) + mom (j + 1) * (nagE (j + 1 + 1) - nagE (j + 1))
    rw [nagE_succ, nagE_succ,
      show d (j + 1) + 1 - (d j + 1) = d (j + 1) - d j from by ring]
    have h1 := d_succ_sub (j + 1)
    have h2 := d_succ_sub j
    push_cast at h1 h2 ⊢
    have hmom : mom (j + 1) * (d (j + 1) - d j) = ((j : ℝ) + 1) / 4 := by
      rw [mom_eq, h2]
      push_cast
      field_simp
      ring
    rw [hmom]
    linarith
