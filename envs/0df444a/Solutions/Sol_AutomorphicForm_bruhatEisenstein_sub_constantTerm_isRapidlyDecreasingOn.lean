    NumberField.AdeleRing.distribHaarChar_eq_prod_norm_pow_mult_of_snd_eq_one F αb hαbf, hq, NNReal.coe_one, mul_one]
  simp_rw [hαba]
  rw [Finset.prod_pow_eq_pow_sum, sum_mult_eq]

private theorem norm_frameChar_le_one {μ ν : 𝔸ˣ →* ℂˣ} (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    {s : ℂ} (hs : 0 ≤ s.re + 1 / 2) {t₁ t₂ αb : 𝔸ˣ} {q : Fˣ} {t : ℝ} (ht : 1 ≤ t)
