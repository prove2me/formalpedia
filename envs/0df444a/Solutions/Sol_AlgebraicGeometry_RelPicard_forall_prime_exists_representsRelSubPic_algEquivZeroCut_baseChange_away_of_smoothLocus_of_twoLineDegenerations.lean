  rintro _ ⟨z, rfl⟩
  show (pullback.fst c (specMap R A)).base ((pullback.fst (baseChange R c A) x').base z) ∈ U
  have h := hgoodU k (x' ≫ specMap R A) hsm' ⟨φ.hom.base z, rfl⟩
