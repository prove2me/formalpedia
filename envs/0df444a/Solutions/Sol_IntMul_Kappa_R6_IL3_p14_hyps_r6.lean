    have hsplit : (dP6 P n : ℝ) = (dP6 P n : ℝ) ^ (1 - P.lamp) * (dP6 P n : ℝ) ^ P.lamp := by
      rw [← Real.rpow_add hd0]; simp
    have hdl : 0 ≤ (dP6 P n : ℝ) ^ P.lamp := (Real.rpow_pos_of_pos hd0 _).le
    have hK0s : (0 : ℝ) ≤ K₀ * ((s : ℝ) + 1) := by positivity
    have e1 : ((K₀ * dP6 P n * (s + 1) : ℕ) : ℝ) =
        (K₀ * ((s : ℝ) + 1) * (dP6 P n : ℝ) ^ (1 - P.lamp)) * (dP6 P n : ℝ) ^ P.lamp := by
      push_cast
      rw [mul_assoc (K₀ * ((s : ℝ) + 1)), ← hsplit]; ring
    rw [e1]
    calc (K₀ * ((s : ℝ) + 1) * (dP6 P n : ℝ) ^ (1 - P.lamp)) * (dP6 P n : ℝ) ^ P.lamp
        ≤ (K₀ * ((s : ℝ) + 1) * y) * (dP6 P n : ℝ) ^ P.lamp := by
          apply mul_le_mul_of_nonneg_right _ hdl
          exact mul_le_mul_of_nonneg_left hdy hK0s
      _ ≤ (KP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp := mul_le_mul_of_nonneg_right hKy hdl

end

