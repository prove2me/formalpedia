open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.RN
theorem solution : IsOpen domRN := by
  have h1 : IsOpen {x : Pt 4 | 0 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h2 : IsOpen {x : Pt 4 | 0 < x 2} := isOpen_lt continuous_const (continuous_apply 2)
  have h3 : IsOpen {x : Pt 4 | x 2 < π} := isOpen_lt (continuous_apply 2) continuous_const
  exact h1.inter (h2.inter h3)
