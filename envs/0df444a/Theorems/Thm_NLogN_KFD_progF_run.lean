open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel AModelL12
variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (tpl : IMat m → List (TStep m))
set_option maxRecDepth 20000

theorem NLogN.KFD.progF_run (hm : 1 ≤ m) (q : ℕ) (hq : 2 ≤ q) (Bb : ℕ) (I : List Sym) :
    ∀ k : ℕ, (∀ j < k, LvOK C tpl (q ^ m ^ j) Bb) → zsz (k : ℤ) ≤ Bb →
    ∀ (P L : ℕ) (A B Cs : Shape), 1 ≤ P → W ^ k ∣ L → 1 ≤ L →
      (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
      zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb →
      ∀ (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
        DescIn t q m k P L A B Cs →
        xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
        IRuns I (progF C tpl) (progF C tpl 0) (t.upd 0 (ints (enc2 xs) ++ R))
          (t.upd 0 (ints (enc2 (AModel.prog C q k P L A B Cs xs)) ++ R))
          (ilCostF W (KlevF C tpl + 10 ^ 5) (KbF C tpl + 10 ^ 9 + 100) (Kd m) (SWn C tpl) q Bb k
            (vol (P :: L :: swShape A B Cs (q ^ m ^ k)))) := by sorry
