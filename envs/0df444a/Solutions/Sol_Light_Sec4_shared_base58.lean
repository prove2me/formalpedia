/-- A procedure of base58P is a procedure, with the same number, of every program that begins with
base58P. -/
theorem at_base58 {p : ℕ} {body : Stmt} (h : base58P[p]? = some body) (R : Program) :
    (base58P ++ R)[p]? = some body :=
  getElem?_append_of_eq_some h R

end Light.Sec4
