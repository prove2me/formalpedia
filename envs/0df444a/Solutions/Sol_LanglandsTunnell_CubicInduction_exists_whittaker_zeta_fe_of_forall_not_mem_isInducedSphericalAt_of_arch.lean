variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem toAdd_unzero_exp (n : ℤ) (h : (WithZero.exp n : WithZero (Multiplicative ℤ)) ≠ 0) :
    Multiplicative.toAdd (WithZero.unzero h) = n :=
  rfl

private theorem norm_eq_of_valued_eq {t : v.adicCompletion ℚ} {n : ℤ} (ht : Valued.v t = WithZero.exp (-n)) :
    ‖t‖ = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n := by
  rw [NumberField.FinitePlace.norm_def, ht, WithZeroMulInt.toNNReal_neg_apply _ WithZero.exp_ne_zero,
    toAdd_unzero_exp]
  simp [zpow_neg]

private theorem modulus_eq_of_valued_eq (t : (v.adicCompletion ℚ)ˣ) (n : ℤ)
    (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n)) :
    (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n := by
  rw [TateLocal.modulus_adicCompletion_eq_nnnorm ℚ v, coe_nnnorm, norm_eq_of_valued_eq v ht]

private theorem units_exists_valued_eq_exp_neg (t : (v.adicCompletion ℚ)ˣ) :
    ∃ m : ℤ, Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m) := by
  have hne : Valued.v (t : v.adicCompletion ℚ) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr t.ne_zero
  exact ⟨-WithZero.log (Valued.v (t : v.adicCompletion ℚ)), by rw [neg_neg, WithZero.exp_log hne]⟩

private theorem exists_valued_eq_one_and_eq_zpow_mul (t : (v.adicCompletion ℚ)ˣ) {m : ℤ}
    (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m)) :
    ∃ w : (v.adicCompletion ℚ)ˣ, Valued.v (w : v.adicCompletion ℚ) = 1 ∧ t = uniformizerUnit ℚ v ^ m * w := by
  refine ⟨uniformizerUnit ℚ v ^ (-m) * t, ?_, by rw [zpow_neg, mul_inv_cancel_left]⟩
  rw [Units.val_mul, Units.val_zpow_eq_zpow_val, map_mul, map_zpow₀, valued_uniformizerUnit ℚ v, ht,
    ← WithZero.exp_zsmul, ← WithZero.exp_add, ← WithZero.exp_zero]
  congr 1
  simp

end
