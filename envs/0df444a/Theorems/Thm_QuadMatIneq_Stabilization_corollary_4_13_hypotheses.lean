-- title:
--   §5.1, p. 18 — the hypotheses of Corollary 4.13 hold: N ∈ 𝚷_{n,n+m} for Φ ∈ 𝚷_{n,T} and (A_s, B_s) ∈ Σ, and M₂₂ ⩽ 0 for P > 0
-- statement:
--   Let $\Phi\in\boldsymbol\Pi_{n,T}$, and let the data $(U_-,X)$ be generated by the system (2.1) with noise satisfying (2.3), i.e. some $(A_s,B_s)$ lies in $\Sigma$. Let $N$ be the matrix (5.2), and $M$ the matrix (5.1) for a matrix $P>0$ and a gain $K$. Then
--   $$N\in\boldsymbol\Pi_{n,n+m}\qquad\text{and}\qquad M_{22}=-\begin{bmatrix}I\\K\end{bmatrix}P\begin{bmatrix}I\\K\end{bmatrix}^{\!\top}\leqslant 0 .$$
--
--   In the paper this is the verification that $N_{22}\leqslant 0$, $N\,|\,N_{22}\geqslant 0$, $\ker N_{22}\subseteq\ker N_{12}$ and $M_{22}\leqslant 0$, which allows Corollary 4.13 to be applied to the inclusion (5.3).
--
--   **Formalization Note** The data-generation hypothesis is stated as $\exists\,A_s,B_s$ with $(A_s,B_s)\in\Sigma$; without it $N\,|\,N_{22}\geqslant 0$ can fail. $M_{22}$ is the lower-right $(n+m)\times(n+m)$ block of `Mmat P K`.
-- source:
--   van Waarde–Camlibel–Eising–Trentelman, arXiv:2203.12959v3, §5.1, p. 18, paragraph after (5.3)

import Mathlib
import Definitions.Def_QuadMatIneq_Stabilization_QMI
import Definitions.Def_QuadMatIneq_Stabilization_Data

open Matrix Filter Topology

namespace QuadMatIneq.Stabilization

/-- §5.1, p. 18: the hypotheses of Corollary 4.13 hold for the matrices `N` of (5.2) and `M`
of (5.1): `N ∈ 𝚷_{n,n+m}` (from `Φ ∈ 𝚷_{n,T}` and `(A_s, B_s) ∈ Σ`), and `M₂₂ ⩽ 0` (from `P > 0`). -/
theorem corollary_4_13_hypotheses {n m T : ℕ}
    (Φ : Matrix (Fin n ⊕ Fin T) (Fin n ⊕ Fin T) ℝ) (X : Matrix (Fin n) (Fin (T + 1)) ℝ)
    (Um : Matrix (Fin m) (Fin T) ℝ) (hΦ : InPi Φ)
    (hgen : ∃ As : Matrix (Fin n) (Fin n) ℝ, ∃ Bs : Matrix (Fin n) (Fin m) ℝ,
      (As, Bs) ∈ Sigma Φ X Um)
    (P : Matrix (Fin n) (Fin n) ℝ) (hP : P.PosDef) (K : Matrix (Fin m) (Fin n) ℝ) :
    InPi (Nmat Φ X Um) ∧ (-(Mmat P K).toBlocks₂₂).PosSemidef := by sorry

end QuadMatIneq.Stabilization
