theorem PI.FJMS.gR_pos_block {m : ℕ} (u v : κ → σ) (pos : κ → Bool) (j : Fin m → κ) (hj : Function.Injective j)
    (P : MvPolynomial σ ℂ) (hA : ∀ c, c ∉ Set.range j → NoVar P (u c))
    (hB : ∀ c, c ∉ Set.range j → NoVar P (v c)) (hin : ∀ k, pos (j k) = true) :
    gR u v pos P = ∑ k, X (u (j k)) * pderiv (v (j k)) P := by sorry
