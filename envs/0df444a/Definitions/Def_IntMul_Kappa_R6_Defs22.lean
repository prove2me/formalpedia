   (kNG, .mul gFm (.reg 46)), (kF, eSub (pr 9) (pr 8))]

/-- `sU = Q · Q · Q · N1 · N2 · N3`. -/
def eSU : Ex HS := .mul (.mul (.reg mQ) (.reg mQ)) (.mul (.mul (.reg mQ) (.reg mN1)) (.mul (.reg mN2) (.reg mN3)))

/-- **The compact header after the masters**. -/
def hdrC : List (Fin HS × Ex HS) :=
  [(kSU, eSU), (kST, .mul (.reg kQC) eSU), (kK2, .reg mK2), (kR2, .reg mR2)]

/-- **The compact row-addition code.** -/
def rowCodeC (l12 : IStmt HS 1) : IStmt HS 1 :=
  withPushI hdrG (withPushI hdrL (zB (withPushI hdrC (l13C l12))))

/-! ## The backgrounds -/

/-! ## The run -/

