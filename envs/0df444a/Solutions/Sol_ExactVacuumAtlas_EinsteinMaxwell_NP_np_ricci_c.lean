/-! ### Symmetries of 4-index contractions -/

section c4

variable {T : Fin 4 → Fin 4 → Fin 4 → Fin 4 → Pt 4 → ℝ} {x : Pt 4}

theorem ccontr4_pair (hT : ∀ a b c d, T c d a b x = T a b c d x) (u v w z : Fin 4 → ℂ) :
    ccontr4 T x w z u v = ccontr4 T x u v w z := by
  have h : ∀ a b c d, (T a b c d x : ℂ) * w a * z b * u c * v d = (T c d a b x : ℂ) * u c * v d * w a * z b := by
    intro a b c d; rw [hT]; ring
  simp only [ccontr4, h]
  exact sum4_pair (fun a b c d => (T a b c d x : ℂ) * u a * v b * w c * z d)

end c4

namespace NullFrameData

variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}

/-! ### Frame Weyl tensor -/

theorem weylF_pair (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (I J A B : Fin 4) :
    weylF g gi E A B I J x = weylF g gi E I J A B x :=
  ccontr4_pair (fun a b c d => weyl_pair hN.metric hx a b c d) _ _ _ _

