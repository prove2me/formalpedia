  have hgen_inj : Function.Injective gen := fun i j h =>
    hgen₀_inj (by rw [← hgen i, ← hgen j, h])
  have hnd_inj : Function.Injective nd := fun e e' h =>
    hnd₀_inj (by rw [← hnd e, ← hnd e', h])
  have hgen_nc : ∀ i, ∃ y : X, gen i ⤳ y ∧ y ≠ gen i := by
    intro i
    obtain ⟨y₀, hy₀, hne₀⟩ := (hgen₀_iff (gen₀ i) (hgen₀_cl i)).mp ⟨i, rfl⟩
    obtain ⟨y, hy⟩ := hsp_surj y₀ (hsp₀ _ _ (hgen₀_cl i) hy₀)
    have hysp : toBase.base y = closedPoint ↥A := (hsp_iff y).mpr (by rw [hy]; exact hsp₀ _ _ (hgen₀_cl i) hy₀)
    refine ⟨y, (hspec_iff (gen i) y (hgen_sp i) hysp).mpr (by rw [hgen, hy]; exact hy₀), fun h => hne₀ ?_⟩
    rw [← hy, ← hgen i, h]
  have hV : ∀ i, ∃ V : ValuationSubring ↥(fieldBar q M'), V.toSubring = SemistableModel.localRing X φ (gen i) := by
    intro i
