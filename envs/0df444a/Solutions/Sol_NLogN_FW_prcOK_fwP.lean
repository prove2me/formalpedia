theorem ditBody_ren_const (pT : Fin P) :
    (ditBody pT : IStmt NLogN.NS P).ren f (fun _ => pT) = (ditBody pT).ren f id := rfl

/-- `dif_runs` for the procedure `difBody` renamed along an injective stack map `f`. -/
theorem dif_runs_ren (hf : Function.Injective f) (pD : Fin P)
    (hP : iprog' pD = (difBody pD).ren f id) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (t : IState S') (A : List ℤ) (R LL LE LN LF : List Item) (E : ℕ),
      A.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) A →
      t.G (f DX) = ints A ++ R → t.G (f DL) = .int (2 ^ j) :: LL →
      t.G (f NLogN.DE) = .int (2 ^ E) :: LE →
      t.G (f RN) = .int (2 ^ n) :: LN → t.G (f RF) = .int (2 ^ n + 1) :: LF →
      IRuns I iprog' (.call pD) t (t.upd (f DX) (ints (difZ (2 ^ n + 1) E j A) ++ R))
