variable {ι : Type*}

private theorem ofReal_map_prod (l : List ι) (g : ι → ℝ) :
    (((l.map g).prod : ℝ) : ℂ) = (l.map fun i => ((g i : ℝ) : ℂ)).prod := by
  induction l with
  | nil => simp
  | cons i l ih => simp [ih]

private theorem prod_one_add_le_exp_tsum {c : ι → ℝ} (hc0 : ∀ i, 0 ≤ c i) (hc : Summable c)
    (s : Finset ι) : ∏ i ∈ s, (1 + c i) ≤ Real.exp (∑' i, c i) := by
  calc ∏ i ∈ s, (1 + c i) ≤ ∏ i ∈ s, Real.exp (c i) :=
        Finset.prod_le_prod (fun i _ => by linarith [hc0 i]) fun i _ => by
          linarith [Real.add_one_le_exp (c i)]
    _ = Real.exp (∑ i ∈ s, c i) := (Real.exp_sum s c).symm
    _ ≤ Real.exp (∑' i, c i) := Real.exp_le_exp.mpr (hc.sum_le_tsum s fun i _ => hc0 i)

private theorem tendsto_prod_toList_filter_of_hasProd (p : ι → Prop) [DecidablePred p] (g : ι → ℂ) {P : ℂ}
    (hP : HasProd (fun i : {i // p i} => g i.1) P) (N : ι → ℕ) (hfin : ∀ n, {i | N i ≤ n}.Finite) :
    Tendsto (fun n => ((((hfin n).toFinset.filter p).toList.map g).prod)) atTop (𝓝 P) := by
  have hF : Tendsto (fun n => ((hfin n).toFinset.subtype p)) atTop (atTop : Filter (Finset {i // p i})) := by
    refine Filter.tendsto_atTop_atTop.mpr fun b => ⟨b.sup fun i => N i.1, fun n hn i hi => ?_⟩
    rw [Finset.mem_subtype, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    exact le_trans (Finset.le_sup (f := fun i : {i // p i} => N i.1) hi) hn
  have h := hP.comp hF
  refine h.congr fun n => ?_
  simp only [Function.comp_apply]
  rw [Finset.prod_subtype_eq_prod_filter, Finset.prod_map_toList]

private theorem multipliable_subtype_of_norm_sub_one_le (p : ι → Prop) {g : ι → ℂ} {c : ι → ℝ}
    (hc : Summable c) (hg : ∀ i, p i → ‖g i - 1‖ ≤ c i) :
    Multipliable fun i : {i // p i} => g i.1 := by
  have hfun : (fun i : {i // p i} => g i.1) = fun i : {i // p i} => 1 + (g i.1 - 1) := by
    funext i; ring
  rw [hfun]
  refine Complex.multipliable_one_add_of_summable ?_
  refine Summable.of_norm ?_
  refine Summable.of_nonneg_of_le (fun i => norm_nonneg _) (fun i => hg i.1 i.2) ?_
  exact hc.subtype {i | p i}

private theorem norm_tsum_sub_one_le {φ : ℤ → ℂ} (hφ : Summable fun m => ‖φ m‖) (h0 : φ 0 = 1) {c : ℝ}
    (hc : ∑' m, ‖φ m‖ ≤ 1 + c) : ‖(∑' m, φ m) - 1‖ ≤ c := by
  classical
  have hsum : Summable φ := hφ.of_norm
  have hrest : Summable fun m : ℤ => ‖if m = 0 then (0 : ℂ) else φ m‖ := by
    refine Summable.of_nonneg_of_le (fun m => norm_nonneg _) (fun m => ?_) hφ
    split_ifs <;> simp
  have hnormsplit : ∑' m, ‖φ m‖ = ‖φ 0‖ + ∑' m : ℤ, (if m = 0 then (0 : ℝ) else ‖φ m‖) :=
    hφ.tsum_eq_add_tsum_ite 0
  have hrest' : (∑' m : ℤ, ‖if m = 0 then (0 : ℂ) else φ m‖) = ∑' m : ℤ, (if m = 0 then (0 : ℝ) else ‖φ m‖) :=
    tsum_congr fun m => by split_ifs <;> simp
  rw [hsum.tsum_eq_add_tsum_ite 0, h0, add_sub_cancel_left]
  refine (norm_tsum_le_tsum_norm hrest).trans ?_
  rw [hrest', h0, norm_one] at *
  linarith

end

