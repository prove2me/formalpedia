open NLogN.KFD
open KIL AModel
theorem solution {m W S : ℕ} (K Kb Kd q : ℕ) (hm : 2 ≤ m) (hW : 1 ≤ W) {τ : ℝ}
    (hτ : 0 < τ ∧ τ < 1) (hs : (S : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ Bb j V, (NLogN.KFD.ilCostF W K Kb Kd S q Bb j V : ℝ) ≤
      K₀ * ((V : ℝ) + (W : ℝ) ^ j) * ((m : ℝ) ^ j) ^ τ +
        ((Kb : ℝ) + (S : ℝ) * Kd) * ((S : ℝ) + 1) ^ j * ((Bb : ℝ) + 2) ^ 2 := by
  set C : ℝ := (K : ℝ) * ((q : ℝ) + 1)
  have hC0 : 0 ≤ C := by positivity
  obtain ⟨K₀, hK₀, hK⟩ := AModel.power_width_recurrence m W S τ C hm hW hτ hs hC0
  refine ⟨K₀, hK₀, fun Bb j V => ?_⟩
  have h1 := NLogN.KFD.ilCostF_le_coeff W K Kb Kd S q Bb hW j V
  have h2 := hK (AModel.coeffSeq S W C) le_rfl (fun k => by simp [AModel.coeffSeq]) j
  have hp : (0 : ℝ) ≤ (V : ℝ) + (W : ℝ) ^ j := by positivity
  have := mul_le_mul_of_nonneg_left h2 hp
  nlinarith
end
