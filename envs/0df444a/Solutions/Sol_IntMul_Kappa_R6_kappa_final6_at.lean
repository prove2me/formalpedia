/-- **One run of `bigE`**, given the setup run in its sub-table. -/
theorem big_run6 (C : BigCtx6 ix Isym tab extM Q D) (ext₁ : Fin ix.P₁ → IStmt HS (7 + ix.P₁))
    (hp₁ : ∀ j, IL.kTableP tab extM (ix.g₁ j) = (IL.kTableP tab ext₁ j).ren id ix.g₁)
    (x y : List Bool) (hxl : x.length = Q.n) (hyl : y.length = Q.n) (t : IState HS) (c0 : ℕ)
    (r0 : IRuns Isym (IL.kTableP tab ext₁) (.call ix.eS) (readSt x y) t c0) (hR : Q.Base t)
    (h0 : t.G 0 = []) (hW : t.G pW = []) (hA : t.G ARGM = (readSt x y).G ARGM)
    (hout : t.out = []) :
    ∃ s' c, IRuns Isym (IL.kTableP tab extM) (bigP6 ix) (readSt x y) s' c ∧
      s'.out = bin (2 * Q.n) (val x * val y) ∧ (c : ℝ) ≤ (c0 : ℝ) + kMul6 C + kFin6 C := by
  have hQ := C.hQ
  have r0' := IRuns.relabel hp₁ r0
  have hx : val x < 2 ^ Q.n := hxl ▸ val_lt x
  have hy : val y < 2 ^ Q.n := hyl ▸ val_lt y
  have hA' : t.G ARGM = [.int (val y : ℤ), .int (val x : ℤ)] := by rw [hA]; simp [readSt]
