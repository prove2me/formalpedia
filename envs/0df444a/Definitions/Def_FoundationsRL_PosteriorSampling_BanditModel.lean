-- title:
--   Bandit models with a mean, mean reward $f^M$, and the reward kernel
-- statement:
--   A **bandit model** on $A$ decisions is a family $M=(M(\cdot\mid\pi))_{\pi\in[A]}$ of probability measures on $\mathbb R$, each with a finite mean. Its **mean reward function** is
--
--   $$
--   f^M(\pi)=\mathbb E_{r\sim M(\cdot\mid\pi)}[r].
--   $$
--
--   The model space carries the σ-algebra generated by the evaluations $M\mapsto M(B\mid\pi)$, so a prior is a probability measure on it, and the module records that $M\mapsto f^M(\pi)$ is measurable. The module also defines the condition that a prior $\mu$ gives rewards in $[0,1]$ almost surely.
--
--   **Formalization Note** The model space is universal: a family of reward laws indexed by any measurable parameter space pushes forward to a prior on this type.
-- source:
--   Foster & Rakhlin, Foundations of Reinforcement Learning and Interactive Decision Making, arXiv:2312.16730v1, Assumption 1, Eq. (2.1), p. 21; Eq. (2.2), p. 22; §2.4, p. 30

import Mathlib

open MeasureTheory ProbabilityTheory

namespace FoundationsRL.PosteriorSampling

/-- A bandit model (Foster & Rakhlin, *Foundations of Reinforcement Learning and Interactive
Decision Making*, arXiv:2312.16730v1, Assumption 1, p. 21, and §2.4, p. 30): a family
`M(· | π)`, `π ∈ [A]`, of probability measures on `ℝ` with a mean.

**Formalization Note.** Integrability is what gives `f^M(π) = E[r | π]` of Eq. (2.2) a meaning.
The model space is the subtype of the product of Giry σ-algebras on `Measure ℝ`. It is universal:
a family of reward laws indexed by any measurable parameter space pushes forward to a prior on
this type. -/
abbrev BanditModel (A : ℕ) : Type :=
  {M : Fin A → Measure ℝ // ∀ a, IsProbabilityMeasure (M a) ∧ Integrable (fun r => r) (M a)}

/-- The mean reward `f^M(π) = E[r | π]` for `r ∼ M(· | π)` (Foster & Rakhlin,
arXiv:2312.16730v1, Eq. (2.2), p. 22). -/
noncomputable def meanReward {A : ℕ} (M : BanditModel A) (a : Fin A) : ℝ :=
  ∫ r, r ∂(M.1 a)

/-- The reward law as a Markov kernel from (model, decision) to `ℝ`: `(M, π) ↦ M(· | π)`
(Foster & Rakhlin, arXiv:2312.16730v1, Assumption 1, Eq. (2.1), p. 21). -/
noncomputable def rewardKernel (A : ℕ) : Kernel (BanditModel A × Fin A) ℝ where
  toFun x := x.1.1 x.2
  measurable' := by
    refine measurable_from_prod_countable_left fun a => ?_
    exact (measurable_pi_apply a).comp measurable_subtype_coe

instance (A : ℕ) : IsMarkovKernel (rewardKernel A) :=
  ⟨fun x => (x.1.2 x.2).1⟩

/-- `M ↦ f^M(π)` is measurable: the mean reward of a model is a random variable under a prior. -/
lemma measurable_meanReward {A : ℕ} (a : Fin A) :
    Measurable fun M : BanditModel A => meanReward M a := by
  have h : ∀ M : BanditModel A, meanReward M a =
      (∫⁻ r, ENNReal.ofReal r ∂(M.1 a)).toReal - (∫⁻ r, ENNReal.ofReal (-r) ∂(M.1 a)).toReal :=
    fun M => integral_eq_lintegral_pos_part_sub_lintegral_neg_part (M.2 a).2
  simp_rw [h]
  have hc : Measurable fun M : BanditModel A => M.1 a :=
    (measurable_pi_apply a).comp measurable_subtype_coe
  have h1 : Measurable fun μ : Measure ℝ => ∫⁻ r, ENNReal.ofReal r ∂μ :=
    Measure.measurable_lintegral ENNReal.measurable_ofReal
  have h2 : Measurable fun μ : Measure ℝ => ∫⁻ r, ENNReal.ofReal (-r) ∂μ :=
    Measure.measurable_lintegral (ENNReal.measurable_ofReal.comp measurable_neg)
  exact (h1.comp hc).ennreal_toReal.sub (h2.comp hc).ennreal_toReal

/-- `M ↦ f^M` is measurable as a map to `ℝ^A`. -/
lemma measurable_meanVec {A : ℕ} :
    Measurable fun M : BanditModel A => (fun a => meanReward M a : Fin A → ℝ) :=
  measurable_pi_iff.2 measurable_meanReward

/-- Under the prior `μ`, rewards lie in `[0, 1]` almost surely. This is the correction of
Proposition 6 of Foster & Rakhlin, arXiv:2312.16730v1, p. 31 (see that theorem). -/
def RewardsInUnitInterval {A : ℕ} (μ : Measure (BanditModel A)) : Prop :=
  ∀ᵐ M ∂μ, ∀ a, M.1 a (Set.Icc 0 1) = 1

end FoundationsRL.PosteriorSampling


