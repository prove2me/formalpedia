@[simp] theorem stD_zero : stD f D T W U P G S N X Y Lr A 0 = f 0 := stD_other f D T W U P G S N X Y Lr A (by decide)

end StD

theorem prod_take_le {sh : List ℕ} (hsh : ∀ a ∈ sh, 1 ≤ a) (k : ℕ) : (sh.take k).prod ≤ sh.prod :=
  (List.take_sublist k sh).prod_le_prod' hsh

theorem prod_drop_le {sh : List ℕ} (hsh : ∀ a ∈ sh, 1 ≤ a) (k : ℕ) : (sh.drop k).prod ≤ sh.prod :=
  (List.drop_sublist k sh).prod_le_prod' hsh

theorem zsz_le_size {n B : ℕ} (h : Nat.size n ≤ B) : zsz (n : ℤ) ≤ B :=
  zsz_le_of_lt (by simpa using lt_of_lt_of_le (Nat.lt_size_self n) (Nat.pow_le_pow_right (by norm_num) h))

theorem zsz_le_of_le_prod {n V B : ℕ} (h : n ≤ V) (hB : Nat.size V ≤ B) : zsz (n : ℤ) ≤ B :=
  zsz_le_size (le_trans (Nat.size_le_size h) hB)

theorem cq_mono {B BL : ℕ} (h : B ≤ BL) : cq B ≤ cq BL := by
  unfold cq; have := Nat.pow_le_pow_left (show B + 2 ≤ BL + 2 by omega) 2; omega

theorem xD_hdr (L B BL : ℕ) : 2 * cq BL ≤ xD L B BL := by unfold xD; omega

theorem xD_cqL (L B BL : ℕ) : cq BL ≤ xD L B BL := by unfold xD; omega

theorem xD_cq {L B BL : ℕ} (h : B ≤ BL) : cq B ≤ xD L B BL :=
  le_trans (cq_mono h) (xD_cqL L B BL)

theorem xD_push {L B BL : ℕ} (h : B ≤ BL) (k : ℕ) (hk : k ≤ 20) :
    k * 10 ^ 7 * (B + 2) ^ 2 ≤ xD L B BL := by
  refine le_trans ?_ (xD_hdr L B BL)
  have := cq_mono h; unfold cq at this ⊢
  have : k * 10 ^ 7 * (B + 2) ^ 2 ≤ 20 * 10 ^ 7 * (B + 2) ^ 2 :=
    Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hk)
  omega

theorem xD_pop {L B BL X : ℕ} (h : X ≤ BL) : 2 * X + 2 ≤ xD L B BL := by
  refine le_trans ?_ (xD_cqL L B BL)
  unfold cq; nlinarith

theorem xD_loop {n : Ex HS} {s : IState HS} {N L B BL c : ℕ} (hl : n.Lin) (hb : n.Bnd s BL)
    (hs : n.size ≤ 6) (hN : N ≤ L) (hc : c ≤ 2 * cq B) :
    n.cost s + cRep N + N * c ≤ xD L B BL := by
  have h1 := Ex.cost_le_lin s BL n hl hb
  have h2 : n.size * 2000 * (BL + 2) ≤ cq BL := by
    unfold cq
    have : n.size * 2000 * (BL + 2) ≤ 6 * 2000 * (BL + 2) :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hs)
    nlinarith
  have h3 : cRep N ≤ cRep L := by
    unfold cRep; have := zsz_natCast_le hN; omega
  have h4 : N * c ≤ L * (2 * cq B) := Nat.mul_le_mul hN hc
  unfold xD
  nlinarith

end NLogN.KFW

end

