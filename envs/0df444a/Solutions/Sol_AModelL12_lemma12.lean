theorem encode_splitAddr {sh : Shape} {i r : ℕ} (h : i + r ≤ sh.length) {b : List ℕ}
    (hb : Valid (mergeShape sh i r) b) :
    encode sh (splitAddr sh i r b) = encode (mergeShape sh i r) b := by
