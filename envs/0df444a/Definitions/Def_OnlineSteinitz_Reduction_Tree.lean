-- title:
--   Position tree, boundary paths and ancestor intervals
-- statement:
--   For a known horizon $T\ge1$, recursively split the output interval into left capacity $\lceil m/2\rceil$ and right capacity $\lfloor m/2\rfloor$, stopping at singletons. The tree height is $h=\lceil\log_2 T\rceil$. For $0\le k\le T$, let $P(k)$ be the internal intervals meeting both the first $k$ slots and their complement. For a node $u$ set
--   $$\alpha_{u,k}=\min\left\{\frac{|I_u\cap[k]|}{m_{u_L}},\frac{|I_u\setminus[k]|}{m_{u_R}}\right\}.$$
--   Strict ancestors are the strictly larger tree intervals containing $I_u$. These deterministic objects describe which local split errors can affect a prefix.
--
--   **Formalization Note** Slots are zero-based; intervals are half-open. Internal intervals are generated by a terminating recursion with fuel $T$. Nodes embed in a finite interval grid; unused grid coordinates are not tree nodes. Weights are used only at internal nodes, so both denominators are positive. At $T=1$ there are no internal nodes and $h=0$.
-- source:
--   Russo–Wei, The Online Steinitz Problem, STOC 2027 submission #22 (2026 preprint), https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/22.pdf, SHA-256 32ff14f15a94c95630765c77f4fa5a429fb294bcf03a9055ed67c60658769366, §2.1, pp.4–5 (position tree); §2.2, pp.5–6 (boundary path); §2.3, p.7 (ancestors and coefficients)

import Mathlib

namespace OnlineSteinitz.Reduction

/-! §2.1, pp.4–5: half-open, zero-based intervals (start, capacity).
The fuel T exceeds the number of internal nodes on any root-to-leaf descent.
The finite grid contains unused coordinates; these have no algorithmic effect. -/
abbrev Node (T : ℕ) := Fin (T + 1) × Fin (T + 1)

def leftSize (m : ℕ) : ℕ := (m + 1) / 2

def rightSize (m : ℕ) : ℕ := m / 2

def nodeKey (T a m : ℕ) : Node T := (Fin.ofNat (T + 1) a, Fin.ofNat (T + 1) m)

def internalRaw : ℕ → ℕ → ℕ → Finset (ℕ × ℕ)
  | 0, _, _ => ∅
  | fuel + 1, a, m =>
    if m ≤ 1 then ∅ else
      {(a, m)} ∪ internalRaw fuel a (leftSize m) ∪
        internalRaw fuel (a + leftSize m) (rightSize m)

def internalNodes (T : ℕ) : Finset (Node T) :=
  (internalRaw T 0 T).image (fun u => nodeKey T u.1 u.2)

def boundaryPath (T k : ℕ) : Finset (Node T) :=
  (internalNodes T).filter (fun u => u.1.val < k ∧ k < u.1.val + u.2.val)

noncomputable def alpha {T : ℕ} (u : Node T) (k : ℕ) : ℝ :=
  min ((min u.2.val (k - u.1.val) : ℕ) / (leftSize u.2.val : ℝ))
    (((u.1.val + u.2.val - max k u.1.val : ℕ) : ℝ) / (rightSize u.2.val : ℝ))

def ancestors {T : ℕ} (u : Node T) : Finset (Node T) :=
  (internalNodes T).filter (fun v =>
    v.1.val ≤ u.1.val ∧ u.1.val + u.2.val ≤ v.1.val + v.2.val ∧ u.2.val < v.2.val)

def height (T : ℕ) : ℕ := Nat.clog 2 T

end OnlineSteinitz.Reduction


