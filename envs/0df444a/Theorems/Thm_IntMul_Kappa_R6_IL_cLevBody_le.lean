theorem IntMul.Kappa.R6.IL.cLevBody_le [NeZero W] (C : Bit.QHNet (ZMod 2) W T m) (P L' h v Bb : ℕ)
    (cC : ℕ × ℕ × ℕ → ℕ) (hP : 1 ≤ P) (hL : 1 ≤ L') (hh : 1 ≤ h) (hv : P * L' * h = v) :
    cLevBody C P L' h v Bb cC ≤ levB C v Bb + ((runsL C).map cC).sum := by sorry
