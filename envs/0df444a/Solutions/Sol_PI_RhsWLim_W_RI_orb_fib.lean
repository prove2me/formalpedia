  have hu := HU.uwb_unit (HU.inc_mem g)
  show (Matrix.of (HU.inc g) : Mat k r) *ᵥ z' = Matrix.of (HU.inc g') *ᵥ z' ↔
    ((Matrix.of (HU.inc g) : Mat k r)⁻¹ * Matrix.of (HU.inc g')) *ᵥ z' = z'
