    rcases Nat.eq_zero_or_pos K with rfl | hK
    · simp
    · have : 1 ≤ K ^ 2 := Nat.one_le_pow _ _ hK
      have : 8 ≤ 64 * K ^ 2 * F := by nlinarith
      nlinarith
  calc 2 ^ (8 * K) + 1 ≤ 2 ^ (8 * K) + 2 ^ (8 * K) := by have := Nat.one_le_two_pow (n := 8 * K); omega
    _ = 2 ^ (8 * K + 1) := by ring
