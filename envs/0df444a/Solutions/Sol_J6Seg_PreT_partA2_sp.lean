  rw [if_neg (by tauto)]

theorem CS_VB {u : Fin HS → ℤ} {A : ℕ} (hu : VB u A) {q : ℤ} (hq : |q| ≤ 2 ^ A) : VB (CS u q) A := by
  refine VB_upd ?_ 6 hq
  intro j hj; simp only [Z]; split_ifs
  · simp
  · exact hu j hj

theorem StIn2.CS {u : Fin HS → ℤ} {P R sN tN lam aN A : ℕ} (hi : StIn2 u P R sN tN lam aN A)
    {q : ℤ} (hq : |q| ≤ 2 ^ A) : StIn2 (CS u q) P R sN tN lam aN A :=
