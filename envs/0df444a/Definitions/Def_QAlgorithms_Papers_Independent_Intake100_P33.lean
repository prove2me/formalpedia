-- title:
--   Definitions for Fundamentals of submersions and immersions between infinite-dimensional manifolds
-- statement:
--   The objects the formalized statements of *Fundamentals of submersions and immersions between infinite-dimensional manifolds* (arXiv:1502.05795) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `RealCrOn`: PDF pp. 9–10: jointly continuous iterated real directional derivatives through order r. The value top means smooth; it does not mean analytic. Used only on open coordinate domains. The tower follows the pinned accepted Gap48.P05.BastianiCkOn and Next46.P35.DirectionalSmoothOn bodies.
--   - `CompatibleRealCrChart`: PDF p. 10: membership in the maximal atlas generated by the supplied atlas is compatibility in both directions with every supplied chart.
--   - `MaximalRealCrAtlas`: PDF p. 10: a real C^r atlas, explicitly saturated to the maximal atlas of the paper. Hausdorffness and locally convex models are theorem binders.
--   - `RealCrMap`: PDF pp. 9–10: a C^r map in the given real atlases. Continuity retains open coordinate domains. The canonical vector-space atlas generates the usual maximal atlas even though its supplied atlas has just the identity.
--   - `RealCrImmersion`: PDF p. 7: the local split-linear chart normal form of a real C^r immersion. A continuous linear left inverse of j is equivalent to j being a topological embedding onto a complemented image. Charts belong to the maximal generated atlas; neither global injectivity nor closed image is part of this local condition.
--   - `RealCrEmbedding`: PDF p. 7: an embedding is an immersion and a topological embedding with the actual source and target topologies.
--   - `RealCrRegular`: PDF pp. 8–9: C^r regularity, in the equivalent bump-function form explicitly stated by the source. Support means the closure of the nonzero locus. This is independent of regularity of Lie groups.
-- source:
--   Fundamentals of submersions and immersions between infinite-dimensional manifolds, arXiv:1502.05795v4, https://arxiv.org/abs/1502.05795v4

import Mathlib

/-!
Draft statements from Glöckner, arXiv:1502.05795v4.
Theorem J is stated at its full real finite/smooth regularity. All other
assigned nodes are explicitly deferred in the paper's HARD.md and GAPS.json.
The local calculus extends the pinned derivative-tower implementations in
Claimed50.P22, Next46.P35 and Gap48.P05 to finite-or-infinite real order.
No accepted module or frozen definition is modified or imported as a chunk.
Compilation and independent moderation are pending the batch handoff.
-/

namespace QAlgorithms.Papers.Independent.Intake100.P33

open Set Filter Topology

universe u v w z

section RealCalculus

variable {E : Type u} {F : Type v}
variable [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
variable [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]

/-- PDF pp. 9–10: jointly continuous iterated real directional derivatives
through order r. The value top means smooth; it does not mean analytic.
Used only on open coordinate domains. The tower follows the pinned accepted
Gap48.P05.BastianiCkOn and Next46.P35.DirectionalSmoothOn bodies. -/
def RealCrOn (r : WithTop ℕ) (U : Set E) (f : E → F) : Prop :=
  ∃ d : (n : ℕ) → E → (Fin n → E) → F,
    (∀ x ∈ U, d 0 x (fun i => Fin.elim0 i) = f x) ∧
    (∀ n : ℕ, (n : WithTop ℕ) ≤ r → ContinuousOn
      (fun p : E × (Fin n → E) => d n p.1 p.2)
      (U ×ˢ (Set.univ : Set (Fin n → E)))) ∧
    (∀ n : ℕ, ((n + 1 : ℕ) : WithTop ℕ) ≤ r → ∀ x ∈ U,
      ∀ (a : Fin n → E) (h : E),
        Tendsto (fun t : ℝ => t⁻¹ • (d n (x + t • h) a - d n x a))
          (𝓝[≠] (0 : ℝ)) (𝓝 (d (n + 1) x (Fin.snoc a h))))

/-- Sanity: zero has the zero tower at every finite or smooth real order,
including the auxiliary order zero; the model need not be normable. -/
example (r : WithTop ℕ) (U : Set E) :
    RealCrOn r U (fun _ : E => (0 : F)) := by
  refine ⟨fun _ _ _ => 0, ?_, ?_, ?_⟩
  · intro x hx
    rfl
  · intro n hn
    exact continuousOn_const
  · intro n hn x hx a h
    simpa only [sub_self, smul_zero] using
      (tendsto_const_nhds : Tendsto (fun _ : ℝ => (0 : F))
        (𝓝[≠] (0 : ℝ)) (𝓝 (0 : F)))

variable {M : Type w} {N : Type z}
variable [TopologicalSpace M] [TopologicalSpace N]
variable [ChartedSpace E M] [ChartedSpace F N]

/-- PDF p. 10: membership in the maximal atlas generated by the supplied
atlas is compatibility in both directions with every supplied chart. -/
def CompatibleRealCrChart (r : WithTop ℕ)
    (c : OpenPartialHomeomorph M E) : Prop :=
  ∀ a ∈ atlas E M,
    RealCrOn r (a.symm.trans c).source (a.symm.trans c) ∧
      RealCrOn r (c.symm.trans a).source (c.symm.trans a)

/-- PDF p. 10: a real C^r atlas, explicitly saturated to the maximal atlas
of the paper. Hausdorffness and locally convex models are theorem binders. -/
def MaximalRealCrAtlas (r : WithTop ℕ) : Prop :=
  (∀ c ∈ atlas E M, CompatibleRealCrChart r c) ∧
    ∀ c : OpenPartialHomeomorph M E,
      CompatibleRealCrChart r c → c ∈ atlas E M

/-- PDF pp. 9–10: a C^r map in the given real atlases. Continuity retains
open coordinate domains. The canonical vector-space atlas generates the
usual maximal atlas even though its supplied atlas has just the identity. -/
def RealCrMap (r : WithTop ℕ) (f : M → N) : Prop :=
  Continuous f ∧ ∀ c ∈ atlas E M, ∀ d ∈ atlas F N,
    RealCrOn r (c.target ∩ (fun x => f (c.symm x)) ⁻¹' d.source)
      (fun x => d (f (c.symm x)))

/-- PDF p. 7: the local split-linear chart normal form of a real C^r
immersion. A continuous linear left inverse of j is equivalent to j being
a topological embedding onto a complemented image. Charts belong to the
maximal generated atlas; neither global injectivity nor closed image is
part of this local condition. -/
def RealCrImmersion (r : WithTop ℕ) (f : M → N) : Prop :=
  RealCrMap (E := E) (F := F) r f ∧ ∀ x : M,
    ∃ c : OpenPartialHomeomorph M E,
    ∃ d : OpenPartialHomeomorph N F,
    ∃ j : E →L[ℝ] F, ∃ p : F →L[ℝ] E,
      CompatibleRealCrChart r c ∧ CompatibleRealCrChart r d ∧
      x ∈ c.source ∧ f x ∈ d.source ∧
      p.comp j = ContinuousLinearMap.id ℝ E ∧
      ∀ y ∈ c.source, f y ∈ d.source ∧ d (f y) = j (c y)

/-- PDF p. 7: an embedding is an immersion and a topological embedding
with the actual source and target topologies. -/
def RealCrEmbedding (r : WithTop ℕ) (f : M → N) : Prop :=
  RealCrImmersion (E := E) (F := F) r f ∧ Topology.IsEmbedding f

/-- PDF pp. 8–9: C^r regularity, in the equivalent bump-function form
explicitly stated by the source. Support means the closure of the nonzero
locus. This is independent of regularity of Lie groups. -/
def RealCrRegular (r : WithTop ℕ) : Prop :=
  ∀ x : M, ∀ U : Set M, IsOpen U → x ∈ U →
    ∃ f : M → ℝ, RealCrMap (E := E) (F := ℝ) r f ∧
      (∀ y, 0 ≤ f y ∧ f y ≤ 1) ∧ closure {y | f y ≠ 0} ⊆ U ∧
      ∃ W : Set M, IsOpen W ∧ x ∈ W ∧ W ⊆ U ∧ ∀ y ∈ W, f y = 1

/-- Sanity: the local splitting condition forces actual injectivity;
it cannot describe a degenerate zero inclusion on a nontrivial model. -/
example (j : E →L[ℝ] F) (p : F →L[ℝ] E)
    (hp : p.comp j = ContinuousLinearMap.id ℝ E) : Function.Injective j := by
  have hleft : Function.LeftInverse p j := by
    intro x
    change (p.comp j) x = x
    exact congrArg (fun q : E →L[ℝ] E => q x) hp
  exact hleft.injective

end RealCalculus

end QAlgorithms.Papers.Independent.Intake100.P33


