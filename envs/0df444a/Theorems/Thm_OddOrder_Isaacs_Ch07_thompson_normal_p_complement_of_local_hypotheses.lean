-- title:
--   Thompson's normal $p$-complement theorem (Isaacs Theorem 7.1)
-- statement:
--   Let $G$ be a finite group, $p\neq 2$ a prime, and $P$ a Sylow $p$-subgroup of $G$. If both $C_G(Z(P))$ and $N_G(J(P))$ have a normal $p$-complement, then $G$ has a normal $p$-complement:
--   $$\mathrm{HasNormalPComplement}_p\big(C_G(Z(P))\big)\wedge \mathrm{HasNormalPComplement}_p\big(N_G(J(P))\big)\ \Longrightarrow\ \mathrm{HasNormalPComplement}_p(G).$$
--   Here $Z(P)$ is the center of $P$ regarded as a subgroup of $G$, $J(P)$ is the Thompson subgroup (generated by the elementary abelian subgroups of $P$ of maximal order), and a normal $p$-complement of a group $X$ is a normal subgroup of $X$ that is a complement of every Sylow $p$-subgroup of $X$.
--
--   This is the Thompson normal $p$-complement theorem; it is proved by strong induction on $|G|$, using Theorem 7.6 on the normality of $J(P)$ and Burnside-type transfer arguments.
--
--   **Formalization Note.** The conclusion and hypotheses use `OddOrder.Isaacs.Ch05.HasNormalPComplement p`.
-- source:
--   Yawara Ishida, Lean 4 formalization of the Feit–Thompson (odd order) theorem, github.com/yawara/odd-order @ 20a6fccbb63c (Apache-2.0), https://github.com/yawara/odd-order/blob/20a6fccbb63c0b138acda9f7fafd798c42f9441b/OddOrder/Isaacs/Ch07_ThompsonSubgroup/S7C_ThompsonPComplementFinal.lean#L24-L101

import Definitions.Def_OddOrder_Isaacs_Ch07_ThompsonSubgroup_S7C_ThompsonPComplement

namespace OddOrder.Isaacs.Ch07

variable {G : Type*} [Group G]

section ThompsonNormalPComplement

theorem thompson_normal_p_complement_of_local_hypotheses.{u}
    {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (hp2 : p ≠ 2)
    (hCZ : OddOrder.Isaacs.Ch05.HasNormalPComplement p
      ↥(Subgroup.centralizer
        (((Subgroup.center (P : Subgroup G)).map
          (P : Subgroup G).subtype : Subgroup G) : Set G)))
    (hNJ : OddOrder.Isaacs.Ch05.HasNormalPComplement p
      ↥(Subgroup.normalizer
        ((Subgroup.thompsonJ (P : Subgroup G) p : Subgroup G) : Set G))) :
    OddOrder.Isaacs.Ch05.HasNormalPComplement p G := by sorry

end ThompsonNormalPComplement

end OddOrder.Isaacs.Ch07
