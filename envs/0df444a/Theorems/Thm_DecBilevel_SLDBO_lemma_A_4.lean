-- title:
--   Lemma A.4, (24), p. 15 — tracker consensus contraction for x
-- statement:
--   Under Assumptions 2.1 and 2.2, let $\{t^k_{x,i}\}$ and $\{d^k_{x,i}\}$ be generated by Algorithm 1 from BOX 1 with any $\alpha,\beta,\eta>0$. For every $k\ge0$,
--   $$\sum_{i=1}^n\|t^{k+1}_{x,i}-\bar t^{k+1}_x\|^2\le\rho\sum_{i=1}^n\|t^k_{x,i}-\bar t^k_x\|^2+\frac1{1-\rho}\sum_{i=1}^n\|d^{k+1}_{x,i}-d^k_{x,i}\|^2.$$
--
--   The tracker disagreement contracts up to the change of the local directions.
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 15, Lemma A.4, (24)

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_4 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    ∑ i, ‖trX s (k + 1) i - avg (trX s (k + 1))‖ ^ 2 ≤
      ρ * ∑ i, ‖trX s k i - avg (trX s k)‖ ^ 2 +
      1 / (1 - ρ) * ∑ i, ‖dirX s (k + 1) i - dirX s k i‖ ^ 2 := by sorry

end DecBilevel.SLDBO
