-- Source module: Solutions.R6CxNetGlobS
/-!
# The logical effect of the global chunk program

With all temporaries starting at zero (`Λ0 (inr _) = 0`), the logical state after `CH` is, on
the data roles, `X(a,b) ↦ Y0(a,b)`, `Y(a,b) ↦ X0(a,b)`, `A ↦ A0` (`ΛF_X`, `ΛF_Y`, `ΛF_A1`, `ΛF_A2`):
stage one adds `X` to `Y`, stage two subtracts `Y` from `X`, the corrections fix the signs.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

/-! ## Stage one -/

def L1 (Λ0 : Rl → Vt) (k : ℕ) (Λ : Rl → Vt) : Prop :=
  (∀ b < NV, ∀ S < NV, Λ (Yr S b) = Λ0 (Yr S b) + (if b < k then Λ0 (Xr S b) else 0)) ∧
  (∀ b < NV, ∀ t < NV, Λ (Xr t b) = Λ0 (Xr t b)) ∧
  (∀ b < NV, ∀ q < NR, Λ (A1r b q) = Λ0 (A1r b q)) ∧
  (∀ b < NV, k ≤ b → ∀ j < 24, Λ (M1r b j) = 0) ∧
  (∀ r, (∀ b < NV, ∀ w < NL, ι1 b w ≠ r) → Λ r = Λ0 r)

variable (Λ0 : Rl → Vt) (htemp : ∀ n, Λ0 (Sum.inr n) = 0)
include htemp

/-- The logical state after stage one. -/
noncomputable def Λ1 : Rl → Vt := runOps (progOps S1) Λ0

/-! ## Stage two -/

def L2 (Λ1 : Rl → Vt) (k : ℕ) (Λ : Rl → Vt) : Prop :=
  (∀ a < NV, ∀ S < NV, Λ (Xr a S) = Λ1 (Xr a S) - (if a < k then Λ1 (Yr a S) else 0)) ∧
  (∀ a < NV, ∀ t < NV, Λ (Yr a t) = Λ1 (Yr a t)) ∧
  (∀ a < NV, ∀ q < NR, Λ (A2r a q) = Λ1 (A2r a q)) ∧
  (∀ a < NV, k ≤ a → ∀ j < 24, Λ (M2r a j) = 0) ∧
  (∀ r, (∀ a < NV, ∀ w < NL, ι2 a w ≠ r) → Λ r = Λ1 r)

/-- The logical state after stage two. -/
noncomputable def Λ2 : Rl → Vt := runOps (progOps S2) (Λ1 Λ0)

/-! ## Corrections -/

/-! ## The final logical state on the data roles -/

/-- The logical state after the whole program. -/
noncomputable def ΛF : Rl → Vt := runOps (progOps CH) Λ0

end IntMul.Kappa.R6.Cx.NetG

