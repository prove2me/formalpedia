  split_ifs with h
  · simp; omega
  · simp; omega

theorem max0_ok {s : IState HS} {a : Ex HS} (ha : a.ok s) : (max0 a).ok s := by
  simp only [max0, ok]
  refine ⟨ha, ?_⟩
