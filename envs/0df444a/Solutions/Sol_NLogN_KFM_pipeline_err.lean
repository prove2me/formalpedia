-- Source module: Solutions.KFMErr
namespace NLogN.KFM

open Complex

noncomputable section

lemma hp_pos (p : ℕ) : 0 < hp p := by unfold hp; positivity

section Arr

variable {ι : Type*} [Fintype ι]

lemma pi_le {f : ι → ℂ} {C : ℝ} (hC : 0 ≤ C) (h : ∀ i, ‖f i‖ ≤ C) : ‖f‖ ≤ C :=
  (pi_norm_le_iff_of_nonneg hC).2 h

lemma truncNum_grid (p : ℕ) (n : ℤ) : Butterfly.truncNum p ((n : ℝ) / 2 ^ p) = n := by
  have h2 : (0 : ℝ) < 2 ^ p := by positivity
  have e : (n : ℝ) / 2 ^ p * 2 ^ p = n := by field_simp
  unfold Butterfly.truncNum
  rw [e]
  split_ifs <;> simp

lemma truncR_idem (p : ℕ) (x : ℝ) : Butterfly.truncR p (Butterfly.truncR p x) = Butterfly.truncR p x := by
  conv_lhs => rw [Butterfly.truncR]
  unfold Butterfly.truncR
  rw [truncNum_grid]

lemma Qp_idem (p : ℕ) (z : ℂ) : Butterfly.Qp p (Butterfly.Qp p z) = Butterfly.Qp p z := by
  apply Complex.ext <;> simp [Butterfly.Qp, truncR_idem]

lemma QA_grid (p : ℕ) (f : ι → ℂ) : Grid p (QA p f) := by
  funext i; exact Qp_idem p (f i)

lemma truncR_neg' (p : ℕ) (x : ℝ) : Butterfly.truncR p (-x) = -Butterfly.truncR p x := by
  unfold Butterfly.truncR Butterfly.truncNum
  rcases lt_trichotomy x 0 with h | h | h
  · rw [if_pos (by linarith), if_neg (by linarith), neg_mul, Int.floor_neg]; push_cast; ring
  · subst h; simp
  · rw [if_neg (by linarith), if_pos h.le, neg_mul, Int.ceil_neg]; push_cast; ring

lemma Qp_conj (p : ℕ) (z : ℂ) : Butterfly.Qp p (starRingEnd ℂ z) = starRingEnd ℂ (Butterfly.Qp p z) := by
  apply Complex.ext <;> simp [Butterfly.Qp, truncR_neg']

lemma QA_cnj (p : ℕ) (f : ι → ℂ) : QA p (cnj f) = cnj (QA p f) := by
  funext i; exact Qp_conj p (f i)

lemma Grid.cnj {p : ℕ} {f : ι → ℂ} (h : Grid p f) : Grid p (cnj f) := by
  unfold Grid at *; rw [QA_cnj, h]

lemma norm_cnj (f : ι → ℂ) : ‖cnj f‖ = ‖f‖ := by
  apply le_antisymm
  · exact pi_le (norm_nonneg _) fun i => by
      simp only [cnj, Complex.norm_conj]; exact norm_le_pi_norm f i
  · exact pi_le (norm_nonneg _) fun i => by
      have := norm_le_pi_norm (cnj f) i
      simp only [cnj, Complex.norm_conj] at this; exact this

lemma cnj_sub (f g : ι → ℂ) : cnj (f - g) = cnj f - cnj g := by funext i; simp [cnj]

lemma norm_QA_le (p : ℕ) (f : ι → ℂ) : ‖QA p f‖ ≤ ‖f‖ :=
  pi_le (norm_nonneg _) fun i => (Butterfly.norm_Qp_le p _).trans (norm_le_pi_norm f i)

lemma norm_QA_sub_le (p : ℕ) (f : ι → ℂ) : ‖QA p f - f‖ ≤ Real.sqrt 2 * hp p :=
  pi_le (by have := hp_pos p; positivity) fun i => (Butterfly.norm_Qp_sub_lt p (f i)).le

lemma sqrt2_le_two : Real.sqrt 2 ≤ 2 := by
  rw [Real.sqrt_le_left (by norm_num)]; norm_num

lemma norm_QA_sub_le2 (p : ℕ) (f : ι → ℂ) : ‖QA p f - f‖ ≤ 2 * hp p :=
  (norm_QA_sub_le p f).trans (by have := hp_pos p; nlinarith [sqrt2_le_two])

lemma norm_mul_le' (a b : ι → ℂ) : ‖a * b‖ ≤ ‖a‖ * ‖b‖ :=
  pi_le (by positivity) fun i => by
    rw [Pi.mul_apply, norm_mul]
    exact mul_le_mul (norm_le_pi_norm a i) (norm_le_pi_norm b i) (norm_nonneg _) (norm_nonneg _)

end Arr

