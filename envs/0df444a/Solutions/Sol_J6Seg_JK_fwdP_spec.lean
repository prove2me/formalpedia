-- Source module: Solutions.J6SegILJKer5
/-!
# B-line IL, the `J` kernel (B4), part 5: the forward loop

The forward table `flatT fs = ⋃_r (|cs_r| :: cs_r)` lies on `dTJ`; row `r` reads its count,
runs the dot loop on the accumulator `A = fA P fs v r` and pushes `v_r - dotF P cs_r (fA r)`
(`fA_succ`). After `m = |fs|` rows (`m` on `HM`), `A = fA P fs v m` and the table has moved
(reversed) onto `TT` (`fwdP_spec`). Cost `(∑_r (|cs_r| + 3) + 1) · uC`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section fwd
variable (P : ℕ) (F : Fin HS → List ℤ) (fs : List (List ℤ)) (v R T0 : List ℤ)

variable {P F fs v R T0}

theorem fwdP_spec_sol_aux {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M Xb Φm) (s : IState HS)
    {lp lp1 lh : List ℤ} (hF : FwdF P F lp lp1) (hm : fs.length ≤ v.length)
    (hwf : ∀ r (h : r < fs.length), fs[r].length ≤ r)
    (hcB : ∀ r (h : r < fs.length), Bnd Xb fs[r]) (hvB : Bnd Xb v)
    (hAB : ∀ r ≤ fs.length, Bnd Xb (fA P fs v r)) (hmB : fs.length < 2 ^ Bc)
    (hXB : 2 * Xb + P + Bc + 3 ≤ Bx) (hT : F dTJ = flatT fs ++ R) (hTT : F TT = T0)
    (hA : F A = []) (hV : F V = v) (hHM : F HM = (fs.length : ℤ) :: lh) :
    MSp M fwdP (encK s F) (encK s (fSt P F fs v R T0 fs.length))
      ((∑ r ∈ range fs.length, ((fs.getD r []).length + 3) + 1) * uC Φm Bx Bc) := by
  have e0 : fSt P F fs v R T0 0 = F := by
    funext j
    simp only [fSt, update_apply, List.drop_zero, List.take_zero, fA_zero]
    by_cases j1 : j = V
    · subst j1; simp +decide [hV]
    by_cases j2 : j = A
    · subst j2; simp +decide [hA]
    by_cases j3 : j = TT
    · subst j3; simp +decide [hTT, flatT]
    by_cases j4 : j = dTJ
    · subst j4; simp +decide [hT]
    simp [j1, j2, j3, j4]
  have hCR : ∀ k, fSt P F fs v R T0 k CR = [] := fun k => by
    simp +decide [fSt, update_apply, hF.cr]
  have hHMk : ∀ k, fSt P F fs v R T0 k HM = (fs.length : ℤ) :: lh := fun k => by
    simp +decide [fSt, update_apply, hHM]
  have hw : CR ∉ fwdB.writes := by
    simp +decide [fwdB, dotP, kD, RM.writes, RS.writes, mvK]
  have hzm : zsz (fs.length : ℤ) ≤ Bc := by apply zsz_le_of_lt; simp; omega
  have hloop := MSp.repS (M := M) (C := CR) (n := .reg HM) (b := fwdB) (s := s)
    (F := fun k => fSt P F fs v R T0 k) (N := fs.length) (B := Bc)
    (c := fun r => ((fs.getD r []).length + 2) * uC Φm Bx Bc) (by decide) hCR hw
    (RS.clean_of_lt (by decide))
    (by simp only [e0]; exact isInt_encK hHM) (by simp only [e0, Ex.Bnd, top_encK hHM]; exact hzm)
    (by simp only [e0]; simp [Ex.eval, top_encK hHM]) (fun k hk => by
      have := fwd_body (R := R) (T0 := T0) hMB s hF hm hwf hcB hvB hAB hmB hXB fs.length k hk
      rw [List.getD_eq_getElem _ _ hk]; exact this)
  simp only [e0] at hloop
  refine hloop.mono ?_
  simp only [Ex.size]
  have hsum : ∑ k ∈ range fs.length, (((fs.getD k []).length + 2) * uC Φm Bx Bc +
      4 * 10 ^ 7 * (Bc + 2) ^ 2 + 30) ≤
      ∑ k ∈ range fs.length, ((fs.getD k []).length + 3) * uC Φm Bx Bc := by
    apply Finset.sum_le_sum
    intro k _
    simp only [uC]; nlinarith
  have e1 : (∑ r ∈ range fs.length, ((fs.getD r []).length + 3) + 1) * uC Φm Bx Bc =
      ∑ r ∈ range fs.length, ((fs.getD r []).length + 3) * uC Φm Bx Bc + uC Φm Bx Bc := by
    rw [add_mul, Finset.sum_mul, one_mul]
  rw [e1]
  have : 2 * 10 ^ 7 * (Bc + 2) ^ 2 + 32 ≤ uC Φm Bx Bc := by simp only [uC]; nlinarith
  omega

end fwd

end J6Seg.JK

end

