-- url     : https://prove2.me/theorems/950bdca8-6946-4fe7-9d3a-3d266c511cb0
-- title:
--   Theorem 5.1, p. 18 — under bounded linear regularity, relaxed PRS on d²_{C_f}, d²_{C_g} contracts d_{C_f∩C_g} by C(γ_{f,k}, γ_{g,k}, λ_k, μ_ρ) and converges linearly to a point of C_f ∩ C_g
-- statement:
--   Let $C_f,C_g$ be closed convex subsets of a real Hilbert space $\mathcal H$ with $C_f\cap C_g\neq\emptyset$, and suppose $\{C_f,C_g\}$ is boundedly linearly regular. Let $(z^k)_{k\ge0}$ be generated by iteration (5.1),
--   $$
--   x_g^k=\mathbf{prox}_{\gamma_{g,k}d^2_{C_g}}(z^k),\quad x_f^k=\mathbf{prox}_{\gamma_{f,k}d^2_{C_f}}(2x_g^k-z^k),\quad z^{k+1}=z^k+2\lambda_k(x_f^k-x_g^k),
--   $$
--   with $\gamma_{f,k},\gamma_{g,k}>0$ and $\lambda_k\in(0,1]$. Let $\rho>0$ and $\mu_\rho>0$ be such that every $z^j$ lies in the open ball $B(0,\rho)$ and $d_{C_f\cap C_g}(x)\le\mu_\rho\max\{d_{C_f}(x),d_{C_g}(x)\}$ for all $x\in B(0,\rho)$. Then:
--
--   1. for all $k\ge0$,
--   $$
--   d_{C_f\cap C_g}(z^{k+1})\le C(\gamma_{f,k},\gamma_{g,k},\lambda_k,\mu_\rho)\,d_{C_f\cap C_g}(z^k), \tag{5.3}
--   $$
--   where $C(\gamma_f,\gamma_g,\lambda,\mu)=\Big(1-\dfrac{4\lambda\min\{\gamma_g/(2\gamma_g+1)^2,\gamma_f/(2\gamma_f+1)^2\}}{\mu^2\max\{16\gamma_g^2/(2\gamma_g+1)^2,1\}}\Big)^{1/2}$;
--   2. if $\overline C=\sup_{j\ge0}C(\gamma_{f,j},\gamma_{g,j},\lambda_j,\mu_\rho)<1$, then $(z^k)$ converges to a point $x\in C_f\cap C_g$, and for all $k\ge0$
--   $$
--   \|z^k-x\|\le 2\,d_{C_f\cap C_g}(z^0)\prod_{i=0}^{k-1}C(\gamma_{f,i},\gamma_{g,i},\lambda_i,\mu_\rho). \tag{5.4}
--   $$
--
--   This is the main result of §5: relaxed Peaceman–Rachford splitting applied to squared distance functions solves the two-set convex feasibility problem at a linear rate as soon as the sets are boundedly linearly regular, with explicit dependence on varying step sizes and relaxation parameters.
--
--   **Formalization Note** The condition $\overline C<1$ is encoded as: there is $c<1$ with $C(\gamma_{f,j},\gamma_{g,j},\lambda_j,\mu_\rho)\le c$ for all $j$ (equivalent, since the values lie in $[0,1]$). The page prints the product in (5.4) up to $i=k$; the proof (via (5.3) and Fejér monotonicity) gives $i\le k-1$, which is stated. The range $\lambda_k\in(0,1]$ is Algorithm 1's standing assumption and is used in the proof ($1/\lambda-1\ge0$); (5.1) does not restate it.
-- source:
--   Davis & Yin, Faster convergence rates of relaxed Peaceman-Rachford and ADMM under regularity assumptions, arXiv:1407.5210v3, p. 18, Theorem 5.1, (5.3), (5.4)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_RandomGradFree_Nonsmooth_IsMetricProjection
import Definitions.Def_RelaxedPRS_Feas_Setting
open ThreeOpSplitting.ConvexRates RandomGradFree.Nonsmooth Filter Topology

namespace RelaxedPRS.Feas

/-- Theorem 5.1 (Linear convergence: feasibility for two sets), p. 18. For iteration (5.1) with
`γ_{f,k}, γ_{g,k} > 0` and `λ_k ∈ (0, 1]`, boundedly linearly regular `{C_f, C_g}`, iterates in
`B(0, ρ)` and `d_{C_f ∩ C_g}(x) ≤ μ_ρ max{d_{C_f}(x), d_{C_g}(x)}` on `B(0, ρ)`:
(5.3) `d_{C_f ∩ C_g}(z^{k+1}) ≤ C(γ_{f,k}, γ_{g,k}, λ_k, μ_ρ) d_{C_f ∩ C_g}(z^k)` for all `k`;
and if every `C(γ_{f,j}, γ_{g,j}, λ_j, μ_ρ) ≤ c` for some `c < 1` (i.e. `C̄ < 1`), then `z^k`
converges to some `x ∈ C_f ∩ C_g` with (5.4)
`‖z^k − x‖ ≤ 2 d_{C_f ∩ C_g}(z⁰) ∏_{i<k} C(γ_{f,i}, γ_{g,i}, λ_i, μ_ρ)`
(the page prints the product up to `i = k`; the proof gives `i ≤ k − 1`). -/
theorem theorem_5_1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Cf Cg : Set H) (hCfc : IsClosed Cf) (hCfv : Convex ℝ Cf) (hCgc : IsClosed Cg)
    (hCgv : Convex ℝ Cg) (hne : (Cf ∩ Cg).Nonempty) (hreg : IsBddLinReg Cf Cg)
    (γf γg lam : ℕ → ℝ) (hγf : ∀ k, 0 < γf k) (hγg : ∀ k, 0 < γg k)
    (hlam : ∀ k, 0 < lam k ∧ lam k ≤ 1)
    (Pf Pg : ℕ → H → H) (hPf : ∀ k, IsProx (γf k) (dsq Cf) (Pf k))
    (hPg : ∀ k, IsProx (γg k) (dsq Cg) (Pg k))
    (z : ℕ → H) (hz : IsFeasRun Pf Pg lam z)
    (ρ μρ : ℝ) (hρ : 0 < ρ) (hμρ : 0 < μρ) (hball : ∀ j, z j ∈ Metric.ball (0 : H) ρ)
    (hμreg : ∀ x ∈ Metric.ball (0 : H) ρ,
      Metric.infDist x (Cf ∩ Cg) ≤ μρ * max (Metric.infDist x Cf) (Metric.infDist x Cg)) :
    (∀ k, Metric.infDist (z (k + 1)) (Cf ∩ Cg) ≤
        Cfeas (γf k) (γg k) (lam k) μρ * Metric.infDist (z k) (Cf ∩ Cg)) ∧
      ∀ c : ℝ, c < 1 → (∀ j, Cfeas (γf j) (γg j) (lam j) μρ ≤ c) →
        ∃ x ∈ Cf ∩ Cg, Tendsto z atTop (𝓝 x) ∧
          ∀ k, ‖z k - x‖ ≤ 2 * Metric.infDist (z 0) (Cf ∩ Cg) *
            ∏ i ∈ Finset.range k, Cfeas (γf i) (γg i) (lam i) μρ := by sorry

end RelaxedPRS.Feas
