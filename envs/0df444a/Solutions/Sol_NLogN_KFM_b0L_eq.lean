open IntMul NLogN

theorem cR_lt (s t l : ℕ) (hs : 0 < s) (hst : s ≤ t) (hl : l < s) : cR s t l < t := by
  unfold cR
  rw [Nat.div_lt_iff_lt_mul (by omega)]
  have h1 : 2 * t * l + 2 * t ≤ 2 * t * s := by
    have := Nat.mul_le_mul_left (2 * t) (show l + 1 ≤ s by omega); rw [Nat.mul_add] at this; omega
  have h2 : 2 * t * s = t * (2 * s) := by ring
  omega

theorem vIter_congr (p s t α : ℕ) (hs : 0 < s) (U U' : ℕ → ℤ × ℤ) (h : ∀ j < s, U j = U' j) :
    ∀ n, ∀ l < s, HvdH.vIter p s t α U n l = HvdH.vIter p s t α U' n l
  | 0, l, hl => by simp only [HvdH.vIter, HvdH.halfFP, h l hl]
  | n + 1, l, _ => by
    simp only [HvdH.vIter]
    exact Eapprox_congr p s t α hs _ _ (vIter_congr p s t α hs U U' h n) l

theorem Japprox_congr (p s t α : ℕ) (hs : 0 < s) (U U' : ℕ → ℤ × ℤ) (h : ∀ j < s, U j = U' j)
    (l : ℕ) (hl : l < s) : HvdH.Japprox p s t α U l = HvdH.Japprox p s t α U' l := by
  simp only [HvdH.Japprox, vIter_congr p s t α hs U U' h _ l hl]

theorem cselL_length (s t : ℕ) (v : List (ℤ × ℤ)) : (cselL s t v).length = s := by simp [cselL]

theorem japL_length (p s t α : ℕ) (u : List (ℤ × ℤ)) : (japL p s t α u).length = s := by
