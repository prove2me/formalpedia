  rw [hdR, hcU, le_div_iff₀ hd0]
  refine le_trans (le_of_eq (mul_comm _ _)) (hNR.trans ?_)
  have hR : ((400000 * (axw6 P n + 1) * JK.uC (mulSup (2 * (axkJ6 P n src k ap + 2)))
      (3 * axkJ6 P n src k ap + 10) (axBc6 P n src k ap) +
      40000000000 * (BkJ6 P n src k ap + 2) * (axw6 P n + 1) : ℕ) : ℝ) =
      400000 * ((axw6 P n : ℝ) + 1) * ((JK.uC (mulSup (2 * (axkJ6 P n src k ap + 2)))
        (3 * axkJ6 P n src k ap + 10) (axBc6 P n src k ap) : ℕ) : ℝ) +
      40000000000 * ((BkJ6 P n src k ap : ℝ) + 2) * ((axw6 P n : ℝ) + 1) := by
    push_cast; ring
  rw [hR]
  have hw1 : (0:ℝ) ≤ (axw6 P n : ℝ) + 1 := by positivity
  have hC1 : (0:ℝ) ≤ (KFZ.Cfm : ℝ) * ((W2c ap : ℝ) + 10) * ((W2c ap : ℝ) + (P.x : ℝ) + 14) ^ 2 :=
