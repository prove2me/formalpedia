      apply pullback.hom_ext
      · simp only [Category.assoc]
        calc (𝔐.pointEquivPlace.symm P₀).1 ≫ e ≫ pullback.fst π (Spec.map (CommRingCat.ofHom O.subtype)) ≫ e₀ ≫
              pullback.fst π₀ (Spec.map (CommRingCat.ofHom j))
            = (𝔐.pointEquivPlace.symm P₀).1 ≫ e' ≫ pullback.fst π₀ sQ := by rw [he'fst]
          _ = sQ ≫ ε₀.1 := by rw [hxs]; exact hs₀
          _ = Spec.map (CommRingCat.ofHom O.subtype) ≫ sO ≫ ε₀.1 := by rw [hsQ, Category.assoc]
          _ = Spec.map (CommRingCat.ofHom O.subtype) ≫ Pt₀.1 ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) := by
              rw [hPt₀]
      · simp only [Category.assoc]
        calc (𝔐.pointEquivPlace.symm P₀).1 ≫ e ≫ pullback.fst π (Spec.map (CommRingCat.ofHom O.subtype)) ≫ e₀ ≫
              pullback.snd π₀ (Spec.map (CommRingCat.ofHom j))
            = (𝔐.pointEquivPlace.symm P₀).1 ≫ e ≫ pullback.fst π (Spec.map (CommRingCat.ofHom O.subtype)) ≫ π := by rw [he₀snd]
          _ = (𝔐.pointEquivPlace.symm P₀).1 ≫ e ≫ pullback.snd π (Spec.map (CommRingCat.ofHom O.subtype)) ≫
                Spec.map (CommRingCat.ofHom O.subtype) := by rw [hcondπ]
          _ = ((𝔐.pointEquivPlace.symm P₀).1 ≫ 𝔐.toBase) ≫ Spec.map (CommRingCat.ofHom O.subtype) := by
              rw [← Category.assoc, ← Category.assoc, Category.assoc (𝔐.pointEquivPlace.symm P₀).1 e, he]
          _ = Spec.map (CommRingCat.ofHom O.subtype) := by rw [(𝔐.pointEquivPlace.symm P₀).2, Category.id_comp]
          _ = Spec.map (CommRingCat.ofHom O.subtype) ≫ Pt₀.1 ≫ π := by rw [Pt₀.2, Category.comp_id]
          _ = Spec.map (CommRingCat.ofHom O.subtype) ≫ Pt₀.1 ≫ e₀ ≫ pullback.snd π₀ (Spec.map (CommRingCat.ofHom j)) := by
              rw [he₀snd]
    have hk₀ := hred P₀ Pt₀ hs₀Pt₀
    have hsk₀ : (𝔐k.pointEquivPlace.symm (red P₀)).1 ≫ ek' ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom ik)) = Spec.map (CommRingCat.ofHom ik) ≫ ε₀.1 := by
      show (𝔐k.pointEquivPlace.symm (red P₀)).1 ≫ ek' ≫ pullback.fst π₀ sk = sk ≫ ε₀.1
      calc (𝔐k.pointEquivPlace.symm (red P₀)).1 ≫ ek' ≫ pullback.fst π₀ sk
          = (𝔐k.pointEquivPlace.symm (red P₀)).1 ≫ ek ≫ pullback.fst π (Spec.map (CommRingCat.ofHom res)) ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) := by
            rw [hek'fst]
        _ = (Spec.map (CommRingCat.ofHom res) ≫ Pt₀.1) ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) := by
            rw [← hk₀]; simp only [Category.assoc]
