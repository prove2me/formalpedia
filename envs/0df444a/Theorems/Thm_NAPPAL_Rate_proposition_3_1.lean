-- title:
--   Proposition 3.1, p. 9 — the stationarity residual at w^{k+1} is bounded by √3·h(u^k,p^k)‖w^k − w^{k+1}‖
-- statement:
--   Let Assumptions 1 and 2 hold, let $\{w^k\}=\{(u^k,v^k,p^k)\}$ be generated by NAPP-AL with the step $\delta_k$ set as in (8), and let $q^k=p^k+\gamma(\Theta(u^k)+Bv^k)$. Put
--   $$h(u^k,p^k):=\max\Big\{2L_G+\|q^k\|L_\Omega+\gamma\|B\|L^0_\Theta+\gamma(L^0_\Theta)^2+\frac{L_K}{\sigma\delta_k},\ 2L_G+L_H+\gamma\|B\|L^0_\Theta,\ L^0_\Theta+\|B\|+\frac1\gamma\Big\}.$$
--   Then for every $k\ge0$
--   $$\operatorname{dist}\big(0,\partial\mathcal L_\gamma(w^{k+1})\big)\le\sqrt3\,h(u^k,p^k)\,\|w^k-w^{k+1}\|.$$
--
--   The residual of the stationarity condition after one step is controlled by the length of that step. This is what turns the vanishing step lengths of Theorem 4.1 into vanishing residuals.
--
--   **Formalization Note** The paper prints the bound without the factor $\sqrt3$. That version is false: one NAPP-AL step on a one-dimensional instance satisfying Assumptions 1 and 2 (convex quadratic $G$, $H=J=0$, $U=\mathbb R$, $\Omega=0$, $\Phi(u)=u/20$, $B=5$, $K=u^2/2$, $\gamma=10.04$, $\sigma=0.99$, $\epsilon^k=\delta_k$) gives a ratio $\operatorname{dist}/(h\|\Delta w\|)\approx1.108$. The paper's proof bounds the three blocks of the residual separately by $h$ times $\|\Delta u\|+\|\Delta v\|+\|\Delta p\|$, which is at most $\sqrt3\|\Delta w\|$; the statement here is what that proof establishes. Only the existence of $c_5$ in Theorem 4.1(iv) uses this result, so nothing downstream changes. $\operatorname{dist}$ takes values in $[0,+\infty]$, and $\|w^k-w^{k+1}\|$ is the Euclidean norm of the stacked difference.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 9, Proposition 3.1 (with (8)); constant corrected by √3, see the Formalization Note

import Mathlib
import Definitions.Def_NAPPAL_Rate_Setting
open Filter Topology
open scoped InnerProductSpace

namespace NAPPAL.Rate

theorem proposition_3_1 {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 LK β γ σ : ℝ) (LOmj : Fin m → ℝ)
    (K : NAPPAL.KL.E n → ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : RunHyp P LG LH L0 LOmj K β LK γ σ δ ε u v p) (k : ℕ) :
    NAPPAL.KL.distZero (NAPPAL.KL.dAugLag P γ (u (k + 1), v (k + 1), p (k + 1))) ≤
      ENNReal.ofReal (Real.sqrt 3 * hfun P LG LH L0 (NAPPAL.KL.LOm LOmj) LK γ σ (qseq P γ u v p k) (δ k) *
        NAPPAL.KL.wdist (u k, v k, p k) (u (k + 1), v (k + 1), p (k + 1))) := by sorry

end NAPPAL.Rate
