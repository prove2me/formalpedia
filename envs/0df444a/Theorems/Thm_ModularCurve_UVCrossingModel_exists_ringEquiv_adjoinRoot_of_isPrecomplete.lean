-- title:
--   Crossing model as a quadratic algebra over W[[s]]
-- statement:
--   Let $W$ be a commutative ring that is Noetherian, local and a domain, and let $c \in W$ be non-zero and not a unit, with $W$ assumed precomplete for the $c$-adic topology, i.e. `IsPrecomplete (Ideal.span {c}) W`. Write $\mathrm{UVCrossingModel}\ W\ c$ for the quotient of the two-variable power series ring $\mathrm{MvPowerSeries}\ (\mathrm{Fin}\ 2)\ W$ by the ideal generated by $X_0 X_1 - c$. The assertion is that there exists a ring isomorphism
--   $$e : \mathrm{MvPowerSeries}\ (\mathrm{Fin}\ 2)\ W/(X_0X_1 - c)\ \xrightarrow{\ \sim\ }\ \mathrm{AdjoinRoot}\bigl(X^2 - C(\mathrm{PowerSeries.X})\cdot X + C(\mathrm{PowerSeries.C}\ c)\bigr),$$
--   the target being the quotient of the polynomial ring in one variable $X$ over $\mathrm{PowerSeries}\ W = W[\![s]\!]$ by the monic quadratic $X^2 - sX + c$, such that: first, $e$ carries the distinguished element `U c` of the crossing model to `AdjoinRoot.root`, the class of $X$; and second, for every power series $f \in W[\![s]\!]$, $e(\mathrm{chartHom}\ c\ f) = \mathrm{AdjoinRoot.of}\ f$, where `chartHom c` is the homomorphism $W[\![s]\!] \to \mathrm{UVCrossingModel}\ W\ c$ obtained by substituting a fixed ambient two-variable series into $f$ and passing to the quotient (by `chartHom_X` it sends $s$ to `S c`).
--
--   This identifies the local crossing model $W[\![u,v]\!]/(uv-c)$, the completed local ring of a modular curve at a supersingular crossing point in the sense of Deligne–Rapoport and Katz–Mazur, with the free quadratic algebra $W[\![s]\!][X]/(X^2-sX+c)$ over the invariants of the branch exchange. It is used in the proof that such crossing models with $c$ a power of a uniformiser are integrally closed, and in the accompanying criteria for integral closedness of a local ring whose maximal ideal is a principal span.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_UVCrossingModel_exists_ringEquiv_adjoinRoot_of_isPrecomplete.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingModel
import Definitions.Def_ModularCurve_UVCrossingChart

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve

theorem ModularCurve.UVCrossingModel.exists_ringEquiv_adjoinRoot_of_isPrecomplete {W : Type*} [CommRing W]
    [IsNoetherianRing W] [IsLocalRing W] [IsDomain W]
    (c : W) (hc0 : c ≠ 0) (hcu : ¬IsUnit c) [IsPrecomplete (Ideal.span {c}) W] :
    ∃ e : UVCrossingModel W c ≃+*
        AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C (PowerSeries.X : PowerSeries W) * Polynomial.X +
          Polynomial.C (PowerSeries.C c)),
      e (U c) = AdjoinRoot.root _ ∧
      ∀ f : PowerSeries W, e (chartHom c f) = AdjoinRoot.of _ f := by sorry
