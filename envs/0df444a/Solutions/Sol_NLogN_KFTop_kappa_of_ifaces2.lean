    (∀ i, j i < s i) → sliceCompZ (PBf p α s t) l x j = sliceCompZ (B0f p α s t) l x j
  | [], _, _, _, _ => rfl
  | i0 :: l, hnd, x, j, hj => by
    rw [List.nodup_cons] at hnd
    simp only [sliceCompZ, Function.comp]
    rw [pb_agree l hnd.2 _ j hj]
    refine sliceCompZ_local (B0f p α s t) i0 (j i0) l hnd.1 _ _ (fun m hm => ?_) j rfl
    simp only [sliceMapZ, PBf, B0f, PB, hm, if_pos (hj i0)]

end padded

section passA

variable (p α : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]

theorem repPad_disc {zs : List GI} {u : ((i : Fin d) → ZMod (s i)) → ℂ}
    (hrep : RepPad p s t zs u) (hu : ‖u‖ ≤ 1) : ∀ x, ‖gC (zs.getD x 0)‖ ≤ 2 ^ p := by
  intro x
  by_cases hx : x < (List.ofFn t).prod
  · by_cases hin : ∀ i, boxIx t x i < s i
    · rw [(hrep.2 x hx).1 hin, norm_mul]
      have := (norm_le_pi_norm u (fun i => ((boxIx t x i : ℕ) : ZMod (s i)))).trans hu
      simp only [norm_pow, RCLike.norm_ofNat]
      nlinarith [pow_pos (show (0 : ℝ) < 2 by norm_num) p]
    · rw [(hrep.2 x hx).2 hin, gC_zero, norm_zero]; positivity
  · rw [List.getD_eq_default _ _ (by rw [hrep.1]; omega), gC_zero, norm_zero]; positivity

theorem repFull_disc {zs : List GI} {w : ((i : Fin d) → ZMod (t i)) → ℂ}
    (hrep : RepFull p t zs w) (hw : ‖w‖ ≤ 1) : ∀ x, ‖gC (zs.getD x 0)‖ ≤ 2 ^ p := by
  intro x
  by_cases hx : x < (List.ofFn t).prod
  · rw [hrep.2 x hx, norm_mul]
    have := (norm_le_pi_norm w (fun i => ((boxIx t x i : ℕ) : ZMod (t i)))).trans hw
    simp only [norm_pow, RCLike.norm_ofNat]
    nlinarith [pow_pos (show (0 : ℝ) < 2 by norm_num) p]
  · rw [List.getD_eq_default _ _ (by rw [hrep.1]; omega), gC_zero, norm_zero]; positivity

theorem tensorGo_mapsA (hst : ∀ i, s i ≤ t i) (zs : List GI)
    (hz : zs.length = (List.ofFn t).prod) :
    tensorGo (mapsA p α s t) (List.ofFn t) zs = listOf (List.ofFn t) fun j =>
      tensorMapZ (fun i : Fin d => Sapprox p (s i) (t i) α) (NLogN.KFY.gIn (List.ofFn t) zs)
        fun i => j i := by
  have hpos : ∀ i < d, 0 < (List.ofFn t).getD i 1 := fun i hi => by
    rw [ofFn_getD t ⟨i, hi⟩]; exact Nat.pos_of_ne_zero (NeZero.ne _)
  have h := tensorGo_eq d (List.ofFn t) (List.ofFn t) (by simp) (by simp) hpos
    (fun i => Sapprox p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α)
    (fun i hi U U' h => Sapprox_congr p _ _ α (by
        rw [ofFn_getD s ⟨i, hi⟩]; exact Nat.pos_of_ne_zero (NeZero.ne _)) U U'
      (fun j hj => h j (by
        rw [ofFn_getD s ⟨i, hi⟩] at hj; rw [ofFn_getD t ⟨i, hi⟩]
        exact lt_of_lt_of_le hj (hst _))))
    (NLogN.KFY.gIn (List.ofFn t) zs)
  rw [listOf_gIn (List.ofFn t) (by simp) zs hz] at h
  have e : (fun i : Fin d => Sapprox p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α) =
      fun i => Sapprox p (s i) (t i) α := by
    funext i; rw [ofFn_getD, ofFn_getD]
  rw [e] at h
  exact h

/-- **The `A` pass.** -/
theorem passA (hst : ∀ i, s i ≤ t i) (zs : List GI) (u : ((i : Fin d) → ZMod (s i)) → ℂ)
    (hrep : RepPad p s t zs u) (hu : ‖u‖ ≤ 1 / 2) (M : AxisMaps (d := d) p α s t) :
    RepFull p t (tensorGo (mapsA p α s t) (List.ofFn t) zs)
        (wOf p t (tensorGo (mapsA p α s t) (List.ofFn t) zs)) ∧
      DiscL p (tensorGo (mapsA p α s t) (List.ofFn t) zs) ∧
      ‖wOf p t (tensorGo (mapsA p α s t) (List.ofFn t) zs) - tensCLM (kerA M.A) u‖ ≤
        epsA p α d * hp p := by
  rw [tensorGo_mapsA p α s t hst zs hrep.1]
  set U := NLogN.KFY.gIn (d := d) (List.ofFn t) zs with hU
  set Aa := fun i : Fin d => Sapprox p (s i) (t i) α with hAa
  set L := listOf (List.ofFn t) fun j => tensorMapZ Aa U fun i => j i with hL
  have hUd : InDisc p U := fun j => repPad_disc p s t hrep (by linarith) _
  obtain ⟨h1, h2⟩ := tensor_fp p Aa M.A (fun _ => 6 * IntMul.HvdH.sWidth p α + 4) M.hS M.hLA U hUd
  have hp0 : (0 : ℝ) < 2 ^ p := by positivity
  -- the input read on the source box is `u`
  have hu' : (fun k : (i : Fin d) → ZMod (s i) => gC (U fun i => (k i).val) / 2 ^ p) = u := by
    funext k
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (k i).val) (fun i =>
      lt_of_lt_of_le (ZMod.val_lt _) (hst i))
    have hin : ∀ i, boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i < s i := by
      intro i
      simp only [boxIx, hdig, extF, dif_pos i.2]
      exact ZMod.val_lt _
    simp only [hU, NLogN.KFY.gIn]
    rw [(hrep.2 _ hx).1 hin]
    have : (fun i => (((boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i : ℕ) :
        ZMod (s i)))) = k := by
      funext i; simp only [boxIx, hdig, extF, dif_pos i.2]; simp
    rw [this]; field_simp
  have hLl : L.length = (List.ofFn t).prod := length_listOf _ _
  refine ⟨⟨hLl, fun x hx => ?_⟩, ?_, ?_⟩
  · -- RepFull
    simp only [wOf]
    have hv : ∀ i : Fin d, ((boxIx t x i : ℕ) : ZMod (t i)).val = digL (List.ofFn t) x i := by
      intro i
      have := digL_lt (List.ofFn t) (ofFn_pos t) x i (by simp)
      simp only [List.getElem_ofFn] at this
      exact val_cast_lt this
    simp only [hv]
    rw [extF_digL, rmPos_digL _ x hx]
    field_simp
  · -- disc
    intro z hz
    simp only [hL, listOf, List.mem_map] at hz
    obtain ⟨l, -, rfl⟩ := hz
    exact h1 _
  · -- error
    refine (pi_norm_le_iff_of_nonneg (by unfold epsA hp; positivity)).2 fun pt => ?_
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (pt i).val) (fun i => ZMod.val_lt _)
    have hval : wOf p t L pt = gC (tensorMapZ Aa U fun i => (pt i).val) / 2 ^ p := by
      simp only [wOf]
      rw [getD_listOf' _ _ _ hx, hdig]
      simp [extF]
    rw [Pi.sub_apply, hval, tensCLM_apply, kerA_eq_kerL]
    have e2 := h2 (fun i => (pt i).val)
    rw [hu'] at e2
    simp only [ZMod.natCast_zmod_val] at e2
    have : gC (tensorMapZ Aa U fun i => (pt i).val) / 2 ^ p - tens (kerL M.A) u pt =
        (gC (tensorMapZ Aa U fun i => (pt i).val) - 2 ^ p * tens (kerL M.A) u pt) / 2 ^ p := by
      field_simp
    rw [this, norm_div, norm_pow, RCLike.norm_ofNat, div_le_iff₀ hp0]
    refine e2.trans (le_of_eq ?_)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, epsA, hp]
    push_cast
    rw [mul_assoc, ← mul_pow, inv_mul_cancel₀ (by norm_num : (2 : ℝ) ≠ 0), one_pow, mul_one]

theorem tensorGo_mapsB (hst : ∀ i, s i ≤ t i) (ys : List GI)
    (hz : ys.length = (List.ofFn t).prod) :
    tensorGo (mapsB p α s t) (List.ofFn t) ys = listOf (List.ofFn t) fun j =>
      tensorMapZ (PBf p α s t) (NLogN.KFY.gIn (List.ofFn t) ys) fun i => j i := by
  have hpos : ∀ i < d, 0 < (List.ofFn t).getD i 1 := fun i hi => by
    rw [ofFn_getD t ⟨i, hi⟩]; exact Nat.pos_of_ne_zero (NeZero.ne _)
  have h := tensorGo_eq d (List.ofFn t) (List.ofFn t) (by simp) (by simp) hpos
    (fun i => PB p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α)
    (fun i hi U U' h => by
      funext l
      simp only [PB]
      split_ifs
      · exact congrFun (B0P_congr p _ _ α (hpos i hi) U U' h) l
      · rfl)
    (NLogN.KFY.gIn (List.ofFn t) ys)
  rw [listOf_gIn (List.ofFn t) (by simp) ys hz] at h
  have e : (fun i : Fin d => PB p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α) =
      PBf p α s t := by
    funext i; rw [ofFn_getD, ofFn_getD]; rfl
  rw [e] at h
  rw [← h]
  unfold mapsB
  congr 1
  apply List.map_congr_left
  intro i hi
  simp only [List.mem_range] at hi
  congr 1
  funext X
  rw [range_PB]
  rw [ofFn_getD s ⟨i, hi⟩, ofFn_getD t ⟨i, hi⟩]; exact hst _

/-- **The `B₀` pass.** -/
theorem passB (hst : ∀ i, s i ≤ t i) (ys : List GI) (y : ((i : Fin d) → ZMod (t i)) → ℂ)
    (hrep : RepFull p t ys y) (hy : ‖y‖ ≤ 1) (M : AxisMaps (d := d) p α s t) :
    RepPad p s t (tensorGo (mapsB p α s t) (List.ofFn t) ys)
        (NLogN.KFY.vOf p s t (tensorGo (mapsB p α s t) (List.ofFn t) ys)) ∧
      DiscL p (tensorGo (mapsB p α s t) (List.ofFn t) ys) ∧
      ‖NLogN.KFY.vOf p s t (tensorGo (mapsB p α s t) (List.ofFn t) ys) - tensCLM (kerB M.B) y‖ ≤
        epsB p α s t * hp p := by
  rw [tensorGo_mapsB p α s t hst ys hrep.1]
  set U := NLogN.KFY.gIn (d := d) (List.ofFn t) ys with hU
  set L := listOf (List.ofFn t) fun j => tensorMapZ (PBf p α s t) U fun i => j i with hL
  have hUd : InDisc p U := fun j => repFull_disc p t hrep hy _
  obtain ⟨h1, h2⟩ := tensor_fp p (B0f p α s t) M.B
    (fun i => (IntMul.HvdH.jIter p (s i) (t i) α * (10 * IntMul.HvdH.eWidth p α + 12) + 4 : ℕ))
    (fun i => by have := M.hB0 i; push_cast; exact this) M.hLB U hUd
  have hp0 : (0 : ℝ) < 2 ^ p := by positivity
  have hy' : (fun k : (i : Fin d) → ZMod (t i) => gC (U fun i => (k i).val) / 2 ^ p) = y := by
    funext k
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (k i).val) (fun i => ZMod.val_lt _)
    simp only [hU, NLogN.KFY.gIn]
    rw [hrep.2 _ hx]
    have : (fun i => (((boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i : ℕ) :
        ZMod (t i)))) = k := by
      funext i; simp only [boxIx, hdig, extF, dif_pos i.2]; simp
    rw [this]; field_simp
  have hnd : (List.finRange d).Nodup := List.nodup_finRange d
  have hagree : ∀ j : Fin d → ℕ, (∀ i, j i < s i) →
      tensorMapZ (PBf p α s t) U j = tensorMapZ (B0f p α s t) U j :=
    fun j hj => pb_agree p α s t _ hnd U j hj
  have hvan : ∀ j : Fin d → ℕ, (∃ i, s i ≤ j i) → tensorMapZ (PBf p α s t) U j = (0, 0) :=
    fun j ⟨i, hi⟩ => pb_vanish p α s t _ U j ⟨i, List.mem_finRange i, hi⟩
  have hLl : L.length = (List.ofFn t).prod := length_listOf _ _
  have hLx : ∀ x < (List.ofFn t).prod,
      L.getD x 0 = tensorMapZ (PBf p α s t) U fun i => digL (List.ofFn t) x i := by
    intro x hx
    rw [hL, getD_listOf' _ _ _ hx]
  refine ⟨⟨hLl, fun x hx => ⟨fun hin => ?_, fun hout => ?_⟩⟩, ?_, ?_⟩
  · -- inside the source box
    simp only [NLogN.KFY.vOf]
    have hv : ∀ i : Fin d, ((boxIx t x i : ℕ) : ZMod (s i)).val = digL (List.ofFn t) x i :=
      fun i => val_cast_lt (hin i)
    simp only [hv]
    rw [extF_digL, rmPos_digL _ x hx]
    field_simp
  · -- outside: exact zeros
    push Not at hout
    obtain ⟨i, hi⟩ := hout
    rw [hLx x hx]
    exact hvan _ ⟨i, hi⟩
  · -- disc
    intro z hz
    simp only [hL, listOf, List.mem_map] at hz
    obtain ⟨l, -, rfl⟩ := hz
    set j := fun i : Fin d => (fun i => l.getD i 0) (i : ℕ)
    by_cases hin : ∀ i, j i < s i
    · rw [hagree j hin]; exact h1 _
    · push Not at hin
      rw [hvan j hin, gC_zero', norm_zero]; positivity
  · -- error
    refine (pi_norm_le_iff_of_nonneg (by unfold epsB hp; positivity)).2 fun pt => ?_
    have hst' : ∀ i, (pt i).val < t i := fun i => lt_of_lt_of_le (ZMod.val_lt _) (hst i)
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (pt i).val) hst'
    have hval : NLogN.KFY.vOf p s t L pt = gC (tensorMapZ (B0f p α s t) U fun i => (pt i).val) / 2 ^ p := by
      simp only [NLogN.KFY.vOf]
      rw [hLx _ hx]
      have : (fun i : Fin d => digL (List.ofFn t)
          (rmPos (List.ofFn t) (extF fun i => (pt i).val)) i) = fun i => (pt i).val := by
        funext i; rw [hdig]; simp [extF]
      rw [this, hagree _ (fun i => ZMod.val_lt _)]
    rw [Pi.sub_apply, hval, tensCLM_apply, kerB_eq_kerL]
    have e2 := h2 (fun i => (pt i).val)
    rw [hy'] at e2
    simp only [ZMod.natCast_zmod_val] at e2
    have : gC (tensorMapZ (B0f p α s t) U fun i => (pt i).val) / 2 ^ p - tens (kerL M.B) y pt =
        (gC (tensorMapZ (B0f p α s t) U fun i => (pt i).val) - 2 ^ p * tens (kerL M.B) y pt) /
          2 ^ p := by
      field_simp
    rw [this, norm_div, norm_pow, RCLike.norm_ofNat, div_le_iff₀ hp0]
    refine e2.trans (le_of_eq ?_)
    simp only [epsB, hp]
    push_cast
    rw [mul_assoc, ← mul_pow, inv_mul_cancel₀ (by norm_num : (2 : ℝ) ≠ 0), one_pow, mul_one]

theorem disc_b0Pad (M : AxisMaps (d := d) p α s t) (i : Fin d) (X : List GI) (hX : DiscL p X) :
    DiscL p (b0Pad p (s i) (t i) α X) := by
  intro z hz
  simp only [b0Pad, List.mem_append, List.mem_map, List.mem_range, List.mem_replicate] at hz
  rcases hz with ⟨k, -, rfl⟩ | ⟨-, rfl⟩
  · exact ((M.hB0 i) _ (fun j => disc_getD hX j)).1 k
  · simp [gC]

end passA

end NLogN.KFY

end

