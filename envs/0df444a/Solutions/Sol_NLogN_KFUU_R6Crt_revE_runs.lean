/-!
# KFUU §2j: the layouts of phase 3

With `M = (range n).reverse`, phase 3 treats the axes `M[i] = n-1-i` in order:
`lay3 bg n i = layA (M.take i) ++ mains (M.drop i) ++ bitsF (M.drop i) ++ [2n]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

theorem lay3_zero (bg : ℕ → Bool) (n : ℕ) :
    lay3 bg n 0 = ((lay1 bg n 0).take n).reverse ++ (lay1 bg n 0).drop n := by
  have hm : (mains (List.range n)).length = n := by simp [mains]
  simp only [lay3, lay1, List.take_zero, List.drop_zero, layA, List.flatMap_nil, List.nil_append,
    List.append_assoc]
  rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega),
    List.drop_append_of_le_length (by omega), List.drop_of_length_le (by omega)]
  simp [mains, bitsR, List.map_reverse]

theorem lay3_n (bg : ℕ → Bool) {n : ℕ} (hn : bg n = false) :
    lay3 bg n n = layA bg ((List.range n).reverse ++ [n]) := by
  rw [layA_append]
  simp [lay3, List.take_of_length_le, List.drop_of_length_le, mains, bitsF, layA, atm, hn]

