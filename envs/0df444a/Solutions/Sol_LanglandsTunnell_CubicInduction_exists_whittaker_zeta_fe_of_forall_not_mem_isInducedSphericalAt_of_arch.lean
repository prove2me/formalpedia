private theorem isGL3PsiWhittakerFn_comp_mul {F R : Type*} [CommRing F] [CommRing R] {ψ ψ' : AddChar F R}
    {τ : GL (Fin 3) F} {a : F}
    (hτ : ∀ x y z : F, τ * upperUnipotent3 x y z = upperUnipotent3 (a * x) (a * y) (a * (a * z)) * τ)
    (hψ' : ∀ s, ψ' s = ψ (a * s)) {W : GL (Fin 3) F → R} (hW : IsGL3PsiWhittakerFn ψ W) :
    IsGL3PsiWhittakerFn ψ' fun g => W (τ * g) := by
  intro x y z g
  calc W (τ * (upperUnipotent3 x y z * g)) = W (τ * upperUnipotent3 x y z * g) :=
        congrArg W (mul_assoc _ _ _).symm
    _ = W (upperUnipotent3 (a * x) (a * y) (a * (a * z)) * τ * g) := congrArg (fun u => W (u * g)) (hτ x y z)
    _ = W (upperUnipotent3 (a * x) (a * y) (a * (a * z)) * (τ * g)) := congrArg W (mul_assoc _ _ _)
    _ = ψ (a * x + a * y) * W (τ * g) := hW _ _ _ _
    _ = ψ' (x + y) * W (τ * g) := by rw [hψ', mul_add]

