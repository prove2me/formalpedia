theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : k) ≠ 0)
    (Z : Set A) (hZ : IsClosed Z) (H : AddSubgroup (L.AlgPoints hc k))
    (hH : ∀ Q : L.AlgPoints hc k, Q ∈ H ↔ (RelativeGroupLaw.AlgPoints.toPoint Q).1.base (IsLocalRing.closedPoint k) ∈ Z)
    (htors : ∀ (n : ℕ) (Q : L.AlgPoints hc k), ℓ ^ n • Q = 0 → Q ∈ H)
    (Q : L.AlgPoints hc k) : Q ∈ H := by
  classical
  by_contra hQ
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  let pt := IsLocalRing.closedPoint k
  have hk1 : Spec.map (CommRingCat.ofHom (algebraMap k k)) = 𝟙 (Spec (CommRingCat.of k)) := specMap_algebraMap_self

  let v : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f → L.AlgPoints hc k :=
    fun x => RelativeGroupLaw.AlgPoints.ofPoint (ofUnitPt f x)
  have hvZ : ∀ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f, x.1.base pt ∈ Z ↔ v x ∈ H :=
    fun x => (hH (v x)).symm

  have hone : (L.one (𝟙 (Spec (CommRingCat.of k)))).1.base pt ∈ Z := by
    have h0 := (hH 0).1 H.zero_mem
    rw [RelativeGroupLaw.AlgPoints.toPoint_zero] at h0
    rw [one_val_congr L hk1]
    exact h0
  have hmul : ∀ x y : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f,
      x.1.base pt ∈ Z → y.1.base pt ∈ Z → (L.mul (𝟙 (Spec (CommRingCat.of k))) x y).1.base pt ∈ Z := by
    intro x y hx hy
    have hxy := (hH _).1 (H.add_mem ((hvZ x).1 hx) ((hvZ y).1 hy))
    rw [RelativeGroupLaw.AlgPoints.toPoint_add] at hxy
    have e := mul_val_congr L hk1 (RelativeGroupLaw.AlgPoints.toPoint (v x)) (RelativeGroupLaw.AlgPoints.toPoint (v y))
    rw [← e] at hxy
    exact hxy
  obtain ⟨Hs, i, LH, hci, hred, hrange, hcompat⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_isClosedImmersion_isReduced_range_eq_of_isClosed_of_mul_mem
      k f L Z hZ hone hmul
  haveI : IsClosedImmersion i := hci
  haveI : IsReduced Hs := hred

  have hval : ∀ {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t (i ≫ f)),
      (NeronModelInfra.schemeHomOverComp x (⟨i, rfl⟩ : SchemeHomOver (i ≫ f) f)).1 = x.1 ≫ i := fun x => rfl
  have hcH : LH.IsCommutative := by
    intro T t x y
    have h1 := hcompat t x y
    have h2 := hcompat t y x
    rw [hc.mul_comm] at h1
    have h3 := congrArg Subtype.val (h1.trans h2.symm)
    rw [hval, hval] at h3
    exact Subtype.ext ((cancel_mono i).1 h3)

  obtain ⟨B, j, LB, n, hcj, hirr, hsm, -, -, -, hdimB, hcompatB, hcommB, S, hSfin, hcos⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_isClosedImmersion_smoothOfRelativeDimension_range_eq_connectedComponent_of_perfectField
      k LH
  have hcB : LB.IsCommutative := hcommB hcH
  haveI : IsClosedImmersion j := hcj
  haveI : IrreducibleSpace B := hirr
  haveI : SmoothOfRelativeDimension n (j ≫ i ≫ f) := hsm

  let fB : B ⟶ Spec (CommRingCat.of k) := j ≫ i ≫ f
  have hfibB : ∀ s : ↥(Spec (CommRingCat.of k)), fB.base ⁻¹' {s} = Set.univ := fun s =>
    Set.eq_univ_of_forall fun b => Subsingleton.elim _ _
  have hAB : AbelianSchemePropertyBundle k fB :=
    { smooth := SmoothOfRelativeDimension.smooth (n := n) (f := fB)
      proper := inferInstance
      connectedFibres := fun s => by rw [hfibB]; exact isConnected_univ
      hasGroupLaw := ⟨LB⟩ }
  have hdimB' : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(fB.base ⁻¹' {s}) = n := fun s => by
    rw [hfibB, IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ B).isHomeomorph]
    exact hdimB

  have hℓr : ∀ r : ℕ, ((ℓ ^ r : ℕ) : k) ≠ 0 := fun r => by
    rw [Nat.cast_pow]; exact pow_ne_zero _ hℓ
  have hcardA : ∀ r : ℕ, Nat.card (Submodule.torsionBy ℤ (L.AlgPoints hc k) ((ℓ ^ r : ℕ) : ℤ)) = (ℓ ^ r) ^ (2 * g) :=
    fun r => GoodReductionJacobian.RelativeGroupLaw.natCard_torsionBy_algPoints_eq_pow_of_topologicalKrullDim_eq
      L hc hA g hdim k (ℓ ^ r) (hℓr r)
  have hcardB : ∀ r : ℕ, Nat.card (Submodule.torsionBy ℤ (LB.AlgPoints hcB k) ((ℓ ^ r : ℕ) : ℤ)) = (ℓ ^ r) ^ (2 * n) :=
    fun r => GoodReductionJacobian.RelativeGroupLaw.natCard_torsionBy_algPoints_eq_pow_of_topologicalKrullDim_eq
      LB hcB hAB n hdimB' k (ℓ ^ r) (hℓr r)

  let ι : SchemeHomOver (i ≫ f) f := ⟨i, rfl⟩
  let κ : SchemeHomOver (j ≫ i ≫ f) (i ≫ f) := ⟨j, rfl⟩
  let φpt : LB.AlgPoints hcB k → L.AlgPoints hc k := fun b =>
    RelativeGroupLaw.AlgPoints.ofPoint
      (NeronModelInfra.schemeHomOverComp (NeronModelInfra.schemeHomOverComp (RelativeGroupLaw.AlgPoints.toPoint b) κ) ι)
  have hφadd : ∀ b b' : LB.AlgPoints hcB k, φpt (b + b') = φpt b + φpt b' := by
    intro b b'
    apply RelativeGroupLaw.AlgPoints.toPoint_injective
    simp only [φpt, RelativeGroupLaw.AlgPoints.toPoint_ofPoint, RelativeGroupLaw.AlgPoints.toPoint_add]
    rw [hcompatB, hcompat]
  let φ : LB.AlgPoints hcB k →+ L.AlgPoints hc k := AddMonoidHom.mk' φpt hφadd
  have hφval : ∀ b, (RelativeGroupLaw.AlgPoints.toPoint (φ b)).1 = (RelativeGroupLaw.AlgPoints.toPoint b).1 ≫ j ≫ i :=
    fun b => rfl
  have hφinj : Function.Injective φ := by
    intro b b' hbb'
    have h1 := congrArg (fun x => (RelativeGroupLaw.AlgPoints.toPoint x).1) hbb'
    simp only [hφval] at h1
    apply RelativeGroupLaw.AlgPoints.toPoint_injective
    apply Subtype.ext
    exact (cancel_mono (j ≫ i)).1 h1

  let w : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (i ≫ f) → L.AlgPoints hc k :=
    fun s => v (NeronModelInfra.schemeHomOverComp s ι)
  let S' : Set (L.AlgPoints hc k) := w '' S
  have hS' : S'.Finite := hSfin.image w
  have hcosA : ∀ x : L.AlgPoints hc k, x ∈ H → ∃ s ∈ S', ∃ b, x = s + φ b := by
    intro x hx
    have hxZ : (RelativeGroupLaw.AlgPoints.toPoint x).1.base pt ∈ Z := (hH x).1 hx
    rw [← hrange] at hxZ
    obtain ⟨x', hx'⟩ := exists_lift_of_mem_range i (RelativeGroupLaw.AlgPoints.toPoint x).1 hxZ
    let xpt : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (i ≫ f) :=
      ⟨x', by rw [← Category.assoc, hx', (RelativeGroupLaw.AlgPoints.toPoint x).2, hk1]⟩
    obtain ⟨s, hs, a, ha⟩ := hcos xpt
    refine ⟨w s, ⟨s, hs, rfl⟩, RelativeGroupLaw.AlgPoints.ofPoint ⟨a.1, by rw [a.2, hk1]⟩, ?_⟩
    have h1 : NeronModelInfra.schemeHomOverComp xpt ι =
        L.mul (𝟙 _) (NeronModelInfra.schemeHomOverComp s ι)
          (NeronModelInfra.schemeHomOverComp (NeronModelInfra.schemeHomOverComp a κ) ι) := by
      rw [ha, hcompat]
    have h2 := congrArg Subtype.val h1
    apply RelativeGroupLaw.AlgPoints.toPoint_injective
    apply Subtype.ext
    rw [RelativeGroupLaw.AlgPoints.toPoint_add,
      ← mul_val_congr L hk1 (RelativeGroupLaw.AlgPoints.toPoint (w s)) (RelativeGroupLaw.AlgPoints.toPoint (φ _))]
    change x' ≫ i = _ at h2
    rw [hx'] at h2
    exact h2

  have hcount : ∀ r : ℕ, (ℓ ^ r) ^ (2 * g) ≤ Nat.card S' * (ℓ ^ r) ^ (2 * n) := by
    intro r
    haveI : Finite (Submodule.torsionBy ℤ (LB.AlgPoints hcB k) ((ℓ ^ r : ℕ) : ℤ)) :=
      Nat.finite_of_card_ne_zero (by rw [hcardB]; exact pow_ne_zero _ (pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero))
    have hc' := card_le_of_cosets φ hφinj S' hS'
      (Submodule.torsionBy ℤ (L.AlgPoints hc k) ((ℓ ^ r : ℕ) : ℤ) : Set (L.AlgPoints hc k)) (ℓ ^ r)
      (fun x hx => (Submodule.mem_torsionBy_iff _ _).1 hx)
      (fun x hx => hcosA x (htors r x (by
        have := (Submodule.mem_torsionBy_iff _ _).1 hx
        rwa [natCast_zsmul] at this)))
    rw [← hcardA r, ← hcardB r]
    exact hc'.2

  have hng : n < g := by
    have hfibA : f.base ⁻¹' {pt} = Set.univ := Set.eq_univ_of_forall fun a => Subsingleton.elim _ _
    haveI : ConnectedSpace A := by
      rw [connectedSpace_iff_univ, ← hfibA]; exact hA.connectedFibres pt
    haveI : IsIntegral A := AlgebraicGeometry.isIntegral_of_smooth_of_preconnectedSpace f
    have hY : IsClosed (Set.range (j ≫ i).base) := (j ≫ i).isClosedEmbedding.isClosed_range
    have hYne : Set.range (j ≫ i).base ≠ Set.univ := by
      intro hY'
      have hm : (RelativeGroupLaw.AlgPoints.toPoint Q).1.base pt ∈ Set.range (j ≫ i).base := hY'.symm ▸ Set.mem_univ _
      obtain ⟨b, hb⟩ := hm
      have : (RelativeGroupLaw.AlgPoints.toPoint Q).1.base pt ∈ Set.range i.base := ⟨j.base b, by simpa using hb⟩
      rw [hrange] at this
      exact hQ ((hH Q).2 this)
    have hdimA : topologicalKrullDim ↥(Set.univ : Set A) = g := by rw [← hfibA]; exact hdim pt
    have hdimY : topologicalKrullDim ↥(Set.range (j ≫ i).base) = n := by
      rw [← IsHomeomorph.topologicalKrullDim_eq _ ((j ≫ i).isClosedEmbedding.isEmbedding.toHomeomorph).isHomeomorph]
      exact hdimB
    have hle := IsIrreducible.topologicalKrullDim_add_one_le_of_isClosed_of_ne (IrreducibleSpace.isIrreducible_univ A)
      hY (Set.subset_univ _) hYne
    rw [hdimA, hdimY] at hle
    have : n + 1 ≤ g := by exact_mod_cast hle
    omega
  exact absurd_of_pow_le (Fact.out : ℓ.Prime).two_le hng hcount

end
