section CappedPolicyUploadModule16
open MeasureTheory Filter CappedBaseStock CappedPolicyMoments CappedPolicyBounds
open CappedPolicyMeanLimits CappedPolicyApproximateBounds CappedEndpointSubsequence
open scoped ENNReal NNReal BigOperators Topology

set_option autoImplicit false
set_option linter.unusedVariables false

/-- Finite-cost policy windows, Cesaro averaging and a vanishing-boundary subsequence
give an exact deterministic input law. No invariant or optimal policy is assumed. -/
theorem solution (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ W : WindowLaw (c.L + 1), ∃ r z : ℝ,
      0 ≤ r ∧ r ≤ mean P ∧ 0 ≤ z ∧ WindowMeans W r z ∧
      windowExpectedInventory P W c.L ≤ ENNReal.ofReal z ∧
      windowExpectedInventory P W (c.L + 1) ≤ ENNReal.ofReal z ∧
      certificateObjective P c r z ≤ policyCost P c π + ENNReal.ofReal ε := by
  obtain ⟨T, hTmono, hTpos, hblock⟩ :=
    exists_endpoint_subsequence_of_eventually
      (inventoryMean P c π) (inventoryMean_nonneg P c π)
      (((policyCost P c π).toReal + 1) / c.h)
      (eventually_inventory_prefix_le P c π hfinite) c.L
  have hTtop : Tendsto T atTop atTop := hTmono.tendsto_atTop
  let rj : ℕ → ℝ := fun j => CappedPolicyCesaro.mean (orderMean P π) (T j)
  let zj : ℕ → ℝ := fun j => CappedPolicyCesaro.mean (inventoryMean P c π) (T j)
  let ej : ℕ → ℝ := fun j => approximationError P c π (T j)
  have hrj : ∀ j, 0 ≤ rj j := fun j => order_average_nonneg P π (T j)
  have hzj : ∀ j, 0 ≤ zj j := fun j => inventory_average_nonneg P c π (T j)
  have hej : ∀ j, 0 ≤ ej j := fun j => approximationError_nonneg P c π (T j)
  have helim : Tendsto ej atTop (𝓝 0) := by
    have hδ := orderError_tendsto_zero P c π T hTtop hblock
    simpa only [ej, approximationError, mul_zero] using hδ.const_mul ((c.L : ℝ) + 3)
  have hzbound : ∀ᶠ j in atTop, zj j ≤ ((policyCost P c π).toReal + 1) / c.h :=
    hTtop.eventually (eventually_inventory_average_le P c π hfinite)
  have hlarge : ∀ᶠ j in atTop, c.L + 1 ≤ T j :=
    hTtop.eventually (eventually_ge_atTop (c.L + 1))
  have hrbound : ∀ᶠ j in atTop, rj j ≤ mean P + ej j := by
    filter_upwards [hlarge] with j hj
    exact order_average_le_mean_add_error P c π hfinite (T j) hj
  have hG : ∀ m : ℕ, m ≤ c.L + 1 → ∀ᶠ j in atTop,
      CappedWindowLimit.G P m (rj j) (zj j) ≤ zj j + ej j := by
    intro m hm
    filter_upwards [hlarge] with j hj
    exact integral_realInventory_average_le_add_error P c π hfinite (T j) hj m hm
  have hcost : ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop,
      c.h * zj j + c.p * (mean P - rj j) ≤ (policyCost P c π).toReal + η := by
    intro η hη
    have hpredTop : Tendsto (fun j => T j - 1) atTop atTop :=
      (tendsto_sub_atTop_nat 1).comp hTtop
    have havg := hpredTop.eventually (eventually_meanAverage_lt P c π hfinite η hη)
    filter_upwards [hlarge, havg] with j hj hmean
    exact (objective_average_le_cost P c π hfinite (T j) hj).trans hmean.le
  obtain ⟨W, r, z, hr, hrmean, hz, hmeans, hL, hL1, hobj⟩ :=
    CappedWindowLimit.exists_window_law_of_approximate_bounds P c
      (policyCost P c π).toReal (((policyCost P c π).toReal + 1) / c.h)
      rj zj ej hrj hzj hej helim hzbound hrbound
      (hG c.L (Nat.le_succ _)) (hG (c.L + 1) le_rfl) hcost
  refine ⟨W, r, z, hr, hrmean, hz, hmeans, hL, hL1, hobj.trans ?_⟩
  rw [ENNReal.ofReal_toReal hfinite.ne]
  exact le_add_right le_rfl
end CappedPolicyUploadModule16
