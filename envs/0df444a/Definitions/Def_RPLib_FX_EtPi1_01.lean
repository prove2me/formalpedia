/-! ### piece Ufd -/
section Piece_Ufd


/-!
# S4-EtPi1, O4: valuations at prime elements of a UFD, and `N`-th powers

* `exists_associated_pow_of_dvd_multiplicity`: in a UFD, if `N ∣ multiplicity π f` for every prime `π`, then `f` is
  associated to an `N`-th power (`normalizedFactors f = N • t`).
* `exists_eq_unit_mul_pow`: for `a ≠ 0` in the fraction field `K` of a UFD `R`, if `N` divides
  `ord_π(den a) - ord_π(num a)` for every prime `π`, then `a = u · b ^ N` with `u ∈ Rˣ`, `b ∈ K` (the reduced fraction
  `num/den` has coprime parts, so `N` divides both orders).
* `isDedekindDomain_atPrime`: for `R` noetherian and `π ≠ 0` with `(π)` prime, `D = R_(π)` is a Dedekind domain (a
  noetherian local domain with principal maximal ideal, `tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain`).
* `place π D hπ`: the closed point of `Spec D` as a height-one prime; `log_intValuation_place`:
  `log v(f) = -ord_π(f)` for `f ∈ R`, and `log_valuation_place`: `log v(a) = ord_π(den a) - ord_π(num a)` for `a ∈ K`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open IsLocalRing IsDedekindDomain

namespace RamanujanPetersson
namespace EtPi1

section Pow

variable {R : Type} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]

/-- In a UFD, an element whose multiplicities are all divisible by `N` is associated to an `N`-th power. -/
theorem exists_associated_pow_of_dvd_multiplicity {f : R} (hf : f ≠ 0) {N : ℕ}
    (h : ∀ π : R, Prime π → N ∣ multiplicity π f) : ∃ d : R, Associated (d ^ N) f := by
  classical
  let _ : StrongNormalizationMonoid R := UniqueFactorizationMonoid.strongNormalizationMonoid
  set s := UniqueFactorizationMonoid.normalizedFactors f with hs
  have hc : ∀ x ∈ s, N ∣ s.count x := by
    intro x hx
    have hirr : Irreducible x := UniqueFactorizationMonoid.irreducible_of_normalized_factor x hx
    have hnorm : normalize x = x := UniqueFactorizationMonoid.normalize_normalized_factor x hx
    rw [← hnorm, ← UniqueFactorizationMonoid.multiplicity_eq_count_normalizedFactors hirr hf]
    exact h x (UniqueFactorizationMonoid.prime_of_normalized_factor x hx)
  refine ⟨(∑ x ∈ s.toFinset, (s.count x / N) • ({x} : Multiset R)).prod, ?_⟩
  rw [← Multiset.prod_nsmul]
  have hst : N • ∑ x ∈ s.toFinset, (s.count x / N) • ({x} : Multiset R) = s := by
    rw [Finset.smul_sum]
    conv_rhs => rw [← Multiset.toFinset_sum_count_nsmul_eq s]
    refine Finset.sum_congr rfl fun x hx => ?_
    rw [smul_smul, Nat.mul_div_cancel' (hc x (Multiset.mem_toFinset.1 hx))]
  rw [hst]
  exact UniqueFactorizationMonoid.prod_normalizedFactors hf

variable (K : Type) [Field K] [Algebra R K] [IsFractionRing R K]

theorem num_ne_zero {a : K} (ha : a ≠ 0) : IsFractionRing.num R a ≠ 0 := by
  intro h
  apply ha
  rw [← IsFractionRing.mk'_num_den' R a, h, map_zero, zero_div]

theorem den_ne_zero (a : K) : (IsFractionRing.den R a : R) ≠ 0 :=
  nonZeroDivisors.ne_zero (IsFractionRing.den R a).2

/-- **`N`-th powers up to units in the fraction field of a UFD.** -/
theorem exists_eq_unit_mul_pow {a : K} (ha : a ≠ 0) {N : ℕ}
    (h : ∀ π : R, Prime π →
      (N : ℤ) ∣ (multiplicity π (IsFractionRing.den R a : R) : ℤ) - multiplicity π (IsFractionRing.num R a)) :
    ∃ u : Rˣ, ∃ b : K, a = algebraMap R K u * b ^ N := by
  have hrel := IsFractionRing.num_den_reduced R a
  have hsplit : ∀ π : R, Prime π → N ∣ multiplicity π (IsFractionRing.num R a) ∧
      N ∣ multiplicity π (IsFractionRing.den R a : R) := by
    intro π hπ
    have h1 := h π hπ
    by_cases hn : π ∣ IsFractionRing.num R a
    · have hd : ¬ π ∣ (IsFractionRing.den R a : R) := fun hd => hπ.not_isUnit (hrel hn hd)
      rw [multiplicity_eq_zero.2 hd, Nat.cast_zero, zero_sub, Int.dvd_neg] at h1
      exact ⟨Int.natCast_dvd_natCast.1 h1, by rw [multiplicity_eq_zero.2 hd]; exact dvd_zero N⟩
    · rw [multiplicity_eq_zero.2 hn, Nat.cast_zero, sub_zero] at h1
      exact ⟨by rw [multiplicity_eq_zero.2 hn]; exact dvd_zero N, Int.natCast_dvd_natCast.1 h1⟩
  obtain ⟨d1, u1, hu1⟩ := exists_associated_pow_of_dvd_multiplicity (num_ne_zero K ha)
    (fun π hπ => (hsplit π hπ).1)
  obtain ⟨d2, u2, hu2⟩ := exists_associated_pow_of_dvd_multiplicity (den_ne_zero K a)
    (fun π hπ => (hsplit π hπ).2)
  refine ⟨u1 * u2⁻¹, algebraMap R K d1 / algebraMap R K d2, ?_⟩
  conv_lhs => rw [← IsFractionRing.mk'_num_den' R a, ← hu1, ← hu2]
  have hinv : algebraMap R K ((u2⁻¹ : Rˣ) : R) = (algebraMap R K (u2 : R))⁻¹ :=
    map_units_inv (algebraMap R K : R →* K) u2
  rw [Units.val_mul, map_mul, map_mul, map_mul, map_pow, map_pow, div_pow, hinv]
  ring

end Pow

section DVR

variable {R : Type} [CommRing R] [IsDomain R] (π : R) [(Ideal.span {π}).IsPrime]
  (D : Type) [CommRing D] [Algebra R D] [IsLocalization.AtPrime D (Ideal.span {π})]

include π in
/-- **The local ring at a prime element of a noetherian domain is a DVR** (here: a Dedekind domain). -/
theorem isDedekindDomain_atPrime [IsNoetherianRing R] : IsDedekindDomain D := by
  have : IsDomain D := IsLocalization.isDomain_of_atPrime D (Ideal.span {π})
  have : IsLocalRing D := IsLocalization.AtPrime.isLocalRing D (Ideal.span {π})
  have : IsNoetherianRing D :=
    IsLocalization.isNoetherianRing (Ideal.span {π}).primeCompl D inferInstance
  have hmax : (maximalIdeal D).IsPrincipal := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {π}) D, Ideal.map_span,
      Set.image_singleton]
    exact ⟨⟨_, rfl⟩⟩
  exact ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (R := D)).out 4 2).1 hmax

variable [IsLocalRing D] [IsDedekindDomain D]

include π in
omit [IsLocalRing D] in
theorem algebraMap_atPrime_injective : Function.Injective (algebraMap R D) :=
  IsLocalization.injective D (Ideal.primeCompl_le_nonZeroDivisors (Ideal.span {π}))

theorem maximalIdeal_atPrime_eq : maximalIdeal D = Ideal.span {algebraMap R D π} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {π}) D, Ideal.map_span,
    Set.image_singleton]

/-- The closed point of `Spec R_(π)` as a height-one prime. -/
def place (hπ : π ≠ 0) : HeightOneSpectrum D where
  asIdeal := maximalIdeal D
  isPrime := (maximalIdeal.isMaximal D).isPrime
  ne_bot := by
    rw [maximalIdeal_atPrime_eq π D, Ne, Ideal.span_singleton_eq_bot]
    exact fun h => hπ (algebraMap_atPrime_injective π D (h.trans (map_zero _).symm))

/-- `log v_π(f) = -ord_π(f)` for `0 ≠ f ∈ R`. -/
theorem log_intValuation_place [WfDvdMonoid R] (hπ : π ≠ 0) {f : R} (hf : f ≠ 0) :
    WithZero.log ((place π D hπ).intValuation (algebraMap R D f)) = -(multiplicity π f : ℤ) := by
  have hprime : Prime π := (Ideal.span_singleton_prime hπ).1 inferInstance
  obtain ⟨g, hfg, hg⟩ := (FiniteMultiplicity.of_prime_left hprime hf).exists_eq_pow_mul_and_not_dvd
  have hgu : (place π D hπ).intValuation (algebraMap R D g) = 1 := by
    rw [HeightOneSpectrum.intValuation_eq_one_iff]
    show algebraMap R D g ∉ maximalIdeal D
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff D (Ideal.span {π}) g, Ideal.mem_span_singleton]
    exact hg
  have hπv : (place π D hπ).intValuation (algebraMap R D π) = WithZero.exp (-1 : ℤ) :=
    HeightOneSpectrum.intValuation_singleton _
      (fun h => hπ (algebraMap_atPrime_injective π D (h.trans (map_zero _).symm)))
      (maximalIdeal_atPrime_eq π D)
  conv_lhs => rw [hfg]
  rw [map_mul, map_pow, map_mul, map_pow, hgu, hπv, mul_one, WithZero.log_pow, WithZero.log_exp]
  simp

variable (K : Type) [Field K] [Algebra R K] [IsFractionRing R K] [Algebra D K] [IsScalarTower R D K]
  [IsFractionRing D K]

/-- `log v_π(a) = ord_π(den a) - ord_π(num a)` for `0 ≠ a ∈ Frac R`. -/
theorem log_valuation_place [UniqueFactorizationMonoid R] (hπ : π ≠ 0) {a : K} (ha : a ≠ 0) :
    WithZero.log ((place π D hπ).valuation K a) =
      (multiplicity π (IsFractionRing.den R a : R) : ℤ) - multiplicity π (IsFractionRing.num R a) := by
  have hn := num_ne_zero (R := R) K ha
  have hd := den_ne_zero (R := R) K a
  have hn' : algebraMap R D (IsFractionRing.num R a) ≠ 0 :=
    fun h => hn (algebraMap_atPrime_injective π D (h.trans (map_zero _).symm))
  have hd' : algebraMap R D (IsFractionRing.den R a : R) ≠ 0 :=
    fun h => hd (algebraMap_atPrime_injective π D (h.trans (map_zero _).symm))
  conv_lhs => rw [← IsFractionRing.mk'_num_den' R a]
  rw [map_div₀, IsScalarTower.algebraMap_apply R D K, IsScalarTower.algebraMap_apply R D K (IsFractionRing.den R a : R),
    HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.valuation_of_algebraMap,
    WithZero.log_div (HeightOneSpectrum.intValuation_ne_zero _ _ hn')
      (HeightOneSpectrum.intValuation_ne_zero _ _ hd'),
    log_intValuation_place π D hπ hn, log_intValuation_place π D hπ hd]
  ring

end DVR

end EtPi1
end RamanujanPetersson

end Piece_Ufd

/-! ### piece Lev -/
section Piece_Lev


/-!
# S4-EtPi1, O3: the level ring `𝔽'[x₁, …, xₙ]` of a constant extension of `Frac 𝔽[x₁, …, xₙ]`

`A = 𝔽[x₁, …, xₙ]` (`𝔽` a field, later finite), `K` a fraction field of `A`, `char K = p`. For `m > 0`:

* `constF F K p m = 𝔽(roots of X^(p^m) - X) ⊆ K̄`, a finite extension of `𝔽` (`constF_finiteDimensional`); every element
  is a constant (`exists_pow_eq_of_mem_constF`, for finite `𝔽`);
* `levRing F n K p m = constF[x₁, …, xₙ]` (a noetherian UFD), `levMap : levRing → K̄` (`xᵢ ↦ xᵢ`) is injective
  (`levMap_injective`: algebraic independence extends to algebraic base changes) with image in `constLevel K p m`;
* `levRing` is a fraction ring of `constLevel K p m` (`isFractionRing_lev`), compatibly with `A → levRing`
  (`MvPolynomial.algebraMvPolynomial`, `levMap_map`, `isScalarTower_lev`); units of `levRing` map to constants
  (`levMap_isUnit_pow_eq`); `constLevel_mono`: `k ∣ m → constLevel K p k ≤ constLevel K p m`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace EtPi1

open Polynomial Kummer

noncomputable section

/-- `x ^ (q ^ k) = x` gives `x ^ (q ^ (k * l)) = x`. -/
theorem pow_pow_mul_eq {M : Type} [Monoid M] {x : M} {q k : ℕ} (h : x ^ (q ^ k) = x) (l : ℕ) :
    x ^ (q ^ (k * l)) = x := by
  induction l with
  | zero => simp
  | succ l ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, h]

section Roots

variable (K : Type) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]

theorem pow_eq_of_mem_rootSet {m : ℕ} {x : AlgebraicClosure K}
    (hx : x ∈ ((X : K[X]) ^ (p ^ m) - X).rootSet (AlgebraicClosure K)) : x ^ (p ^ m) = x := by
  have h := ((mem_rootSet).1 hx).2
  simpa [sub_eq_zero] using h

theorem pos_of_mem_rootSet {m : ℕ} {x : AlgebraicClosure K}
    (hx : x ∈ ((X : K[X]) ^ (p ^ m) - X).rootSet (AlgebraicClosure K)) : 0 < m := by
  rcases Nat.eq_zero_or_pos m with rfl | h
  · have h := ((mem_rootSet).1 hx).1
    simp at h
  · exact h

/-- `k ∣ m`, `m > 0` give `constLevel K p k ≤ constLevel K p m`. -/
theorem constLevel_mono {k m : ℕ} (hkm : k ∣ m) (hm : 0 < m) : constLevel K p k ≤ constLevel K p m := by
  refine IntermediateField.adjoin_le_iff.2 fun x hx => ?_
  obtain ⟨l, rfl⟩ := hkm
  exact mem_constLevel hm (pow_pow_mul_eq (pow_eq_of_mem_rootSet K p hx) l)

end Roots

section Const

variable (F : Type) [Field F] (K : Type) [Field K] [Algebra F K] (p : ℕ) [Fact p.Prime] [CharP K p]

/-- The constants of level `m`: `𝔽(roots of X^(p^m) - X) ⊆ K̄`. -/
def constF (m : ℕ) : IntermediateField F (AlgebraicClosure K) :=
  IntermediateField.adjoin F (((X : K[X]) ^ (p ^ m) - X).rootSet (AlgebraicClosure K))

theorem isIntegral_of_mem_rootSet {m : ℕ} {x : AlgebraicClosure K}
    (hx : x ∈ ((X : K[X]) ^ (p ^ m) - X).rootSet (AlgebraicClosure K)) : IsIntegral F x := by
  have hm := pos_of_mem_rootSet K p hx
  refine ⟨X ^ (p ^ m) - X, monic_X_pow_sub ?_, ?_⟩
  · rw [degree_X]; exact_mod_cast one_lt_pow_p hm
  · simp [pow_eq_of_mem_rootSet K p hx]

instance constF_finiteDimensional (m : ℕ) : FiniteDimensional F (constF F K p m) :=
  IntermediateField.finiteDimensional_adjoin fun _ hx => isIntegral_of_mem_rootSet F K p hx

theorem constF_le (m : ℕ) {c : AlgebraicClosure K} (hc : c ∈ constF F K p m) : c ∈ constLevel K p m := by
  have h : constF F K p m ≤ (constLevel K p m).restrictScalars F :=
    IntermediateField.adjoin_le_iff.2 fun x hx => IntermediateField.subset_adjoin K _ hx
  exact h hc

/-- Every element of `constF` is a constant (`𝔽` finite). -/
theorem exists_pow_eq_of_mem_constF [Finite F] (m : ℕ) (c : constF F K p m) :
    ∃ j, 0 < j ∧ (c : AlgebraicClosure K) ^ (p ^ j) = c := by
  have : Finite (constF F K p m) := Module.finite_of_finite F
  let := Fintype.ofFinite (constF F K p m)
  have : CharP (constF F K p m) p :=
    (algebraMap (constF F K p m) (AlgebraicClosure K)).charP (RingHom.injective _) p
  obtain ⟨j, -, hj⟩ := FiniteField.card (constF F K p m) p
  have h := FiniteField.pow_card c
  rw [hj] at h
  exact ⟨j, j.pos, by simpa using congrArg Subtype.val h⟩

end Const

section Lev

variable (F : Type) [Field F] (n : ℕ) (K : Type) [Field K] [Algebra (MvPolynomial (Fin n) F) K]
  [Algebra F K] [IsScalarTower F (MvPolynomial (Fin n) F) K] (p : ℕ) [Fact p.Prime] [CharP K p] (m : ℕ)

/-- The coordinates `xᵢ ∈ K̄`. -/
def xs (i : Fin n) : AlgebraicClosure K := algebraMap (MvPolynomial (Fin n) F) (AlgebraicClosure K) (MvPolynomial.X i)

/-- The level ring `constF[x₁, …, xₙ]`. -/
abbrev levRing : Type := MvPolynomial (Fin n) (constF F K p m)

/-- `levRing → K̄`, `xᵢ ↦ xᵢ`. -/
def levMap : levRing F n K p m →ₐ[constF F K p m] AlgebraicClosure K := MvPolynomial.aeval (xs F n K)

@[simp] theorem levMap_C (c : constF F K p m) : levMap F n K p m (MvPolynomial.C c) = c := by
  simp [levMap]

@[simp] theorem levMap_X (i : Fin n) : levMap F n K p m (MvPolynomial.X i) = xs F n K i := by
  simp [levMap]

theorem levMap_mem (f : levRing F n K p m) : levMap F n K p m f ∈ constLevel K p m := by
  induction f using MvPolynomial.induction_on with
  | C c => rw [levMap_C]; exact constF_le F K p m c.2
  | add f g hf hg => rw [map_add]; exact add_mem hf hg
  | mul_X f i hf =>
    rw [map_mul, levMap_X]
    refine mul_mem hf ?_
    rw [xs, IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) F) K (AlgebraicClosure K)]
    exact IntermediateField.algebraMap_mem _ _

/-- `levMap` restricted to `constLevel K p m`. -/
def levHom : levRing F n K p m →+* constLevel K p m :=
  (levMap F n K p m).toRingHom.codRestrict (constLevel K p m) (levMap_mem F n K p m)

instance levAlgebra : Algebra (levRing F n K p m) (constLevel K p m) := (levHom F n K p m).toAlgebra

@[simp] theorem coe_algebraMap_lev (f : levRing F n K p m) :
    ((algebraMap (levRing F n K p m) (constLevel K p m) f : constLevel K p m) : AlgebraicClosure K) =
      levMap F n K p m f := rfl

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- `levMap` extends `A → K → K̄`. -/
theorem levMap_map (a : MvPolynomial (Fin n) F) :
    levMap F n K p m (algebraMap (MvPolynomial (Fin n) F) (levRing F n K p m) a) =
      algebraMap (MvPolynomial (Fin n) F) (AlgebraicClosure K) a := by
  rw [MvPolynomial.algebraMap_def, levMap, MvPolynomial.aeval_map_algebraMap]
  exact (DFunLike.congr_fun (MvPolynomial.aeval_unique
    (IsScalarTower.toAlgHom F (MvPolynomial (Fin n) F) (AlgebraicClosure K))) a).symm

attribute [local instance] MvPolynomial.algebraMvPolynomial in
instance isScalarTower_lev :
    IsScalarTower (MvPolynomial (Fin n) F) (levRing F n K p m) (constLevel K p m) :=
  IsScalarTower.of_algebraMap_eq fun a => Subtype.ext (levMap_map F n K p m a).symm

variable [IsFractionRing (MvPolynomial (Fin n) F) K]

theorem algebraMap_A_injective :
    Function.Injective (algebraMap (MvPolynomial (Fin n) F) (AlgebraicClosure K)) := by
  rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin n) F) K (AlgebraicClosure K), RingHom.coe_comp]
  exact (algebraMap K (AlgebraicClosure K)).injective.comp (IsFractionRing.injective _ K)

theorem xs_algebraicIndependent : AlgebraicIndependent F (xs F n K) := by
  have hinj : Function.Injective
      (IsScalarTower.toAlgHom F (MvPolynomial (Fin n) F) (AlgebraicClosure K)) := by
    rw [IsScalarTower.coe_toAlgHom']
    exact algebraMap_A_injective F n K
  have h := (MvPolynomial.algebraicIndependent_X (Fin n) F).map' hinj
  have he : (IsScalarTower.toAlgHom F (MvPolynomial (Fin n) F) (AlgebraicClosure K)) ∘ MvPolynomial.X =
      xs F n K := by
    funext i
    rw [Function.comp_apply, IsScalarTower.coe_toAlgHom']
    rfl
  rwa [he] at h

theorem levMap_injective : Function.Injective (levMap F n K p m) :=
  (xs_algebraicIndependent F n K).extendScalars (constF F K p m)

instance isFractionRing_lev : IsFractionRing (levRing F n K p m) (constLevel K p m) := by
  have : FaithfulSMul (levRing F n K p m) (constLevel K p m) :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 fun x y h =>
      levMap_injective F n K p m (congrArg Subtype.val h)
  refine IsFractionRing.of_field _ _ fun z => ?_
  set T : Subfield (AlgebraicClosure K) := Subfield.closure (Set.range (levMap F n K p m)) with hT
  have hrange : ∀ f, levMap F n K p m f ∈ T := fun f => Subfield.subset_closure ⟨f, rfl⟩
  have hK : ∀ x : K, algebraMap K (AlgebraicClosure K) x ∈ T := by
    intro x
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (MvPolynomial (Fin n) F) x
    rw [map_div₀, ← IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) F) K (AlgebraicClosure K) a,
      ← IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) F) K (AlgebraicClosure K) b,
      ← levMap_map F n K p m a, ← levMap_map F n K p m b]
    exact div_mem (hrange _) (hrange _)
  have hle : constLevel K p m ≤ T.toIntermediateField hK := by
    refine IntermediateField.adjoin_le_iff.2 fun x hx => ?_
    have h := hrange (MvPolynomial.C ⟨x, IntermediateField.subset_adjoin F _ hx⟩)
    rwa [levMap_C] at h
  obtain ⟨y, hy, w, hw, hyw⟩ := (Subfield.mem_closure_iff).1 (hle z.2)
  have hsub : Subring.closure (Set.range (levMap F n K p m)) ≤ (levMap F n K p m).toRingHom.range :=
    Subring.closure_le.2 (by rintro _ ⟨g, rfl⟩; exact ⟨g, rfl⟩)
  obtain ⟨f, hf⟩ := RingHom.mem_range.1 (hsub hy)
  obtain ⟨g, hg⟩ := RingHom.mem_range.1 (hsub hw)
  change levMap F n K p m f = y at hf
  change levMap F n K p m g = w at hg
  refine ⟨f, g, Subtype.ext ?_⟩
  rw [IntermediateField.coe_div, coe_algebraMap_lev, coe_algebraMap_lev, hf, hg, hyw]

/-- Units of `levRing` map to constants (`𝔽` finite). -/
theorem levMap_isUnit_pow_eq [Finite F] {u : levRing F n K p m} (hu : IsUnit u) :
    ∃ j, 0 < j ∧ (levMap F n K p m u) ^ (p ^ j) = levMap F n K p m u := by
  obtain ⟨r, -, rfl⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.1 hu
  rw [levMap_C]
  exact exists_pow_eq_of_mem_constF F K p m r

end Lev

end

end EtPi1
end RamanujanPetersson

end Piece_Lev

/-! ### piece Ord -/
section Piece_Ord


/-!
# S4-EtPi1, O5 (part 1): `N`-th roots in unramified extensions have orders divisible by `N`

`A = 𝔽[x₁, …, xₙ]`, `K = Frac A`, `K' = constLevel K p m` with its level ring `R' = constF[x₁, …, xₙ]` (a UFD,
`Def_RP_EtPi1_Lev`). If `L ∈ unramSet A K` contains `K'` and an `N`-th root `α` of `a ∈ K'ˣ`, then for every prime
element `π` of `R'`, `N ∣ ord_π(den a) - ord_π(num a)` (`dvd_ord_of_unram`): localize `R'` at `π` inside `K'` (a DVR,
`isDedekindDomain_atPrime`), the inertia of `Gal(L/K')` there is trivial (`inertia_eq_bot_of_unramSet`), so `N` divides
the valuation (`dvd_log_valuation_of_inertia`), which is `ord_π(den) - ord_π(num)` (`log_valuation_place`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace EtPi1

open Polynomial Kummer

noncomputable section

section Ord

variable (F : Type) [Field F] (n : ℕ) (K : Type) [Field K] [Algebra (MvPolynomial (Fin n) F) K]
  [IsFractionRing (MvPolynomial (Fin n) F) K] [Algebra F K] [IsScalarTower F (MvPolynomial (Fin n) F) K]
  (p : ℕ) [Fact p.Prime] [CharP K p]

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The local ring of `levRing` at a prime element `π`, as a subalgebra of `constLevel K p m`. -/
abbrev locAt (m : ℕ) (π : levRing F n K p m) [(Ideal.span {π}).IsPrime] :
    Subalgebra (levRing F n K p m) (constLevel K p m) :=
  Localization.subalgebra.ofField (constLevel K p m) (Ideal.span {π}).primeCompl
    (Ideal.primeCompl_le_nonZeroDivisors _)

/-- **Orders of `N`-th powers.** -/
theorem dvd_ord_of_unram {m : ℕ} {L : IntermediateField K (AlgebraicClosure K)}
    (hL : L ∈ unramSet (MvPolynomial (Fin n) F) K) (hmL : constLevel K p m ≤ L)
    {N : ℕ} {α : AlgebraicClosure K} (hαL : α ∈ L) {a : constLevel K p m}
    (ha : α ^ N = (a : AlgebraicClosure K)) (ha0 : a ≠ 0) (π : levRing F n K p m) (hπ : Prime π) :
    (N : ℤ) ∣ (multiplicity π (IsFractionRing.den (levRing F n K p m) a : levRing F n K p m) : ℤ) -
      multiplicity π (IsFractionRing.num (levRing F n K p m) a) := by
  have : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).2 hπ
  let D := locAt F n K p m π
  let _ : Algebra (levRing F n K p m) D := Subalgebra.algebra D
  let _ : Algebra D (constLevel K p m) := Subalgebra.toAlgebra D
  let _ : Algebra (MvPolynomial (Fin n) F) D := Subalgebra.algebra' D
  have : @IsScalarTower (levRing F n K p m) D (constLevel K p m) Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsLocalization.AtPrime D (Ideal.span {π}) :=
    Localization.subalgebra.isLocalization_ofField (constLevel K p m) _ _
  have : IsFractionRing D (constLevel K p m) :=
    Localization.subalgebra.isFractionRing_ofField (constLevel K p m) _ _
  have : IsLocalRing D := IsLocalization.AtPrime.isLocalRing D (Ideal.span {π})
  have : IsDedekindDomain D := isDedekindDomain_atPrime π D
  let _ : Algebra (constLevel K p m) L := (IntermediateField.inclusion hmL).toRingHom.toAlgebra
  have : @IsScalarTower K (constLevel K p m) L Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let _ : Algebra D L := ((algebraMap (constLevel K p m) L).comp (algebraMap D (constLevel K p m))).toAlgebra
  have : @IsScalarTower D (constLevel K p m) L Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : @IsScalarTower (MvPolynomial (Fin n) F) D L Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : FiniteDimensional K L := hL.1
  have : IsGalois K L := hL.2.1
  have : FiniteDimensional (constLevel K p m) L := Module.Finite.of_restrictScalars_finite K _ L
  have : IsGalois (constLevel K p m) L := IsGalois.tower_top_of_isGalois K (constLevel K p m) L
  have hI : InertiaTrivial D (constLevel K p m) L := fun Q hQ => inertia_eq_bot_of_unramSet hL Q hQ
  have hαN : (⟨α, hαL⟩ : L) ^ N = algebraMap (constLevel K p m) L a := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow]
    exact ha
  have h := dvd_log_valuation_of_inertia D (constLevel K p m) L hI hαN (place π D hπ.ne_zero)
  rwa [log_valuation_place π D (constLevel K p m) hπ.ne_zero ha0] at h

end Ord

end

end EtPi1
end RamanujanPetersson

end Piece_Ord

/-! ### piece K12 -/
section Piece_K12


/-!
# S4-EtPi1, O5 (part 2): K12, `H¹(𝔸ⁿ ⊗ 𝔽̄, ℤ/N) = 0` for `p ∤ N`

`A = 𝔽[x₁, …, xₙ]` (`𝔽` finite of characteristic `p`), `K = Frac A`, `K_U = maxUnram A K`.

* `exists_constLevel_of_pow_mem`: if `α ∈ K_Uˣ` and `α ^ N` lies in a constant level `K' = constLevel K p k`, then so
  does `α` (some level): `N` divides every `π`-order of `a = α ^ N` in the UFD `constF[x₁, …, xₙ]` (`dvd_ord_of_unram`),
  so `a = u b ^ N` with `u` a unit, hence a constant, and `α / b` is an `N`-th root of a constant;
* `rad_le_fixUnits`: Kummer radicals for `π₁^geo` are `π₁^geo`-fixed;
* `H1_pi1geo_subsingleton`: **K12**, `H¹(π₁^geo, ℤ/N) = 0` (Kummer theory, `kummerEquiv`);
* `hom_eq_zero`: every locally constant homomorphism `π₁^geo → ℤ/N` is zero.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace EtPi1

open Polynomial Kummer CurveCoh

noncomputable section

section K12

variable {F : Type} [Field F] [Finite F] {n : ℕ} {K : Type} [Field K] [Algebra (MvPolynomial (Fin n) F) K]
  [IsFractionRing (MvPolynomial (Fin n) F) K] [Algebra F K] [IsScalarTower F (MvPolynomial (Fin n) F) K]
  {p : ℕ} [Fact p.Prime] [CharP K p]

/-- **K12 core**: an `N`-th root (`p ∤ N`) in `K_U` of an element of a constant level lies in a constant level. -/
theorem exists_constLevel_of_pow_mem {N : ℕ} [NeZero N] (hpN : Nat.Coprime p N) {α : AlgebraicClosure K}
    (hα : α ∈ maxUnram (MvPolynomial (Fin n) F) K) (hα0 : α ≠ 0) {k : ℕ} (hk : 0 < k)
    (ha : α ^ N ∈ constLevel K p k) : ∃ j, 0 < j ∧ α ∈ constLevel K p j := by
  obtain ⟨L, hL, hle⟩ := exists_unramSet_of_finite (A := MvPolynomial (Fin n) F) (K := K) {α}
    (fun x hx => by rw [Finset.mem_singleton] at hx; exact hx ▸ hα)
  have hαL : α ∈ L :=
    hle (IntermediateField.subset_adjoin K _ (Finset.mem_coe.2 (Finset.mem_singleton_self α)))
  have hL' : L ⊔ constLevel K p k ∈ unramSet (MvPolynomial (Fin n) F) K :=
    sup_mem_unramSet (A := MvPolynomial (Fin n) F) (K := K) hL (constLevel_mem_unramSet _ hk)
  have ha0 : (⟨α ^ N, ha⟩ : constLevel K p k) ≠ 0 := fun h =>
    hα0 ((pow_eq_zero_iff (NeZero.ne N)).1 (congrArg Subtype.val h))
  have hdvd := fun π hπ => dvd_ord_of_unram F n K p hL' le_sup_right
    ((le_sup_left : L ≤ L ⊔ constLevel K p k) hαL) (a := ⟨α ^ N, ha⟩) rfl ha0 π hπ
  obtain ⟨u, b, hab⟩ := exists_eq_unit_mul_pow (R := levRing F n K p k) (constLevel K p k) ha0 hdvd
  have hab' : α ^ N = levMap F n K p k u * (b : AlgebraicClosure K) ^ N := by
    simpa using congrArg Subtype.val hab
  have hb0 : (b : AlgebraicClosure K) ≠ 0 := by
    intro h0
    rw [h0, zero_pow (NeZero.ne N), mul_zero] at hab'
    exact hα0 ((pow_eq_zero_iff (NeZero.ne N)).1 hab')
  obtain ⟨j, hj, hc⟩ := levMap_isUnit_pow_eq F n K p k u.isUnit
  have hc0 : levMap F n K p k u ≠ 0 := fun h =>
    u.ne_zero (levMap_injective F n K p k (h.trans (map_zero _).symm))
  have hcv : (α / b) ^ N = levMap F n K p k u := by
    rw [div_pow, hab', mul_div_assoc, div_self (pow_ne_zero N hb0), mul_one]
  obtain ⟨t, ht, hpt⟩ := isConst_of_pow_eq (Fact.out : p.Prime).one_lt hj hpN hc hc0 hcv
  refine ⟨k * t, Nat.mul_pos hk ht, ?_⟩
  have h1 : α / b ∈ constLevel K p (k * t) :=
    constLevel_mono K p (dvd_mul_left t k) (Nat.mul_pos hk ht) (mem_constLevel ht hpt)
  have h2 : (b : AlgebraicClosure K) ∈ constLevel K p (k * t) :=
    constLevel_mono K p (dvd_mul_right k t) (Nat.mul_pos hk ht) b.2
  have h3 := mul_mem h1 h2
  rwa [div_mul_cancel₀ α hb0] at h3

/-- **Kummer radicals of `π₁^geo(𝔸ⁿ)` are fixed** (`p ∤ N`). -/
theorem rad_le_fixUnits {e : ℕ} (he : 0 < e) {N : ℕ} [NeZero N] (hpN : Nat.Coprime p N) :
    rad (pi1geo (MvPolynomial (Fin n) F) K (p ^ e)) N ≤ fixUnits (pi1geo (MvPolynomial (Fin n) F) K (p ^ e)) := by
  intro α hα
  obtain ⟨k, hk, hmem⟩ := (mem_rad_pi1geo_iff he N α).1 hα
  have hα0 : ((α : maxUnram (MvPolynomial (Fin n) F) K) : AlgebraicClosure K) ≠ 0 := fun h =>
    α.ne_zero (Subtype.ext h)
  obtain ⟨j, hj, hj'⟩ :=
    exists_constLevel_of_pow_mem hpN (α : maxUnram (MvPolynomial (Fin n) F) K).2 hα0 hk (by simpa using hmem)
  exact (mem_fixUnits_pi1geo_iff he α).2 ⟨j, hj, hj'⟩

theorem natCast_ne_zero_of_coprime {N : ℕ} (hpN : Nat.Coprime p N) : (N : K) ≠ 0 := fun h =>
  ((Nat.Prime.coprime_iff_not_dvd (Fact.out : p.Prime)).1 hpN) ((CharP.cast_eq_zero_iff K p N).1 h)

/-- **K12**: `H¹(𝔸ⁿ ⊗ 𝔽̄, ℤ/N) = 0` for `p ∤ N` (locally constant cohomology of `π₁^geo`). -/
theorem H1_pi1geo_subsingleton {e : ℕ} (he : 0 < e) {N : ℕ} [NeZero N] (hpN : Nat.Coprime p N) :
    Subsingleton (H1 (triv K (maxUnram (MvPolynomial (Fin n) F) K) N)
      (pi1geo (MvPolynomial (Fin n) F) K (p ^ e))) := by
  obtain ⟨ζ, hζ, hc⟩ := exists_zeta (MvPolynomial (Fin n) F) K p he N (natCast_ne_zero_of_coprime hpN)
  let E := kummerEquiv hζ (zeta_fixed hc)
  refine ⟨fun x y => Multiplicative.ofAdd.injective (E.symm.injective ?_)⟩
  obtain ⟨u, hu⟩ := QuotientGroup.mk_surjective (E.symm (Multiplicative.ofAdd x))
  obtain ⟨v, hv⟩ := QuotientGroup.mk_surjective (E.symm (Multiplicative.ofAdd y))
  rw [← hu, ← hv, QuotientGroup.eq]
  exact Subgroup.mem_subgroupOf.2 (rad_le_fixUnits he hpN (u⁻¹ * v).2)

/-- **Every locally constant homomorphism `π₁^geo(𝔸ⁿ) → ℤ/N` is zero** (`p ∤ N`). -/
theorem hom_eq_zero {e : ℕ} (he : 0 < e) {N : ℕ} [NeZero N] (hpN : Nat.Coprime p N)
    (c : pi1geo (MvPolynomial (Fin n) F) K (p ^ e) → ZMod N) (hlc : IsLocallyConstant c)
    (hadd : ∀ g h, c (g * h) = c g + c h) : c = 0 := by
  have hZ : c ∈ Z1 (triv K (maxUnram (MvPolynomial (Fin n) F) K) N)
      (pi1geo (MvPolynomial (Fin n) F) K (p ^ e)) :=
    (mem_Z1 _ _ c).2 ⟨hlc, fun g h => by rw [hadd]; simp [triv]⟩
  have := H1_pi1geo_subsingleton (F := F) (n := n) (K := K) he hpN
  let ρ := triv K (maxUnram (MvPolynomial (Fin n) F) K) N
  let Γ := pi1geo (MvPolynomial (Fin n) F) K (p ^ e)
  have h0 := H1mk_triv_injective (K := K) (E := maxUnram (MvPolynomial (Fin n) F) K) (N := N) Γ
    (Subsingleton.elim ((H1.mk ρ Γ) ⟨c, hZ⟩) ((H1.mk ρ Γ) 0))
  exact congrArg Subtype.val h0

end K12

end

end EtPi1
end RamanujanPetersson

end Piece_K12


