-- title:
--   Finite generation of lower central series quotients
-- statement:
--   If the abelianization $\Gamma_0/\Gamma_1$ of a group $G$ is finitely generated, then every lower-central-series quotient $\Gamma_k/\Gamma_{k+1}$ is finitely generated. The proof is by induction on $k$: the quotient $\Gamma_{k+1}/\Gamma_{k+2}$ is generated by the images of commutators $[s, t]$ where $s$ lifts a generator of $\Gamma_k/\Gamma_{k+1}$ and $t$ lifts a generator of $\Gamma_0/\Gamma_1$. The key input is the commutator bound $[\Gamma_k, \Gamma_1] \leq \Gamma_{k+2}$ (Wolf.commutator_lcs_le), which ensures the commutator map descends to a well-defined bilinear map on the quotients.

import Definitions.Def_MilnorWolf_Growth
import Mathlib

set_option autoImplicit false

open MilnorWolf

theorem Wolf.fg_quotient_lcs {G : Type*} [Group G] (hfg : Group.FG (↥(MilnorWolf.lcs G 0) ⧸ (MilnorWolf.lcs G 1).subgroupOf (MilnorWolf.lcs G 0))) (k : ℕ) : Group.FG (↥(MilnorWolf.lcs G k) ⧸ ((MilnorWolf.lcs G (k + 1)).subgroupOf (MilnorWolf.lcs G k))) := by sorry
