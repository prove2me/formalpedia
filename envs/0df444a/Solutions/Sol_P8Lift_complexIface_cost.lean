variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

theorem recCost_succ (Cloc : ℕ → ℝ → ℝ) (Cleaf : ℝ → ℝ) (k : ℕ) (V : ℝ) :
    recCost I u Cloc Cleaf (k + 1) V = Cloc (k + 1) V + s * recCost I u Cloc Cleaf k (V / W) := by
  rw [recCost, I.count]

/-- **§5.3 cost bound for the recursion**: with local work `≤ C V (u m^{k})^λ` per node and
`≤ C₀ V u` per leaf, and `s/W ≤ m^σ < m^λ`, the depth-`k` program costs
`≤ V (K₁ (u m^k)^λ + C₀ (u m^k)^σ u^{1-σ})`. -/
theorem recCost_le (hm : 2 ≤ m) (lam σ C C₀ : ℝ) (hsσ : (s : ℝ) / W ≤ (m : ℝ) ^ σ)
    (hσl : σ < lam) (hC : 0 ≤ C) (hC₀ : 0 ≤ C₀) :
    ∃ K₁ : ℝ, 0 ≤ K₁ ∧ ∀ (Cloc : ℕ → ℝ → ℝ) (Cleaf : ℝ → ℝ),
      (∀ V, 0 ≤ V → Cleaf V ≤ C₀ * V * u) →
      (∀ k V, 0 ≤ V → Cloc (k + 1) V ≤ C * V * ((u : ℝ) * (m : ℝ) ^ (k + 1)) ^ lam) →
      ∀ k V, 0 ≤ V → recCost I u Cloc Cleaf k V ≤
        V * (K₁ * ((u : ℝ) * (m : ℝ) ^ k) ^ lam +
          C₀ * (((u : ℝ) * (m : ℝ) ^ k) ^ σ * (u : ℝ) ^ (1 - σ))) := by
  have hW : 1 ≤ W := Nat.one_le_iff_ne_zero.2 (NeZero.ne W)
  obtain ⟨K₁, hK₁, h⟩ := batch_time_sigma m W s lam σ C C₀ hm hW hsσ hσl hC hC₀
  refine ⟨K₁, hK₁, fun Cloc Cleaf hleaf hloc => ?_⟩
  refine h u (Nat.cast_nonneg u) (recCost I u Cloc Cleaf) (fun V hV => hleaf V hV) ?_
  intro k V hV
  rw [recCost_succ]
  linarith [hloc k V hV]

