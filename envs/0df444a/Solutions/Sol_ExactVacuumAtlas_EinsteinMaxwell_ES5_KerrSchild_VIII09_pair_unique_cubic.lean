theorem solution (j : ℝ) {c d : ℝ → ℝ}
    (hc : MagClass 3 c) (hd : VClass 3 d)
    (hcEq : ∀ R ∈ Ioi (3:ℝ), Lmag c R = q3j j (1 / R) / R ^ 3)
    (hdEq : ∀ R ∈ Ioi (3:ℝ), Dell 0 c d R = r3j j (1 / R) / R) :
    EqOn c (cj j) (Ioi (3:ℝ)) ∧ EqOn d (dj j) (Ioi (3:ℝ)) := by
  have hL : ∀ R ∈ Ioi (3:ℝ), Lmag c R = sfun 0 (q3j j) (1 / R) / R ^ 3 := by
    intro R hR
    rw [hcEq R hR]
    simp [sfun]
  obtain ⟨hbc, hvc⟩ := pair_unique (j := (0:ℝ)) (q := q3j j) (r := r3j j)
    (q3j_contDiffOn j) (r3j_continuousOn j) hc hd hL hdEq
  exact ⟨hbc, hvc⟩
