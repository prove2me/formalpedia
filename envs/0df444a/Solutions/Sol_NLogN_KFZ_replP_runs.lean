variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem mvN_runs (X Y : Fin HS) (hXY : X ≠ Y) (hX : NC X) (hY : NC Y) (L : List ℤ) (B : ℕ)
    (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (RX : List Item) (h0 : s.G X = ints L ++ RX) :
    IRuns I iprog (rpt pA pC pD L.length (.op (.mv X Y))) s
      ((s.upd X RX).upd Y (ints L.reverse ++ s.G Y))
      (L.length * (110 * (B + 1) + 64) + 60 + cRpt L.length) := by
  obtain ⟨hXA, hXC, hXD⟩ := hX
  obtain ⟨hYA, hYC, hYD⟩ := hY
  let T : ℕ → IState HS := fun k =>
    (s.upd X (ints (L.drop k) ++ RX)).upd Y (ints (L.take k).reverse ++ s.G Y)
  have H := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp [T, hXA.symm, hYA.symm]) (fun k => by simp [T, hXC.symm, hYC.symm])
    (fun k => by simp [T, hXD.symm, hYD.symm]) (.op (.mv X Y)) (110 * (B + 1))
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have hx : (cf3 (T k) pA pC pD LA LC LD).G X = .int L[k] :: (ints (L.drop (k + 1)) ++ RX) := by
        simp only [T, cf3, IState.upd_G, if_neg hXD, if_neg hXC, if_neg hXA, if_neg hXY, if_true]
        rw [hd]; rfl
      have Hm := IRuns.mv (I := I) (iprog := iprog) hXY hx
      refine Hm.mono' ?_ ?_
      · have ht : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have e2 : ints (L.take (k + 1)).reverse = .int L[k] :: ints (L.take k).reverse := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear Hm e2 ht hd hx
        ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
      · have := moveIntCost_le (zsz L[k]); omega)
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil]
    rw [← h0]; simp [ints]
  have e1 : T L.length = (s.upd X RX).upd Y (ints L.reverse ++ s.G Y) := by
    simp only [T, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at H
  exact H

