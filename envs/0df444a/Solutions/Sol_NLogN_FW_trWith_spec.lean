namespace RS

variable (σ)

@[simp] theorem writes_ren : ∀ p : RS, (p.ren σ).writes = p.writes.map σ
  | skip => rfl
  | asg _ _ | push _ _ | pop _ => rfl
  | seq a b | ite _ a b => by simp [NLogN.RS.ren, writes, writes_ren a, writes_ren b]
  | rep i n b => by simp [NLogN.RS.ren, writes, writes_ren b]

theorem decSt_rn (i : Fin HS) (t : IState HS) : decSt (σ i) (t.rn σ) = (decSt i t).rn σ := by
  simp [decSt, IState.rn_upd]

theorem decE_ren (i : Fin HS) : decE (σ i) = (decE i).ren σ := rfl

theorem asgCost_ren (i : Fin HS) (e : Ex HS) (s : IState HS) :
    asgCost (σ i) (e.ren σ) (s.rn σ) = asgCost i e s := by
  simp [asgCost]

/-- Iterating a map that commutes with relocation. -/
theorem iterate_rn {F F' : IState HS → IState HS} (h : ∀ t, F' (t.rn σ) = (F t).rn σ) (k : ℕ)
    (t : IState HS) : F'^[k] (t.rn σ) = (F^[k] t).rn σ := by
  induction k generalizing t with
  | zero => rfl
  | succ k ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ← ih, h]

@[simp] theorem run_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).run (s.rn σ) = (p.run s).rn σ
  | skip, _ => rfl
  | asg i e, s => by simp [NLogN.RS.ren, NLogN.RS.run, IState.rn_upd]
  | push i e, s => by simp [NLogN.RS.ren, NLogN.RS.run, IState.rn_upd]
  | pop i, s => by simp [NLogN.RS.ren, NLogN.RS.run, IState.rn_upd]
  | seq a b, s => by simp [NLogN.RS.ren, NLogN.RS.run, run_ren a, run_ren b]
  | ite c a b, s => by
    simp only [NLogN.RS.ren, NLogN.RS.run, Ex.eval_ren]; split_ifs
    · exact run_ren a s
    · exact run_ren b s
  | rep i n b, s => by
    simp only [NLogN.RS.ren, NLogN.RS.run, Ex.eval_ren]
    rw [← IState.rn_G σ s i, ← IState.rn_upd,
      iterate_rn σ (F := fun t => decSt i (b.run t)) (fun t => by
        simp only [run_ren b, decSt_rn])]
    simp only [IState.rn_G, IState.rn_upd]

theorem repSt_ren (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (k : ℕ) :
    repSt (σ i) (n.ren σ) (b.ren σ) (s.rn σ) k = (repSt i n b s k).rn σ := by
  simp only [repSt, Ex.eval_ren]
  rw [← IState.rn_G σ s i, ← IState.rn_upd]
  exact iterate_rn σ (fun t => by simp only [run_ren, decSt_rn]) k _

@[simp] theorem cost_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).cost (s.rn σ) = p.cost s
  | skip, _ => rfl
  | asg i e, s => by simp [NLogN.RS.ren, cost, asgCost_ren]
  | push i e, s => by simp [NLogN.RS.ren, cost]
  | pop i, s => by simp [NLogN.RS.ren, cost]
  | seq a b, s => by simp [NLogN.RS.ren, cost, cost_ren a, cost_ren b]
  | ite c a b, s => by
    simp only [NLogN.RS.ren, cost, Ex.eval_ren, Ex.cost_ren]; split_ifs
    · rw [cost_ren a s]
    · rw [cost_ren b s]
  | rep i n b, s => by
    simp only [NLogN.RS.ren, cost, Ex.eval_ren, Ex.cost_ren, repSt_ren, cost_ren b, run_ren, decE_ren,
      asgCost_ren]

variable {σ}

theorem ok_ren (hσ : FixHi σ) : ∀ (p : RS) (s : IState HS), (p.ren σ).ok (s.rn σ) ↔ p.ok s
  | skip, _ => Iff.rfl
  | asg i e, s => by simp [NLogN.RS.ren, ok, hσ.lt56, Ex.Clean_ren hσ]
  | push i e, s => by simp [NLogN.RS.ren, ok, hσ.lt56, Ex.Clean_ren hσ]
  | pop i, s => by simp [NLogN.RS.ren, ok, hσ.lt56]
  | seq a b, s => by simp [NLogN.RS.ren, ok, ok_ren hσ a, ok_ren hσ b]
  | ite c a b, s => by
    simp only [NLogN.RS.ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ]; split_ifs
    · rw [ok_ren hσ a s]
    · rw [ok_ren hσ b s]
  | rep i n b, s => by
    simp only [NLogN.RS.ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ, hσ.lt56, writes_ren,
      List.mem_map, σ.injective.eq_iff, exists_eq_right, repSt_ren, ok_ren hσ b]

end RS

theorem IOp.run_ren (o : IOp HS) (s : IState HS) :
    (o.ren σ).run (s.rn σ) = (o.run s).map (fun r => (r.1.rn σ, r.2)) := by
  cases o <;> simp only [IOp.ren, IOp.run, IState.rn_G, σ.injective.eq_iff] <;>
    (repeat' split) <;> simp_all [IState.rn_upd]

namespace RM

open RS (decSt decE asgCost)

variable (σ)

theorem IOp.stks_ren (o : IOp HS) : (o.ren σ).stks = o.stks.map σ := by
  cases o <;> rfl

@[simp] theorem writes_ren : ∀ p : RM, (p.ren σ).writes = p.writes.map σ
  | rs p => RS.writes_ren σ p
  | mul _ _ _ => rfl
  | seq a b | ite _ a b => by simp [NLogN.RM.ren, writes, writes_ren a, writes_ren b]
  | rep i n b => by simp [NLogN.RM.ren, writes, writes_ren b]
  | op o => IOp.stks_ren σ o
  | prc .. => rfl

@[simp] theorem run_ren : ∀ (p : RM) (s : IState HS), (p.ren σ).run (s.rn σ) = (p.run s).rn σ
  | rs p, s => RS.run_ren σ p s
  | mul k i j, s => by simp [NLogN.RM.ren, NLogN.RM.run, IState.rn_upd]
  | seq a b, s => by simp [NLogN.RM.ren, NLogN.RM.run, run_ren a, run_ren b]
  | ite c a b, s => by
    simp only [NLogN.RM.ren, NLogN.RM.run, Ex.eval_ren]; split_ifs
    · exact run_ren a s
    · exact run_ren b s
  | rep i n b, s => by
    simp only [NLogN.RM.ren, NLogN.RM.run, Ex.eval_ren]
    rw [← IState.rn_G σ s i, ← IState.rn_upd,
      RS.iterate_rn σ (F := fun t => decSt i (b.run t)) (fun t => by
        simp only [run_ren b, RS.decSt_rn])]
    simp only [IState.rn_G, IState.rn_upd]
  | op o, s => by
    simp only [NLogN.RM.ren, NLogN.RM.run, IOp.run_ren]
    cases o.run s <;> rfl
  | prc .., s => by simp only [NLogN.RM.ren, NLogN.RM.run, IState.rn_inv_rn]

theorem repSt_ren (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (k : ℕ) :
    repSt (σ i) (n.ren σ) (b.ren σ) (s.rn σ) k = (repSt i n b s k).rn σ := by
  simp only [repSt, Ex.eval_ren]
  rw [← IState.rn_G σ s i, ← IState.rn_upd]
  exact RS.iterate_rn σ (fun t => by simp only [run_ren, RS.decSt_rn]) k _

@[simp] theorem cost_ren (M : MulSpec) :
    ∀ (p : RM) (s : IState HS), (p.ren σ).cost M (s.rn σ) = p.cost M s
  | rs p, s => RS.cost_ren σ p s
  | mul k i j, s => by simp [NLogN.RM.ren, cost, mulCost]
  | seq a b, s => by simp [NLogN.RM.ren, cost, cost_ren M a, cost_ren M b]
  | ite c a b, s => by
    simp only [NLogN.RM.ren, cost, Ex.eval_ren, Ex.cost_ren]; split_ifs
    · rw [cost_ren M a s]
    · rw [cost_ren M b s]
  | rep i n b, s => by
    simp only [NLogN.RM.ren, cost, Ex.eval_ren, Ex.cost_ren, repSt_ren, cost_ren M b, run_ren,
      RS.decE_ren, RS.asgCost_ren]
  | op o, s => by
    simp only [NLogN.RM.ren, cost, IOp.run_ren]
    cases o.run s <;> rfl
  | prc .., s => by simp only [NLogN.RM.ren, cost, IState.rn_inv_rn]

variable {σ}

theorem ok_ren (M : MulSpec) (hσ : FixHi σ) :
    ∀ (p : RM) (s : IState HS), (p.ren σ).ok M (s.rn σ) ↔ p.ok M s
  | rs p, s => RS.ok_ren hσ p s
  | mul k i j, s => by simp [NLogN.RM.ren, ok, hσ.lt55]
  | seq a b, s => by simp [NLogN.RM.ren, ok, ok_ren M hσ a, ok_ren M hσ b]
  | ite c a b, s => by
    simp only [NLogN.RM.ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ]; split_ifs
    · rw [ok_ren M hσ a s]
    · rw [ok_ren M hσ b s]
  | rep i n b, s => by
    simp only [NLogN.RM.ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ, hσ.lt56, writes_ren,
      List.mem_map, σ.injective.eq_iff, exists_eq_right, repSt_ren, ok_ren M hσ b]
  | op o, s => by
    simp only [NLogN.RM.ren, ok, IOp.run_ren]
    cases o.run s <;> rfl
  | prc .., s => by simp only [NLogN.RM.ren, ok, IState.rn_inv_rn]

/-- The relocated program on an arbitrary state `t`. -/
theorem run_ren_any (p : RM) (t : IState HS) :
    (p.ren σ).run t = (p.run (t.rn σ⁻¹)).rn σ := by
  conv_lhs => rw [← IState.rn_rn_inv σ t]
  exact run_ren σ p _

theorem ok_ren_any (M : MulSpec) (hσ : FixHi σ) (p : RM) (t : IState HS) :
    (p.ren σ).ok M t ↔ p.ok M (t.rn σ⁻¹) := by
  conv_lhs => rw [← IState.rn_rn_inv σ t]
  exact ok_ren M hσ p _

theorem cost_ren_any (M : MulSpec) (p : RM) (t : IState HS) :
    (p.ren σ).cost M t = p.cost M (t.rn σ⁻¹) := by
  conv_lhs => rw [← IState.rn_rn_inv σ t]
  exact cost_ren σ M p _

end RM

