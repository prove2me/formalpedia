    NLogN.KFY.RSAll (NLogN.KFY.takeD r e) t ((t.upd r (.int (e.eval t) :: t.G r)).upd NLogN.KFY.dS R)
      ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (2 * B + 2)) := by
