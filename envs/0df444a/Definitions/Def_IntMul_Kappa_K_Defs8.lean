lemma out3 (hh : 7 ≤ h) {S : Finset (Fin h)} (hS : S.card = 3) : ∃ k, k ∉ S :=
  exists_out S (by omega)

lemma HasON_Pp' (hh : 7 ≤ h) {S : Finset (Fin h)} (hS : S.card = 3) : HasON (Pp S) := by
