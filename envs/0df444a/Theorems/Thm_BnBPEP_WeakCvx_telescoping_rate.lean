-- Prove2me | Theorems.Thm_BnBPEP_WeakCvx_telescoping_rate
-- name    : BnBPEP.WeakCvx.telescoping_rate
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-08T06:47:20.558196+00:00
-- url     : https://prove2.me/theorems/bd093572-bd07-4a1c-ab87-6cb83c755fa9
-- title:
--   §6.3.2 — telescoping (32) gives $\frac1{N+1}\sum\|f'(y_i)\|^2\le\frac1{N+1}(\widetilde L^2\sum c_i+b_0R^2)$
-- statement:
--   Let $L>0$, $f\in\mathcal W_{1,L}$ with global minimizer $x_\star$, $R>0$, $N\in\mathbb N$ and $h\in\mathbb R$. Let $x_0,\dots,x_{N+1}$ be generated by $x_{k+1}=x_k-h\,f'(x_k)$ for $k\in[0:N]$, where each $f'(x_k)\in\partial f(x_k)$ is an arbitrary subgradient. Let $y_k=\mathrm{prox}_{(1/2)f}(x_k)$ for $k\in[0:N+1]$, $f'(y_k)=2(x_k-y_k)$, and assume the initial condition
--   $$f(y_0)-f(x_\star)+\|x_0-y_0\|^2\le R^2.$$
--   Let $b_0,\dots,b_{N+1}\ge0$ and $c_0,\dots,c_N\ge0$, put $\psi_k=b_k\big(f(y_k)-f(x_\star)+\|x_k-y_k\|^2\big)$, and suppose (32) holds for every $k\in[0:N]$:
--   $$\|f'(y_k)\|^2+\psi_{k+1}-\psi_k\le c_k\|f'(x_k)\|^2 .$$
--   Then
--   $$\frac{1}{N+1}\sum_{i=0}^{N}\|f'(y_i)\|^2\ \le\ \frac{1}{N+1}\Big(L^2\sum_{i=0}^{N}c_i+\psi_0-\psi_{N+1}\Big)\ \le\ \frac{1}{N+1}\Big(L^2\sum_{i=0}^{N}c_i+b_0R^2\Big).$$
--
--   This is the step that turns the one-iteration inequality (32) into a rate for the averaged squared stationarity measure; its right-hand side is the quantity that Theorem 1 and Corollary 1 then evaluate and minimize over $h$.
--
--   **Formalization Note** $L$ is the paper's $\widetilde L$. The potentials $\psi_k$ are written out in full. $f'(y_i)$ is $2(x_i-y_i)$, which by the Moreau-envelope milestone equals $\nabla f_{(1/2)}(x_i)$. Index ranges $[0:N]$ and $[0:N+1]$ are $k\le N$ and $k\le N+1$.
-- source:
--   Das Gupta, Van Parys, Ryu, Branch-and-bound performance estimation programming, Math. Program. 204 (2024), §6.3.2, p. 616, display after (32); initial condition and ψ_k on p. 615

import Mathlib
import Definitions.Def_SAGA_Convex_IsProxPoint
import Definitions.Def_BnBPEP_WeakCvx_IsWeakSubgrad
import Definitions.Def_BnBPEP_WeakCvx_InWeakClass

namespace BnBPEP.WeakCvx

/-- Telescoping display after (32), p. 616: if the potential inequality (32)
`‖f'(y_k)‖² + ψ_{k+1} - ψ_k ≤ c_k ‖f'(x_k)‖²`, with `ψ_k = b_k (f(y_k) - f(x⋆) + ‖x_k - y_k‖²)`
and `f'(y_k) = 2(x_k - y_k)`, holds for `k ∈ [0 : N]` with nonnegative `b, c`, then
`(1/(N+1)) Σ_{i=0}^N ‖f'(y_i)‖² ≤ (1/(N+1))(L² Σ c_i + ψ_0 - ψ_{N+1}) ≤ (1/(N+1))(L² Σ c_i + b_0 R²)`. -/
theorem telescoping_rate {d : ℕ} (f : EuclideanSpace ℝ (Fin d) → ℝ) (L : ℝ)
    (hL : 0 < L) (hf : InWeakClass 1 L f)
    (xstar : EuclideanSpace ℝ (Fin d)) (hxstar : ∀ z, f xstar ≤ f z)
    (R : ℝ) (hR : 0 < R) (N : ℕ) (h : ℝ)
    (x g y : ℕ → EuclideanSpace ℝ (Fin d))
    (hg : ∀ k ≤ N, IsWeakSubgrad 1 f (x k) (g k))
    (hstep : ∀ k ≤ N, x (k + 1) = x k - h • g k)
    (hy : ∀ k ≤ N + 1, SAGA.Convex.IsProxPoint f (1 / 2) (x k) (y k))
    (hinit : f (y 0) - f xstar + ‖x 0 - y 0‖ ^ 2 ≤ R ^ 2)
    (b c : ℕ → ℝ) (hb : ∀ k ≤ N + 1, 0 ≤ b k) (hc : ∀ k ≤ N, 0 ≤ c k)
    (h32 : ∀ k ≤ N,
      ‖(2 : ℝ) • (x k - y k)‖ ^ 2
          + b (k + 1) * (f (y (k + 1)) - f xstar + ‖x (k + 1) - y (k + 1)‖ ^ 2)
          - b k * (f (y k) - f xstar + ‖x k - y k‖ ^ 2)
        ≤ c k * ‖g k‖ ^ 2) :
    1 / ((N : ℝ) + 1) * ∑ i ∈ Finset.range (N + 1), ‖(2 : ℝ) • (x i - y i)‖ ^ 2
        ≤ 1 / ((N : ℝ) + 1) * (L ^ 2 * ∑ i ∈ Finset.range (N + 1), c i
            + b 0 * (f (y 0) - f xstar + ‖x 0 - y 0‖ ^ 2)
            - b (N + 1) * (f (y (N + 1)) - f xstar + ‖x (N + 1) - y (N + 1)‖ ^ 2)) ∧
      1 / ((N : ℝ) + 1) * (L ^ 2 * ∑ i ∈ Finset.range (N + 1), c i
            + b 0 * (f (y 0) - f xstar + ‖x 0 - y 0‖ ^ 2)
            - b (N + 1) * (f (y (N + 1)) - f xstar + ‖x (N + 1) - y (N + 1)‖ ^ 2))
        ≤ 1 / ((N : ℝ) + 1) * (L ^ 2 * ∑ i ∈ Finset.range (N + 1), c i + b 0 * R ^ 2) := by sorry

end BnBPEP.WeakCvx
