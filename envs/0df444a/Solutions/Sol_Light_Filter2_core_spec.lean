theorem hitB_iff {x : AEInst} {act D : ℕ → Bool} (hI1 : Light.Filter2.Inv1 x D) (hI2 : Light.Filter2.Inv2 x act D) {g : ℕ}
    (hg : g < x.n * x.n) :
    Light.Filter2.hitB x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act D g (Light.Filter2.mOf x.n) = true ↔
      ∃ c < x.n, Light.Filter2.triSum x.n x.AB x.BC x.AC g c = 0 := by
  unfold Light.Filter2.hitB
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range, Bool.and_eq_true]
  constructor
  · rintro (h | ⟨j, hj, ha, hb⟩)
    · exact hI1 g hg h
    · have h0 := (blockHit_iff hg (mul_sOf_lt hj)).1 hb
      have := witness_of_cnt0 h0
      rwa [mod_block hg] at this
  · rintro ⟨c, hc, h⟩
    cases hD : D g
    · right
      have hj := div_sOf_lt hc
      have h0 := cnt0_of_witness (sOf_pos x.n) hg hc h
      refine ⟨c / Light.Filter2.sOf x.n, hj, ?_, (blockHit_iff hg (mul_sOf_lt hj)).2 h0⟩
      refine hI2 _ ?_ (by rw [mod_block hg]; exact hD) h0
      unfold Light.Filter2.LL
      have := Nat.mul_le_mul_right (x.n * x.n) (show c / Light.Filter2.sOf x.n + 1 ≤ Light.Filter2.mOf x.n by omega)
      rw [Nat.add_mul, Nat.one_mul] at this
      omega
    · left; rfl

theorem seg_aeFlags {x : AEInst} {act D : ℕ → Bool} (hI1 : Light.Filter2.Inv1 x D) (hI2 : Light.Filter2.Inv2 x act D)
    {μ : ℕ → ℤ}
    (h : Light.Filter2.Arr μ x.out (x.n * x.n) fun g => Light.Filter2.bitB (Light.Filter2.hitB x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act D g (Light.Filter2.mOf x.n))) :
    Seg μ x.out (aeFlags x.n x.AB x.BC x.AC) := by
  intro i hi
  simp only [aeFlags, List.length_map, List.length_range] at hi
  rw [h i hi]
  simp only [aeFlags, List.getElem_map, List.getElem_range]
  have := hitB_iff hI1 hI2 hi
  unfold Light.Filter2.triSum at this
  by_cases hw : ∃ c < x.n, x.AB.getD i 0 + x.BC.getD (i % x.n * x.n + c) 0 +
      x.AC.getD (i / x.n * x.n + c) 0 = 0
  · rw [this.2 hw, flag, if_pos hw]; rfl
  · have hf : Light.Filter2.hitB x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act D i (Light.Filter2.mOf x.n) = false := by
      cases h' : Light.Filter2.hitB x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act D i (Light.Filter2.mOf x.n)
      · rfl
      · exact absurd (this.1 h') hw
    rw [hf, flag, if_neg hw]; rfl

/-- The work of the final scans is the number of marked candidates of the groups that are not
done. -/
theorem sum_cntG_eq (n s : ℕ) (act D : ℕ → Bool) :
    ∑ g ∈ Finset.range (n * n), Light.Filter2.cntG (n * n) ((n + s - 1) / s) act D g =
      Light.Filter2.cardA n s (Light.Filter2.eff (n * n) act D) := by
  unfold Light.Filter2.cntG Light.Filter2.cardA
  refine Finset.sum_congr rfl fun g hg => Finset.sum_congr rfl fun j _ => ?_
  simp only [Light.Filter2.eff, mod_block (Finset.mem_range.1 hg)]

theorem cardA_le_LL (n : ℕ) (A : ℕ → Bool) : Light.Filter2.cardA n (Light.Filter2.sOf n) A ≤ Light.Filter2.LL n := by
  calc Light.Filter2.cardA n (Light.Filter2.sOf n) A ≤ Light.Filter2.cardA n (Light.Filter2.sOf n) (fun _ => true) := cardA_mono fun _ _ => rfl
    _ = Light.Filter2.LL n := by rw [cardA_true]; unfold Light.Filter2.LL Light.Filter2.mOf; ring

theorem roundsOf_le_word (n U : ℕ) : Light.Filter2.roundsOf n ≤ Light.Filter2.filterWord n U := by
  have h1 : Light.Filter2.roundsOf n ≤ 3 * n + 1 := by
    have : Light.Filter2.kOf n ≤ n := Nat.size_le.2 Nat.lt_two_pow_self
    unfold Light.Filter2.roundsOf
    have := Nat.div_le_self (3 * Light.Filter2.kOf n) (Light.Filter2.dOf n)
    omega
  obtain ⟨k1, -, -, -⟩ := KW_ge n U
  have h2 : n + 1 ≤ (n + 1) ^ 3 := Nat.le_self_pow (by norm_num) _
  have h3 : Light.Filter2.KW n U ≤ Light.Filter2.KW n U * Light.Filter2.KW n U := Nat.le_mul_of_pos_left _ (by omega)
  rw [filterWord_eq]
  omega

