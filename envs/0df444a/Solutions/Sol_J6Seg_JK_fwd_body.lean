  have g1T : G1 dTJ = (cs.length : ℤ) :: (cs ++ flatT (fs.drop (r + 1)) ++ R) := by
    simp +decide [hG1, g0T]
  have s2 := Sp.push (s := s) (f := G1) (i := TT) (e := .reg dTJ) (B := Bx) (by decide)
