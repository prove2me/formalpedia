-- Source module: Solutions.J6AIL3
/-!
# A lines, IL side 3: the kernel frame and the header moves

The `A` kernel (`J6AIL4`) reads its parameters from the table stack `dT`: a header of register
values on top of the tables. Here:

* `AF G r0 w1 w2 o dt du`: the six stacks the kernel body changes (`0, W1, W2, OUT, dT, DU`)
  over a base `G` (the registers live in `G`);
* `tkL Rs`: the header values `vs` on top of `dT` into the registers `Rs` (`tkL_sp`:
  `G ↦ pushAll G Rs vs`);
* `rtLR Rs`: back from the registers onto `dT`, the registers emptied (`rtLR_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR.AK

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-- **The kernel frame**: the six stacks the kernel body changes, over a base `G`. -/
def AF (G : Fin HS → List ℤ) (r0 w1 w2 o dt du : List ℤ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (G) (0 : Fin HS) r0) W1 w1) W2 w2) OUT o) dT dt) DU du

section AFl
variable {G : Fin HS → List ℤ} {r0 w1 w2 o dt du : List ℤ}

@[simp] theorem AF_r0 : AF G r0 w1 w2 o dt du (0 : Fin HS) = r0 := by
  unfold AF; rw [Function.update_of_ne (show (0 : Fin HS) ≠ DU by decide), Function.update_of_ne (show (0 : Fin HS) ≠ dT by decide), Function.update_of_ne (show (0 : Fin HS) ≠ OUT by decide), Function.update_of_ne (show (0 : Fin HS) ≠ W2 by decide), Function.update_of_ne (show (0 : Fin HS) ≠ W1 by decide), Function.update_self]
@[simp] theorem AF_w1 : AF G r0 w1 w2 o dt du W1 = w1 := by
  unfold AF; rw [Function.update_of_ne (show W1 ≠ DU by decide), Function.update_of_ne (show W1 ≠ dT by decide), Function.update_of_ne (show W1 ≠ OUT by decide), Function.update_of_ne (show W1 ≠ W2 by decide), Function.update_self]
@[simp] theorem AF_w2 : AF G r0 w1 w2 o dt du W2 = w2 := by
  unfold AF; rw [Function.update_of_ne (show W2 ≠ DU by decide), Function.update_of_ne (show W2 ≠ dT by decide), Function.update_of_ne (show W2 ≠ OUT by decide), Function.update_self]
@[simp] theorem AF_o : AF G r0 w1 w2 o dt du OUT = o := by
  unfold AF; rw [Function.update_of_ne (show OUT ≠ DU by decide), Function.update_of_ne (show OUT ≠ dT by decide), Function.update_self]
@[simp] theorem AF_dt : AF G r0 w1 w2 o dt du dT = dt := by
  unfold AF; rw [Function.update_of_ne (show dT ≠ DU by decide), Function.update_self]
@[simp] theorem AF_du : AF G r0 w1 w2 o dt du DU = du := by
  unfold AF; rw [Function.update_self]

end AFl

/-! ## Header moves -/

/-- The registers outside the frame. -/
def FFree (R : Fin HS) : Prop :=
  R.val < 56 ∧ ∀ k ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS)), R ≠ k

/-- One header value from `dT` into `R`. -/
def tkH (R : Fin HS) : RS := .seq (.push R (.reg dT)) (.pop dT)

/-- One register value back onto `dT`, the register popped. -/
def rtH (R : Fin HS) : RS := .seq (.push dT (.reg R)) (.pop R)

/-- The header into the registers, in order. -/
def tkL : List (Fin HS) → RS
  | [] => .skip
  | R :: Rs => .seq (tkH R) (tkL Rs)

/-- The registers back onto `dT`, last first. -/
def rtLR : List (Fin HS) → RS
  | [] => .skip
  | R :: Rs => .seq (rtLR Rs) (rtH R)

/-- The registers after reading the header. -/
def pushAll (G : Fin HS → List ℤ) : List (Fin HS) → List ℤ → Fin HS → List ℤ
  | R :: Rs, v :: vs => pushAll (Function.update G R (v :: G R)) Rs vs
  | _, _ => G

end J6Seg.KR.AK

end

section
-- Source module: Solutions.J6SegKr6
/-!
# B3 (chunk kernel), part 6: the chunk on pairs with per-block records, and growth bounds

* `chunkB`, `chunkG2`: the chunk kernel on pairs, each block of length `n` with its own record
  length `r = 2n`; `liftG_chunkL2`: `liftG (chunkL …) = chunkG2 …`.
* growth: if the row entries are bounded by `X` and the tables by `2^P·Kt`, every stage value of a
  block of length `n ≤ λ` is bounded by `Xs ((λ+1)·Kt+1) X 7`, where `Xs K X i` iterates `X ↦ K·X+1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-! ## The chunk on pairs, per-block records -/

/-- Total length of the blocks. -/
def sumN : List (ℕ × List ℤ × List ℤ) → ℕ
  | [] => 0
  | d :: ds => d.1 + sumN ds

section chunk
variable (P : ℕ) (di gi gam dd : List ℤ)

/-- The blocks part of the chunk kernel. -/
def chunkB : List (ℕ × List ℤ × List ℤ) → List GI → List GI
  | [], _ => []
  | (n, am, ap) :: ds, z => blkG P (2 * n) di gi gam dd am ap (z.take n) ++ chunkB ds (z.drop n)

/-- The chunk kernel on pairs (zeros after the last block). -/
def chunkG2 (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI) : List GI :=
  chunkB P di gi gam dd ds z ++ (z.drop (sumN ds)).map fun _ => ((0 : ℤ), (0 : ℤ))

end chunk

/-! ## Growth of the stage values -/

/-- Iterates of `X ↦ K·X + 1`. -/
def Xs (K X : ℤ) : ℕ → ℤ
  | 0 => X
  | i + 1 => K * Xs K X i + 1

end J6Seg.KR

end

section
-- Source module: Solutions.J6AIL4
/-!
# A lines, IL side 4: the per-block `A` kernel as an IL program

`aKprog pM` computes `J6A.aKerL w2 bk win Q aTab rTab cTab` on the row on stack `0`. It reads
every parameter from its table on `dT`: the table `aKTab …` is the header `aHdr …` (register
values) followed by `aTab ++ rTab ++ cTab`.

1. `tkL aRegs`: the header into the registers (`R1 … R7`, `bN`, `bN2`, `rP`, `rP1`, and the
   record-product parameters `kc … kD`);
2. `dgI` (scale by `aTab`, rounding `Q`, exact because `aTab = 2^Q a`), drop the rest of the row,
   pad with `bk` zero pairs;
3. `aTab` off `dT` (onto `DU`); `tsI`: the Toeplitz stage (one record product, `Δ = 0`), rounding
   `Q`, exact because `rTab = 2^Q r`; it consumes `rTab` onto `DU`;
4. drop the first `w2` outputs; `dgI` with `cTab` (rounding `Q`) onto `OUT`;
5. `win - bk` zero pairs, the outputs back onto stack `0`;
6. restore the table (`DU → dT`) and the header (`rtLR aRegs`).

**`aK_runs`**: the run on the managed state of `RowBody6` (every stack but `0`, `dT` empty).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR.AK

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- Counts: `w2`, `2(win - w2)`, `2bk`, `2w2`, `bk`, `2(win - bk)`, `2w2 + bk`. -/
abbrev R1 : Fin HS := 26
abbrev R2 : Fin HS := 27
abbrev R3 : Fin HS := 28
abbrev R4 : Fin HS := 29
abbrev R5 : Fin HS := 30
abbrev R6 : Fin HS := 33
abbrev R7 : Fin HS := 34

/-- The header registers, in table order. -/
def aRegs : List (Fin HS) := [R7, R1, R2, R3, R4, R5, R6, bN, bN2, rP, rP1, kc, kr, kK, kB, kJ, kD]

/-- The header values. -/
def aHdr (w2 bk win Q pk b : ℕ) : List ℤ :=
  [((w2 + bk + w2 : ℕ) : ℤ), (w2 : ℤ), ((2 * (win - w2) : ℕ) : ℤ), ((2 * bk : ℕ) : ℤ),
   ((2 * w2 : ℕ) : ℤ), (bk : ℤ), ((2 * (win - bk) : ℕ) : ℤ), ((w2 + bk : ℕ) : ℤ),
   ((2 * (w2 + bk) : ℕ) : ℤ), 2 ^ Q, 2 ^ (Q + 1), 2 ^ pk, ((2 * (w2 + bk) : ℕ) : ℤ),
   kG b (2 * (w2 + bk)) (2 ^ pk), 2 ^ b, (2 ^ b) ^ (2 * (2 * (w2 + bk))), 1]

/-- Cost of the `A` kernel. -/
def cAK (w2 bk win pk b φ1 φ2 B BH : ℕ) : ℕ :=
  (17 * (5000 * (BH + 2)) + 1) + cDG w2 φ1 B + cMvP (2 * (win - w2)) B + cMvP (2 * bk) B +
  (2 * 2000 * (B + 2) + w2 * (14000 * (B + 2)) + 32) + cTS (w2 + bk) pk b φ2 B +
  cMvP (2 * w2) B + cDG bk φ1 B + cMvP (2 * (win - bk)) B + cMvP bk B +
  (2 * 2000 * (B + 2) + (w2 + bk + w2) * (14000 * (B + 2)) + 32) + (17 * (5000 * (BH + 2)) + 1)

/-- The registers after the header. -/
def aG (w2 bk win Q pk b : ℕ) : Fin HS → List ℤ :=
  pushAll (fun _ => []) aRegs (aHdr w2 bk win Q pk b)

end J6Seg.KR.AK

end

section
-- Source module: Solutions.J6SegILKer2
/-!
# B-line IL, B2 (kernel-pass wrapper) §2: table moves and the row loop

* `tLoad_sp`: pop the length `|T|` of the next table from the store `ρ 10`, push it on `U`
  (`ρ 15`) and keep it in `ρ 16`, move `T` to `dT` in order (through `T1 = ρ 14`).
* `tUnload_sp`: move `T` from `dT` onto `U` (reversed), drop the length.
* `rows_run`: the loop over the `post` rows of one block: call the kernel `e` on the row on top
  of stack `0` (tables on `dT`), move its output (`2m` integers) onto `Acc` (`ρ 17`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem RegOK.ne {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} (hR : RegOK ρ dT dF) {a b : Fin 19}
    (h : a ≠ b) : ρ a ≠ ρ b := hR.inj.ne h

/-! ## Loading and unloading a table -/

/-- Load the next table onto `dT`. -/
def tLoad (ρ : Fin 19 → Fin HS) (dT : Fin HS) : RS :=
  .seq (.push (ρ 16) (.reg (ρ 10))) (.seq (.pop (ρ 10)) (.seq (.push (ρ 15) (.reg (ρ 16)))
    (.seq (mvK (ρ 10) (ρ 14) (ρ 18) (.reg (ρ 16))) (mvK (ρ 14) dT (ρ 18) (.reg (ρ 16))))))

/-- Put the table on `dT` back (reversed) onto `U`. -/
def tUnload (ρ : Fin 19 → Fin HS) (dT : Fin HS) : RS :=
  .seq (mvK dT (ρ 15) (ρ 18) (.reg (ρ 16))) (.pop (ρ 16))

/-- The cost of one table move. -/
def cTab (B n : ℕ) : ℕ := 40000 * (B + 2) * (n + 1)

/-! ## The row loop -/

/-- One row: the kernel, then the output onto `Acc`. -/
def rowB {Pp : ℕ} (ρ : Fin 19 → Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  .seq (.call e) (mvK 0 (ρ 17) (ρ 18) (.reg (ρ 7))).code

/-- The rows of one block. -/
def rowsL {Pp : ℕ} (ρ : Fin 19 → Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  irep (ρ 13) (.reg (ρ 4)) (rowB ρ e)

/-- The cost of the rows of one block. -/
def cRows (Ckn B m post : ℕ) : ℕ := post * (Ckn + 40000 * (B + 2) * (m + 1)) + 10000 * (B + 2)

end J6Seg

end

section
-- Source module: Solutions.J6SegILKer3
/-!
# B-line IL, B2 (kernel-pass wrapper) §3: the block loops

`segT tabOf q = |tabOf q| :: tabOf q`; the table store holds `tabsT tabOf nc ++ R0`
(`tabsT = ⋃_{q < nc} segT q`).

* `qLoop_run`: for one outer index `i`, the loop over the chunks `q < nc`: load table `q`, run the
  `post` rows of block `i·nc + q` (kernel `g q`), unload; the store is consumed and `U` (`ρ 15`)
  collects the used tables, reversed.
* `iLoop_run`: the loop over `i < pre`: the chunk loop, then the store is restored from `U`.

The rows come from an abstract stream (`RowStream`): row `r` is `xr r`, on top of stack `0`
before it is `zA r`, the outputs so far are `aA r` (reversed), the kernel of row `r` is
`g (r / post % nc)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- One stored table. -/
def segT (tabOf : ℕ → List ℤ) (q : ℕ) : List ℤ := ((tabOf q).length : ℤ) :: tabOf q

/-- The table store. -/
def tabsT (tabOf : ℕ → List ℤ) (nc : ℕ) : List ℤ := (List.range nc).flatMap (segT tabOf)

/-- The row stream. -/
def RowStream (Pre : List GI → Prop) (g : ℕ → List GI → List GI) (B m post nc R : ℕ)
    (zA aA : ℕ → List ℤ) (xr : ℕ → List GI) : Prop :=
  ∀ r < R, zA r = gflat (xr r) ++ zA (r + 1) ∧ Pre (xr r) ∧
    (g (r / post % nc) (xr r)).length = m ∧ Bnd B (gflat (g (r / post % nc) (xr r))) ∧
    aA (r + 1) = (gflat (g (r / post % nc) (xr r))).reverse ++ aA r

/-- The chunk body. -/
def qBody {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dT : Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  .seq (tLoad ρ dT).code (.seq (rowsL ρ e) (tUnload ρ dT).code)

/-- The chunk loop. -/
def qLoop {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dT : Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  irep (ρ 12) (.reg (ρ 6)) (qBody ρ dT e)

/-- The outer body: the chunk loop, then restore the store. -/
def iBody {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dT : Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  .seq (qLoop ρ dT e) (mvK (ρ 15) (ρ 10) (ρ 18) (.reg (ρ 9))).code

/-- The outer loop. -/
def iLoop {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dT : Fin HS) (e : Fin Pp) : IStmt HS Pp :=
  irep (ρ 11) (.reg (ρ 5)) (iBody ρ dT e)

/-- Costs. -/
def cQb (Ckn B m post Lmax : ℕ) : ℕ := 2 * cTab B Lmax + cRows Ckn B m post
def cIb (Ckn B m post Lmax nc Tot : ℕ) : ℕ :=
  nc * (cQb Ckn B m post Lmax + 10000 * (B + 2)) + 20000 * (B + 2) * (Tot + 2)
def cIL (Ckn B m post Lmax nc Tot pre : ℕ) : ℕ :=
  pre * (cIb Ckn B m post Lmax nc Tot + 10000 * (B + 2)) + 10000 * (B + 2)

end J6Seg

end

section
-- Source module: Solutions.J6SegILKer4
/-!
# B-line IL, B2: the kernel-pass wrapper `kerW` (`kerPass` on stack `0`)

`kerW ρ dT dF eF eB e`:

1. push `descFine w f A post` on `dF` (by `dup` from `ρ 0, 2, 3, 4`), call `eF`, drop it:
   stack `0` becomes the exposure `X = blkT (2^f) post A L` (`A = pre·nc`);
2. `iLoop`: for `i < pre`, `q < nc`: load table `q` on `dT`, run the kernel `e` on the `post`
   rows of block `i·nc + q` (each output moved onto `Acc = ρ 17`), unload; restore the store;
3. move `Acc` back onto stack `0` (`ρ 8 = 2·A·post·2^f` integers);
4. push `descFine w' f A post`, call `eB`, drop it.

**`kerW_run`**: on the managed state `F` (registers as in `J6SegILKer1`, `F dT = []`) with
`F 0 = gflat L ++ l`, `LRep A (2^f) post L φ` and the kernel hypotheses on the rows `φ b c`,
the wrapper leaves `gflat (kerPass (2^f) post A (fun b => g (b % nc)) L) ++ l` on stack `0` and
everything else unchanged, at cost
`C₀ · cFine w f A post + C₀ · cFine w' f A post + kerC …` (`kerC`: the rows at `⌊Ck⌋₊ +
O((B+2)·2^f)` each, the table moves `O((B+2)·Lmax)` per block, `O((B+2)·|tabs|)` per `i`,
`O((B+2)·N)` for the final move).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

/-- Push the fine descriptor `[w, f, A, post]` (`w` from `rw`) on `dF`. -/
def descI {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dF rw : Fin HS) : IStmt HS Pp :=
  .seq (.op (.dup (ρ 4) dF)) (.seq (.op (.dup (ρ 3) dF)) (.seq (.op (.dup (ρ 2) dF))
    (.op (.dup rw dF))))

/-- Drop it. -/
def dropI {Pp : ℕ} (dF : Fin HS) : IStmt HS Pp :=
  .seq (.op (.drop dF)) (.seq (.op (.drop dF)) (.seq (.op (.drop dF)) (.op (.drop dF))))

/-- **The kernel-pass wrapper.** -/
def kerW {Pp : ℕ} (ρ : Fin 19 → Fin HS) (dT dF : Fin HS) (eF eB e : Fin Pp) : IStmt HS Pp :=
  .seq (descI ρ dF (ρ 0)) (.seq (.call eF) (.seq (dropI dF) (.seq (iLoop ρ dT e)
    (.seq (mvK (ρ 17) 0 (ρ 18) (.reg (ρ 8))).code (.seq (descI ρ dF (ρ 1))
      (.seq (.call eB) (dropI dF)))))))

/-- The cost of the wrapper outside the two fine exposures. -/
def kerC (Ckn B m post Lmax nc Tot pre N : ℕ) : ℕ :=
  cIL Ckn B m post Lmax nc Tot pre + 20000 * (B + 2) * (N + 1) + 4000 * (B + 1)

/-! ## The exposed rows -/

end J6Seg

end

section
-- Source module: Solutions.J6AIL11
/-!
# A lines, IL side 11: the copy step `dupL 32`

* `Sp.dupKE`: `dupK` with a general count expression;
* `cpBody T T2 C r`: from `T = G.reverse`, push `G` onto stack `0` (via `T2`) and restore `T`;
  `rpt k b`: `k` copies of `b` in sequence;
* **`dupP`**: read `pre, post, t` of the descriptor on `dA` into the register file, compute
  `2·pre·t·post`, move the array to `T`, push it back `32` times, drop `T`, leave the register file.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.DP

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH J6A.PA

/-! ## One copy -/

abbrev T1 : Fin HS := 16
abbrev T2 : Fin HS := 17
abbrev CC : Fin HS := 18

@[local simp] theorem neF0 : ((0 : Fin HS) = T1) = False := eq_false (by decide)
@[local simp] theorem neF1 : ((0 : Fin HS) = T2) = False := eq_false (by decide)
@[local simp] theorem neF2 : ((0 : Fin HS) = CC) = False := eq_false (by decide)
@[local simp] theorem neF3 : ((0 : Fin HS) = (20 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF4 : (T1 = (0 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF5 : (T1 = T2) = False := eq_false (by decide)
@[local simp] theorem neF6 : (T1 = CC) = False := eq_false (by decide)
@[local simp] theorem neF7 : (T1 = (20 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF8 : (T2 = (0 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF9 : (T2 = T1) = False := eq_false (by decide)
@[local simp] theorem neF10 : (T2 = CC) = False := eq_false (by decide)
@[local simp] theorem neF11 : (T2 = (20 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF12 : (CC = (0 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF13 : (CC = T1) = False := eq_false (by decide)
@[local simp] theorem neF14 : (CC = T2) = False := eq_false (by decide)
@[local simp] theorem neF15 : (CC = (20 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF16 : ((20 : Fin HS) = (0 : Fin HS)) = False := eq_false (by decide)
@[local simp] theorem neF17 : ((20 : Fin HS) = T1) = False := eq_false (by decide)
@[local simp] theorem neF18 : ((20 : Fin HS) = T2) = False := eq_false (by decide)
@[local simp] theorem neF19 : ((20 : Fin HS) = CC) = False := eq_false (by decide)

/-- From `T1 = G.reverse` (count `|G|` on `20`) push `G` onto `0` and restore `T1`. -/
def cpBody : RS := .seq (dupKE T1 0 T2 CC (.reg 20)) (mvK T2 T1 CC (.reg 20))

/-- `k` copies of a program in sequence. -/
def rpt : ℕ → RS → RS
  | 0, _ => .skip
  | k + 1, b => .seq (rpt k b) b

/-- The cost of one copy. -/
def cB (n Bb : ℕ) : ℕ :=
  ((1 + 1) * 2000 * (Bb + 2) + n * ((1 + 1) * 2000 * (Bb + 2) +
    (1 + 1) * 2000 * (Bb + 2) + (2 * Bb + 2) + 8000 * (Bb + 2) + 30) + 32) +
  ((1 + 1) * 2000 * (Bb + 2) + n * (14000 * (Bb + 2)) + 32)

/-! ## The copy step -/

/-- `2 · pre · (t · post)`. -/
def nE : Ex HS := .mul (.lit 2) (.mul (.reg 1) (.mul (.reg 4) (.reg 2)))

/-- Read `pre, post, t` and compute the flat length. -/
def rdN (X : Fin HS) : RS :=
  .seq (rdK X 1 1) (.seq (rdK X 2 2) (.seq (rdK X 4 4) (.asg 20 nE)))

/-- **The copy step.** -/
def dupP (X : Fin HS) : RS :=
  .seq (initP rg) (.seq (rdN X) (.seq (mvK 0 T1 CC (.reg 20)) (.seq (rpt 31 cpBody)
    (.seq (mvK T1 0 CC (.reg 20)) (finiP rg)))))

/-- The cost of the copy step. -/
def cDupP (W n Bb : ℕ) : ℕ :=
  (21 * 8001 + 1) + (cRdK 1 W + (cRdK 2 W + (cRdK 4 W + J6Seg.PJ.cT nE W))) +
    ((1 + 1) * 2000 * (Bb + 2) + n * (14000 * (Bb + 2)) + 32) + (31 * cB n Bb + 1) +
    ((1 + 1) * 2000 * (Bb + 2) + n * (14000 * (Bb + 2)) + 32) + (21 * (2 * (W + 1) + 2) + 1)

end J6A.DP

end

section
-- Source module: Solutions.J6AIL12
/-!
# A lines, IL side 12: the parameter block on any descriptor stack

`parAX X` is `parA` reading the descriptor from the stack `X` (`parA = parAX 31`), and
**`Rn.parAX`** is `Rn.parA` for every `X ∉ rg`, `X < 56`, `X ≠ 15, 47`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.PA

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH

/-- **The parameter block on the stack `X`.** -/
def parAX (X : Fin HS) : RS := seqL [rdK X 1 1, rdK X 2 2, rdK X 3 3, rdK X 4 4, rdK X 5 5, rdK X 6 6,
  .asg 20 (.lit 0), .asg 21 (.lit 0), .rep cL (.reg 5) sqB, .asg 7 mE,
  .asg 20 (.lit 1), .asg 8 (.lit 1), .asg 22 (.lit 0), .rep cL (.reg 7) lgB,
  .asg 9 (.add (.add (.reg 8) (.reg 7)) (.lit 3)),
  .asg 11 (.mul (.lit 8) (.reg 8)),
  .asg 12 (.add (.reg 22) (.lit 3)),
  .asg 10 (.ndiv (.reg 4) (.mul (.lit 16) (.reg 8)))]

end J6A.PA

end

section
-- Source module: Solutions.J6AIL13
/-!
# A lines, IL side 13: the fine-descriptor set-ups

For a fine descriptor `descFine w f a y` with `w = p + 2`, `f` a literal and `a`, `y` expressions in
the registers of `parAX X`:

* `fsR X ea ey fl Q`: enter the register file, `parAX X`, push `w, f, a, y` on four temporaries
  `Q 0 … Q 3` (outside `rg`, away from `dF`), leave the register file;
* `fsUp`: then copy `y, a, f, w` onto `dF` and drop the temporaries; `fsDn`: drop four from `dF`.

**`fsUp_runs`** / **`fsDn_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.FS

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function J6A.PA IntMul.Kappa.R6

/-- The base of the temporaries. -/
def qb (dF : Fin HS) : ℕ := if 16 ≤ dF.val ∧ dF.val ≤ 19 then 32 else 16

theorem qb_cases (dF : Fin HS) : (qb dF = 32 ∧ 16 ≤ dF.val ∧ dF.val ≤ 19) ∨
    (qb dF = 16 ∧ ¬ (16 ≤ dF.val ∧ dF.val ≤ 19)) := by
  unfold qb; split_ifs with h
  · exact Or.inl ⟨rfl, h⟩
  · exact Or.inr ⟨rfl, h⟩

/-- The temporaries. -/
def Q (dF : Fin HS) (i : Fin 4) : Fin HS :=
  ⟨qb dF + i.val, by rcases qb_cases dF with h | h <;> (rw [h.1]; have := i.isLt; unfold HS; omega)⟩

/-- `w = p + 2`. -/
def eW : Ex HS := .add (.reg 5) (.lit 2)

/-- The register part. -/
def fsR (X : Fin HS) (ea ey : Ex HS) (fl : ℕ) (dF : Fin HS) : RS :=
  .seq (initP rg) (.seq (parAX X) (.seq (.push (Q dF 0) eW) (.seq (.push (Q dF 1) (.lit fl))
    (.seq (.push (Q dF 2) ea) (.seq (.push (Q dF 3) ey) (finiP rg))))))

/-- **The set-up**: registers, then copy onto `dF`, then drop the temporaries. -/
def fsUp {Pp : ℕ} (X : Fin HS) (ea ey : Ex HS) (fl : ℕ) (dF : Fin HS) : IStmt HS Pp :=
  .seq (fsR X ea ey fl dF).code (.seq (.op (.dup (Q dF 3) dF)) (.seq (.op (.dup (Q dF 2) dF))
    (.seq (.op (.dup (Q dF 1) dF)) (.seq (.op (.dup (Q dF 0) dF))
    (.seq (.op (.drop (Q dF 0))) (.seq (.op (.drop (Q dF 1))) (.seq (.op (.drop (Q dF 2)))
      (.op (.drop (Q dF 3))))))))))

/-- **The tear-down.** -/
def fsDn {Pp : ℕ} (dF : Fin HS) : IStmt HS Pp :=
  .seq (.op (.drop dF)) (.seq (.op (.drop dF)) (.seq (.op (.drop dF)) (.op (.drop dF))))

/-- The register file after the four pushes, back on the stacks. -/
def fsG (F : Fin HS → List ℤ) (dF : Fin HS) (w f a y : ℤ) : Fin HS → List ℤ :=
  update (update (update (update F (Q dF 0) [w]) (Q dF 1) [f]) (Q dF 2) [a]) (Q dF 3) [y]

/-- The cost of the register part. -/
def cFsR (W p m : ℕ) (ea ey : Ex HS) (fl : ℕ) : ℕ :=
  (21 * 8001 + 1) + (cParA W p m + (J6Seg.PJ.cT eW W + (J6Seg.PJ.cT (.lit fl : Ex HS) W +
    (J6Seg.PJ.cT ea W + J6Seg.PJ.cT ey W)))) + (21 * (2 * (W + 1) + 2) + 1)

section il
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The cost of the stack part. -/
def cFsI (w f a y : ℤ) : ℕ :=
  (dupCost (zsz y) + 17) + (dupCost (zsz a) + 17) + (dupCost (zsz f) + 17) +
    (dupCost (zsz w) + 17) + (2 * zsz w + 2) + (2 * zsz f + 2) + (2 * zsz a + 2) + (2 * zsz y + 2)

end il

section runs
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The cost of the tear-down. -/
def cFsD (w f a y : ℕ) : ℕ :=
  (2 * zsz (w : ℤ) + 2) + (2 * zsz (f : ℤ) + 2) + (2 * zsz (a : ℤ) + 2) + (2 * zsz (y : ℤ) + 2)

end runs

end J6A.FS

end

