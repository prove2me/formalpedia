theorem abs_det_le_factorial_pow (A : Matrix ι ι ℤ) (R : ℤ)
    (_hR : 0 ≤ R) (hA : ∀ i j, |A i j| ≤ R) :
    |A.det| ≤ (Fintype.card ι).factorial * R ^ Fintype.card ι := by
  rw [Matrix.det_apply']
  calc
    |∑ σ : Equiv.Perm ι, (Equiv.Perm.sign σ : ℤ) * ∏ i, A (σ i) i| ≤
        ∑ σ : Equiv.Perm ι, |(Equiv.Perm.sign σ : ℤ) * ∏ i, A (σ i) i| :=
      Finset.abs_sum_le_sum_abs _ _
    _ = ∑ σ : Equiv.Perm ι, ∏ i, |A (σ i) i| := by
      simp only [abs_mul, Equiv.Perm.sign_abs, one_mul, Finset.abs_prod]
    _ ≤ ∑ _σ : Equiv.Perm ι, R ^ Fintype.card ι := by
      apply Finset.sum_le_sum
      intro σ _
      simpa only [Finset.prod_const, Finset.card_univ] using
        Finset.prod_le_prod (s := (Finset.univ : Finset ι)) (fun i _ => abs_nonneg (A (σ i) i))
        (fun i _ => hA (σ i) i)
    _ = (Fintype.card ι).factorial * R ^ Fintype.card ι := by
      simp [Fintype.card_perm]

/-- Bounding an adjugate using the full determinant of its updated-row definition avoids
special cases for zero-dimensional and one-dimensional deleted minors. -/
theorem abs_adjugate_le_factorial_pow (A : Matrix ι ι ℤ) (R : ℤ)
    (hR : 1 ≤ R) (hA : ∀ i j, |A i j| ≤ R) (i j : ι) :
    |A.adjugate i j| ≤ (Fintype.card ι).factorial * R ^ Fintype.card ι := by
  rw [Matrix.adjugate_apply]
  apply abs_det_le_factorial_pow _ R (by omega)
  intro k l
  by_cases hk : k = j
  · subst k
    simp only [Matrix.updateRow_self]
    by_cases hl : l = i
    · subst l
      simpa using hR
    · simpa [Pi.single_eq_of_ne hl] using (show (0 : ℤ) ≤ R by omega)
  · simpa only [Matrix.updateRow_ne hk] using hA k l

omit [Fintype ι] [DecidableEq ι] in
theorem abs_mulVec_le {κ : Type*} [Fintype κ]
    (A : Matrix ι κ ℤ) (v : κ → ℤ) (a b : ℤ)
    (ha : 0 ≤ a) (hA : ∀ i j, |A i j| ≤ a) (hv : ∀ j, |v j| ≤ b) (i : ι) :
    |(A *ᵥ v) i| ≤ Fintype.card κ * a * b := by
  calc
    |(A *ᵥ v) i| ≤ ∑ j, |A i j * v j| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : κ, a * b := by
      apply Finset.sum_le_sum
      intro j _
      rw [abs_mul]
      exact mul_le_mul (hA i j) (hv j) (abs_nonneg _) ha
    _ = Fintype.card κ * a * b := by simp [mul_assoc]

omit [Fintype ι] [DecidableEq ι] in
theorem abs_matrix_mul_le {κ ν : Type*} [Fintype κ]
    (A : Matrix ι κ ℤ) (B : Matrix κ ν ℤ) (a b : ℤ)
    (ha : 0 ≤ a) (hA : ∀ i j, |A i j| ≤ a) (hB : ∀ i j, |B i j| ≤ b)
    (i : ι) (j : ν) :
    |(A * B) i j| ≤ Fintype.card κ * a * b :=
  abs_mulVec_le A (fun k => B k j) a b ha hA (fun k => hB k j) i

