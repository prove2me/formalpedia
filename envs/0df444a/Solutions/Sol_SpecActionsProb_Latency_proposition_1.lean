lemma hits_closed (q : ℝ) (hq : 0 ≤ q) :
    ∀ n, SpecActions.hits q n = SpecActions.hitsClosed q n ∧
      SpecActions.hits q (n + 1) = SpecActions.hitsClosed q (n + 1) := by
  have h1 : (1 + q) ≠ 0 := by linarith
  intro n
  induction n with
  | zero =>
    refine ⟨by simp [SpecActions.hits, SpecActions.hitsClosed], ?_⟩
    simp only [SpecActions.hits, SpecActions.hitsClosed]
    field_simp; ring
  | succ n ih =>
    refine ⟨ih.2, ?_⟩
    rw [SpecActions.hits, ih.1, ih.2]
    simp only [SpecActions.hitsClosed]
    push_cast
    field_simp; ring

