theorem sg_tdiv (a : ℤ) (m : ℕ) : sg a (a.natAbs / 2 ^ m) = a.tdiv (2 ^ m) := by
  unfold sg
  split_ifs with h
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, a = -k := ⟨a.natAbs, by omega⟩
    rw [Int.neg_tdiv]
    simp only [Int.natAbs_neg, Int.natAbs_natCast, neg_inj]
    rw [show ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) by push_cast; rfl, ← Int.ofNat_tdiv]
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, a = k := ⟨a.natAbs, by omega⟩
    simp only [Int.natAbs_natCast]
    rw [show ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) by push_cast; rfl, ← Int.ofNat_tdiv]

theorem sg_tmod (a : ℤ) (m : ℕ) : sg a (a.natAbs % 2 ^ m) = a.tmod (2 ^ m) := by
  unfold sg
  split_ifs with h
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, a = -k := ⟨a.natAbs, by omega⟩
    rw [Int.neg_tmod]
    simp only [Int.natAbs_neg, Int.natAbs_natCast, neg_inj]
    rw [show ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) by push_cast; rfl, ← Int.ofNat_tmod]
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, a = k := ⟨a.natAbs, by omega⟩
    simp only [Int.natAbs_natCast]
    rw [show ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) by push_cast; rfl, ← Int.ofNat_tmod]

theorem zX_all : zX.all = [56, 57, 58, 59, 60, 61, 62, 63] := rfl

theorem zsz_sg_div_le (a : ℤ) (m : ℕ) : zsz (sg a (a.natAbs / 2 ^ m)) ≤ zsz a :=
  zsz_mono_r6c (by rw [natAbs_sg]; exact Nat.div_le_self _ _)

theorem zsz_sg_mod_le (a : ℤ) (m : ℕ) : zsz (sg a (a.natAbs % 2 ^ m)) ≤ zsz a :=
  zsz_mono_r6c (by rw [natAbs_sg]; exact Nat.mod_le _ _)

namespace Ex

theorem Clean.not56 {e : Ex HS} (h : e.Clean) : (56 : Fin HS) ∉ e.regs := fun hm =>
  h _ hm (by simp [zX_all])

theorem code_runs_r6c : ∀ (e : Ex HS) (s : IState HS), e.Clean → e.ok s →
