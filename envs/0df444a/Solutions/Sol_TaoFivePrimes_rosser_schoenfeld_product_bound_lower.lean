theorem term_ge_minorant (m : ℕ) (hm : 201 ≤ m) :
    (1:ℝ)/(2*((m:ℝ)+9/50)*((m:ℝ)+9/50+1)) ≤ ZetaAsymptotics.term m 1 := by
  have hmR : (201:ℝ) ≤ (m:ℝ) := by exact_mod_cast hm
  rw [ZetaAsymptotics.term_one (by omega : 0 < m)]
  have hlog : Real.log ((m:ℝ)+1) - Real.log (m:ℝ) = -Real.log (1 - 1/((m:ℝ)+1)) := by
    have hden : (1:ℝ) - 1/((m:ℝ)+1) = (m:ℝ)/((m:ℝ)+1) := by
      field_simp
      ring
    rw [hden, Real.log_div (by positivity) (by positivity)]
    ring
  rw [hlog]
  set u : ℝ := 1/((m:ℝ)+1) with hu
  have hu0 : 0 < u := by rw [hu]; positivity
  have hu1 : |u| < 1 := by
    rw [abs_of_pos hu0, hu, div_lt_one (by positivity)]
    linarith
  have hHS := Real.hasSum_pow_div_log_of_abs_lt_one hu1
  have hsumm : Summable (fun n : ℕ => u ^ (n+1) / (n+1)) := hHS.summable
  have h3 := Summable.sum_le_tsum (Finset.range 3) (fun n _ => by positivity) hsumm
  rw [hHS.tsum_eq] at h3
  have h3e : ∑ n ∈ Finset.range 3, u ^ (n+1) / (n+1) = u + u^2/2 + u^3/3 := by
    rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ,
      Finset.sum_range_zero]
    norm_num
  rw [h3e] at h3
  have hsub : u + u^2/2 + u^3/3 - 1/((m:ℝ)+1) = u^2/2 + u^3/3 := by
    rw [hu]
    field_simp
    ring
  have h3b : u^2/2 + u^3/3 ≤ -Real.log (1-u) - 1/((m:ℝ)+1) := by
    linarith [h3, hsub]
  have hpoly : (1:ℝ)/(2*((m:ℝ)+9/50)*((m:ℝ)+9/50+1)) ≤ u^2/2 + u^3/3 := by
    rw [hu]
    field_simp
    nlinarith [hmR, sq_nonneg ((m:ℝ)-201)]
  exact le_trans hpoly h3b

theorem hasSum_minorant_telescope (a : ℝ) (ha0 : 0 < a) :
    HasSum (fun k : ℕ => (1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a)) ((1/2)/a) := by
  refine (hasSum_iff_tendsto_nat_of_nonneg ?_ _).mpr ?_
  · intro k
    rw [show (((k+1:ℕ):ℝ)+a) = (k:ℝ)+a+1 by push_cast; ring]
    rw [show (1/2)/((k:ℝ)+a) - (1/2)/((k:ℝ)+a+1)
        = (1/2)/(((k:ℝ)+a)*((k:ℝ)+a+1)) by
      field_simp
      ring]
    positivity
  · have hps : ∀ n, (∑ k ∈ Finset.range n,
        ((1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a)))
        = (1/2)/a - (1/2)/((n:ℝ)+a) := by
      intro n
      rw [Finset.sum_range_sub']
      simp only [Nat.cast_zero, zero_add]
    have h1 : Tendsto (fun n : ℕ => ((n:ℝ) + a)) atTop atTop :=
      tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop
    have h2 : Tendsto (fun n : ℕ => (1/2)/((n:ℝ) + a)) atTop (nhds 0) := by
      have h2' : Tendsto (fun n : ℕ => (((n:ℝ) + a))⁻¹) atTop (nhds 0) :=
        h1.inv_tendsto_atTop
      have hc : Tendsto (fun n : ℕ => (1/2) * (((n:ℝ) + a))⁻¹) atTop
          (nhds ((1/2) * 0)) := tendsto_const_nhds.mul h2'
      rw [mul_zero] at hc
      simpa only [div_eq_mul_inv] using hc
    have h4 : Tendsto (fun n : ℕ => (1/2)/a - (1/2)/((n:ℝ) + a)) atTop
        (nhds ((1/2)/a - 0)) := tendsto_const_nhds.sub h2
    rw [sub_zero] at h4
    simpa only [hps] using h4

theorem gammaUpS_bound : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ) := by
  have hf : Summable (fun n : ℕ => ZetaAsymptotics.term (n+1) 1) :=
    ZetaAsymptotics.term_tsum_one.summable
  have hsplit := Summable.sum_add_tsum_nat_add 200 hf
  rw [ZetaAsymptotics.term_tsum_one.tsum_eq] at hsplit
  have htail_eq : (∑' i : ℕ, (fun n : ℕ => ZetaAsymptotics.term (n+1) 1) (i+200))
      = (∑' k : ℕ, ZetaAsymptotics.term (k+201) 1) := by
    apply tsum_congr
    intro i
    congr 1
  rw [htail_eq] at hsplit
  have htermSum : (∑ i ∈ Finset.range 200, ZetaAsymptotics.term (i+1) 1)
      = Real.log 201 - (harmonic 201 : ℝ) + 1 := by
    have h := ZetaAsymptotics.termSum_one 200
    unfold ZetaAsymptotics.termSum at h
    rw [show ((200:ℕ):ℝ) + 1 = 201 by norm_num, show (200 + 1 : ℕ) = 201 by norm_num] at h
    exact h
  rw [htermSum] at hsplit
  have hγ : Real.eulerMascheroniConstant = (harmonic 201 : ℝ) - Real.log 201
      - (∑' k : ℕ, ZetaAsymptotics.term (k+201) 1) := by linarith
  have hlo : (logLo15 201 : ℝ) ≤ (S : ℝ) * Real.log 201 :=
    logLo15_sound 201 (by norm_num) (by norm_num)
  have hsumg : Summable (fun k : ℕ => ZetaAsymptotics.term (k+201) 1) :=
    (summable_nat_add_iff 200).mpr hf
  set a : ℝ := (201:ℝ)+9/50 with ha
  have ha0 : 0 < a := by rw [ha]; norm_num
  have hmin_hasSum := hasSum_minorant_telescope a ha0
  have hterm_ge : ∀ k : ℕ,
      (1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a) ≤
        ZetaAsymptotics.term (k+201) 1 := by
    intro k
    have h := term_ge_minorant (k+201) (by omega)
    have hconv : (1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a)
        = (1:ℝ)/(2*((k:ℝ)+a)*((k:ℝ)+a+1)) := by
      rw [show (((k+1:ℕ):ℝ)+a) = (k:ℝ)+a+1 by push_cast; ring]
      field_simp
      ring
    rw [hconv]
    have hshape : (k:ℝ)+a = ((k+201:ℕ):ℝ)+9/50 := by
      rw [ha]
      push_cast
      ring
    rw [hshape]
    exact h
  have hmin_le : (∑' k : ℕ, ((1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a)))
      ≤ (∑' k : ℕ, ZetaAsymptotics.term (k+201) 1) :=
    Summable.tsum_le_tsum hterm_ge hmin_hasSum.summable hsumg
  have hmin_val : (∑' k : ℕ, ((1/2)/((k:ℝ)+a) - (1/2)/(((k+1:ℕ):ℝ)+a)))
      = (25:ℝ)/10059 := by
    rw [hmin_hasSum.tsum_eq, ha]
    norm_num
  have hlo_div : (logLo15 201 : ℝ)/(S : ℝ) ≤ Real.log 201 := by
    rw [div_le_iff₀ (by norm_num [S] : (0:ℝ) < (S:ℝ))]
    linarith [hlo]
  have hnum : (harmonic 201 : ℝ) - (logLo15 201 : ℝ)/(S:ℝ) - (25:ℝ)/10059
      < (gammaUpS:ℝ)/(S:ℝ) := by
    have hval : logLo15 201 = 5303304906238512 := by decide +kernel
    rw [hval]
    norm_num [harmonic, S, gammaUpS]
  calc Real.eulerMascheroniConstant
      = (harmonic 201 : ℝ) - Real.log 201 - (∑' k : ℕ, ZetaAsymptotics.term (k+201) 1) := hγ
    _ ≤ (harmonic 201 : ℝ) - (logLo15 201 : ℝ)/(S:ℝ) - (25:ℝ)/10059 := by
        rw [← hmin_val]
        linarith [hlo_div, hmin_le]
    _ < (gammaUpS:ℝ)/(S:ℝ) := hnum

