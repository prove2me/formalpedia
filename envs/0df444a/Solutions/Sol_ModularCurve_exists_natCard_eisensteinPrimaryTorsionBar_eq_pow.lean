variable (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (m : ℕ)

omit [Fact q.Prime] in

theorem pow_nsmul_eq_zero (x : JZero p) (hx : x ∈ eisensteinPrimaryTorsionBar p q m) :
    (q ^ m) • x = 0 := by
  have h1 : ((q : ℤ) ^ m) • x = 0 := hx.1
  rw [← natCast_zsmul, Nat.cast_pow]
  exact h1

omit [Fact q.Prime] in

theorem le_torsion :
    eisensteinPrimaryTorsionBar p q m
      ≤ Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar p) (q ^ m) := by
  intro x hx
  rw [Pic0.mem_torsion]
  have h1 : ((q : ℤ) ^ m) • x = 0 := hx.1
  rw [Nat.cast_pow]
  exact h1

theorem finite_eisensteinPrimaryTorsionBar : Finite ↥(eisensteinPrimaryTorsionBar p q m) := by
  have hfin : Finite ↥(Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar p) (q ^ m)) := by
    have h := ModularCurve.jZeroTorsionFinite p (q ^ m) (pow_pos (Fact.out : q.Prime).pos m)
    unfold ModularCurve.JZeroTorsionFinite at h
    exact h
  exact Finite.of_injective (AddSubgroup.inclusion (le_torsion p q m))
    (AddSubgroup.inclusion_injective (le_torsion p q m))

theorem exists_natCard_eq_pow :
    ∃ n : ℕ, Nat.card ↥(eisensteinPrimaryTorsionBar p q m) = q ^ n := by
  haveI := finite_eisensteinPrimaryTorsionBar p q m
  haveI : Finite (Multiplicative ↥(eisensteinPrimaryTorsionBar p q m)) :=
    Finite.of_equiv _ Multiplicative.ofAdd
  have hpg : IsPGroup q (Multiplicative ↥(eisensteinPrimaryTorsionBar p q m)) := by
    intro g
    refine ⟨m, ?_⟩
    apply Multiplicative.toAdd.injective
    rw [toAdd_pow, toAdd_one]
    apply Subtype.ext
    push_cast
    exact pow_nsmul_eq_zero p q m _ (Multiplicative.toAdd g).2
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hpg
  exact ⟨n, hn⟩

end EisensteinPrimaryTorsionBarCard
end ModularCurve

