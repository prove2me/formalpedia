    linarith
  have hcardeq : Nat.card {v : AlgebraicCurve.Place Ω₀ ↥(ModularCurve.x1FunctionFieldC Ω₀ M) //
          (jbar : ↥(ModularCurve.x1FunctionFieldC Ω₀ M)) ∈ v.toValuationSubring ∧
            v.evalAt jbar ∈ ModularCurve.ssJSet p Ω₀} =
      Nat.card {z : ↥Xb // ¬ IsRegularLocalRing (Xb.presheaf.stalk z)} := by
    have := hSN; omega
