/-- The compact-open topology on continuous maps into a real or complex polynormable space
is generated by continuous seminorms. -/
theorem polynormableSpace_continuousMap (𝕜 X E : Type*) [RCLike 𝕜] [TopologicalSpace X]
    [AddCommGroup E] [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    [ContinuousSMul 𝕜 E] [PolynormableSpace 𝕜 E] : PolynormableSpace 𝕜 C(X, E) := by
  let : Module ℝ E := Module.restrictScalars ℝ 𝕜 E
  let : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let : ContinuousSMul ℝ E := IsScalarTower.continuousSMul 𝕜
  let : LocallyConvexSpace ℝ E := (PolynormableSpace.withSeminorms 𝕜 E).toLocallyConvexSpace
  let : LocallyConvexSpace 𝕜 E := LocallyConvexSpace.ofBasisZero 𝕜 E id _
    (LocallyConvexSpace.convex_basis_zero ℝ E)
    (fun _ h ↦ convex_RCLike_iff_convex_real.mpr h.2)
  infer_instance

/-- A closed set of continuous maps is complete for compact convergence if the closure
of its image under evaluation at each point is complete. -/
theorem isComplete_continuousMap_of_isComplete_eval
    {X E : Type*} [TopologicalSpace X] [CompactlyCoherentSpace X] [UniformSpace E]
    {s : Set C(X, E)} (hs : IsClosed s)
    (heval : ∀ x : X, IsComplete (closure ((fun f : C(X, E) ↦ f x) '' s))) :
    IsComplete s := by
  let j : C(E, Completion E) := ⟨(↑), Completion.continuous_coe E⟩
  have hj : IsUniformInducing j := Completion.isUniformInducing_coe E
  let J : C(X, E) → C(X, Completion E) := j.comp
  have hJ : IsUniformInducing J := ContinuousMap.isUniformInducing_comp j hj
  apply hJ.isComplete_iff.mp
  apply IsClosed.isComplete
  rw [← closure_subset_iff_isClosed]
  intro f hf
  have lifts (x : X) : ∃ y : E, j y = f x := by
    let A := closure ((fun g : C(X, E) ↦ g x) '' s)
    have hA : IsClosed (j '' A) := (hj.isComplete_iff.mpr (heval x)).isClosed
    have hx : f x ∈ j '' A := by
      apply closure_minimal (t := (fun g : C(X, Completion E) ↦ g x) ⁻¹' (j '' A))
        _ (hA.preimage (continuous_eval_const x)) hf
      rintro _ ⟨g, hg, rfl⟩
      exact ⟨g x, subset_closure ⟨g, hg, rfl⟩, rfl⟩
    obtain ⟨y, _, hy⟩ := hx
    exact ⟨y, hy⟩
  choose g hg using lifts
  let G : C(X, E) := ⟨g, hj.isInducing.continuous_iff.mpr (by
    convert f.continuous using 1
    exact funext hg)⟩
  have hG : J G = f := ContinuousMap.ext hg
  refine ⟨G, ?_, hG⟩
  rw [← hs.closure_eq, hJ.isInducing.closure_eq_preimage_closure_image]
  change J G ∈ closure (J '' s)
  rwa [hG]

end Sol_VectorValuedHolomorphy_quasiCompleteSpace_compactlySupported

open VectorValuedHolomorphy Sol_VectorValuedHolomorphy_quasiCompleteSpace_compactlySupported in
theorem solution (𝕜 : Type*) [RCLike 𝕜] (X : Type*)
    [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [ParacompactSpace X] (E : Type*)
    [AddCommGroup E] [Module 𝕜 E] [UniformSpace E] [IsUniformAddGroup E]
    [ContinuousSMul 𝕜 E] [PolynormableSpace 𝕜 E] [T2Space E] [QuasiCompleteSpace 𝕜 E] :
    @QuasiCompleteSpace 𝕜 C_c(X, E) _ (compactlySupportedUniformSpace 𝕜 X E) _ _ := by
  -- facts about the inductive limit topology (Lemma C.5.1.3(1)) and bounded sets (C.5.1.3(4))
  have hind := (compactlySupportedTopology_t2_induced_isClosed 𝕜 X E).2
  letI 𝒰 : UniformSpace C_c(X, E) := compactlySupportedUniformSpace 𝕜 X E
  have hW : WithSeminorms (compactlySupportedSeminormFamily 𝕜 X E) := ⟨rfl⟩
  haveI : IsUniformAddGroup C_c(X, E) :=
    (compactlySupportedSeminormFamily 𝕜 X E).moduleFilterBasis.toAddGroupFilterBasis.isUniformAddGroup
  haveI : PolynormableSpace 𝕜 C(X, E) := polynormableSpace_continuousMap 𝕜 X E
  haveI : IsUniformAddGroup C(X, E) := by
    let φ : C(X, E) →+ UniformOnFun X E {K | IsCompact K} :=
      { toFun := ContinuousMap.toUniformOnFunIsCompact
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    exact IsUniformInducing.isUniformAddGroup φ
      ContinuousMap.isUniformEmbedding_toUniformOnFunIsCompact.isUniformInducing
  -- the linear inclusion `C_c(X, E) → C(X, E)` is continuous
  let ι : C_c(X, E) →ₗ[𝕜] C(X, E) :=
    { toFun := fun f => (f : C(X, E))
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hι : Continuous ι := by
    refine (PolynormableSpace.withSeminorms 𝕜 C(X, E)).continuous_of_continuous_comp ι ?_
    intro p
    refine hW.continuous_seminorm ⟨p.1.comp ι, ?_⟩
    intro K _
    letI : TopologicalSpace {f : C_c(X, E) // tsupport f ⊆ K} :=
      TopologicalSpace.induced (fun f : {f : C_c(X, E) // tsupport f ⊆ K} => (f.1 : C(X, E)))
        ContinuousMap.compactOpen
    exact p.2.comp continuous_induced_dom
  let ιL : C_c(X, E) →L[𝕜] C(X, E) := ⟨ι, hι⟩
  have hιu : UniformContinuous ι :=
    uniformContinuous_addMonoidHom_of_continuous (f := ι.toAddMonoidHom) hι
  refine ⟨fun s hb hs => ?_⟩
  obtain ⟨K, hK, hsK⟩ := exists_isCompact_tsupport_subset_of_isVonNBounded 𝕜 X E s hb
  -- the closure of the image of `s` in `C(X, E)` is closed and bounded, hence complete
  have hTb : Bornology.IsVonNBounded 𝕜 (closure (ι '' s)) := (hb.image ιL).closure
  have hTc : IsComplete (closure (ι '' s)) :=
    isComplete_continuousMap_of_isComplete_eval isClosed_closure fun x =>
      QuasiCompleteSpace.quasiComplete ((hTb.image (ContinuousMap.evalCLM 𝕜 x)).closure)
        isClosed_closure
  intro F hF hFs
  obtain ⟨g, hgT, hg⟩ := hTc (map ι F) (hF.map hιu)
    ((map_mono hFs).trans (by rw [map_principal]; exact principal_mono.mpr subset_closure))
  -- the limit `g` vanishes outside `K`, so it is compactly supported
  have hKc : IsClosed K := hK.isClosed
  have hZ : IsClosed {u : C(X, E) | ∀ x ∈ Kᶜ, u x = 0} := by
    simp only [Set.ofPred_forall]
    exact isClosed_biInter fun x _ => isClosed_eq (continuous_eval_const x) continuous_const
  have hsub : ι '' s ⊆ {u : C(X, E) | ∀ x ∈ Kᶜ, u x = 0} := by
    rintro _ ⟨f, hf, rfl⟩ x hx
    exact image_eq_zero_of_notMem_tsupport (fun h => hx (hsK f hf h))
  have hg0 : ∀ x ∉ K, g x = 0 := fun x hx => closure_minimal hsub hZ hgT x hx
  have hgc : HasCompactSupport g := HasCompactSupport.intro hK hg0
  let g' : C_c(X, E) := ⟨g, hgc⟩
  have hg'K : tsupport g' ⊆ K :=
    closure_minimal (Function.support_subset_iff'.mpr hg0) hKc
  -- `F` converges to `g'` in the inductive limit topology, by Lemma C.5.1.3(1)
  have hSmem : {f : C_c(X, E) | tsupport f ⊆ K} ∈ F :=
    mem_of_superset (le_principal_iff.mp hFs) hsK
  let G : Filter {f : C_c(X, E) // tsupport f ⊆ K} := comap Subtype.val F
  have hGF : map Subtype.val G = F := by
    rw [map_comap_of_mem]
    rw [Subtype.range_coe_subtype]
    exact hSmem
  have h1 : Tendsto (fun f : {f : C_c(X, E) // tsupport f ⊆ K} => (f.1 : C(X, E))) G
      (𝓝 (g' : C(X, E))) := by
    change Tendsto (ι ∘ Subtype.val) G (𝓝 g)
    rw [Tendsto, ← map_map, hGF]
    exact hg
  have h2 : Tendsto id G (@nhds {f : C_c(X, E) // tsupport f ⊆ K}
      (TopologicalSpace.induced (fun f : {f : C_c(X, E) // tsupport f ⊆ K} => (f.1 : C(X, E)))
        ContinuousMap.compactOpen) ⟨g', hg'K⟩) := by
    rw [@nhds_induced]
    exact tendsto_comap_iff.mpr h1
  rw [← (hind K hK).1, @nhds_induced] at h2
  have h3 : F ≤ 𝓝 g' := by
    rw [← hGF]
    exact tendsto_comap_iff.mp h2
  haveI : F.NeBot := hF.1
  exact ⟨g', hs.mem_of_tendsto h3 (Filter.mem_of_superset (le_principal_iff.mp hFs)
    fun _ h => h), h3⟩
