theorem cover_scalars_sourceProof {μ : ℕ→ℤ} {cover h J : ℕ} (HC : LightCoverKeyData.Stored μ cover h J) :
    μ (cover+3)=(groupSize h : ℤ) ∧ μ (cover+6)=(localPrime h : ℤ) ∧
      μ (cover+7)=(localBucketCap h : ℤ) := by
  refine ⟨?_,?_,?_⟩
  · simpa [LightLocalCoverInit.values,LightLocalParameters.values,
      LightLocalCounts.values,LightLocalCoverMetadata.values]
      using HC.header.getD (i := 3) (by simp [LightLocalCoverInit.values,
        LightLocalParameters.values,LightLocalCounts.values,LightLocalCoverMetadata.values]) 0
  · simpa [LightLocalCoverInit.values,LightLocalParameters.values,
      LightLocalCounts.values,LightLocalCoverMetadata.values]
      using HC.header.getD (i := 6) (by simp [LightLocalCoverInit.values,
        LightLocalParameters.values,LightLocalCounts.values,LightLocalCoverMetadata.values]) 0
  · simpa [LightLocalCoverInit.values,LightLocalParameters.values,
      LightLocalCounts.values,LightLocalCoverMetadata.values]
      using HC.header.getD (i := 7) (by simp [LightLocalCoverInit.values,
        LightLocalParameters.values,LightLocalCounts.values,LightLocalCoverMetadata.values]) 0

end ThreeSum.ReportingHostWantedRecordData

end


theorem solution : ∀ {μ : Nat → Int} {cover h J : Nat},
  ThreeSum.LightCoverKeyData.Stored μ cover h J →
    And
      (@Eq.{1} Int
        (μ
          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) cover
            (@OfNat.ofNat.{0} Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))))
        (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LocalCoverBounds.groupSize h)))
      (And
        (@Eq.{1} Int
          (μ
            (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) cover
              (@OfNat.ofNat.{0} Nat (nat_lit 6) (instOfNatNat (nat_lit 6)))))
          (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LocalCoverBounds.localPrime h)))
        (@Eq.{1} Int
          (μ
            (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) cover
              (@OfNat.ofNat.{0} Nat (nat_lit 7) (instOfNatNat (nat_lit 7)))))
          (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LocalCoverBounds.localBucketCap h)))) := by
  exact @ThreeSum.ReportingHostWantedRecordData.cover_scalars_sourceProof

