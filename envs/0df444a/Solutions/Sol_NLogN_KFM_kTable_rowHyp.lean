theorem IState.ext' {s t : IState S} (hG : ∀ x, s.G x = t.G x) (hip : s.ip = t.ip)
    (hout : s.out = t.out) : s = t := by
  cases s; cases t; simp only [IState.mk.injEq]; exact ⟨funext hG, hip, hout⟩

