open J6Sieve
open Finset

theorem J6Sieve.greedy (d X H : ℕ) (A : ℕ → ℕ) (hA : ∀ i < d, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∀ k ≤ d, ∃ s : ℕ → ℕ, (∀ i < k, rough (zz d X) (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      ∀ i < k, ∀ j < k, i ≠ j → Nat.Coprime (s i) (s j) := by sorry
