section
-- Source module: Solutions.J6SegILPre22
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 22: the new block header and one block

* `hdrP2 K Cs` pushes `blkHdr2 n b = [n, 2n, clog₂(2n), 2nb]` (reading order, i.e. `K` gains its
  reverse) for `n` on `2`, `b` on `28`. `clog₂(2n)` is computed by `λ` rounds (counter `Cs`) of
  `if p < 2n then (p := 2p; j := j + 1)` with `j` on `3`, `p` on `4`. Everything is at width `BW A`
  (needs `4λ ≤ 2^A`, since `p = 2^j < 4n`).
* `blkB2 K Cs` is `blkB K Cs` with `hdrP2` in place of `hdrP`; `blk2_sp` needs no `M`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## The header -/

def pE : Ex HS := .add (.reg 4) (.neg (.add (.reg 2) (.reg 2)))
def hdB : RS :=
  .ite pE (.seq (.asg 4 (.add (.reg 4) (.reg 4))) (.asg 3 (.add (.reg 3) (.lit 1)))) .skip
def nbE : Ex HS := .mul (.add (.reg 2) (.reg 2)) (.reg 28)

def hdrP2 (K Cs : Fin HS) : RS :=
  .seq (.push K (.reg 2)) (.seq (.push K (.add (.reg 2) (.reg 2))) (.seq (.asg 3 (.lit 0))
    (.seq (.asg 4 (.lit 1)) (.seq (.rep Cs (.reg 24) hdB) (.seq (.push K (.reg 3)) (.push K nbE))))))

def cHdB (A : ℕ) : ℕ :=
  cE pE (BW A) + (2 * BW A + 2) + 25 +
    (cE (.add (.reg 4) (.reg 4)) (BW A) + cE (.add (.reg 3) (.lit 1)) (BW A) + 1)

def cHdr2 (A lam : ℕ) : ℕ :=
  cE (.reg 2) (BW A) + (cE (.add (.reg 2) (.reg 2)) (BW A) + (cE (.lit 0) (BW A) +
    (cE (.lit 1) (BW A) + ((((Ex.reg (S := HS) 24).size + 1) * 2000 * (BW A + 2) +
      lam * (cHdB A + 8000 * (BW A + 2) + 30) + 32) + (cE (.reg 3) (BW A) + cE nbE (BW A))))))

/-- The header registers after `k` rounds. -/
def hS (v : Fin HS → ℤ) (J k : ℕ) : Fin HS → ℤ :=
  Function.update (Function.update v 3 ((min k J : ℕ) : ℤ)) 4 ((2 : ℤ) ^ min k J)

/-! ## One block -/

def blkB2 (K Cs : Fin HS) : RS :=
  .seq (scan Cs) (.seq (hdrP2 K Cs) (.seq (amP K) (.seq (apP K) (.seq (.asg 7 e7) (.seq (.asg 8 e8)
    (.seq (.asg 1 e1) clr))))))

def cBlk2 (A lam : ℕ) : ℕ :=
  cScan A lam + (cHdr2 A lam + (cStA A lam jME + (cStA A lam jPE + (cE e7 (BW A) + (cE e8 (BW A) +
    (cE e1 (BW A) + cClr A))))))

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre23
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 23: the block loop and chunk part A

`blkL2`, `partA2` are `blkL`, `partA` with `blkB2`; the descriptors are `dsEnc2 b`, all at width
`BW A` (no `BH`/`BD`, no `M`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

def blkL2 (K Cs Cb : Fin HS) : RS := .rep Cb (.reg 24) (.ite tE (blkB2 K Cs) .skip)

def cRnd2 (A lam : ℕ) : ℕ := cE tE (BW A) + (2 * BW A + 2) + 25 + (cBlk2 A lam + 1)

def cBL2 (A lam : ℕ) : ℕ :=
  ((Ex.reg (S := HS) 24).size + 1) * 2000 * (BW A + 2) + lam * (cRnd2 A lam + 8000 * (BW A + 2) + 30) + 32

/-! ## Lengths and bounds of the new descriptors -/

def partA2 (O : Fin HS) : RS :=
  .seq (.asg 1 (.mul (.reg 6) (.reg 24))) (.seq (.asg 7 (.lit 0)) (.seq (.asg 8 (.lit 0))
    (.seq (blkL2 13 53 54) (NLogN.mvK 13 O 50 lenE))))

def cPA2 (A lam : ℕ) : ℕ :=
  cE (.mul (.reg 6) (.reg 24)) (BW A) + (cE (.lit 0) (BW A) + (cE (.lit 0) (BW A) + (cBL2 A lam +
    ((lenE.size + 1) * 2000 * (BW A + 2) + 6 * lam * (14000 * (BW A + 2)) + 32))))

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre24
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 24: one chunk

`chB2 O L = partA2 O; partB O; partC O L`. From `CS u q` it pushes `|tab q| :: tab q` with
`tab q = tabK2 P pk b λ di gi gam dd (descsOf … q)` onto `O` and adds `1 + |tab q|` on `L`.
Part C is the old program, re-costed with `2^pk`, `2^b` at width `M + 2` (`pk, b ≤ M`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- Width of the `2^pk`, `2^b` pushes. -/
def BP (M : ℕ) : ℕ := M + 2

def cPC2 (A M : ℕ) : ℕ :=
  cE x8E (BW A) + cE (.pow2 (.reg 28)) (BP M) + cE (.pow2 (.reg 26)) (BP M) + cE lnE (BW A) +
  cE (.reg 7) (BW A) + cE (.reg 10) (BW A) + cE (.reg 9) (BW A) + cE (.reg 24) (BW A) +
  cE lnE (BW A) + ((accE 42).size + 1) * 2000 * (BW A + 2) +
  cE (.add (.reg 6) (.lit (-1))) (BW A) + 3 * cE (.lit 0) (BW A)

def chB2 (O L : Fin HS) : RS := .seq (partA2 O) (.seq (partB O) (partC O L))

def cCh2 (P R A lam M : ℕ) : ℕ := cPA2 A lam + (cPB P R A lam + cPC2 A M)

/-- The table of chunk `q` (new layout). -/
abbrev tabQ2 (P R sN tN lam aN pk b q : ℕ) : List ℤ :=
  J6Seg.KR.tabK2 P pk b lam (diL P R sN tN lam aN) (giL P R sN tN lam aN) (gamL P R sN tN lam aN)
    (ddL P R sN tN lam aN) (J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q)

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre25
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 25: **the chunk store** `chunkStore2_sp`

`chunkStoreP2 O L = preP L; nc rounds (counter 51) of chB2 O L; 6 := 0` builds
`tabsT (tabQ2 …) nc` on `O` and its length on `L`. Compared with `chunkStore_sp` (old `tabK`):
no `1 ≤ b`, no `λ ≤ M`, no `BH M` width (only `pk, b ≤ M` for the `2^pk`, `2^b` header pushes).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

def chunkStoreP2 (O L : Fin HS) : RS :=
  .seq (preP L) (.seq (.rep 51 (.reg 29) (chB2 O L)) (.asg 6 (.lit 0)))

def cCS2 (P R A lam M nc : ℕ) : ℕ :=
  (((Ex.lit (S := HS) 0).size + 1) * 2000 * (BW A + 2) + (cClr A + (cE (.lit 0) (BW A) +
    (cE (.lit 0) (BW A) + (cE (.lit 0) (BW A) + cE (.add (.reg 29) (.lit (-1))) (BW A)))))) +
  ((((Ex.reg (S := HS) 29).size + 1) * 2000 * (BW A + 2) +
    nc * (cCh2 P R A lam M + 8000 * (BW A + 2) + 30) + 32) + cE (.lit 0) (BW A))

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre27
/-!
# B-line IL, pre-tables (B5′), part 27: a polynomial bound for `cCS2`

`cCS2_le`: `cCS2 P R A λ M nc ≤ 10^63 · (nc + 1) · (λ + 1)^2 · Y^10` with `Y = A + P + R + M + 30`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxRecDepth 100000

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

section
variable {P R A M : ℕ}

/-- The unit. -/
def cUu (P R A M : ℕ) : ℕ := 10 ^ 60 * (A + P + R + M + 30) ^ 10

end

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre28
/-!
# B-line IL, pre-tables (B5′), part 28: **the chunk store is within the per-axis budget**

`chunkStore_cost_ev`: for widths `A ≤ aA·Q + aC`, `M ≤ mA·Q + mC` (`Q = Q6 p d s`), eventually
`cCS2 Q R A λ M nc ≤ cU6 P n A' / (D + 1)` on every axis (`Cp = 1`, any `A'`).

The ℕ core: `cCS2 ≤ K b⁴ t p¹⁰` (`cCS2_le`, `λ ≤ 4b²`, `nc λ ≤ t`), `d ≤ b`, and
`K b⁵ p⁹ t ≤ T` because `t² ≤ 2T` (`ℓ ≤ (L+1)/2` for `d ≥ 2`) and `2 (K b⁵ p⁹)² ≤ T`
(`T b' ≥ 4n > 2^(b+1)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.PreT

open IntMul NLogN IntMul.Kappa.R6 J6Seg J6Seg.Side

/-- The constant of the width bounds. -/
def cK (aA aC mA mC : ℕ) : ℕ := 35 * 10 ^ 63 * (3 * aA + 3 * mA + aC + mC + 34) ^ 10

end J6Seg.PreT
end

end

section
-- Source module: Solutions.J6AIL19
/-!
# A lines, IL side 19: the numerical context of `AStepNeed6`

**`numCtx P hP K`**: for large `n`, on every axis `k`, with `W = L + 2p + 10`: the geometry of
`axA_geom`, `pre · (t · post) = T`, `64 T < 2^W`, the descriptor entries below `2^W`,
`sWidth p α + 4 ≤ W`, `W + 4 ≤ 3p`, `p + 1 ≤ t`, `K t p⁶ ≤ T` and `T p ≤ cU6 P n A / (D + 1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6A.NC

open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- The facts of one axis. -/
structure Ctx (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k K : ℕ) : Prop where
  H1 : 1 ≤ HA6 P n
  M0 : 0 < tF6 P n k / (16 * HA6 P n)
  tM : tF6 P n k = tF6 P n k / (16 * HA6 P n) * 8 * (2 * HA6 P n)
  Ws : J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ src k
  st : src k ≤ tF6 P n k
  sep : 2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) * tF6 P n k ≤ 16 * HA6 P n * src k
  Ww : 2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ 8 * HA6 P n
  pre0 : 0 < preT P n D k
  post0 : 0 < postT P n D k
  T_eq : preT P n D k * (tF6 P n k * postT P n D k) = TP6 P n
  T64 : 64 * TP6 P n < 2 ^ (LP6 P n + 2 * pP6 P n + 10)
  dL : ∀ x ∈ J6A.PA.dL k (preT P n D k) (postT P n D k) (src k) (tF6 P n k) (pP6 P n) (αN6 P n)
    (dP6 P n), |x| < 2 ^ (LP6 P n + 2 * pP6 P n + 10)
  p1 : 1 ≤ pP6 P n
  α1 : 1 ≤ αN6 P n
  mW : IntMul.HvdH.sWidth (pP6 P n) (αN6 P n) + 4 ≤ LP6 P n + 2 * pP6 P n + 10
  W3p : LP6 P n + 2 * pP6 P n + 10 + 4 ≤ 3 * pP6 P n
  pt : pP6 P n + 1 ≤ tF6 P n k
  tT : tF6 P n k ≤ TP6 P n
  pT : pP6 P n ≤ TP6 P n
  Kt : K * tF6 P n k * pP6 P n ^ 6 ≤ TP6 P n
  U : ∀ A : ℕ, ((TP6 P n * pP6 P n : ℕ) : ℝ) ≤ cU6 P n A / (D + 1)

end J6A.NC
end

end

section
-- Source module: Solutions.J6AIL21
/-!
# A lines, IL side 21: the leaf costs against `t · p⁶` and `T · p`

With `W + 4 ≤ 3p`, `p + 1 ≤ t`, `m + 4 ≤ W` (`m = sWidth p α`), every set-up / tear-down cost
(plus the call) is at most `KQ · t · p⁶` (`fineC`, `gathC`, `compC`), and the copy step at most
`10^16 · T · p` (`dupC`, `p ≤ T`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6A.BD

open IntMul NLogN NLogN.KIL Function RS J6Seg.PJ J6A.PA

attribute [local irreducible] Kc Kf

/-- The constant of the set-ups. -/
@[irreducible] def KQ : ℕ := 10 ^ 20 * (Kc + 1)

end J6A.BD

end

section
-- Source module: Solutions.J6AIL22
/-!
# A lines, IL side 22: **`AStepNeed6`**

The family `aU dA dF` (13 procedures): the copy step `dupP dA`; four fine set-up / tear-down pairs
`fsUp dA ea ey fl dF / fsDn dF`; the gather and compress slab pairs `slUp (gP1 dA) 7 12 / slDn`,
`slUp (cP1 dA) 7 4 / slDn`. With `W = L + 2p + 10` every cost is at most `10^16 · T · p ≤
10^16 · cU6 P n 0 / (D + 1)` (`J6A.NC.numCtx`, `J6A.BD.fineC/gathC/compC/dupC`).

**`aStepNeed6_all : ∀ P, P.Ok → AStepNeed6 P`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6A.AS

open IntMul NLogN NLogN.KIL NLogN.KFB Function RS J6Seg.PJ J6A.PA IntMul.Kappa.R6 IntMul.HvdH
open J6Seg.Ax (SetupS PassOK ρS slabV sZ Fam)

/-- `pre · (t · post)`. -/
def eY2 : Ex HS := .mul (.reg 1) (.mul (.reg 4) (.reg 2))
/-- `t · post`. -/
def eY3 : Ex HS := .mul (.reg 4) (.reg 2)
/-- `M · 8H · post`. -/
def eY5 : Ex HS := .mul (.mul (.reg 10) (.reg 11)) (.reg 2)
/-- `pre · M`. -/
def eA6 : Ex HS := .mul (.reg 1) (.reg 10)
/-- `8H · post`. -/
def eY6 : Ex HS := .mul (.reg 11) (.reg 2)

/-- **The family.** -/
def aU (dA dF : Fin HS) : Fam 13 := fun E _ i =>
  (![(J6A.DP.dupP dA).code,
    J6A.FS.fsUp dA (.lit 1) eY2 5 dF, J6A.FS.fsDn dF,
    J6A.FS.fsUp dA (.reg 1) eY3 5 dF, J6A.FS.fsDn dF,
    J6A.SL.slUp (J6A.SL.gP1 dA) 7 12, J6A.SL.slDn.code,
    J6A.FS.fsUp dA (.reg 1) eY5 3 dF, J6A.FS.fsDn dF,
    J6A.FS.fsUp dA eA6 eY6 3 dF, J6A.FS.fsDn dF,
    J6A.SL.slUp (J6A.SL.cP1 dA) 7 4, J6A.SL.slDn.code] : Fin 13 → IStmt HS (7 + E)) i

end J6A.AS

end

end


