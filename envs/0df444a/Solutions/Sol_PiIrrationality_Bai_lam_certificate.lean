  have e1 : (Dd : ℝ) ^ 12 = Dd ^ j * Dd ^ (12 - j) := by rw [← pow_add]; congr 1; omega
  have e2 : z ^ 13 = z ^ (12 - j) * z ^ (j + 1) := by rw [← pow_add]; congr 1; omega
  push_cast
  rw [e1, e2, div_pow, mul_pow]
  field_simp
  ring

lemma cert_ineq (m : ℝ) (hm : 5 ≤ m) :
    (Dd : ℝ) ^ 12 * (2 * m + 1) ^ 13 * (pEval fhat m * (m + 1) ^ 18 - pEval fhat (m + 1) * m ^ 18) ≤
      Qc * pEval ghat (2 * m + 1) * (m ^ 18 * (m + 1) ^ 18) := by
  have h := pEval_nonneg certPoly cert_ok (m - 5) (by linarith)
  simp only [certPoly, pEval_add, pEval_smul, pEval_mul, pEval_pow, pEval_horner, pEval_cons,
    pEval_nil] at h
  have e1 : ((11 : ℤ) : ℝ) + (m - 5) * (((2 : ℤ) : ℝ) + (m - 5) * 0) = 2 * m + 1 := by push_cast; ring
  have e2 : ((5 : ℤ) : ℝ) + (m - 5) * (((1 : ℤ) : ℝ) + (m - 5) * 0) = m := by push_cast; ring
  have e3 : ((6 : ℤ) : ℝ) + (m - 5) * (((1 : ℤ) : ℝ) + (m - 5) * 0) = m + 1 := by push_cast; ring
  rw [e1, e2, e3] at h
  push_cast at h
  linarith

lemma tail_step (m : ℕ) (hm : 5 ≤ m) : Ftel m - Ftel (m + 1) ≤ rowSum m := by
  have hm' : (5 : ℝ) ≤ m := by exact_mod_cast hm
  have hD : (0 : ℝ) < Dd := by rw [Dd_eq]; norm_num
  set M : ℝ := (m : ℝ) + 1 / 2 with hMdef
  have hM : 0 < M := by positivity
  -- 1. rewrite the row terms
  have hterm : ∀ t ∈ rows, term m t = 1 / (M + ((2 : ℝ) * t.1 - Dd) / (2 * Dd)) -
      1 / (M + ((2 : ℝ) * t.2.1 - Dd) / (2 * Dd)) := by
    intro t ht
    have hA : (0 : ℝ) < t.1 := by exact_mod_cast row_A_pos t ht
    have hB : (0 : ℝ) < t.2.1 := by exact_mod_cast (lt_trans (row_A_pos t ht) (row_facts t ht).1)
    have e1 : M + ((2 : ℝ) * t.1 - Dd) / (2 * Dd) = ((m : ℝ) * Dd + t.1) / Dd := by
      rw [hMdef]; field_simp; ring
    have e2 : M + ((2 : ℝ) * t.2.1 - Dd) / (2 * Dd) = ((m : ℝ) * Dd + t.2.1) / Dd := by
      rw [hMdef]; field_simp; ring
    rw [e1, e2, one_div_div, one_div_div, term]
  have hrow : rowSum m = (rows.map fun t => 1 / (M + ((2 : ℝ) * t.1 - Dd) / (2 * Dd)) -
      1 / (M + ((2 : ℝ) * t.2.1 - Dd) / (2 * Dd))).sum := by
    rw [rowSum]; congr 1; exact List.map_congr_left hterm
  -- 2. the expansion
  have hexp := list_expand rows (fun t => ((2 : ℝ) * t.1 - Dd) / (2 * Dd))
    (fun t => ((2 : ℝ) * t.2.1 - Dd) / (2 * Dd)) M hM
    (by
      intro t _
      have hA : (0 : ℝ) ≤ t.1 := Nat.cast_nonneg _
      have : -(1 / 2 : ℝ) ≤ ((2 : ℝ) * t.1 - Dd) / (2 * Dd) := by
        rw [le_div_iff₀ (by positivity)]; linarith
      have : (1 / 2 : ℝ) < M := by rw [hMdef]; linarith
      linarith)
    (by
      intro t ht
      have : (t.1 : ℝ) ≤ t.2.1 := by exact_mod_cast (row_facts t ht).1.le
      apply div_le_div_of_nonneg_right _ (by positivity)
      linarith)
  -- 3. power sums
  have hps : ∑ j ∈ range 13, (rows.map fun t => (-(((2 : ℝ) * t.1 - Dd) / (2 * Dd))) ^ j -
      (-(((2 : ℝ) * t.2.1 - Dd) / (2 * Dd))) ^ j).sum / M ^ (j + 1) =
      ∑ j ∈ range 13, (Pc j : ℝ) / (2 * Dd) ^ j / M ^ (j + 1) := by
    apply Finset.sum_congr rfl
    intro j hj
    rw [powsum_eq j (Finset.mem_range.1 hj)]
  -- 4. polynomial form
  have hz : (0 : ℝ) < 2 * m + 1 := by positivity
  have hG := ghat_eval (2 * m + 1) hz
  have hM2 : (2 * (m : ℝ) + 1) / 2 = M := by rw [hMdef]; ring
  rw [hM2] at hG
  -- 5. certificate
  have hc := cert_ineq m hm'
  have hm0 : (0 : ℝ) < m := by linarith
  have hQ := Qc_pos
  have hF : Ftel m - Ftel (m + 1) ≤ pEval ghat (2 * m + 1) / ((Dd : ℝ) ^ 12 * (2 * m + 1) ^ 13) := by
    rw [Ftel, Ftel, div_sub_div _ _ (by positivity) (by positivity), div_le_div_iff₀ (by positivity)
      (by positivity)]
    nlinarith [hc]
  rw [hrow]
  calc Ftel m - Ftel (m + 1) ≤ _ := hF
    _ = _ := hG
    _ = _ := hps.symm
    _ ≤ _ := hexp

lemma tail_sum (K : ℕ) (hK : 5 ≤ K) : Ftel 5 - Ftel K ≤ ∑ m ∈ Ico 5 K, rowSum m := by
  induction K, hK using Nat.le_induction with
  | base => simp
  | succ K hK ih =>
    rw [Finset.sum_Ico_succ_top hK]
    have := tail_step K hK
    push_cast at this ⊢
    linarith

lemma fhatK : pEvalZ fhat (10 ^ 16) =  := by decide +kernel

theorem lam_ge : (12025657733612916 / 10 ^ 13 : ℝ) ≤ lam (10 ^ 16) := by
  have hsplit := Finset.sum_range_add_sum_Ico rowSum (show 5 ≤ 10 ^ 16 by norm_num)
  have ht := tail_sum (10 ^ 16) (by norm_num)
  have h0 := rowSum_ge_head 0
  have h1 := rowSum_ge_head 1
  have h2 := rowSum_ge_head 2
  have h3 := rowSum_ge_head 3
  have h4 := rowSum_ge_head 4
  rw [head0] at h0; rw [head1] at h1; rw [head2] at h2; rw [head3] at h3; rw [head4] at h4
  have hF5 : Ftel 5 = (pEvalZ fhat 5 : ℝ) / (Qc * 5 ^ 18) := by
    rw [Ftel, show (5 : ℝ) = ((5 : ℤ) : ℝ) by norm_num, pEval_intCast]
  have hFK : Ftel ((10 ^ 16 : ℕ) : ℝ) = (pEvalZ fhat (10 ^ 16) : ℝ) / (Qc * ((10 : ℝ) ^ 16) ^ 18) := by
    rw [Ftel, show ((10 ^ 16 : ℕ) : ℝ) = ((10 ^ 16 : ℤ) : ℝ) by norm_num, pEval_intCast]; push_cast; ring
  rw [fhat5] at hF5
  rw [fhatK] at hFK
  rw [lam, ← hsplit, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ,
    Finset.sum_range_succ, Finset.sum_range_one]
  have hnum : (12025657733612916 / 10 ^ 13 : ℝ) ≤
      (120242845109066492188485 : ℕ) / 10 ^ 20 + (7181868997861744624 : ℕ) / 10 ^ 20 +
      (2253379956405403558 : ℕ) / 10 ^ 20 + (1099831383896855978 : ℕ) / 10 ^ 20 +
      (651469754273396059 : ℕ) / 10 ^ 20 + (Ftel 5 - Ftel ((10 ^ 16 : ℕ) : ℝ)) := by
    rw [hF5, hFK, Qc]
    norm_num
  push_cast at ht
  linarith

end PiIrrationality.BaiPhi

