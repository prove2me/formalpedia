    (hF : t.G gF = .int (f : ℤ) :: L1) (hLp : t.G rLp = .int (L' : ℤ) :: L2)
    (hA : t.G gA = .int (a : ℤ) :: L3) (hQQ : t.G sQQ = .int (N : ℤ) :: L4)
    (hB : t.G rVB = .int (b : ℤ) :: L5) (hC : t.G rVC = .int (c : ℤ) :: L6)
    (hP : t.G dP = .int (P : ℤ) :: L7)
    (R : List Item) (ys : List (ZMod 2)) (hys : ys.length = V) :
    IRuns I iprog (callR j0 m ρ) (t.upd 0 (ints (enc2 ys) ++ R))
