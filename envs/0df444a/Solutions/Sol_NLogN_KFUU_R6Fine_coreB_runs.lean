theorem stLB_zero (a f y : ℕ) (xs : List ℤ) (hlen : xs.length = vol [a, y, 2 ^ f, 2])
    (t : IState HS) (R LX LZ : List Item) (h0 : t.G 0 = ints xs ++ R)
    (hX : t.G qX = .int (a : ℤ) :: LX) (hZ : t.G qZ = .int ((2 ^ f * 2 : ℕ) : ℤ) :: LZ) :
    stLB a f y xs t R LX LZ 0 = t := by
  have e : stB a (2 ^ f) y (2 ^ 0) (2 ^ (f - 0)) xs = xs := by
    rw [Nat.sub_zero, pow_zero]; exact stB_zero a (2 ^ f) y xs hlen
  unfold stLB
  rw [e, Nat.sub_zero, pow_zero, mul_one]
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases e1 : j = qZ
  · subst e1; simp +decide [hZ]
  · by_cases e2 : j = qX
    · subst e2; simp +decide [hX]
    · by_cases e3 : j = 0
      · subst e3; simp +decide [h0]
      · simp [e1, e2, e3]

set_option maxHeartbeats 4000000 in
theorem loopB_runs (a f y w Z : ℕ) (ha : 1 ≤ a) (hy : 1 ≤ y) (hZ2 : 2 ≤ Z)
    (hVZ : zsz ((2 * (a * 2 ^ f * y) : ℕ) : ℤ) ≤ Z)
    (xs : List ℤ) (hlen : xs.length = vol [a, y, 2 ^ f, 2]) (hb : Bnd w xs)
    (t : IState HS) (R LX LZ L2 LB LN : List Item) (h0 : t.G 0 = ints xs ++ R)
    (hX : t.G qX = .int (a : ℤ) :: LX) (hZ : t.G qZ = .int ((2 ^ f * 2 : ℕ) : ℤ) :: LZ)
    (hT : t.G tq = .int ((2 ^ 1 : ℕ) : ℤ) :: L2) (hB : t.G qB = .int (y : ℤ) :: LB)
    (hN : t.G nR = .int (f : ℤ) :: LN) :
    IRuns I iprog (rptX nR lA lC lD bodyB) t (stLB a f y xs t R LX LZ f)
      ((f + 1) * (cIt w (a * 2 ^ f * y) Z + 3000)) := by
  have H := rptXU_runs (I := I) (iprog := iprog) (X := nR) (by decide) f (stLB a f y xs t R LX LZ)
    (fun k => by simp +decide [stLB]) (fun k => by simp +decide [stLB])
    (fun k => by simp +decide [stLB]) bodyB (cIt w (a * 2 ^ f * y) Z)
    (fun k hk LA LC LD => bodyB_runs a f y w Z ha hy hZ2 hVZ xs hb t R LX LZ L2 hT hB hk LA LC LD)
    LN (by simp +decide [stLB, hN])
  rwa [stLB_zero a f y xs hlen t R LX LZ h0 hX hZ] at H

/-! ## The backward core -/

set_option maxHeartbeats 16000000 in
theorem coreB_runs_sol_aux (a f y w Z : ℕ) (ha : 1 ≤ a) (hy : 1 ≤ y) (hZ2 : 2 ≤ Z)
    (hVZ : zsz ((2 * (a * 2 ^ f * y) : ℕ) : ℤ) ≤ Z)
    (xs : List ℤ) (hlen : xs.length = vol [a, y, 2 ^ f, 2]) (hb : Bnd w xs)
    (t : IState HS) (R Ld La Lf : List Item) (h0 : t.G 0 = ints xs ++ R)
    (hd : t.G dP = .int (y : ℤ) :: Ld) (hA : t.G rCZ = .int (a : ℤ) :: La)
    (hF : t.G rU = .int (f : ℤ) :: Lf) :
    IRuns I iprog coreB t (t.upd 0 (ints (stB a (2 ^ f) y (2 ^ f) 1 xs) ++ R))
      (cCore w f (a * 2 ^ f * y) Z) := by
  set V := a * 2 ^ f * y with hV
  have hV1 : 1 ≤ 2 ^ f * y := Nat.mul_pos Nat.one_le_two_pow hy
  have haV : a * 2 ^ f ≤ V := Nat.le_mul_of_pos_right _ hy
  have haV' : a ≤ a * 2 ^ f := Nat.le_mul_of_pos_right _ Nat.one_le_two_pow
  have hyV : y ≤ V := by
    have : 1 * y ≤ a * 2 ^ f * y := Nat.mul_le_mul_right _ (le_trans ha haV')
    omega
  have h2V : 2 ^ f ≤ V := by
    have : 1 * 2 ^ f * 1 ≤ a * 2 ^ f * y := Nat.mul_le_mul (Nat.mul_le_mul_right _ ha) hy
    omega
  have hfV : f ≤ V := le_trans (le_of_lt Nat.lt_two_pow_self) h2V
  have zle : ∀ x : ℕ, x ≤ 2 * V → zsz (x : ℤ) ≤ Z := fun x hx =>
    le_trans (NLogN.zsz_natCast_le hx) hVZ
  -- setup
  have r1 := IRuns.mv (I := I) (iprog := iprog) (s := t) (i := dP) (j := qB) (a := (y : ℤ)) (L := Ld)
    (by decide) hd
  set s1 := (t.upd dP Ld).upd qB (.int (y : ℤ) :: t.G qB) with hs1
  have r2 := IRuns.dup (I := I) (iprog := iprog) (s := s1) (i := rCZ) (j := qX) (a := (a : ℤ))
    (L := La) (by decide) (by simp +decide [s1, hA])
  set s2 := s1.upd qX (.int (a : ℤ) :: s1.G qX) with hs2
  have r3 := IRuns.dup (I := I) (iprog := iprog) (s := s2) (i := rU) (j := nR) (a := (f : ℤ))
    (L := Lf) (by decide) (by simp +decide [s2, s1, hF])
  set s3 := s2.upd nR (.int (f : ℤ) :: s2.G nR) with hs3
  have r4 := IRuns.const (I := I) (iprog := iprog) (s := s3) tq (2 : ℤ)
  set s4 := s3.upd tq (.int 2 :: s3.G tq) with hs4
  have r5 := IRuns.const (I := I) (iprog := iprog) (s := s4) qZ (2 : ℤ)
  set s5 := s4.upd qZ (.int 2 :: s4.G qZ) with hs5
  -- qZ := 2^f 2
  set T1 : ℕ → IState HS := fun k => s5.upd qZ (.int ((2 ^ k * 2 : ℕ) : ℤ) :: t.G qZ) with hT1
  have r6 := rptXU_runs (I := I) (iprog := iprog) (X := nR) (by decide) f T1
    (fun k => by simp +decide [T1]) (fun k => by simp +decide [T1]) (fun k => by simp +decide [T1])
    (.op (.shl qZ tq)) 400 ?_ (t.G nR) (by simp +decide [T1, s5, s4, s3, s2, s1])
  rotate_left
  · intro k hk LA LC LD
    have H1 := shlN_runs (I := I) (iprog := iprog) (i := qZ) (j := tq) (by decide)
      (cf3 (T1 k) lA lC lD LA LC LD) (a := 2 ^ k * 2) (m := 1) (Li := t.G qZ) (Lj := s3.G tq)
      (by simp +decide [cf3, T1]) (by simp +decide [cf3, T1, s5, s4])
    refine H1.mono' ?_ le_rfl
    have e : 2 ^ k * 2 * 2 ^ 1 = 2 ^ (k + 1) * 2 := by rw [pow_succ 2 k]; ring
    simp only [cf3, T1, e]
    ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
  have e0 : T1 0 = s5 := by
    simp only [T1, pow_zero, one_mul]
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases e1 : j = qZ
    · subst e1; simp +decide [s5, s4, s3, s2, s1]
    · simp [e1]
  rw [e0] at r6
  set s6 := T1 f with hs6
  -- the loop
  have r7 := loopB_runs (I := I) (iprog := iprog) a f y w Z ha hy hZ2 hVZ xs hlen hb s6 R (t.G qX)
    (t.G qZ) (t.G tq) (t.G qB) (t.G nR)
    (by simp +decide [s6, T1, s5, s4, s3, s2, s1, h0])
    (by simp +decide [s6, T1, s5, s4, s3, s2, s1]) (by simp +decide [s6, T1])
    (by simp +decide [s6, T1, s5, s4, s3, s2, s1]) (by simp +decide [s6, T1, s5, s4, s3, s2, s1])
    (by simp +decide [s6, T1, s5, s4, s3, s2, s1])
  set s7 := stLB a f y xs s6 R (t.G qX) (t.G qZ) f with hs7
  -- clear
  have r8 := IRuns.drop (I := I) (iprog := iprog) (s := s7) (i := qZ)
    (a := ((2 ^ (f - f) * 2 : ℕ) : ℤ)) (L := t.G qZ) (by simp +decide [s7, stLB])
  have r9 := IRuns.drop (I := I) (iprog := iprog) (s := s7.upd qZ (t.G qZ)) (i := tq) (a := 2)
    (L := t.G tq) (by simp +decide [s7, stLB, s6, T1, s5, s4, s3, s2, s1])
  have r10 := IRuns.drop (I := I) (iprog := iprog) (s := (s7.upd qZ (t.G qZ)).upd tq (t.G tq))
    (i := nR) (a := (f : ℤ)) (L := t.G nR) (by simp +decide [s7, stLB, s6, T1, s5, s4, s3, s2, s1])
  have r11 := IRuns.drop (I := I) (iprog := iprog)
    (s := ((s7.upd qZ (t.G qZ)).upd tq (t.G tq)).upd nR (t.G nR))
    (i := qX) (a := ((a * 2 ^ f : ℕ) : ℤ)) (L := t.G qX) (by simp +decide [s7, stLB])
  have r12 := IRuns.mv (I := I) (iprog := iprog)
    (s := (((s7.upd qZ (t.G qZ)).upd tq (t.G tq)).upd nR (t.G nR)).upd qX (t.G qX))
    (i := qB) (j := dP) (a := (y : ℤ)) (L := t.G qB) (by decide)
    (by simp +decide [s7, stLB, s6, T1, s5, s4, s3, s2, s1])
  refine (r1.seq (r2.seq (r3.seq (r4.seq (r5.seq (r6.seq (r7.seq (r8.seq (r9.seq (r10.seq
    (r11.seq r12))))))))))).mono' ?_ ?_
  · simp only [s7, stLB, s6, T1, s5, s4, s3, s2, s1, Nat.sub_self, pow_zero]
    clear r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12
    ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte, hd]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
  · -- cost
    have c1 := mv_le_cU (zle _ (by omega : y ≤ 2 * V))
    have c2 := dup_le_cU (zle _ (by omega : a ≤ 2 * V))
    have c3 := dup_le_cU (zle _ (by omega : f ≤ 2 * V))
    have c4 := const_le_cU (Z := Z) (x := ((2 : ℕ) : ℤ)) (zle _ (by omega))
    have c8 := drop_le_cU (zle _ (by
      rw [Nat.sub_self, pow_zero]; omega : 2 ^ (f - f) * 2 ≤ 2 * V))
    have c9 := drop_le_cU (Z := Z) (x := ((2 : ℕ) : ℤ)) (zle _ (by omega))
    have c10 := drop_le_cU (zle _ (by omega : f ≤ 2 * V))
    have c11 := drop_le_cU (zle _ (by omega : a * 2 ^ f ≤ 2 * V))
    have c12 := mv_le_cU (zle _ (by omega : y ≤ 2 * V))
    push_cast at c4 c9
    unfold cCore
    clear r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12
    generalize cIt w V Z = CI
    generalize cU Z = CZ at *
    linarith

