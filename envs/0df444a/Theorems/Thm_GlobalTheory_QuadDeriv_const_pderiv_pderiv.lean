variable {k : Type} [CommRing k] {d : ℕ}

theorem GlobalTheory.QuadDeriv.const_pderiv_pderiv (g : PS k 2 d) (i j : Fin d) :
    constantCoeff (pderiv k ((0 : Fin 2), i) (pderiv k ((1 : Fin 2), j) g)) =
      coeff (Finsupp.single ((0 : Fin 2), i) 1 + Finsupp.single ((1 : Fin 2), j) 1) g := by sorry
