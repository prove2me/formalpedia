variable {L : BPTQuditLattice} {kappa : Type v} [Fintype kappa]

theorem QEC.Bounds.BPTCommutingProjectorModel.isotypicTensorLeftAction_adjoint
    {B : Type u}
    [NormedAddCommGroup B] [InnerProductSpace Complex B] [Semantics.FiniteQuantumSystem B]
    (S : StarSubalgebra Complex (Semantics.Operator B))
    (W : Submodule S B) (n : Nat) (operator : S) :
    LinearMap.adjoint (isotypicTensorLeftAction S W n operator) =
      isotypicTensorLeftAction S W n (star operator) := by sorry
