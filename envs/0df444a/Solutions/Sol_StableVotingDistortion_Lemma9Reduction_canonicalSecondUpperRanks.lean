section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds

def quickTotalScore (q : ℚ) : ℚ := quickScore (qclamp q)
def quickTotalJ (q : ℚ) : ℚ := quickJ (qclamp q)
def quickTotalScoreBox (i : Bounds) : Bounds :=
  ⟨quickTotalScore i.hi,quickTotalScore i.lo⟩
def quickTotalPrimitiveBox (i : Bounds) : Bounds :=
  unimodalRange (fun q => point (quickJ q)) lamQ (clampBox i)
def quickTotalPrimitiveSlope (i : Bounds) : Bounds :=
  (quickTotalScoreBox i).times (clampSlopeBox i)

@[simp] theorem quickTotalScore_eq (q : ℚ) : quickTotalScore q = qtScore q := quickScore_clipped _
@[simp] theorem quickTotalJ_eq (q : ℚ) : quickTotalJ q = qtJ q := quickJ_clipped _

private theorem clampBox_meet (i : Bounds) : (clampBox i).meet ⟨0,1⟩=clampBox i := by
  simp only [clampBox,meet,max_eq_left (qclamp_domain i.lo).1,min_eq_left (qclamp_domain i.hi).2]

@[simp] theorem quickTotalScoreBox_eq (i : Bounds) : quickTotalScoreBox i=totalScoreBox i := by
  rw [totalScoreBox,scoreBox,clampBox_meet]
  simp only [decreasingRange,quickTotalScoreBox,quickTotalScore,
    clampBox,point,quickScore_clipped]

@[simp] theorem quickTotalPrimitiveBox_eq (i : Bounds) : quickTotalPrimitiveBox i=totalPrimitiveBox i := by
  have hL : lamQ∈Icc (0:ℚ) 1 := by norm_num [lamQ]
  rw [totalPrimitiveBox,primitiveBox,clampBox_meet]
  unfold quickTotalPrimitiveBox unimodalRange
  by_cases a : (clampBox i).hi ≤ lamQ
  · rw [if_pos a,if_pos a]; simp only [clampBox,quickJ_clipped]
  · rw [if_neg a,if_neg a]
    by_cases b : lamQ ≤ (clampBox i).lo
    · rw [if_pos b,if_pos b]; simp only [decreasingRange,clampBox,quickJ_clipped]
    · rw [if_neg b,if_neg b]; simp only [clampBox,quickJ_clipped,quickJ_eq hL]

@[simp] theorem quickTotalPrimitiveSlope_eq (i : Bounds) :
    quickTotalPrimitiveSlope i=totalPrimitiveSlope i := by
  rw [quickTotalPrimitiveSlope,quickTotalScoreBox_eq];rfl

end StableVotingDistortion.PaperCurve
