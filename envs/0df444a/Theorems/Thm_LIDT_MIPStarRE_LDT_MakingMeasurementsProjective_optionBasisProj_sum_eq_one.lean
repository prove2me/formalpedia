lemma LIDT.MIPStarRE.LDT.MakingMeasurementsProjective.optionBasisProj_sum_eq_one {α : Type*} [Fintype α] [DecidableEq α] :
    ∑ oa : Option α, (Matrix.single oa oa (1 : ℂ) : _root_.LIDT.MIPStarRE.Quantum.Op (Option α)) = 1 := by sorry
