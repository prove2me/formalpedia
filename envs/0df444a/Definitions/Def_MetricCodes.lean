        coefficient • fibre source v) :
    BoxRaisingProjectedAxisWitness a b o fibre
      target source h row hdeg where
  gram := gram
  gram_pos := hgram_pos
  gram_inner := hgram
  coefficient := coefficient
  coefficient_sq := by
    rw [boxProbability_eq_minus_of_signature_raise
      a b target source row hrow]
    exact hcoefficient
