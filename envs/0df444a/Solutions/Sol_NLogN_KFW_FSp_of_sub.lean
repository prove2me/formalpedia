theorem Agree.top {σ : Fin HS → Option ℤ} {s : IState HS} (h : Agree σ s) {i : Fin HS} {v : ℤ}
    (hi : σ i = some v) : s.top i = v := by
  obtain ⟨L, hL⟩ := h i v hi; exact IState.top_eq hL

theorem Agree.isInt {σ : Fin HS → Option ℤ} {s : IState HS} (h : Agree σ s) {i : Fin HS} {v : ℤ}
    (hi : σ i = some v) : s.IsInt i := by
  obtain ⟨L, hL⟩ := h i v hi; exact ⟨L, by rw [hL, IState.top_eq hL]⟩

theorem Agree.congr {σ : Fin HS → Option ℤ} {s t : IState HS} (h : Agree σ s)
    (he : ∀ i, (σ i).isSome → t.G i = s.G i) : Agree σ t := by
  intro i v hi
  rw [he i (by simp [hi])]; exact h i v hi

section ExLemmas

variable (σ : Fin HS → Option ℤ) {s : IState HS}

theorem Ex.eval_sub (hs : Agree σ s) : ∀ e : Ex HS, (Ex.sub σ e).eval s = e.eval s
  | .reg i => by
    unfold Ex.sub
    rcases h : σ i with _ | v
    · rfl
    · simp only [Ex.eval]; exact (hs.top h).symm
  | .lit c => rfl
  | .add a b | .mul a b | .shl a b | .quo a b | .rem a b | .ndiv a b | .nmod a b => by
    simp only [Ex.sub, Ex.eval, Ex.eval_sub hs a, Ex.eval_sub hs b]
  | .neg a | .pow2 a => by simp only [Ex.sub, Ex.eval, Ex.eval_sub hs a]
  | .sel c x y => by simp only [Ex.sub, Ex.eval, Ex.eval_sub hs c, Ex.eval_sub hs x, Ex.eval_sub hs y]

theorem Ex.ok_sub (hs : Agree σ s) : ∀ e : Ex HS, (Ex.sub σ e).ok s → e.ok s
  | .reg i, h => by
    unfold Ex.sub at h
    rcases hσ : σ i with _ | v
    · rw [hσ] at h; exact h
    · exact hs.isInt hσ
  | .lit c, h => trivial
  | .add a b, h | .mul a b, h => ⟨Ex.ok_sub hs a h.1, Ex.ok_sub hs b h.2⟩
  | .shl a b, h | .quo a b, h | .rem a b, h => by
    obtain ⟨h1, h2, h3⟩ := h
    exact ⟨Ex.ok_sub hs a h1, Ex.ok_sub hs b h2, by rwa [Ex.eval_sub σ hs] at h3⟩
  | .ndiv a b, h | .nmod a b, h => by
    obtain ⟨h1, h2, h3, h4⟩ := h
    exact ⟨Ex.ok_sub hs a h1, Ex.ok_sub hs b h2, by rwa [Ex.eval_sub σ hs] at h3,
      by rwa [Ex.eval_sub σ hs] at h4⟩
  | .neg a, h => Ex.ok_sub hs a h
  | .pow2 a, h => ⟨Ex.ok_sub hs a h.1, by have := h.2; rwa [Ex.eval_sub σ hs] at this⟩
  | .sel c x y, h => by
    obtain ⟨h1, h2⟩ := h
    refine ⟨Ex.ok_sub hs c h1, ?_⟩
    rw [Ex.eval_sub σ hs] at h2
    split_ifs at h2 ⊢
    · exact Ex.ok_sub hs x h2
    · exact Ex.ok_sub hs y h2

theorem Ex.cost_sub (hs : Agree σ s) : ∀ e : Ex HS, e.cost s ≤ 400 * (Ex.sub σ e).cost s
  | .reg i => by
    unfold Ex.sub
    rcases h : σ i with _ | v
    · simp only [Ex.cost]; omega
    · simp only [Ex.cost, hs.top h]
      have := dupCost_le (zsz v); omega
  | .lit c => by simp only [Ex.sub, Ex.cost]; omega
  | .add a b => by
    have ha := Ex.cost_sub hs a; have hb := Ex.cost_sub hs b
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .mul a b => by
    have ha := Ex.cost_sub hs a; have hb := Ex.cost_sub hs b
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .shl a b => by
    have ha := Ex.cost_sub hs a; have hb := Ex.cost_sub hs b
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .quo a b | .rem a b => by
    have ha := Ex.cost_sub hs a; have hb := Ex.cost_sub hs b
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .ndiv a b | .nmod a b => by
    have ha := Ex.cost_sub hs a; have hb := Ex.cost_sub hs b
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .neg a => by
    have ha := Ex.cost_sub hs a
    simp only [Ex.sub, Ex.cost]; nlinarith
  | .pow2 a => by
    have ha := Ex.cost_sub hs a
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]; nlinarith
  | .sel c x y => by
    have hc := Ex.cost_sub hs c; have hx := Ex.cost_sub hs x; have hy := Ex.cost_sub hs y
    simp only [Ex.sub, Ex.cost, Ex.eval_sub σ hs]
    split_ifs <;> nlinarith

end ExLemmas

theorem Ex.regs_sub (σ : Fin HS → Option ℤ) : ∀ e : Ex HS, ∀ i ∈ e.regs,
    i ∈ (Ex.sub σ e).regs ∨ (σ i).isSome
  | .reg i, j, h => by
    simp only [Ex.regs, List.mem_singleton] at h; subst h
    unfold Ex.sub
    rcases hσ : σ j with _ | v
    · left; simp [Ex.regs]
    · right; simp
  | .lit c, j, h => by simp [Ex.regs] at h
  | .add a b, j, h | .mul a b, j, h | .shl a b, j, h | .quo a b, j, h | .rem a b, j, h
  | .ndiv a b, j, h | .nmod a b, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with h | h
    · rcases Ex.regs_sub σ a j h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases Ex.regs_sub σ b j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .neg a, j, h | .pow2 a, j, h => by
    simp only [Ex.regs] at h
    simp only [Ex.sub, Ex.regs]
    exact Ex.regs_sub σ a j h
  | .sel c x y, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with (h | h) | h
    · rcases Ex.regs_sub σ c j h with h' | h'
      · exact Or.inl (Or.inl (Or.inl h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ x j h with h' | h'
      · exact Or.inl (Or.inl (Or.inr h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ y j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'

theorem Ex.clean_sub {σ : Fin HS → Option ℤ} (hσ : SClean σ) {e : Ex HS}
    (h : (Ex.sub σ e).Clean) : e.Clean := by
  intro i hi
  rcases Ex.regs_sub σ e i hi with h' | h'
  · exact h i h'
  · exact hσ i h'

theorem RS.writes_sub (σ : Fin HS → Option ℤ) : ∀ p : RS, (RS.sub σ p).writes = p.writes
  | .skip => rfl
  | .asg i e | .push i e | .pop i => rfl
  | .seq a b | .ite _ a b => by simp [RS.sub, RS.writes, RS.writes_sub σ a, RS.writes_sub σ b]
  | .rep i n b => by simp [RS.sub, RS.writes, RS.writes_sub σ b]

theorem Agree.run {σ : Fin HS → Option ℤ} {p : RS} (hw : NoW σ p) {s : IState HS}
    (hs : Agree σ s) : Agree σ (p.run s) :=
  hs.congr fun i hi => run_G_of_not_mem p s i (fun h => by
    have := hw i h; rw [this] at hi; simp at hi)

theorem RS.run_sub (σ : Fin HS → Option ℤ) : ∀ (p : RS), NoW σ p → ∀ s, Agree σ s →
    (RS.sub σ p).run s = p.run s
  | .skip, _, s, _ => rfl
  | .asg i e, _, s, hs | .push i e, _, s, hs => by simp [RS.sub, RS.run, Ex.eval_sub σ hs]
  | .pop i, _, s, _ => rfl
  | .seq a b, hw, s, hs => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, RS.run]
    rw [RS.run_sub σ a ha s hs, RS.run_sub σ b hb _ (hs.run ha)]
  | .ite c a b, hw, s, hs => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, RS.run, Ex.eval_sub σ hs]
    rw [RS.run_sub σ a ha s hs, RS.run_sub σ b hb s hs]
  | .rep i n b, hw, s, hs => by
    have hbw : NoW σ b := fun j h => hw j (by simp [RS.writes, h])
    have hi : σ i = none := hw i (by simp [RS.writes])
    simp only [RS.sub, RS.run, Ex.eval_sub σ hs]
    suffices H : ∀ k (t : IState HS), Agree σ t →
        (fun t => decSt i ((RS.sub σ b).run t))^[k] t = (fun t => decSt i (b.run t))^[k] t ∧
        Agree σ ((fun t => decSt i (b.run t))^[k] t) by
      rw [(H _ _ _).1]
      exact hs.congr fun j hj => by
        have : j ≠ i := fun e => by subst e; rw [hi] at hj; simp at hj
        simp [IState.upd_G, this]
    intro k
    induction k with
    | zero => intro t ht; exact ⟨rfl, ht⟩
    | succ k ih =>
      intro t ht
      obtain ⟨e1, e2⟩ := ih t ht
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', e1]
      refine ⟨by rw [RS.run_sub σ b hbw _ e2], ?_⟩
      refine (e2.run hbw).congr fun j hj => ?_
      have : j ≠ i := fun e => by subst e; rw [hi] at hj; simp at hj
      simp [decSt, IState.upd_G, this]

theorem repSt_sub (σ : Fin HS → Option ℤ) {i : Fin HS} {n : Ex HS} {b : RS} (hbw : NoW σ b)
    (hi : σ i = none) {s : IState HS} (hs : Agree σ s) :
    ∀ k, repSt i (Ex.sub σ n) (RS.sub σ b) s k = repSt i n b s k ∧ Agree σ (repSt i n b s k) := by
  intro k
  induction k with
  | zero =>
    refine ⟨by simp [repSt, Ex.eval_sub σ hs], ?_⟩
    simp only [repSt, Function.iterate_zero, id]
    exact hs.congr fun j hj => by
      have : j ≠ i := fun e => by subst e; rw [hi] at hj; simp at hj
      simp [IState.upd_G, this]
  | succ k ih =>
    obtain ⟨e1, e2⟩ := ih
    have q1 : repSt i (Ex.sub σ n) (RS.sub σ b) s (k + 1) =
        decSt i ((RS.sub σ b).run (repSt i (Ex.sub σ n) (RS.sub σ b) s k)) := by
      simp only [repSt]; rw [Function.iterate_succ_apply']
    have q2 : repSt i n b s (k + 1) = decSt i (b.run (repSt i n b s k)) := by
      simp only [repSt]; rw [Function.iterate_succ_apply']
    rw [q1, q2, e1, RS.run_sub σ b hbw _ e2]
    refine ⟨rfl, (e2.run hbw).congr fun j hj => ?_⟩
    have : j ≠ i := fun e => by subst e; rw [hi] at hj; simp at hj
    simp [decSt, IState.upd_G, this]

theorem RS.ok_sub (σ : Fin HS → Option ℤ) (hσ : SClean σ) : ∀ (p : RS), NoW σ p → ∀ s,
    Agree σ s → (RS.sub σ p).ok s → p.ok s
  | .skip, _, s, _, _ => trivial
  | .asg i e, _, s, hs, ⟨h1, h2, h3, h4⟩ =>
    ⟨h1, Ex.clean_sub hσ h2, Ex.ok_sub σ hs e h3, h4⟩
  | .push i e, _, s, hs, ⟨h1, h2, h3⟩ => ⟨h1, Ex.clean_sub hσ h2, Ex.ok_sub σ hs e h3⟩
  | .pop i, _, s, _, h => h
  | .seq a b, hw, s, hs, ⟨h1, h2⟩ => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    refine ⟨RS.ok_sub σ hσ a ha s hs h1, ?_⟩
    rw [RS.run_sub σ a ha s hs] at h2
    exact RS.ok_sub σ hσ b hb _ (hs.run ha) h2
  | .ite c a b, hw, s, hs, ⟨h1, h2, h3⟩ => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    refine ⟨Ex.clean_sub hσ h1, Ex.ok_sub σ hs c h2, ?_⟩
    rw [Ex.eval_sub σ hs] at h3
    split_ifs at h3 ⊢
    · exact RS.ok_sub σ hσ a ha s hs h3
    · exact RS.ok_sub σ hσ b hb s hs h3
  | .rep i n b, hw, s, hs, ⟨h1, h2, h3, h4, h5, h6⟩ => by
    have hbw : NoW σ b := fun j h => hw j (by simp [RS.writes, h])
    have hi : σ i = none := hw i (by simp [RS.writes])
    rw [Ex.eval_sub σ hs] at h4 h6
    refine ⟨h1, Ex.clean_sub hσ h2, Ex.ok_sub σ hs n h3, h4, by rwa [RS.writes_sub] at h5,
      fun k hk => ?_⟩
    have := h6 k hk
    obtain ⟨e1, e2⟩ := repSt_sub σ hbw hi hs k
    rw [e1] at this
    exact RS.ok_sub σ hσ b hbw _ e2 this

theorem fcost_sub (σ : Fin HS → Option ℤ) : ∀ (p : RS), NoW σ p → ∀ s,
    Agree σ s → fcost p s ≤ 400 * fcost (RS.sub σ p) s
  | .skip, _, s, _ => by simp [RS.sub, fcost]
  | .asg i e, _, s, hs => by
    have := Ex.cost_sub σ hs e
    simp only [RS.sub, fcost, asgCost, Ex.eval_sub σ hs]; nlinarith
  | .push i e, _, s, hs => by
    have := Ex.cost_sub σ hs e
    simp only [RS.sub, fcost, Ex.eval_sub σ hs]; nlinarith
  | .pop i, _, s, _ => by simp only [RS.sub, fcost]; omega
  | .seq a b, hw, s, hs => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    have h1 := fcost_sub σ a ha s hs
    have h2 := fcost_sub σ b hb _ (hs.run ha)
    simp only [RS.sub, fcost]
    rw [RS.run_sub σ a ha s hs]; omega
  | .ite c a b, hw, s, hs => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    have h1 := fcost_sub σ a ha s hs
    have h2 := fcost_sub σ b hb s hs
    have hc := Ex.cost_sub σ hs c
    simp only [RS.sub, fcost, Ex.eval_sub σ hs]
    split_ifs <;> nlinarith
  | .rep i n b, hw, s, hs => by
    have hbw : NoW σ b := fun j h => hw j (by simp [RS.writes, h])
    have hi : σ i = none := hw i (by simp [RS.writes])
    have hn := Ex.cost_sub σ hs n
    simp only [RS.sub, fcost, Ex.eval_sub σ hs]
    have hsum : (∑ k ∈ Finset.range (n.eval s).toNat, (fcost b (repSt i n b s k) + 31)) ≤
        400 * ∑ k ∈ Finset.range (n.eval s).toNat,
          (fcost (RS.sub σ b) (repSt i (Ex.sub σ n) (RS.sub σ b) s k) + 31) := by
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro k _
      obtain ⟨e1, e2⟩ := repSt_sub σ hbw hi hs k
      rw [e1]
      have := fcost_sub σ b hbw _ e2
      omega
    nlinarith

end NLogN.KFW

