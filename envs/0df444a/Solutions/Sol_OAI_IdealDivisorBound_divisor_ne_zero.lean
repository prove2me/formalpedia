theorem _root_.solution {I J : Ideal O} (hI : I ≠ ⊥) (hJ : J ∈ idealDivisors I) : J ≠ 0 := by
  intro hz
  have hd := (mem_idealDivisors hI).mp hJ
  rw [hz, zero_dvd_iff] at hd
  exact hI hd
