theorem πR_low (c r KG B BJ D2 : ℤ) : PLow (πR c r KG B BJ D2) :=
  PLow.of_list (by simp [HS])

theorem zsz_two : zsz (2 : ℤ) = 2 := by simpa using NLogN.zsz_two_pow 1

theorem LitOK.twoR {π : PMap} {r : ℕ} (hr : π kr = some (r : ℤ)) :
    LitOK π ((2 * r : ℕ) : ℤ) exTwoR := by
  refine ⟨fun j hj hj' => ?_, fun s hs => ?_⟩
  · simp [exTwoR, Ex.regs] at hj; subst hj; revert hj'; simp only [NLogN.zX_all]; decide
  · obtain ⟨L, hL⟩ := hs kr r hr
    refine ⟨⟨IState.isInt_of hL, IState.isInt_of hL⟩, ?_, ?_⟩
    · simp only [exTwoR, Ex.eval, IState.top_eq hL]; push_cast; ring
    · simp only [exTwoR, Ex.cost, Ex.eval, IState.top_eq hL]
      have h1 : zsz (r : ℤ) ≤ zsz ((2 * r : ℕ) : ℤ) := zsz_natCast_le' (by omega)
      simp only [addIntCost, addMagCost, subMagCost, zipCost, moveCost, dupCost]
      omega

theorem LitOK.half {π : PMap} {b : ℕ} (hb : 1 ≤ b) (hB : π kB = some ((2 : ℤ) ^ b)) (sgn : Bool) :
    LitOK π (if sgn then -(2 : ℤ) ^ (b - 1) else (2 : ℤ) ^ (b - 1))
      (if sgn then .neg exHalf else exHalf) := by
  have hcl : exHalf.Clean := by
    intro j hj hj'; simp [exHalf, Ex.regs] at hj; subst hj; revert hj'; simp only [NLogN.zX_all]; decide
  refine ⟨?_, fun s hs => ?_⟩
  · cases sgn
    · exact hcl
    · intro j hj; exact hcl j (by simpa [Ex.regs] using hj)
  · obtain ⟨L, hL⟩ := hs kB _ hB
    have e2 : (2 : ℤ) ^ b = 2 ^ (b - 1) * 2 := by rw [← pow_succ]; congr 1; omega
    have hok : exHalf.ok s := ⟨IState.isInt_of hL, trivial, 1, by simp [Ex.eval]⟩
    have hev : exHalf.eval s = 2 ^ (b - 1) := by
      simp only [exHalf, Ex.eval, IState.top_eq hL]
      rw [e2, Int.mul_tdiv_cancel _ (by norm_num)]
    have z1 : zsz ((2 : ℤ) ^ b) = b + 1 := NLogN.zsz_two_pow b
    have z2 : zsz ((2 : ℤ) ^ (b - 1)) = b - 1 + 1 := NLogN.zsz_two_pow _
    have hco : exHalf.cost s + 20 + (2 * moveCost (zsz ((2 : ℤ) ^ (b - 1))) + 19) ≤
        2000 * (zsz ((2 : ℤ) ^ (b - 1)) + 2) := by
      simp only [exHalf, Ex.cost, Ex.eval, IState.top_eq hL]
      rw [z1, z2, zsz_two]
      simp only [splitCost, takeCost, moveCost, dupCost, zipCost]
      omega
    cases sgn
    · refine ⟨hok, hev, ?_⟩
      simp only [Bool.false_eq_true, ↓reduceIte]; omega
    · refine ⟨hok, by simp [Ex.eval, hev], ?_⟩
      simp only [↓reduceIte, Ex.cost, zsz_neg]
      omega

theorem GSim.refl (π : PMap) : ∀ p : RS, GSim π p p
  | .skip => .skip
  | .asg i e => .asg i (.refl e)
  | .push i e => .push i (.refl e)
  | .pop i => .pop i
  | .seq a b => .seq (refl π a) (refl π b)
  | .ite c a b => .ite (.refl c) (refl π a) (refl π b)
  | .rep i n b => .rep i (.refl n) (refl π b)

theorem isim_rptE {π : PMap} {A C D : Fin HS} (hA : A ≠ 56) {n : ℕ} {e : Ex HS}
    (he : LitOK π (n : ℤ) e) (b : IStmt HS Pp) : ISim I iprog π (rpt A C D n b) (rptE e A C D b) :=
  .seq (ISim.pushE hA he) (ISim.refl π _)

theorem isim_rptZ {π : PMap} {A C D : Fin HS} {n : ℕ} (hn : n = 0) (b : IStmt HS Pp) :
    ISim I iprog π (rpt A C D n b) (rptZ A C D b) := by
  subst hn
  exact ISim.refl π _

theorem isim_digI {π : PMap} {b r : ℕ} (hB : π kB = some ((2 : ℤ) ^ b)) (hr : π kr = some (r : ℤ)) :
    ISim I iprog π (digI b 0 (2 * r) (2 * r)) digU :=
  .seq (.par hB (by decide)) (.seq (isim_rptE (by decide) (LitOK.twoR hr) _) (.seq (.op _)
    (.seq (isim_rptZ (n := 2 * (2 * r - 2 * r)) (by omega) _) (.seq (.op _) (.seq (isim_rptE (by decide) (LitOK.twoR hr) _)
    (.seq (.op _) (.op _)))))))

