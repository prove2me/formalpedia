-- title:
--   Lemma 3.4 — fractional Brownian integral bound for a past-measurable integrand
-- statement:
--   Fix a scalar fractional Brownian motion $B$ with $1/2<H<1$, $0\le\kappa<H-1/2$, and $2\le p<q$. For $0\le s\le t$ with $t-s\le1$, let $F_r$ be smooth in $r$ on $[s,t]$ and measurable with respect to the sigma algebra generated by increments of $B$ up to $s$. Its Young integral satisfies
--
--   $$\left\|\int_s^t F_r\,dB_r\right\|_{L^p} \le C\,\big\||F|_{-\kappa}\big\|_{L^q}\,(t-s)^{H-\kappa},$$
--
--   where $|F|_{-\kappa}$ is the negative Hölder norm on $[s,t]$. The constant depends on $H,\kappa,p,q$ and is uniform over the probability space, driver, integrand, and times. The estimate supplies the stochastic input to Lemma 3.10.
--
--   **Formalization Note** The paper allows a larger filtration satisfying its independence convention; this statement takes the increment filtration. It states the smooth Young-integral case, while the paper also describes an extension to rougher integrands by density.
-- source:
--   Hairer and Li, Averaging dynamics driven by fractional Brownian motion, Ann. Probab. 48(4) (2020), https://doi.org/10.1214/19-AOP1408, p. 1833, Lemma 3.4; p. 1832, Convention

import Mathlib
import Definitions.Def_HairerLiFBM_SemiDet_Model

namespace HairerLiFBM.SemiDet

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

/-- Lemma 3.4, p. 1833, in the smooth Young-integral case and with the increment filtration. -/
theorem lemma_3_4 :
    ∀ (H κ p q : ℝ), 1 / 2 < H → H < 1 →
      0 ≤ κ → κ < H - 1 / 2 → 2 ≤ p → p < q →
      ∃ C : ℝ, 0 < C ∧
        ∀ {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
          (B : ℝ → Ω → E 1), IsFBM 1 H B P → HasHolderPaths 1 H B P →
          ∀ s t, 0 ≤ s → s ≤ t → t - s ≤ 1 →
            ∀ (F : ℝ → Ω → ℝ),
              (∀ ω, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun r => F r ω) (Set.Icc s t)) →
              (∀ r ∈ Set.Icc s t, Measurable[incrSigma B s] (F r)) →
              ∀ I : Ω → ℝ,
                (∀ᵐ ω ∂P,
                  IsYoungIntegral
                    (fun r => F r ω • ContinuousLinearMap.id ℝ ℝ)
                    (fun r => B r ω 0) s t (I ω)) →
                eLpNorm I (ENNReal.ofReal p) P ≤
                  ENNReal.ofReal C *
                    (∫⁻ ω, negHolder κ s t (fun r => F r ω) ^ q ∂P) ^ (1 / q) *
                      ENNReal.ofReal ((t - s) ^ (H - κ)) := by sorry

end HairerLiFBM.SemiDet
