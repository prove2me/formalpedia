-- title:
--   §1.1, p. 1 and Definition 5.6, p. 14 — L∞-algebras as Chevalley–Eilenberg differentials on C∗(L) = Sym(L∨), and the Postnikov pieces
-- statement:
--   Let $L = L_0 \oplus L_1 \oplus L_2 \oplus \cdots$ be a non-negatively graded real vector space. Let $L^\vee$ be the graded vector space with $L_i^* = \mathrm{Hom}(L_i,\mathbb R)$ placed in degree $i+1$, and let
--   $$C^*(L) = \mathrm{Sym}(L^\vee)$$
--   be its graded-symmetric algebra: generators of odd degree (those from $L_i^*$ with $i$ even) anticommute, generators of even degree commute. Concretely
--   $$C^*(L) = \Lambda\Big(\bigoplus_{i \text{ even}} L_i^*\Big) \otimes \mathrm{Sym}\Big(\bigoplus_{i \text{ odd}} L_i^*\Big),$$
--   with the generator maps $\mathrm{gen}_i : L_i^* \to C^*(L)$. The degree-$n$ part $C^n(L)$ is spanned by the products of generators whose degrees add up to $n$ (so $C^0(L) = \mathbb R$).
--
--   An **$L_\infty$-structure** on $L$ is a linear map $\delta : C^*(L) \to C^*(L)$ such that
--
--   1. $\delta$ has degree $+1$: $\delta(C^n(L)) \subseteq C^{n+1}(L)$;
--   2. $\delta$ is a graded derivation: $\delta(xy) = \delta(x)\,y + (-1)^n x\,\delta(y)$ for $x \in C^n(L)$;
--   3. $\delta \circ \delta = 0$.
--
--   This is how the paper encodes $L_\infty$-algebras: the transposes of the brackets assemble into such a derivation, and $\delta^2 = 0$ contains all the axioms.
--
--   A **generator system** is a choice of subspaces $S_i \subseteq L_i^*$; it generates a subalgebra $A_S \subseteq C^*(L)$. Writing $\partial_{i+1}^* : L_i^* \to L_{i+1}^*$ for the linear part of $\delta$ on generators (the transpose of the unary bracket $\partial = [\,]$), define
--
--   - $\ker \partial_{i+1}^* = \{\xi \in L_i^* : \delta(\xi) \text{ lies in the subalgebra generated by } L_{\le i}^*\}$;
--   - $\operatorname{im} \partial_{i}^* = \{\xi \in L_i^* : \exists \eta \in L_{i-1}^*,\ \delta(\eta) - \xi \text{ lies in the subalgebra generated by } L_{\le i-1}^*\}$ for $i \ge 1$, and $0$ for $i = 0$.
--
--   The **Postnikov pieces** of Definition 5.6 are posed dually, by their generator systems:
--   $$(\tau_{\le n}L)^*_i = \begin{cases} L_i^* & i<n\\ \ker\partial_{n+1}^* = (\operatorname{coker}\partial_{n+1})^* & i=n\\ 0 & i>n\end{cases}\qquad (\tau_{< n}L)^*_i = \begin{cases} L_i^* & i<n\\ \operatorname{im}\partial_{n}^* \cong (\operatorname{im}\partial_{n})^* & i=n\\ 0 & i>n.\end{cases}$$
--   The subalgebra $A_{\tau L}$ is the image of the injective DGA map $C^*(\tau L) \to C^*(L)$ dual to the projection $L \to \tau L$. In particular $\tau_{<0}L = 0$.
--
--   **Formalization Note** `CE L`, `gen`, `ceDeg`, `LInfty` (fields `δ`, `deg`, `leibniz`, `sq`), `GenSys`, `genAlg`, `lowAlg`, `kerSub`, `imSub`, `tauLe`, `tauLt`. The characterizations of $\ker\partial^*$ and $\operatorname{im}\partial^*$ use no sign convention for the transpose.
-- source:
--   Henriques, Integrating L∞-algebras, arXiv:math/0603563v2, p. 1, §1.1 (C∗(L), δ); p. 13, standing assumptions of §5; p. 14, Definition 5.6

import Mathlib
open scoped TensorProduct

namespace IntLInfty.Kan

variable (L : ℕ → Type) [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

/-- The Chevalley–Eilenberg algebra `C∗(L) = Sym(L∨)` (graded sense), where the generator space
`L∗ᵢ = Hom(Lᵢ, ℝ)` sits in degree `i + 1`. Generators of odd degree (`i` even) anticommute: they span
the exterior factor. Generators of even degree (`i` odd) commute: they span the symmetric factor.
The tensor product of the two algebras is the graded-commutative one because the symmetric factor
is concentrated in even degrees. -/
abbrev CE : Type :=
  ExteriorAlgebra ℝ (DirectSum {i : ℕ // Even i} fun i => Module.Dual ℝ (L i.1)) ⊗[ℝ]
    SymmetricAlgebra ℝ (DirectSum {i : ℕ // Odd i} fun i => Module.Dual ℝ (L i.1))

/-- The generator map `L∗ᵢ → C∗(L)`: into the exterior factor for even `i` (degree `i + 1` odd),
into the symmetric factor for odd `i` (degree `i + 1` even). -/
noncomputable def gen (i : ℕ) : Module.Dual ℝ (L i) →ₗ[ℝ] CE L :=
  if h : Even i then
    (Algebra.TensorProduct.includeLeft :
        ExteriorAlgebra ℝ (DirectSum {i : ℕ // Even i} fun i => Module.Dual ℝ (L i.1)) →ₐ[ℝ] CE L).toLinearMap
      ∘ₗ ExteriorAlgebra.ι ℝ ∘ₗ
        DirectSum.lof ℝ {i : ℕ // Even i} (fun i => Module.Dual ℝ (L i.1)) ⟨i, h⟩
  else
    (Algebra.TensorProduct.includeRight :
        SymmetricAlgebra ℝ (DirectSum {i : ℕ // Odd i} fun i => Module.Dual ℝ (L i.1)) →ₐ[ℝ] CE L).toLinearMap
      ∘ₗ SymmetricAlgebra.ι ℝ _ ∘ₗ
        DirectSum.lof ℝ {i : ℕ // Odd i} (fun i => Module.Dual ℝ (L i.1)) ⟨i, Nat.not_even_iff_odd.mp h⟩

/-- The degree-`n` part of `C∗(L)`: the span of the products of generators whose degrees
(`i + 1` for a generator from `L∗ᵢ`) add up to `n`. The empty product gives `ceDeg L 0 ∋ 1`. -/
def ceDeg (n : ℕ) : Submodule ℝ (CE L) :=
  Submodule.span ℝ {x | ∃ (k : ℕ) (d : Fin k → ℕ) (ξ : ∀ t, Module.Dual ℝ (L (d t))),
    (∑ t, (d t + 1)) = n ∧ x = (List.ofFn fun t => gen L (d t) (ξ t)).prod}

/-- An `L∞`-structure on the non-negatively graded vector space `L`, given (§1.1) by its
Chevalley–Eilenberg differential: a linear map `δ` of degree `+1` which is a graded derivation and
squares to zero. -/
structure LInfty where
  /-- the Chevalley–Eilenberg differential -/
  δ : CE L →ₗ[ℝ] CE L
  /-- `δ` has degree `+1` -/
  deg : ∀ n, ∀ x ∈ ceDeg L n, δ x ∈ ceDeg L (n + 1)
  /-- graded Leibniz rule, the sign given by the degree of the left factor -/
  leibniz : ∀ n, ∀ x ∈ ceDeg L n, ∀ y : CE L, δ (x * y) = δ x * y + (-1 : ℝ) ^ n • (x * δ y)
  /-- `δ² = 0` -/
  sq : δ ∘ₗ δ = 0

/-- A generator system: a subspace `S i ⊆ L∗ᵢ` for every degree. -/
abbrev GenSys : Type := ∀ i, Submodule ℝ (Module.Dual ℝ (L i))

/-- The subalgebra of `C∗(L)` generated by the generator system `S`. The full system gives
`C∗(L)`, the zero system gives `ℝ`. -/
noncomputable def genAlg (S : GenSys L) : Subalgebra ℝ (CE L) :=
  Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) '' (S i : Set (Module.Dual ℝ (L i))))

/-- The subalgebra generated by all generators from `L∗ₖ` with `k ≤ p`. -/
noncomputable def lowAlg (p : ℕ) : Subalgebra ℝ (CE L) :=
  Algebra.adjoin ℝ (⋃ k, ⋃ (_ : k ≤ p), Set.range (gen L k))

variable {L}

/-- `ker ∂ᵢ₊₁∗ ⊆ L∗ᵢ`, where `∂ᵢ₊₁∗ : L∗ᵢ → L∗ᵢ₊₁` is the transpose of the unary bracket, i.e. the
linear part of `δ` on generators. Written without a sign convention: `ξ` lies in it iff `δ(ξ)` lies in
the subalgebra generated by `L∗_{≤ i}` (the nonlinear part of `δ(ξ)` always does). -/
noncomputable def kerSub (δ : LInfty L) (i : ℕ) : Submodule ℝ (Module.Dual ℝ (L i)) :=
  (Subalgebra.toSubmodule (lowAlg L i)).comap (δ.δ ∘ₗ gen L i)

/-- `im ∂ᵢ∗ ⊆ L∗ᵢ` (with `im ∂₀∗ = 0`): for `i = p + 1`, the `ξ ∈ L∗ₚ₊₁` such that
`δ(η) − ξ` lies in the subalgebra generated by `L∗_{≤ p}` for some `η ∈ L∗ₚ`. -/
noncomputable def imSub (δ : LInfty L) : (i : ℕ) → Submodule ℝ (Module.Dual ℝ (L i))
  | 0 => ⊥
  | p + 1 =>
    ((Subalgebra.toSubmodule (lowAlg L p)).comap
        ((δ.δ ∘ₗ gen L p) ∘ₗ LinearMap.fst ℝ _ _ - gen L (p + 1) ∘ₗ LinearMap.snd ℝ _ _)).map
      (LinearMap.snd ℝ (Module.Dual ℝ (L p)) (Module.Dual ℝ (L (p + 1))))

/-- The generator system of the Postnikov piece `τ≤ₙL` (Definition 5.6), posed dually:
`(τ≤ₙL)∗ᵢ = L∗ᵢ` for `i < n`, `(coker ∂ₙ₊₁)∗ = ker ∂ₙ₊₁∗` for `i = n`, `0` for `i > n`. -/
noncomputable def tauLe (δ : LInfty L) (n : ℕ) : GenSys L := fun i =>
  if i < n then ⊤ else if i = n then kerSub δ i else ⊥

/-- The generator system of the Postnikov piece `τ<ₙL` (Definition 5.6), posed dually:
`L∗ᵢ` for `i < n`, `(im ∂ₙ)∗ ≅ im ∂ₙ∗` for `i = n`, `0` for `i > n`. `tauLt δ 0 = ⊥`. -/
noncomputable def tauLt (δ : LInfty L) (n : ℕ) : GenSys L := fun i =>
  if i < n then ⊤ else if i = n then imSub δ i else ⊥

end IntLInfty.Kan


