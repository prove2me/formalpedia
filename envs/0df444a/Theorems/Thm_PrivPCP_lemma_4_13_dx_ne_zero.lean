-- title:
--   Lemma 4.13: $dx\ne0$, $dy\ne0$ for curves of bidegree below $q$
-- statement:
--   This is a step in the proof of Lemma 4.13 in the source: the coordinate functions of a curve of small bidegree have nonzero differentials.
--
--   Let $q$ be prime and $K=\overline{\mathbb F}_q$. Let $F\in K[X,Y]$ be irreducible of bidegree $(a,b)$ with $0<a<q$ and $0<b<q$, and let $x,y$ be the coordinate functions on the function field $K(\mathcal X_F)$. Then
--
--   $$dx\ne0\qquad\text{and}\qquad dy\ne0$$
--
--   in the module of Kähler differentials of $K(\mathcal X_F)/K$.
--
--   The source argues as follows. Since $K$ is perfect, $dx=0$ exactly when $x$ is a $q$-th power in $K(\mathcal X_F)$. That would make $q$ divide $\deg(x)=b$, which is impossible for $0<b<q$. Together with $q\nmid n_1n_2$, this gives the hypothesis $d(x^{n_1}),d(y^{n_2})\ne0$ of Theorem 4.12.
--
--   **Formalization Note** The function field is any field $L\supseteq K$ generated by $x,y$ in which the kernel of $X\mapsto x$, $Y\mapsto y$ is $(F)$. The differential $d$ is `KaehlerDifferential.D`.
-- source:
--   Bafna, Vyas, Private PCPs from Product Expansion, STOC 2027 submission manuscript (sha256 c2cac1e07fc4af8721f673867373fc5bd417aa65f45cf170c543568abcf1e47e), proof of Lemma 4.13, p.25 (PDF p.27)

import Mathlib

namespace PrivPCP

theorem lemma_4_13_dx_ne_zero : ∀ (q : ℕ) [Fact q.Prime]
    (F : MvPolynomial (Fin 2) (AlgebraicClosure (ZMod q))),
    Irreducible F → 0 < F.degreeOf 0 → 0 < F.degreeOf 1 → F.degreeOf 0 < q → F.degreeOf 1 < q →
    ∀ (L : Type) [Field L] [Algebra (AlgebraicClosure (ZMod q)) L] (x y : L),
    RingHom.ker (MvPolynomial.aeval (R := AlgebraicClosure (ZMod q)) ![x, y]).toRingHom =
      Ideal.span {F} →
    IntermediateField.adjoin (AlgebraicClosure (ZMod q)) {x, y} = ⊤ →
    KaehlerDifferential.D (AlgebraicClosure (ZMod q)) L x ≠ 0 ∧
      KaehlerDifferential.D (AlgebraicClosure (ZMod q)) L y ≠ 0 := by
  sorry

end PrivPCP
