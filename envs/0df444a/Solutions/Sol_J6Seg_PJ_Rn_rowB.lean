/-- **A straight-line block.** -/
theorem Rn.insL {W N : ℕ} (hN : N ≤ 2 ^ W) : ∀ (l : List Ins) {v : Vr} {c : Cs}, BV W v →
    OkL W N l (v, c) →
    Rn (progL l) v c (fun v' => v' = (runL l (v, c)).1 ∧ BV W v') (runL l (v, c)).2 (costL W N l)
  | [], v, c, hv, _ => (Rn.skip v c).mono (fun v' h => ⟨h, h ▸ hv⟩) le_rfl
