-- title:
--   Eq. (10): the EM E step for superimposed sources
-- statement:
--   Let $\mathbf s_i:\mathbb C^{P_i}\to\mathbb C^M$, $i=1,\dots,K$, be the source contributions, each depending only on its own parameter block $\boldsymbol\theta_i$, and let $\boldsymbol\theta^k=(\boldsymbol\theta^k_1,\dots,\boldsymbol\theta^k_K)$ be the current estimate. Let $\mathbf\Pi$ be a positive definite Hermitian $M\times M$ matrix and let $\beta_1,\dots,\beta_K\ge0$ with $\sum_i\beta_i=1$. Let the noise components $(\tilde{\mathbf n}_1,\dots,\tilde{\mathbf n}_K)$ be jointly zero-mean circular complex Gaussian with
--
--   $$E\{\tilde{\mathbf n}_i\tilde{\mathbf n}_j^H\}=\beta_i\delta_{ij}\mathbf\Pi,$$
--
--   and set $\tilde{\mathbf x}_i=\mathbf s_i(\boldsymbol\theta^k_i)+\tilde{\mathbf n}_i$ and $\mathbf y=\sum_i\tilde{\mathbf x}_i$, so that $\mathbf y=\sum_i\mathbf s_i(\boldsymbol\theta^k_i)+\mathbf n$ with $\mathbf n=\sum_i\tilde{\mathbf n}_i$. Then for every $i$, almost surely,
--
--   $$E\{\tilde{\mathbf x}_i\mid\mathbf y,\boldsymbol\theta^k\}=\mathbf s_i(\boldsymbol\theta^k_i)+\beta_i\Big(\mathbf y-\sum_{l=1}^K\mathbf s_l(\boldsymbol\theta^k_l)\Big).$$
--
--   This is the E step of the EM algorithm for superimposed signals (Feder and Weinstein), whose M step fits $\boldsymbol\theta_i$ to $\widehat{\tilde{\mathbf x}}_i$ separately for each source.
--
--   **Formalization Note** The conditional expectation is taken with respect to the $\sigma$-algebra generated by $\mathbf y$, on a probability space carrying the noise, with the model evaluated at $\boldsymbol\theta^k$. The paper's "jointly Gaussian" is stated as the joint law of the stacked components being circular complex Gaussian with the block covariance (8); circularity is the convention of eq. (15) and is needed (see the mission report). The paper calls the $\beta_i$ an affine combination; $\beta_i\ge0$ is required for $\beta_i\mathbf\Pi$ to be a covariance.
-- source:
--   Yatawatta, Zaroubi, de Bruyn, Koopmans and Noordam, Radio interferometric calibration using the SAGE algorithm, arXiv:0810.5751v1 (2008), claim c002; Section III-A (EM Algorithm), eqs. (7)-(10), PDF p. 3

import Mathlib
import Definitions.Def_Arxiv0810_5751_Basic

open MeasureTheory Matrix
open scoped ComplexOrder

namespace Arxiv0810_5751

theorem em_estep_cond_mean {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {K M : ℕ} (P : Fin K → ℕ) (s : ∀ i : Fin K, (Fin (P i) → ℂ) → Fin M → ℂ)
    (θk : ∀ i : Fin K, Fin (P i) → ℂ)
    (Pcov : Matrix (Fin M) (Fin M) ℂ) (hPcov : Pcov.PosDef)
    (β : Fin K → ℝ) (hβ0 : ∀ i, 0 ≤ β i) (hβ1 : ∑ i, β i = 1)
    (nt : Fin K → Ω → Fin M → ℂ) (hnt : ∀ i, Measurable (nt i))
    (hlaw : IsCircGaussian (μ.map fun ω (a : Fin K × Fin M) => nt a.1 ω a.2) (emNoiseCov β Pcov))
    (i : Fin K) :
    μ[fun ω => s i (θk i) + nt i ω |
        MeasurableSpace.comap (fun ω => ∑ l, s l (θk l) + ∑ l, nt l ω) inferInstance] =ᵐ[μ]
      fun ω => s i (θk i) + (β i : ℂ) • ((∑ l, s l (θk l) + ∑ l, nt l ω) - ∑ l, s l (θk l)) := by sorry

end Arxiv0810_5751
