theorem eq_packed_of_rows {n m : ℕ} (rows : IntMatrix) (A : Hex.Matrix ℤ n m)
    (hlen : rows.length=n) (h : ∀ i : Fin n, rowAt rows i.val=packVector (A.getRow i)) :
