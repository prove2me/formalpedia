-- title:
--   Weighted local Bézout bound for a minimal complete intersection
-- statement:
--   For an ideal generated by exactly as many bounded-degree polynomials as the height of a minimal prime, the local quotient length at that prime, multiplied by the selected normal-coordinate weights, is bounded by twice the degree bound to that height. In positive codimension, prove this by restricting to a generic transverse coordinate slice, applying a coordinate-power substitution to turn weighted degree into ordinary degree, and using ordinary Bézout for isolated intersection multiplicities. The zero-codimension case is handled separately by the empty basis and unit local length.

import Definitions.Def_OAI_PiExponent_LogarithmicNormalBases
import Definitions.Def_OAI_PiExponent_ComponentLocalLength
import Mathlib.RingTheory.Ideal.Height

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.weighted_local_complete_intersection_bezout
    {m k : Nat} (w : Fin (m + 1) → Rat)
    (hw : ∀ i, 0 < (w i : Real)) (H : Real) (hH : 0 < H)
    (f : Fin k → MvPolynomial (Fin (m + 1)) Complex)
    (P : Ideal (MvPolynomial (Fin (m + 1)) Complex)) [P.IsPrime]
    (hminimal :
      (Ideal.span (Set.range f)).IsMinimalPrime P)
    (hdegree : ∀ j, logarithmicDegreeBound w H (f j))
    (A : Finset (Fin (m + 1)))
    (hA : coordinateNormalBasisAtPrime P A)
    (hcard : A.card = P.height)
    (L : Nat)
    (hlength :
      componentLocalLength (Ideal.span (Set.range f)) P = (L : ENat)) :
    (L : Real) * (∏ i ∈ A, (w i : Real)) ≤ 2 * H ^ A.card := by sorry
