variable {R : Type*} [CommRing R] {m W : ℕ}

variable [NeZero W] (C : Circuit R m W) {N : ℕ} [NeZero N] (P L' : ℕ) (A B Cs : Shape)

omit [NeZero N] in
lemma childOK_swap {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) (steps : List (AModel.Step (m + m) N))
    (hsteps : ∀ a b, Step.swap a b ∈ steps →
      ∃ i j : Fin m, a = Fin.castAdd m i ∧ b = Fin.natAdd m j) :
