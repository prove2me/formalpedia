theorem specMap_comp_specMap :
    specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ ≫ specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ) = specMap ℤ ℚ := by
  rw [specMap, specMap, specMap, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rfl

def pasteIso : pullback (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≅ (D.baseChange ℚ).P :=
  pullbackLeftPullbackSndIso D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≪≫
    pullback.congrHom rfl (specMap_comp_specMap (ℓ := ℓ))

theorem pasteIso_inv_snd :
    (pasteIso D (ℓ := ℓ)).inv ≫ pullback.snd (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)
      = (D.baseChange ℚ).toBase := by
  simp only [pasteIso, Iso.trans_inv, Category.assoc, pullbackLeftPullbackSndIso_inv_snd_snd, pullback.congrHom_inv,
    pullback.lift_snd, Category.comp_id]

theorem pasteIso_hom_toBase :
    (pasteIso D (ℓ := ℓ)).hom ≫ (D.baseChange ℚ).toBase
      = pullback.snd (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) := by
  rw [← pasteIso_inv_snd D (ℓ := ℓ), Iso.hom_inv_id_assoc]

theorem exists_curveIsoQ (𝔛 : DRModelPackage p) (P : Pkg p ℓ) :
    ∃ (e36 : P.M₀.C ≅ 𝔛.M₀.C) (he36 : e36.hom ≫ 𝔛.M₀.toBase = P.M₀.toBase)
      (hplace36 : ∀ x : closedPoints P.M₀.C,
        𝔛.M₀.placeOfPoint ⟨e36.hom.base x.1, by
            show IsClosed ({e36.hom.base x.1} : Set 𝔛.M₀.C)
            rw [← Set.image_singleton]
            exact (TopCat.homeoOfIso (Scheme.forgetToTop.mapIso e36)).isClosedMap _ x.2⟩
          = Place.congrRingEquiv (AlgEquiv.refl : ↥(modularFunctionFieldFull p) ≃ₐ[ℚ] ↥(modularFunctionFieldFull p)).toRingEquiv
              (fun a => (AlgEquiv.refl : ↥(modularFunctionFieldFull p) ≃ₐ[ℚ] ↥(modularFunctionFieldFull p)).commutes a)
              (P.M₀.placeOfPoint x))
      (eQ : pullback P.c (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≅ pullback (DRModel.toBase p) (specMap ℤ ℚ)),
      eQ.hom ≫ pullback.snd _ _ = pullback.snd _ _ ∧ eQ.inv ≫ pullback.snd _ _ = pullback.snd _ _ ∧
      P.e₀ ≫ eQ.hom = e36.hom ≫ 𝔛.e₀ := by
  obtain ⟨e36, he36, hplace⟩ := AlgebraicCurve.CurveModel.exists_iso_comp_toBase_eq_placeOfPoint_congr_eq
    (AlgEquiv.refl : ↥(modularFunctionFieldFull p) ≃ₐ[ℚ] ↥(modularFunctionFieldFull p)) P.M₀ 𝔛.M₀
  haveI := P.e₀_iso; haveI := 𝔛.e₀_iso
  let eQ : pullback P.c (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≅ pullback (DRModel.toBase p) (specMap ℤ ℚ) :=
    (asIso P.e₀).symm ≪≫ e36 ≪≫ asIso 𝔛.e₀
  have h1 : eQ.hom ≫ pullback.snd _ _ = pullback.snd _ _ := by
    show (inv P.e₀ ≫ e36.hom ≫ 𝔛.e₀) ≫ pullback.snd _ _ = _
    rw [Category.assoc, Category.assoc, 𝔛.he₀, he36, ← P.he₀, IsIso.inv_hom_id_assoc]
  refine ⟨e36, he36, hplace, eQ, h1, ?_, ?_⟩
  · rw [← h1, Iso.inv_hom_id_assoc]
  · show P.e₀ ≫ inv P.e₀ ≫ e36.hom ≫ 𝔛.e₀ = _
    rw [IsIso.hom_inv_id_assoc]

theorem exists_theta
    (hbundle : AbelianSchemePropertyBundle ↥(GaloisRep.ratLocalizedAt ℓ) (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))) :
    ∃ (e36 : P.M₀.C ≅ 𝔛.M₀.C) (he36 : e36.hom ≫ 𝔛.M₀.toBase = P.M₀.toBase)
      (hplace36 : ∀ x : closedPoints P.M₀.C,
