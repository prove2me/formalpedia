-- title:
--   Explicit logarithmic coordinate power ideals
-- statement:
--   At a center $c$, use the coordinates $u_0=X_0-1$ and $u_{i+1}=X_{i+1}-c_i-(\log(1+u_0))_{<T_i}$. The center ideal is generated by $u_i^{e_i}$, and the ideal of a finite family of centers is their product. These explicit polynomial ideals encode the affine restrictions of the geometric logarithmic center ideals; their powers link geometric quotient lifting to formal weighted jet vanishing.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Jets/AlgebraicJetPackets.lean, inverseTriangularMap; Jets/CompactJetPolynomial.lean, coordinates, powerIdeal and logPolynomials; Jets/CompactLogJetIdeal.lean, polynomialIdeal.

import Definitions.Def_OAI_PiExponent_FormalInterpolationPackets
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.Polynomial.AlgebraMap

open scoped BigOperators
noncomputable section
namespace OAI.PiExponent.FormalInterpolation

def logarithmicCoordinate {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ) :
    Fin (m + 1) → MvPolynomial (Fin (m + 1)) ℂ :=
  Fin.cases (MvPolynomial.X 0 - 1)
    (fun i => MvPolynomial.X i.succ - MvPolynomial.C (c i) -
      Polynomial.aeval (MvPolynomial.X 0 - 1)
        (InterpolationMatrix.truncatedLog (T i)))

def logarithmicCenterIdeal {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ)
    (e : Fin (m + 1) → ℕ) : Ideal (MvPolynomial (Fin (m + 1)) ℂ) :=
  Ideal.span (Set.range (fun i => logarithmicCoordinate c T i ^ e i))

def logarithmicCentersIdeal {m K : ℕ} (c : Fin K → Fin m → ℂ)
    (T : Fin m → ℕ) (e : Fin (m + 1) → ℕ) :
    Ideal (MvPolynomial (Fin (m + 1)) ℂ) :=
  ∏ j, logarithmicCenterIdeal (c j) T e

end OAI.PiExponent.FormalInterpolation


