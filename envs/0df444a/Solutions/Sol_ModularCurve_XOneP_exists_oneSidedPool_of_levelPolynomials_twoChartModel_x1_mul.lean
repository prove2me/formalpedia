    {x : C} (hx0 : x ∈ c.smoothLocus) : x ∈ (U : Set C) := by
  have hWsm : Smooth (c.smoothLocus.ι ≫ c) := by
    apply Scheme.Hom.smoothLocus_eq_top_iff.mp
    rw [← Scheme.Hom.preimage_smoothLocus_eq]
