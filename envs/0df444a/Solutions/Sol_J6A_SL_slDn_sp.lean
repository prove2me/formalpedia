    have hu := uC_ge A DD
    simp only [popL, List.not_mem_nil, if_false]
    exact (Sp.skip _).mono (by simp; omega)
  | i :: l, G, hn, hl => by
    have hi : i ∉ l := (List.nodup_cons.1 hn).1
    obtain ⟨h5, a, r, hG, ha⟩ := hl i (by simp)
    have h1 := popP s0 G (i := i) (D := DD) h5 hG ha (by decide)
    have h2 := popL_sp s0 l (update G i r) (List.nodup_cons.1 hn).2
      (fun j hj => by
        have hji : j ≠ i := fun h => hi (h ▸ hj)
        rw [update_of_ne hji]; exact hl j (by simp [hj]))
    have e : (fun j => if j ∈ l then (update G i r j).tail else update G i r j) =
        (fun j => if j ∈ i :: l then (G j).tail else G j) := by
      funext j
      by_cases hj : j = i
      · subst hj; simp [hi, hG]
      · by_cases hjl : j ∈ l <;> simp [hj, hjl, update_of_ne hj]
    rw [e] at h2
    refine (h1.seq h2).mono (le_of_eq ?_)
    simp only [List.length_cons]; ring

