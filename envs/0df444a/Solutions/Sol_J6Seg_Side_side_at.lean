namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue NLogN.KFZ

noncomputable section

attribute [local irreducible] fmA Cfm

theorem lgn_ge (n : ℕ) : 1 ≤ Real.log (IntMul.lg n) + 1 := by
  have : (1 : ℝ) ≤ IntMul.lg n := by exact_mod_cast bP6_pos n
  have := Real.log_nonneg this; linarith

theorem lgp_le (P : Prm) (n : ℕ) :
    Real.log (pP6 P n) + 1 ≤ ((P.x : ℝ) + 4) * (Real.log (IntMul.lg n) + 1) := by
  have hb : (1 : ℝ) ≤ IntMul.lg n := by exact_mod_cast bP6_pos n
  have hl := Real.log_nonneg hb
  have e : (pP6 P n : ℝ) = 6 * (IntMul.lg n : ℝ) ^ (1 + P.x) := by
    unfold pP6 b'P6 bP6; push_cast; ring
  rw [e, Real.log_mul (by norm_num) (by positivity), Real.log_pow]
  have h6 : Real.log 6 ≤ 2 := by
    have := Real.add_one_le_exp (2 : ℝ)
    have h7 : (6 : ℝ) ≤ Real.exp 2 := by
      have := Real.exp_one_gt_d9
      have e2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
      nlinarith
    calc Real.log 6 ≤ Real.log (Real.exp 2) := Real.log_le_log (by norm_num) h7
      _ = 2 := Real.log_exp 2
  push_cast
  have hx : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  nlinarith

end

end IntMul.Kappa.R6

end

