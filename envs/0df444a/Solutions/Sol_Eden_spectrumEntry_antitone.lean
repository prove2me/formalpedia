open Set
open Eden
namespace Eden
theorem _root_.solution {a : Fin 5 → ℝ} (ha : Antitone a)
    {i j : ℕ} (hij : i ≤ j) (hj : j < 5) : spectrumEntry a j ≤ spectrumEntry a i := by
  have hi : i < 5 := lt_of_le_of_lt hij hj
  simp only [spectrumEntry, dif_pos hi, dif_pos hj]
  exact ha hij
end Eden
