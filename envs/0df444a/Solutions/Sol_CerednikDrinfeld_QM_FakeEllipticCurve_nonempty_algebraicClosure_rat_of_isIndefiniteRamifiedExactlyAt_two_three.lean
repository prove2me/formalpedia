theorem span_mul_mem {K : Type} [Field K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0)
    (x y : K) (hx : x ∈ Submodule.span ℤ ({1, ω} : Set K)) (hy : y ∈ Submodule.span ℤ ({1, ω} : Set K)) :
    x * y ∈ Submodule.span ℤ ({1, ω} : Set K) := by
  rw [Submodule.mem_span_pair] at hx hy ⊢
  obtain ⟨a, b, rfl⟩ := hx
  obtain ⟨c, d, rfl⟩ := hy
  refine ⟨a * c - b * d, a * d + b * c - b * d, ?_⟩
  simp only [zsmul_eq_mul, Int.cast_sub, Int.cast_mul, Int.cast_add]
  linear_combination (-((b : K) * (d : K))) * hω

theorem chi_intCast {K F : Type} [Field K] [CharZero K] [Field F] (ω : K)
    (O : Submodule ℤ K) (hO : O = Submodule.span ℤ ({1, ω} : Set K))
    (χ : ↥O → F) (hχ1 : ∀ h : (1 : K) ∈ O, χ ⟨1, h⟩ = 1) (hχadd : ∀ x y : ↥O, χ (x + y) = χ x + χ y)
    (n : ℤ) (hn : ((n : ℚ) : K) ∈ O) : χ ⟨((n : ℚ) : K), hn⟩ = (n : F) := by
  have h1 : (1 : K) ∈ O := by rw [hO]; exact Submodule.subset_span (by simp)
  have mem : ∀ m : ℤ, ((m : ℚ) : K) ∈ O := fun m => by
    have : ((m : ℚ) : K) = m • (1 : K) := by simp
