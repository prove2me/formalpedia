theorem NLogN.Rsp.row1P_all (T RK : Fin HS) (hd : TDist T TCI TCK TRI RK) (hTR : T ≠ TRI) (hRR : RK ≠ TRI)
    (wP : RS) (s0 : IState HS) (NK : ℕ) (wf : ℕ → ℕ → ℤ) (Cw : ℕ)
    (hw : WSpec wP T TCI TCK (s0.upd TRI (.int 1 :: s0.G TRI)) 1 NK wf Cw) (LK : List Item)
    (hRK : s0.G RK = .int (NK : ℤ) :: LK) :
    (row1P T RK wP).ok s0 ∧
      (row1P T RK wP).run s0 = s0.upd T (ints ((List.range NK).map (wf 0)) ++ s0.G T) ∧
