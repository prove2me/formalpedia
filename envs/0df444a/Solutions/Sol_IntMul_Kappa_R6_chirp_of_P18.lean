namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

attribute [local irreducible] fmA Cfm

theorem Kc_nonneg : 0 ≤ Kc := by unfold Kc; positivity

end

