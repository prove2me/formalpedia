/-- The Taylor polynomial is `C^m` on any set, for every `m`. -/
theorem contDiffOn_taylorPoly_any (L : ℕ → ℝ) (n m : ℕ) (s : Set ℝ) :
    ContDiffOn ℝ m (taylorPoly L n) s := by
  have hfun : taylorPoly L n
      = fun x : ℝ => ∑ j ∈ Finset.range (n + 1), L j / (j.factorial : ℝ) * x ^ j := rfl
  rw [hfun]; fun_prop

