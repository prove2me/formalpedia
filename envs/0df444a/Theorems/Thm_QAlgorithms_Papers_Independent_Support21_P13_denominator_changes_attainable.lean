-- title:
--   Every denominator change is attained among four phases
-- statement:
--   Let $z,w\in R$ satisfy $|z|^2+|w|^2=1$, and suppose the finite squared-modulus exponent $d=\operatorname{sde}(|z|^2)$ is at least four. Then
--
--   $$
--   \forall s\in\{-1,0,1\}\ \exists k\in\{0,1,2,3\}:\quad
--   \operatorname{sde}\!\left(\left|\frac{z+w\omega^k}{\sqrt2}\right|^2\right)=d+s.
--   $$
--
--   Each displayed exponent is the finite least integer exponent relative to $\sqrt2$ and $\mathbb Z[\omega]$. This supplies a reducing phase choice for exact synthesis; no verifier bucket conditions are additional hypotheses.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 6, Lemma 3: all three denominator changes are attainable

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Lemma 3, PDF p.6: each denominator change is attained by a representative
k=0,1,2,3. The inconsistent verifier buckets on pp.13-14 are not hypotheses. -/
theorem denominator_changes_attainable (z w : ℂ)
    (hz : z ∈ synthesisRing) (hw : w ∈ synthesisRing)
    (hstate : Complex.normSq z + Complex.normSq w = 1)
    (d : ℤ) (hd : IsSDE (normSquared z) d) (hlarge : 4 ≤ d) :
    ∀ s : ℤ, s = -1 ∨ s = 0 ∨ s = 1 →
      ∃ k : Fin 4,
        IsSDE (normSquared ((z + w * (QAlgorithms.gateT true true) ^ k.val) / ((Real.sqrt 2 : ℝ) : ℂ))) (d + s) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
