theorem GlobalTheory.HermFrame.Model.curv_quot (h : MContDiffAt 2 H z) (hh : ∀ᶠ x in 𝓝 z, (H x).IsHermitian)
    (hu : IsUnit (H z).det) (hs : IsUnit (subGram (H z)).det) (ξ η : E) :
    curv (fun x => quotGram (H x)) z ξ η =
      blockQQ (H z) (curv H z ξ η) + secondForm H z ξ * secondFormAdj H z η := by sorry
