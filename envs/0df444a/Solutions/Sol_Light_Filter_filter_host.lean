    exact (Nat.not_prime_mul (by norm_num) (by omega)) hp
  refine Finset.card_pos.2 ⟨p, ?_⟩
  simp only [Light.Filter.pool, Finset.mem_filter, Finset.mem_range]
  exact ⟨by omega, hlt.le, hp⟩

