theorem J6Seg.AC.akCond_at (P : Prm) {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (h : AxANum P n src D k)
    (hp64 : 64 ≤ pP6 P n) :
    let p := pP6 P n; let s := src k; let t := tF6 P n k; let α := αN6 P n; let H := HA6 P n
    let pk := pkA6 8 16 p; let b := bA6 17 40 p; let w := p + 2
    let f := Nat.log 2 (IntMul.HvdH.sWidth p α) + 3
    let pre := preT P n D k; let post := postT P n D k
    let WA := J6A.WA p α H
    AKCond p s t α H pk b w f pre post (mulSup (2 * (20 * p + 60)))
      (mulSup (2 * (b * (2 * (2 * WA + 2 * H)) + 2))) (20 * p + 60) (b + 2) (b + 2)
      (17 + 2 * WA + (2 * WA + 2 * H) + 2 * H) (aK0 p) (aK0 p) (aK0 p) (2 ^ (p + 2)) := by sorry
