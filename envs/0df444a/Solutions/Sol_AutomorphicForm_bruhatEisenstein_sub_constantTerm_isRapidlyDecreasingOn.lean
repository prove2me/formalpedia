section ComplexTransport

p2m_open "Complex Function.Complex"

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

private def toComplexGL : GL (Fin 2) w.Completion →* GL (Fin 2) ℂ :=
  Units.map (RingHom.mapMatrix (ringEquivComplexOfIsComplex hw).toRingHom).toMonoidHom

omit [NumberField F] in
private theorem toComplexGL_apply (k : GL (Fin 2) w.Completion) (i j : Fin 2) :
    ((toComplexGL hw k : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) i j
      = ringEquivComplexOfIsComplex hw ((k : Matrix (Fin 2) (Fin 2) w.Completion) i j) := rfl

omit [NumberField F] in
private theorem ofComplexGL_toComplexGL (k : GL (Fin 2) w.Completion) :
    ofComplexGL hw (toComplexGL hw k) = k := by
  apply Units.ext
  ext i j
  rw [ofComplexGL_coe, toComplexGL_apply, RingEquiv.symm_apply_apply]

omit [NumberField F] in

private theorem toComplexGL_unipotentGL2 (c : w.Completion) :
    toComplexGL hw (unipotentGL2 c) = unipotentGL2 (ringEquivComplexOfIsComplex hw c) := by
  apply Units.ext
  ext i j
  rw [toComplexGL_apply, unipotentGL2_coe, unipotentGL2_coe]
  fin_cases i <;> fin_cases j <;> simp

omit [NumberField F] in

private theorem toComplexGL_gl2Weyl : toComplexGL hw (gl2Weyl : GL (Fin 2) w.Completion) = gl2Weyl := by
  apply Units.ext
  ext i j
  rw [toComplexGL_apply, gl2Weyl_val, gl2Weyl_val]
  fin_cases i <;> fin_cases j <;> simp

omit [NumberField F] in
private theorem det_toComplexGL_ne_zero (k : GL (Fin 2) w.Completion) :
    ((toComplexGL hw k : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ).det ≠ 0 :=
  Matrix.GeneralLinearGroup.det_ne_zero _

omit [NumberField F] in

private theorem norm_ringEquivComplexOfIsComplex (x : w.Completion) :
