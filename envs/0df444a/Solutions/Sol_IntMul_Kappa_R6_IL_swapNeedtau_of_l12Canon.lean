set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFS NLogN.KFL NLogN.KFW AModel AModelL12

section Chain

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

/-- **`SwapNeedτ` from fine Lemma 12**: the table `kTableP tab` with the one extra procedure
`(swGUP l12).ren id (gL 1)` (entry `7`) and the descriptor on `dS`. -/
theorem swapNeedτ_of_l12Canon_sol_aux (hτ : 0 ≤ τ) (h : L12Canon tab l12 τ) : SwapNeedτ tab τ := by
  obtain ⟨K, hK, HK⟩ := swGUP_spec hτ h
  refine ⟨1, fun _ => (swGUP l12).ren id (KFM.gL 1), ⟨7, by omega⟩, dS, K + 2, by decide,
    by positivity, ?_⟩
  intro Isym u w sh p q hu hsh hpq hq hpu hqu s f zs l hf hfD hf0 hzl hGB
  obtain ⟨c, Hc, hc⟩ := HK u w sh p q hu hsh hpq hq hpu hqu Isym s f zs l hf hfD hf0 hzl hGB
  have R := KFM.IRuns.relabel (iprog' := kTableP tab (fun _ => (swGUP l12).ren id (KFM.gL 1)))
    (g := KFM.gL 1) (kTableP_l12 tab _) Hc
  have hent : kTableP tab (fun _ : Fin 1 => (swGUP l12).ren id (KFM.gL 1)) ⟨7, by omega⟩ =
      (swGUP l12).ren id (KFM.gL 1) := by
    simp [kTableP]
  refine ⟨c + 2, IRuns.call (by rw [hent]; exact R), ?_⟩
  set X : ℝ := ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ +
    (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ) with hX
  have hX1 : 1 ≤ X := by
    have h1 : (0 : ℝ) ≤ ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ := by positivity
    have h2 : 0 < (sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 := by positivity
    have h3 : (1 : ℝ) ≤ (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ) := by
      exact_mod_cast h2
    linarith
  push_cast
  nlinarith

end Chain

end IntMul.Kappa.R6.IL

