-- title:
--   Nonnegative Poisson integral is measurable in regional count σ-algebra
-- statement:
--   Every nonnegative measurable integrand supported in R has a lintegral against the original arbitrary LevyStochCalc Poisson random measure N measurable in the σ-algebra generated by measurable subregion evaluations of N. Use finite simple approximation and count evaluation, adapting the proved LeanLevy point-family argument to the actual structure.
-- source:
--   Kyprianou (2006) Chapter 2 Eq (2.3), marked integrals of arbitrary LevyStochCalc.Poisson.PoissonRandomMeasure.

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
set_option autoImplicit false

theorem Kyprianou.Ch02.prmNonnegativeIntegralMeasurableLocalEvalSigmaV1
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ν : Measure ℝ) [SigmaFinite ν]
    (N : LevyStochCalc.Poisson.PoissonRandomMeasure.{0, 0, 0} P ν)
    (R : Set (ℝ × ℝ)) (hRm : MeasurableSet R)
    (g : ℝ × ℝ → ℝ≥0∞) (hg : Measurable g)
    (hgR : ∀ z ∉ R, g z = 0) :
    Measurable[(⨆ C ∈ {C : Set (ℝ × ℝ) | C ⊆ R ∧ MeasurableSet C},
        MeasurableSpace.comap (fun ω => N.N ω C) inferInstance)]
      (fun ω => ∫⁻ z, g z ∂(N.N ω)) := by sorry
