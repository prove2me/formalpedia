section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 100000
set_option exponentiation.threshold 2048
open NLogN
open NLogN.KFY
open IntMul NLogN IntMul.OpenAI.Glue NLogN.GL NLogN.AX NLogN.Rsp
theorem solution : ∃ n₂, ∀ n, IntMul.OpenAI.Glue.n0 ≤ n → n₂ ≤ n → NLogN.KFY.NG n := by
  obtain ⟨n₂, H⟩ := NLogN.KFY.nf_exists
  refine ⟨n₂, fun n hn h2 => ?_⟩
  obtain ⟨-, -, hb8, hd1, hdb, h2L, hLb, -, -, -, hl1, -, -, -, -, hα4, -⟩ := IntMul.OpenAI.Glue.params_ok hn
  refine ⟨H n hn h2, by exact_mod_cast hα4, ?_, by exact_mod_cast IntMul.OpenAI.Glue.b_ge_d5 hn, ?_, hLb, ?_⟩
  · have hd0 : (0 : ℝ) < IntMul.OpenAI.Glue.dP n := by exact_mod_cast hd1
    rw [div_le_iff₀ (by positivity)] at hl1
    have h3 : ((IntMul.OpenAI.Glue.pP n : ℕ) : ℝ) ≤ ((IntMul.OpenAI.Glue.ℓP n * (12 * IntMul.OpenAI.Glue.dP n) : ℕ) : ℝ) := by push_cast; linarith
    have h4 := Nat.cast_le.1 h3
    unfold IntMul.OpenAI.Glue.pP at h4
    nlinarith
  · have h1 := IntMul.OpenAI.Glue.d_half hn
    have h2 := IntMul.OpenAI.Glue.beps_big hn
    have h3 : (2 : ℝ) ^ (13 : ℝ) ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 57) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
    have h4 : ((2 ^ 12 : ℕ) : ℝ) ≤ IntMul.OpenAI.Glue.dP n := by
      have : (2 : ℝ) ^ (13 : ℝ) = 2 ^ 13 := by norm_num
      push_cast; linarith
    exact_mod_cast h4
  · intro k hk
    have hdp : NLogN.KFM.dpN n ≤ IntMul.OpenAI.Glue.dP n := (NLogN.KFY.dpN_lt hn).le
    obtain ⟨-, -, hw⟩ := NLogN.KFM.srcS_ok_n hn (NLogN.KFM.dpN n) hdp
    have := (hw ⟨k, hk⟩).1
    rw [NLogN.KFY.tN_eq hn k hk]
    exact this
end
