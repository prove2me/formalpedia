theorem _root_.solution (g₀ g₁ g₂ : List ℤ) (k : ℕ) :
    (qrow g₀ g₁ g₂ k).length = 2 * k + 1 := by
  induction k with
  | zero => simp [qrow]
  | succ k ih =>
    simp only [qrow, qstep, radd_length, rscale_length, List.length_cons, ih]
    omega
end Sendov
