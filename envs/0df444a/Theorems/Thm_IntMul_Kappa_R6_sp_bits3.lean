theorem IntMul.Kappa.R6.sp_bits3 (s : IState HS) (f : Fin HS → List ℤ) (N dp : ℕ) (l25 l34 : List ℤ) (Aa Bb : ℕ)
    (h51 : f 51 = []) (h25 : f 25 = (N : ℤ) :: l25) (h34 : f 34 = (dp : ℤ) :: l34)
    (hNA : N ≤ Aa) (hdA : dp ≤ Aa) (hAa : 2 ≤ Aa) (hB : Aa ^ 6 < 2 ^ Bb) :
    Sp btR (encK s f) (encK s (update (update (update f 26 (bitL dp N ++ f 26))
      27 (bitL dp N ++ f 27)) 28 (bitL dp N ++ f 28))) ((N * 31 + 1) * kU Bb) := by sorry
