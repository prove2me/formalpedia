variable {σ : Type*}
lemma mem_support_mul' {p q : MvPolynomial σ ℝ} {s : σ →₀ ℕ} (hs : s ∈ (p * q).support) :
    ∃ u ∈ p.support, ∃ v ∈ q.support, u + v = s := by
  classical
  have := support_mul p q hs
  simpa [Finset.mem_add] using this

theorem degLE_mul (w : σ → ℕ) {a b : ℕ} {p q : MvPolynomial σ ℝ}
    (hp : DegLE w a p) (hq : DegLE w b q) : DegLE w (a + b) (p * q) := by
  intro s hs
  obtain ⟨u, hu, v, hv, rfl⟩ := mem_support_mul' hs
  rw [map_add]
  exact add_le_add (hp u hu) (hq v hv)

end SoSLinAlg.WeakRank.Dev.Leaf.PartA
