theorem norm_sq_le_of_radial_bound (F : E → E) (C : ℝ)
    (hbound : ∀ x, 2 * inner ℝ x (F x) ≤ C)
    {γ : ℝ → E} (hγ : ∀ t, HasDerivAt γ (F (γ t)) t)
