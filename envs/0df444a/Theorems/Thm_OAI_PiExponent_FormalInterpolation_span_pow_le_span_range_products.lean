-- title:
--   Powers of a finitely generated ideal are contained in the ideal of indexed products
-- statement:
--   For a finite family of generators, the kth power of the ideal they span is contained in the ideal generated by all products indexed by functions from `Fin k` into the generator indices.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.span_pow_le_span_range_products
    {d n k : Nat} (g : Fin n → MvPolynomial (Fin d) Complex) :
    (Ideal.span (Set.range g)) ^ k ≤
      Ideal.span (Set.range fun f : Fin k → Fin n => ∏ t : Fin k, g (f t)) := by sorry
