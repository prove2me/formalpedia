variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem NLogN.KFUU.p1U_runs {pM : Fin P} (hM : MulOK I iprog pM MS) {pS : Fin HS} (hpS : LS pS)
    (u cz : ℕ) (bs : List Bool) (hcz : 1 ≤ cz) (w : ℕ) (xs0 : List ℤ)
    (hxs : xs0.length = vol (shP u bs) * cz) (hx : Bnd w xs0) (Z : ℕ)
    (hVZ : zsz ((vol (shP u bs) * cz : ℕ) : ℤ) ≤ Z) (hZ2 : 2 ≤ Z) (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints xs0 ++ R) {RS LZ LU LN : List Item}
    (hpS0 : t.G pS = ints (zl (shP u bs)) ++ RS)
    (hZ : t.G rCZ = .int (cz : ℤ) :: LZ) (hU : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: LU)
    (hN : t.G nR = .int (bs.length : ℤ) :: LN) :
    IRuns I iprog (p1U pM pS) t
      (t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (lay1 (bgB bs) bs.length 0) xs0 0) ++ R))
      ((bs.length + 1) * (KFU.cMv (vol (shP u bs) * cz) w + 50 * cU Z)) := by sorry
