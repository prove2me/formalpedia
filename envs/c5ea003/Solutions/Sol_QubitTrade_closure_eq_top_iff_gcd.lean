/-!
# QUBIT-TRADE VI: the sample criterion is a generation criterion in `ZMod r`

The arithmetic criterion of `SampleFungibility.lean` — a record of Shor samples
`k₁, …, k_m` recovers the order `r` iff `gcd (gcd_i k_i, r) = 1` — is exactly a
*group-theoretic* statement about the cyclic group `ZMod r`:

  **a record recovers the order iff the sampled numerators generate `ZMod r`.**

* `QubitTrade.recovered_eq_addOrderOf` — one sample returns the additive order of
  `k` in `ZMod r`, i.e. the size of the subgroup it generates;
* `QubitTrade.recordGcd_mem_closure` — the joint gcd of a record lies in the
  subgroup generated by the record (Bézout, by induction along the list);
* `QubitTrade.closure_eq_top_iff_gcd` — the generation criterion;
* `QubitTrade.samples_recover_iff_generate` — the bridge: `recordEstimate ks r = r`
  iff the samples generate `ZMod r`.

So "qubit ↔ sample fungibility" is the statement that extra samples enlarge the
subgroup of `ZMod r` that the algorithm has seen, until it is everything; while
extra qubits (below the resolution threshold) enlarge nothing at all.
-/

open QubitTrade









open QubitTrade in
theorem solution{r : ℕ} (hr : 0 < r) (ks : List ℕ) :
    AddSubgroup.closure (recordImage ks r) = ⊤ ↔ Nat.gcd (recordGcd ks) r = 1 := by
  haveI : NeZero r := ⟨by omega⟩
  constructor
  · intro htop
    set g := Nat.gcd (recordGcd ks) r with hg
    have hgr : g ∣ r := Nat.gcd_dvd_right _ _
    have hsub : recordImage ks r ⊆ (AddSubgroup.zmultiples ((g : ZMod r)) : Set (ZMod r)) := by
      rintro x ⟨k, hk, rfl⟩
      have hgk : g ∣ k := (Nat.gcd_dvd_left _ _).trans (recordGcd_dvd_mem hk)
      obtain ⟨m, rfl⟩ := hgk
      exact ⟨(m : ℤ), by push_cast [zsmul_eq_mul]; ring⟩
    have hle : AddSubgroup.closure (recordImage ks r) ≤ AddSubgroup.zmultiples ((g : ZMod r)) :=
      (AddSubgroup.closure_le _).mpr hsub
    rw [htop] at hle
    obtain ⟨n, hn⟩ := hle (show (1 : ZMod r) ∈ (⊤ : AddSubgroup (ZMod r)) by trivial)
    have hz : ((n * (g : ℤ) - 1 : ℤ) : ZMod r) = 0 := by
      push_cast [zsmul_eq_mul] at hn ⊢
      rw [← hn]; ring
    have hdvd : (r : ℤ) ∣ n * (g : ℤ) - 1 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ r).mp hz
    have hgz : (g : ℤ) ∣ (r : ℤ) := Int.natCast_dvd_natCast.mpr hgr
    have hng : (g : ℤ) ∣ n * (g : ℤ) := ⟨n, by ring⟩
    have h1 : (g : ℤ) ∣ 1 := by
      have hsubd := dvd_sub hng (hgz.trans hdvd)
      rwa [show n * (g : ℤ) - (n * (g : ℤ) - 1) = 1 by ring] at hsubd
    have : (g : ℤ) = 1 := Int.eq_one_of_dvd_one (by positivity) h1
    exact_mod_cast this
  · intro hgcd
    have hb : (1 : ℤ) = (recordGcd ks : ℤ) * Nat.gcdA (recordGcd ks) r
        + (r : ℤ) * Nat.gcdB (recordGcd ks) r := by
      have h := Nat.gcd_eq_gcd_ab (recordGcd ks) r
      rw [hgcd] at h
      exact_mod_cast h
    have hA : (Nat.gcdA (recordGcd ks) r) • (((recordGcd ks : ℕ)) : ZMod r) = (1 : ZMod r) := by
      have hcast : ((1 : ℤ) : ZMod r) =
          (((recordGcd ks : ℤ) * Nat.gcdA (recordGcd ks) r
            + (r : ℤ) * Nat.gcdB (recordGcd ks) r : ℤ) : ZMod r) := by rw [← hb]
      push_cast [zsmul_eq_mul] at hcast ⊢
      rw [hcast]
      simp
      ring
    have hone : (1 : ZMod r) ∈ AddSubgroup.closure (recordImage ks r) := by
      rw [← hA]
      exact AddSubgroup.zsmul_mem _ (recordGcd_mem_closure ks r) _
    refine (AddSubgroup.eq_top_iff' _).mpr (fun x => ?_)
    have hx : x = (x.val : ℕ) • (1 : ZMod r) := by
      simp [nsmul_eq_mul, ZMod.natCast_val, ZMod.cast_id]
    rw [hx]
    exact nsmul_mem hone _
