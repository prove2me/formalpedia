/-! ### Semantics -/

/-- The conclusion of the cover lemma for the pattern `(A, B)`. -/
def Concl (A B : ℕ) : Prop :=
  ∃ (e : ℕ) (x : ℕ × ℕ) (k : ℕ) (di dj : ℤ), nogoods[e]? = some x ∧ k < 8 ∧ PlacedIn x k di dj A B

theorem mpi_mono {k : ℕ} {di dj : ℤ} {m M M' : ℕ} (h : MaskPlacedIn k di dj m M)
    (hM : ∀ c, c < 25 → M.testBit c = true → M'.testBit c = true) : MaskPlacedIn k di dj m M' := by
  intro c hc hm
  obtain ⟨h1, h2, h3, h4, h5⟩ := h c hc hm
  exact ⟨h1, h2, h3, h4, hM _ (by omega) h5⟩

theorem Concl.mono {A B A' B' : ℕ} (h : Concl A B)
    (hA : ∀ c, c < 25 → A.testBit c = true → A'.testBit c = true)
    (hB : ∀ c, c < 25 → B.testBit c = true → B'.testBit c = true) : Concl A' B' := by
  obtain ⟨e, x, k, di, dj, h1, h2, h3, h4⟩ := h
  exact ⟨e, x, k, di, dj, h1, h2, mpi_mono h3 hA, mpi_mono h4 hB⟩

/-- The pattern word `w` contains a placed pattern of the library. -/
def GoodW (w : ℕ) : Prop := Concl (w % 2 ^ 25) (w / 2 ^ 25)

/-- Field `i` (50 bits) of a table. -/
def fld (G i : ℕ) : ℕ := G / 2 ^ (50 * i) % 2 ^ 50

/-- Every nonzero field of the table is a good pattern word. -/
def GTValid (G : ℕ) : Prop := ∀ i, fld G i ≠ 0 → GoodW (fld G i)

/-- Every mark `j` of `Y` points to the cells outside `msk` of a good pattern word accepted by `chk`. -/
def BInv (chk : ℕ → ℕ → Bool) (msk T Y : ℕ) : Prop :=
  ∀ j, Y.testBit j = true → ∃ w, GoodW w ∧ chk (w % 2 ^ 25) (w / 2 ^ 25) = true ∧
    ∀ c, c < 25 → T.testBit (j + c) = (w.testBit c && !msk.testBit c)

