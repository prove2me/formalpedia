def seedRelator : Bool → FreeGroup Bool
  | false => FreeGroup.of false ^ 2 * (FreeGroup.of true ^ 5)⁻¹
  | true => FreeGroup.of false ^ 2 * ((FreeGroup.of false * (FreeGroup.of true)⁻¹) ^ 3)⁻¹

