        LAK.IsTorsionPoint (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) (ℓ ^ v) x →
          Spec.map (CommRingCat.ofHom (σ : Ω →+* Ω)) ≫ x.1 = x.1) :
    ∃ (𝒜 : Scheme.{u}) (f𝒜 : 𝒜 ⟶ Spec (CommRingCat.of R)) (L𝒜 : RelativeGroupLaw R f𝒜)
