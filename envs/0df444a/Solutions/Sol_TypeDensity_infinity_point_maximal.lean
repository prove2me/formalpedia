theorem solution (O R : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R] (S : TypeDensity.SurfaceData O R) :
    (TypeDensity.infinityPoint R S.t S.x).IsMaximal ∧ TypeDensity.chartBase R S.x S.t S.x ∈ TypeDensity.infinityPoint R S.t S.x ∧
    TypeDensity.chartSlope R S.x S.t ∈ TypeDensity.infinityPoint R S.t S.x ∧ Module.length R
    (TypeDensity.BlowupChart R S.x S.t ⧸ TypeDensity.infinityPoint R S.t S.x) = 1 := by
  have hker : ∃ φ : TypeDensity.BlowupChart R S.x S.t →+* IsLocalRing.ResidueField R,
      (∀ r, φ (TypeDensity.chartBase R S.x S.t r) = IsLocalRing.residue R r) ∧
      φ (TypeDensity.chartSlope R S.x S.t) = 0 ∧ RingHom.ker φ = TypeDensity.infinityPoint R S.t S.x := by
    have hx : IsLocalRing.residue R S.x = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, ← S.parameters]
      exact Ideal.subset_span (by simp)
    have ht : IsLocalRing.residue R S.t = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, ← S.parameters]
      exact Ideal.subset_span (by simp)
    let ψ : Polynomial R →+* IsLocalRing.ResidueField R :=
      Polynomial.eval₂RingHom (IsLocalRing.residue R) 0
    have hψ : Ideal.span {TypeDensity.blowupRelation R S.x S.t} ≤ RingHom.ker ψ := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      simp [ψ, TypeDensity.blowupRelation, ht]
    refine ⟨Ideal.Quotient.lift _ ψ fun a ha ↦ hψ ha, fun r ↦ ?_, ?_, ?_⟩
    · change ψ (Polynomial.C r) = _
      simp [ψ]
    · change ψ Polynomial.X = _
      simp [ψ]
    · ext b
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
      have hrel := TypeDensity.blowup_chart_relation R S.x S.t
      have hI_x : TypeDensity.chartBase R S.x S.t S.x ∈ TypeDensity.infinityPoint R S.t S.x := Ideal.subset_span (by simp)
      have hI_W : TypeDensity.chartSlope R S.x S.t ∈ TypeDensity.infinityPoint R S.t S.x := Ideal.subset_span (by simp)
      have hI_t : TypeDensity.chartBase R S.x S.t S.t ∈ TypeDensity.infinityPoint R S.t S.x := by
        rw [← hrel]; exact Ideal.mul_mem_right _ _ hI_x
      have hp := Polynomial.divX_mul_X_add p
      have hmk : Ideal.Quotient.mk (Ideal.span {TypeDensity.blowupRelation R S.x S.t}) p =
          Ideal.Quotient.mk (Ideal.span {TypeDensity.blowupRelation R S.x S.t}) (p.divX) * TypeDensity.chartSlope R S.x S.t
          + TypeDensity.chartBase R S.x S.t (p.coeff 0) := by
        conv_lhs => rw [← hp]
        simp [TypeDensity.chartSlope, TypeDensity.chartBase]
      have hψp : ψ p = IsLocalRing.residue R (p.coeff 0) := by
        simp [ψ, Polynomial.eval₂_at_zero]
      simp only [RingHom.mem_ker]
      change ψ p = 0 ↔ _
      refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
      · rw [hψp, IsLocalRing.residue_eq_zero_iff, ← S.parameters] at h
        rw [hmk]
        refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ hI_W) ?_
        have : Ideal.map (TypeDensity.chartBase R S.x S.t) (Ideal.span {S.t, S.x}) ≤
            TypeDensity.infinityPoint R S.t S.x := by
          rw [Ideal.map_span, Ideal.span_le]
          rintro _ ⟨y, hy, rfl⟩
          rcases hy with rfl | rfl
          · exact hI_t
          · exact hI_x
        exact this (Ideal.mem_map_of_mem _ h)
      · have hle : TypeDensity.infinityPoint R S.t S.x ≤
            RingHom.ker (Ideal.Quotient.lift _ ψ fun a ha ↦ hψ ha) := by
          rw [TypeDensity.infinityPoint, Ideal.span_le]
          rintro _ (rfl | rfl)
          · change ψ (Polynomial.C S.x) = 0
            simpa [ψ] using hx
          · change ψ Polynomial.X = 0
            simp [ψ]
        exact hle h
  obtain ⟨φ, hφ1, hφ2, hφk⟩ := hker
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨TypeDensity.chartBase R S.x S.t r, hφ1 r⟩
  have hmax : (TypeDensity.infinityPoint R S.t S.x).IsMaximal := by
    rw [← hφk]; exact RingHom.ker_isMaximal_of_surjective φ hsurj
  refine ⟨hmax, Ideal.subset_span (by simp), Ideal.subset_span (by simp), ?_⟩
  let e0 : (TypeDensity.BlowupChart R S.x S.t ⧸ TypeDensity.infinityPoint R S.t S.x) ≃+* IsLocalRing.ResidueField R :=
    (Ideal.quotEquivOfEq hφk.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  rw [(AlgEquiv.ofRingEquiv (R := R) (f := e0) fun r ↦ hφ1 r).toLinearEquiv.length_eq,
    TypeDensity.length_eq_of_surjective_onto_field R _ _ (IsLocalRing.residue R)
      IsLocalRing.residue_surjective fun r m ↦ rfl]
  simp
