/-- A chunk at a lower stride (`S = S' Q' m`) is unchanged. -/
theorem gc_sc_lo {Q S Q' S' m : ℕ} (hS' : 0 < S') (hS : S = S' * Q' * m) (v n : ℕ) :
    NLogN.KFL.gc Q' S' (NLogN.KFL.sc Q S v n) = NLogN.KFL.gc Q' S' n := by
  unfold NLogN.KFL.gc NLogN.KFL.sc
