-- title:
--   Controlled Markov process, admissible histories, and history-dependent policies
-- statement:
--   A controlled Markov process has a Borel state space $E$, a Borel action space $A$, a Borel admissible graph $D\subseteq E\times A$, and a transition probability kernel $Q(\cdot\mid x,a)$ for $(x,a)\in D$. Every action set $D(x)=\{a:(x,a)\in D\}$ is nonempty.
--
--   A history through stage $n$ records the prior state-action pairs and the current state. A history-dependent policy is an infinite sequence of measurable rules $g_n$, each choosing an action in $D(x_n)$ from the history available at stage $n$.
--
--   $$H_n=D^n\times E,\qquad \Pi=\{(g_n)_{n\ge0}:g_n(h_n)\in D(x_n)\text{ and }g_n\text{ is measurable}\}. $$
--
--   This process and policy layer can be reused with a different cost criterion. **Formalization Note** A history is a chronological finite list and its terminal state. Rules are defined on all finite lists; only admissible lists of the matching stage length occur in a trajectory. The kernel is total in Lean, but only its values on $D$ are used.
-- source:
--   Bäuerle & Rieder, More Risk-Sensitive Markov Decision Processes, authors' manuscript (KIT repository 1000039663; published Math. Oper. Res. 39(1):105–120, 2014), p. 3, §2

import Mathlib

open MeasureTheory ProbabilityTheory Filter

namespace RiskSensMDP.Discounted

/-- The controlled state process of §2, p. 3, before a utility or cost criterion is chosen.
The transition kernel is specified on all pairs but only its values on `D` are used. -/
structure ControlledMDP (E A : Type*) [MeasurableSpace E] [MeasurableSpace A] where
  D : Set (E × A)
  measurable_D : MeasurableSet D
  nonempty_D : ∀ x : E, {a : A | (x, a) ∈ D}.Nonempty
  Q : Kernel (E × A) E
  markov_Q : IsMarkovKernel Q

variable {E A : Type*} [MeasurableSpace E] [MeasurableSpace A]

/-- The measurable structure generated by every coordinate of a finite list. -/
instance : MeasurableSpace (Option (E × A)) :=
  MeasurableSpace.generateFrom
    ({s : Set (Option (E × A)) | s = {none} ∨
      ∃ t : Set (E × A), MeasurableSet t ∧ s = Option.some '' t})

instance : MeasurableSpace (List (E × A)) :=
  MeasurableSpace.comap (fun l : List (E × A) => fun n : ℕ => l[n]?) inferInstance

/-- The section `D(x)` of the admissible state-action graph (§2, p. 3). -/
def ControlledMDP.actions (P : ControlledMDP E A) (x : E) : Set A :=
  {a | (x, a) ∈ P.D}

/-- A finite state-action history ending in the current state. The list records the
earlier pairs in chronological order; it is `Dⁿ × E` along admissible paths. -/
abbrev History (E A : Type*) := List (E × A) × E

/-- The paper's stage-`n` history space `Hₙ=Dⁿ×E`, as a subset of finite lists. -/
def ValidHistory (P : ControlledMDP E A) (n : ℕ)
    (h : History E A) : Prop :=
  h.1.length = n ∧ ∀ p ∈ h.1, p ∈ P.D

/-- The paper's infinite sequence of measurable, admissible history rules (§2, p. 3).
Rules are represented by total functions, with requirements only on `Hₙ`. -/
structure Policy (P : ControlledMDP E A) where
  g : ℕ → History E A → A
  measurable_g : ∀ n,
    Measurable (fun h : {h : History E A // ValidHistory P n h} => g n h.1)
  admissible_g : ∀ n h, ValidHistory P n h → (h.2, g n h) ∈ P.D

end RiskSensMDP.Discounted


