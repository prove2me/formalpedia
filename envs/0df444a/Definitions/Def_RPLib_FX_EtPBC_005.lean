theorem etale_as (A0 B : Type) [CommRing A0] [CommRing B] [Algebra A0 B] [Algebra.Etale A0 B] {As Bt : Type}
    [CommRing As] [CommRing Bt] [Algebra A0 As] (s : A0) [IsLocalization.Away s As] [Algebra B Bt]
    [IsLocalization.Away (algebraMap A0 B s) Bt] [Algebra As Bt] [Algebra A0 Bt] [IsScalarTower A0 As Bt]
    [IsScalarTower A0 B Bt] : Etale (Spec.map (CommRingCat.ofHom (algebraMap As Bt))) := by
  have h1 : Algebra.Etale B Bt := Algebra.Etale.of_isLocalizationAway (algebraMap A0 B s)
  have h2 : Algebra.Etale A0 Bt := Algebra.Etale.comp A0 B Bt
  have h3 : Algebra.Etale A0 As := Algebra.Etale.of_isLocalizationAway s
  have h4 : Algebra.Etale As Bt := Algebra.Etale.of_restrictScalars A0 As Bt
  exact (HasRingHomProperty.Spec_iff (P := @Etale)).2 (RingHom.etale_algebraMap.2 h4)

theorem map_genPt_of_injective {R S : Type} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S] (f : R →+* S)
