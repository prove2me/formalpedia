/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA7a2: the `B'`-side of the induction step

**`bSide`**: let `z` be a power-series solution over `K[[x']]` of the coefficient system `eqsys` of `h` and
`g = δ·G` (`δ` the polynomial Tougeron minor of `h` at `U`) for a division by a generic monic `P` of degree
`d > 0`, with residues `z(P-coefficients) = 0`, `z(R_i,0) = c_i` and `V(0) ≠ 0`. If `AA n` holds and
`G·f_j ∈ (h)`, then `f` has a solution in an etale neighbourhood of the origin of `K[x_0..x_n]` with residues `c`.
Proof: `AA n` solves `eqsys` in `B'`; over `S = B'[X]` the specialisations `P̄`, `R̄` satisfy `P̄⁴ ∣ h(R̄)` and
`δ(R̄)G(R̄) = P̄·V̄`; `finish_step` and `SolNbhd.trans_ringHom` along `K[x_0..x_n] → B'[X]`.
-/

set_option autoImplicit false

noncomputable section

open Polynomial

namespace RamanujanPetersson.EtPBC.Cov

universe u

section BSide

variable {K : Type u} [Field K]

theorem bSide {n N m r : ℕ} (hA : AA K n) (f : Fin m → MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K))
    (h : Fin r → MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) (U : Fin r → Fin N)
    (G : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) (hGf : ∀ j, G * f j ∈ Ideal.span (Set.range h))
    (c : Fin N → K) {d : ℕ} (hd : 0 < d) (z : Unk d N (4 * d) → MvPowerSeries (Fin n) K)
    (hz : ∀ e, MvPolynomial.aeval z
      (eqsys (theta1 K n) h ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) d e) = 0)
    (hzP : ∀ l, MvPowerSeries.constantCoeff (z (Sum.inl l)) = 0)
    (hzR : ∀ i (k : Fin (4 * d)), (k : ℕ) = 0 → MvPowerSeries.constantCoeff (z (Sum.inr (i, k))) = c i)
    (hzV : MvPowerSeries.constantCoeff ((evS (theta1 K n) _
      ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz z) /ₘ Pz z).coeff 0) ≠ 0) :
    SolNbhd (MvPolynomial.constantCoeff : MvPolynomial (Fin (n + 1)) K →+* K) f c := by
  classical
  obtain ⟨B', i1, i2, i3, χ', zb, hχ', hzb, hres⟩ := hA.apply_fintype _ z hz
  have hm : (Pz zb).Monic := mkP_monic d _
  obtain ⟨hdh, hdg⟩ := dvd_of_eqsys_vanish (theta1 K n) h
    ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) zb hzb
  choose W hW using fun j => dvd_iff_exists_eq_mul_right.mp (hdh j)
  have hgV : evS (theta1 K n) B' ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz zb) =
      Pz zb * (evS (theta1 K n) B' ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz zb) /ₘ
        Pz zb) := by
    have h0 := modByMonic_add_div
      (evS (theta1 K n) B' ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz zb)) (Pz zb)
    rw [(modByMonic_eq_zero_iff_dvd hm).mpr hdg, zero_add] at h0
    exact h0.symm
  have hP0 : Polynomial.eval₂RingHom χ' 0 (Pz zb) = 0 := by
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_at_zero, mkP_coeff_zero hd, hres, hzP]
  have hB : ∀ b, χ' (algebraMap (MvPolynomial (Fin n) K) B' b) =
      MvPowerSeries.constantCoeff (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K) b) := fun b => by
    rw [hχ', cc_coe]
  have key := Polynomial.ext_iff.mp (map_point zb z χ' MvPowerSeries.constantCoeff hB hres
    ((evS (theta1 K n) _ ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G)
      (genR (MvPolynomial (Fin n) K) d N (4 * d))) /ₘ genP (MvPolynomial (Fin n) K) d N (4 * d))) 0
  rw [genV_map, genV_map, Polynomial.coeff_map, Polynomial.coeff_map] at key
  have hV : Polynomial.eval₂RingHom χ' 0 (evS (theta1 K n) B'
      ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz zb) /ₘ Pz zb) ≠ 0 := by
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_at_zero, key]
    exact hzV
  have hGf' : ∀ j, MvPolynomial.map (thetaS (theta1 K n) B') G * MvPolynomial.map (thetaS (theta1 K n) B') (f j) ∈
      Ideal.span (Set.range fun j => MvPolynomial.map (thetaS (theta1 K n) B') (h j)) := fun j => by
    rw [← map_mul]
    have h5 := Ideal.mem_map_of_mem (MvPolynomial.map (thetaS (theta1 K n) B')) (hGf j)
    rw [Ideal.map_span, ← Set.range_comp] at h5
    exact h5
  have hW' : ∀ j, MvPolynomial.eval (Rz zb) (MvPolynomial.map (thetaS (theta1 K n) B') (h j)) =
      Pz zb ^ 4 * W j := fun j => (MvPolynomial.eval_map _ _ _).trans (hW j)
  have hgV' : (tmin (fun j => MvPolynomial.map (thetaS (theta1 K n) B') (h j)) U (Rz zb)).det *
      MvPolynomial.eval (Rz zb) (MvPolynomial.map (thetaS (theta1 K n) B') G) =
        Pz zb * (evS (theta1 K n) B' ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G) (Rz zb) /ₘ
          Pz zb) := by
    rw [tmin_evS, MvPolynomial.eval_map]
    unfold evS at hgV ⊢
    rw [← MvPolynomial.eval₂_mul]
    exact hgV
  have hfin := finish_step (Polynomial.eval₂RingHom χ' 0)
    (fun j => MvPolynomial.map (thetaS (theta1 K n) B') (f j))
    (fun j => MvPolynomial.map (thetaS (theta1 K n) B') (h j)) U
    (MvPolynomial.map (thetaS (theta1 K n) B') G) hGf' (Rz zb) (Pz zb) _ W hm.mem_nonZeroDivisors hP0 hV hW' hgV'
  have hT := SolNbhd.trans_ringHom (thetaS (theta1 K n) B') etale_thetaS (point_thetaS χ' hχ') hfin
  have h4d : 0 < 4 * d := by omega
  have hc : (fun i => Polynomial.eval₂RingHom χ' 0 (Rz zb i)) = c := funext fun i => by
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_at_zero, mkR_coeff_zero h4d, hres, hzR i ⟨0, h4d⟩ rfl]
  rw [hc] at hT
  exact hT

end BSide

