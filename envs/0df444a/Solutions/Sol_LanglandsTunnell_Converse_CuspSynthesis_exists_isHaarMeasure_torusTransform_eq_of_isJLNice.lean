attribute [local instance] NumberField.Idele.ideleBorel NumberField.Idele.borelSpace_ideleBorel
  NumberField.Idele.isHaarMeasure_idelicHaar

variable {K : Type} [Field K] [NumberField K] {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}
  {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ}
  (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

omit archR archC dR dC in

private theorem t0478 (dF : FinWhittakerDatum K S Pi) (z : (AdeleRing (𝓞 K) K)ˣ)
    (y : AdelicGL2 (𝓞 K) K) : dF.Wf (diagOne (d018 K S z) * y) = dF.Wf y := by
  unfold d018
  refine (Finset.prod_induction (fun v : ↥S => d004 v.1 (unitAt v.1 z))
    (fun t : (AdeleRing (𝓞 K) K)ˣ => ∀ y' : AdelicGL2 (𝓞 K) K, dF.Wf (diagOne t * y') = dF.Wf y') ?_ ?_ ?_) y
  · intro a b ha hb y'
    rw [map_mul, mul_assoc, ha, hb]
  · intro y'
    rw [map_one, one_mul]
  · intro v _ y'
    rw [FiniteWhittaker.t0392]
    exact t0245 dF v.2 _ _

private theorem t0479 {t : (AdeleRing (𝓞 K) K)ˣ}
    (ht : ((t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1) (y : AdelicGL2 (𝓞 K) K) :
    archW' archR archC dR dC (diagOne t * y) = archW' archR archC dR dC y :=
  t0125 archR archC dR dC
    (fun w hw => by
      rw [t0142, t0142, map_mul, FiniteWhittaker.t0353 ht,
        one_mul])
    (fun w hw => by
      rw [t0143, t0143, map_mul,
        FiniteWhittaker.t0353 ht, one_mul])

omit archR archC dR dC in

private theorem t0480 (z : (AdeleRing (𝓞 K) K)ˣ) :
    ((d018 K S z : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1 := by
  unfold d018
  refine Finset.prod_induction (fun v : ↥S => d004 v.1 (unitAt v.1 z))
    (fun t : (AdeleRing (𝓞 K) K)ˣ => ((t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1) ?_ ?_ ?_
  · intro a b ha hb
    rw [Units.val_mul]
    exact (show ((a : AdeleRing (𝓞 K) K) * (b : AdeleRing (𝓞 K) K)).1 =
        (a : AdeleRing (𝓞 K) K).1 * (b : AdeleRing (𝓞 K) K).1 from rfl).trans (by rw [ha, hb, one_mul])
  · rfl
  · intro v _
    exact funext (t0033 v.1 _)

omit archR archC dR dC in

private theorem t0481 (z : (AdeleRing (𝓞 K) K)ˣ) : d018 K S z * stripS K S z = z := by
  rw [mul_comm]
  exact inv_mul_cancel_right z (d018 K S z)

omit archR archC dR dC in

private theorem t0482 {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) (z : (AdeleRing (𝓞 K) K)ˣ) :
    unitAt v (d018 K S z) = unitAt v z := by
  have h : (⟨⟨unitAt v, unitAt_one v⟩, unitAt_mul v⟩ : (AdeleRing (𝓞 K) K)ˣ →* (v.adicCompletion K)ˣ)
      (d018 K S z) = ∏ w : ↥S, unitAt v (d004 w.1 (unitAt w.1 z)) :=
    map_prod _ _ _
  rw [show unitAt v (d018 K S z) = ∏ w : ↥S, unitAt v (d004 w.1 (unitAt w.1 z)) from h,
    Finset.prod_eq_single ⟨v, hv⟩]
  · exact Units.ext (t0034 v _)
  · intro w _ hw
    have hwv : v ≠ w.1 := fun h' => hw (Subtype.ext h'.symm)
    exact Units.ext (t0035 w.1 _ hwv)
  · intro h'
    exact absurd (Finset.mem_univ _) h'

omit archR archC dR dC in

private theorem t0483 {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) (z : (AdeleRing (𝓞 K) K)ˣ) :
    unitAt v (stripS K S z) = 1 := by
  show unitAt v (z * (d018 K S z)⁻¹) = 1
  rw [unitAt_mul, unitAt_inv, t0482 hv, mul_inv_cancel]

omit archR archC dR dC in

private theorem t0484 (z : (AdeleRing (𝓞 K) K)ˣ) : stripS K S z ∈ d020 S := by
  rw [t0262, t0137]
  intro v
  rw [t0483 v.2, Units.val_one, map_one]

private theorem t0485 (dF : FinWhittakerDatum K S Pi) (r : Kˣ) (g : AdelicGL2 (𝓞 K) K)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) (z : (AdeleRing (𝓞 K) K)ˣ) :
    d043 archR archC dR dC epsS dF 1 g μ s
        (z * stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) =
      ((μ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) : ℂˣ) : ℂ) *
          ((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r))
            : ℝ) : ℂ) ^ s *
        d043 archR archC dR dC epsS dF r g μ s z := by
  have hpt : diagOne z * (globalPoints (𝓞 K) K (diagOne r) * g) =
      diagOne (d018 K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) *
        (diagOne (z * stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) *
          (globalPoints (𝓞 K) K (diagOne 1) * g)) := by
    rw [map_one, map_one, one_mul, FiniteWhittaker.t0098, ← mul_assoc (diagOne z), ← map_mul,
      ← mul_assoc, ← map_mul,
      mul_left_comm (d018 K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)),
      t0481]
  have hε :
      d017 S epsS (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) = 1 :=
    t0251 S epsS fun v hv => by
      rw [← t0051, t0483 hv, Units.val_one]
  unfold d043
  rw [hpt,
    t0479 archR archC dR dC
      (t0480 (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)),
    t0478 dF,
    map_mul μ, map_mul (d017 S epsS), hε, mul_one, Units.val_mul, ideleNorm_mul, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (ideleNorm_pos _).le (ideleNorm_pos _).le]
  ring

omit archR archC dR dC in

private theorem t0486 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (G : (AdeleRing (𝓞 K) K)ˣ → E) {c : (AdeleRing (𝓞 K) K)ˣ}
    (hc : c ∈ d020 S) :
    ∫ z in d020 S, G (z * c) ∂(NumberField.Idele.idelicHaar K) =
      ∫ z in d020 S, G z ∂(NumberField.Idele.idelicHaar K) := by
  have hmeas : MeasurableSet (d020 (K := K) S) := (t0263 S).measurableSet
  have hind : (d020 S).indicator (fun z => G (z * c)) = fun z => (d020 S).indicator G (z * c) := by
    funext z
    classical
    simp only [Set.indicator_apply]
    by_cases hz : z ∈ d020 S
    · rw [if_pos hz, if_pos (t0262.2 ((unitIdelesAt S).mul_mem (t0262.1 hz)
        (t0262.1 hc)))]
    · have hz' : z * c ∉ d020 S := fun h => hz (t0262.2 (by
        have h2 := (unitIdelesAt S).mul_mem (t0262.1 h) ((unitIdelesAt S).inv_mem
          (t0262.1 hc))
        rwa [mul_inv_cancel_right] at h2))
      rw [if_neg hz, if_neg hz']
  rw [← integral_indicator hmeas, ← integral_indicator hmeas, hind]
  exact integral_mul_right_eq_self _ c

omit archR archC dR dC in

private theorem t0487 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {E : Type} [NormedAddCommGroup E] {G : (AdeleRing (𝓞 K) K)ˣ → E} {c : (AdeleRing (𝓞 K) K)ˣ}
    (hc : c ∈ d020 S)
    (hG : IntegrableOn G (d020 S) (NumberField.Idele.idelicHaar K)) :
    IntegrableOn (fun z => G (z * c)) (d020 S) (NumberField.Idele.idelicHaar K) := by
  have hmeas : MeasurableSet (d020 (K := K) S) := (t0263 S).measurableSet
  have hind : (d020 S).indicator (fun z => G (z * c)) = fun z => (d020 S).indicator G (z * c) := by
    funext z
    classical
    simp only [Set.indicator_apply]
    by_cases hz : z ∈ d020 S
    · rw [if_pos hz, if_pos (t0262.2 ((unitIdelesAt S).mul_mem (t0262.1 hz)
        (t0262.1 hc)))]
    · have hz' : z * c ∉ d020 S := fun h => hz (t0262.2 (by
        have h2 := (unitIdelesAt S).mul_mem (t0262.1 h) ((unitIdelesAt S).inv_mem
          (t0262.1 hc))
        rwa [mul_inv_cancel_right] at h2))
      rw [if_neg hz, if_neg hz']
  rw [← integrable_indicator_iff hmeas] at hG ⊢
  rw [hind]
  exact hG.comp_mul_right c

private theorem t0488 (dF : FinWhittakerDatum K S Pi) (r : Kˣ) (g : AdelicGL2 (𝓞 K) K)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
    ∫ z in d020 S, d043 archR archC dR dC epsS dF 1 g μ s z ∂(NumberField.Idele.idelicHaar K) =
      ((μ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) : ℂˣ) : ℂ) *
          ((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r))
            : ℝ) : ℂ) ^ s *
        ∫ z in d020 S, d043 archR archC dR dC epsS dF r g μ s z ∂(NumberField.Idele.idelicHaar K) := by
  rw [← t0486 S (d043 archR archC dR dC epsS dF 1 g μ s)
    (t0484 (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r))]
  simp only [t0485 archR archC dR dC dF r g μ s]
  exact integral_const_mul _ _

private theorem t0489 (dF : FinWhittakerDatum K S Pi) (r : Kˣ) (g : AdelicGL2 (𝓞 K) K)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ)
    (h1 : IntegrableOn (d043 archR archC dR dC epsS dF 1 g μ s) (d020 S)
      (NumberField.Idele.idelicHaar K)) :
    IntegrableOn (d043 archR archC dR dC epsS dF r g μ s) (d020 S)
      (NumberField.Idele.idelicHaar K) := by
  set c : (AdeleRing (𝓞 K) K)ˣ :=
    stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r) with hc
  have hK : ((μ c : ℂˣ) : ℂ) * ((ideleNorm K c : ℝ) : ℂ) ^ s ≠ 0 :=
    mul_ne_zero (Units.ne_zero _) fun h =>
      Complex.ofReal_ne_zero.2 (ideleNorm_pos c).ne' ((Complex.cpow_eq_zero_iff _ _).1 h).1
  have h2 : IntegrableOn (fun z => ((μ c : ℂˣ) : ℂ) * ((ideleNorm K c : ℝ) : ℂ) ^ s *
      d043 archR archC dR dC epsS dF r g μ s z) (d020 S) (NumberField.Idele.idelicHaar K) := by
    have h := t0487 S (t0484
      (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) h1
    simp only [t0485 archR archC dR dC dF r g μ s] at h
    exact h
  have h3 := h2.const_mul ((((μ c : ℂˣ) : ℂ) * ((ideleNorm K c : ℝ) : ℂ) ^ s)⁻¹)
  refine h3.congr (Filter.Eventually.of_forall fun z => ?_)
  show ((((μ c : ℂˣ) : ℂ) * ((ideleNorm K c : ℝ) : ℂ) ^ s)⁻¹ *
      (((μ c : ℂˣ) : ℂ) * ((ideleNorm K c : ℝ) : ℂ) ^ s * d043 archR archC dR dC epsS dF r g μ s z)) =
    d043 archR archC dR dC epsS dF r g μ s z
  rw [← mul_assoc, inv_mul_cancel₀ hK, one_mul]

