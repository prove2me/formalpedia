-- url     : https://prove2.me/theorems/ce1b46c0-c5dd-4e65-930d-5e0efcc2eef5
-- title:
--   AMP orbit with the Onsager memory term, Definitions 2–3 and (1.4)–(1.6)
-- statement:
--   For a symmetric matrix $A$ with zero diagonal, a family of coordinate polynomial maps $f^i(\cdot;t)$, and initial vectors $x_i^0$, the AMP orbit is generated by
--
--   $$x_i^{t+1}=\sum_j A_{ij}f^j(x_j^t;t)-\sum_j A_{ij}^2 Jf^j(x_j^t;t)f^i(x_i^{t-1};t-1).$$
--
--   The memory term is absent at $t=0$. The definition stores the current and preceding iterates together, so the update uses the actual squared entries $A_{ij}^2$ and the preceding polynomial map.
-- source:
--   Bayati, Lelarge and Montanari, Universality in polytope phase transitions and message passing algorithms, arXiv:1207.7321v2, pp. 6–7, Definitions 2–3, (1.4)–(1.6)

import Definitions.Def_AMPUniversality_StateEvol_Poly
import Definitions.Def_AMPUniversality_Universal_Orbit

set_option autoImplicit false

namespace AMPUniversality.StateEvol

/-- One AMP update with the Onsager term suppressed at time zero. -/
def ampStep {N q d : ℕ} (A : Matrix (Fin N) (Fin N) ℝ)
    (c : Fin N → ℕ → Fin q → (Fin q → Fin (d + 1)) → ℝ)
    (x prev : Fin N → Fin q → ℝ) (t : ℕ) : Fin N → Fin q → ℝ :=
  fun i r =>
    (∑ j, A i j * polyEval (c j t) (x j) r) -
    (if t = 0 then 0 else
      ∑ j, (A i j) ^ 2 *
        ∑ s, polyJac (c j t) (x j) r s *
          polyEval (c i (t - 1)) (prev i) s)

/-- The state carries the current and preceding AMP iterates. -/
def ampState {N q d : ℕ} (A : Matrix (Fin N) (Fin N) ℝ)
    (c : Fin N → ℕ → Fin q → (Fin q → Fin (d + 1)) → ℝ)
    (x0 : Fin N → Fin q → ℝ) :
    ℕ → (Fin N → Fin q → ℝ) × (Fin N → Fin q → ℝ)
  | 0 => (x0, 0)
  | t + 1 =>
      let st := ampState A c x0 t
      (ampStep A c st.1 st.2 t, st.1)

end AMPUniversality.StateEvol


