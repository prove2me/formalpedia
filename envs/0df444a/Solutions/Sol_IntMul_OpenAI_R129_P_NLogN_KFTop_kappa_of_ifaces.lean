theorem n0_ge3 {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 3 ≤ n := by
  have hb := (setup_facts hn).1
  by_contra h; push Not at h
  have : Nat.clog 2 n ≤ 1 := Nat.clog_le_of_le_pow (by omega)
  have e : bP n = max (Nat.clog 2 n) 1 := rfl
  omega

set_option maxHeartbeats 4000000 in
theorem setP_runs (x y : List Bool) (hn : IntMul.OpenAI.Glue.n0 ≤ x.length) :
    ∃ c, IRuns I iprog setP (readSt x y) (baseSt x y) c ∧
      c ≤ cStart x.length + 12 * 10 ^ 15 * (bP x.length + 1) ^ 4 +
        parS.cost (setupSt x.length (stA x y)) +
        parQ.cost ((setupSt x.length (stA x y)).upd NLogN.KFM.rS (.int (sCmp x.length : ℤ) ::
          (setupSt x.length (stA x y)).G NLogN.KFM.rS)) + (3 + 2 * shlCost x.length) := by
  set n := x.length with hnd
  have h3 := n0_ge3 hn
  have r1 := startP_runs (I := I) (iprog := iprog) x y h3
  have hlg : (lg n : ℤ) = (bP n : ℤ) := rfl
  obtain ⟨k2, e2, c2⟩ := setupS_all n hn (stA x y) [] [] (by simp +decide [stA] <;> rfl)
    (by simp +decide [stA, hlg] <;> rfl)
  have r2 := RS.code_runs (I := I) (iprog := iprog) setupS (stA x y) k2
  rw [e2] at r2
  set sB := setupSt n (stA x y) with hsB
  have hBD : sB.G zD = .int (IntMul.OpenAI.R129.dP n : ℤ) :: (stA x y).G zD := setupSt_D n _
  have hBB : sB.G NLogN.KFM.zB = .int (bP n : ℤ) :: [] := by
    simp +decide [sB, setupSt, stA, hlg] <;> rfl
  obtain ⟨k3, e3⟩ := parS_run hn sB _ _ hBD hBB (setupSt_srcRegs n _)
  have r3 := RS.code_runs (I := I) (iprog := iprog) parS sB k3
  rw [e3] at r3
  set sC := sB.upd NLogN.KFM.rS (.int ((∏ j ∈ Finset.range (IntMul.OpenAI.R129.dP n), srcN n j) % 2 ^ bP n : ℕ) :: sB.G NLogN.KFM.rS)
    with hsC
  have hq : QRegs sC n (sCmp n) := by
    refine ⟨⟨(stA x y).G NLogN.KFM.zL, ?_⟩, ⟨[], ?_⟩, ⟨[], ?_⟩, ⟨(stA x y).G zD, ?_⟩, ⟨(stA x y).G zAl, ?_⟩,
      ⟨sB.G NLogN.KFM.rS, ?_⟩⟩ <;> simp +decide [sC, sB, setupSt, stA, hlg, sCmp] <;> rfl
  obtain ⟨k4, e4⟩ := parQ_run hn (sCmp n) sC hq
  have r4 := RS.code_runs (I := I) (iprog := iprog) parQ sC k4
  rw [e4] at r4
  have hT : (NLogN.KFM.pushV sC (parQV n (sCmp n))).G kT1 = .int ((2 : ℤ) ^ n) :: [] := by
    rw [pushV_G _ _ _ (by simp +decide [parQV])]
    simp +decide [sC, sB, setupSt, stA, readSt, hnd]
  have r5 := oP_runs (I := I) (iprog := iprog) _ n [] hT
  refine ⟨_, r1.seq (r2.seq (r3.seq (r4.seq r5))), ?_⟩
  have : sC = sB.upd NLogN.KFM.rS (.int (sCmp n : ℤ) :: sB.G NLogN.KFM.rS) := rfl
  rw [← this]
  have ec : cStart x.length = cStart n := rfl
  omega

