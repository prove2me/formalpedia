universe u

noncomputable def shuffle {X : Scheme.{u}} (a b c d : X.Modules) : (a ⊗ b) ⊗ (c ⊗ d) ≅ (a ⊗ c) ⊗ (b ⊗ d) :=
  α_ a b (c ⊗ d) ≪≫ whiskerLeftIso a ((α_ b c d).symm ≪≫ whiskerRightIso (β_ b c) d ≪≫ α_ c b d) ≪≫ (α_ a c (b ⊗ d)).symm

noncomputable def tensorPowTensorIso {X : Scheme.{u}} (M Q : X.Modules) :
    ∀ n : ℕ, (M ⊗ Q).tensorPow n ≅ M.tensorPow n ⊗ Q.tensorPow n
  | 0 => (λ_ (𝟙_ X.Modules)).symm
  | n + 1 => whiskerRightIso (tensorPowTensorIso M Q n) (M ⊗ Q) ≪≫ shuffle _ _ _ _

theorem isInvertible_tensorPow {X : Scheme.{u}} {M : X.Modules} (hM : Scheme.Modules.IsInvertible M) :
    ∀ n : ℕ, Scheme.Modules.IsInvertible (M.tensorPow n)
  | 0 => Scheme.Modules.isInvertible_unit X
  | n + 1 => (isInvertible_tensorPow hM n).tensor_monoidalV2 hM

theorem inPicZero_tensorPow (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) {Q : A.Modules} (hQ : InPicZero f L Q) : ∀ n : ℕ, InPicZero f L (Q.tensorPow n)
  | 0 => inPicZero_tensorUnit k f L
  | n + 1 => InPicZero.tensor k f L (inPicZero_tensorPow k f L hQ n) hQ

theorem kernelPts_tensor_subset (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (M Q : A.Modules) (hQ : InPicZero f L Q) :
    kernelPts f L (M ⊗ Q) ⊆ kernelPts f L M := by
  intro x hx
  obtain ⟨e⟩ := (mem_kernelPts_iff_nonempty_pullback_translate_iso k f L (M ⊗ Q) x).mp hx
  obtain ⟨eQ⟩ := hQ.2 x
  obtain ⟨-, ⟨eQQ⟩⟩ := hQ.1.dual_monoidalV2
  refine (mem_kernelPts_iff_nonempty_pullback_translate_iso k f L M x).mpr ⟨?_⟩
  exact (ρ_ _).symm ≪≫ whiskerLeftIso _ eQQ.symm ≪≫ (α_ _ _ _).symm ≪≫
    whiskerRightIso (whiskerLeftIso _ eQ.symm ≪≫ (pullbackTensorObjIso _ _ _).symm ≪≫ e) _ ≪≫
    α_ _ _ _ ≪≫ whiskerLeftIso _ eQQ ≪≫ ρ_ _

theorem locIsoOnBase_of_iso {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
