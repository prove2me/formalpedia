-- title:
--   The intrinsic càdlàg path space, J₁ topology, Borel laws and restrictions
-- statement:
--   Let $T$ be a real interval and $S$ a metric space. The space $D(T,S)$ consists of right-continuous functions with left limits, identified by their values on $T$. Its topology is generated by the sets which are sequentially open for the published restriction criterion for $J_1$ convergence. Its measurable structure is the Borel σ-field of this topology. The projection and restriction maps are
--
--   $$\pi_t(x)=x(t),\qquad r_U(x)=x|_U.$$
--
--   The cylinder σ-field is independently generated by all $\pi_t$. For a probability law $P$, $T_P$ consists of times where almost every path is continuous. Weak convergence means convergence of integrals of every bounded continuous real function; relative compactness of laws uses the weak topology on probability measures. These definitions provide the common interface for the topological and probabilistic results.
--
--   **Formalization Note** A path stores a function $T\to S$, so off-domain values do not distinguish points. The càdlàg predicate is expressed equivalently by requiring each total extension of each restriction to be càdlàg there. This also handles empty $T$ and empty $S$. The topology is defined from sequential convergence, not from the metrics whose existence is asserted in Theorems 2.5–2.6. Besides the published restriction criterion (compact $[a,b]\subseteq T$ with $a<b$), sequential convergence also tests the degenerate compact intervals $[a,a]$ of p. 70 at continuity points and endpoints, where the metric (2.1) is $m(x(a),y(a))$; this clause follows from the published criterion whenever $T$ has more than one point, and it gives a one-point $T$ the topology of $S$ rather than the indiscrete topology. On the exceptional empty-time/empty-state singleton there are no total representatives, but the generated topology is still its unique topology. Borel measurability is not replaced by cylinder measurability. The constructor `packD` keeps any càdlàg input; otherwise it returns its constant value at a chosen time (or the unique empty path). Theorems using it assert the exact pointwise formulas as conclusions, ruling out reliance on that fallback.
-- source:
--   Whitt, Some Useful Functions for Functional Limit Theorems, Math. Oper. Res. 5(1) (1980), DOI 10.1287/moor.5.1.67, §2, pp. 70–73

import Mathlib
import Definitions.Def_WhittFLT_Composition_SkorohodD

namespace WhittFLT.TimeReversal.Supplement
open Set Filter Topology MeasureTheory
open WhittFLT.Composition

variable {S : Type*} [MetricSpace S]

/-- Intrinsic càdlàg functions on T. Requiring the càdlàg condition for each
restriction/total extension is equivalent to the usual relative condition, and
makes restriction a structural operation. No values off T are stored. -/
def PathProperty (T : Set ℝ) (f : T → S) : Prop :=
  ∀ (U : Set ℝ) (hU : U ⊆ T) (g : ℝ → S),
    (∀ t (ht : t ∈ U), g t = f ⟨t, hU ht⟩) → IsCadlagOn U g

def DPath (T : Set ℝ) (S : Type*) [MetricSpace S] :=
  {f : T → S // PathProperty T f}

/-- A total representative: equality only on the actual time domain. -/
def Represents {T : Set ℝ} (x : DPath T S) (f : ℝ → S) : Prop :=
  ∀ t (ht : t ∈ T), f t = x.1 ⟨t, ht⟩

/-- J₁ sequences, using the published convergence predicate rather than a new metric.
The last clause is the degenerate compact interval `[a, a]` of p. 70 (the metric (2.1) on
`[a, a]` is `m(x(a), y(a))`): it is implied by `J1Tendsto T` when `T` has more than one point,
and it gives a one-point `T` the topology of `S` instead of the indiscrete one. -/
def PathSeq {T : Set ℝ} (xs : ℕ → DPath T S) (x : DPath T S) : Prop :=
  ∃ fs : ℕ → ℝ → S, ∃ f : ℝ → S,
    (∀ n, Represents (xs n) (fs n)) ∧ Represents x f ∧ J1Tendsto T fs f ∧
    ∀ a ∈ T, (ContinuousWithinAt f T a ∨ IsEndpoint T a) → J1TendstoOn a a fs f

/-- The sequentially open sets for the restriction definition of J₁. This definition
neither chooses nor presupposes a complete metric. The generated family is a topology. -/
instance pathTopology (T : Set ℝ) : TopologicalSpace (DPath T S) :=
  TopologicalSpace.generateFrom {U | ∀ xs x, PathSeq xs x → x ∈ U → ∀ᶠ n in atTop, xs n ∈ U}

instance pathMeasurable (T : Set ℝ) : MeasurableSpace (DPath T S) := borel (DPath T S)
instance pathBorel (T : Set ℝ) : BorelSpace (DPath T S) := ⟨rfl⟩

/-- Restriction to any subset, with no arbitrary extension or default path. -/
def restrictD {T U : Set ℝ} (h : U ⊆ T) (x : DPath T S) : DPath U S :=
  ⟨fun t => x.1 ⟨t, h t.2⟩, fun V hV g hg => x.2 V (hV.trans h) g hg⟩

def evalD {T : Set ℝ} (t : T) (x : DPath T S) : S := x.1 t

/-- The Kolmogorov sigma field, not declared equal to Borel by definition. -/
@[instance_reducible] def cylinder (T : Set ℝ) : MeasurableSpace (DPath T S) :=
  ⨆ t : T, MeasurableSpace.comap (evalD t) (borel S)

/-- Weak convergence, with all probability conditions explicit. Testing against
bounded continuous real functions is valid on the Polish spaces of Theorem 2.6. -/
def Weakly {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    (ps : ℕ → Measure X) (p : Measure X) : Prop :=
  (∀ n, IsProbabilityMeasure (ps n)) ∧ IsProbabilityMeasure p ∧
    ∀ f : BoundedContinuousFunction X ℝ, Tendsto (fun n => ∫ x, f x ∂ps n) atTop (𝓝 (∫ x, f x ∂p))

/-- Relative compactness of laws in the weak probability-measure topology. -/
def RelCompactLaws {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    (ps : ℕ → Measure X) : Prop :=
  ∃ K : Set (ProbabilityMeasure X), IsCompact K ∧
    ∀ n, ∃ p ∈ K, p.toMeasure = ps n

/-- Times of almost-sure continuity, relative to T. -/
def TP {T : Set ℝ} (p : Measure (DPath T S)) : Set ℝ :=
  {t | ∃ ht : t ∈ T, p {x | ¬ ContinuousAt x.1 ⟨t, ht⟩} = 0}

/-- Structural constant path. -/
def constantD (T : Set ℝ) (s : S) : DPath T S := by
  refine ⟨fun _ => s, ?_⟩
  intro U hU g hg t ht
  have he : g =ᶠ[𝓝[U] t] fun _ => s :=
    Filter.mem_of_superset self_mem_nhdsWithin (fun u hu => hg u hu)
  constructor
  · exact continuousWithinAt_const.congr (fun u hu => hg u hu.1) (hg t ht)
  · exact ⟨s, tendsto_const_nhds.congr' (he.filter_mono (nhdsWithin_mono _ inter_subset_left)).symm⟩

/-- Pack an intrinsic function if it is càdlàg; otherwise return its constant
value at a chosen time (and the unique empty function for empty T). All results
using this constructor assert pointwise exactness, so fallback cannot weaken them. -/
noncomputable def packD {T : Set ℝ} (f : T → S) : DPath T S := by
  classical
  exact if hf : PathProperty T f then ⟨f, hf⟩ else
    if hT : T.Nonempty then constantD T (f ⟨hT.choose, hT.choose_spec⟩)
    else ⟨f, by intro U hU g hg t ht; exact False.elim (hT ⟨t, hU ht⟩)⟩

end WhittFLT.TimeReversal.Supplement


