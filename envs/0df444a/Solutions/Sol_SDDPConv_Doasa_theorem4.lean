/-- Conic support deletion, with no sum-one restriction on the coefficients. -/
theorem independent_conic_representation {ι E : Type*} [AddCommGroup E] [Module ℝ E]
    (v : ι → E) (s : Finset ι) (a : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i) :
    ∃ t : Finset ι, t ⊆ s ∧ LinearIndepOn ℝ v (t : Set ι) ∧
      ∃ b : ι → ℝ, (∀ i ∈ t, 0 ≤ b i) ∧
        ∑ i ∈ t, b i • v i = ∑ i ∈ s, a i • v i := by
  classical
  revert a
  refine s.strongInductionOn ?_
  intro s ih a ha
  by_cases hs : LinearIndepOn ℝ v (s : Set ι)
  · exact ⟨s, Subset.rfl, hs, a, ha, rfl⟩
  obtain ⟨r, hr, i, hi, hri⟩ := not_linearIndepOn_finset_iff.mp hs
  have hex : ∃ g : ι → ℝ, (∑ j ∈ s, g j • v j = 0) ∧ ∃ j ∈ s, 0 < g j := by
    by_cases hp : 0 < r i
    · exact ⟨r, hr, i, hi, hp⟩
    · refine ⟨fun j => -r j, ?_, i, hi, ?_⟩
      · simp only [neg_smul, Finset.sum_neg_distrib, hr, neg_zero]
      · exact neg_pos.mpr (lt_of_le_of_ne (le_of_not_gt hp) hri)
  obtain ⟨g, hg, j, hj, hgj⟩ := hex
  let pos := s.filter (fun j => 0 < g j)
  obtain ⟨i, hi, hmin⟩ := pos.exists_min_image (fun j => a j / g j)
    ⟨j, Finset.mem_filter.mpr ⟨hj, hgj⟩⟩
  have his : i ∈ s := (Finset.mem_filter.mp hi).1
  have hgi : 0 < g i := (Finset.mem_filter.mp hi).2
  let b : ι → ℝ := fun j => a j - a i / g i * g j
  have hbi : b i = 0 := by simp [b, ne_of_gt hgi]
  have hb (j : ι) (hj : j ∈ s) : 0 ≤ b j := by
    dsimp [b]
    apply sub_nonneg.mpr
    by_cases hp : 0 < g j
    · exact (le_div_iff₀ hp).mp (hmin j (Finset.mem_filter.mpr ⟨hj, hp⟩))
    · exact (mul_nonpos_of_nonneg_of_nonpos
        (div_nonneg (ha i his) hgi.le) (le_of_not_gt hp)).trans (ha j hj)
  have hsum : (∑ j ∈ s.erase i, b j • v j) = ∑ j ∈ s, a j • v j := by
    calc
      (∑ j ∈ s.erase i, b j • v j) = ∑ j ∈ s, b j • v j :=
        Finset.sum_erase _ (by rw [hbi, zero_smul])
      _ = ∑ j ∈ s, a j • v j := by
        simp only [b, sub_smul, mul_smul, Finset.sum_sub_distrib,
          ← Finset.smul_sum, hg, smul_zero, sub_zero]
  obtain ⟨t, ht, htli, c, hc, hceq⟩ := ih (s.erase i) (Finset.erase_ssubset his) b
    (fun j hj => hb j (Finset.mem_of_mem_erase hj))
  exact ⟨t, ht.trans (Finset.erase_subset _ _), htli, c, hc, hceq.trans hsum⟩

/-- A cone generated by finitely many vectors is closed. -/
theorem finite_cone_isClosed {ι E : Type*} [Fintype ι]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    (v : ι → E) :
    IsClosed {x : E | ∃ a : ι → ℝ, (∀ i, 0 ≤ a i) ∧ ∑ i, a i • v i = x} := by
  classical
  let J := {s : Finset ι // LinearIndepOn ℝ v (s : Set ι)}
  let L (s : J) : (s.1 → ℝ) →ₗ[ℝ] E :=
    Fintype.linearCombination ℝ (fun i : s.1 => v i)
  let O (s : J) : Set (s.1 → ℝ) := {a | ∀ i, 0 ≤ a i}
  have hO (s : J) : IsClosed (O s) := by
    rw [show O s = ⋂ i : s.1, {a : s.1 → ℝ | 0 ≤ a i} by ext a; simp [O]]
    exact isClosed_iInter (fun _ => isClosed_le continuous_const (continuous_apply _))
  have hL (s : J) : IsClosedEmbedding (L s) :=
    LinearMap.isClosedEmbedding_of_injective
      (LinearMap.ker_eq_bot.mpr s.2.fintypeLinearCombination_injective)
  have heq : {x : E | ∃ a : ι → ℝ, (∀ i, 0 ≤ a i) ∧ ∑ i, a i • v i = x} =
      ⋃ s : J, L s '' O s := by
    ext x
    constructor
    · rintro ⟨a, ha, rfl⟩
      obtain ⟨s, _, hs, b, hb, he⟩ := independent_conic_representation v Finset.univ a
        (fun i _ => ha i)
      refine Set.mem_iUnion.mpr ⟨⟨s, hs⟩, ?_⟩
      refine ⟨fun i => b i, (fun i => hb i i.2), ?_⟩
      change (∑ i : s, b i • v i) = _
      exact (Finset.sum_coe_sort s (fun i => b i • v i)).trans he
    · intro hx
      obtain ⟨s, c, hc, rfl⟩ := Set.mem_iUnion.mp hx
      let b : ι → ℝ := fun i => if h : i ∈ s.1 then c ⟨i, h⟩ else 0
      refine ⟨b, ?_, ?_⟩
      · intro i
        dsimp [b]
        split_ifs with hi
        · exact hc ⟨i, hi⟩
        · exact le_rfl
      · change (∑ i, b i • v i) = ∑ i : s.1, c i • v i
        calc
          (∑ i, b i • v i) = ∑ i ∈ s.1, b i • v i := by
            symm
            exact Finset.sum_subset (Finset.subset_univ _) (fun i _ hi => by simp [b, hi])
          _ = ∑ i : s.1, c i • v i := by
            rw [← Finset.sum_coe_sort]
            apply Finset.sum_congr rfl
            intro i _
            simp [b, i.2]
  rw [heq]
  exact isClosed_iUnion_of_finite (fun s => (hL s).isClosedMap _ (hO s))

end DOASAProof

