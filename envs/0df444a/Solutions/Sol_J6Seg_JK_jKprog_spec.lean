variable {B : Fin HS → List ℤ} {z0 re im v w tmp wr wi : List ℤ}

theorem kS_ne {j : Fin HS} (h0 : j ≠ 0) (h1 : j ≠ RE) (h2 : j ≠ IM) (h3 : j ≠ V) (h4 : j ≠ W)
