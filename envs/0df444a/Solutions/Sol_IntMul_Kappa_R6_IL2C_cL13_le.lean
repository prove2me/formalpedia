/-! ## Polynomial bounds of the cost units -/

section NatB

variable (Bb : ℕ)

theorem sz_tm : tmA.size ≤ 92 ∧ tmB.size ≤ 92 ∧ tmS.size ≤ 92 ∧ tmC.size ≤ 92 ∧ tmT.size ≤ 92 := by
  decide

theorem cSegItR_le {T : Ex HS} (hT : T.size ≤ 92) : cSegItR T Bb ≤ 4 * 10 ^ 9 * (Bb + 2) ^ 2 := by
  unfold cSegItR
  calc (T.size + 8) * 4 * 10 ^ 7 * (Bb + 2) ^ 2 ≤ 100 * 4 * 10 ^ 7 * (Bb + 2) ^ 2 := by
        gcongr; omega
    _ = 4 * 10 ^ 9 * (Bb + 2) ^ 2 := by ring

theorem b_le_sq : Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith

theorem cStepR_le {T : Ex HS} (hT : T.size ≤ 92) (n c : ℕ) (hc : c ≤ 100) :
    cStepR T Bb n c ≤ 10 ^ 10 * (n + 1) * (Bb + 2) ^ 2 := by
  unfold cStepR KFD.cLp
  have h := cSegItR_le Bb hT
  have hb := b_le_sq Bb
  have h1 : n * (cSegItR T Bb + 1100) ≤ n * (5 * 10 ^ 9 * (Bb + 2) ^ 2) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  have h2 : (c + 20) * 10 ^ 7 * (Bb + 2) ^ 2 ≤ 120 * 10 ^ 7 * (Bb + 2) ^ 2 := by gcongr; omega
  nlinarith

theorem cV_le {T : Ex HS} (hT : T.size ≤ 92) (n : ℕ) :
    cV T Bb n ≤ 2 * 10 ^ 10 * (n + 1) * (Bb + 2) ^ 2 := by
  unfold cV
  have := cStepR_le Bb hT n 100 le_rfl
  nlinarith

theorem cKeyC_le (n : ℕ) : cKeyC Bb n ≤ 10 ^ 12 * (n + 1) * (Bb + 2) ^ 2 := by
  obtain ⟨a, b, s, c, t⟩ := sz_tm
  unfold cKeyC
  have := cV_le Bb a n; have := cV_le Bb b n; have := cV_le Bb s n; have := cV_le Bb c n
  have := cV_le Bb t n
  nlinarith

theorem cTabR_le {T : Ex HS} (hT : T.size ≤ 92) (n : ℕ) :
    cTabR T Bb n ≤ 10 ^ 10 * (n + 1) * (Bb + 2) ^ 2 := by
  unfold cTabR KFD.cLp
  have h := cSegItR_le Bb hT
  have hb := b_le_sq Bb
  have h1 : n * (cSegItR T Bb + 1100) ≤ n * (5 * 10 ^ 9 * (Bb + 2) ^ 2) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  nlinarith

theorem cTabGenR_le {T : Ex HS} (hT : T.size ≤ 92) (n P : ℕ) :
    cTabGenR T Bb n P ≤ 2 * 10 ^ 10 * (P + 1) * (n + 1) * (Bb + 2) ^ 2 := by
  unfold cTabGenR KFD.cLp
  have h := cTabR_le Bb hT n
  have hb := b_le_sq Bb
  have hn : (Bb + 2) ^ 2 ≤ (n + 1) * (Bb + 2) ^ 2 := Nat.le_mul_of_pos_left _ (by omega)
  have h1 : P * (cTabR T Bb n + 1100) ≤ P * ((10 ^ 10 + 1100) * (n + 1) * (Bb + 2) ^ 2) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  nlinarith

theorem cRotF_le (P Q B : ℕ) (hB : 1 ≤ B) :
    KFC.cRotF P Q B 1 ≤ 10 ^ 4 * (P * Q * B + P + B + 1) := by
  unfold KFC.cRotF KFC.cRB KFC.cUL KFC.kap
  have zQ : zsz (Q : ℤ) ≤ Q := zsz_natCast_le_self Q
  have zP : zsz (P : ℤ) ≤ P := zsz_natCast_le_self P
  have zB : zsz (B : ℤ) ≤ B := zsz_natCast_le_self B
  have hPQ : P * Q ≤ P * Q * B := Nat.le_mul_of_pos_right _ hB
  have h1 : P * (3 * Q * (B * (76 * 1 + 200) + 124) + 1100 * Q + 2200 * zsz (Q : ℤ) + 4000 + 64) ≤
      P * (828 * (Q * B) + 3672 * Q + 4064) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  nlinarith

theorem cRotR_le {T : Ex HS} (hT : T.size ≤ 92) (n P Q B : ℕ) (hB : 1 ≤ B) :
    cRotR T Bb n P Q B 1 ≤
      10 ^ 11 * ((P + 1) * (n + 1) * (Bb + 2) ^ 2 + P * Q * B + P + B) := by
  unfold cRotR
  have h1 := cTabGenR_le Bb hT n P
  have h2 := cRotF_le P Q B hB
  have hb := b_le_sq Bb
  have h3 : (Bb + 2) ^ 2 ≤ (P + 1) * (n + 1) * (Bb + 2) ^ 2 :=
    Nat.le_mul_of_pos_left _ (Nat.mul_pos (by omega) (by omega))
  nlinarith

theorem cXorGen_le (P : ℕ) : cXorGen P Bb ≤ 10 ^ 9 * (P + 1) * (Bb + 2) ^ 2 := by
  unfold cXorGen KFD.cLp
  have hb := b_le_sq Bb
  have h1 : P * (20 * 10 ^ 7 * (Bb + 2) ^ 2 + 1100) ≤ P * ((2 * 10 ^ 8 + 1100) * (Bb + 2) ^ 2) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  nlinarith

theorem cXorU_le' (P B : ℕ) (hB : 1 ≤ B) :
    cXorU P B 1 Bb ≤ 10 ^ 12 * ((P + 1) * (Bb + 2) ^ 2 + P * 2 * B + P + B) := by
  unfold cXorU
  have h1 := cXorGen_le Bb P
  have h2 := cRotF_le P 2 B hB
  have hb := b_le_sq Bb
  have h3 : (Bb + 2) ^ 2 ≤ (P + 1) * (Bb + 2) ^ 2 := Nat.le_mul_of_pos_left _ (by omega)
  nlinarith

theorem cIte_le : cIte Bb ≤ 10 ^ 5 * (Bb + 2) := by unfold cIte; omega

theorem cBr_le (B : ℕ) : KFL.cBr B Bb ≤ 10 ^ 10 * (B + (Bb + 2) ^ 2) := by
  unfold KFL.cBr KFD.cLp
  have hb := b_le_sq Bb
  nlinarith

theorem cP1G_le (cK B : ℕ) : cP1G cK B Bb ≤ cK + 10 ^ 11 * (B + (Bb + 2) ^ 2) := by
  unfold cP1G
  have := cIte_le Bb; have := cBr_le Bb B; have hb := b_le_sq Bb
  nlinarith

theorem cEnt_le (B : ℕ) : cEnt B Bb ≤ 10 ^ 5 * (B + (Bb + 2)) := by
  unfold cEnt cBk KFD.cLp
  nlinarith

theorem cPass_le (B N : ℕ) : KFL.cPass B N Bb ≤ 10 ^ 6 * ((Bb + 2) + N * (B + (Bb + 2))) := by
  unfold KFL.cPass KFD.cLp
  have h1 : N * (cEnt B Bb + 1100) ≤ N * (10 ^ 5 * (B + (Bb + 2)) + 1100) :=
    Nat.mul_le_mul_left _ (by have := cEnt_le Bb B; omega)
  nlinarith

theorem cP3_le (B : ℕ) : cP3 B Bb ≤ 10 ^ 5 * (B + (Bb + 2)) := by
  unfold cP3 KFD.cLp
  nlinarith

theorem cCorrG_le (cK B M A nB : ℕ) :
    cCorrG cK B M A nB Bb ≤ 10 ^ 12 * ((Bb + 2) + M * cK + M * (B + (Bb + 2) ^ 2) +
      A * (Bb + 2) + A * nB * (B + (Bb + 2))) := by
  unfold cCorrG KFD.cLp
  have hb := b_le_sq Bb
  have h1 : M * (cP1G cK B Bb + 1100) ≤ M * cK + M * (10 ^ 11 * (B + (Bb + 2) ^ 2) + 1100) := by
    have := cP1G_le Bb cK B; nlinarith
  have h2 : A * (KFL.cPass B nB Bb + 1100) ≤
      A * (10 ^ 6 * ((Bb + 2) + nB * (B + (Bb + 2))) + 1100) :=
    Nat.mul_le_mul_left _ (by have := cPass_le Bb B nB; omega)
  have h3 : M * (cP3 B Bb + 1100) ≤ M * (10 ^ 5 * (B + (Bb + 2)) + 1100) :=
    Nat.mul_le_mul_left _ (by have := cP3_le Bb B; omega)
  have := Nat.zero_le (M * cK); have := Nat.zero_le (M * B); have := Nat.zero_le (M * Bb ^ 2)
  have := Nat.zero_le (M * Bb); have := Nat.zero_le (A * Bb); have := Nat.zero_le (A * nB * B)
  have := Nat.zero_le (A * nB * Bb); have := Nat.zero_le (A * nB); have := Nat.zero_le Bb
  have := Nat.zero_le M; have := Nat.zero_le A
  linarith

end NatB

/-! ## The units of the compact phase -/

section Units

variable {l : Lay}

/-- A rotation. -/
theorem cR_le {T : Ex HS} (hT : T.size ≤ 92) {n Br P Q S : ℕ} (hBr : 1 ≤ Br) (hS : 1 ≤ S)
    (hSM : S ≤ l.M) (hPM : P * (Q * S) ≤ l.M) (hP : P ≤ l.M) :
    cR T l n Br P Q S ≤ 10 ^ 12 * (((l.M : ℝ) + 1) * ((n : ℝ) + 1) *
      ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2 + 2 * ((l.M * Br : ℕ) : ℝ)) := by
  unfold cR
  set Bb := zsz ((l.M * Br : ℕ) : ℤ) + 3 with hBb
  have h := cRotR_le Bb hT n P Q (S * Br) (Nat.mul_pos hS hBr)
  have e1 : P * Q * (S * Br) ≤ l.M * Br := by
    calc P * Q * (S * Br) = P * (Q * S) * Br := by ring
      _ ≤ l.M * Br := Nat.mul_le_mul_right _ hPM
  have e2 : S * Br ≤ l.M * Br := Nat.mul_le_mul_right _ hSM
  have e3 : P ≤ l.M * Br := le_trans hP (Nat.le_mul_of_pos_right _ hBr)
  have e4 : (P + 1) * (n + 1) * (Bb + 2) ^ 2 ≤ (l.M + 1) * (n + 1) * (Bb + 2) ^ 2 := by gcongr
  have h' : cRotR T Bb n P Q (S * Br) 1 ≤
      10 ^ 11 * ((l.M + 1) * (n + 1) * (Bb + 2) ^ 2 + 3 * (l.M * Br)) := by omega
  have hR : (cRotR T Bb n P Q (S * Br) 1 : ℝ) ≤
      10 ^ 11 * (((l.M : ℝ) + 1) * ((n : ℝ) + 1) * ((Bb : ℝ) + 2) ^ 2 + 3 * ((l.M * Br : ℕ) : ℝ)) := by
    exact_mod_cast h'
  have hB : ((Bb : ℕ) : ℝ) + 2 = (zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5 := by rw [hBb]; push_cast; ring
  rw [hB] at hR
  have : (0 : ℝ) ≤ (((l.M : ℝ) + 1) * ((n : ℝ) + 1) * ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2) := by
    positivity
  have : (0 : ℝ) ≤ ((l.M * Br : ℕ) : ℝ) := Nat.cast_nonneg _
  nlinarith

/-- An xor rotation. -/
theorem cX_le {Br P s : ℕ} (hBr : 1 ≤ Br) (hs : 1 ≤ s) (hsM : s ≤ l.M) (hPM : P * (2 * s) ≤ l.M)
    (hP : P ≤ l.M) :
    (cXorU P (s * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℝ) ≤ 10 ^ 12 * (((l.M : ℝ) + 1) *
      ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2 + 3 * ((l.M * Br : ℕ) : ℝ)) := by
  set Bb := zsz ((l.M * Br : ℕ) : ℤ) + 3 with hBb
  have h := cXorU_le' Bb P (s * Br) (Nat.mul_pos hs hBr)
  have e1 : P * 2 * (s * Br) ≤ l.M * Br := by
    calc P * 2 * (s * Br) = P * (2 * s) * Br := by ring
      _ ≤ l.M * Br := Nat.mul_le_mul_right _ hPM
  have e2 : s * Br ≤ l.M * Br := Nat.mul_le_mul_right _ hsM
  have e3 : P ≤ l.M * Br := le_trans hP (Nat.le_mul_of_pos_right _ hBr)
  have e4 : (P + 1) * (Bb + 2) ^ 2 ≤ (l.M + 1) * (Bb + 2) ^ 2 := by gcongr
  have h' : cXorU P (s * Br) 1 Bb ≤ 10 ^ 12 * ((l.M + 1) * (Bb + 2) ^ 2 + 3 * (l.M * Br)) := by
    omega
  have hR : (cXorU P (s * Br) 1 Bb : ℝ) ≤
      10 ^ 12 * (((l.M : ℝ) + 1) * ((Bb : ℝ) + 2) ^ 2 + 3 * ((l.M * Br : ℕ) : ℝ)) := by
    exact_mod_cast h'
  have hB : ((Bb : ℕ) : ℝ) + 2 = (zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5 := by rw [hBb]; push_cast; ring
  rw [hB] at hR
  exact hR

/-- The correction. -/
theorem cCo_le {K ρ G n L Br : ℕ} :
    cCo l K ρ G n L Br ≤ 10 ^ 27 * ((l.M : ℝ) * ((n : ℝ) + 1) *
      ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2 + (l.M : ℝ) * Br +
      (zsz ((l.M * Br : ℕ) : ℤ) : ℝ) * ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) +
      (zsz ((l.M * Br : ℕ) : ℤ) : ℝ) * (nMv (keyC l K ρ G n L) l.M : ℝ) *
        ((Br : ℝ) + (zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) +
      ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2) := by
  unfold cCo
  set A := zsz ((l.M * Br : ℕ) : ℤ) with hA
  set Bb := A + 3 with hBb
  set nB := nMv (keyC l K ρ G n L) l.M
  have h1 := cCorrG_le Bb (cKeyC Bb n) Br l.M A nB
  have h2 := cKeyC_le Bb n
  have h3 : l.M * cKeyC Bb n ≤ l.M * (10 ^ 12 * (n + 1) * (Bb + 2) ^ 2) := Nat.mul_le_mul_left _ h2
  have hb := b_le_sq Bb
  have hN : 30 * 10 ^ 7 * (A + 3 + 2) ^ 2 + 1 + 400 * cCorrG (cKeyC Bb n) Br l.M A nB Bb +
      (3 * (2 * (A + 3) + 2) + 1) ≤ 10 ^ 27 * (l.M * (n + 1) * (Bb + 2) ^ 2 + l.M * Br +
        A * (Bb + 2) + A * nB * (Br + (Bb + 2)) + (Bb + 2) ^ 2) := by
    rw [show A + 3 + 2 = Bb + 2 by omega, show 2 * (A + 3) + 2 = 2 * Bb + 2 by omega]
    have q1 : l.M * (Bb + 2) ^ 2 ≤ l.M * (n + 1) * (Bb + 2) ^ 2 :=
      Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ (Nat.succ_pos n))
    have q2 : 1 ≤ (Bb + 2) ^ 2 := Nat.one_le_pow _ _ (Nat.succ_pos _)
    have := Nat.zero_le (l.M * n * Bb ^ 2); have := Nat.zero_le (l.M * n * Bb)
    have := Nat.zero_le (l.M * n); have := Nat.zero_le (l.M * Bb ^ 2); have := Nat.zero_le (l.M * Bb)
    have := Nat.zero_le l.M; have := Nat.zero_le (l.M * Br); have := Nat.zero_le (A * Bb)
    have := Nat.zero_le A; have := Nat.zero_le (A * nB * Br); have := Nat.zero_le (A * nB * Bb)
    have := Nat.zero_le (A * nB); have := Nat.zero_le (Bb ^ 2); have := Nat.zero_le Bb
    have := Nat.zero_le (l.M * cKeyC Bb n)
    linarith
  have hR : ((30 * 10 ^ 7 * (A + 3 + 2) ^ 2 + 1 + 400 * cCorrG (cKeyC Bb n) Br l.M A nB Bb +
      (3 * (2 * (A + 3) + 2) + 1) : ℕ) : ℝ) ≤ ((10 ^ 27 * (l.M * (n + 1) * (Bb + 2) ^ 2 + l.M * Br +
        A * (Bb + 2) + A * nB * (Br + (Bb + 2)) + (Bb + 2) ^ 2) : ℕ) : ℝ) := by exact_mod_cast hN
  have e : ((Bb : ℕ) : ℝ) + 2 = (A : ℝ) + 5 := by rw [hBb]; push_cast; ring
  rw [hBb] at hR ⊢
  push_cast at hR ⊢
  refine le_trans hR (le_of_eq (by ring))

end Units

/-! ## The moved records -/

theorem nB_le {l : Lay} {K ρ G n L Z : ℕ} (hV : KVal l K ρ G n L l.M (zsz ((l.M * 1 : ℕ) : ℤ) + 3))
    (hnZ : n ≤ Z) (hZG : 4 * Z * (Z + 2) ≤ 2 ^ G) (hGK : 16 * Z * (Z + 2) * 2 ^ G ≤ 2 ^ K) :
    nMv (keyC l K ρ G n L) l.M * (Z + 2) ≤ l.M := by
  have hc : nMv (keyC l K ρ G n L) l.M * (2 ^ G * 2 ^ K) ≤
      n * l.M * (2 * 2 ^ K + (2 * 2 ^ G + 2) * 2 ^ G) :=
    Lay.card_moved_C hV.ok hV.qc hV.ql hV.hK hV.hG hV.hL
  set a := 2 ^ G with ha
  set b := 2 ^ K with hb
  have ha1 : 1 ≤ a := Nat.one_le_two_pow
  have hW : n * (Z + 2) ≤ Z * (Z + 2) := Nat.mul_le_mul_right _ hnZ
  have h1 : n * (Z + 2) * (2 * b) ≤ Z * (Z + 2) * (2 * b) := Nat.mul_le_mul_right _ hW
  have h2 : n * (Z + 2) * ((2 * a + 2) * a) ≤ Z * (Z + 2) * (4 * a * a) :=
    Nat.mul_le_mul hW (by nlinarith)
  have h3 : 4 * Z * (Z + 2) * (2 * b) ≤ a * (2 * b) := Nat.mul_le_mul_right _ hZG
  have h4 : 16 * Z * (Z + 2) * a * a ≤ b * a := Nat.mul_le_mul_right _ hGK
  have key : n * (2 * b + (2 * a + 2) * a) * (Z + 2) ≤ a * b := by nlinarith
  have hD : 0 < a * b := by positivity
  set nB := nMv (keyC l K ρ G n L) l.M
  have : nB * (Z + 2) * (a * b) ≤ l.M * (a * b) := by
    calc nB * (Z + 2) * (a * b) = nB * (a * b) * (Z + 2) := by ring
      _ ≤ n * l.M * (2 * b + (2 * a + 2) * a) * (Z + 2) := Nat.mul_le_mul_right _ hc
      _ = l.M * (n * (2 * b + (2 * a + 2) * a) * (Z + 2)) := by ring
      _ ≤ l.M * (a * b) := Nat.mul_le_mul_left _ key
  exact Nat.le_of_mul_le_mul_right this hD

/-! ## The total -/

theorem rpow_nG_le {τ : ℝ} (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) {n G f : ℕ} (hG : 1 ≤ G) (hn : n ≤ f) :
    (((n * G : ℕ) : ℝ)) ^ τ ≤ (G : ℝ) * ((f : ℝ) + 1) ^ τ := by
  push_cast
  rw [Real.mul_rpow (by positivity) (by positivity)]
  have hG' : (1 : ℝ) ≤ G := by exact_mod_cast hG
  have a1 : (n : ℝ) ^ τ ≤ ((f : ℝ) + 1) ^ τ :=
    Real.rpow_le_rpow (by positivity) (by have : (n : ℝ) ≤ f := by exact_mod_cast hn
                                          linarith) hτ0
  have a2 : (G : ℝ) ^ τ ≤ G := by
    calc (G : ℝ) ^ τ ≤ (G : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hG' hτ1
      _ = G := Real.rpow_one _
  have a3 : (0 : ℝ) ≤ (n : ℝ) ^ τ := by positivity
  have a4 : (0 : ℝ) ≤ (G : ℝ) ^ τ := by positivity
  nlinarith

set_option maxHeartbeats 4000000 in
/-- **The cost of the compact Lemma 13 code** (no factor `K`). -/
theorem cL13_le_sol_aux {Ksw τ : ℝ} (hKsw : 0 ≤ Ksw) (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1)
    {N0 N1 N2 N3 K f ρ G R w Z : ℕ} {px py : Fin 3}
    (hp : RP N0 N1 N2 N3 K f ρ G px py) (hR : 1 ≤ R) (hfZ : f ≤ Z)
    (hZG : 4 * Z * (Z + 2) ≤ 2 ^ G) (hGK : 16 * Z * (Z + 2) * 2 ^ G ≤ 2 ^ K)
    (hzV : zsz ((vol (rect N0 N1 N2 N3 (f * K)) * (R * (2 * (w + 1))) : ℕ) : ℤ) ≤
      Z + zsz ((w : ℤ) + 1)) :
    cL13 Ksw τ N0 N1 N2 N3 K f ρ G R w px py ≤ (10 ^ 31 + 100 * Ksw) * ((G : ℝ) + 2) *
      ((vol (rect N0 N1 N2 N3 (f * K)) : ℝ) *
        ((R : ℝ) * (w + 1) * ((f : ℝ) + 1) ^ τ + (KFR.PsiR R Z w : ℝ))) := by
  unfold cL13 cCmp cPsi cPh cTop cW
  have hf := hp.hf
  have hG := hp.hG
  have hBr1 : 1 ≤ R * (2 * (w + 1)) := Nat.mul_pos hR (by omega)
  have hnG := rpow_nG_le (n := f - 1) (G := G) (f := f) hτ0 hτ1 hG (by omega)
  have hTo := cTo_le (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w
  have hFr := cFrom_le (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w
  set n := f - 1 with hnd
  set Br := R * (2 * (w + 1)) with hBrd
  set l := layR N0 N1 N2 N3 (f * K) G n px py with hld
  set q := ρ + n * K with hqd
  have hT : TopOK l (f * K) q Br := hp.topok Br hBr1
  have hP : PhOK l K ρ G n (f * K) Br := hp.phok Br hBr1
  have hV := hP.kv
  have hOK : l.OK := hp.ok
  have hlM : l.M = vol (rect N0 N1 N2 N3 (f * K)) := (vol_rect (R := R) (w := w)).symm
  have hM1 : 1 ≤ l.M := hOK.pM
  -- the units
  have hYM : l.sY ≤ l.M := hP.yM
  have hXM : l.sX ≤ l.M := hP.xM
  have dvle : ∀ a b : ℕ, a / b * b ≤ a := fun a b => Nat.div_mul_le_self a b
  have rY : ∀ {T : Ex HS}, T.size ≤ 92 → cR T l n Br (l.M / (l.QL * l.sY)) l.QL l.sY ≤
      10 ^ 12 * (((l.M : ℝ) + 1) * ((n : ℝ) + 1) * ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2 +
        2 * ((l.M * Br : ℕ) : ℝ)) := fun hT =>
    cR_le hT hBr1 hOK.pY hYM (dvle _ _) (Nat.div_le_self _ _)
  have rB : ∀ {T : Ex HS}, T.size ≤ 92 → cR T l n Br (l.M / l.QC) l.QC 1 ≤
      10 ^ 12 * (((l.M : ℝ) + 1) * ((n : ℝ) + 1) * ((zsz ((l.M * Br : ℕ) : ℤ) : ℝ) + 5) ^ 2 +
        2 * ((l.M * Br : ℕ) : ℝ)) := fun hT =>
    cR_le hT hBr1 le_rfl hM1 (by rw [mul_one]; exact dvle _ _) (Nat.div_le_self _ _)
  obtain ⟨sA, sB, sS, sC, -⟩ := sz_tm
  have iA := rY sA
  have iB := rY sB
  have iS := rB sS
  have iC := rB sC
  have xY := cX_le (l := l) (Br := Br) (P := l.M / (2 * (l.sY * 2 ^ q))) (s := l.sY * 2 ^ q) hBr1
    (Nat.mul_pos hOK.pY (by positivity)) (le_trans (by omega) (le_trans (hT.s2 _) hOK.yq_le))
    (dvle _ _) (Nat.div_le_self _ _)
