section PtCompSub

variable {k : Type} [Field k] [IsAlgClosed k] {Λ : Type} [CommRing Λ] {P : Scheme.{0}} (c : A1 k ⟶ P)
  [IsOpenImmersion c] {N : ℕ} [NeZero N] (hN : (N : k) ≠ 0) (hΛ : ∀ x : Λ, N • x = 0)

/-- Point classes push along `Λ[r]`. -/
theorem ptCls_comp {R T : P.Etale} (r : R ⟶ T) {x : Ext.{0} (freeSh Λ (etId P)) (freeSh Λ R) 2}
    (hx : PtCls Λ c hN hΛ R x) : PtCls Λ c hN hΛ T (x.comp (Ext.mk₀ (freeMap Λ r)) (add_zero 2)) := by
  obtain ⟨a, B, φ, hφE, Uz, hUz, hS, s, c', h1, h2, h3, h4, h5, rfl⟩ := hx
  exact ⟨a, B, φ, hφE, Uz, hUz, hS, s ≫ r, c', h1, h2, h3, h4, h5, by
    rw [Ext.comp_assoc_of_third_deg_zero, Ext.mk₀_comp_mk₀, freeMap_comp]⟩

end PtCompSub

