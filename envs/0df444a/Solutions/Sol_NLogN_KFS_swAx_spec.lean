theorem solution :
    ∃ q₀ : ℕ, ∀ q', q'.Prime → q₀ < q' → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (sh : AModel.Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q → q < sh.length →
      sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
      ∀ (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (xs : List ℤ) (R : List NLogN.Item),
      t.G 0 = NLogN.ints xs ++ R → xs.length = AModel.vol sh → (∀ x ∈ xs, NLogN.zsz x ≤ w) →
      ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFS.swAx q' w sh p q u) t
        (t.upd 0 (NLogN.ints (AModel.pull sh sh (AModel.swapPos p q) 0 xs) ++ R)) c ∧
        (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((AModel.vol sh : ℝ) + 1) * (u : ℝ) ^ τS := by
  obtain ⟨q₀, H⟩ := NLogN.KFS.swW_spec
  refine ⟨q₀, fun q' hq' hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q' hq' hq₀
  refine ⟨K, hK, fun u w sh p q hu hsh hpq hq hpF hqF I t xs R h0 hxl hxw => ?_⟩
  have eS := NLogN.KFS.binShape_split sh hpq hq hpF hqF
  obtain ⟨h1, h2, h3⟩ := NLogN.KFS.pos_sub hsh p q
  obtain ⟨c, Hc, hc⟩ := HK u w (NLogN.KFS.preS sh p) (NLogN.KFS.midS sh p q) (NLogN.KFS.sufS sh q) hu h1 h2 h3 I t xs R h0
    (by rw [eS]; exact hxl) hxw
  rw [eS, NLogN.KFS.len_midS sh hpq hq, NLogN.KFS.len_preS sh (by omega)] at Hc
  rw [eS] at hc
  exact ⟨c, Hc, hc⟩
end
