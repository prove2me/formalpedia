  have h := congrArg (fun M : Matrix (Fin 5) (Fin 5) ℝ => M i j)
    ((metricMatrix_esFaraday hE hx).trans (FG_matrix Φ Ψ x))
  simpa [metricMatrix] using h

/-- The Maxwell quadratic term of the actual field equations, in frame components. -/
theorem faradayQuad_frame (hE : ESData R B D A H W Φ Ψ) {x : Pt 5} (hx : x ∈ esDomain R)
    (k : Fin 5 → ℝ) :
    ∑ a, ∑ b, (∑ c, ∑ d, esFaraday Φ Ψ a c x * esInverse B D A H W c d x *
        esFaraday Φ Ψ b d x) * k a * k b =
      frameQ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2)
        (frameZ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2)
          (deriv Φ (x 1) + W (x 1) * deriv Ψ (x 1)) (deriv Ψ (x 1)) (Ψ (x 1)) (frameInv W x k)) := by
  obtain ⟨hB, hD, hA, hH, hu, hv⟩ := hE.nz hx
  rw [sum_FgF_contract (fun i j => esFaraday Φ Ψ i j x) (fun i j => esInverse B D A H W i j x) k]
  simp only [esFaraday_apply hE hx]
  simp [Fin.sum_univ_five, esInverse, frameQ, frameZ, frameInv]
  field_simp
  ring

end Contraction

