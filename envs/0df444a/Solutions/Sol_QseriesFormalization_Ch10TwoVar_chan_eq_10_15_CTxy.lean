theorem JK_coeff (A e : ℤ) (hA : 0 < A) (w : ℤ → ℚ) (m : ℤ) :
    (JK A e hA w).coeff m = ∑ᶠ r : ℤ, (if thetaQDeg A e r = m then w r else 0) := by
