section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set PaperBox PaperBox.Bounds
open PaperCurve (anchor deviation quickTotalScore quickTotalJ quickTotalScoreBox quickTotalPrimitiveBox quickTotalPrimitiveSlope)
noncomputable section

def cellReal (k l : Knot) (p q z : ℝ) : ℝ :=
  q+interpolate Knot.beta k l p*physicalK p q z+z-PaperCurve.lam+
    (1+max (interpolate Knot.eta k l p-1) 0)*PaperCurve.totalScore z

theorem affineEntry_exact (col : Knot → ℕ) (k l : Knot) (hkl : rank k<rank l) {p : ℚ} (hp : (p:ℝ)∈Icc (rank k) (rank l)) :
    (affineEntry col k l p:ℝ)=interpolate col k l p := by simp [affineEntry,interpolate_eq col k l _ hkl hp,qValue_cast,qRank_cast,qSlope_cast]

theorem cellPoint_exact {k l : Knot} (hkl : rank k<rank l) {p : ℚ} (hp : (p:ℝ)∈Icc (rank k) (rank l)) (q z : ℚ) :
    (cellPoint k l p q z:ℝ)=cellReal k l p q z := by
  have ca (v : ℚ) : ((PaperCurve.qclamp v):ℝ)=PaperCurve.clamp v := by simp [PaperCurve.qclamp,PaperCurve.clamp]
  have cs (v : ℚ) : (quickTotalScore v:ℝ)=PaperCurve.totalScore v := by simp [PaperCurve.qtScore,PaperCurve.totalScore,PaperCurve.qscore_exact,ca]
  have cj (v : ℚ) : (quickTotalJ v:ℝ)=PaperCurve.totalPrimitive v := by
    simp [PaperCurve.qtJ,PaperCurve.totalPrimitive,PaperCurve.qprimitive_exact,ca,PaperCurve.J_score (PaperCurve.clamp_mem _)]
  simp only [cellPoint,cellReal,physicalK,PaperCurve.lam,Rat.cast_add,Rat.cast_mul,Rat.cast_sub,
    Rat.cast_max,Rat.cast_one,Rat.cast_zero,cs,cj,affineEntry_exact _ _ _ hkl hp]

private theorem penalty_aux {k l : Knot} (hkl : rank k<rank l) {p : ℝ} {b : Bounds}
    (hp : b.Holds p) (hd : p∈Icc (rank k) (rank l)) :
    (fastPenaltyBox k l b).Holds (1+max (interpolate Knot.eta k l p-1) 0) := by
  simpa only [fastPenaltyBox,Rat.cast_one] using plus_holds (point_holds 1)
    (posPart_holds (minus_holds (lineRange_sound Knot.eta k l hkl hp hd) (point_holds 1)))

private theorem penalty_aux_slope {k l : Knot} (hkl : rank k<rank l) {p t : ℝ} {b : Bounds}
    (hp : b.Holds p) (ht : b.Holds t) (hd : p∈Icc (rank k) (rank l)) (he : t∈Icc (rank k) (rank l)) :
    Secants (fun x => 1+max (interpolate Knot.eta k l x-1) 0) p t (fastPenaltySlope k l b) := by
  obtain ⟨m,hm,em⟩ := lineRange_secants Knot.eta k l hkl hd he
  have boxed {u : ℝ} (hu : b.Holds u) (h : u∈Icc (rank k) (rank l)) :
      ((lineRange Knot.eta k l b).minus (point 1)).Holds (interpolate Knot.eta k l u-1) := by
    simpa only [Rat.cast_one] using minus_holds (lineRange_sound Knot.eta k l hkl hu h) (point_holds 1)
  obtain ⟨n,hn,en⟩ := clipSlope_sound (boxed hp hd) (boxed ht he)
  refine ⟨n*m,times_holds hn hm,?_⟩
  dsimp at en ⊢;linear_combination en+n*em

theorem cellP_sound {k l : Knot} (hkl : rank k<rank l) {p t q z : ℝ} {i j h : Bounds}
    (hp : i.Holds p) (ht : i.Holds t) (hq : j.Holds q) (hz : h.Holds z)
    (hd : p∈Icc (rank k) (rank l)) (he : t∈Icc (rank k) (rank l)) :
    Secants (fun a => cellReal k l a q z) p t (cellP k l i j h) := by
  obtain ⟨d,hd',ed⟩ := lineRange_secants Knot.beta k l hkl hd he
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds ht hq hz)
  obtain ⟨s,hs,es⟩ := penalty_aux_slope hkl hp ht hd he
  simp only [cellP,cellKBox,PaperCurve.quickTotalPrimitiveBox_eq,PaperCurve.quickTotalPrimitiveSlope_eq,PaperCurve.quickTotalScoreBox_eq]
  refine ⟨d*physicalK p q z-interpolate Knot.beta k l t*f+s*PaperCurve.totalScore z,
    plus_holds (minus_holds (times_holds hd' (physicalK_holds hp hq hz))
      (times_holds (lineRange_sound Knot.beta k l hkl ht he) hf)) (times_holds hs (PaperCurve.totalScoreBox_holds hz)),?_⟩
  dsimp [cellReal,physicalK] at es ⊢
  linear_combination (PaperCurve.totalPrimitive (z-p+q)-PaperCurve.totalPrimitive z-PaperCurve.totalPrimitive q)*ed+
    (interpolate Knot.beta k l t)*ef+(PaperCurve.totalScore z)*es

theorem cellQ_sound {k l : Knot} (hkl : rank k<rank l) {p q t z : ℝ} {i j h : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (ht : j.Holds t) (hz : h.Holds z) (hd : p∈Icc (rank k) (rank l)) :
    Secants (fun a => cellReal k l p a z) q t (cellQ k l i j h) := by
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds hp ht hz)
  obtain ⟨g,hg,eg⟩ := PaperCurve.totalPrimitive_secant hq ht
  simp only [cellQ,PaperCurve.quickTotalPrimitiveSlope_eq]
  refine ⟨1+interpolate Knot.beta k l p*(f-g),plus_holds (by simpa using point_holds 1)
    (times_holds (lineRange_sound Knot.beta k l hkl hp hd) (minus_holds hf hg)),?_⟩
  dsimp [cellReal,physicalK];linear_combination (interpolate Knot.beta k l p)*(ef-eg)

theorem cellZ_sound {S : Bounds → Bounds} {k l : Knot} (hkl : rank k<rank l) {p q z t : ℝ} {i j h : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (hz : h.Holds z) (ht : h.Holds t) (hd : p∈Icc (rank k) (rank l))
    (hS : Secants PaperCurve.totalScore z t (S h)) :
    Secants (fun a => cellReal k l p q a) z t (cellZ S k l i j h) := by
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds hp hq ht)
  obtain ⟨g,hg,eg⟩ := PaperCurve.totalPrimitive_secant hz ht
  obtain ⟨s,hs,es⟩ := hS
  simp only [cellZ,PaperCurve.quickTotalPrimitiveSlope_eq]
  refine ⟨1+interpolate Knot.beta k l p*(f-g)+(1+max (interpolate Knot.eta k l p-1) 0)*s,
    plus_holds (plus_holds (by simpa using point_holds 1)
      (times_holds (lineRange_sound Knot.beta k l hkl hp hd) (minus_holds hf hg))) (times_holds (penalty_aux hkl hp hd) hs),?_⟩
  dsimp [cellReal,physicalK];linear_combination (interpolate Knot.beta k l p)*(ef-eg)+(1+max (interpolate Knot.eta k l p-1) 0)*es

end
end StableVotingDistortion.PaperMiddle
end

