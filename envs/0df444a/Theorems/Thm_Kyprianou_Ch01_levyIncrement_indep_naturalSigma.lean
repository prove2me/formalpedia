-- title:
--   Independence of future Lévy increments from the Chapter 1 natural filtration
-- statement:
--   For a real Lévy process with measurable evaluations, the increment X(t)-X(s), t≥s, is independent of the sigma-algebra generated by observations of the process through time s. This connects the LeanLevy proven natural-filtration independence theorem with the Kyprianou Chapter 1 filtration.
-- source:
--   Kyprianou (2006), Chapter 1 Exercises 1.1 and 1.5; reuses the proved LeanLevy theorem ProbabilityTheory.HasIndependentIncrements.indep_naturalFiltration.

import Mathlib
import Definitions.Def_Kyprianou_Ch01_McKeanBrownianStopping
import Theorems.Thm_ProbabilityTheory_HasIndependentIncrements_indep_naturalFiltration
open MeasureTheory ProbabilityTheory Kyprianou.Ch01
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch01.levyIncrement_indep_naturalSigma
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℝ≥0 → Ω → ℝ)
    (hX : IsLevyProcess X P)
    (hmeas : ∀ t : ℝ≥0, Measurable (X t))
    (s t : ℝ≥0) (hst : s ≤ t) :
    Indep (MeasurableSpace.comap
        (fun ω : Ω => X t ω - X s ω) inferInstance)
      (naturalSigma X s) P := by sorry
