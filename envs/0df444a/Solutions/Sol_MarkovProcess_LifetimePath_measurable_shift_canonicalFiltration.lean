/-!
# Canonical filtration of lifetime paths

The raw canonical filtration is generated by the cemetery-valued coordinates up to each time.
The lifetime is a stopping time because death by time `t` is exactly the event that the time-`t`
coordinate is the cemetery state.
-/

open MeasureTheory
open scoped ENNReal


variable {alpha : Type*} [TopologicalSpace alpha] [MeasurableSpace alpha]







namespace MarkovProcess.LifetimePath

end MarkovProcess.LifetimePath
open MarkovProcess.LifetimePath
theorem solution (S t : NNReal) :
    Measurable[canonicalFiltration (alpha := alpha) (S + t),
      canonicalFiltration (alpha := alpha) t]
      (shift S : LifetimePath alpha → LifetimePath alpha) := by
  apply Measurable.of_comap_le
  rw [canonicalFiltration, MeasurableSpace.comap_iSup]
  rw [iSup_le_iff]
  intro u
  rw [MeasurableSpace.comap_comp]
  have hfun : coordinate (α := alpha) u ∘ shift S = coordinate (S + u) := by
    funext omega
    exact coordinate_shift S u omega
  rw [hfun]
  exact le_iSup_of_le
    (⟨S + u, by simpa only [add_comm] using! add_le_add_left u.property S⟩ :
      Set.Iic (S + t)) le_rfl
