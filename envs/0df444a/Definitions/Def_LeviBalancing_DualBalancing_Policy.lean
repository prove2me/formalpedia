-- title:
--   §2 and §4.1, pp. 288–293 — demand process, feasible nonanticipatory policies, expected cost $E[\mathcal C(P)]$ and the dual-balancing policy
-- statement:
--   This file fixes the stochastic layer of the model of Levi, Pál, Roundy and Shmoys (2007): demands, information, feasible policies, expected cost and the dual-balancing policy of §4.1.
--
--   **Information and demand.** Let $(\Omega, \mathcal F, \mathbb P)$ be a probability space and $(\mathcal F_s)_s$ a filtration indexed by periods: $\mathcal F_s$ is the information available at the beginning of period $s$. A **demand process** consists of random demands $D_1, \dots, D_T$ such that for each $t$:
--
--   1. $D_t \ge 0$;
--   2. $D_t$ is $\mathcal F_{t+1}$-measurable (the realized demand of period $t$ is known at the beginning of period $t+1$).
--
--   No independence, stationarity or Markov structure is assumed, and no unconditional integrability of the demands: the integrability a statement needs is carried by that statement (the costs of a dual-balancing policy below; the demands in the existence theorem).
--
--   **Feasible policies.** A feasible (nonanticipatory) policy $P$ is an order process $Q^P_1, \dots, Q^P_T$ with $Q^P_t \ge 0$ and $Q^P_t$ measurable with respect to $\mathcal F_t$. Along each outcome $\omega$, the objects of the deterministic model (positions $X^P_t, Y^P_t$, marginal costs $H^P_t$, $\Pi^P_t$ and the cost $\mathcal C(P)$ of Eq. (4)) are evaluated on the realized demands and orders. The **expected cost** of $P$ is
--   $$E[\mathcal C(P)] = \int_\Omega \mathcal C(P)(\omega)\, d\mathbb P(\omega) \in [0, \infty].$$
--
--   **Dual-balancing policy.** An order process $B$ is a dual-balancing policy if it is feasible, orders nothing in periods $T - L + 1, \dots, T$, and for each period $t = 1, \dots, T - L$ the marginal costs $H^B_t$ and $\Pi^B_t$ are integrable and balanced in conditional expectation:
--   $$E\bigl[H^B_t \mid \mathcal F_t\bigr] = E\bigl[\Pi^B_t \mid \mathcal F_t\bigr] \quad \text{almost surely.}$$
--   In words, in each period the policy orders the quantity at which the expected holding cost the new units will ever incur equals the expected backlogging penalty incurred one lead time ahead.
--
--   **Formalization Note** The filtration is an arbitrary `Filtration ℤ` to which the demands are adapted with a one-period lag; the paper's information vector $F_s = (D_1, \dots, D_{s-1}, W_1, \dots, W_s)$ is the special case where $\mathcal F_s$ is generated by it. Randomized policies are covered when their randomization is part of the information (the external signals $W$). Expected costs are lower Lebesgue integrals in $[0,\infty]$, so an infinite expected cost is never read as $0$. The dual-balancing rule $l_s^B(q'_s) = \pi_s^B(q'_s)$ of p. 293 is stated in its conditional-expectation form "with probability one, $E[H_t^B \mid F_t] = E[\Pi_t^B \mid F_t]$" (p. 294), with integrability of $H_t^B$ and $\Pi_t^B$ required so that Mathlib's conditional expectation is not the junk value $0$.
-- source:
--   Levi, Pál, Roundy & Shmoys, Approximation Algorithms for Stochastic Inventory Control Models, Math. Oper. Res. 32(2):284–302 (2007), DOI 10.1287/moor.1060.0205, pp. 288–289 (PDF pp. 5–6) §2 information sets and nonanticipatory policies; pp. 292–293 (PDF pp. 9–10) §4.1 the dual-balancing policy; p. 294 (PDF p. 11) balancing in conditional expectation

import Mathlib
import Definitions.Def_LeviBalancing_DualBalancing_Model

noncomputable section

namespace LeviBalancing.DualBalancing

open MeasureTheory
open scoped ENNReal

/-- The demand process of §2 (p. 288) on a probability space `(Ω, μ)` with a filtration `ℱ`
indexed by periods: `ℱ s` is the information available at the beginning of period `s`.
For `t = 1, …, T`, the demand `D t` is nonnegative and known one period later
(`ℱ (t+1)`-measurable, since `f_{t+1}` contains `d_t`). No independence, stationarity or Markov
assumption is made, and no unconditional integrability: the paper only asks that the conditional
expectations `E[D_t | f_s]` be finite, and every statement that needs integrability carries it
itself (the costs of a dual-balancing policy in `IsDualBalancing`, the demands in the existence
theorem). -/
structure DemandProcess {Ω : Type*} [m : MeasurableSpace Ω] (ℱ : Filtration ℤ m)
    (μ : Measure Ω) (T : ℕ) where
  D : ℤ → Ω → ℝ
  nonneg : ∀ t : ℤ, 1 ≤ t → t ≤ (T : ℤ) → ∀ ω, 0 ≤ D t ω
  measurable : ∀ t : ℤ, 1 ≤ t → t ≤ (T : ℤ) → Measurable[ℱ (t + 1)] (D t)

/-- A feasible (nonanticipatory) policy (p. 289), given as its order process `Q`: for each period
`t = 1, …, T` the order `Q t` is nonnegative and is a function of the information `ℱ t`
available at the beginning of period `t`. -/
structure IsFeasiblePolicy {Ω : Type*} [m : MeasurableSpace Ω] (I : Instance)
    (ℱ : Filtration ℤ m) (Q : ℤ → Ω → ℝ) : Prop where
  nonneg : ∀ t : ℤ, 1 ≤ t → t ≤ (I.T : ℤ) → ∀ ω, 0 ≤ Q t ω
  adapted : ∀ t : ℤ, 1 ≤ t → t ≤ (I.T : ℤ) → Measurable[ℱ t] (Q t)

/-- The random marginal holding cost `H_t^P` (Eq. (1)) of the order process `Q`. -/
def randHolding {Ω : Type*} (I : Instance) (D Q : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => marginalHolding I (fun j => D j ω) (fun j => Q j ω) t

/-- The random marginal backlogging cost `Π_t^P` (Eq. (2)) of the order process `Q`. -/
def randBacklog {Ω : Type*} (I : Instance) (D Q : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => marginalBacklog I (fun j => D j ω) (fun j => Q j ω) t

/-- The random inventory position after ordering, `Y_t^P`. -/
def randPositionAfter {Ω : Type*} (I : Instance) (D Q : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => invPositionAfter I (fun j => D j ω) (fun j => Q j ω) t

/-- The expected cost `E[𝒞(P)]` of Eq. (4), as a lower Lebesgue integral in `[0, ∞]` of the
(nonnegative) realized cost; an infinite expected cost is `∞`, never `0`. -/
def expectedCost {Ω : Type*} [MeasurableSpace Ω] (I : Instance) (μ : Measure Ω)
    (D Q : ℤ → Ω → ℝ) : ℝ≥0∞ :=
  ∫⁻ ω, ENNReal.ofReal (marginalCost I (fun j => D j ω) (fun j => Q j ω)) ∂μ

/-- The dual-balancing policy of §4.1 (pp. 292–293), as a property of an order process `B`:
`B` is feasible; it orders nothing in periods `T − L + 1, …, T`; and in each period
`t = 1, …, T − L` its marginal holding and backlogging costs are integrable and balanced in
conditional expectation given the information at the beginning of period `t`,
`E[H_t^B | ℱ t] = E[Π_t^B | ℱ t]` almost surely (the form used on p. 294). -/
structure IsDualBalancing {Ω : Type*} [m : MeasurableSpace Ω] (I : Instance)
    (ℱ : Filtration ℤ m) (μ : Measure Ω) (D B : ℤ → Ω → ℝ) : Prop where
  feasible : IsFeasiblePolicy I ℱ B
  zero_after : ∀ t : ℤ, (I.T : ℤ) - I.L < t → t ≤ (I.T : ℤ) → ∀ ω, B t ω = 0
  integrable_holding : ∀ t : ℤ, 1 ≤ t → t ≤ (I.T : ℤ) - I.L →
    Integrable (randHolding I D B t) μ
  integrable_backlog : ∀ t : ℤ, 1 ≤ t → t ≤ (I.T : ℤ) - I.L →
    Integrable (randBacklog I D B t) μ
  balance : ∀ t : ℤ, 1 ≤ t → t ≤ (I.T : ℤ) - I.L →
    μ[randHolding I D B t | ℱ t] =ᵐ[μ] μ[randBacklog I D B t | ℱ t]

end LeviBalancing.DualBalancing

end


