theorem cost_le_core_sol_aux {Q R A M lam nc t p b aA aC mA mC : ℕ} (hp : 1 ≤ p) (hb : 1 ≤ b) (ht : 1 ≤ t)
    (hA : A ≤ aA * Q + aC) (hM : M ≤ mA * Q + mC) (hQ : Q ≤ 3 * p) (hR : R ≤ p)
    (hlam : lam ≤ 4 * b ^ 2) (hnc : nc * lam ≤ t) (hl : 1 ≤ lam) :
    cCS2 Q R A lam M nc ≤ cK aA aC mA mC * b ^ 4 * t * p ^ 10 := by
  set c := 3 * aA + 3 * mA + aC + mC + 34
  have hY : A + Q + R + M + 30 ≤ c * p := by
