  have h2 : IntMul.OpenAI.R129.P.NLogN.KFM.TrRegs t2 n w m rw rm := h1.upd hd _
  obtain ⟨LE2, hE2⟩ := h2.hEl
  set t3 := t2.upd dst (.int ((IntMul.OpenAI.R129.ℓP n - 1 : ℕ) : ℤ) :: t2.G dst) with ht3
