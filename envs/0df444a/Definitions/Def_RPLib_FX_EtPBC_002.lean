section Geo0

@[reassoc]
theorem etPullCompIso_inv_left {W X Y : Scheme.{u}} (g : W ⟶ X) (f : X ⟶ Y) (V : Y.Etale) :
    ((etPullCompIso g f).inv.app V).left =
      (pullbackLeftPullbackSndIso V.hom f g).hom ≫ (pullback.congrHom rfl rfl).inv := rfl

@[reassoc]
theorem etPullCompIso_inv_fst {W X Y : Scheme.{u}} (g : W ⟶ X) (f : X ⟶ Y) (V : Y.Etale) :
    ((etPullCompIso g f).inv.app V).left ≫ pullback.fst V.hom (g ≫ f) =
      pullback.fst ((etPull f).obj V).hom g ≫ pullback.fst V.hom f := by
  rw [etPullCompIso_inv_left]
  simp

@[reassoc]
theorem etPullCompIso_inv_snd {W X Y : Scheme.{u}} (g : W ⟶ X) (f : X ⟶ Y) (V : Y.Etale) :
    ((etPullCompIso g f).inv.app V).left ≫ pullback.snd V.hom (g ≫ f) =
      pullback.snd ((etPull f).obj V).hom g :=
  MorphismProperty.Over.w ((etPullCompIso g f).inv.app V)

@[reassoc]
theorem etCompAdj_unit_fst {X Y : Scheme.{u}} (f : X ⟶ Y) [Etale f] (V : X.Etale) :
    ((etCompAdj f).unit.app V).left ≫ pullback.fst ((etComp f).obj V).hom f = 𝟙 _ :=
  pullback.lift_fst _ _ _

instance subsingleton_spec_field {Ω : Type u} [Field Ω] : Subsingleton (Spec (CommRingCat.of Ω)) := by
  change Subsingleton (PrimeSpectrum Ω)
  infer_instance

/-- **A rational point is a closed immersion**: `σ : Spec Ω ⟶ V` with `σ ≫ gV` an isomorphism. -/
theorem isClosedImmersion_of_isIso_comp {Ω : Type u} [Field Ω] {V Z : Scheme.{u}} (gV : V ⟶ Z)
    (σ : Spec (CommRingCat.of Ω) ⟶ V) [IsIso (σ ≫ gV)] : IsClosedImmersion σ :=
  isClosedImmersion_of_comp_eq_id (gV ≫ inv (σ ≫ gV)) σ (by rw [← Category.assoc, IsIso.hom_inv_id])

end Geo0

variable {Λ : Type u} [CommRing Λ] {M : ModuleCat.{u} Λ}

section RUq

variable {U₁ U₂ P : Scheme.{u}} (h : U₁ ⟶ U₂) (Φ₂ : U₂ ⟶ P) (Φ₁ : U₁ ⟶ P) (hh : h ≫ Φ₂ = Φ₁)

/-- `V ×_P U₁ ⟶ V ×_P U₂` over `h`. -/
def muq (V : P.Etale) : pullback V.hom Φ₁ ⟶ pullback V.hom Φ₂ :=
  pullback.lift (pullback.fst _ _) (pullback.snd _ _ ≫ h) (by rw [pullback.condition, Category.assoc, hh])

@[reassoc (attr := simp)]
theorem muq_fst (V : P.Etale) : muq h Φ₂ Φ₁ hh V ≫ pullback.fst V.hom Φ₂ = pullback.fst V.hom Φ₁ :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem muq_snd (V : P.Etale) : muq h Φ₂ Φ₁ hh V ≫ pullback.snd V.hom Φ₂ = pullback.snd V.hom Φ₁ ≫ h :=
  pullback.lift_snd _ _ _

end RUq

section M

variable {P P' Y U : Scheme.{u}} (π : Y ⟶ P) (f : P' ⟶ P) (Φ : U ⟶ P') (h : U ⟶ Y) (hh : h ≫ π = Φ ≫ f)

variable [Etale f]

omit [Etale f] in
/-- Sections of `Φ_* G` restrict through `etPull Φ` (generic `G`, so the kernel never unfolds `G`). -/
theorem push_obj_map_hom {X Z : Scheme.{u}} (Ψ : X ⟶ Z) (G : EtSh Λ X) {V W : Z.Etale} (g : V ⟶ W) :
    ((push Ψ Λ).obj G).obj.map g.op = G.obj.map ((etPull Ψ).map g).op := rfl

omit [Etale f] in
theorem mc_apply {A B : ModuleCat.{u} Λ} (g : A ⟶ B) (x : A) : g x = g.hom x := rfl

/-- The transpose along `res f ⊣ f_*`, on sections (generic `F`, `G`, `φ`). -/
theorem resAdj_symm_app {F : EtSh Λ P} {G : EtSh Λ P'} (φ : F ⟶ (push f Λ).obj G) (W : P'.Etale)
    (z : F.obj.obj (op ((etComp f).obj W))) :
    ((((resAdj f Λ).homEquiv F G).symm φ).hom.app (op W)).hom z =
      (G.obj.map ((etCompAdj f).unit.app W).op).hom ((φ.hom.app (op ((etComp f).obj W))).hom z) := by
  rw [Adjunction.homEquiv_counit]
  rfl

/-- The point map underlying `mR` on `W`. -/
def thU (W : P'.Etale) : pullback W.hom Φ ⟶ pullback ((etComp f).obj W).hom π :=
  ((etPull Φ).map ((etCompAdj f).unit.app W)).left ≫ ((etPullCompIso Φ f).inv.app ((etComp f).obj W)).left ≫
    muq h π (Φ ≫ f) hh ((etComp f).obj W)

theorem thU_apply (W : P'.Etale) (u : ((etPull Φ).obj W).left) :
    thU π f Φ h hh W u = muq h π (Φ ≫ f) hh ((etComp f).obj W)
      (((etPullCompIso Φ f).inv.app ((etComp f).obj W)).left
        (((etPull Φ).map ((etCompAdj f).unit.app W)).left u)) :=
  (Scheme.Hom.comp_apply _ _ u).trans (Scheme.Hom.comp_apply _ _ _)

omit [Etale f] in
/-- A map `W ×_{P'} U ⟶ X ×_P Y` over `fst` and `snd ≫ h` is surjective when `U ⟶ P' ×_P Y` is. -/
theorem surj_of_comp (hs : Function.Surjective ⇑(pullback.lift Φ h hh.symm : U ⟶ pullback f π))
    {Wl : Scheme.{u}} (w : Wl ⟶ P') (X : Wl ⟶ P) (hX : w ≫ f = X) (T : pullback w Φ ⟶ pullback X π)
    (h1 : T ≫ pullback.fst X π = pullback.fst w Φ) (h2 : T ≫ pullback.snd X π = pullback.snd w Φ ≫ h) :
    Function.Surjective ⇑T := by
  subst hX
  have eq₁ : w ≫ 𝟙 P' = 𝟙 Wl ≫ w := by rw [Category.comp_id, Category.id_comp]
  have eq₂ : Φ ≫ 𝟙 P' = pullback.lift Φ h hh.symm ≫ pullback.fst f π := by
    rw [Category.comp_id, pullback.lift_fst]
  have e : T = pullback.map w Φ w (pullback.fst f π) (𝟙 _) (pullback.lift Φ h hh.symm) (𝟙 _) eq₁ eq₂ ≫
      (pullbackRightPullbackFstIso f π w).hom := by
    apply pullback.hom_ext
    · rw [h1, Category.assoc, pullbackRightPullbackFstIso_hom_fst]
      exact ((pullback.lift_fst _ _ _).trans (Category.comp_id _)).symm
    · rw [h2, Category.assoc, pullbackRightPullbackFstIso_hom_snd]
      exact ((Category.assoc _ _ _).symm.trans ((eq_whisker (pullback.lift_snd _ _ _) _).trans
        ((Category.assoc _ _ _).trans (whisker_eq _ (pullback.lift_snd _ _ _))))).symm
  have h1' : Function.Surjective ⇑(pullback.map w Φ w (pullback.fst f π) (𝟙 _)
      (pullback.lift Φ h hh.symm) (𝟙 _) eq₁ eq₂) := by
    intro q
    have hq : q ∈ Set.range ⇑(pullback.map w Φ w (pullback.fst f π) (𝟙 _)
        (pullback.lift Φ h hh.symm) (𝟙 _) eq₁ eq₂) := by
      rw [Scheme.Pullback.range_map]
      exact ⟨⟨_, rfl⟩, hs _⟩
    exact hq
  have h2' : Function.Surjective ⇑(pullbackRightPullbackFstIso f π w).hom :=
    (pullbackRightPullbackFstIso f π w).hom.surjective
  rw [e]
  intro q
  obtain ⟨a, rfl⟩ := h2' q
  obtain ⟨b, rfl⟩ := h1' a
  exact ⟨b, Scheme.Hom.comp_apply _ _ _⟩

end M

