    show Divisor.IsPrincipal _
    rw [show (Point.zero : W.Point) = 0 from rfl,
      h0, _root_.map_zero, _root_.map_zero, _root_.map_zero, zero_add, sub_zero]
    exact Divisor.principal.zero_mem
