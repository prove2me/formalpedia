lemma sieve_lower (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) (m : ℕ) (hm : Odd m) (A H : ℕ) :
    (H : ℝ) * WS S m - (TS S m).card
      ≤ (((Ioc A (A + H)).filter (fun n => ∀ p ∈ S, ¬ p ∣ n)).card : ℝ) := by
  classical
  rw [Finset.card_filter]
  push_cast
  calc (H : ℝ) * WS S m - (TS S m).card
      = ∑ t ∈ TS S m, ((-1:ℝ) ^ t.card * ((H : ℝ) / ((∏ p ∈ t, p : ℕ) : ℝ)) - 1) := by
        rw [Finset.sum_sub_distrib, WS, Finset.mul_sum]
        simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
        congr 1
        apply Finset.sum_congr rfl; intro t _
        rw [Nat.cast_prod, div_eq_mul_inv, Finset.prod_inv_distrib]; ring
    _ ≤ ∑ t ∈ TS S m, (-1:ℝ) ^ t.card *
          (((Ioc A (A + H)).filter ((∏ p ∈ t, p) ∣ ·)).card : ℝ) := by
        apply Finset.sum_le_sum; intro t ht
