theorem natCast_val_toZModPow_one (x : ℤ_[p]) :
    (((PadicInt.toZModPow 1 x).val : ℕ) : ZMod p) = PadicInt.toZMod x := by
  have h1 : x - ((PadicInt.toZModPow 1 x).val : ℤ_[p]) ∈ IsLocalRing.maximalIdeal ℤ_[p] := by
