-- Source module: Solutions.ResampleCost
/-!
# §9.8 The complete time bound

* `Ncost`: the normalized cost of Table 1 (cost divided by `V = T p`),
  `dK + pK^{τ-1} + ℓ d^{λ'} + d²(1+ℓ^τ) + d p^{1/2+δ} α + d p^δ + log₂(rp) + p^δ + 1`.
* `Ncost_le`: under the pointwise parameter bounds of §9.2.1
  (`p^ε/12 ≤ d ≤ p^ε`, `p^{εc}/24 ≤ K ≤ p^{εc}`, `ℓ ≤ p/(3d)`, `α ≤ 4 p^{1/4+ε/2}`),
  `Ncost ≤ 50 p^{1-2κ}` with `κ = 2⁻¹⁸²`.
* `concrete_d_bounds`, `concrete_K_bounds`, `concrete_alpha_bound`: the floors/ceilings
  `d = ⌊b^ε⌋`, `K = ⌊d^c⌋`, `α = ⌈(12d²b)^{1/4}⌉` satisfy these bounds with `p = 6b`.
* `kappaBound_of_table`: a correct multitape machine whose time on length `n ≥ n₀` is at most
  `C₀ (V(n) · Ncost(n) + n)` with `V ≤ 48n`, `p = 6 lg n` and parameters obeying the pointwise
  bounds satisfies the campaign statement `KappaBound (2⁻¹⁸²)`, i.e. time `O(n (lg n)^{1-κ})`.
-/

open Real

namespace IntMul.OpenAI.RCost

noncomputable section

def τ : ℝ := 1 - 1 / 2 ^ 50
def δ : ℝ := 1 / 16
def c : ℝ := 1 / 2 ^ 56
def lam' : ℝ := 1 - 1 / 2 ^ 54
def ε : ℝ := 1 / 2 ^ 75
def κ : ℝ := 1 / 2 ^ 182
/-- The common exponent `1 - 2κ`. -/
def es : ℝ := 1 - 2 * κ

/-- Normalized Table 1 cost (all rows after division by `T p`). -/
def Ncost (p d K ℓ α : ℝ) : ℝ :=
  d * K + p * K ^ (τ - 1) + ℓ * d ^ lam' + d ^ 2 * (1 + ℓ ^ τ) + d * p ^ (1 / 2 + δ) * α +
    d * p ^ δ + (ℓ + Real.logb 2 p) + p ^ δ + 1

/-! ### The concrete parameters of §9.2.1 satisfy the pointwise bounds -/

/-! ### Connection to the campaign statement -/

end

end IntMul.OpenAI.RCost

