-- Source module: Solutions.J6SegILSweep4
/-!
# B-line IL, B6 §4: one axis step

At axis `k` the registers hold (`vK`): `σ 0..3 = p, α, h, d`, `σ 4 = #ones`, `σ 5 = T`,
`σ 6 = pre_k`, `σ 8 = k`, `σ 13 = bits_{≥k}`, `σ 14 = bits_{<k}` (reversed), `σ 15 = s_{<k}`
(reversed); `dS = s_{≥k}`.

`axP1`: `σ 9 := b_k`, `σ 10 := s_k` (both also saved on `σ 14`, `σ 15`), `σ 11 := t_k = 2^h (1 +
b_k)`, `σ 7 := post_k = T / (pre_k t_k)`; then `descAx6` is pushed on `dA` by `dup`, `eX` is
called, the descriptor dropped; `axP2`: pop `σ 9, 10, 7`, `σ 6 := pre_k t_k`, pop `σ 11`,
`σ 8 := k + 1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem bsW_get (P : Prm) (n D k : ℕ) (hk : k < (bsW P n D).length) :
    (bsW P n D)[k] = if bL6 P n k then 1 else 0 := by
  simp [bsW, KFM.bitsZ]

theorem svW_get (src : ℕ → ℕ) (D k : ℕ) (hk : k < (svW src D).length) :
    (svW src D)[k] = (src k : ℤ) := by
  simp [svW]

theorem bsW_len (P : Prm) (n D : ℕ) : (bsW P n D).length = D + 1 := by simp [bsW, KFM.bitsZ]
theorem svW_len (src : ℕ → ℕ) (D : ℕ) : (svW src D).length = D + 1 := by simp [svW]

theorem TW_pos (P : Prm) (n D : ℕ) : 0 < TW P n D := by
  unfold TW; rw [total_eq]; positivity

theorem le_TW_pre (P : Prm) (n D k : ℕ) (hk : k ≤ D) :
    preT P n D k ≤ TW P n D ∧ tF6 P n k ≤ TW P n D ∧ postT P n D k ≤ TW P n D ∧
      preT P n D k * tF6 P n k ≤ TW P n D := by
  have e := pre_t_post P n D k hk
  have h1 : 0 < postT P n D k := by
    have := TW_pos P n D; unfold TW at this; rw [← e] at this
    exact Nat.pos_of_mul_pos_left this
  have h2 : 0 < tF6 P n k := by unfold tF6; split_ifs <;> positivity
  have h3 : 0 < preT P n D k := by rw [preT_pow P n D k (by omega)]; positivity
  unfold TW; rw [← e]
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc preT P n D k ≤ preT P n D k * tF6 P n k := Nat.le_mul_of_pos_right _ h2
      _ ≤ _ := Nat.le_mul_of_pos_right _ h1
  · calc tF6 P n k ≤ preT P n D k * tF6 P n k := Nat.le_mul_of_pos_left _ h3
      _ ≤ _ := Nat.le_mul_of_pos_right _ h1
  · exact Nat.le_mul_of_pos_left _ (Nat.mul_pos h3 h2)
  · exact Nat.le_mul_of_pos_right _ h1

end J6Seg

end

