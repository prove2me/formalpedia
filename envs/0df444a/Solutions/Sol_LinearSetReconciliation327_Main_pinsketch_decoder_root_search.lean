theorem rootSeedProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc Q0 Q1 src cap t : ℕ) (σ : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootSeedProcedure pc))
    (hmeta : (107 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (ht : 1 ≤ t) (hcap : 1 ≤ cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : Q1 < 2 ^ E.W) (hsrc : 128 ≤ src)
    (hQword : Q0 + t * cap ≤ 2 ^ E.W) (hSword : src + cap ≤ 2 ^ E.W)
    (hdisj : src + cap ≤ Q0 ∨ Q0 + t * cap ≤ src) (hdeg : σ.natDegree < cap)
