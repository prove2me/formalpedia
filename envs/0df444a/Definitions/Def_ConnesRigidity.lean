instance paperVectorDistribMulAction : DistribMulAction K V where
  smul k v := kLinear k v
  one_smul v := by
    change kLinear 1 v = v
    simp
  mul_smul k l v := by
    change kLinear (k * l) v = kLinear k (kLinear l v)
    rw [map_mul]
    rfl
  smul_zero k := by
    change kLinear k 0 = 0
    exact (kLinear k).map_zero
  smul_add k v w := (kLinear k).map_add v w
