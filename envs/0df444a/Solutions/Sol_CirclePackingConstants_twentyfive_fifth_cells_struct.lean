def cell (S : State) (i j : ℕ) : ℕ := get5 (get5 S i) j

theorem nbeq (a b : ℕ) : Nat.beq a b = decide (a = b) := by
  cases h : Nat.beq a b
  · have : ¬ a = b := fun hab => by rw [hab, Nat.beq_refl] at h; exact absurd h (by simp)
    simp [this]
  · simp [Nat.eq_of_beq_eq_true h]

theorem land_spec (a b : ℕ) (h : Nat.beq (Nat.land a b) a = true) : a &&& b = a :=
  Nat.eq_of_beq_eq_true h

theorem blt_pow_spec (a c n : ℕ) (h : Nat.blt a (Nat.pow c n) = true) : a < c ^ n :=
  Nat.le_of_ble_eq_true h

theorem mod_pow_spec (a c n : ℕ) (h : Nat.beq (Nat.mod a (Nat.pow c n)) 0 = true) :
    a % c ^ n = 0 :=
  Nat.eq_of_beq_eq_true h

theorem xor_sub_lt (M mask n : ℕ) (h : M < 8192 ^ n) : M ^^^ (M &&& mask) < 8192 ^ n := by
  rw [pow8192] at h ⊢
  exact Nat.xor_lt_two_pow h (lt_of_le_of_lt Nat.and_le_left h)

theorem get5_set5 {α : Type} (t : α × α × α × α × α) (i j : ℕ) (v : α) (hj : j < 5) :
    get5 (set5 t i v) j = if j = i then v else get5 t j := by
  interval_cases j <;> rcases i with _ | _ | _ | _ | _ | i <;> simp [get5, set5, nbeq]

theorem get5_clamp {α : Type} (t : α × α × α × α × α) (i : ℕ) : get5 t i = get5 t (min i 4) := by
  rcases i with _ | _ | _ | _ | _ | i
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rw [show min (i + 1 + 1 + 1 + 1 + 1) 4 = 4 by omega]; rfl

theorem cell_upd (S : State) (ci cj v i j : ℕ) (hi : i < 5) (hj : j < 5) :
    cell (set5 S ci (set5 (get5 S ci) cj v)) i j = if i = ci ∧ j = cj then v else cell S i j := by
  unfold cell
  rw [get5_set5 _ _ _ _ hi]
  by_cases h1 : i = ci
  · subst h1
    rw [if_pos rfl, get5_set5 _ _ _ _ hj]
    by_cases h2 : j = cj
    · rw [if_pos h2, if_pos ⟨rfl, h2⟩]
    · rw [if_neg h2, if_neg (fun h => h2 h.2)]
  · rw [if_neg h1, if_neg (fun h => h1 h.1)]

/-! ### Geometry -/

open CirclePackingConstants

/-- `|x - y|` on natural numbers. -/
def adN (x y : Nat) : Nat := Nat.add (Nat.sub x y) (Nat.sub y x)

/-- Squares with offsets `u = a - a' + 27`, `v = b - b' + 27` in cells with offset
`(ex, ey) = (pi + 1 - qi, pj + 1 - qj)` have two corners farther apart than 35 lattice units. -/
def farB (ex ey u v : Nat) : Bool :=
  Nat.blt 1225 (Nat.add (Nat.pow (Nat.succ (adN (Nat.succ u) (Nat.mul 28 ex))) 2)
    (Nat.pow (Nat.succ (adN (Nat.succ v) (Nat.mul 28 ey))) 2))

def allLt : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | n + 1, f => and (f n) (allLt n f)

theorem allLt_iff (n : ℕ) (f : ℕ → Bool) : allLt n f = true ↔ ∀ i, i < n → f i = true := by
  induction n with
  | zero => simp [allLt]
  | succ n ih =>
    simp only [allLt, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.1 hi with h | h
      · exact h2 i h
      · rw [h]; exact h1
    · intro h
      exact ⟨h n (Nat.lt_succ_self n), fun i hi => h i (Nat.lt_succ_of_lt hi)⟩

def tabCheck : Bool :=
  allLt 3 fun ex => allLt 3 fun ey =>
    or (and (Nat.beq ex 1) (Nat.beq ey 1))
      (and (and (Nat.beq (Nat.land (tab ex ey) COMB) (tab ex ey))
                (Nat.blt (tab ex ey) (Nat.pow 8192 4510)))
        (allLt 55 fun u => allLt 55 fun v =>
          or (not (farB ex ey u v)) (Nat.testBit (tab ex ey) (13 * (u * 82 + v)))))

theorem tabCheck_ok : tabCheck = true := by decide +kernel

set_option exponentiation.threshold 10000 in
theorem tab_spec (ex ey : ℕ) (hex : ex < 3) (hey : ey < 3) (hne : ¬(ex = 1 ∧ ey = 1)) :
    tab ex ey &&& COMB = tab ex ey ∧ tab ex ey < 8192 ^ 4510 ∧
      ∀ u v, u < 55 → v < 55 → farB ex ey u v = true →
        (tab ex ey).testBit (13 * (u * 82 + v)) = true := by
  have h := tabCheck_ok
  unfold tabCheck at h
  rw [allLt_iff] at h
  have h1 := h ex hex
  rw [allLt_iff] at h1
  have h2 := h1 ey hey
  rw [Bool.or_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h2
  rcases h2 with ⟨h3, h4⟩ | ⟨⟨h3, h4⟩, h5⟩
  · exact absurd ⟨Nat.eq_of_beq_eq_true h3, Nat.eq_of_beq_eq_true h4⟩ hne
  · refine ⟨land_spec _ _ h3, blt_pow_spec _ _ _ h4, ?_⟩
    · intro u v hu hv hf
      rw [allLt_iff] at h5
      have h6 := h5 u hu
      rw [allLt_iff] at h6
      have h7 := h6 v hv
      rw [hf] at h7
      simpa using h7

theorem adN_le (x y : ℕ) : x ≤ y + adN x y ∧ y ≤ x + adN x y := by
  show x ≤ y + ((x - y) + (y - x)) ∧ y ≤ x + ((x - y) + (y - x))
  omega

/-- The scaled point lies in the unit square `(a, b)` of cell `(i, j)`. -/
def InSq (P : Point) (i j a b : ℕ) : Prop :=
  28 * (i : ℝ) + a ≤ 140 * P.1 ∧ 140 * P.1 ≤ 28 * (i : ℝ) + a + 1 ∧
  28 * (j : ℝ) + b ≤ 140 * P.2 ∧ 140 * P.2 ≤ 28 * (j : ℝ) + b + 1

theorem close_of_not_far (ex ey qi qj pi pj a b a' b' : ℕ) (hex : ex + qi = pi + 1)
    (hey : ey + qj = pj + 1) (ha' : a' < 28) (hb' : b' < 28)
    (hfar : farB ex ey (a + 27 - a') (b + 27 - b') = false) (Pq Pp : Point)
    (hq : InSq Pq qi qj a b) (hp : InSq Pp pi pj a' b') : sqDist Pq Pp ≤ 1 / 16 := by
  have h1 := adN_le (Nat.succ (a + 27 - a')) (Nat.mul 28 ex)
  have h2 := adN_le (Nat.succ (b + 27 - b')) (Nat.mul 28 ey)
  have hsum : ¬ (1225 < (Nat.succ (adN (Nat.succ (a + 27 - a')) (Nat.mul 28 ex))) ^ 2 +
      (Nat.succ (adN (Nat.succ (b + 27 - b')) (Nat.mul 28 ey))) ^ 2) := by
    intro h
    have : farB ex ey (a + 27 - a') (b + 27 - b') = true := Nat.ble_eq_true_of_le h
    rw [hfar] at this
    exact absurd this (by simp)
  generalize adN (Nat.succ (a + 27 - a')) (Nat.mul 28 ex) = n1 at h1 hsum
  generalize adN (Nat.succ (b + 27 - b')) (Nat.mul 28 ey) = n2 at h2 hsum
  have e1 : a + 28 ≤ a' + 28 * ex + n1 := by
    have := h1.1; simp only [Nat.succ_eq_add_one, Nat.mul_eq] at this; omega
  have e2 : a' + 28 * ex ≤ a + 28 + n1 := by
    have := h1.2; simp only [Nat.succ_eq_add_one, Nat.mul_eq] at this; omega
  have e3 : b + 28 ≤ b' + 28 * ey + n2 := by
    have := h2.1; simp only [Nat.succ_eq_add_one, Nat.mul_eq] at this; omega
  have e4 : b' + 28 * ey ≤ b + 28 + n2 := by
    have := h2.2; simp only [Nat.succ_eq_add_one, Nat.mul_eq] at this; omega
  have e1r : (a : ℝ) + 28 ≤ a' + 28 * ex + n1 := by exact_mod_cast e1
  have e2r : (a' : ℝ) + 28 * ex ≤ a + 28 + n1 := by exact_mod_cast e2
  have e3r : (b : ℝ) + 28 ≤ b' + 28 * ey + n2 := by exact_mod_cast e3
  have e4r : (b' : ℝ) + 28 * ey ≤ b + 28 + n2 := by exact_mod_cast e4
  have hexr : (ex : ℝ) + qi = pi + 1 := by exact_mod_cast hex
  have heyr : (ey : ℝ) + qj = pj + 1 := by exact_mod_cast hey
  have hsumr : ((n1 : ℝ) + 1) ^ 2 + ((n2 : ℝ) + 1) ^ 2 ≤ 1225 := by
    have : (n1 + 1) ^ 2 + (n2 + 1) ^ 2 ≤ 1225 := by
      simp only [Nat.succ_eq_add_one] at hsum; omega
    exact_mod_cast this
  obtain ⟨q1, q2, q3, q4⟩ := hq
  obtain ⟨p1, p2, p3, p4⟩ := hp
  have hx : (140 * Pq.1 - 140 * Pp.1) ^ 2 ≤ ((n1 : ℝ) + 1) ^ 2 :=
    sq_le_sq' (by linarith) (by linarith)
  have hy : (140 * Pq.2 - 140 * Pp.2) ^ 2 ≤ ((n2 : ℝ) + 1) ^ 2 :=
    sq_le_sq' (by linarith) (by linarith)
  have hring : (140 * Pq.1 - 140 * Pp.1) ^ 2 + (140 * Pq.2 - 140 * Pp.2) ^ 2 =
      19600 * sqDist Pq Pp := by unfold sqDist; ring
  linarith

/-! ### Invariant -/

def Alive (M a b : ℕ) : Prop := M.testBit (13 * (a * 82 + b)) = true

def InCell (P : Point) (i j M : ℕ) : Prop :=
  ∃ a b, a < 28 ∧ b < 28 ∧ Alive M a b ∧ InSq P i j a b

def CleanN (M : ℕ) : Prop := M &&& COMB = M ∧ M < 8192 ^ 2296

/-- Every cell is a clean bitmap and contains its point in one of its alive squares. -/
def Inv (P : ℕ → ℕ → Point) (S : State) : Prop :=
  ∀ i j, i < 5 → j < 5 → CleanN (cell S i j) ∧ InCell (P i j) i j (cell S i j)

def Sep (P : ℕ → ℕ → Point) : Prop :=
  ∀ i j k l, i < 5 → j < 5 → k < 5 → l < 5 → ¬(i = k ∧ j = l) →
    1 / 16 < sqDist (P i j) (P k l)

theorem guard_spec {qi qj pi pj : ℕ} (h : guard qi qj pi pj = true) :
    qi ≤ pi + 1 ∧ pi ≤ qi + 1 ∧ qj ≤ pj + 1 ∧ pj ≤ qj + 1 ∧ qi < 5 ∧ qj < 5 ∧ pi < 5 ∧ pj < 5 ∧
      ¬(qi = pi ∧ qj = pj) := by
  simp only [guard, Bool.and_eq_true, Nat.ble_eq, Bool.not_eq_true', Bool.and_eq_false_iff,
    Nat.succ_eq_add_one] at h
  obtain ⟨⟨⟨h1, h2⟩, h3, h4⟩, ⟨⟨h5, h6⟩, h7, h8⟩, h9⟩ := h
  refine ⟨h1, h2, h3, h4, by omega, by omega, by omega, by omega, ?_⟩
  rintro ⟨rfl, rfl⟩
  rcases h9 with h | h <;> simp at h

theorem step_def (S : State) (qi qj pi pj : ℕ) :
    step S qi qj pi pj = if guard qi qj pi pj = true then
      set5 S qi (set5 (get5 S qi) qj (cell S qi qj &&&
        ((tab (pi + 1 - qi) (pj + 1 - qj) * cell S pi pj + MADD) >>> 29145)))
      else S := by
  unfold step
  cases guard qi qj pi pj <;> rfl

theorem step_inv (P : ℕ → ℕ → Point) (hsep : Sep P) (S : State) (h : Inv P S)
    (qi qj pi pj : ℕ) : Inv P (step S qi qj pi pj) := by
  rw [step_def]
  split_ifs with hg
  swap
  · exact h
  obtain ⟨g1, g2, g3, g4, g5, g6, g7, g8, g9⟩ := guard_spec hg
  intro i j hi hj
  rw [cell_upd _ _ _ _ _ _ hi hj]
  split_ifs with hij
  swap
  · exact h i j hi hj
  obtain ⟨rfl, rfl⟩ := hij
  obtain ⟨⟨hc1, hc2⟩, a, b, ha, hb, hal, hsq⟩ := h i j hi hj
  obtain ⟨⟨hpc1, hpc2⟩, a', b', ha', hb', hal', hsq'⟩ := h pi pj g7 g8
  refine ⟨⟨?_, lt_of_le_of_lt Nat.and_le_left hc2⟩, a, b, ha, hb, ?_, hsq⟩
  · rw [Nat.and_right_comm, hc1]
  · unfold Alive at hal hal' ⊢
    rw [Nat.testBit_and, hal, Bool.true_and]
    obtain ⟨hX, hXlt, htab⟩ := tab_spec (pi + 1 - i) (pj + 1 - j) (by omega) (by omega) (by omega)
    by_contra hD
    have hfar : farB (pi + 1 - i) (pj + 1 - j) (a + 27 - a') (b + 27 - b') = false := by
      by_contra hf
      have hf' : farB (pi + 1 - i) (pj + 1 - j) (a + 27 - a') (b + 27 - b') = true := by
        simpa using hf
      exact hD (survive _ _ ((a + 27 - a') * 82 + (b + 27 - b')) (a' * 82 + b') (a * 82 + b)
        hX hpc1 hXlt hpc2 (htab _ _ (by omega) (by omega) hf') hal' (by omega))
    have h1 := close_of_not_far (pi + 1 - i) (pj + 1 - j) i j pi pj a b a' b' (by omega) (by omega)
      ha' hb' hfar _ _ hsq hsq'
    have h2 := hsep i j pi pj hi hj g7 g8 g9
    linarith

theorem runCode_inv (P : ℕ → ℕ → Point) (hsep : Sep P) (n : ℕ) :
    ∀ (S : State) (c : ℕ), Inv P S → Inv P (runCode n S c) := by
  induction n with
  | zero => intro S c h; exact h
  | succ n ih =>
    intro S c h
    simp only [runCode]
    exact ih _ _ (step_inv P hsep S h _ _ _ _)

theorem refOK_def (R : State) (ci cj mask ei ej n code sn scode : ℕ) :
    refOK R (ci, cj, mask, ei, ej, n, code, sn, scode) =
      Nat.beq (cell (runCode n (set5 R ci (set5 (get5 R ci) cj (cell R ci cj &&& mask))) code)
        ei ej) 0 := rfl

theorem adv_def (R : State) (ci cj mask ei ej n code sn scode : ℕ) :
    adv R (ci, cj, mask, ei, ej, n, code, sn, scode) =
      runCode sn (set5 R ci (set5 (get5 R ci) cj
        (cell R ci cj ^^^ (cell R ci cj &&& mask)))) scode := rfl

theorem adv_inv (P : ℕ → ℕ → Point) (hsep : Sep P) (R : State) (h : Inv P R) (x : Item)
    (hok : refOK R x = true) : Inv P (adv R x) := by
  obtain ⟨ci, cj, mask, ei, ej, n, code, sn, scode⟩ := x
  rw [adv_def]
  rw [refOK_def] at hok
  have hz := Nat.eq_of_beq_eq_true hok
  apply runCode_inv P hsep
  intro i j hi hj
  rw [cell_upd _ _ _ _ _ _ hi hj]
  split_ifs with hij
  swap
  · exact h i j hi hj
  obtain ⟨rfl, rfl⟩ := hij
  obtain ⟨⟨hc1, hc2⟩, a, b, ha, hb, hal, hsq⟩ := h i j hi hj
  refine ⟨⟨?_, ?_⟩, a, b, ha, hb, ?_, hsq⟩
  · apply Nat.eq_of_testBit_eq
    intro k
    have hk := congrArg (fun m => m.testBit k) hc1
    simp only [Nat.testBit_and] at hk
    simp only [Nat.testBit_and, Nat.testBit_xor]
    revert hk
    cases (cell R i j).testBit k <;> cases COMB.testBit k <;> cases mask.testBit k <;> simp
  · exact xor_sub_lt _ _ _ hc2
  · unfold Alive at hal ⊢
    rw [Nat.testBit_xor, Nat.testBit_and, hal]
    by_contra hm
    have hm' : mask.testBit (13 * (a * 82 + b)) = true := by
      revert hm; cases mask.testBit (13 * (a * 82 + b)) <;> simp
    have hT : Inv P (set5 R i (set5 (get5 R i) j (cell R i j &&& mask))) := by
      intro i' j' hi' hj'
      rw [cell_upd _ _ _ _ _ _ hi' hj']
      split_ifs with hij
      swap
      · exact h i' j' hi' hj'
      obtain ⟨rfl, rfl⟩ := hij
      refine ⟨⟨by rw [Nat.and_right_comm, hc1], lt_of_le_of_lt Nat.and_le_left hc2⟩,
        a, b, ha, hb, ?_, hsq⟩
      unfold Alive
      rw [Nat.testBit_and, hal, hm']; rfl
    have h2 := runCode_inv P hsep n _ code hT
    have hcl : cell (runCode n (set5 R i (set5 (get5 R i) j (cell R i j &&& mask))) code) ei ej =
        cell (runCode n (set5 R i (set5 (get5 R i) j (cell R i j &&& mask))) code)
          (min ei 4) (min ej 4) := by
      unfold cell; rw [get5_clamp _ ei, get5_clamp _ ej]
    obtain ⟨_, a2, b2, _, _, hal2, _⟩ := h2 (min ei 4) (min ej 4) (by omega) (by omega)
    rw [← hcl, hz] at hal2
    unfold Alive at hal2
    simp at hal2

theorem chunk_inv (P : ℕ → ℕ → Point) (hsep : Sep P) :
    ∀ (L : List Item) (R : State), Inv P R → chunkOK R L = true → Inv P (chunkAdv R L)
  | [], _, h, _ => h
  | x :: xs, R, h, hok => by
    simp only [chunkOK, Bool.and_eq_true] at hok
    exact chunk_inv P hsep xs _ (adv_inv P hsep R h x hok.1) hok.2

/-! ### Initial and final states -/

def fullCheck : Bool :=
  and (and (Nat.beq (Nat.land FULL COMB) FULL) (Nat.blt FULL (Nat.pow 8192 2296)))
    (allLt 28 fun a => allLt 28 fun b => Nat.testBit FULL (13 * (a * 82 + b)))

theorem fullCheck_ok : fullCheck = true := by decide +kernel

theorem exists_square (y : ℝ) (h0 : 0 ≤ y) (h1 : y ≤ 28) :
    ∃ a : ℕ, a < 28 ∧ (a : ℝ) ≤ y ∧ y ≤ a + 1 := by
  by_cases h : y < 28
  · refine ⟨⌊y⌋₊, ?_, Nat.floor_le h0, (Nat.lt_floor_add_one y).le⟩
    exact (Nat.floor_lt h0).2 (by exact_mod_cast h)
  · exact ⟨27, by norm_num, by norm_num; linarith, by norm_num; linarith⟩

set_option exponentiation.threshold 10000 in
theorem inv_R0 (P : ℕ → ℕ → Point)
    (hc : ∀ i j : ℕ, i < 5 → j < 5 → (i : ℝ) / 5 ≤ (P i j).1 ∧ (P i j).1 ≤ ((i : ℝ) + 1) / 5 ∧
      (j : ℝ) / 5 ≤ (P i j).2 ∧ (P i j).2 ≤ ((j : ℝ) + 1) / 5) : Inv P R0 := by
  have h := fullCheck_ok
  unfold fullCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  intro i j hi hj
  have hcell : cell R0 i j = FULL := by
    interval_cases i <;> interval_cases j <;> rfl
  rw [hcell]
  obtain ⟨c1, c2, c3, c4⟩ := hc i j hi hj
  obtain ⟨a, ha, ha1, ha2⟩ := exists_square (140 * (P i j).1 - 28 * i) (by linarith) (by linarith)
  obtain ⟨b, hb, hb1, hb2⟩ := exists_square (140 * (P i j).2 - 28 * j) (by linarith) (by linarith)
  refine ⟨⟨land_spec _ _ h1, blt_pow_spec _ _ _ h2⟩, a, b, ha, hb, ?_,
    by linarith, by linarith, by linarith, by linarith⟩
  rw [allLt_iff] at h3
  have h4 := h3 a ha
  rw [allLt_iff] at h4
  exact h4 b hb

def finalCheck (S : State) : Bool :=
  allLt 5 fun i => allLt 5 fun j =>
    and (Nat.blt (cell S i j) (Nat.pow 2 (1066 * (min (4 * i) 12 + 16))))
      (Nat.beq (Nat.mod (cell S i j) (Nat.pow 2 (1066 * min (4 * i) 12))) 0)

theorem final_bound (S : State) (h : finalCheck S = true) (i j a b : ℕ) (hi : i < 5) (hj : j < 5)
    (hb : b < 28) (hal : Alive (cell S i j) a b) :
    min (4 * i) 12 ≤ a ∧ a ≤ min (4 * i) 12 + 15 := by
  unfold finalCheck at h
  rw [allLt_iff] at h
  have h1 := h i hi
  rw [allLt_iff] at h1
  have h2 := h1 j hj
  rw [Bool.and_eq_true] at h2
  obtain ⟨h3, h4⟩ := h2
  have h3' : cell S i j < 2 ^ (1066 * (min (4 * i) 12 + 16)) :=
    blt_pow_spec _ _ _ h3
  have h4' : cell S i j % 2 ^ (1066 * min (4 * i) 12) = 0 :=
    mod_pow_spec _ _ _ h4
  unfold Alive at hal
  constructor
  · by_contra hlt
    have h5 : (cell S i j % 2 ^ (1066 * min (4 * i) 12)).testBit (13 * (a * 82 + b)) = true := by
      rw [Nat.testBit_mod_two_pow, hal]
      simp only [Bool.and_true, decide_eq_true_eq]
      omega
    rw [h4'] at h5
    simp at h5
  · by_contra hgt
    have h5 : cell S i j < 2 ^ (13 * (a * 82 + b)) :=
      lt_of_lt_of_le h3' (Nat.pow_le_pow_right (by norm_num) (by omega))
    rw [Nat.testBit_lt_two_pow h5] at hal
    exact absurd hal (by simp)

theorem shear_of_inv (P : ℕ → ℕ → Point) (S : State) (h : Inv P S) (hf : finalCheck S = true)
    (i j k : ℕ) (hi : i < 5) (hj : j < 5) (hk : k < 5) :
    |(P i j).1 - (P i k).1| ≤ 47 / 400 := by
  obtain ⟨_, a, b, ha, hb, hal, s1, s2, _, _⟩ := h i j hi hj
  obtain ⟨_, a', b', ha', hb', hal', t1, t2, _, _⟩ := h i k hi hk
  obtain ⟨u1, u2⟩ := final_bound S hf i j a b hi hj hb hal
  obtain ⟨v1, v2⟩ := final_bound S hf i k a' b' hi hk hb' hal'
  have w1 : (a : ℝ) ≤ a' + 15 := by exact_mod_cast (by omega : a ≤ a' + 15)
  have w2 : (a' : ℝ) ≤ a + 15 := by exact_mod_cast (by omega : a' ≤ a + 15)
  rw [abs_le]
