-- title:
--   Lemma 4.14 — the labeling algorithm
-- statement:
--   There are one Turing machine $M$ and one constant $C$ such that for every prime $p$, all $p$-groups $G,H$ of class 2 of order $p^n$ with $Z(G)\cong Z(H)$ and $G/Z(G)\cong H/Z(H)$, all labellings and every $\delta\ge1$ ($R'=\mathbb Z/p^\delta$): $M$, on the two Cayley tables and $\delta$, outputs within $\lceil p^{Cn^{17/9}(\log p)^{8/9}}\rceil$ steps a list of at most $\lceil p^{Cn^{17/9}(\log p)^{8/9}}\rceil$ pairs $\lambda_i:D_{p^\delta}(G)\to R'^{\kappa_i}$, $\lambda'_i:D_{p^\delta}(H)\to R'^{\kappa_i}$ with $1\le\kappa_i\le n^2$ such that (1) $\lambda_i$, $\lambda'_i$ are additive; (2) there is $Z(G)\le J_i\le D_{p^\delta}(G)$ such that $D_{p^\delta}(G)$ is generated by $J_i$ and at most $C\delta^2n^{4/9}(\log p)^2$ further elements of $D_{p^\delta}(G)$, and the group generated by $[g,j]$, $g\in D_{p^\delta}(G)$ with $\lambda_i(g)=0$, $j\in J_i$, has a generating set of at most that size; (3) if $G\cong H$ then for some $i$ there is an isomorphism $f$ with $f(D_{p^\delta}(G))=D_{p^\delta}(H)$ and $\lambda_i(g)=\lambda'_i(f(g))$ for all $g\in D_{p^\delta}(G)$.
--
--   Differences from the source:
--   - encoding: an algorithm, no machine model fixed; inputs are groups, restrictions, tensors or matrix tuples → one Mathlib multi-stack Turing machine run through the published HMBinPacking.OutputsWithin, on binary codes built from the published encodeNat (groups by labelled Cayley tables, every labelling quantified); reason: Turing machines and RAMs simulate each other with polynomial overhead; any standard code differs polynomially
--   - reading: 'there is an algorithm … in time p^{O(·)}' (the O-constant and the algorithm unspecified in their dependence on p) → one machine and one constant C chosen before the prime p and every other input; reason: the paper presents 'a general algorithm that works for all the possible p-groups of class 2' (p. 8, PDF p. 10); the uniform reading is the stronger one
--   - encoding: real-valued bounds p^{x} → ⌈p^x⌉ in ℕ (ppow), natural logarithms; reason: step counts are natural numbers; rounding up changes no bound
--   - encoding: λ_i : D_{p^δ}(G) → (R')^{κ_i}, a set of pairs → functions on G whose values off D_{p^δ}(G) are never read or coded; a list of Σ-pairs; reason: a function on a subgroup is the restriction of a function on the group
--   - reading: the labeling algorithm outputs a positive integer κ_i (PDF 24) → 0 < κ_i as well as κ_i ≤ n²; reason: the theorem inherits the algorithm’s declared output domain
-- source:
--   Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), Lemma 4.14, p. 22 (PDF p. 24)

import Mathlib
import Definitions.Def_GroupIsoPoly_encPair
import Definitions.Def_HMBinPacking_OutputsWithin
import Definitions.Def_SunGroupIso_Class2_Restriction

set_option autoImplicit false

open scoped Classical commutatorElement

namespace SunGroupIso.Class2

open ExponomialAssortment.FPTAS (encodeNat)
open GroupIsoPoly (encPair cayley)

/-- **Lemma 4.14** (Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), Lemma 4.14, pp. 22–23, PDF pp. 24–25). For `p`-groups `G, H` of class 2
(order `p^n`) with `Z(G) ≅ Z(H)` and `G/Z(G) ≅ H/Z(H)`, and `R' = Z/p^δZ`, a labeling algorithm with running
time `p^{O(n^{17/9}(log p)^{8/9})}` creates `p^{O(n^{17/9}(log p)^{8/9})}` pairs `λ_i : D_{p^δ}(G) → R'^{κ_i}`,
`λ'_i : D_{p^δ}(H) → R'^{κ_i}`, `κ_i ≤ n^2`, with: (1) `λ_i, λ'_i` additive; (2) a subgroup
`Z(G) ≤ J_i ≤ D_{p^δ}(G)` such that `D_{p^δ}(G)` is generated by `J_i` and `O(δ^2 n^{4/9}(log p)^2)` other
elements, and the group generated by `[g, J_i]` over `g ∈ D_{p^δ}(G)` with `λ_i(g) = 0` has a generating set of
that size; (3) if `G ≅ H`, some pair and some isomorphism `f` have `f(D_{p^δ}(G)) = D_{p^δ}(H)` and
`λ_i(g) = λ'_i(f(g))` on `D_{p^δ}(G)`. -/
theorem lemma_4_14 :
    ∃ M : Turing.TM2ComputableAux Bool Bool, ∃ C : ℕ,
      ∀ (p n N : ℕ) (G H : Type) [Group G] [Group H] [Finite G] [Finite H]
        (eG : G ≃ Fin N) (eH : H ≃ Fin N) (δ : ℕ),
        p.Prime → IsPGroupClass2 p G → IsPGroupClass2 p H → Nat.card G = p ^ n → 0 < δ →
        Nonempty (Subgroup.center G ≃* Subgroup.center H) → Nonempty (Qt G ≃* Qt H) →
        let K : ℕ := ppow p (C * (n : ℝ) ^ ((17 : ℝ) / 9) * Real.log p ^ ((8 : ℝ) / 9))
        let s : ℝ := C * (δ : ℝ) ^ 2 * (n : ℝ) ^ ((4 : ℝ) / 9) * Real.log p ^ 2
        let inp : List Bool := encPair N (cayley eG) (cayley eH) ++ encUnary δ
        ∃ L : List (Σ κ : ℕ, (G → Fin κ → ZMod (p ^ δ)) × (H → Fin κ → ZMod (p ^ δ))),
          L.length ≤ K ∧
          (∀ κ lam lam', ⟨κ, lam, lam'⟩ ∈ L →
            0 < κ ∧ κ ≤ n ^ 2 ∧
            (∀ g ∈ Dsub p δ G, ∀ g' ∈ Dsub p δ G, lam (g * g') = lam g + lam g') ∧
            (∀ h ∈ Dsub p δ H, ∀ h' ∈ Dsub p δ H, lam' (h * h') = lam' h + lam' h') ∧
            ∃ J : Subgroup G, J ≤ Dsub p δ G ∧ Subgroup.center G ≤ J ∧
              (∃ S : List G, (S.length : ℝ) ≤ s ∧ (∀ x ∈ S, x ∈ Dsub p δ G) ∧
                Subgroup.closure ((J : Set G) ∪ {x | x ∈ S}) = Dsub p δ G) ∧
              (∃ S : List G, (S.length : ℝ) ≤ s ∧
                Subgroup.closure {x | x ∈ S} =
                  Subgroup.closure {c | ∃ g ∈ Dsub p δ G, lam g = 0 ∧ ∃ j ∈ J, c = ⁅g, j⁆})) ∧
          (Nonempty (G ≃* H) →
            ∃ κ lam lam', ⟨κ, lam, lam'⟩ ∈ L ∧ ∃ f : G ≃* H,
              (Dsub p δ G).map f.toMonoidHom = Dsub p δ H ∧ ∀ g ∈ Dsub p δ G, lam g = lam' (f g)) ∧
          HMBinPacking.OutputsWithin M inp
            (encList (fun x => encodeNat x.1 ++ encLabel eG p δ x.2.1 ++ encLabel eH p δ x.2.2) L)
            (K) := by sorry

end SunGroupIso.Class2
