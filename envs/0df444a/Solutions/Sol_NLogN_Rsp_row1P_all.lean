section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.Rsp
open IntMul NLogN RS
theorem solution (T RK : Fin NLogN.HS) (hd : NLogN.Rsp.TDist T NLogN.Rsp.TCI NLogN.Rsp.TCK NLogN.Rsp.TRI RK) (hTR : T ≠ NLogN.Rsp.TRI) (hRR : RK ≠ NLogN.Rsp.TRI)
    (wP : NLogN.RS) (s0 : NLogN.IState NLogN.HS) (NK : ℕ) (wf : ℕ → ℕ → ℤ) (Cw : ℕ)
    (hw : NLogN.Rsp.WSpec wP T NLogN.Rsp.TCI NLogN.Rsp.TCK (s0.upd NLogN.Rsp.TRI (.int 1 :: s0.G NLogN.Rsp.TRI)) 1 NK wf Cw) (LK : List NLogN.Item)
    (hRK : s0.G RK = .int (NK : ℤ) :: LK) :
    (NLogN.Rsp.row1P T RK wP).ok s0 ∧
      (NLogN.Rsp.row1P T RK wP).run s0 = s0.upd T (NLogN.ints ((List.range NK).map (wf 0)) ++ s0.G T) ∧
      (NLogN.Rsp.row1P T RK wP).cost s0 ≤ NLogN.Rsp.tabCost 1 NK Cw + 10 ^ 9 := by
  obtain ⟨s1, h1⟩ : ∃ q, q = s0.upd NLogN.Rsp.TRI (.int 1 :: s0.G NLogN.Rsp.TRI) := ⟨_, rfl⟩
  have e1 : (NLogN.RS.push NLogN.Rsp.TRI (.lit 1)).run s0 = s1 := by rw [h1]; exact NLogN.Rsp.push_run_val _ _ _ _ rfl
  rw [← h1] at hw
  have H := NLogN.Rsp.tabP_all hd hw (s0.G NLogN.Rsp.TRI) LK (by rw [h1]; simp)
    (by rw [h1]; simp [hRR, hRK])
  rw [NLogN.Rsp.tabL_one] at H
  have g : (s1.upd T (NLogN.ints ((List.range NK).map (wf 0)) ++ s1.G T)).G NLogN.Rsp.TRI =
      .int 1 :: s0.G TRI := by rw [h1]; simp [hTR.symm]
  have e3 := NLogN.Rsp.pop_run_val NLogN.Rsp.TRI _ _ _ g
  have hfin : (s1.upd T (NLogN.ints ((List.range NK).map (wf 0)) ++ s1.G T)).upd NLogN.Rsp.TRI (s0.G NLogN.Rsp.TRI) =
      s0.upd T (NLogN.ints ((List.range NK).map (wf 0)) ++ s0.G T) := by
    apply NLogN.IState.ext' _ (by rw [h1]; simp) (by rw [h1]; simp)
    intro x; rw [h1]; simp only [NLogN.IState.upd_G]
    by_cases a : x = NLogN.Rsp.TRI
    · subst a; simp [hTR.symm]
    · by_cases b : x = T
      · subst b; simp [hTR]
      · simp [a, b]
  refine ⟨?_, ?_, ?_⟩
  · refine ⟨⟨by decide, by simp [NLogN.Ex.Clean, NLogN.Ex.regs], trivial⟩, ?_⟩
    rw [e1]; exact ⟨H.1, by rw [H.2.1]; exact ⟨by decide, NLogN.IState.isInt_of g⟩⟩
  · simp only [NLogN.Rsp.row1P, NLogN.RS.run_seq, e1, H.2.1, e3, hfin]
  · simp only [NLogN.Rsp.row1P, NLogN.RS.cost_seq', NLogN.RS.run_seq, e1, H.2.1]
    have c1 := NLogN.RS.pushCost_le (.lit 1) s0 1 (by simp [NLogN.Ex.Bnd, NLogN.zsz_one])
    simp only [NLogN.RS.cost, NLogN.IState.top_eq g]
    have c3 : 2 * NLogN.zsz (1 : ℤ) + 2 ≤ 4 := by simp [NLogN.zsz_one]
    have c2 := H.2.2
    have : (NLogN.Ex.lit (S := NLogN.HS) 1).size = 1 := rfl
    rw [this] at c1
    norm_num at c1
    omega
end
