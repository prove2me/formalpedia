structure EngineDatum (E V : Type) [Fintype E] [Fintype V] [DecidableEq E] [DecidableEq V] where

  D : DegeneracyData E V

  wV : V → ℕ

  TE : Nat.Primes → Matrix E E ℤ

  adjE : Nat.Primes → Matrix E E ℤ

  TV : Nat.Primes → Matrix V V ℤ

  adjV : Nat.Primes → Matrix V V ℤ

  s : Nat.Primes

  π : Equiv.Perm E

  padj : Fin 2 → ((V → ℤ) →ₗ[ℤ] (E → ℤ))

  S : Finset Nat.Primes

  wV_pos : ∀ v, 0 < wV v
  s_mem : s ∈ S
  commE : ∀ ℓ ℓ' : Nat.Primes, Commute (TE ℓ) (TE ℓ')
  commAdjE : ∀ ℓ ℓ' : Nat.Primes, Commute (adjE ℓ) (adjE ℓ')
  commV : ∀ ℓ ℓ' : Nat.Primes, Commute (TV ℓ) (TV ℓ')
  commAdjV : ∀ ℓ ℓ' : Nat.Primes, Commute (adjV ℓ) (adjV ℓ')
  degE : ∀ (ℓ : Nat.Primes) (x : E → ℤ), x ∈ characterLattice E → (TE ℓ).mulVec x ∈ characterLattice E
  degAdjE : ∀ (ℓ : Nat.Primes) (x : E → ℤ), x ∈ characterLattice E → (adjE ℓ).mulVec x ∈ characterLattice E
  degV : ∀ (ℓ : Nat.Primes) (x : V → ℤ), x ∈ characterLattice V → (TV ℓ).mulVec x ∈ characterLattice V
  degAdjV : ∀ (ℓ : Nat.Primes) (x : V → ℤ), x ∈ characterLattice V → (adjV ℓ).mulVec x ∈ characterLattice V
  kerE : ∀ (ℓ : Nat.Primes) (x : E → ℤ), x ∈ ribbonKernel D → (TE ℓ).mulVec x ∈ ribbonKernel D
  kerAdjE : ∀ (ℓ : Nat.Primes) (x : E → ℤ), x ∈ ribbonKernel D → (adjE ℓ).mulVec x ∈ ribbonKernel D
  adjE_law : ∀ (ℓ : Nat.Primes) (x y : E → ℤ),
    widthPairing (fun e => (D.w e : ℕ)) ((TE ℓ).mulVec x) y = widthPairing (fun e => (D.w e : ℕ)) x ((adjE ℓ).mulVec y)
  adjV_law : ∀ (ℓ : Nat.Primes) (x y : V → ℤ), widthPairing wV ((TV ℓ).mulVec x) y = widthPairing wV x ((adjV ℓ).mulVec y)

  adjE_off : ∀ ℓ : Nat.Primes, ℓ ∉ S → adjE ℓ = TE ℓ
  adjV_off : ∀ ℓ : Nat.Primes, ℓ ∉ S → adjV ℓ = TV ℓ
  symE_off : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeWeightSymm (fun e => (D.w e : ℕ)) (TE ℓ).transpose
  symV_off : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeWeightSymm wV (TV ℓ).transpose

  adjV_s : adjV s = TV s
  eqv : ∀ ℓ : Nat.Primes, ℓ ≠ s → ∀ (i : Fin 2) (x : E → ℤ),
    jointDelta D i ((TE ℓ).mulVecLin x) = (TV ℓ).mulVecLin (jointDelta D i x)

  eqvAdj : ∀ ℓ : Nat.Primes, ℓ ≠ s → ∀ (i : Fin 2) (x : E → ℤ),
    jointDelta D i ((adjE ℓ).mulVecLin x) = (adjV ℓ).mulVecLin (jointDelta D i x)

  hadj : ∀ (i : Fin 2) (x : V → ℤ) (y : E → ℤ),
    (∑ v, (wV v : ℤ) * (degeneracyMatrix (![D.a, D.b] i)).mulVec y v * x v) = ∑ e, (D.w e : ℤ) * y e * padj i x e
  c3_deg : ∀ (i : Fin 2) (x : V → ℤ), (degeneracyMatrix (![D.a, D.b] i)).mulVec (padj i x) = (((s : ℕ) : ℤ) + 1) • x
  c3_ab : ∀ x : V → ℤ, (degeneracyMatrix D.a).mulVec (padj 1 x) = (TV s).mulVec x
  c3_ba : ∀ x : V → ℤ, (degeneracyMatrix D.b).mulVec (padj 0 x) = (TV s).mulVec x
  c3_Ua : ∀ y : E → ℤ, (degeneracyMatrix D.a).mulVec ((TE s).mulVec y) =
    (TV s).mulVec ((degeneracyMatrix D.a).mulVec y) - (degeneracyMatrix D.b).mulVec y
  c3_Ub : ∀ y : E → ℤ, (degeneracyMatrix D.b).mulVec ((TE s).mulVec y) = ((s : ℕ) : ℤ) • (degeneracyMatrix D.a).mulVec y

  c3bis_a : ∀ e : E, D.a (π e) = D.b e
  c3bis_b : ∀ e : E, D.b (π e) = D.a e
  c3bis_inv : ∀ e : E, π (π e) = e
  c3bis_w : ∀ e : E, D.w (π e) = D.w e
  adjE_s : ∀ i j : E, adjE s i j = TE s (π i) (π j)

  padj_π : ∀ (x : V → ℤ) (e : E), padj 1 x e = padj 0 x (π e)

  onto : ∀ x y : V → ℤ, x ∈ characterLattice V → y ∈ characterLattice V →
    ∃ d : E → ℤ, d ∈ characterLattice E ∧ (degeneracyMatrix D.a).mulVec d = x ∧ (degeneracyMatrix D.b).mulVec d = y

  rowV : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeRowSums (TV ℓ).transpose (((ℓ : ℕ) : ℤ) + 1)
  rowE : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeRowSums (TE ℓ).transpose (((ℓ : ℕ) : ℤ) + 1)
  divV : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeOffDiagDivides wV (TV ℓ).transpose
  divE : ∀ ℓ : Nat.Primes, ℓ ∉ S → HeckeOffDiagDivides (fun e => (D.w e : ℕ)) (TE ℓ).transpose

