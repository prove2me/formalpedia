    centerALowerYBox.Contains (Y (lower E8TAxisProd0181PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0181PaddedInputs.centerAInput.alpha = ((3482318024844347500022322904444928295572329716 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
