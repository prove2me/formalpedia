def W_scale : Nat := 1000000000
def D_in : Nat := 22892544
def A1_num : Nat := 7948800
def B1_num : Nat := 9420800
def A2_num : Nat := 9420800
def B2_num : Nat := 9953280
def S_step_in : Nat := 178848
def D_out : Nat := 4349952
def A0_num : Nat := 1228800
def B0_num : Nat := 1510400
def StepPhi : Nat := 33984

def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

theorem le_mul_ceilDiv {a b : Nat} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
  unfold ceilDiv
  have h1 := Nat.div_add_mod (a + b - 1) b
  have h2 := Nat.mod_lt (a + b - 1) hb
  omega

def wInv (a b : Nat) : Nat :=
  ceilDiv (W_scale * (b * b - a * a)) (2 * a * b)

def wInvSqIn (a b : Nat) : Nat :=
  ceilDiv (W_scale * D_in * (b - a)) (a * b)

def sumUpTo : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | n + 1, f => sumUpTo n f + f n

def N1_of (m : Nat) : Nat :=
  if 14 ≤ m && m < 30 then 32
  else if 6 ≤ m && m < 38 then 16
  else 8

def N2_of (m : Nat) : Nat :=
  if 14 ≤ m && m < 30 then 16
  else 8

def F_sumWith (ub : Nat → Nat → Nat) (m N1 N2 : Nat) : Nat :=
  let sa := (211 + m) * S_step_in
  let sb := (212 + m) * S_step_in
  let h1 := (B1_num - A1_num) / N1
  let h2 := (B2_num - A2_num) / N2
  sumUpTo N1 fun j =>
    let lo1 := A1_num + j * h1
    let hi1 := lo1 + h1
    let w1 := wInvSqIn lo1 hi1
    w1 * sumUpTo N2 fun k =>
      let lo2 := A2_num + k * h2
      let hi2 := lo2 + h2
      ub (((sa - 2 * hi1 - hi2) * 256) / hi1) (((sb - 2 * lo1 - lo2) * 256) / lo1) * wInv lo2 hi2

