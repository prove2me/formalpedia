theorem GlobalTheory.meanSq_primeFactors_outPart (m₀ m : ℕ) :
    (outPart m₀ m).primeFactors = m.primeFactors.filter (fun p => ¬ p ∣ m₀ ∧ Odd (m.factorization p)) := by sorry
