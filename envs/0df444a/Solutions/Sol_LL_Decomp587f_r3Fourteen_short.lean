      have hl := ihl x0a m x1a x1b x1a x1b hvl (Subset.trans hs1 hsub)
      have hr := ihr m x0b x1a x1b x1a x1b hvr (Subset.trans hs2 hsub)
      refine le_trans hunion (le_trans (add_le_add hl hr) (le_of_eq ?_))
      dsimp only [evalBox]; push_cast; ring
  | sd12 c01 mm c12 ih01 ihm ih12 =>
      intro x0a x0b x1a x1b x2a x2b hval hsub
      simp only [validTree, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, and_assoc] at hval
      rcases hval with ⟨h12a, h12b, h1le, hv1, hv2, hv3⟩
      subst h12a; subst h12b
      set m := (x1a + x1b) / 2
      have hm1 : x1a ≤ m := by omega
      have hm2 : m ≤ x1b := by omega
      have hm1r : (x1a : ℝ) / D_den ≤ (m : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast hm1) (le_of_lt hDpos)
      have hm2r : (m : ℝ) / D_den ≤ (x1b : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast hm2) (le_of_lt hDpos)
      have hs1 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) (le_refl ((x0b : ℝ) / D_den)) (le_refl ((x1a : ℝ) / D_den)) hm2r (le_refl ((x1a : ℝ) / D_den)) hm2r
      have hs2 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) (le_refl ((x0b : ℝ) / D_den)) (le_refl ((x1a : ℝ) / D_den)) hm2r hm1r (le_refl ((x1b : ℝ) / D_den))
      have hs3 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) (le_refl ((x0b : ℝ) / D_den)) hm1r (le_refl ((x1b : ℝ) / D_den)) hm1r (le_refl ((x1b : ℝ) / D_den))
      have hunion := integral_subset_union_three ordBox3_sub_sd12 hf_nn hint_root
        (Subset.trans hs1 hsub) (Subset.trans hs2 hsub) (Subset.trans hs3 hsub)
        (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _)
      have h1 := ih01 x0a x0b x1a m x1a m hv1 (Subset.trans hs1 hsub)
      have h2 := ihm x0a x0b x1a m m x1b hv2 (Subset.trans hs2 hsub)
      have h3 := ih12 x0a x0b m x1b m x1b hv3 (Subset.trans hs3 hsub)
      refine le_trans hunion (le_trans (add_le_add (add_le_add h1 h2) h3) (le_of_eq ?_))
      dsimp only [evalBox]; push_cast; ring
  | sd012 c0 m01 m12 c1 ih0 ih01 ih12 ih1 =>
      intro x0a x0b x1a x1b x2a x2b hval hsub
      simp only [validTree, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, and_assoc] at hval
      rcases hval with ⟨h01a, h12a, h01b, h12b, h0le, hv0, hv01, hv12, hv1⟩
      subst h01a; subst h12a; subst h01b; subst h12b
      set m := (x0a + x0b) / 2
      have hm1 : x0a ≤ m := by omega
      have hm2 : m ≤ x0b := by omega
      have hm1r : (x0a : ℝ) / D_den ≤ (m : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast hm1) (le_of_lt hDpos)
      have hm2r : (m : ℝ) / D_den ≤ (x0b : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast hm2) (le_of_lt hDpos)
      have hs0 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) hm2r (le_refl ((x0a : ℝ) / D_den)) hm2r (le_refl ((x0a : ℝ) / D_den)) hm2r
      have hs01 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) hm2r (le_refl ((x0a : ℝ) / D_den)) hm2r hm1r (le_refl ((x0b : ℝ) / D_den))
      have hs12 := ordBox3_mono (le_refl ((x0a : ℝ) / D_den)) hm2r hm1r (le_refl ((x0b : ℝ) / D_den)) hm1r (le_refl ((x0b : ℝ) / D_den))
      have hs1 := ordBox3_mono hm1r (le_refl ((x0b : ℝ) / D_den)) hm1r (le_refl ((x0b : ℝ) / D_den)) hm1r (le_refl ((x0b : ℝ) / D_den))
      have hunion := integral_subset_union_four ordBox3_sub_sd012 hf_nn hint_root
        (Subset.trans hs0 hsub) (Subset.trans hs01 hsub) (Subset.trans hs12 hsub) (Subset.trans hs1 hsub)
        (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _) (ordBox3_measurable _ _ _ _ _ _)
      have h0 := ih0 x0a m x0a m x0a m hv0 (Subset.trans hs0 hsub)
      have h01 := ih01 x0a m x0a m m x0b hv01 (Subset.trans hs01 hsub)
      have h12 := ih12 x0a m m x0b m x0b hv12 (Subset.trans hs12 hsub)
      have h1 := ih1 m x0b m x0b m x0b hv1 (Subset.trans hs1 hsub)
      refine le_trans hunion (le_trans (add_le_add (add_le_add (add_le_add h0 h01) h12) h1) (le_of_eq ?_))
      dsimp only [evalBox]; push_cast; ring

lemma piece_bound {ω : ℝ → ℝ} {φ : ℝ} {pa_n pb_n : ℕ} {t : BoxTree} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (hpa : (pa_n : ℝ) / D_den ≤ φ) (hpb : φ ≤ (pb_n : ℝ) / D_den)
    (hchk : checkPiece pa_n pb_n t = true) :
    buchstabIntegral ω 1 r3FourteenLo r3FourteenHi φ ≤ (2640381 / 1000000000 : ℝ) := by
  simp only [checkPiece, Bool.and_eq_true, decide_eq_true_eq] at hchk
  rcases hchk with ⟨⟨_, hval⟩, hev⟩
  unfold buchstabIntegral
  rw [domain_eq]
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have h1 := evalBox_sound hω hz hpa hpb t A0_num B0_num A1_num B1_num A2_num B2_num hval (Subset.refl _)
  have h2 : (evalBox pa_n pb_n t A0_num B0_num A1_num B1_num A2_num B2_num : ℝ) /
      ((S_scale : ℝ) * W_scale * W_scale * W_scale) ≤
      (targetBoundNat : ℝ) / ((S_scale : ℝ) * W_scale * W_scale * W_scale) :=
    div_le_div_of_nonneg_right (by exact_mod_cast hev) (by positivity)
  have h3 : (targetBoundNat : ℝ) / ((S_scale : ℝ) * W_scale * W_scale * W_scale) = (2640381 / 1000000000 : ℝ) := by
    unfold targetBoundNat S_scale W_scale; norm_num
  exact le_trans h1 (h3 ▸ h2)

end

