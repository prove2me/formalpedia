variable {E : ℕ}

theorem kTable_mul (ext : Fin E → IStmt HS (7 + E)) :
    ∀ j, kTable ext (gM E j) = (mulProg j).ren ssE (gM E) := by
  intro j
  have hj := j.isLt
  unfold kTable
  rw [dif_neg (show (gM E j).val ≠ 0 by simp [gM]), dif_neg (show (gM E j).val ≠ 1 by simp [gM]),
    dif_pos (show (gM E j).val < 7 by simp [gM]; omega)]
  congr 2

theorem kTable_wrap (ext : Fin E → IStmt HS (7 + E)) :
    kTable ext (pMul E) = mulWrap (gM E) := by
  simp [kTable, pMul]

