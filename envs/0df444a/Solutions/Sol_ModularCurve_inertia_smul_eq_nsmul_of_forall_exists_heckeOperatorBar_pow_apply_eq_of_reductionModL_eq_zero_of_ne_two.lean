  toRingHom := frobenius (Fib p H) p
  commutes' c := by
    show algebraMap (ZMod p) (Fib p H) c ^ p = algebraMap (ZMod p) (Fib p H) c
    exact algebraMap_pow_p p H c

@[scoped simp] private theorem fibFrobAlgHom_apply (x : Fib p H) : fibFrobAlgHom p H x = x ^ p := rfl

