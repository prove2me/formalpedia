theorem floor_sum_le (f : ℕ → ℝ) (hf : ∀ s, 0 ≤ f s) (x : ℝ) (hx : 0 ≤ x) : ∀ l : List ℕ,
    (((l.map fun s => ⌊f s * x⌋₊).sum : ℕ) : ℝ) ≤ (l.map f).sum * x
  | [] => by simp
  | a :: l => by
    have ih := floor_sum_le f hf x hx l
    have ha : (⌊f a * x⌋₊ : ℝ) ≤ f a * x := Nat.floor_le (mul_nonneg (hf a) hx)
    simp only [List.map_cons, List.sum_cons, Nat.cast_add]
    nlinarith

