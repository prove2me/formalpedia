      have h1 : t_hi + sl = (t_lo + sr) + mult * hs := by simp only [t_hi, sr]; ring
      rw [h1, ht_lo_eq]; simp only [step]; ring
    have hH_box : ∀ s ∈ Icc ((sl : ℝ) / D_den) ((sr : ℝ) / D_den),
        H_real (φ - s) ≤ ((H_cert.drop (d * mult)).getD i 0 : ℝ) / S_sc := by
