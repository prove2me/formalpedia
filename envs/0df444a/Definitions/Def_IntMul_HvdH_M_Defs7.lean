/-- The scalar parameters the axis loops read (values on top, anything below). -/
structure Glob (q : Params) (kb : ℕ) (s : IState HS) : Prop where
  p : ∃ L, s.G gp = .int (q.p : ℤ) :: L
  a2 : ∃ L, s.G ga2 = .int ((q.α ^ 2 : ℕ) : ℤ) :: L
  w : ∃ L, s.G gw = .int (sWidth q.p q.α : ℤ) :: L
  w1 : ∃ L, s.G gw1 = .int ((2 * sWidth q.p q.α + 1 : ℕ) : ℤ) :: L
  e : ∃ L, s.G ge = .int (eWidth q.p q.α : ℤ) :: L
  e1 : ∃ L, s.G ge1 = .int ((2 * eWidth q.p q.α + 1 : ℕ) : ℤ) :: L
  be : ∃ L, s.G gbe = .int (betaT q.p q.α) :: L
  p2 : ∃ L, s.G g2p2 = .int (2 ^ (2 * q.p)) :: L
  p1 : ∃ L, s.G g2p = .int (2 ^ q.p) :: L
  kb : ∃ L, s.G gkb = .int (kb : ℤ) :: L
  K : ∃ L, s.G gK = .int (q.K : ℤ) :: L
  Kd : ∃ L, s.G gKd = .int ((q.K - q.dh : ℕ) : ℤ) :: L
  rh : ∃ L, s.G grh = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L
  r : ∃ L, s.G gr = .int ((2 ^ q.e : ℕ) : ℤ) :: L

/-! ## Per-axis quantities -/

/-- Source length of axis `k`. -/
def sK (q : Params) (k : ℕ) : ℕ := q.s.getD k 1

/-- Target length of axis `k`. -/
def tK (q : Params) (k : ℕ) : ℕ := 2 ^ q.te k

/-- `T = ∏ tᵢ`. -/
def TT (q : Params) : ℕ := q.tdims.prod

/-- Axis list before the `S̃` step `k`. -/
def dS (q : Params) (k : ℕ) : List ℕ := q.s.drop k ++ q.tdims.take k

/-- Number of slices of the `S̃` step `k`. -/
def mS (q : Params) (k : ℕ) : ℕ := (q.s.drop (k + 1) ++ q.tdims.take k).prod

/-- Array size before the `S̃` step `k`. -/
def NS (q : Params) (k : ℕ) : ℕ := (dS q k).prod

/-- The array after `k` `S̃` steps. -/
def XS (q : Params) (U : List (ℤ × ℤ)) (k : ℕ) : List (ℤ × ℤ) :=
  tensorGo ((fwdAxS q).take k) q.sdims U

/-- Axis list before the `B̃` step `k`. -/
def dB (q : Params) (k : ℕ) : List ℕ := q.tdims.drop k ++ q.s.take k

/-- Number of slices of the `B̃` step `k`. -/
def mB (q : Params) (k : ℕ) : ℕ := (q.tdims.drop (k + 1) ++ q.s.take k).prod

/-- Array size before the `B̃` step `k`. -/
def NB (q : Params) (k : ℕ) : ℕ := (NLogN.EX.dB q k).prod

/-- The array after `k` `B̃` steps (from the `FtL` output `Y`). -/
def XB (q : Params) (Y : List (ℤ × ℤ)) (k : ℕ) : List (ℤ × ℤ) :=
  tensorGo ((fwdAxB q).take k) q.tdims Y

end NLogN.EX

end

section
-- Source module: NLogN.HEx3
/-!
# The full `fwdL` / `exactConvL` programs, part 3: the scalar expressions of the axis loops

In iteration `k` of an axis loop the counter `cL` holds `K - k`, `xS` holds `sₖ` on top and
`xM` the current array size `N`.  The pushed scalars are computed by small expressions over these
and the globals (`Glob`): `tₖ = (K - dh) - (K - k) < 0 ? 2^(e-1) : 2^e`, `sOff`, `N / sₖ`, …
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- `tₖ` from the counter. -/
def tE : Ex HS := .sel (.add (.reg gKd) (.neg (.reg cL))) (.reg grh) (.reg gr)

/-- `sOff s w = (s - w mod s) mod s`. -/
def sOffE (sr wr : Fin HS) : Ex HS :=
  .nmod (.add (.reg sr) (.neg (.nmod (.reg wr) (.reg sr)))) (.reg sr)

/-- `N / s`. -/
def mE (Nr sr : Fin HS) : Ex HS := .ndiv (.reg Nr) (.reg sr)

/-- The bit-size budget of all scalars. -/
def Gx (q : Params) (kb : ℕ) : ℕ :=
  NLogN.EX.TT q + 2 ^ q.e + q.p + q.α ^ 2 + sWidth q.p q.α + eWidth q.p q.α + q.K + kb + 2

def Vx (q : Params) (kb : ℕ) : ℕ := 2 ^ (2 * q.p) + 4 * Gx q kb ^ 3

/-! ## Evaluation bundles -/

/-- `e` evaluates to `v` in `w`, with its side conditions and bit bound `B`. -/
def EA (w : IState HS) (B : ℕ) (e : Ex HS) (v : ℤ) : Prop :=
  e.eval w = v ∧ e.ok w ∧ e.Bnd w B ∧ e.Clean

/-! ## `tE` -/

/-! ## `sOffE` and `mE` -/

end NLogN.EX

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

end NLogN.EX

end

section
-- Source module: NLogN.HEx4
/-!
# The full `fwdL` / `exactConvL` programs, part 4: the body of the `S̃` axis loop

`sBody` (iteration `k`): push the registers of `sapAxP` (layout `HAx2`) computed from `sₖ`
(top of `xS`), the counter, the size `N` (top of `xM`) and the globals; run `sapAxP`; pop the
registers; then `xM := (N / sₖ) tₖ`, move `sₖ` from `xS` to `xU`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- The pushed registers of the `S̃` step. -/
def sPush : List (Fin HS × Ex HS) :=
  [(aS, .reg xS), (aT, NLogN.EX.tE), (aKa, sOffE xS gw), (aKN, .add (.reg xS) (.reg gw1)),
    (aR, .reg g2p2), (aNR, .reg gw1), (aNW, .mul NLogN.EX.tE (.reg gw1)), (aM, NLogN.EX.mE xM xS),
    (aKB, .reg gkb), (aK2, .mul (.reg ga2) (.mul NLogN.EX.tE NLogN.EX.tE)), (aP, .reg gp), (aWd, .reg gw),
    (aBe, .reg gbe), (aTot, .mul (NLogN.EX.mE xM xS) NLogN.EX.tE)]

/-- Their values in iteration `k`. -/
def sVals (q : Params) (kb k : ℕ) : List (Fin HS × ℤ) :=
  [(aS, ((sK q k : ℕ) : ℤ)), (aT, ((tK q k : ℕ) : ℤ)),
    (aKa, ((sOff (sK q k) (sWidth q.p q.α) : ℕ) : ℤ)),
    (aKN, ((sK q k + (2 * sWidth q.p q.α + 1) : ℕ) : ℤ)), (aR, 2 ^ (2 * q.p)),
    (aNR, ((2 * sWidth q.p q.α + 1 : ℕ) : ℤ)), (aNW, ((tK q k * (2 * sWidth q.p q.α + 1) : ℕ) : ℤ)),
    (aM, ((mS q k : ℕ) : ℤ)), (aKB, (kb : ℤ)), (aK2, ((q.α ^ 2 * tK q k ^ 2 : ℕ) : ℤ)),
    (aP, (q.p : ℤ)), (aWd, (sWidth q.p q.α : ℤ)), (aBe, betaT q.p q.α),
    (aTot, ((mS q k * tK q k : ℕ) : ℤ))]

/-- Loop bookkeeping: `xM := (N / s) t`, `s` from `xS` to `xU`. -/
def sUpd : RS := .seq (.asg xM (.mul (NLogN.EX.mE xM xS) NLogN.EX.tE)) (.seq (.push xU (.reg xS)) (.pop xS))

def sBody : RM := RM.seqL [.rs (pushes sPush), sapAxP, .rs (pops (sPush.map Prod.fst)), .rs sUpd]

/-- The per-axis hypotheses of the `S̃` step `k`. -/
structure SAx (q : Params) (kb mm Bacc Q Bq : ℕ) (BS : ℕ → ℕ) (k : ℕ) : Prop where
  sap : SapHyp q.p (sK q k) (tK q k) q.α (BS k) (BS (k + 1)) mm Bacc Q
  tab : TabHyp q.p (sK q k) (tK q k) q.α Bq
  axq : AxQ (sK q k) (tK q k) (mS q k) kb (BS k) (BS (k + 1)) Q

/-- Overhead of one iteration (besides `sapAxP`). -/
def sOver (B : ℕ) : ℕ := 10 ^ 9 * (B + 2) ^ 2

end NLogN.EX

end

section
-- Source module: NLogN.HEx5
/-!
# The full `fwdL` / `exactConvL` programs, part 5: the `S̃` axis loop

`sLoop = rep cL K sBody`: iteration `k` turns `gints (XS q U k)` into `gints (XS q U (k+1))`,
walking `q.s` from `xS` to `xU` and keeping the current size on `xM`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- `q.s` as integers. -/
def sl (q : Params) : List ℤ := q.s.map (fun x : ℕ => (x : ℤ))

/-- The `S̃` loop. -/
def sLoop : RM := .rep cL (.reg gK) NLogN.EX.sBody

/-- State after `k` iterations. -/
def sSt (q : Params) (U : List (ℤ × ℤ)) (w : IState HS) (R RS LM : List Item) (k : ℕ) :
    IState HS :=
  (((w.upd gD (gints (XS q U k) ++ R)).upd xM (.int (NS q k : ℤ) :: LM)).upd xU
    (ints ((NLogN.EX.sl q).take k).reverse ++ w.G xU)).upd xS (ints ((NLogN.EX.sl q).drop k) ++ RS)

/-- Overhead of the loop besides the `sapAxP` calls (uniform bound `CS` on them). -/
def sLoopCost (K CS Bx : ℕ) : ℕ := 2 * 2000 * (Bx + 2) + K * (CS + sOver Bx + 8000 * (Bx + 2) + 30) + 32

end NLogN.EX

end

section
-- Source module: NLogN.HEx6
/-!
# The full `fwdL` / `exactConvL` programs, part 6: the body of the `B̃` axis loop

`bBody` (iteration `k`, `s = sₖ` on top of `xS`, `N = tₖ m` on top of `xM`): push the registers
of `bapAxP` (layout `HAx5`), compute `u = (s⁻¹ mod t).val` onto `bKS` with `invP`, run `bapAxP`,
pop everything, then `xM := (N / t) s` and move `s` from `xS` to `xU`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- `(p s + a (t - s) - 1) / (a (t - s))` from expressions for `p, s, t, a`. -/
def jEx (pe se te ae : Ex HS) : Ex HS :=
  .ndiv (.add (.mul pe se) (.add (.mul ae (.add te (.neg se))) (.lit (-1))))
    (.mul ae (.add te (.neg se)))

/-- `N / t` (the rest size of the `B̃` step). -/
def mBE : Ex HS := .ndiv (.reg xM) NLogN.EX.tE

def jE : Ex HS := jEx (.reg gp) (.reg xS) NLogN.EX.tE (.reg ga2)

/-- The pushed registers of the `B̃` step (`bKS` is computed afterwards by `invP`). -/
def bPush : List (Fin HS × Ex HS) :=
  [(bKa, sOffE xS ge), (bKN, .add (.reg xS) (.reg ge1)), (bT, NLogN.EX.tE), (bKB, .reg gkb),
    (bR, .reg g2p), (NLogN.AX.bN, .reg xS), (bJN, jE), (bNR, .reg ge1), (bJL, .add (.reg xS) (.reg xS)),
    (bS, .reg xS), (bNW, .mul (.reg xS) (.reg ge1)), (bI, .reg ga2), (bPR, .reg g2p),
    (bKs, .reg xS), (bO, .reg gp), (bM, mBE), (bTot, .mul mBE (.reg xS))]

/-- Their values in iteration `k`. -/
def bVals (q : Params) (kb k : ℕ) : List (Fin HS × ℤ) :=
  [(bKa, ((sOff (sK q k) (eWidth q.p q.α) : ℕ) : ℤ)),
    (bKN, ((sK q k + (2 * eWidth q.p q.α + 1) : ℕ) : ℤ)), (bT, ((tK q k : ℕ) : ℤ)),
    (bKB, (kb : ℤ)), (bR, 2 ^ q.p), (NLogN.AX.bN, ((sK q k : ℕ) : ℤ)),
    (bJN, (jIter q.p (sK q k) (tK q k) q.α : ℤ)), (bNR, ((2 * eWidth q.p q.α + 1 : ℕ) : ℤ)),
    (bJL, ((2 * sK q k : ℕ) : ℤ)), (bS, ((sK q k : ℕ) : ℤ)),
    (bNW, ((sK q k * (2 * eWidth q.p q.α + 1) : ℕ) : ℤ)), (bI, ((q.α ^ 2 : ℕ) : ℤ)),
    (bPR, 2 ^ q.p), (bKs, ((sK q k : ℕ) : ℤ)), (bO, (q.p : ℤ)), (bM, ((mB q k : ℕ) : ℤ)),
    (bTot, ((mB q k * sK q k : ℕ) : ℤ))]

/-- The inverse register. -/
def uVal (q : Params) (k : ℕ) : ℤ := ((((sK q k : ℕ) : ZMod (tK q k))⁻¹).val : ℕ)

def bUpd : RS := .seq (.asg xM (.mul mBE (.reg xS))) (.seq (.push xU (.reg xS)) (.pop xS))

def bBody : RM :=
  RM.seqL [.rs (pushes bPush), .rs (invP bKS cMv bS bT), bapAxP,
    .rs (pops ((bPush.map Prod.fst) ++ [bKS])), .rs bUpd]

/-- The per-axis hypotheses of the `B̃` step `k`. -/
structure BAx (q : Params) (kb mm Bacc Q Bq : ℕ) (BB : ℕ → ℕ) (k : ℕ) : Prop where
  bap : BapHyp q.p (sK q k) (tK q k) q.α kb (BB k) (BB (k + 1)) mm Bacc Q
  tab : TabHypB q.p (sK q k) (tK q k) q.α Bq
  axq : AxQ (tK q k) (sK q k) (mB q k) kb (BB k) (BB (k + 1)) Q
  lt : sK q k < tK q k
  t2 : 2 ≤ tK q k

/-- Overhead of one `B̃` iteration (besides `bapAxP`), including the inverse loop. -/
def bOver (q : Params) (B : ℕ) : ℕ := (NLogN.EX.TT q + 3) * 10 ^ 10 * (B + 2) ^ 2

end NLogN.EX

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

end NLogN.EX

end

section
-- Source module: NLogN.HEx7
/-!
# The full `fwdL` / `exactConvL` programs, part 7: the `B̃` axis loop
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- The `B̃` loop. -/
def bLoop : RM := .rep cL (.reg gK) bBody

/-- State after `k` iterations. -/
def bSt (q : Params) (U : List (ℤ × ℤ)) (w : IState HS) (R RS LM : List Item) (k : ℕ) :
    IState HS :=
  (((w.upd gD (gints (XB q U k) ++ R)).upd xM (.int (NB q k : ℤ) :: LM)).upd xU
    (ints ((NLogN.EX.sl q).take k).reverse ++ w.G xU)).upd xS (ints ((NLogN.EX.sl q).drop k) ++ RS)

/-- Overhead of the loop besides the `bapAxP` calls (uniform bound `CS` on them). -/
def bLoopCost (q : Params) (CS Bx : ℕ) : ℕ :=
  2 * 2000 * (Bx + 2) + q.K * (CS + bOver q Bx + 8000 * (Bx + 2) + 30) + 32

end NLogN.EX

end

section
-- Source module: NLogN.HEx8
/-!
# The full `fwdL` / `exactConvL` programs, part 8: the two axis phases and `fwdLP`

A phase pushes the initial array size on `xM`, runs the axis loop, pops `xM` and moves `q.s`
back from `xU` to `xS`; it changes nothing but `gD`.
`fwdLP fw = S̃ phase; ftlP fw; B̃ phase` computes `Ref.fwdL`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- A phase around an axis loop; `cst` holds the initial size. -/
def phaseP (cst : Fin HS) (loop : RM) : RM :=
  RM.seqL [.rs (.push xM (.reg cst)), loop, .rs (.pop xM), .rs (mvList xU xS cMv (.reg gK))]

/-- Overhead of a phase besides its loop. -/
def phOver (K Bx : ℕ) : ℕ := (K + 1) * 20000 * (Bx + 2)

end NLogN.EX

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- The `S̃` phase (initial size `S` read from `gPM`). -/
def sPhase : RM := phaseP gPM sLoop

/-- The `B̃` phase (initial size `T` read from `gPN`). -/
def bPhase : RM := phaseP gPN bLoop

end NLogN.EX

end

section
-- Source module: NLogN.HEx9
/-!
# The full `fwdL` / `exactConvL` programs, part 9: `fwdLP`

`fwdLP fw = S̃ phase (loop over the axes, `sapAxP` per axis); ftlP fw; B̃ phase (loop over the
axes, `bapAxP` per axis)`, generic in the `fermatW` program `fw` (any `GL.LProg2` with
`GL.FwOK`, e.g. `FWW.fwL`). Its context `Ctx` (e.g. the `FwCtx` frame on stacks
`32 … 39, 52, 53`) is a precondition that survives: every axis program restores every stack
but `gD`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

section
variable {M : MulSpec} {Ctx : IState HS → Prop} {PreW : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop}
  {q : Params} {CW : ℕ}

def fwdLP (fw : LProg2 M Ctx PreW (fermatW q) CW) : RM := RM.seqL [sPhase, ftlP fw, bPhase]

/-- Static facts (parameters, per-axis hypotheses, size budgets) for `fwdLP`. -/
structure FwdCfgX (M : MulSpec) (q : Params) (kb mm Φ Bacc Qa Bq Bx CS CB m Q : ℕ)
    (BS BB : ℕ → ℕ) : Prop where
  hM : MulBnd M mm Φ
  hsl : q.s.length = q.K
  hst : ∀ i < q.K, sK q i ≤ tK q i
  hα : 1 ≤ q.α
  hBx : Vx q kb < 2 ^ Bx
  sax : ∀ k < q.K, SAx q kb mm Bacc Qa Bq BS k
  bax : ∀ k < q.K, BAx q kb mm Bacc Qa Bq BB k
  cS : ∀ k < q.K,
    sapAxCost q.p (sK q k) (tK q k) q.α (mS q k) kb (BS k) mm Φ Bacc Qa Bq ≤ CS
  cB : ∀ k < q.K,
    bapAxCost q.p (sK q k) (tK q k) q.α (mB q k) kb (BB k) mm Φ Bacc Qa Bq ≤ CB
  chl : (chirpL q).length = NLogN.EX.TT q
  chb : GB m (chirpL q)
  Sm : BS q.K ≤ m
  Bm : BB q.K ≤ m
  mQ : 2 * m + 1 ≤ Q
  k : q.p + q.logT + 1 ≤ Q
  NQ : zsz ((2 * NLogN.EX.TT q : ℕ) : ℤ) ≤ Q

/-- What `fwdLP` needs in the machine state (besides the data on `gD`). -/
structure FwdEnvX (q : Params) (kb : ℕ) (Ctx : IState HS → Prop) (s : IState HS) : Prop where
  ctx : Ctx s
  glob : Glob q kb s
  xs : ∃ RS, s.G xS = ints (NLogN.EX.sl q) ++ RS
  ch : ∃ RC, s.G gCH = gints (chirpL q) ++ RC
  pn : ∃ L, s.G gPN = .int (NLogN.EX.TT q : ℤ) :: L
  pm : ∃ L, s.G gPM = .int (q.S : ℤ) :: L
  pt : ∃ L, s.G gPT = .int (2 ^ (q.p + q.logT)) :: L
  pp : ∃ L, s.G gPP = .int (2 ^ q.p) :: L

/-- What `fwdLP` needs about the data `U`. -/
structure FwdInX (q : Params) (PreW : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop) (BS BB : ℕ → ℕ)
    (m Q : ℕ) (U : List (ℤ × ℤ)) : Prop where
  len : U.length = q.S
  b : GB (BS 0) U
  pre : PreW (ftlV q (fwdX q U)) (chirpL q)
  wl : (fermatW q (ftlV q (fwdX q U)) (chirpL q)).length = NLogN.EX.TT q
  wb : GB Q (fermatW q (ftlV q (fwdX q U)) (chirpL q))
  cb : GB m (convL q (ftlV q (fwdX q U)) (chirpL q))
  yb : GB (BB 0) (FtL q (fwdX q U))

/-- The cost bound of `fwdLP`: two axis phases (`K` iterations each, every iteration bounded
by `CS` resp. `CB` plus explicit overhead) and `FtL` (`CW` for `fermatW`, `8 T` products of
size `m`, linear rest). -/
def fwdLCost (q : Params) (CS CB Bx CW Q Φm : ℕ) : ℕ :=
  (sLoopCost q.K CS Bx + phOver q.K Bx) +
    (CW + 8 * NLogN.EX.TT q * Φm + 1000000 * (NLogN.EX.TT q + 1) * (Q + 2)) +
    (bLoopCost q CB Bx + phOver q.K Bx)

end

end NLogN.EX

end

section
-- Source module: NLogN.HEx10
/-!
# The full `fwdL` / `exactConvL` programs, part 10: `exactLP`

`exactLP fw` follows `GL.exactP` (scale `u`, `fwdL`, park, scale `v`, `fwdL`, pointwise
`mulConj`, `fwdL`, round) with `fwdLP fw` in place of `GL.fwdP`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

section
variable {M : MulSpec} {Ctx : IState HS → Prop} {PreW : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop}
  {q : Params} {CW : ℕ}

def exactLP (fw : LProg2 M Ctx PreW (fermatW q) CW) : RM :=
  RM.seqL [scaleP gPM, fwdLP fw, xferP gD gSA (cnt2 gPM), xferP gV gD (.reg gPM),
    scaleP gPM, fwdLP fw, xferP gSA gZA (cnt2 gPM), zipP sgMulConj gPM,
    fwdLP fw, roundP gPM]

end

end NLogN.EX

