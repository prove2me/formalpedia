  apply monom_eq_monom
  · unfold thetaQDeg; ring
  · ring
  · ring
  · rw [zpow_add₀ (by norm_num : (-1 : ℚ) ≠ 0), zpow_add₀ (by norm_num : (-1 : ℚ) ≠ 0)]

