namespace LinearSetReconciliation327.Main
def crOutputPrepare : List Instr :=
  (crSpillLoad 0 0 ++ crSpillLoad 1 1) ++ [.add 0 9 0]
theorem crOutputPrepare_length : crOutputPrepare.length = 7 := rfl
theorem crOutputPrepare_spec (E : RAMEnv) (p src : RAMState) (w file memBase : ℕ)
    (hView : CRView w file memBase src p) (hSource : CRWordClosed w src)
    (hWide : w < E.W) (hPtr : p.regs 8 = file) (hMemPtr : p.regs 9 = memBase)
    (hFile : file + 16 ≤ 2 ^ E.W) (hRead : memBase + 2 ^ w < 2 ^ E.W) :
    let out := runBlock crOutputPrepare E p
    out.pc = p.pc + 7 ∧ out.mem = p.mem ∧
      out.regs 0 = memBase + src.regs 0 ∧ out.regs 1 = src.regs 1 ∧
      ∀ r, r ≠ 0 → r ≠ 1 → out.regs r = p.regs r := by
  have hBound : ∀ r : Fin 16, p.mem (p.regs 8 + r.val) ≤ 2 ^ w := by
    intro r
    rw [hPtr]
    exact crView_regs_bound hView hSource r
  generalize hu : runBlock (crSpillLoad 0 0 ++ crSpillLoad 1 1) E p = u
  have hU := crSpillFetchTwo_spec E p w 0 1 hWide (by rw [hPtr]; exact hFile) hBound
  rw [hu] at hU
  obtain ⟨hUpc, hUmem, hU0, hU1, hUfr⟩ := hU
  have hU0' : u.regs 0 = src.regs 0 := by
    rw [hU0, hPtr]
    exact hView.1 0
  have hU1' : u.regs 1 = src.regs 1 := by
    rw [hU1, hPtr]
    exact hView.1 1
  have hU9 : u.regs 9 = memBase := (hUfr 9 (by decide) (by decide)).trans hMemPtr
  have hAddr : u.regs 9 + u.regs 0 < 2 ^ E.W := by
    rw [hU9, hU0']
    exact (Nat.add_le_add_left (hSource.1 0) memBase).trans_lt hRead
  generalize ho : runBlock [.add 0 9 0] E u = out
  have hO : out = {u with pc := u.pc + 1, regs := Function.update u.regs 0 ((u.regs 9 + u.regs 0) % 2 ^ E.W)} := by
    rw [← ho]
    rfl
  have hRun : runBlock crOutputPrepare E p = out := by
    rw [crOutputPrepare, runBlock_append, hu, ho]
  dsimp only
  rw [hRun]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp only [hO, hUpc, Nat.add_assoc]
  · simpa only [hO] using hUmem
  · simp only [hO, Function.update_self]
    rw [Nat.mod_eq_of_lt hAddr, hU9, hU0']
  · simpa only [hO, Function.update_of_ne (by decide : (1 : Fin 16) ≠ 0)] using hU1'
  · intro r hr0 hr1
    simpa only [hO, Function.update_of_ne hr0] using hUfr r hr0 hr1
theorem crView_outList {w file memBase : ℕ} {src p out : RAMState}
    (hView : CRView w file memBase src p) (hSource : CRWordClosed w src)
    (hMem : out.mem = p.mem) (h0 : out.regs 0 = memBase + src.regs 0)
    (h1 : out.regs 1 = src.regs 1) : outList out = outList src := by
  unfold outList
  rw [h1]
  apply List.map_congr_left
  intro i hi
  have hI : i < src.regs 1 := List.mem_range.mp hi
  have hBound : src.regs 0 + i ≤ 2 ^ (w + 1) := by
    calc
      src.regs 0 + i ≤ 2 ^ w + 2 ^ w :=
        Nat.add_le_add (hSource.1 0) (hI.le.trans (hSource.1 1))
      _ = 2 ^ (w + 1) := by rw [pow_succ, Nat.mul_two]
  rw [h0, hMem, Nat.add_assoc]
  exact hView.2 _ hBound
theorem crOutputPrepare_support (E : RAMEnv) (p src : RAMState) (w file memBase N : ℕ)
    (x : Fin N → ZMod 2) (hView : CRView w file memBase src p) (hSource : CRWordClosed w src)
    (hWide : w < E.W) (hPtr : p.regs 8 = file) (hMemPtr : p.regs 9 = memBase)
    (hFile : file + 16 ≤ 2 ^ E.W) (hRead : memBase + 2 ^ w < 2 ^ E.W)
    (hOutput : OutputsSupport src x) : OutputsSupport (runBlock crOutputPrepare E p) x := by
  generalize ho : runBlock crOutputPrepare E p = out
  have h := crOutputPrepare_spec E p src w file memBase hView hSource hWide hPtr hMemPtr hFile hRead
  rw [ho] at h
  obtain ⟨hPc, hMem, h0, h1, hFrame⟩ := h
  have hList := crView_outList hView hSource hMem h0 h1
  unfold OutputsSupport
  rw [hList]
  exact hOutput
end LinearSetReconciliation327.Main
