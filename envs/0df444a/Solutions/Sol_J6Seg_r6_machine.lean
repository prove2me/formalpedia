/-! ## Row-major digits and `listOf` -/

theorem digL_ge : ∀ (dims : List ℕ) (x i : ℕ), dims.length ≤ i → digL dims x i = 0
  | [], _, _, _ => rfl
  | _ :: _, _, 0, h => by simp at h
  | _ :: ts, x, i + 1, h => digL_ge ts _ i (by simp at h; omega)

theorem boxIdxs_getElem? : ∀ (dims : List ℕ) (x : ℕ), x < dims.prod →
    (boxIdxs dims)[x]? = some ((List.range dims.length).map (digL dims x))
  | [], x, hx => by
    simp at hx; subst hx; simp [boxIdxs]
  | n :: ns, x, hx => by
    have hP : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h | h
      · simp [h] at hx
      · exact h
    have hq : x / ns.prod < n := by
      rw [Nat.div_lt_iff_lt_mul hP]; simpa [mul_comm] using hx
    have hr : x % ns.prod < ns.prod := Nat.mod_lt _ hP
    have e : x = x / ns.prod * ns.prod + x % ns.prod := (Nat.div_add_mod' x ns.prod).symm
    rw [boxIdxs]
    conv_lhs => rw [e]
    rw [getElem?_flatMap_const n ns.prod _ (fun _ _ => by simp [length_boxIdxs]) _ _ hq hr,
      List.getElem?_map, boxIdxs_getElem? ns _ hr]
    simp only [Option.map_some]
    congr 1
    rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map]
    congr 1
    all_goals (try simp [digL, Nat.mod_eq_of_lt hq])
    all_goals (try (apply List.map_congr_left; intro i _; simp [digL, Function.comp]))

theorem ixf_digL (dims : List ℕ) (x : ℕ) :
    ixf ((List.range dims.length).map (digL dims x)) = digL dims x :=
  ixf_map_range _ _ (fun i hi => digL_ge dims x i hi)

theorem getD_listOf' {α : Type*} (dims : List ℕ) (f : (ℕ → ℕ) → α) (dflt : α) {x : ℕ}
    (hx : x < dims.prod) : (listOf dims f).getD x dflt = f (digL dims x) := by
  rw [listOf, List.getD_eq_getElem?_getD, List.getElem?_map, boxIdxs_getElem? dims x hx]
  simp only [Option.map_some, Option.getD_some]
  exact congrArg f (ixf_digL dims x)

theorem rmPos_digL : ∀ (dims : List ℕ) (x : ℕ), x < dims.prod → rmPos dims (digL dims x) = x
  | [], x, hx => by simp at hx; subst hx; rfl
  | n :: ns, x, hx => by
    have hP : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h | h
      · simp [h] at hx
      · exact h
    have hq : x / ns.prod < n := by
      rw [Nat.div_lt_iff_lt_mul hP]; simpa [mul_comm] using hx
    show digL (n :: ns) x 0 * ns.prod + rmPos ns (fun i => digL (n :: ns) x (i + 1)) = x
    have h1 : (fun i => digL (n :: ns) x (i + 1)) = digL ns (x % ns.prod) := by funext i; rfl
    rw [h1, rmPos_digL ns _ (Nat.mod_lt _ hP)]
    simp only [digL, Nat.mod_eq_of_lt hq]
    exact Nat.div_add_mod' x ns.prod

theorem listOf_self {α : Type*} (dims : List ℕ) (L : List α) (dflt : α)
    (hL : L.length = dims.prod) : listOf dims (fun j => L.getD (rmPos dims j) dflt) = L := by
  apply List.ext_getElem (by rw [length_listOf, hL])
  intro x h1 h2
  have hx : x < dims.prod := by rwa [length_listOf] at h1
  have := getD_listOf' dims (fun j => L.getD (rmPos dims j) dflt) dflt hx
  rw [List.getD_eq_getElem _ _ h1] at this
  rw [this, rmPos_digL dims x hx, List.getD_eq_getElem _ _ h2]

/-! ## Box points as natural-number index functions -/

variable {d : ℕ}

theorem extF_ixf {l : List ℕ} (hl : l.length = d) : extF (fun i : Fin d => ixf l i) = ixf l := by
  funext i
  unfold extF
  split_ifs with h
  · rfl
  · simp only [ixf]; rw [List.getD_eq_default _ _ (by omega)]

theorem listOf_extF {α : Type*} (dims : List ℕ) (hd : dims.length = d) (F : (ℕ → ℕ) → α) :
    listOf dims (fun j => F (extF (fun i : Fin d => j i))) = listOf dims F := by
  unfold listOf
  apply List.map_congr_left
  intro l hl
  have := (mem_boxIdxs.1 hl).1
  show F (extF fun i : Fin d => ixf l i) = F (ixf l)
  rw [extF_ixf (this.trans hd)]

theorem ofFn_getD (t : Fin d → ℕ) (i : Fin d) (c : ℕ) : (List.ofFn t).getD i c = t i := by
  simp [List.getD_eq_getElem?_getD]

theorem listOf_gIn (dims : List ℕ) (hd : dims.length = d) (zs : List GI)
    (hz : zs.length = dims.prod) :
    listOf dims (fun j => gIn (d := d) dims zs (fun i : Fin d => j i)) = zs := by
  have := listOf_extF (d := d) dims hd (fun j => zs.getD (rmPos dims j) 0)
  show (listOf dims fun j => zs.getD (rmPos dims (extF (d := d) fun i : Fin d => j i)) 0) = zs
  rw [this, listOf_self dims zs 0 hz]

