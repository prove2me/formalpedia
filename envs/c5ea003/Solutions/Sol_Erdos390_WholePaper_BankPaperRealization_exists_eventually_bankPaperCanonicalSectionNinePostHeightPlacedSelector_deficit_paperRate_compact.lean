    calc
      (3 : Real) * (n : Real) <
          (n : Real) ^ (1 / 9 : Real) * (n : Real) :=
        mul_lt_mul_of_pos_right hpower hnReal
      _ = (n : Real) * (n : Real) ^ (1 / 9 : Real) :=
        mul_comm _ _
  have hpowerIdentity :
      (n : Real) * (n : Real) ^ (1 / 9 : Real) = y n ^ 5 := by
    unfold y
