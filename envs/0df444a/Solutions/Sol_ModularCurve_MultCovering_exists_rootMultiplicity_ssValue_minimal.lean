theorem exists_rootMultiplicity_le_of_sum_smul_eq {k ι : Type*} [Field k] [Fintype ι]
    (c : ι → k) (P : ι → k[X]) (D : k[X]) (hD : D ≠ 0) (a : k)
    (hsum : ∑ i, c i • P i = D) :
    ∃ i, c i ≠ 0 ∧ P i ≠ 0 ∧ (P i).rootMultiplicity a ≤ D.rootMultiplicity a := by
  classical
  by_contra h
  push Not at h

  have hdvd : (X - C a) ^ (D.rootMultiplicity a + 1) ∣ ∑ i, c i • P i := by
    refine Finset.dvd_sum fun i _ => ?_
    by_cases hc : c i = 0
    · rw [hc, zero_smul]; exact dvd_zero _
    by_cases hP : P i = 0
    · rw [hP, smul_zero]; exact dvd_zero _
    rw [smul_eq_C_mul]
    exact Dvd.dvd.mul_left ((le_rootMultiplicity_iff hP).mp (h i hc hP)) _
  rw [hsum] at hdvd
  have := (le_rootMultiplicity_iff hD).mpr hdvd
  omega

theorem rootMultiplicity_prod_X_sub_C_of_injective {k ι : Type*} [Field k] [DecidableEq ι]
    (s : Finset ι) (f : ι → k) (hf : Function.Injective f) (i : ι) :
    (∏ j ∈ s, (X - C (f j))).rootMultiplicity (f i) = if i ∈ s then 1 else 0 := by
  classical
  have hDS0 : (∏ j ∈ s, (X - C (f j))) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => X_sub_C_ne_zero _
  rw [← Polynomial.count_roots, Polynomial.roots_prod _ _ hDS0]
  simp only [Polynomial.roots_X_sub_C, Multiset.count_bind, Multiset.count_singleton]
  rw [show (s.val.map fun j => if f i = f j then 1 else 0).sum = ∑ j ∈ s, (if f i = f j then 1 else 0) from rfl]
  by_cases hi : i ∈ s
  · rw [if_pos hi, Finset.sum_eq_single i]
    · simp
    · intro j _ hne; rw [if_neg]; exact fun h => hne (hf h).symm
    · intro h; exact absurd hi h
  · rw [if_neg hi]
    refine Finset.sum_eq_zero fun j hj => ?_
    rw [if_neg]
    intro h; exact hi ((hf h) ▸ hj)

theorem exists_eval_ne_zero_of_span_eq_degreeLT {k ι : Type*} [Field k] [Fintype ι]
    (P : ι → k[X]) (m : ℕ) (hm : 0 < m)
    (hspan : Submodule.span k (Set.range P) = degreeLT k m) (a : k) :
    ∃ i, (P i).eval a ≠ 0 := by
  classical
  have h1 : (1 : k[X]) ∈ Submodule.span k (Set.range P) := by
    rw [hspan, mem_degreeLT, degree_one]; exact_mod_cast hm
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp h1
  by_contra h
  push Not at h
  have : (1 : k[X]).eval a = 0 := by
    rw [← hc, eval_finsetSum]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [eval_smul, h i, smul_zero]
  rw [eval_one] at this
  exact one_ne_zero this

