theorem exists_isRegular_ofList_eq_maximalIdeal_stalk_of_isClosed
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of k))
    (g : ℕ) [SmoothOfRelativeDimension g f] (x : X) (hx : IsClosed ({x} : Set X)) :
    ∃ rs : List (X.presheaf.stalk x),
      Ideal.ofList rs = maximalIdeal (X.presheaf.stalk x) ∧ rs.length = g ∧
        RingTheory.Sequence.IsRegular (X.presheaf.stalk x) rs := by
  haveI : Smooth f := SmoothOfRelativeDimension.smooth (n := g) (f := f)
  haveI : IsRegularLocalRing (X.presheaf.stalk x) := Smooth.isRegularLocalRing_stalk (f := f) x
  obtain ⟨rs, hof, hlen, hreg⟩ := RegularFlatLocalAscent.exists_isRegular_ofList_eq_maximalIdeal (X.presheaf.stalk x)
  refine ⟨rs, hof, ?_, hreg⟩
  have h1 : (((maximalIdeal (X.presheaf.stalk x)).spanFinrank : ℕ∞) : WithBot ℕ∞) = ringKrullDim (X.presheaf.stalk x) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  rw [SmoothOfRelativeDimension.ringKrullDim_stalk_eq_of_isClosed k f g x hx, ← hlen] at h1
  exact_mod_cast h1

