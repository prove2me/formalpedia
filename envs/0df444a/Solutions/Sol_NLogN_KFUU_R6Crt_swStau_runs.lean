theorem swapPos_5 (A M C : List ℕ) (x y : ℕ) :
    swapPos A.length (A.length + 1 + M.length) (A ++ x :: M ++ y :: C) = A ++ y :: M ++ x :: C := by
  have e : A ++ x :: M ++ y :: C = A ++ x :: (M ++ y :: C) := by simp
  have g1 : (A ++ x :: M ++ y :: C).getD A.length 0 = x := by
    rw [e, List.getD_eq_getElem?_getD, List.getElem?_append_right (le_refl _)]; simp
  have g2 : (A ++ x :: M ++ y :: C).getD (A.length + 1 + M.length) 0 = y := by
    rw [e, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega),
      show A.length + 1 + M.length - A.length = M.length + 1 by omega, List.getElem?_cons_succ,
      List.getElem?_append_right (le_refl _)]
    simp
  unfold swapPos
  rw [g1, g2, e, List.set_append_right _ _ (le_refl _), Nat.sub_self, List.set_cons_zero,
    List.set_append_right _ _ (by omega),
    show A.length + 1 + M.length - A.length = M.length + 1 by omega, List.set_cons_succ,
    List.set_append_right _ _ (le_refl _), Nat.sub_self, List.set_cons_zero]
  simp

theorem encode5 (A M C : Shape) (a m c x y : ℕ) (ha : a < vol A) (hm : m < vol M) (hc : c < vol C)
    (F : ℕ) :
    encode (A ++ F :: M ++ F :: C) (decode A a ++ x :: decode M m ++ y :: decode C c) =
      encode [vol A, F, vol M, F, vol C] [a, x, m, y, c] := by
  have e1 : A ++ F :: M ++ F :: C = A ++ (F :: (M ++ F :: C)) := by simp
  have e2 : decode A a ++ x :: decode M m ++ y :: decode C c =
      decode A a ++ (x :: (decode M m ++ y :: decode C c)) := by simp
  rw [e1, e2, encode_append_len _ _ (length_decode _ _), encode_decode ha]
  simp only [encode, List.headD_cons, List.tail_cons]
  rw [encode_append_len _ _ (length_decode _ _), encode_decode hm]
  simp only [encode, List.headD_cons, List.tail_cons, encode_decode hc, vol_cons, vol_append, vol_nil]
  ring
theorem pull_swap5 {α : Type*} (A M C : Shape) (F : ℕ) (d : α) (xs : List α) :
    pull (A ++ F :: M ++ F :: C) (A ++ F :: M ++ F :: C) (swapPos A.length (A.length + 1 + M.length))
        d xs =
      pull [vol A, F, vol M, F, vol C] [vol A, F, vol M, F, vol C] (swapPos 1 3) d xs := by
  have hv : vol (A ++ F :: M ++ F :: C) = vol [vol A, F, vol M, F, vol C] := by
    simp only [vol_append, vol_cons, vol_nil]; ring
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  have hval := valid_decode h2
  obtain ⟨a, f1, m, f2, c, hdec, ha, hf1, hm, hf2, hc⟩ : ∃ a f1 m f2 c,
      decode [vol A, F, vol M, F, vol C] j = [a, f1, m, f2, c] ∧ a < vol A ∧ f1 < F ∧
        m < vol M ∧ f2 < F ∧ c < vol C := by
    generalize decode [vol A, F, vol M, F, vol C] j = D at hval
    rcases hval with _ | ⟨ha, _ | ⟨h1, _ | ⟨hm, _ | ⟨h2, _ | ⟨hc, h⟩⟩⟩⟩⟩
    cases h
    exact ⟨_, _, _, _, _, rfl, ha, h1, hm, h2, hc⟩
  have hj : j = encode [vol A, F, vol M, F, vol C] [a, f1, m, f2, c] := by
    rw [← hdec, encode_decode h2]
  have hDv : Valid (A ++ F :: M ++ F :: C) (decode A a ++ f1 :: decode M m ++ f2 :: decode C c) := by
    rw [show A ++ F :: M ++ F :: C = A ++ (F :: (M ++ F :: C)) by simp,
      show decode A a ++ f1 :: decode M m ++ f2 :: decode C c =
        decode A a ++ (f1 :: (decode M m ++ f2 :: decode C c)) by simp]
    exact valid_append (valid_decode ha) (.cons hf1 (valid_append (valid_decode hm)
      (.cons hf2 (valid_decode hc))))
  have hdD : decode (A ++ F :: M ++ F :: C) j = decode A a ++ f1 :: decode M m ++ f2 :: decode C c := by
    rw [hj, ← encode5 A M C a m c f1 f2 ha hm hc F, decode_encode hDv]
  rw [hdD, hdec]
  have e1 := swapPos_5 (decode A a) (decode M m) (decode C c) f1 f2
  rw [length_decode, length_decode] at e1
  rw [e1, encode5 A M C a m c f2 f1 ha hm hc F]
  rfl

/-! ## Pairs -/

theorem gflat_gpair : ∀ (xs : List ℤ), xs.length % 2 = 0 → gflat (gpair xs) = xs
  | [], _ => rfl
  | [a], h => by simp at h
  | a :: b :: r, h => by
    simp only [gpair, gflat_cons]
    rw [gflat_gpair r (by simp at h; omega)]

theorem length_gpair : ∀ (xs : List ℤ), (gpair xs).length = xs.length / 2
  | [] => rfl
  | [a] => by simp [gpair]
  | a :: b :: r => by simp only [gpair, List.length_cons, length_gpair r]; omega

/-- One `SwapNeed` call on the paired data, in flat terms. -/
theorem gflat_swap5 (a F m c2 : ℕ) (xs : List ℤ) (hlen : xs.length = vol [a, F, m, F, c2] * 2) :
    gflat (pull [a, F, m, F, c2] [a, F, m, F, c2] (swapPos 1 3) 0 (gpair xs)) =
      pull [a, F, m, F, c2 * 2] [a, F, m, F, c2 * 2] (swapPos 1 3) 0 xs := by
  have he : xs.length % 2 = 0 := by rw [hlen]; simp
  rw [KFS.gflat_pull_swapPos _ (by simp) (by simp) (by simp) _ _
    (by rw [length_gpair, hlen]; simp), gflat_gpair xs he]
  have := pull_swap5 (α := ℤ) [a] [m] [c2, 2] F 0 xs
  simp only [List.length_singleton, List.cons_append, List.singleton_append, List.nil_append,
    vol_cons, vol_nil, mul_one] at this
  simpa using this

