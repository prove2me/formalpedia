namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

/-! ## The witnesses -/

/-! ## The per-block multiplication bound -/

theorem mulSup_le_fmB' (m : ℕ) : mulSup m ≤ KFM.fmB m := by
  unfold mulSup
  apply Finset.sup_le
  intro a ha
  rw [Finset.mem_range] at ha
  refine le_trans ?_ (KFM.fmB_mono (show a ≤ m by omega))
  have := KFM.mulCostH_le a
  unfold KFM.fmB; exact this

theorem zszN_mono {x y : ℕ} (h : x ≤ y) : zsz (x : ℤ) ≤ zsz (y : ℤ) :=
  zsz_mono (by simp only [Int.natAbs_natCast]; exact h)

/-- `φT m ≤ (m + 1) Φ` for the blocks of a chunk. -/
theorem phiT_le {b lam m : ℕ} (hb : 1 ≤ b) (hm : m ≤ lam) :
    mulSup (2 * (b * (2 * m) + 2)) ≤ (m + 1) * (NLogN.KFZ.Cfm * (5 * b) *
      (zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) + 2) *
      (zsz (((zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1)) := by
  have e : 2 * (b * (2 * m) + 2) = 4 * b * m + 4 := by ring
  rw [e]
  refine (mulSup_le_fmB' _).trans ?_
  rw [show KFM.fmB (4 * b * m + 4) = NLogN.KFZ.Cfm * (4 * b * m + 4 + 1) *
      (zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) + 2) *
      (zsz (((zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) from rfl]
  set C := NLogN.KFZ.Cfm
  have h1 : 4 * b * m + 4 + 1 ≤ (m + 1) * (5 * b) := by nlinarith
  have hz : zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) ≤ zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) :=
    zszN_mono (by have : b * m ≤ b * lam := Nat.mul_le_mul_left _ hm; nlinarith)
  have hz4 : zsz (((zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) ≤
      zsz (((zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) :=
    zszN_mono (Nat.pow_le_pow_left (by omega) 4)
  calc C * (4 * b * m + 4 + 1) * (zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) + 2) *
        (zsz (((zsz (((4 * b * m + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1)
      ≤ C * ((m + 1) * (5 * b)) * (zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) + 2) *
        (zsz (((zsz (((4 * b * lam + 4 + 1 : ℕ)) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left _ h1) (by omega)) (by omega)
    _ = _ := by ring

/-! ## The size facts on one axis -/

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxNum P n src D k)
include h

theorem lam_facts : 1 ≤ axl6 P n ∧ axl6 P n < 2 ^ axQ6 P n src k := by
  have hl : Nat.log 2 (lamF (axd6 P n)) < axQ6 P n src k := Val.log_lam_lt_Q _ _ _
  constructor
  · unfold axl6 lamP; exact Nat.one_le_two_pow
  · unfold axl6 lamP; exact Nat.pow_lt_pow_right (by norm_num) hl

theorem T_lt : TP6 P n < 2 ^ pP6 P n := by
  have := Nat.size_le.1 h.sizeT; omega

theorem chunk_facts_sol_aux (hT : J6Seg.Ax.TabAt P n src k) (hc : AxCh.ChunkPlan6 ap) (hcb : ChunkPlanB ap) :
    ChunkFacts P ap n src D k (cBI P n src k ap) (cBH P n src k ap) (cBk P n src k ap)
      (cLc P n) (cCk P n src k ap) := by
  unfold ChunkFacts; dsimp only
  have htot := h.tot
  have hVC := h.VC
  have hncl := h.ncl
  have hpre1 := h.pre1
  have hpost1 := h.post1
  have ht1 := h.t1
  have hlamC := h.lamC
  obtain ⟨f1, f2, f3⟩ := AxCh.chunkPlan_facts P ap n src k hc
  obtain ⟨hl1, hlQ⟩ := lam_facts h
  have hTp := T_lt h
  obtain ⟨b1, b2⟩ := hcb
  set Q := axQ6 P n src k with hQ
  set lam := axl6 P n with hlam
  have hpk : axpk6 P n src k ap = ap.pl.pkA * Q + ap.pl.pkC := rfl
  have hbd : axb6 P n src k ap = ap.pl.bA * Q + ap.pl.bC := rfl
  have hbQ : 2 * axpk6 P n src k ap + Q + 3 ≤ axb6 P n src k ap := by
    rw [hpk, hbd]
    have : (2 * ap.pl.pkA + 1) * Q ≤ ap.pl.bA * Q := Nat.mul_le_mul_right _ b1
    have e : (2 * ap.pl.pkA + 1) * Q = 2 * (ap.pl.pkA * Q) + Q := by ring
    omega
  have hb1 : 1 ≤ axb6 P n src k ap := by omega
  set b := axb6 P n src k ap with hb
  set pk := axpk6 P n src k ap with hpkd
  have h2l : 2 * lam < 2 ^ (Q + 1) := by rw [pow_succ]; omega
  have hz2l : zsz ((2 * lam : ℕ) : ℤ) ≤ Q + 1 := zN le_rfl h2l
  -- the plan widths
  have eBI : cBI P n src k ap = b + 2 * pk + 2 * Q + 6 := rfl
  have eBH : cBH P n src k ap = cBI P n src k ap + b + Q + axR6 P n + 8 := rfl
  have eBk : cBk P n src k ap = axwd6 P n src k ap + cBH P n src k ap + pP6 P n + 10 := rfl
  have eLc : cLc P n = 8 + 10 * lam := rfl
  -- the tables
  have hT' : ∀ u < lam, |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).di u| ≤
        2 ^ (Q + axR6 P n + 2) ∧
      |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).gi u| ≤ 2 ^ (Q + axR6 P n + 2) ∧
      |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).gam u| ≤ 2 ^ (Q + axR6 P n + 2) ∧
      |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).dd u| ≤ 2 ^ (Q + axR6 P n + 2) ∧
      ∀ c, |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).am c u| ≤
          2 ^ (Q + axR6 P n + 2) ∧
        |(TT Q (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)).ap c u| ≤ 2 ^ (Q + axR6 P n + 2) :=
    hT
  have hTab : ∀ q, ∀ v ∈ axTC6 P n src k ap q, zsz v ≤ cBH P n src k ap := fun q =>
    tabK2_bnd (Q := Q) (R := axR6 P n) (s := axs6 src k) (t := axt6 P n k) (lam := lam)
      (α := axα6 P n) (pk := pk) (b := b) hl1 hlQ hb1 hT' (by rw [eBH, eBI]; omega) q
  have hLen : ∀ q, (axTC6 P n src k ap q).length ≤ cLc P n := fun q =>
    tabK2_len (Q := Q) (R := axR6 P n) (s := axs6 src k) (t := axt6 P n k) (lam := lam)
      (α := axα6 P n) (pk := pk) (b := b) hl1 q
