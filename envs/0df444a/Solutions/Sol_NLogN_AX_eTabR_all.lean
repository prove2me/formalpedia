theorem tabL_eWf (p s t α : ℕ) :
    tabL (eWf p s t (HvdH.eWidth p α) (α ^ 2) (s ^ 2)) (2 * HvdH.eWidth p α + 1) s =
      (eTab p s t α).flatten := rfl

theorem eTabBP_all (s0 : IState HS) (p s t α Bq : ℕ) (LP LS LT LM LA LK LR : List Item) (hs : 0 < s)
    (hP : s0.G TP = .int (p : ℤ) :: LP) (hS : s0.G TS = .int (s : ℤ) :: LS)
    (hT : s0.G NLogN.Rsp.TT = .int (t : ℤ) :: LT) (hM : s0.G TM = .int (HvdH.eWidth p α : ℤ) :: LM)
    (hA : s0.G TBe = .int ((α ^ 2 : ℕ) : ℤ) :: LA) (hK : s0.G TK2 = .int ((s ^ 2 : ℕ) : ℤ) :: LK)
    (hR : s0.G TRI = .int ((2 * HvdH.eWidth p α + 1 : ℕ) : ℤ) :: LR)
    (hBq : (α ^ 2 + s + t + 2 * HvdH.eWidth p α + 2) ^ 24 < 2 ^ Bq) (hpB : zsz (p : ℤ) ≤ Bq)
    (hKB : zsz ((s ^ 2 : ℕ) : ℤ) ≤ Bq) (hEB : ∀ j, zsz (HvdH.expNeg p (s ^ 2) j) ≤ Bq) :
    eTabBP.ok s0 ∧ eTabBP.run s0 = s0.upd NLogN.Rsp.BW (ints (eTab p s t α).flatten ++ s0.G NLogN.Rsp.BW) ∧
      eTabBP.cost s0 ≤ tabCost (2 * HvdH.eWidth p α + 1) s (eWCost p Bq) := by
  have hw := eWP_wspec s0 p s t (HvdH.eWidth p α) (α ^ 2) (s ^ 2) (2 * HvdH.eWidth p α + 1) Bq
    LP LS LT LM LA LK hs rfl hP hS hT hM hA hK hBq hpB hKB hEB
  have H := tabP_all (tdist_of NLogN.Rsp.BW TS) hw LR LS hR hS
  rw [tabL_eWf] at H
  exact H

end NLogN.Rsp

