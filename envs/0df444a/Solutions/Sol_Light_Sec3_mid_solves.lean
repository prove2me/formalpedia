section
open Light
open Light.Sec3
open ThreeSumApsp ThreeSumApsp.Spec
variable {P₀ R : Program} {ν : Et17Nums} {pAEBrute pAELoop pScanPairsAE pCore pFill : ℕ}
  {Tn : List ℕ → ℕ} {need : List ℕ → Need} {Dfun Gfun tD tG wD wG : ℕ → ℕ}
theorem solution {P₀ : Program} {pS pD pG : ℕ} {Tn : List ℕ → ℕ} {need : List ℕ → Light.Need}
    {Dfun Gfun tD tG wD wG : ℕ → ℕ} (hsol : SolvesN lopDetectTask P₀ pS Tn need)
    (hD : ∀ R, ParamProc (P₀ ++ R) pD Dfun tD wD) (hG : ∀ R, ParamProc (P₀ ++ R) pG Gfun tG wG)
    (hpos : ∀ n, 1 ≤ n → 1 ≤ Dfun n) :
    Solves aeTask (P₀ ++ midProcs pS pD pG P₀.length) (P₀.length + 33)
      (midHostTime Dfun Gfun tD tG Tn) (midHostNeed Dfun Gfun wD wG need) := by
  refine ⟨aeTopBody (P₀.length + 14) (P₀.length + 32), ?_, fun R lim d x μ fr hpre hok => ?_⟩
  · have htop : (P₀ ++ (midProcs pS pD pG P₀.length ++ []))[P₀.length + 33]? =
        some (aeTopBody (P₀.length + 14) (P₀.length + 32)) := by
      rw [midProcs, List.append_assoc]
      exact getElem?_append_append
        (B := et17Procs pS pD pG P₀.length ++ midExtra pS pD pG P₀.length) []
        (by rw [List.getElem?_append_right (by simp [length_et17Procs])]; rfl)
    simpa using htop
  · rw [List.append_assoc]
    exact midTop_spec (midCtx_assembled hsol hD hG hpos R) x μ fr hpre hok
end
