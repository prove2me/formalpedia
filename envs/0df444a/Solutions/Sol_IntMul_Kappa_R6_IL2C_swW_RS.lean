theorem bits_flR {recs : ℕ → List ℤ} (hb : ∀ m, KFL.Bits (recs m)) (M : ℕ) : KFL.Bits (flR recs M) := by
  intro z hz
  simp only [flR, List.mem_flatMap] at hz
  obtain ⟨m, -, hm⟩ := hz
  exact hb m z hm

