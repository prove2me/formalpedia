  obtain ⟨c, hfc, hGc, -⟩ := TypeDensity.glued_function_initial_form R S.t S.x beta _ G hreg hregSwap f hf
  set k := IsLocalRing.ResidueField R
  set H : Polynomial k := ∑ i : Fin (TypeDensity.curveDataDegree D+1),
    Polynomial.C (IsLocalRing.residue R (c i)) * Polynomial.X ^ i.val with hHdef
  set P := TypeDensity.divisorAffinePolynomial k Dv with hPdef
