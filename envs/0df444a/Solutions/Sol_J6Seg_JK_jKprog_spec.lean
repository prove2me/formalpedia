`partP`: from the row `v` (length `G`) on `V` and the table body
`flatT fs ++ flatB k bs ++ flatT cc` on `dTJ`, the forward loop, the backward loop, the cyclic
extension and the coupling window leave `W = Wl.reverse` with
`Wl = (range m).map (wF P cc (zext K (bwdS P bs (fA P fs v m) m).1))`; every other stack is as
before (`V` emptied), the table is restored from `TT` (`partP_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL NLogN.KFB Function Finset

theorem zsz_lt_pow {n B : ℕ} (h : n < 2 ^ B) : zsz (n : ℤ) ≤ B := by
  apply zsz_le_of_lt; simpa using h

theorem uC_facts (Φm Bx Bc : ℕ) : 2 * 10 ^ 5 * (Bx + 2) ≤ uC Φm Bx Bc ∧
    15 * (2000 * (Bx + 2)) + 5 * 32 ≤ uC Φm Bx Bc ∧
    8000 * (Bx + 2) + 2 * Bx + 32 ≤ uC Φm Bx Bc ∧ 14000 * (Bx + 2) ≤ uC Φm Bx Bc := by
  simp only [uC]; refine ⟨by omega, by omega, by omega, by omega⟩

end J6Seg.JK

end

