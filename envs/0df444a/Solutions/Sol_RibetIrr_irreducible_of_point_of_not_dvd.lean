  (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
    ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)

theorem toZModPow_pow_val_mod (n k : ℕ) :
    (PadicInt.toZModPow n ((p : ℤ_[p]) ^ k)).val % p ^ n = p ^ k % p ^ n := by
  rw [map_pow, map_natCast, ← Nat.cast_pow, ZMod.val_natCast, Nat.mod_mod]

include hsmul in

theorem coe_pow_smul (k : ℕ) (y : ModularCurve.TateModule p J) :
    ((((p : ℤ_[p]) ^ k) • y : ModularCurve.TateModule p J) : ℕ → J) = (p ^ k : ℕ) • (y : ℕ → J) := by
  funext n
  rw [hsmul, Pi.smul_apply]
  exact nsmul_eq_of_mod_eq p J (by rw [toZModPow_pow_val_mod]) (ModularCurve.TateModule.pow_smul_apply y.2 n)

