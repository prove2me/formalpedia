  · rw [abs_of_nonneg ha]
    constructor <;> nlinarith
  · rw [abs_of_neg ha]
    constructor <;> nlinarith

theorem expTerm_abs_le (N : ℕ) (X Y W : ℤ) (hW : |X| + |Y| ≤ W) (k : ℕ) :
