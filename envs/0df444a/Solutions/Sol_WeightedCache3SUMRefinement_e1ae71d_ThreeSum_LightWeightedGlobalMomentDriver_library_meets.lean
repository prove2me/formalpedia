noncomputable section
open WeightedCache3SUMRefinement_e1ae71d.ThreeSum WeightedCache3SUMRefinement_e1ae71d.ThreeSum.LightWeightedGlobalMomentDriver
open Light TernaryMomentSchedule
set_option maxHeartbeats 2000000
namespace WeightedCache3SUMRefinement_e1ae71d.ThreeSum.LightWeightedGlobalMomentDriver
theorem _root_.solution {lim : Limits} {d i T : ℕ} {vals : List ℤ} {μ : ℕ→ℤ}
    {R : ℤ→(ℕ→ℤ)→Prop} (xl yl zl xr yr zr : List ℤ) (steps : List (ℕ×ℕ))
    (hi : i<steps.length)
    (h : Meets lim (LightWeightedGlobalMomentSourceProgram.program xl yl zl xr yr zr
      (steps.getD i (0,0)).1 (steps.getD i (0,0)).2) 138 d vals μ T R) :
    Meets lim (library xl yl zl xr yr zr steps) (139*i+138) d vals μ T R := by
  induction steps generalizing i with
  | nil => simp at hi
  | cons c cs ih =>
    cases i with
    | zero =>
      simpa only [library,ReportingHostRelocation.program,List.getD_cons_zero,
        LightWeightedGlobalMomentSourceProgram.program_length,Nat.mul_zero,Nat.zero_add] using
        h.append ((library xl yl zl xr yr zr cs).map (ReportingHostRelocation.relocate 139))
    | succ i =>
      have hi' : i<cs.length := by simpa using hi
      have hh := ih hi' (by simpa only [List.getD_cons_succ] using h)
      have hr := ReportingHostRelocation.meets hh
        (LightWeightedGlobalMomentSourceProgram.program xl yl zl xr yr zr c.1 c.2)
      convert hr using 1 <;> simp only [library,LightWeightedGlobalMomentSourceProgram.program_length] <;> omega
end WeightedCache3SUMRefinement_e1ae71d.ThreeSum.LightWeightedGlobalMomentDriver
