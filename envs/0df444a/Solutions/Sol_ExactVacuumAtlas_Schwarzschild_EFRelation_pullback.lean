open Real
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.EFRelation
set_option maxHeartbeats 4000000
theorem solution (M ε : ℝ) (hε : ε ^ 2 = 1) {x : Pt 4} (hx : x ∈ domStd M) :
    (jac M ε x).transpose * metricMatrix (gEF M ε) (toEF M ε x) * jac M ε x =
      metricMatrix (gStd M) x := by
  have hr := domStd_r hx
  have hD := domStd_D hx
  have hε' : ε * ε = 1 := by rw [← sq]; exact hε
  have e2 : 1 - 2 * M / x 1 = (x 1 - 2 * M) / x 1 := by field_simp
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, jac, metricMatrix, gEF, gStd] <;>
    rcases mul_self_eq_one_iff.mp hε' with rfl | rfl <;>
    first
    | ring1
    | (rw [e2]; field_simp; ring1)
    | (field_simp; ring1)
    | (rw [e2]; field_simp)
    | norm_num
