section
-- Source module: Solutions.J6SegILPre7
/-!
# B-line IL, pre-tables (B5), part 7: the stage tables `di`, `dd`

`stDI O` / `stDD O` push `(mkTables P R s t α).di u` / `.dd u` for `u = 0, …, λ-1` onto `O`
(so `O` gains `(diL …).reverse` / `(ddL …).reverse`, the layout of `tabK`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem expNegCost_mono {n a b a' b' : ℕ} (ha : a ≤ a') (hb : b ≤ b') :
    expNegCost n a b ≤ expNegCost n a' b' := by
  unfold expNegCost; gcongr <;> omega

theorem expPosCost_mono {n a b a' b' σ : ℕ} (ha : a ≤ a') (hb : b ≤ b') :
    expPosCost n a b σ ≤ expPosCost n a' b' σ := by
  unfold expPosCost; gcongr <;> omega

theorem zsz_nat_of_VB {w : Fin HS → ℤ} {A : ℕ} (hw : VB w A) {j : Fin HS} (hj : j ∈ rg) {a : ℕ}
    (h : w j = a) : zsz (a : ℤ) ≤ BW A := by rw [← h]; exact zsz_of_VB (hw j hj)

theorem inRg_of {e : Ex HS} (h : (e.regs.all fun i => decide (i ∈ rg)) = true) : InRg e := by
  intro i hi; simpa using List.all_eq_true.1 h i hi

/-- The `di` call from registers with `U = k`. -/
theorem clDI_sp (s : IState HS) (w : Fin HS → ℤ) (cc : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hw : VB w A) {P sN tN aN k : ℕ} (h20 : w 20 = P) (h22 : w 22 = sN) (h23 : w 23 = tN)
    (h25 : w 25 = aN) (h12 : w 12 = k)
    (hr : |expNeg P sN (aN ^ 2 * (tN - sN) * k ^ 2)| ≤ 2 ^ A) :
    Sp clDI (encK s (RF w cc))
      (encK s (RF (Function.update w 11 (expNeg P sN (aN ^ 2 * (tN - sN) * k ^ 2))) cc))
      (cCall (.reg 20) (.reg 22) jDE (.lit 0) (BW A) (expNegCost P (BW A) (BW A))) := by
  have hj : jDE.eval (encK s (RF w cc)) = ((aN ^ 2 * (tN - sN) * k ^ 2 : ℕ) : ℤ) :=
    jDE_eval h22 h23 h25 h12
  have ij : InRg jDE := inRg_of (by decide)
  have zj : zsz ((aN ^ 2 * (tN - sN) * k ^ 2 : ℕ) : ℤ) ≤ BW A := by
    rw [← hj]; exact zsz_eval ij (vb_regs hw ij) (mgB hA (by decide) (by decide))
  have H := callC_sp s w cc (d := 11) (by decide) (inRg_of (e := .reg 20) (by decide))
    (inRg_of (e := .reg 22) (by decide)) ij (inRg_of (e := .lit 0) (by decide))
    (ok_RF (inRg_of (by decide)) rfl) (ok_RF (inRg_of (by decide)) rfl)
    (ok_RF ij rfl) trivial
    (a16 := P) (a17 := sN) (a18 := aN ^ 2 * (tN - sN) * k ^ 2) (a27 := 0)
    (by rw [ev_reg (by decide), h20]) (by rw [ev_reg (by decide), h22]) hj rfl
    (expNeg_prog P sN (aN ^ 2 * (tN - sN) * k ^ 2))
    (V := fun _ => 2 ^ A) (B := BW A)
    (vb_regs hw (inRg_of (by decide))) (vb_regs hw (inRg_of (by decide))) (vb_regs hw ij)
    (vb_regs hw (inRg_of (by decide)))
    (mgB hA (by decide) (by decide)) (mgB hA (by decide) (by decide))
    (mgB hA (by decide) (by decide)) (mgB hA (by decide) (by decide))
    (zsz_of_VB hr) (zsz_of_VB (hw 11 (by decide)))
  refine H.mono ?_
  unfold cCall
  have := expNegCost_mono (n := P) (zsz_nat_of_VB hw (by decide) h22) zj
  omega

/-- The `dd` call from registers with `U = k`. -/
theorem clDD_sp (s : IState HS) (w : Fin HS → ℤ) (cc : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hw : VB w A) {P R sN tN aN k : ℕ} (h20 : w 20 = P) (h21 : w 21 = R) (h22 : w 22 = sN)
    (h23 : w 23 = tN) (h25 : w 25 = aN) (h12 : w 12 = k)
    (hr : |expPos (P + R) sN (aN ^ 2 * (tN - sN) * k ^ 2) R| ≤ 2 ^ A) :
    Sp clDD (encK s (RF w cc))
      (encK s (RF (Function.update w 11 (expPos (P + R) sN (aN ^ 2 * (tN - sN) * k ^ 2) R)) cc))
      (cCall (.add (.reg 20) (.reg 21)) (.reg 22) jDE (.reg 21) (BW A)
        (expPosCost (P + R) (BW A) (BW A) R)) := by
  have hj : jDE.eval (encK s (RF w cc)) = ((aN ^ 2 * (tN - sN) * k ^ 2 : ℕ) : ℤ) :=
    jDE_eval h22 h23 h25 h12
  have ij : InRg jDE := inRg_of (by decide)
  have zj : zsz ((aN ^ 2 * (tN - sN) * k ^ 2 : ℕ) : ℤ) ≤ BW A := by
    rw [← hj]; exact zsz_eval ij (vb_regs hw ij) (mgB hA (by decide) (by decide))
  have H := callC_sp s w cc (d := 11) (by decide) (inRg_of (e := .add (.reg 20) (.reg 21)) (by decide))
    (inRg_of (e := .reg 22) (by decide)) ij (inRg_of (e := .reg 21) (by decide))
    (ok_RF (inRg_of (by decide)) rfl) (ok_RF (inRg_of (by decide)) rfl)
    (ok_RF ij rfl) (ok_RF (inRg_of (by decide)) rfl)
    (a16 := P + R) (a17 := sN) (a18 := aN ^ 2 * (tN - sN) * k ^ 2) (a27 := R)
    (by simp only [Ex.eval, top_RF (show (20 : Fin HS) ∈ rg by decide),
      top_RF (show (21 : Fin HS) ∈ rg by decide), h20, h21]; push_cast; ring)
    (by rw [ev_reg (by decide), h22]) hj (by rw [ev_reg (by decide), h21])
    (expPos_prog (P + R) sN (aN ^ 2 * (tN - sN) * k ^ 2) R)
    (V := fun _ => 2 ^ A) (B := BW A)
    (vb_regs hw (inRg_of (by decide))) (vb_regs hw (inRg_of (by decide))) (vb_regs hw ij)
    (vb_regs hw (inRg_of (by decide)))
    (mgB hA (by decide) (by decide)) (mgB hA (by decide) (by decide))
    (mgB hA (by decide) (by decide)) (mgB hA (by decide) (by decide))
    (zsz_of_VB hr) (zsz_of_VB (hw 11 (by decide)))
  refine H.mono ?_
  unfold cCall
  have := expPosCost_mono (n := P + R) (σ := R) (zsz_nat_of_VB hw (by decide) h22) zj
  omega

theorem writes_callC (d : Fin HS) (e1 e2 e3 e4 : Ex HS) (p : RS) (h : Cu ∉ p.writes)
    (hd : d ≠ Cu) : Cu ∉ (callC d e1 e2 e3 e4 p).writes := by
  simp [callC, RS.writes, h, Ne.symm hd]; decide

theorem cu_expNeg : Cu ∉ expNegP.writes := by decide
theorem cu_expPos : Cu ∉ expPosP.writes := by decide

/-- **`di` table.** -/
theorem stDI_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {P R sN tN lam aN A : ℕ}
    (hi : StIn v P R sN tN lam aN A)
    (hf : ∀ k < lam, |(mkTables P R sN tN aN).di k| ≤ 2 ^ A) :
    Sp (stDI O) (encK s (RF v c))
      (encK s (RF (wS v (mkTables P R sN tN aN).di lam) (Function.update c O
        ((diL P R sN tN lam aN).reverse ++ c O))))
      (cSt A lam (cCall (.reg 20) (.reg 22) jDE (.lit 0) (BW A) (expNegCost P (BW A) (BW A)))) :=
  cLoop_sp1 s v c hO hO5 hOC hc (writes_callC _ _ _ _ _ _ cu_expNeg (by decide)) hi.A2 hi.vb hi.h24
    hi.lam _ hf (fun k hk w cc hw h12 hoth => clDI_sp s w cc hi.A2 hw
      (by rw [hoth 20 (by decide) (by decide), hi.h20]) (by rw [hoth 22 (by decide) (by decide), hi.h22])
      (by rw [hoth 23 (by decide) (by decide), hi.h23]) (by rw [hoth 25 (by decide) (by decide), hi.h25])
      h12 (hf k hk))

/-- **`dd` table.** -/
theorem stDD_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {P R sN tN lam aN A : ℕ}
    (hi : StIn v P R sN tN lam aN A)
    (hf : ∀ k < lam, |(mkTables P R sN tN aN).dd k| ≤ 2 ^ A) :
    Sp (stDD O) (encK s (RF v c))
      (encK s (RF (wS v (mkTables P R sN tN aN).dd lam) (Function.update c O
        ((ddL P R sN tN lam aN).reverse ++ c O))))
      (cSt A lam (cCall (.add (.reg 20) (.reg 21)) (.reg 22) jDE (.reg 21) (BW A)
        (expPosCost (P + R) (BW A) (BW A) R))) :=
  cLoop_sp1 s v c hO hO5 hOC hc (writes_callC _ _ _ _ _ _ cu_expPos (by decide)) hi.A2 hi.vb hi.h24
    hi.lam _ hf (fun k hk w cc hw h12 hoth => clDD_sp s w cc hi.A2 hw
      (by rw [hoth 20 (by decide) (by decide), hi.h20]) (by rw [hoth 21 (by decide) (by decide), hi.h21])
      (by rw [hoth 22 (by decide) (by decide), hi.h22])
      (by rw [hoth 23 (by decide) (by decide), hi.h23]) (by rw [hoth 25 (by decide) (by decide), hi.h25])
      h12 (hf k hk))

end J6Seg.PreT

