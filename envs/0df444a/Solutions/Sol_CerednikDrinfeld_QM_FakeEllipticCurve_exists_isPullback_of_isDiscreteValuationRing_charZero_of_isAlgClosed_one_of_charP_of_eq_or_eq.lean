theorem ringHom_eq_of_local {O R κ : Type} [CommRing O] [CommRing R] [IsLocalRing R] [Field κ] [Algebra O R]
    (res : O →+* κ) (hres : Function.Surjective res)
    (f g : R →+* κ) (hf : f.comp (algebraMap O R) = res) (hg : g.comp (algebraMap O R) = res)
    (hg' : ∀ x ∈ IsLocalRing.maximalIdeal R, g x = 0) : g = f := by
  ext r
  obtain ⟨o, ho⟩ := hres (f r)
  have hfo : f (algebraMap O R o) = f r := by rw [← RingHom.comp_apply, hf, ho]
  have hmem : r - algebraMap O R o ∈ IsLocalRing.maximalIdeal R := by
    have hker : r - algebraMap O R o ∈ RingHom.ker f := by rw [RingHom.mem_ker, map_sub, hfo, sub_self]
    exact IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top f) hker
  have h0 := hg' _ hmem
  rw [map_sub, sub_eq_zero] at h0
  rw [h0, ← RingHom.comp_apply, hg, ho]

theorem isIso_map {p : ℕ} [Fact p.Prime] {B B' : Type} [CommRing B] [CommRing B'] (f : B →+* B')
    {X Y : FormalODModule p B} (u : X.Hom Y) (hu : u.IsIso) : (u.map f).IsIso := by
  obtain ⟨v, hv₁, hv₂⟩ := hu
  refine ⟨v.map f, ?_, ?_⟩
  · apply FormalODModule.Hom.ext
    have h := congrArg (fun w : X.Hom X => w.toSeries.map f) hv₁
    change (v.toSeries.map f).comp (u.toSeries.map f) = Series.id B'
    rw [← Series.map_comp f _ _ u.isODHom.constantCoeff]
    change (FormalODModule.Hom.comp v u).toSeries.map f = Series.id B'
    rw [hv₁]; exact Series.map_id f
  · apply FormalODModule.Hom.ext
    change (u.toSeries.map f).comp (v.toSeries.map f) = Series.id B'
    rw [← Series.map_comp f _ _ v.isODHom.constantCoeff]
    change (FormalODModule.Hom.comp u v).toSeries.map f = Series.id B'
    rw [hv₂]; exact Series.map_id f

theorem exists_inv {p : ℕ} [Fact p.Prime] {B : Type} [CommRing B] {X Y : FormalODModule p B} (u : X.Hom Y) (hu : u.IsIso) :
    ∃ v : Y.Hom X, v.IsIso := by
  obtain ⟨v, hv₁, hv₂⟩ := hu
  exact ⟨v, u, hv₂, hv₁⟩

theorem finiteBySections_pullback_of_isPullback {R R' : Type} [CommRing R] [CommRing R'] (φ : R →+* R')
    {X X' : Scheme.{0}} {f : X ⟶ Spec (.of R)} {f' : X' ⟶ Spec (.of R')} (g : X' ⟶ X)
    (hg : IsPullback g f' f (Spec.map (CommRingCat.ofHom φ)))
    {M : X.Modules} (hM : Scheme.Modules.FiniteBySections M f) :
    Scheme.Modules.FiniteBySections ((Scheme.Modules.pullback g).obj M) f' := by
  letI : Algebra R R' := φ.toAlgebra
  obtain ⟨N, 𝔓, h𝔓⟩ := hM
  have sq : IsPullback g f' f (Spec.map (CommRingCat.ofHom (algebraMap R R'))) := hg
  obtain ⟨𝔓', -, -, hsq⟩ := AlgebraicGeometry.Scheme.Modules.ProjPresentation.exists_baseChange_of_isPullback sq 𝔓
  exact ⟨N, 𝔓', MorphismProperty.of_isPullback hsq h𝔓⟩

noncomputable def threeIso {X : Scheme.{0}} (L : X.Modules) : L ⊗ (L ⊗ L) ≅ L.tensorPow 3 :=
  (α_ L L L).symm ≪≫ (((λ_ L).symm ⊗ᵢ Iso.refl L) ⊗ᵢ Iso.refl L)

theorem finrank_sections_pos_of_geomFibreH0Finrank_pos
    {k : Type} [Field k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k)) [IsProper f]
    (𝓜 : A.Modules) (h𝓜 : Scheme.Modules.IsInvertible 𝓜)
    (h : 0 < Scheme.Modules.geomFibreH0Finrank f 𝓜 k (RingHom.id k)) :
    letI : Algebra k Γ(A, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ le_top).hom.toAlgebra
    letI : Module k Γ(𝓜, ⊤) := Module.compHom _ (algebraMap k Γ(A, ⊤))
    0 < Module.finrank k Γ(𝓜, ⊤) := by
  rw [Scheme.Modules.geomFibreH0Finrank_id_eq_finrank_sections k f 𝓜 h𝓜] at h
  exact h

