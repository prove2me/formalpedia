lemma eKz_closed (l h : ℤ) :
    eKz s t l h = (t * h + bOf s t l - bOf s t (l + h)) *
      ((t * h + bOf s t l - bOf s t (l + h)) + 2 * bOf s t (l + h)) := by
  unfold eKz; ring

lemma sn_eq (l h : ℤ) : (t : ℤ) * h + bOf s t l - bOf s t (l + h) =
    s * ((2 * t * (l + h) + s) / (2 * s) - (2 * t * l + s) / (2 * s)) := by
  unfold bOf; ring

/-- `eKz ≥ s² |h| (|h| - 1)`. -/
