lemma foldl_mat (gs : List (SGate W)) (A : Matrix W W (ZMod 2)) :
    gs.foldl (fun M g => g.1 * M) A = NetScalar.runMat gs * A := by
  induction gs generalizing A with
  | nil => simp [NetScalar.runMat]
  | cons g gs ih =>
    simp only [List.foldl_cons, NetScalar.runMat]
    rw [ih, ih (g.1 * 1), mul_one, mul_assoc]

lemma runMat_append (l₁ l₂ : List (SGate W)) : NetScalar.runMat (l₁ ++ l₂) = NetScalar.runMat l₂ * NetScalar.runMat l₁ := by
  simp only [NetScalar.runMat, List.foldl_append]
  exact NetScalar.foldl_mat _ _

lemma runMat_cons (g : SGate W) (l : List (SGate W)) : NetScalar.runMat (g :: l) = NetScalar.runMat l * g.1 := by
  rw [show g :: l = [g] ++ l from rfl, NetScalar.runMat_append]
  simp [NetScalar.runMat]

lemma sRun_eq (gs : List (SGate W)) (v : W → ZMod 2) : NetScalar.sRun gs v = NetScalar.runMat gs *ᵥ v := by
  induction gs generalizing v with
  | nil => simp [NetScalar.sRun, NetScalar.runMat]
  | cons g gs ih =>
    simp only [NetScalar.sRun, List.foldl_cons] at ih ⊢
    rw [ih, NetScalar.runMat_cons, ← Matrix.mulVec_mulVec]

lemma scalarRun_labelled {N M : Type*} (lab : N → M) (gs : List (N × SGate W)) (v : W → ZMod 2) :
    scalarRun (NetScalar.labelled lab gs) v = NetScalar.sRun (gs.map Prod.snd) v := by
  induction gs generalizing v with
  | nil => rfl
  | cons g gs ih =>
    simp only [NetScalar.labelled, List.map_cons, scalarRun, NetScalar.sRun, List.foldl_cons] at ih ⊢
    exact ih _

lemma ok_labelled {N M : Type*} [AddGroup M] (lab : N → M) (gs : List (N × SGate W))
    (h : ∀ g ∈ gs, NetScalar.SOK g.2) : ∀ g ∈ NetScalar.labelled lab gs, g.OK := by
  intro g hg
  simp only [NetScalar.labelled, List.mem_map] at hg
  obtain ⟨g', hg', rfl⟩ := hg
  exact h g' hg'

lemma egM_apply {ι : Type*} (A : Finset ι) (r c : ι → W) (w w' : W) :
    NetScalar.egM A r c w w' = ∑ x ∈ A, if r x = w ∧ c x = w' then 1 else 0 := by
  simp [NetScalar.egM, Matrix.sum_apply, single_apply]

lemma egM_mulVec {ι : Type*} (A : Finset ι) (r c : ι → W) (v : W → ZMod 2) (w : W) :
    (NetScalar.egM A r c *ᵥ v) w = ∑ x ∈ A, if r x = w then v (c x) else 0 := by
  simp only [mulVec, dotProduct, NetScalar.egM_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  by_cases h : r x = w <;> simp [h]

lemma egM_ok {ι : Type*} (A : Finset ι) (r c : ι → W) (K : Finset W)
    (hK : ∀ x ∈ A, r x ∈ K ∧ c x ∈ K) : NetScalar.SOK ((1 + NetScalar.egM A r c, K) : SGate W) := by
  intro w w'
  refine ⟨fun hw => ?_, fun hw hw' => ?_⟩
  · simp only [Matrix.add_apply, one_apply, NetScalar.egM_apply]
    rw [Finset.sum_eq_zero, add_zero]
    intro x hx
    have : r x ≠ w := fun h => hw (h ▸ (hK x hx).1)
    simp [this]
  · simp only [Matrix.add_apply, one_apply, NetScalar.egM_apply]
    have hne : w ≠ w' := fun h => hw' (h ▸ hw)
    rw [Finset.sum_eq_zero]
    · simp [hne]
    intro x hx
    have : c x ≠ w' := fun h => hw' (h ▸ (hK x hx).2)
    simp [this]

lemma egM_mul {ι κ : Type*} (A : Finset ι) (r c : ι → W) (B : Finset κ) (r' c' : κ → W) :
    NetScalar.egM A r c * NetScalar.egM B r' c' =
      ∑ x ∈ A, ∑ y ∈ B, if c x = r' y then (single (r x) (c' y) (1 : ZMod 2) : Matrix W W (ZMod 2)) else 0 := by
  simp only [NetScalar.egM, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  refine Finset.sum_congr rfl fun y _ => ?_
  by_cases h : c x = r' y
  · simp [h]
  · simp [h]

lemma egM_mul_zero {ι κ : Type*} (A : Finset ι) (r c : ι → W) (B : Finset κ) (r' c' : κ → W)
    (h : ∀ x y, c x ≠ r' y) : NetScalar.egM A r c * NetScalar.egM B r' c' = 0 := by
  rw [NetScalar.egM_mul]
  exact Finset.sum_eq_zero fun x _ => Finset.sum_eq_zero fun y _ => by simp [h x y]

/-- Blocks whose net effects `1 + f i` pairwise compose to zero products run as `1 + ∑ f`. -/
lemma runMat_flatMap {ι : Type*} (L : List ι) (blk : ι → List (SGate W))
    (f : ι → Matrix W W (ZMod 2)) (hb : ∀ i ∈ L, NetScalar.runMat (blk i) = 1 + f i)
    (hz : ∀ i ∈ L, ∀ j ∈ L, f i * f j = 0) :
    NetScalar.runMat (L.flatMap blk) = 1 + (L.map f).sum := by
  induction L with
  | nil => simp [NetScalar.runMat]
  | cons i L ih =>
    rw [List.flatMap_cons, NetScalar.runMat_append, ih (fun j hj => hb j (List.mem_cons_of_mem _ hj))
      (fun a ha b hb' => hz a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb')),
      hb i List.mem_cons_self]
    have : (L.map f).sum * f i = 0 := by
      rw [← List.sum_map_mul_right]
      exact List.sum_eq_zero fun x hx => by
        obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hx
        exact hz j (List.mem_cons_of_mem _ hj) i List.mem_cons_self
    rw [List.map_cons, List.sum_cons]
    simp only [mul_add, add_mul, one_mul, mul_one, this]
    abel

lemma runMat_map {ι : Type*} (L : List ι) (g : ι → SGate W)
    (f : ι → Matrix W W (ZMod 2)) (hb : ∀ i ∈ L, (g i).1 = 1 + f i)
    (hz : ∀ i ∈ L, ∀ j ∈ L, f i * f j = 0) :
    NetScalar.runMat (L.map g) = 1 + (L.map f).sum := by
  rw [show L.map g = L.flatMap fun i => [g i] by induction L <;> simp_all]
  exact NetScalar.runMat_flatMap L _ f (fun i hi => by simp [NetScalar.runMat, hb i hi]) hz

lemma two_eq_zero_mat (X : Matrix W W (ZMod 2)) : X + X = 0 := by
  ext i j
  simp only [Matrix.add_apply, Matrix.zero_apply]
  generalize X i j = a
  revert a; decide

end Generic

lemma neg_mat_two {W : Type*} (X : Matrix W W (ZMod 2)) : -X = X := by
  ext i j
  simp only [Matrix.neg_apply]
  generalize X i j = a
  revert a; decide

section Invocation

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))
variable {W : Type*} [Fintype W] [DecidableEq W]

variable {ind}

lemma sum_ite_card {ι : Type*} [Fintype ι] [DecidableEq ι] (s : Finset ι)
    (F : Matrix W W (ZMod 2)) :
    ∑ i, (if i ∈ s then F else 0) = ((#s : ℕ) : ZMod 2) • F := by
  rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, Nat.cast_smul_eq_nsmul]

lemma sum_Pinc {M : Type*} [AddCommMonoid M] (f : Fin h → T → M) :
    ∑ q ∈ NetScalar.Pinc ind, f q.1 q.2 = ∑ i, ∑ S, if i ∈ ind S then f i S else 0 := by
  rw [Finset.sum_filter, Fintype.sum_prod_type]

variable {I : Inv ind W}

lemma Inv.Cm_mul_Gm (hG : I.Good) : I.Cm * I.Gm =
    ∑ S, ∑ t, ((#(ind S ∩ ind t) : ℕ) : ZMod 2) • single (I.tgt S) (I.src t) (1 : ZMod 2) := by
  unfold NetScalar.Inv.Cm NetScalar.Inv.Gm
  rw [NetScalar.egM_mul]
  simp only [hG.cen_inj.eq_iff]
  have hin : ∀ (i : Fin h) (S : T), ∑ q' ∈ NetScalar.Pinc ind,
      (if i = q'.1 then single (I.tgt S) (I.src q'.2) (1 : ZMod 2) else 0) =
      ∑ t, if i ∈ ind t then single (I.tgt S) (I.src t) (1 : ZMod 2) else 0 := by
    intro i S
    rw [sum_Pinc (fun i' t => if i = i' then single (I.tgt S) (I.src t) (1 : ZMod 2) else 0),
      Finset.sum_comm]
    refine Finset.sum_congr rfl fun t _ => ?_
    by_cases hi : i ∈ ind t
    · simp [hi]
    · simp only [hi, if_false]
      exact Finset.sum_eq_zero fun i' _ => by
        by_cases e : i = i'
        · subst e; simp [hi]
        · simp [e]
  rw [sum_Pinc (fun i S => ∑ q' ∈ NetScalar.Pinc ind,
    (if i = q'.1 then single (I.tgt S) (I.src q'.2) (1 : ZMod 2) else 0))]
  simp only [hin]
  simp_rw [← sum_ite_card, Finset.mem_inter]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun S _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  by_cases hi : i ∈ ind S <;> simp [hi]

lemma Inv.Dm_mul_Bm (hG : I.Good) : I.Dm * I.Bm =
    ∑ S, ∑ t, (if #(ind S ∩ ind t) = 1 then 1 else 0 : ZMod 2) •
      single (I.tgt S) (I.src t) (1 : ZMod 2) := by
  unfold NetScalar.Inv.Dm NetScalar.Inv.Bm
  rw [NetScalar.egM_mul]
  simp only [hG.side_inj.eq_iff, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [← Finset.sum_subtype (univ.filter fun st : T × T => #(ind st.1 ∩ ind st.2) = 1)
    (by simp) (fun st => single (I.tgt st.1) (I.src st.2) (1 : ZMod 2)),
    Finset.sum_filter, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun S _ => Finset.sum_congr rfl fun t _ => ?_
  split_ifs <;> simp

lemma Inv.Jm_eq : I.Jm =
    ∑ S, ∑ t, (if S = t then 1 else 0 : ZMod 2) • single (I.tgt S) (I.src t) (1 : ZMod 2) := by
  simp [NetScalar.Inv.Jm, NetScalar.egM, ite_smul]

/-- The key parity identity: for card-3 sets with `ind` injective,
`|S ∩ T| + [|S ∩ T| = 1] ≡ [S = T] (mod 2)`. -/
lemma key_parity (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (S t : T) :
    ((#(ind S ∩ ind t) : ℕ) : ZMod 2) + (if #(ind S ∩ ind t) = 1 then 1 else 0) =
      if S = t then 1 else 0 := by
  by_cases e : S = t
  · subst e
    rw [Finset.inter_self, hcard, if_pos rfl]
    decide
  · have hle : #(ind S ∩ ind t) ≤ 3 := (hcard S) ▸ Finset.card_le_card Finset.inter_subset_left
    have hne : #(ind S ∩ ind t) ≠ 3 := by
      intro h3
      have h1 : ind S ∩ ind t = ind S :=
        Finset.eq_of_subset_of_card_le Finset.inter_subset_left (by rw [h3, hcard])
      have h2 : ind S ∩ ind t = ind t :=
        Finset.eq_of_subset_of_card_le Finset.inter_subset_right (by rw [h3, hcard])
      exact e (hinj (h1.symm.trans h2))
    rw [if_neg e]
    generalize #(ind S ∩ ind t) = n at hle hne ⊢
    interval_cases n <;> first | decide | exact absurd rfl hne

/-- Net target change of a forward invocation: `R G + J V = J` (central plus side). -/
lemma Inv.CG_add_DB (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (hG : I.Good) :
    I.Cm * I.Gm + I.Dm * I.Bm = I.Jm := by
  rw [I.Cm_mul_Gm hG, I.Dm_mul_Bm hG, NetScalar.Inv.Jm_eq, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun S _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [← add_smul, key_parity hcard hinj]

lemma Inv.runMat_side (hG : I.Good) (k : Fin 8) :
    NetScalar.runMat (((univ : Finset T).toList.map fun S => (((k, some S) : IName T), I.sideG S)).map
      Prod.snd) = 1 + I.Dm := by
  rw [List.map_map]
  rw [NetScalar.runMat_map _ _ (fun S => NetScalar.egM (univ.filter fun n : NetScalar.Nb ind => n.1.1 = S)
    (fun n => I.tgt n.1.1) I.side) (fun _ _ => rfl)
    (fun _ _ _ _ => NetScalar.egM_mul_zero _ _ _ _ _ _ fun x y => (hG.ts _ _).symm)]
  rw [Finset.sum_map_toList]
  unfold NetScalar.Inv.Dm NetScalar.egM
  rw [Finset.sum_fiberwise]

lemma Inv.runMat_copy (hG : I.Good) (k : Fin 8) :
    NetScalar.runMat (((univ : Finset T).toList.map fun t => (((k, some t) : IName T), I.copyG t)).map
      Prod.snd) = 1 + I.Bm := by
  rw [List.map_map]
  rw [NetScalar.runMat_map _ _ (fun t => NetScalar.egM (univ.filter fun n : NetScalar.Nb ind => n.1.2 = t)
    I.side (fun n => I.src n.1.2)) (fun _ _ => rfl)
    (fun _ _ _ _ => NetScalar.egM_mul_zero _ _ _ _ _ _ fun x y => hG.ss _ _)]
  rw [Finset.sum_map_toList]
  unfold NetScalar.Inv.Bm NetScalar.egM
  rw [Finset.sum_fiberwise]

lemma Inv.runMat_scat (k : Fin 8) :
    NetScalar.runMat ([(((k, none) : IName T), I.scatG)].map Prod.snd) = 1 + I.Cm := by
  simp [NetScalar.runMat, NetScalar.Inv.scatG, NetScalar.Inv.Cm]

lemma Inv.runMat_gath (k : Fin 8) :
    NetScalar.runMat ([(((k, none) : IName T), I.gathG)].map Prod.snd) = 1 + I.Gm := by
  simp [NetScalar.runMat, NetScalar.Inv.gathG, NetScalar.Inv.Gm]

/-- **Lemma 5, matrix form.** The forward schedule of one invocation has matrix `1 + J`. -/
theorem Inv.runMat_gates (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (hG : I.Good) : NetScalar.runMat I.gates = 1 + I.Jm := by
  have z : ∀ {ι κ : Type _} (A : Finset ι) (r c : ι → W) (B : Finset κ) (r' c' : κ → W),
      (∀ x y, c x ≠ r' y) → NetScalar.egM A r c * NetScalar.egM B r' c' = 0 := fun A r c B r' c' h =>
    NetScalar.egM_mul_zero A r c B r' c' h
  have key := eight_rows I.Bm I.Gm I.Cm I.Dm
    (z _ _ _ _ _ _ fun _ _ => hG.ss _ _) (z _ _ _ _ _ _ fun _ _ => hG.sc _ _)
    (z _ _ _ _ _ _ fun _ _ => hG.st _ _) (z _ _ _ _ _ _ fun _ _ => hG.st _ _)
    (z _ _ _ _ _ _ fun _ _ => hG.ss _ _) (z _ _ _ _ _ _ fun _ _ => hG.sc _ _)
    (z _ _ _ _ _ _ fun _ _ => hG.st _ _) (z _ _ _ _ _ _ fun _ _ => hG.st _ _)
    (z _ _ _ _ _ _ fun _ _ => (hG.sic _ _).symm) (z _ _ _ _ _ _ fun _ _ => (hG.tc _ _).symm)
    (z _ _ _ _ _ _ fun _ _ => (hG.tc _ _).symm)
    (z _ _ _ _ _ _ fun _ _ => hG.sic _ _) (z _ _ _ _ _ _ fun _ _ => (hG.ts _ _).symm)
    (z _ _ _ _ _ _ fun _ _ => (hG.ts _ _).symm)
  simp only [sub_eq_add_neg, neg_mat_two, I.CG_add_DB hcard hinj hG] at key
  simp only [NetScalar.Inv.gates, NetScalar.Inv.named, List.map_append, NetScalar.runMat_append, I.runMat_side hG,
    I.runMat_copy hG, I.runMat_scat, I.runMat_gath]
  simpa only [mul_assoc] using key

/-- Every gate of an invocation is a valid gate on its touched set. -/
theorem Inv.gates_ok (I : NetScalar.Inv ind W) : ∀ g ∈ I.named, NetScalar.SOK g.2 := by
  intro g hg
  simp only [NetScalar.Inv.named, List.mem_append, List.mem_map, Finset.mem_toList, Finset.mem_univ,
    true_and, List.mem_singleton] at hg
  have hs : ∀ S, NetScalar.SOK (I.sideG S) := fun S => NetScalar.egM_ok _ _ _ _ fun x hx => by
    have : x.1.1 = S := (Finset.mem_filter.1 hx).2
    refine ⟨by simp [this], Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hx)⟩
  have hc : ∀ t, NetScalar.SOK (I.copyG t) := fun t => NetScalar.egM_ok _ _ _ _ fun x hx => by
    have : x.1.2 = t := (Finset.mem_filter.1 hx).2
    refine ⟨Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hx), by simp [this]⟩
  have hsc : NetScalar.SOK I.scatG := NetScalar.egM_ok _ _ _ _ fun x _ => by simp
  have hga : NetScalar.SOK I.gathG := NetScalar.egM_ok _ _ _ _ fun x _ => by simp
  rcases hg with ((((((⟨S, rfl⟩ | rfl) | ⟨t, rfl⟩) | rfl) | rfl) | ⟨S, rfl⟩) | rfl) | ⟨t, rfl⟩
  exacts [hs S, hsc, hc t, hga, hsc, hs S, hga, hc t]

end Invocation

section Bit

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))

variable {ind}

lemma srcW_ne_tgtW (j : Fin 3) (a b : T × T × T) : (NetScalar.srcW j a : NetScalar.Wr ind) ≠ NetScalar.tgtW j b := by
  unfold NetScalar.srcW NetScalar.tgtW NetScalar.wX NetScalar.wY; split_ifs <;> simp

lemma inv_good (j : Fin 3) (p : T × T) : (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).Good := by
  have e := emb_inj (T := T) j p
  refine ⟨fun t t' h' => e ?_, fun t t' h' => e ?_, fun n n' h' => ?_, fun i i' h' => ?_,
    fun a b => NetScalar.srcW_ne_tgtW _ _ _, fun a n => ?_, fun a i => ?_, fun a n => ?_, fun a i => ?_,
    fun n i => ?_⟩ <;>
    simp only [NetScalar.inv, NetScalar.srcW, NetScalar.tgtW, NetScalar.wX, NetScalar.wY, NetScalar.wS, NetScalar.wC] at * <;> (try split_ifs at *) <;> simp_all

variable (ind)

variable {ind}

lemma runMat_stage (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (j : Fin 3) :
    NetScalar.runMat ((univ : Finset (T × T)).toList.flatMap fun p =>
      (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).gates) = 1 + NetScalar.Kst j := by
  rw [NetScalar.runMat_flatMap _ _ (fun p => (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).Jm)
    (fun p _ => (NetScalar.inv j p).runMat_gates hcard hinj (NetScalar.inv_good j p))
    (fun _ _ _ _ => NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => NetScalar.srcW_ne_tgtW _ _ _),
    Finset.sum_map_toList]
  congr 1
  unfold NetScalar.Kst NetScalar.Inv.Jm NetScalar.egM
  exact sum_emb j fun a => single (NetScalar.tgtW j a) (NetScalar.srcW j a) (1 : ZMod 2)

lemma bitGates_eq : bitGates ind = ([0, 1, 2] : List (Fin 3)).flatMap fun j =>
    (univ : Finset (T × T)).toList.flatMap fun p => (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).gates := by
  simp only [bitGates, bitNamed, List.map_flatMap, List.map_map]
  rfl

lemma runMat_bitGates (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) :
    NetScalar.runMat (bitGates ind) = (1 + NetScalar.Kst 2) * ((1 + NetScalar.Kst 1) * (1 + NetScalar.Kst 0)) := by
  rw [bitGates_eq]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil, NetScalar.runMat_append,
    NetScalar.runMat_stage hcard hinj, mul_assoc]

lemma stage_apply (j : Fin 3) (u : NetScalar.Wr ind → ZMod 2) (w : NetScalar.Wr ind) :
    ((1 + NetScalar.Kst j) *ᵥ u) w = u w + ∑ a, if NetScalar.tgtW j a = w then u (NetScalar.srcW j a) else 0 := by
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply, NetScalar.Kst, NetScalar.egM_mulVec]

/-- **Bit exchange.** The scalar circuit sends wire `w` unchanged to wire `ρ w`: it swaps every
`X a` with `Y a` and restores every auxiliary wire. -/
theorem bit_exchange (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (v : NetScalar.Wr ind → ZMod 2) (w : NetScalar.Wr ind) : NetScalar.sRun (bitGates ind) v (NetScalar.ρ ind w) = v w := by
  rw [NetScalar.sRun_eq, runMat_bitGates hcard hinj, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rcases w with a | a | x
  · simp only [NetScalar.ρ, NetScalar.stage_apply, NetScalar.srcW, NetScalar.tgtW, NetScalar.wX, NetScalar.wY]
    simp only [Fin.isValue, Fin.reduceEq, if_false, if_true, Sum.inr.injEq, Sum.inl.injEq,
      reduceCtorEq, Finset.sum_ite_eq', Finset.mem_univ, Finset.sum_const_zero, add_zero]
    generalize v (Sum.inl a) = x
    generalize v (Sum.inr (Sum.inl a)) = y
    revert x y; decide
  · simp only [NetScalar.ρ, NetScalar.stage_apply, NetScalar.srcW, NetScalar.tgtW, NetScalar.wX, NetScalar.wY]
    simp only [Fin.isValue, Fin.reduceEq, if_false, if_true, Sum.inr.injEq, Sum.inl.injEq,
      reduceCtorEq, Finset.sum_ite_eq', Finset.mem_univ, Finset.sum_const_zero, add_zero]
    generalize v (Sum.inl a) = x
    generalize v (Sum.inr (Sum.inl a)) = y
    revert x y; decide
  · simp only [NetScalar.ρ, NetScalar.stage_apply, NetScalar.srcW, NetScalar.tgtW, NetScalar.wX, NetScalar.wY]
    simp

end Bit

end NetScalar

end

section
-- Source module: Solutions.NetProp7Chain
set_option linter.unusedSectionVars false

namespace NetProp7

open Matrix Finset AModel

section ChainSec

variable {M β : Type*} [AddGroup M] [AddCommMonoid β]

variable {Wr R : Type*} [Fintype Wr] [DecidableEq Wr]

/-- **Per-wire regrouping of `frameSum`.** -/
theorem frameSum_eq_chain (f : M → β) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum f gates lab Mout = ∑ w, chain f (lab w) (labelsOn w gates) (Mout w) := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum, labelsOn, chain]
  | cons g gs ih =>
    intro lab Mout
    rw [frameSum, ih]
    simp only [labelsOn_cons]
    have e : ∀ x, chain f (lab x) (if x ∈ g.2.1 then g.2.2 :: labelsOn x gs else labelsOn x gs)
        (Mout x) = (if x ∈ g.2.1 then f (g.2.2 - lab x) else 0) +
          chain f (labStep lab g x) (labelsOn x gs) (Mout x) := by
      intro x
      by_cases hx : x ∈ g.2.1 <;> simp [hx, labStep, chain]
    simp only [e, Finset.sum_add_distrib, Finset.sum_ite_mem, Finset.univ_inter]

end ChainSec

section Cast

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

lemma frameSum_cast_nat (f : M → ℕ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      ((frameSum f gates lab Mout : ℕ) : ℚ) = frameSum (fun a => (f a : ℚ)) gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum]
  | cons g gs ih => intro lab Mout; simp [frameSum, ih]

end Cast

section Transport

variable {Wr V R M M' : Type*} [Fintype Wr] [DecidableEq Wr] [Fintype V] [DecidableEq V]
  [CommRing R]

lemma trG_OK [AddGroup M] [AddGroup M'] (e : Wr ≃ V) (φ : M → M') {g : NGate Wr R M}
    (hg : g.OK) : (trG e φ g).OK := by
  intro w w'
  have := hg (e.symm w) (e.symm w')
  simp only [trG, Finset.mem_map_equiv, submatrix_apply, e.symm.injective.eq_iff] at this ⊢
  exact this

lemma scalarRun_trG [AddGroup M] [AddGroup M'] (e : Wr ≃ V) (φ : M → M') :
    ∀ (gates : List (NGate Wr R M)) (v : V → R) (w : V),
      scalarRun (gates.map (trG e φ)) v w = scalarRun gates (fun x => v (e x)) (e.symm w) := by
  intro gates
  induction gates with
  | nil => intro v w; simp [scalarRun]
  | cons g gs ih =>
    intro v w
    simp only [List.map_cons, scalarRun, List.foldl_cons] at ih ⊢
    rw [ih]
    have : (fun x => ((trG e φ g).1 *ᵥ v) (e x)) = g.1 *ᵥ fun x => v (e x) := by
      funext x
      simp only [trG, submatrix_mulVec_equiv, Function.comp_apply, Equiv.symm_symm,
        Equiv.symm_apply_apply]
      rfl
    rw [this]

lemma frameSum_trG [AddGroup M] [AddGroup M'] {β : Type*} [AddCommMonoid β] (e : Wr ≃ V)
    (φ : M →+ M') (f : M' → β) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum f (gates.map (trG e φ)) (fun w => φ (lab (e.symm w))) (fun w => φ (Mout (e.symm w)))
        = frameSum (fun a => f (φ a)) gates lab Mout := by
  intro gates
  induction gates with
  | nil =>
    intro lab Mout
    simp only [List.map_nil, frameSum, ← map_sub]
    exact Equiv.sum_comp e.symm (fun x => f (φ (Mout x - lab x)))
  | cons g gs ih =>
    intro lab Mout
    simp only [List.map_cons, frameSum]
    have hl : labStep (fun w => φ (lab (e.symm w))) (trG e φ g) =
        fun w => φ (labStep lab g (e.symm w)) := by
      funext w
      simp only [labStep, trG, Finset.mem_map_equiv]
      split_ifs <;> rfl
    rw [hl, ih]
    congr 1
    simp only [trG, Finset.sum_map, Equiv.toEmbedding_apply, Equiv.symm_apply_apply, ← map_sub]

end Transport

end NetProp7

