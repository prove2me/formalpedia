theorem contDiff_qK (a : ℝ) : ContDiff ℝ ∞ (qK a) := by
  have : qK a = fun x : Pt 4 => ((x 1 : ℝ) : ℂ) + I * ((a : ℂ) * Complex.cos ((x 2 : ℝ) : ℂ)) :=
