-- title:
--   Definition 3.2.1 — optimal polar simplices
-- statement:
--   Given constraint vectors $a_1,\ldots,a_n\in\mathbb R^d$, positive right-hand sides $y_i$, and an objective $z$, the set $\operatorname{optSimp}_z(a;y)$ consists of $d$-element index sets $I$ for which $A_I$ has full rank, the simplex with vertices $a_i/y_i$ for $i\in I$ is a facet of $\operatorname{ConvHull}(0,a_1/y_1,\ldots,a_n/y_n)$, and $z$ belongs to the cone generated by the $a_i$ for $i\in I$.
--
--   $$\operatorname{optSimp}_z(a;y)=\{I\in\tbinom{[n]}d: \operatorname{rank}(A_I)=d,\ \Delta(a_i/y_i)_{i\in I}\text{ is a facet},\ z\in\operatorname{Cone}(a_i)_{i\in I}\}.$$
--
--   This is the polar object whose union forms a shadow. The cone condition uses unscaled $a_i$, equivalent to using $a_i/y_i$ when every $y_i>0$.
--
--   **Formalization Note** A facet is an exposed, nonempty, proper face, with linear independence forcing dimension $d-1$. The code extends the set-valued expression to other $y$ only to make Lean functions total; the paper's use assumes $y_i>0$.
-- source:
--   Spielman & Teng, Smoothed Analysis of Algorithms, arXiv:cs/0111050v7, Definition 3.2.1, printed p. 30, PDF p. 30

import Mathlib
import Definitions.Def_SmoothedSimplex_TwoPhase_gaussianInput

namespace SmoothedSimplex.TwoPhase

/-- The cone generated by the indexed constraint vectors (Spielman–Teng,
Definition 3.2.1, printed p. 30, PDF p. 30). -/
def inCone {n d : ℕ} (a : Fin n → Point d) (I : Finset (Fin n)) (z : Point d) : Prop :=
  ∃ c : Fin n → ℝ, (∀ i, 0 ≤ c i) ∧
    (∀ i, i ∉ I → c i = 0) ∧ z = ∑ i, (c i) • a i

/-- `optSimp_z(a;y)` from Definition 3.2.1, printed p. 30, PDF p. 30.
A selected simplex has `d` linearly independent vertices, is exactly an exposed
facet of `ConvHull(0,aᵢ/yᵢ)`, and its unscaled normals generate `z`. The definition
is intended for all `yᵢ > 0`. The facet is required to be nonempty and proper. -/
noncomputable def optSimp {n d : ℕ} (a : Fin n → Point d) (y : Fin n → ℝ)
    (z : Point d) : Finset (Finset (Fin n)) := by
  classical
  let scaled : Fin n → Point d := fun i => (y i)⁻¹ • a i
  let hull : Set (Point d) := convexHull ℝ ({0} ∪ Set.range scaled)
  exact (Finset.univ.powersetCard d).filter (fun I =>
    LinearIndependent ℝ (fun i : I => a i.1) ∧
    IsExposed ℝ hull (convexHull ℝ (scaled '' (I : Set (Fin n)))) ∧
    (convexHull ℝ (scaled '' (I : Set (Fin n)))).Nonempty ∧
    convexHull ℝ (scaled '' (I : Set (Fin n))) ≠ hull ∧
    inCone a I z)

end SmoothedSimplex.TwoPhase


