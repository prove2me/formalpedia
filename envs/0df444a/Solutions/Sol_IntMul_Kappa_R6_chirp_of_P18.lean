section
-- Source module: Solutions.R6IL2Head
/-!
# Round six, item language (I2): the row-addition header for any label dimension `m`

Parametric copy of the `m`-dependent part of `KFX5Head` (the frozen file has the OpenAI label
dimension `mC = 100^3` hard-wired): the register assignment `rowσ m …` of the ten row-addition
parameters `[m^k, K, e, t, S0, B, r, H, i, j]` (`i j : Fin m`), the shape factors `N0R … N3R`,
the admissibility facts `PF m …` (now also `6 ≤ K` and `16 ≤ m ≤ 10^6`; round six has `m = 576`),
and the specifications `x…` of the header expressions (the expressions themselves are the frozen
ones: they read `m^k` from a register, so they do not depend on `m`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE NLogN.KFB NLogN.KFL NLogN.KFW NLogN.KFH
  NLogN.KFX AModel Butterfly

/-! ## The row-addition parameters for label dimension `m` -/

/-! ## The shape factors -/

/-! ## Specifications of the parameter expressions -/

section Par

variable {m k K e T S0 B r H : ℕ} {i j : Fin m} {u : IState HS} {Bb : ℕ}
  (hp : PF m k K e T S0 B r) (hA : Agree (rowσ m k K e T S0 B r H i j) u)
  (hBb : zsz ((VbR T S0 B r H : ℕ) : ℤ) ≤ Bb)

include hp hA hBb

omit hA hBb in
theorem VbR_ge : S0 ≤ VbR T S0 B r H ∧ B ≤ VbR T S0 B r H ∧ r ≤ VbR T S0 B r H ∧
    H + 1 ≤ VbR T S0 B r H ∧ B * 2 ^ T * S0 * r ≤ VbR T S0 B r H ∧
    r * (2 * (H + 1)) ≤ VbR T S0 B r H := by
  have := hp.s0; have := hp.b; have := hp.r
  have h2 : 1 ≤ 2 ^ T := Nat.one_le_two_pow
  have hn : 1 ≤ B * 2 ^ T * S0 := Nat.one_le_iff_ne_zero.2 (by positivity)
  unfold VbR
  generalize hN : B * 2 ^ T * S0 = n at hn
  have hSn : S0 ≤ n := by
    rw [← hN]; calc S0 = 1 * 1 * S0 := by ring
      _ ≤ B * 2 ^ T * S0 := Nat.mul_le_mul_right _ (Nat.mul_le_mul hp.b h2)
  have hBn : B ≤ n := by
    rw [← hN]; calc B = B * 1 * 1 := by ring
      _ ≤ B * 2 ^ T * S0 := Nat.mul_le_mul (Nat.mul_le_mul_left _ h2) hp.s0
  have e1 : 2 * n * r * (H + 1) = n * (r * (2 * (H + 1))) := by ring
  have e2 : 2 * n * r * (H + 1) = (n * r) * (2 * (H + 1)) := by ring
  have hX : r * (2 * (H + 1)) ≤ 2 * n * r * (H + 1) := by
    rw [e1]; exact Nat.le_mul_of_pos_left _ hn
  have hY : n * r ≤ 2 * n * r * (H + 1) := by rw [e2]; exact Nat.le_mul_of_pos_right _ (by omega)
  have hr2 : r ≤ r * (2 * (H + 1)) := Nat.le_mul_of_pos_right _ (by omega)
  have hH2 : H + 1 ≤ r * (2 * (H + 1)) := by
    calc H + 1 ≤ 1 * (2 * (H + 1)) := by omega
      _ ≤ r * (2 * (H + 1)) := Nat.mul_le_mul_right _ hp.r
  have hnr : n ≤ n * r := Nat.le_mul_of_pos_right _ (by omega)
  refine ⟨by omega, by omega, by omega, by omega, hY, hX⟩

omit hA hBb in
theorem nV : B * 2 ^ T * S0 ≤ VbR T S0 B r H :=
  le_trans (Nat.le_mul_of_pos_right _ hp.r) (VbR_ge (H := H) hp).2.2.2.2.1

end Par

end IntMul.Kappa.R6.IL2

end

section
-- Source module: Solutions.R6MTab
/-!
# Round-six machine: the top level and merged tables

* **`kappa_of_big6`**: the frozen `KFM.kappa_of_big` with the round-six final reduction
  `kappaBound_of_machine6`: a merged table with the FM multiplier at `pM` and a large-`n`
  procedure meeting `BigSpec` with cost `Tb` inside `C₀ (V · Ncost6 · (log lg n + 1)^A + n)` gives
  `KappaBound κ` for every `κ < P.gap`.
* **`mExt4`**: four interface tables `kTableP tab ext_i` and the machine's own procedures merged
  into one `kTableP tab (mExt4 …)` (the frozen `KFM.mExt` with one more slot and `kTable → kTableP
  tab`); **`mTab4_g1 … mTab4_g4`**, **`mTab4_own`** are the hypotheses of `IRuns.relabel`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IL

noncomputable section

/-! ## The top level -/

/-! ## Merging four interface tables -/

section Merge

variable {E₁ E₂ E₃ E₄ E₀ : ℕ}

theorem kTableP_ext' {E : ℕ} (tab : Fin 1 → IStmt HS 1) (ext : Fin E → IStmt HS (7 + E))
    (j : Fin (7 + E)) (hj : 7 ≤ j.val) : kTableP tab ext j = ext ⟨j.val - 7, by omega⟩ := by
  unfold kTableP; rw [dif_neg (by omega), dif_neg (by omega), dif_neg (by omega)]

theorem kTableP_ext'' {E : ℕ} (tab : Fin 1 → IStmt HS 1) (ext : Fin E → IStmt HS (7 + E))
    (k : ℕ) (hk : k < E) : kTableP tab ext ⟨k + 7, by omega⟩ = ext ⟨k, hk⟩ := by
  rw [kTableP_ext' tab ext _ (by simp)]; congr 1

/-- The fixed part of `kTableP` is invariant under `gI`. -/
theorem kTableP_fixed {E : ℕ} (tab : Fin 1 → IStmt HS 1) (ext : Fin E → IStmt HS (7 + E))
    (Ei off : ℕ) (h : off + Ei ≤ E) (exti : Fin Ei → IStmt HS (7 + Ei)) (j : Fin (7 + Ei))
    (hj : j.val < 7) :
    kTableP tab ext (gI Ei E off h j) = (kTableP tab exti j).ren id (gI Ei E off h) := by
  have e : gI Ei E off h j = ⟨j.val, by omega⟩ := by simp [gI, hj]
  rw [e]
  unfold kTableP
  by_cases h0 : j.val = 0
  · rw [dif_pos h0, dif_pos h0, IStmt.ren_ren, gI_gL]; rfl
  by_cases h1 : j.val = 1
  · rw [dif_neg h0, dif_pos h1, dif_neg h0, dif_pos h1]
    simp only [mulWrap, IStmt.ren, IOp.ren, id]
    rw [← gI_gM Ei E off h]; rfl
  · rw [dif_neg h0, dif_neg h1, dif_pos hj, dif_neg h0, dif_neg h1, dif_pos hj, IStmt.ren_ren,
      gI_gM]; rfl

variable (tab : Fin 1 → IStmt HS 1) (ext₁ : Fin E₁ → IStmt HS (7 + E₁))
  (ext₂ : Fin E₂ → IStmt HS (7 + E₂)) (ext₃ : Fin E₃ → IStmt HS (7 + E₃))
  (ext₄ : Fin E₄ → IStmt HS (7 + E₄)) (own : Fin E₀ → IStmt HS (7 + (E₁ + E₂ + E₃ + E₄ + E₀)))

theorem mTab4_g1 : ∀ j, mTab4 tab ext₁ ext₂ ext₃ ext₄ own (g4₁ E₁ E₂ E₃ E₄ E₀ j) =
    (kTableP tab ext₁ j).ren id (g4₁ E₁ E₂ E₃ E₄ E₀) := by
  intro j
  by_cases hj : j.val < 7
  · exact kTableP_fixed tab _ _ _ _ _ j hj
  · have e : g4₁ E₁ E₂ E₃ E₄ E₀ j = ⟨(j.val - 7) + 7, by omega⟩ := by
      simp [g4₁, gI, hj]; omega
    rw [e, mTab4, kTableP_ext'' tab _ (j.val - 7) (by omega)]
    have e2 : kTableP tab ext₁ j = ext₁ ⟨j.val - 7, by omega⟩ := kTableP_ext' tab ext₁ j (by omega)
    rw [e2, mExt4, dif_pos (by simp; omega)]; rfl

theorem mTab4_own (k : Fin E₀) :
    mTab4 tab ext₁ ext₂ ext₃ ext₄ own (gO4 E₁ E₂ E₃ E₄ E₀ k) = own k := by
  rw [gO4, mTab4, kTableP_ext'' tab _ (E₁ + E₂ + E₃ + E₄ + k.val) (by omega), mExt4,
    dif_neg (by simp; omega), dif_neg (by simp; omega), dif_neg (by simp; omega), dif_neg (by simp)]
  congr 1; ext; simp

end Merge

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6MQ
/-!
# Round-six machine: the run-time parameters of one size

`Q6` bundles the parameter record `P`, the input size `n` and the source list `src` (chosen by
the setup). All parameters of the machine are functions of `Q : Q6` (`Q.b = b'`, `Q.p = 6b'`,
`Q.L`, `Q.d`, `Q.ℓ`, `Q.h = ℓ − 1`, `Q.α`, `Q.K`, `Q.r`, the boxes `Q.sB D`, `Q.tB D`, `S`, `M`,
the error allowance `Q.er = errW6` and the source-transform error `Q.Es`).

`QOk Q` collects the numerical facts the assembly uses (proved for large `n` in `R6MFacts`).

* `prod_tB`, `tB_last`, `tBox_eq6`, `crtOK6`: the boxes.
* `regIdx6`, `BaseOK6.of_agree`, `BaseOK6.upd`: the register file is kept by writes elsewhere.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IntMul.OpenAI.RT AModel

noncomputable section

namespace Q6

variable (Q : Q6)

theorem p_eq : Q.p = 6 * Q.b := rfl

theorem ℓ_eq : Q.ℓ = OpenAI.RP.ell Q.L Q.d := rfl

theorem dp_eq : Q.dp = OpenAI.RP.mcnt Q.L Q.d := rfl

end Q6

namespace QOk

variable {Q : Q6} (hQ : QOk Q)
include hQ

theorem ell_pos : 1 ≤ OpenAI.RP.ell Q.L Q.d := by have := hQ.hℓ2; rw [← Q.ℓ_eq]; omega

theorem h_succ : Q.h + 1 = Q.ℓ := by
  have : 2 ≤ ℓP6 Q.P Q.n := hQ.hℓ2
  show hN6 Q.P Q.n + 1 = ℓP6 Q.P Q.n
  unfold hN6; omega

theorem dp_lt : Q.dp < Q.d := by
  rw [Q.dp_eq]; exact OpenAI.RP.mcnt_lt _ _ (by have := hQ.hd1; omega)

/-- The axis lengths are `2^{axExp}`. -/
theorem tF_eq (j : ℕ) (hj : j < Q.d) :
    tF6 Q.P Q.n j = 2 ^ OpenAI.RP.axExp Q.L Q.d ⟨j, hj⟩ := by
  have hl := hQ.ell_pos
  unfold tF6 OpenAI.RP.axExp bL6
  have e1 : hN6 Q.P Q.n = OpenAI.RP.ell Q.L Q.d - 1 := rfl
  have e2 : dpN6 Q.P Q.n = OpenAI.RP.mcnt Q.L Q.d := rfl
  rw [e1, e2]
  simp only [decide_eq_true_eq]
  by_cases h : OpenAI.RP.mcnt Q.L Q.d ≤ j
  · rw [if_pos h, if_neg (by omega), ← pow_succ]; congr 1; omega
  · rw [if_neg h, if_pos (by omega)]

theorem prod_tB {D : ℕ} (hD : Q.d = D + 1) : ∏ i, Q.tB D i = 2 ^ Q.L := by
  have e : ∏ j ∈ Finset.range Q.d, (2 : ℕ) ^ (if j < OpenAI.RP.mcnt Q.L Q.d then
      OpenAI.RP.ell Q.L Q.d - 1 else OpenAI.RP.ell Q.L Q.d) = 2 ^ Q.L := by
    rw [← Fin.prod_univ_eq_prod_range (fun j => (2 : ℕ) ^ (if j < OpenAI.RP.mcnt Q.L Q.d then
      OpenAI.RP.ell Q.L Q.d - 1 else OpenAI.RP.ell Q.L Q.d))]
    exact OpenAI.RP.axLen_prod Q.L Q.d (by have := hQ.hd1; omega)
  rw [show ∏ i, Q.tB D i = ∏ j ∈ Finset.range (D + 1), tF6 Q.P Q.n j from
    Fin.prod_univ_eq_prod_range (fun j => tF6 Q.P Q.n j) (D + 1), ← hD, ← e]
  refine Finset.prod_congr rfl fun j hj => ?_
  rw [hQ.tF_eq j (Finset.mem_range.1 hj)]; rfl

theorem tB_last {D : ℕ} (hD : Q.d = D + 1) : Q.tB D (Fin.last D) = Q.r := by
  have h : dpN6 Q.P Q.n < dP6 Q.P Q.n := hQ.dp_lt
  have hD' : dP6 Q.P Q.n = D + 1 := hD
  show tF6 Q.P Q.n D = rP6 Q.P Q.n
  unfold tF6 bL6 rP6
  rw [if_pos (by simp only [decide_eq_true_eq]; omega), ← pow_succ]
  congr 1; exact hQ.h_succ

theorem sB_lt {D : ℕ} (hD : Q.d = D + 1) (i : Fin (D + 1)) : Q.sB D i < Q.tB D i :=
  hQ.hlt i.val (by omega)

end QOk

/-! ## The register file -/

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6ZParam
/-!
# Round six, chirp: the chirp procedure parameters of a size `Q`

The frozen `KFZParam` facts for a round-six size `Q` with `QOk Q` and `Q.d = D + 1`:
`h = ℓ - 1`, `σ = d - d'`, the bits `bs6`, the sources `ss6`, `t_i = 2^{h + bit i}`,
`(D+1) h + σ = L`, the chirp descriptor `descChirp6`, the chirp-table descriptor
`descT (sB D) (tB D)`, the register width `BN6 ≤ 5p` with `RB`, and the Prop 18 descriptor side
conditions `MG`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP NLogN.KFZ

noncomputable section

section Facts

variable {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)
include hQ hD

theorem h_pos6 : 1 ≤ Q.h := by have := hQ.h_succ; have := hQ.hℓ2; omega

theorem dp_le6 : Q.dp ≤ D := by have := hQ.dp_lt; omega

theorem tB_bit6 (i : Fin (D + 1)) : Q.tB D i = 2 ^ (Q.h + bit6 Q i.val) := by
  show tF6 Q.P Q.n i.val = _
  unfold tF6 bit6 bL6
  by_cases h : dpN6 Q.P Q.n ≤ i.val
  · simp only [h, decide_true, if_true]
    show 2 ^ hN6 Q.P Q.n * 2 = 2 ^ (hN6 Q.P Q.n + 1)
    rw [pow_succ]
  · simp only [h, decide_false, if_false]
    rfl

theorem prod_t6 : ∏ i, Q.tB D i = 2 ^ ((D + 1) * Q.h + σ6 Q) := by
  rw [Finset.prod_congr rfl (fun i _ => tB_bit6 hQ hD i)]
  rw [Fin.prod_univ_eq_prod_range (fun j => 2 ^ (Q.h + bit6 Q j)) (D + 1)]
  have := prod_bits Q.dp Q.h (D + 1)
  unfold bit6
  rw [this]
  unfold σ6; rw [hD]

theorem t_last6 : Q.tB D (Fin.last D) = 2 ^ (Q.h + 1) := by
  rw [tB_bit6 hQ hD]
  have := dp_le6 hQ hD
  unfold bit6; simp only [Fin.val_last]; rw [if_pos this]

theorem t_le6 (i : Fin (D + 1)) : Q.tB D i ≤ 2 ^ (Q.h + 1) := by
  rw [tB_bit6 hQ hD]
  exact Nat.pow_le_pow_right (by norm_num) (by unfold bit6; split_ifs <;> omega)

theorem t_ge6 (i : Fin (D + 1)) : 2 ≤ Q.tB D i := by
  rw [tB_bit6 hQ hD]
  have := h_pos6 hQ hD
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem s_le6 (i : Fin (D + 1)) : Q.sB D i ≤ Q.tB D i := (hQ.sB_lt hD i).le

theorem prod_init6 : (∏ i : Fin D, Q.tB D i.castSucc) * 2 ^ (Q.h + 1) =
    2 ^ ((D + 1) * Q.h + σ6 Q) := by
  rw [← t_last6 hQ hD, ← Fin.prod_univ_castSucc, prod_t6 hQ hD]

theorem σ_le6 : σ6 Q ≤ D + 1 := by unfold σ6; omega

theorem σ_pos6 : 1 ≤ σ6 Q := by have := dp_le6 hQ hD; unfold σ6; omega

theorem sum_bs6 : (bs6 Q).sum = σ6 Q := by
  unfold bs6 bit6 σ6
  exact sum_bits Q.dp Q.d

theorem length_bs6 : (bs6 Q).length = D + 1 := by simp [bs6, hD]

theorem length_ss6 : (ss6 Q).length = D + 1 := by simp [ss6, hD]

theorem bs6_get (i : ℕ) (hi : i < D + 1) :
    (bs6 Q)[i]'(by rw [length_bs6 hQ hD]; exact hi) = bit6 Q i := by
  simp only [bs6, List.getElem_map, List.getElem_range]

theorem ss6_get (i : ℕ) (hi : i < D + 1) :
    (ss6 Q)[i]'(by rw [length_ss6 hQ hD]; exact hi) = Q.src i := by
  simp only [ss6, List.getElem_map, List.getElem_range]

theorem bs6_le1 : ∀ b ∈ bs6 Q, b ≤ 1 := by
  intro b hb
  simp only [bs6, List.mem_map] at hb
  obtain ⟨j, -, rfl⟩ := hb
  unfold bit6; split_ifs <;> omega

theorem ss6_le (i : ℕ) (hi : i < D + 1) :
    (ss6 Q)[i]'(by rw [length_ss6 hQ hD]; exact hi) ≤
      2 ^ (Q.h + (bs6 Q)[i]'(by rw [length_bs6 hQ hD]; exact hi)) := by
  rw [ss6_get hQ hD i hi, bs6_get hQ hD i hi]
  have := s_le6 hQ hD ⟨i, hi⟩
  rw [tB_bit6 hQ hD] at this
  exact this

theorem eS6 : eS Q.h (bs6 Q) (D + 1) = (D + 1) * Q.h + σ6 Q := by
  unfold eS
  rw [List.take_of_length_le (by rw [length_bs6 hQ hD]), sum_bs6 hQ hD]

theorem axD_eq6 : axD Q.h (bs6 Q) (ss6 Q) = axL (Q.sB D) (Q.tB D) := by
  apply List.ext_getElem
  · rw [length_axD _ _ _ (by rw [length_ss6 hQ hD, length_bs6 hQ hD]), length_bs6 hQ hD]
    simp [axL]
  · intro i h1 h2
    have hi : i < D + 1 := by simpa [axL] using h2
    rw [getElem_axD _ _ _ (by rw [length_ss6 hQ hD, length_bs6 hQ hD])]
    simp only [axL, List.getElem_ofFn]
    rw [ss6_get hQ hD i hi, bs6_get hQ hD i hi, tB_bit6 hQ hD ⟨i, hi⟩]
    rfl

theorem desc_eq6 : descA 1 (axD Q.h (bs6 Q) (ss6 Q)) ++
    [(2 * 2 ^ eS Q.h (bs6 Q) (D + 1) : ℤ)] = descT (Q.sB D) (Q.tB D) := by
  rw [descT, axD_eq6 hQ hD, eS6 hQ hD, prod_t6 hQ hD]
  push_cast; rfl

theorem dCh_eq6 : Q.dCh = (Q.K : ℤ) :: (Q.p : ℤ) :: (Q.α : ℤ) :: (Q.h : ℤ) ::
    ((D + 1 : ℕ) : ℤ) :: (zl (bs6 Q) ++ zl (ss6 Q)) := by
  show (KP6 Q.P Q.n : ℤ) :: descLine (pP6 Q.P Q.n) (αN6 Q.P Q.n) (hN6 Q.P Q.n) (dP6 Q.P Q.n)
    (bL6 Q.P Q.n) Q.src = _
  unfold descLine
  have hD' : dP6 Q.P Q.n = D + 1 := hD
  rw [hD']
  congr 5
  unfold bitsZ zl bs6 ss6 bit6 bL6
  rw [show Q.d = D + 1 from hD, List.map_map, List.map_map]
  congr 1
  · congr 1; funext j; simp only [Function.comp, decide_eq_true_eq]; split_ifs <;> rfl

theorem ell_le_L6 : Q.ℓ ≤ Q.L := by
  have h1 := (OpenAI.RP.ell_spec Q.L Q.d (by have := hQ.hd1; omega)).2
  rw [← Q.ℓ_eq] at h1
  have hd := hQ.hd1
  have hl := hQ.hℓ2
  by_contra hc
  push Not at hc
  have h2 : Q.d * (Q.L + 1) ≤ Q.d * Q.ℓ := Nat.mul_le_mul_left _ hc
  have h3 : Q.L ≤ Q.d * Q.L := Nat.le_mul_of_pos_left _ (by omega)
  have e : Q.d * (Q.L + 1) = Q.d * Q.L + Q.d := by ring
  omega

theorem L_le_b6 : Q.L ≤ Q.b := by have := hQ.hLb; omega

theorem K_le6 : Q.K ≤ Q.b := by
  have := ell_le_L6 hQ hD; have := L_le_b6 hQ hD
  show ℓP6 Q.P Q.n - 1 ≤ _
  have : Q.ℓ ≤ Q.b := by omega
  exact (Nat.sub_le _ _).trans this

theorem RB6 : RB Q.p Q.h (D + 1) (σ6 Q) Q.K (BN6 Q) := by
  have hσ := σ_pos6 hQ hD
  have hσd := σ_le6 hQ hD
  have hh : Q.h ≤ (D + 1) * Q.h := Nat.le_mul_of_pos_left _ (by omega)
  refine ⟨hσd, by omega, ?_, ?_⟩
  · unfold BN6; rw [hD]; omega
  · unfold BN6; omega

theorem MG6 : MG Q.p Q.h (D + 1) (σ6 Q) Q.K := by
  have hp6 : Q.p / 6 = Q.b := by rw [Q.p_eq]; omega
  have hb := hQ.hb
  have hdb := hQ.hdb
  have hl := ell_le_L6 hQ hD
  have hLb := L_le_b6 hQ hD
  have hs := hQ.h_succ
  refine ⟨by rw [hp6, Q.p_eq], by omega, by omega, by omega,
    Nat.pow_le_pow_right (by norm_num) (by omega), by rw [hp6]; exact K_le6 hQ hD, by omega⟩

theorem p_le_B6 : Q.p + 1 ≤ BN6 Q := by unfold BN6 dlV; omega

theorem setupB6 : eS Q.h (bs6 Q) (D + 1) + Q.h + 6 ≤ BN6 Q ∧ D + 1 + 2 ≤ BN6 Q ∧
    zsz (Q.K : ℤ) ≤ BN6 Q ∧ zsz (Q.p : ℤ) ≤ BN6 Q ∧ zsz (Q.α : ℤ) ≤ BN6 Q := by
  rw [eS6 hQ hD]
  refine ⟨?_, ?_, zszS ?_, zszS ?_, zszS ?_⟩ <;> unfold BN6 dlV <;> rw [hD] <;> omega

/-- The Prop 18 descriptor at `Q` is `dsG` of the chirp parameters. -/
theorem dsG_eq6 : dsG Q.p Q.h (D + 1) (σ6 Q) Q.K = desc18 Q.p Q.ℓ Q.K (tsG Q.d Q.dp Q.r) := by
  have hs := hQ.h_succ
  have hdp := dp_le6 hQ hD
  unfold dsG
  rw [hs, show D + 1 - σ6 Q = Q.dp by unfold σ6; omega, show (2 : ℕ) ^ Q.ℓ = Q.r from rfl, ← hD]

theorem tsG_eq6 : tsG Q.d Q.dp Q.r = tsOf (Q.tB D) := by
  apply List.ext_getElem
  · simp [tsG, tsOf, hD]
  · intro i h1 h2
    simp only [tsG, tsOf, List.getElem_map, List.getElem_range, List.getElem_ofFn]
    show _ = tF6 Q.P Q.n i
    unfold tF6 bL6
    have hs := hQ.h_succ
    have er : Q.r = 2 ^ hN6 Q.P Q.n * 2 := by
      show 2 ^ ℓP6 Q.P Q.n = _
      rw [← pow_succ]; congr 1; exact hs.symm
    by_cases h : dpN6 Q.P Q.n ≤ i
    · rw [if_pos h, if_pos (decide_eq_true h)]; exact er
    · rw [if_neg h, if_neg (by simpa using h)]
      show Q.r / 2 = _
      rw [er]; omega

theorem ts_len6 : (tsG Q.d Q.dp Q.r).length + 1 = Q.d := by simp [tsG, hD]

theorem ts_mem6 : ∀ t ∈ tsG Q.d Q.dp Q.r, t = Q.r ∨ 2 * t = Q.r := by
  intro t ht
  simp only [tsG, List.mem_map] at ht
  obtain ⟨j, -, rfl⟩ := ht
  have hs := hQ.h_succ
  have er : Q.r = 2 ^ Q.h * 2 := by
    show 2 ^ ℓP6 Q.P Q.n = _
    rw [← pow_succ]; congr 1; exact hs.symm
  split_ifs
  · left; rfl
  · right; rw [er]; omega

theorem ts_prod6 : (tsG Q.d Q.dp Q.r).prod * Q.r = Q.T := by
  rw [tsG_eq6 hQ hD, tsOf_prod, ← hQ.tB_last hD, ← Fin.prod_univ_castSucc, hQ.prod_tB hD]; rfl

theorem desc18_bnd6 : ∀ x ∈ dsG Q.p Q.h (D + 1) (σ6 Q) Q.K, zsz x ≤ BN6 Q := by
  have hB := p_le_B6 hQ hD
  have hs := hQ.h_succ
  have hK := K_le6 hQ hD
  have hlb := ell_le_L6 hQ hD
  have hLb := L_le_b6 hQ hD
  have hpb : Q.p = 6 * Q.b := Q.p_eq
  rw [dsG_eq6 hQ hD]
  intro x hx
  simp [desc18] at hx
  rcases hx with rfl | rfl | rfl | rfl | ⟨t, ht, rfl⟩
  · exact zszS (by omega)
  · exact zszS (by unfold BN6 dlV; omega)
  · exact zszS (by unfold BN6; omega)
  · have := ts_len6 hQ hD
    exact zszS (by unfold BN6 dlV; rw [hD] at *; omega)
  · have er : Q.r = 2 ^ (Q.h + 1) := by rw [hs]; rfl
    rcases ts_mem6 hQ hD t ht with e | e
    · rw [e, er]
      exact zszN (k := Q.h + 1) le_rfl (by unfold BN6 dlV; omega)
    · have : t ≤ 2 ^ (Q.h + 1) := by rw [← er]; omega
      exact zszN (k := Q.h + 1) this (by unfold BN6 dlV; omega)

theorem hM6 : 2 ^ ((D + 1) * Q.h + σ6 Q - (Q.h + 1)) = ∏ i : Fin D, Q.tB D i.castSucc := by
  have e1 := prod_init6 hQ hD
  have hle : Q.h + 1 ≤ (D + 1) * Q.h + σ6 Q := (RB6 hQ hD).hL
  have e2 : 2 ^ ((D + 1) * Q.h + σ6 Q - (Q.h + 1)) * 2 ^ (Q.h + 1) =
      2 ^ ((D + 1) * Q.h + σ6 Q) := by
    rw [← pow_add, Nat.sub_add_cancel hle]
  rw [← e2] at e1
  exact (Nat.eq_of_mul_eq_mul_right (by positivity) e1).symm

end Facts

end

