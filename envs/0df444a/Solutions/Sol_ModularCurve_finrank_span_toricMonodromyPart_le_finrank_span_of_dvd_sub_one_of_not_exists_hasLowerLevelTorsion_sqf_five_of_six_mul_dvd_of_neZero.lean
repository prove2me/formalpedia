private theorem jg2_hda_transpose {ι : Type*} [Fintype ι] (M : Matrix ι ι ℤ) (D : ι → ℤ) :
    heckeDivisorAction M.transpose D = M.mulVec D := by
  funext j
  simp [heckeDivisorAction_apply, Matrix.mulVec, dotProduct]

private theorem jg2_hca_comm {ι : Type*} [Fintype ι] (A B : Matrix ι ι ℤ) {m n : ℤ}
    (hA : HeckeRowSums A.transpose m) (hB : HeckeRowSums B.transpose n) (h : Commute A B)
    (D : ↥(characterLattice ι)) :
    heckeCharacterAction A.transpose hA (heckeCharacterAction B.transpose hB D) =
      heckeCharacterAction B.transpose hB (heckeCharacterAction A.transpose hA D) := by
  apply Subtype.ext
  simp only [heckeCharacterAction_coe, jg2_hda_transpose, Matrix.mulVec_mulVec]
  rw [h.eq]

private theorem jg2_range_comm {L : Type*} [AddCommGroup L] (g : Nat.Primes → Module.End ℤ L)
    (hg : ∀ a b, g a * g b = g b * g a) :
    ∀ x ∈ Set.range g, ∀ y ∈ Set.range g, x * y = y * x := by
  rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
  exact hg a b

private noncomputable def jg2_hom {L : Type*} [AddCommGroup L] (g : Nat.Primes → Module.End ℤ L)
    (hg : ∀ a b, g a * g b = g b * g a) : HeckeAlg →+* Module.End ℤ L :=
  letI : CommRing ↥(Algebra.adjoin ℤ (Set.range g)) :=
    Algebra.adjoinCommRingOfComm ℤ (jg2_range_comm g hg)
  (Algebra.adjoin ℤ (Set.range g)).val.toRingHom.comp
    (MvPolynomial.aeval fun ℓ : Nat.Primes =>
      (⟨g ℓ, Algebra.subset_adjoin ⟨ℓ, rfl⟩⟩ : ↥(Algebra.adjoin ℤ (Set.range g)))).toRingHom

@[reducible] private noncomputable def jg2_module {L : Type*} [AddCommGroup L]
    (g : Nat.Primes → Module.End ℤ L) (hg : ∀ a b, g a * g b = g b * g a) : Module HeckeAlg L :=
  Module.compHom L (jg2_hom g hg)

private theorem jg2_heckeGen_smul {L : Type*} [AddCommGroup L] (g : Nat.Primes → Module.End ℤ L)
    (hg : ∀ a b, g a * g b = g b * g a) (ℓ : Nat.Primes) (l : L) :
    letI := jg2_module g hg
    heckeGen ℓ • l = g ℓ l := by
  letI : CommRing ↥(Algebra.adjoin ℤ (Set.range g)) :=
    Algebra.adjoinCommRingOfComm ℤ (jg2_range_comm g hg)
  show (jg2_hom g hg (heckeGen ℓ)) l = g ℓ l
  simp [jg2_hom]

