  have hA64 : 64 ≤ Aa := by
    rw [hAaE]; calc 64 = 2 ^ 6 := by norm_num
      _ ≤ 2 ^ E := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hA2 : 2 ≤ Aa := by omega
  have hpw : ∀ k, k ≤ E → 2 ^ k ≤ Aa := fun k hk => Nat.pow_le_pow_right (by norm_num) hk
  have hpA : 2 ^ p ≤ Aa := hpw p (by omega)
  have hbA : 2 ^ b ≤ Aa := hpw b (by omega)
  have hnA : 4 * n ≤ Aa := by
    have : 4 * 2 ^ b = 2 ^ (b + 2) := by ring
    have := hpw (b + 2) (by omega)
    omega
  have hEb : E < 2 ^ E := Nat.lt_two_pow_self
  have hEA : E ≤ Aa := by omega
  have hB : Aa ^ D < 2 ^ Bb := by
    have e1 : Aa ^ D = 2 ^ (E * D) := by rw [hAaE, ← pow_mul]
    have e2 : Bb = D * E + 1 := rfl
    rw [e1, e2, Nat.mul_comm E D]; exact Nat.pow_lt_pow_right (by norm_num) (by omega)
  have hB6 : Aa ^ 6 < 2 ^ Bb := powD_lt hA2 hB (by rw [hDd, DgS]; omega)
  have hcA : 2 ^ ℓ * 2 ^ ℓ ≤ Aa := by rw [← pow_add]; exact hpw _ (by omega)
  have hPA : 2 * 2 ^ (ℓ * d) ≤ Aa := by
    rw [← pow_succ']; exact hpw _ (by rw [mul_comm]; omega)
  have hsA : 8 * (d + ℓ) ≤ Aa := by
    have h1 : E - 4 < 2 ^ (E - 4) := Nat.lt_two_pow_self
    have h2 : 2 ^ (E - 4) * 16 = 2 ^ E := by
      rw [show (16 : ℕ) = 2 ^ 4 by norm_num, ← pow_add, Nat.sub_add_cancel (by omega : 4 ≤ E)]
    rw [hAaE]; omega
  have hl1 : 1 ≤ ℓ := by omega
  -- the sources are small
  have hsrc : ∀ i < d, src6 P n i ≤ 2 ^ ℓ := fun i hi => src6_le P n hd1 hl1 hW i hi
  have hsrc2 : ∀ i < d, 2 ≤ src6 P n i := fun i hi => by
    have H := src6_facts P n hd1 hl1 hW d le_rfl i hi
    have h8 := wnd6_le P n i hd1
    have ht : 2 ≤ tF6 P n i := by
      rw [tF6_bit]
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by unfold hN6; omega)
    unfold wA6 at H; omega
