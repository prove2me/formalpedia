    ∃ j : Fin 7968, codeBox (codeFunctionP9 j.val) d := by
  have hc : fragmentObligations 7968 codeFunctionP9 fragmentContextP9_1151 fragmentTreeP9_1151 := by
    unfold fragmentTreeP9_1151
    apply fragmentComputed_sound
    decide +kernel
  exact fragment_sound 7968 codeFunctionP9 fragmentContextP9_1151 fragmentTreeP9_1151 hc d hΓ
