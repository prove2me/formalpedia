namespace FamilyData

variable {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {W : Set (ℝ × Pt n)} {h : Metric n} {f : TwoForm n}

theorem smooth_inv (hfam : FamilyData g ginv F W) (i j : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => ginv p.1 i j p.2) W :=
  contDiffOn_inv_joint hfam.smooth hfam.inv i j

/-- `δ ginv = invVar ginv h` (true inverse; `δG = -G h G`). -/
theorem hasDerivAt_inv (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (a b : Fin n) :
    HasDerivAt (fun ε => ginv ε a b y) (invVar (ginv 0) h a b y) 0 :=
  hasDerivAt_param_inv hfam.isOpen hfam.smooth hfam.inv hy (ht.metric y hy) a b

theorem hasDerivAt_pd_metric (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (k i j : Fin n) :
    HasDerivAt (fun ε => pd k (g ε i j) y) (pd k (h i j) y) 0 :=
  hasDerivAt_pd_param (Φ := fun ε => g ε i j) hfam.isOpen (hfam.smooth i j) hy
    (fun z hz => ht.metric z hz i j) k

/-- `δΓ = chrVar g ginv h`. -/
theorem hasDerivAt_christoffel (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (a b c : Fin n) :
    HasDerivAt (fun ε => christoffel (g ε) (ginv ε) a b c y) (chrVar (g 0) (ginv 0) h a b c y) 0 :=
  hasDerivAt_christoffel_of (hfam.hasDerivAt_inv ht hy) (hfam.hasDerivAt_pd_metric ht hy) a b c

/-- `δF^{ab} = raise2Var ginv h F f` (both raisings vary). -/
theorem hasDerivAt_raise2 (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (a b : Fin n) :
    HasDerivAt (fun ε => raise2 (ginv ε) (F ε) a b y) (raise2Var (ginv 0) h (F 0) f a b y) 0 :=
  hasDerivAt_raise2_of (hfam.hasDerivAt_inv ht hy) (ht.field y hy) a b

theorem hasDerivAt_pd_raise2 (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {x : Pt n}
    (hx : ((0 : ℝ), x) ∈ W) (i a b : Fin n) :
    HasDerivAt (fun ε => pd i (raise2 (ginv ε) (F ε) a b) x) (pd i (raise2Var (ginv 0) h (F 0) f a b) x) 0 :=
  hasDerivAt_pd_param (Φ := fun ε => raise2 (ginv ε) (F ε) a b) hfam.isOpen
    (contDiffOn_raise2_joint hfam.smooth_inv hfam.smooth_F a b) hx
    (fun _ hy => hfam.hasDerivAt_raise2 ht hy a b) i

/-- **Bridge for `J`**: `d/dε|₀ J^b(g_ε, ginv_ε, F_ε)(x) = linMaxwell (g 0) (ginv 0) (F 0) h f b x`. -/
theorem bridge_maxwell (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {x : Pt n}
    (hx : ((0 : ℝ), x) ∈ W) (b : Fin n) :
    HasDerivAt (fun ε => maxwellDiv (g ε) (ginv ε) (F ε) b x) (linMaxwell (g 0) (ginv 0) (F 0) h f b x) 0 :=
  hasDerivAt_maxwellDiv_of (fun a b c => hfam.hasDerivAt_christoffel ht hx a b c)
    (fun a b => hfam.hasDerivAt_raise2 ht hx a b) (fun a b => hfam.hasDerivAt_pd_raise2 ht hx a a b) b

end FamilyData

