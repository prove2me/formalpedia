    centerALowerYBox.Contains (Y (lower E8TAxisProd0520PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0520PaddedInputs.centerAInput.alpha = ((4273758705152157645723775860095423839948636289 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
