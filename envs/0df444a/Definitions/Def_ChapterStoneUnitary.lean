/-!
# The general Stone theorem, part IV: the group `e^{-itA}` and its continuity

The approximating groups `e^{-itA_n}` converge strongly; the limit `U t = e^{-itA}` is
constructed here and shown to be a strongly continuous one-parameter unitary group.
-/

open scoped InnerProductSpace
open Filter Topology NormedSpace

namespace BookProof.ChapterStoneResolvent

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

omit [CompleteSpace H] in
/-- A sequence of isometric operators which converges pointwise on a dense set converges
pointwise everywhere (Cauchy version). -/
theorem cauchySeq_of_dense_of_isometry {F : ℕ → H →L[ℂ] H} (hiso : ∀ k y, ‖F k y‖ = ‖y‖)
    {D : Set H} (hD : Dense D) (hC : ∀ y ∈ D, CauchySeq (fun k => F k y)) (y : H) :
    CauchySeq (fun k => F k y) := by
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨z, hz, hyz⟩ := hD.exists_dist_lt y (ε := ε / 3) (by linarith)
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp (hC z hz) (ε / 3) (by linarith)
  refine ⟨N, fun k hk l hl => ?_⟩
  have hkz : dist (F k y) (F k z) = dist y z := by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, hiso]
  have hlz : dist (F l z) (F l y) = dist y z := by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, hiso, norm_sub_rev]
  calc dist (F k y) (F l y)
      ≤ dist (F k y) (F k z) + dist (F k z) (F l z) + dist (F l z) (F l y) :=
        dist_triangle4 _ _ _ _
    _ < ε / 3 + ε / 3 + ε / 3 := by
        rw [hkz, hlz]
        have := hN k hk l hl
        linarith
    _ = ε := by ring

namespace UnboundedSelfAdjoint

variable (T : UnboundedSelfAdjoint H)

/-! ## Strong convergence of the approximations -/

theorem approxU_cauchy_domain (t : ℝ) (x : T.domain) :
    CauchySeq (fun k : ℕ => T.approxU ((k : ℝ) + 1) t (x : H)) := by
  have hy : CauchySeq (fun k : ℕ => T.yosida ((k : ℝ) + 1) (x : H)) :=
    (T.yosida_tendsto x).cauchySeq
  rw [Metric.cauchySeq_iff]
  intro ε hε
  have hpos : (0 : ℝ) < ε / (|t| + 1) := by positivity
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hy _ hpos
  refine ⟨N, fun k hk l hl => ?_⟩
  have hkl := hN k hk l hl
  rw [dist_eq_norm] at hkl ⊢
  have hbound := T.norm_approxU_sub_apply_le ((k : ℝ) + 1) ((l : ℝ) + 1) t (x : H)
  have habs : (0 : ℝ) ≤ |t| := abs_nonneg t
  calc ‖T.approxU ((k : ℝ) + 1) t (x : H) - T.approxU ((l : ℝ) + 1) t (x : H)‖
      ≤ |t| * ‖T.yosida ((k : ℝ) + 1) (x : H) - T.yosida ((l : ℝ) + 1) (x : H)‖ := hbound
    _ ≤ |t| * (ε / (|t| + 1)) := by
        exact mul_le_mul_of_nonneg_left (le_of_lt hkl) habs
    _ < ε := by
        rw [mul_div_assoc'] at *
        rw [div_lt_iff₀ (by positivity)]
        nlinarith

theorem approxU_cauchy (t : ℝ) (x : H) :
    CauchySeq (fun k : ℕ => T.approxU ((k : ℝ) + 1) t x) := by
  refine cauchySeq_of_dense_of_isometry (F := fun k => T.approxU ((k : ℝ) + 1) t)
    (fun k y => T.norm_approxU_apply _ t y) T.denseDomain ?_ x
  intro y hy
  exact T.approxU_cauchy_domain t ⟨y, hy⟩

/-! ## The limit group -/

/-- The unitary group `e^{-itA}` generated by the self-adjoint operator `A`, defined as the
strong limit of `e^{-itA_n}`. -/
noncomputable def stoneFun (t : ℝ) (x : H) : H :=
  limUnder atTop (fun k : ℕ => T.approxU ((k : ℝ) + 1) t x)

theorem tendsto_stoneFun (t : ℝ) (x : H) :
    Tendsto (fun k : ℕ => T.approxU ((k : ℝ) + 1) t x) atTop (𝓝 (T.stoneFun t x)) := by
  obtain ⟨z, hz⟩ := cauchySeq_tendsto_of_complete (T.approxU_cauchy t x)
  rw [stoneFun, hz.limUnder_eq]
  exact hz

theorem norm_stoneFun (t : ℝ) (x : H) : ‖T.stoneFun t x‖ = ‖x‖ := by
  have h1 : Tendsto (fun k : ℕ => ‖T.approxU ((k : ℝ) + 1) t x‖) atTop (𝓝 ‖T.stoneFun t x‖) :=
    (T.tendsto_stoneFun t x).norm
  have h2 : (fun k : ℕ => ‖T.approxU ((k : ℝ) + 1) t x‖) = fun _ : ℕ => ‖x‖ := by
    funext k; exact T.norm_approxU_apply _ t x
  rw [h2] at h1
  exact tendsto_nhds_unique h1 tendsto_const_nhds

/-- `e^{-itA}` as a linear map. -/
noncomputable def stoneLinear (t : ℝ) : H →ₗ[ℂ] H where
  toFun x := T.stoneFun t x
  map_add' x y := by
    refine tendsto_nhds_unique (T.tendsto_stoneFun t (x + y)) ?_
    have h : (fun k : ℕ => T.approxU ((k : ℝ) + 1) t (x + y))
        = fun k : ℕ => T.approxU ((k : ℝ) + 1) t x + T.approxU ((k : ℝ) + 1) t y := by
      funext k; rw [map_add]
    rw [h]
    exact (T.tendsto_stoneFun t x).add (T.tendsto_stoneFun t y)
  map_smul' c x := by
    refine tendsto_nhds_unique (T.tendsto_stoneFun t (c • x)) ?_
    have h : (fun k : ℕ => T.approxU ((k : ℝ) + 1) t (c • x))
        = fun k : ℕ => c • T.approxU ((k : ℝ) + 1) t x := by
      funext k; rw [map_smul]
    rw [h]
    exact (T.tendsto_stoneFun t x).const_smul c

/-- **The unitary group `e^{-itA}`** generated by an unbounded self-adjoint operator. -/
noncomputable def stoneU (t : ℝ) : H →L[ℂ] H :=
   (T.stoneLinear t).mkContinuous 1 (fun x => by
     simp only [stoneLinear, LinearMap.coe_mk, AddHom.coe_mk, one_mul]
     exact le_of_eq (T.norm_stoneFun t x))

@[simp] theorem stoneU_apply (t : ℝ) (x : H) : T.stoneU t x = T.stoneFun t x := rfl

theorem tendsto_stoneU (t : ℝ) (x : H) :
    Tendsto (fun k : ℕ => T.approxU ((k : ℝ) + 1) t x) atTop (𝓝 (T.stoneU t x)) :=
  T.tendsto_stoneFun t x

theorem norm_stoneU_apply (t : ℝ) (x : H) : ‖T.stoneU t x‖ = ‖x‖ := T.norm_stoneFun t x

@[simp] theorem stoneU_zero : T.stoneU 0 = 1 := by
  ext x
  refine tendsto_nhds_unique (T.tendsto_stoneU 0 x) ?_
  have h : (fun k : ℕ => T.approxU ((k : ℝ) + 1) 0 x) = fun _ : ℕ => x := by
    funext k; simp
  rw [h]
  simp

/-- The one-parameter group law. -/
theorem stoneU_add (s t : ℝ) : T.stoneU (s + t) = T.stoneU s * T.stoneU t := by
  ext x
  refine tendsto_nhds_unique (T.tendsto_stoneU (s + t) x) ?_
  have h : (fun k : ℕ => T.approxU ((k : ℝ) + 1) (s + t) x)
      = fun k : ℕ => T.approxU ((k : ℝ) + 1) s (T.approxU ((k : ℝ) + 1) t x) := by
    funext k
    rw [T.approxU_add]
    rfl
  rw [h]
  have hgoal : Tendsto (fun k : ℕ => T.approxU ((k : ℝ) + 1) s (T.approxU ((k : ℝ) + 1) t x))
      atTop (𝓝 (T.stoneU s (T.stoneU t x))) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp (T.tendsto_stoneU t x) (ε / 2) (by linarith)
    obtain ⟨N₂, hN₂⟩ :=
      Metric.tendsto_atTop.mp (T.tendsto_stoneU s (T.stoneU t x)) (ε / 2) (by linarith)
    refine ⟨max N₁ N₂, fun k hk => ?_⟩
    have hk1 : N₁ ≤ k := le_trans (le_max_left _ _) hk
    have hk2 : N₂ ≤ k := le_trans (le_max_right _ _) hk
    have h1 : dist (T.approxU ((k : ℝ) + 1) s (T.approxU ((k : ℝ) + 1) t x))
        (T.approxU ((k : ℝ) + 1) s (T.stoneU t x)) < ε / 2 := by
      rw [dist_eq_norm, ← map_sub, T.norm_approxU_apply]
      have := hN₁ k hk1
      rwa [dist_eq_norm] at this
    have h2 : dist (T.approxU ((k : ℝ) + 1) s (T.stoneU t x)) (T.stoneU s (T.stoneU t x)) < ε / 2 :=
      hN₂ k hk2
    calc dist (T.approxU ((k : ℝ) + 1) s (T.approxU ((k : ℝ) + 1) t x))
          (T.stoneU s (T.stoneU t x))
        ≤ dist (T.approxU ((k : ℝ) + 1) s (T.approxU ((k : ℝ) + 1) t x))
            (T.approxU ((k : ℝ) + 1) s (T.stoneU t x))
          + dist (T.approxU ((k : ℝ) + 1) s (T.stoneU t x)) (T.stoneU s (T.stoneU t x)) :=
          dist_triangle _ _ _
      _ < ε := by linarith
  exact hgoal

theorem stoneU_apply_stoneU (s t : ℝ) (x : H) : T.stoneU s (T.stoneU t x) = T.stoneU (s + t) x := by
  rw [T.stoneU_add]; rfl

/-- On the domain, `‖e^{-itA} x - x‖ ≤ |t| ‖A x‖`. -/
theorem norm_stoneU_sub_approxU_le (k : ℝ) (t : ℝ) (x : T.domain) :
    ‖T.stoneU t (x : H) - T.approxU k t (x : H)‖ ≤ |t| * ‖T.op x - T.yosida k (x : H)‖ := by
  have hf : Tendsto (fun l : ℕ => ‖T.approxU ((l : ℝ) + 1) t (x : H) - T.approxU k t (x : H)‖)
      atTop (𝓝 ‖T.stoneU t (x : H) - T.approxU k t (x : H)‖) :=
    ((T.tendsto_stoneU t (x : H)).sub tendsto_const_nhds).norm
  have hg : Tendsto
      (fun l : ℕ => |t| * ‖T.yosida ((l : ℝ) + 1) (x : H) - T.yosida k (x : H)‖)
      atTop (𝓝 (|t| * ‖T.op x - T.yosida k (x : H)‖)) :=
    (((T.yosida_tendsto x).sub tendsto_const_nhds).norm).const_mul _
  refine le_of_tendsto_of_tendsto' hf hg (fun l => ?_)
  exact T.norm_approxU_sub_apply_le _ k t (x : H)

theorem norm_stoneU_sub_domain (t : ℝ) (x : T.domain) :
    ‖T.stoneU t (x : H) - (x : H)‖ ≤ |t| * ‖T.op x‖ := by
  have h := T.norm_stoneU_sub_approxU_le 0 t x
  simpa [approxU, yosidaGen] using h

/-- **Strong continuity at `0`**. -/
theorem tendsto_stoneU_zero (x : H) : Tendsto (fun t : ℝ => T.stoneU t x) (𝓝 0) (𝓝 x) := by
  rw [Metric.tendsto_nhds_nhds]
  intro ε hε
  obtain ⟨z, hz, hxz⟩ := T.denseDomain.exists_dist_lt x (ε := ε / 3) (by linarith)
  set w : T.domain := ⟨z, hz⟩ with hw
  refine ⟨ε / (3 * (‖T.op w‖ + 1)), by positivity, fun t ht => ?_⟩
  rw [Real.dist_eq, sub_zero] at ht
  have hzx : ‖x - z‖ < ε / 3 := by rw [dist_eq_norm] at hxz; exact hxz
  have h1 : ‖T.stoneU t (x - z)‖ = ‖x - z‖ := T.norm_stoneU_apply t _
  have h2 : ‖T.stoneU t z - z‖ ≤ |t| * ‖T.op w‖ := T.norm_stoneU_sub_domain t w
  have hsplit : T.stoneU t x - x = T.stoneU t (x - z) + (T.stoneU t z - z) + (z - x) := by
    rw [map_sub]
    abel
  have h3 : |t| * ‖T.op w‖ < ε / 3 := by
    have hden : (0 : ℝ) < 3 * (‖T.op w‖ + 1) := by positivity
    have h4 : |t| * (3 * (‖T.op w‖ + 1)) < ε := by
      rw [← lt_div_iff₀ hden]; exact ht
    nlinarith [norm_nonneg (T.op w), abs_nonneg t]
  rw [dist_eq_norm]
  calc ‖T.stoneU t x - x‖
      ≤ ‖T.stoneU t (x - z)‖ + ‖T.stoneU t z - z‖ + ‖z - x‖ := by
        rw [hsplit]
        exact (norm_add_le _ _).trans (by gcongr; exact norm_add_le _ _)
    _ = ‖x - z‖ + ‖T.stoneU t z - z‖ + ‖z - x‖ := by rw [h1]
    _ < ε / 3 + ε / 3 + ε / 3 := by
        have : ‖z - x‖ = ‖x - z‖ := norm_sub_rev z x
        rw [this]
        linarith
    _ = ε := by ring

theorem continuousAt_stoneU_apply (x : H) (t₀ : ℝ) :
    ContinuousAt (fun t : ℝ => T.stoneU t x) t₀ := by
  have h1 : Tendsto (fun t : ℝ => t - t₀) (𝓝 t₀) (𝓝 0) := by
    simpa using (continuous_sub_right t₀).tendsto t₀
  have h2 : Tendsto (fun t : ℝ => T.stoneU (t - t₀) x) (𝓝 t₀) (𝓝 x) :=
    (T.tendsto_stoneU_zero x).comp h1
  have h3 : Tendsto (fun t : ℝ => T.stoneU t₀ (T.stoneU (t - t₀) x)) (𝓝 t₀)
      (𝓝 (T.stoneU t₀ x)) :=
    ((T.stoneU t₀).continuous.tendsto x).comp h2
  have heq : (fun t : ℝ => T.stoneU t₀ (T.stoneU (t - t₀) x)) = fun t : ℝ => T.stoneU t x := by
    funext t
    rw [T.stoneU_apply_stoneU]
    have hts : t₀ + (t - t₀) = t := by ring
    rw [hts]
  have h3' : ContinuousAt (fun t : ℝ => T.stoneU t₀ (T.stoneU (t - t₀) x)) t₀ := by
    rw [ContinuousAt]
    simpa [stoneU_zero] using h3
  rw [← heq]
  exact h3'

theorem continuous_stoneU_apply (x : H) : Continuous (fun t : ℝ => T.stoneU t x) :=
  continuous_iff_continuousAt.mpr (fun t₀ => T.continuousAt_stoneU_apply x t₀)

/-- **The group `e^{-itA}` is weakly measurable.** -/
theorem measurable_inner_stoneU (x y : H) :
    Measurable (fun t : ℝ => ⟪ y, T.stoneU t x ⟫_ℂ) :=
  (continuous_const.inner (T.continuous_stoneU_apply x)).measurable

















