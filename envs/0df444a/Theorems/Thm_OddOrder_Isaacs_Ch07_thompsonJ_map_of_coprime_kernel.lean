-- title:
--   Thompson's $J$ commutes with the quotient by a normal $p'$-subgroup on $p$-subgroups
-- statement:
--   Let $G$ be a finite group, $p$ a prime, $N\trianglelefteq G$ a normal subgroup with $p\nmid |N|$, and $\pi:G\to G/N$ the quotient map. Let $P\le G$ be a $p$-subgroup. Then
--   $$J(\pi(P)) = \pi\big(J(P)\big),$$
--   where $J(\cdot)$ is the Thompson subgroup at the prime $p$ (the subgroup generated by the elementary abelian subgroups of maximal order).
--
--   The quotient map is injective on $P$ since $P\cap N=1$; this identification is used when the hypotheses of Isaacs's Theorem 7.1 are passed to $G/N$.
--
--   **Formalization Note.** $J$ is `Subgroup.thompsonJ _ p`; $\pi$ is `QuotientGroup.mk' N`, and the image is `Subgroup.map`.
-- source:
--   Yawara Ishida, Lean 4 formalization of the Feit–Thompson (odd order) theorem, github.com/yawara/odd-order @ 20a6fccbb63c (Apache-2.0), https://github.com/yawara/odd-order/blob/20a6fccbb63c0b138acda9f7fafd798c42f9441b/OddOrder/Isaacs/Ch07_ThompsonSubgroup/S7B2_NormalJ_PComplement.lean#L335-L390

import Definitions.Def_OddOrder_Isaacs_Ch07_ThompsonSubgroup_S7B2_NormalJClose
import Definitions.Def_OddOrder_Isaacs_Ch07_ThompsonSubgroup_S7B2_NormalJ_PComplement

namespace OddOrder.Isaacs.Ch07

open scoped commutatorElement

open scoped Pointwise

variable {G : Type*} [Group G]

open scoped commutatorElement

theorem thompsonJ_map_of_coprime_kernel
    [Finite G] {N : Subgroup G} [N.Normal] {p : ℕ} [Fact p.Prime]
    (hp_coprime : ¬ p ∣ Nat.card N)
    {P : Subgroup G} (hP_pgroup : IsPGroup p P) :
    Subgroup.thompsonJ (P.map (QuotientGroup.mk' N)) p =
      (Subgroup.thompsonJ P p).map (QuotientGroup.mk' N) := by sorry

end OddOrder.Isaacs.Ch07
