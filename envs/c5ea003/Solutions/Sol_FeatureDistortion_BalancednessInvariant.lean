  have hB := (hγ.2.2 t ht).2
  have hRank := ContinuousLinearMap.hasDerivWithinAt_of_bilinear
    (B := InnerProductSpace.rankOne ℝ) hv hv
  let adj : Features d k →L[ℝ] (Vec k →L[ℝ] Vec d) :=
    (ContinuousLinearMap.adjoint (𝕜 := ℝ)).toContinuousLinearEquiv.toContinuousLinearMap
  have hAdj : HasDerivWithinAt (fun s ↦ (γ.features s).adjoint)
      (-featureGradient X Y (γ.head t) (γ.features t)).adjoint (Ici 0) t :=
    adj.hasFDerivAt.comp_hasDerivWithinAt t hB
