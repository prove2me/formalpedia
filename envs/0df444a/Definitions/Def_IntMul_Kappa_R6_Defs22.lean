  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- **What the level procedure needs from the network.** -/
structure NetOK (c : Cfg) : Prop where
  gate : ∀ G, HStep.gate G ∈ c.net → (∃ as, GAtH c.Wr c.A G as) ∨
    ∃ U : Finset (Fin c.Wr), G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1
  child : ∀ w S neg, HStep.child w S neg ∈ c.net → neg = ∅ ∧ S = pref c.m S.card ∧ S.card < c.m
  data : ∀ (κ : Type) [Fintype κ] [DecidableEq κ] (v w' : Fin c.W) (x y : Addr c.m κ),
    denListH (chEx (κ := κ)) c.net (Fin.castAdd c.T v, x) (Fin.castAdd c.T w', y) =
      if v = w' then (tens Cm : Op (Fin c.m × κ)) x y else 0

/-! ## Chosen atoms -/

/-! ## Scales -/

/-- The scale of a step of a node with `F` bits per slot. -/
noncomputable def eStH (c : Cfg) (F : ℕ) : HStep (Fin c.Wr) c.m → ℕ
  | .child _ S _ => c.G (S.card * F)
  | a => eLocH c.Wr c.A c.m a

