theorem LB_of_subset {L L' : List (ℤ × ℤ)} {B : ℕ} (h : LB L B) (hs : ∀ z ∈ L', z ∈ L) :
    LB L' B := fun z hz => h z (hs z hz)

theorem chunkL_LB {L : List (ℤ × ℤ)} {B : ℕ} (h : LB L B) (n : ℕ) :
    ∀ C ∈ chunkL n L, LB C B := by
  intro C hC
  simp only [chunkL, List.mem_map] at hC
  obtain ⟨i, -, rfl⟩ := hC
  exact LB_of_subset h fun z hz => List.mem_of_mem_drop (List.mem_of_mem_take hz)

theorem transposeL_LB {L : List (ℤ × ℤ)} {B : ℕ} (h : LB L B) (n m : ℕ) :
    LB (transposeL n m L) B := by
  intro z hz
  simp only [transposeL, List.mem_map] at hz
  obtain ⟨i, -, rfl⟩ := hz
  exact h.getD _

theorem flatMap_LB {α : Type*} {Xs : List α} {f : α → List (ℤ × ℤ)} {B : ℕ}
    (h : ∀ X ∈ Xs, LB (f X) B) : LB (Xs.flatMap f) B := by
  intro z hz
  obtain ⟨X, hX, hz⟩ := List.mem_flatMap.1 hz
  exact h X hX z hz

theorem mem_zipWith' {α β γ : Type*} {f : α → β → γ} :
    ∀ {l : List α} {l' : List β} {z : γ}, z ∈ List.zipWith f l l' →
      ∃ a ∈ l, ∃ b ∈ l', z = f a b
  | [], _, _, h => by simp at h
  | _ :: _, [], _, h => by simp at h
  | a :: l, b :: l', z, h => by
    simp only [List.zipWith_cons_cons, List.mem_cons] at h
    rcases h with h | h
    · exact ⟨a, by simp, b, by simp, h⟩
    · obtain ⟨a', ha', b', hb', e⟩ := mem_zipWith' h
      exact ⟨a', by simp [ha'], b', by simp [hb'], e⟩

/-- The tensor product: if every axis map sends `LB · B` lists to `LB · (g B)` and `g` is
inflationary, the output is bounded by `g^[#axes] B`. -/
theorem tensorGo_LB (g : ℕ → ℕ) (hg : ∀ B, B ≤ g B) :
    ∀ (As : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ)))),
      (∀ a ∈ As, ∀ X B, LB X B → LB (a.2 X) (g B)) →
      ∀ (dims : List ℕ) (L : List (ℤ × ℤ)) (B : ℕ), LB L B →
        LB (tensorGo As dims L) (g^[As.length] B)
  | [], _, dims, L, B, hL => by simpa [tensorGo] using hL
  | (n', A) :: As, hA, [], L, B, hL => by
    simp only [tensorGo]
    refine hL.mono ?_
    have hgi : ∀ k B, B ≤ g^[k] B := by
      intro k; induction k with
      | zero => intro B; simp
      | succ k ih => intro B; rw [Function.iterate_succ_apply']; exact (ih B).trans (hg _)
    exact hgi _ _
  | (n', A) :: As, hA, n :: rest, L, B, hL => by
    simp only [tensorGo, List.length_cons, Function.iterate_succ_apply]
    apply tensorGo_LB g hg As (fun a ha => hA a (by simp [ha]))
    apply flatMap_LB
    intro X hX
    exact hA (n', A) (by simp) X B (chunkL_LB (transposeL_LB hL _ _) _ X hX)

/-- Multiplicative version: a factor `c ≥ 1` per axis. -/
theorem tensorGo_LB_mul (c : ℕ) (hc : 1 ≤ c) (As : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ))))
    (hA : ∀ a ∈ As, ∀ X B, LB X B → LB (a.2 X) (c * B)) (dims : List ℕ)
    {L : List (ℤ × ℤ)} {B : ℕ} (hL : LB L B) :
    LB (tensorGo As dims L) (c ^ As.length * B) := by
  have h := tensorGo_LB (fun B => c * B) (fun B => Nat.le_mul_of_pos_left B hc) As hA dims L B hL
  have e : ∀ k B, (fun B => c * B)^[k] B = c ^ k * B := by
    intro k; induction k with
    | zero => intro B; simp
    | succ k ih => intro B; rw [Function.iterate_succ_apply', ih, pow_succ]; ring
  rwa [e] at h

/-- The intermediate stage after the first `k` axes. -/
theorem tensorGo_take_LB (c : ℕ) (hc : 1 ≤ c) (As : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ))))
    (hA : ∀ a ∈ As, ∀ X B, LB X B → LB (a.2 X) (c * B)) (dims : List ℕ)
    {L : List (ℤ × ℤ)} {B : ℕ} (hL : LB L B) (k : ℕ) :
    LB (tensorGo (As.take k) dims L) (c ^ k * B) := by
  have h := tensorGo_LB_mul c hc (As.take k) (fun a ha => hA a (List.mem_of_mem_take ha)) dims hL
  refine h.mono (Nat.mul_le_mul_right _ (Nat.pow_le_pow_right hc ?_))
  simp

/-- The slices fed to the axis maps at one step of `tensorGo` are bounded by the bound of the
current array. -/
theorem tensorGo_slices_LB {L : List (ℤ × ℤ)} {B : ℕ} (hL : LB L B) (n m : ℕ) :
    ∀ X ∈ chunkL n (transposeL n m L), LB X B :=
  chunkL_LB (transposeL_LB hL _ _) _

theorem chunksL_LBz (b L x : ℕ) : LBz (chunksL b L x) (2 ^ b - 1) := by
  intro a ha
  simp only [chunksL, List.mem_map] at ha
  obtain ⟨k, -, rfl⟩ := ha
  rw [Int.natAbs_natCast]
  have := Nat.mod_lt (x / 2 ^ (b * k)) (show 0 < 2 ^ b by positivity)
  omega

theorem crtIn_LBz (s : List ℕ) {c : List ℤ} {B : ℕ} (h : LBz c B) : LBz (crtIn s c) B := by
  intro a ha
  simp only [crtIn, listOf, List.mem_map] at ha
  obtain ⟨l, -, rfl⟩ := ha
  exact h.getD _

theorem crtOut_LBz (s : List ℕ) (M : ℕ) {w : List ℤ} {B : ℕ} (h : LBz w B) :
    LBz (crtOut s M w) B := by
  intro a ha
