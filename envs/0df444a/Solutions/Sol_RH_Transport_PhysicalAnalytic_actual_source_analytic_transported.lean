  refine ⟨excludePrimes_mask η S hS.prime, ?_, ?_⟩
  · change AnalyticOnNhd ℂ (fun s => globalClosedCorrection η S s 1 (1 / 6))
      {s : ℂ | Geometry.boundary p < s.re}
    exact RH.Transport.PhysicalAnalytic.globalClosedCorrection_transported_analytic_x p hp η S hS.tail
      (1 : ℂ) (1 / 6 : ℂ) (by norm_num) (by norm_num)
