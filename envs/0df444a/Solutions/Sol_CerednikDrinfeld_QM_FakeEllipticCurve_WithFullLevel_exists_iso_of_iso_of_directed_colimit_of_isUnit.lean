theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (m : ℕ) (hm : 3 ≤ m)
    (ι : Type) [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    (S : ι → Type) [∀ i, CommRing (S i)]
    (t : ∀ i j, i ≤ j → (S i →+* S j))
    (ht₁ : ∀ i (h : i ≤ i), t i i h = RingHom.id (S i))
    (ht₂ : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k), (t j k hjk).comp (t i j hij) = t i k (hij.trans hjk))
    (L : Type) [CommRing L] (c : ∀ i, S i →+* L)
    (hc : ∀ i j (h : i ≤ j), (c j).comp (t i j h) = c i)
    (hcsurj : ∀ x : L, ∃ (i : ι) (y : S i), c i y = x)
    (hcker : ∀ (i : ι) (y z : S i), c i y = c i z → ∃ (j : ι) (h : i ≤ j), t i j h y = t i j h z)
    (hmL : IsUnit ((m : ℕ) : L)) :
    ∀ (i : ι) (v w : FakeEllipticCurve.WithFullLevel Λ N m (S i)) (v' w' : FakeEllipticCurve.WithFullLevel Λ N m L),
        FakeEllipticCurve.WithFullLevel.IsPullback (c i) v v' → FakeEllipticCurve.WithFullLevel.IsPullback (c i) w w' →
        FakeEllipticCurve.WithFullLevel.Iso v' w' →
        ∃ (j : ι) (h : i ≤ j) (vj wj : FakeEllipticCurve.WithFullLevel Λ N m (S j)),
          FakeEllipticCurve.WithFullLevel.IsPullback (t i j h) v vj ∧ FakeEllipticCurve.WithFullLevel.IsPullback (t i j h) w wj ∧
          FakeEllipticCurve.WithFullLevel.Iso vj wj := by
  classical
  intro i v w v' w' hv' hw' hiso
  obtain ⟨-, Kcomp, Kcancel, -, -, -, -, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.isPullback_refl_comp_cancel_iso_unique_nsmulPt Λ N m

  obtain ⟨x, hx⟩ := hmL.exists_right_inv
  obtain ⟨j₁, y, hy⟩ := hcsurj x
  have h1 : c j₁ (((m : ℕ) : S j₁) * y) = c j₁ 1 := by rw [map_mul, map_natCast, hy, hx, map_one]
  obtain ⟨j₂, hj₁₂, hj₂⟩ := hcker j₁ _ _ h1
  obtain ⟨j₀, hij₀, hj₂₀⟩ := directed_of (· ≤ ·) i j₂
  have hm₀ : IsUnit ((m : ℕ) : S j₀) := by
    have h2 := congrArg (t j₂ j₀ hj₂₀) hj₂
    rw [map_mul, map_natCast, map_one, map_mul, map_natCast, map_one] at h2
    exact isUnit_iff_exists_inv.2 ⟨_, h2⟩

  obtain ⟨v₀, gv₀, hgv₀, hv₀s⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff (t i j₀ hij₀) v
  obtain ⟨w₀, gw₀, hgw₀, hw₀s⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff (t i j₀ hij₀) w
  have hv₀ : FakeEllipticCurve.WithFullLevel.IsPullback (t i j₀ hij₀) v v₀ := isPullback_of_strong _ _ _ gv₀ hgv₀ hv₀s
  have hw₀ : FakeEllipticCurve.WithFullLevel.IsPullback (t i j₀ hij₀) w w₀ := isPullback_of_strong _ _ _ gw₀ hgw₀ hw₀s
  have hv'₀ : FakeEllipticCurve.WithFullLevel.IsPullback (c j₀) v₀ v' :=
    Kcancel _ _ _ (t i j₀ hij₀) (c j₀) v v₀ v' hv₀ (by rw [hc i j₀ hij₀]; exact hv')
  have hw'₀ : FakeEllipticCurve.WithFullLevel.IsPullback (c j₀) w₀ w' :=
    Kcancel _ _ _ (t i j₀ hij₀) (c j₀) w w₀ w' hw₀ (by rw [hc i j₀ hij₀]; exact hw')
  obtain ⟨k, hj₀k, vk, wk, hvk, hwk, hisok⟩ :=
    ColimB18.main_at hqq' hB Λ hΛ N m hm ι S t ht₁ ht₂ L c hc hcsurj hcker j₀ hm₀ v₀ w₀ v' w' hv'₀ hw'₀ hiso
  refine ⟨k, hij₀.trans hj₀k, vk, wk, ?_, ?_, hisok⟩
  · rw [← ht₂ i j₀ k hij₀ hj₀k]; exact Kcomp _ _ _ (t i j₀ hij₀) (t j₀ k hj₀k) v v₀ vk hv₀ hvk
  · rw [← ht₂ i j₀ k hij₀ hj₀k]; exact Kcomp _ _ _ (t i j₀ hij₀) (t j₀ k hj₀k) w w₀ wk hw₀ hwk

