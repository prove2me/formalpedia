  have h2 : AModel.vol ([b].map (asz mz)) = 2 := by simp [AModel.vol, hb]
  have e : AModel.vol ((LA ++ LF ++ [b] ++ LC).map (asz mz)) =
      AModel.vol (LA.map (asz mz)) * 2 * AModel.vol (LF.map (asz mz)) * AModel.vol (LC.map (asz mz)) := by
    simp only [List.map_append, vol_append, h2]; ring
