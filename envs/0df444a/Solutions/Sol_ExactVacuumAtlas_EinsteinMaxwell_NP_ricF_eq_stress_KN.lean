open Real Complex
open scoped ComplexConjugate
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN faradayKN domReg)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable {M a Q : ℝ} {x : Pt 4}
local notation "OM" => omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q)
theorem solution (hx : x ∈ domReg M a Q) (A B : Fin 4) :
    ricF (gKN M a Q) (giKN M a Q) (knE M a Q) A B x
      = 2 * ccontr (emStress (gKN M a Q) (giKN M a Q) (faradayKN a Q)) x (fvec (knE M a Q) A x)
        (fvec (knE M a Q) B x) := by
  have h : ∀ i j, ricciOf (gKN M a Q) (giKN M a Q) i j x = 2 * emStress (gKN M a Q) (giKN M a Q) (faradayKN a Q) i j x := by
    intro i j
    have := KN.einstein M a Q hx i j
    have hR := KN.ricciScalar_zero M a Q hx
    unfold einsteinMaxwell at this
    rw [hR] at this
    linarith
  unfold ricF
  simp only [ccontr, h, Complex.ofReal_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by push_cast; ring
