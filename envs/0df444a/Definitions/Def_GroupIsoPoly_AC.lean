-- title:
--   The characteristic subgroups $\mathrm{AC}(K)$ and $S(K)$
-- statement:
--   Let $K$ be a finite group with $\mathrm{srad}(K)\ne1$. Let $D$ be the last nonidentity term of the derived series of $\mathrm{srad}(K)$, let $r$ be the least prime dividing $|D|$, and let $D_r$ be the unique Sylow $r$-subgroup of the abelian group $D$. Set
--   $$
--   \mathrm{AC}(K)=\{x\in D_r : x^r=1\}.
--   $$
--   The **selected subgroup** is
--   $$
--   S(K)=\begin{cases}\mathrm{AC}(K)&\text{if }\mathrm{srad}(K)\ne1,\\ \mathrm{Soc}(K)&\text{if }\mathrm{srad}(K)=1.\end{cases}
--   $$
--   Both are characteristic in $K$; $\mathrm{AC}(K)$ is a nontrivial elementary abelian $r$-group.
--
--   **Formalization Note** $D=\mathrm{srad}(K)^{(d)}$ where $d$ is the least index with $\mathrm{srad}(K)^{(d+1)}=1$. `AC K` is the normal subgroup generated by $\{x\in D: x^r=1\}$. Since $D$ is abelian and characteristic, this set is already a normal subgroup, and it equals $\{x\in D_r:x^r=1\}$ because each such $x$ has order dividing the prime $r$; generating the normal subgroup changes nothing and provides normality by construction. `AC K` carries no meaning when $\mathrm{srad}(K)=1$, where `S K` uses the socle.
-- source:
--   Qiao, Zhang, Testing isomorphism of finite groups in time polynomial in the group order, preprint, Nov. 3, 2026 (held version sha256 eb9a3355…), §9.2.1, p.94 (PDF p.98)

import Mathlib
import Definitions.Def_GroupIsoPoly_srad
import Definitions.Def_GroupIsoPoly_soc

set_option autoImplicit false

namespace GroupIsoPoly

/-- The index of the last nonidentity term of the derived series of `srad K`: the least `n` with
`(srad K)^{(n+1)} = 1`. -/
noncomputable def derivedLen (K : Type*) [Group K] : ℕ :=
  sInf {n : ℕ | derivedSeries (srad K) (n + 1) = ⊥}

/-- `D`, the last nonidentity term of the derived series of `srad K`, as a subgroup of `K`. -/
noncomputable def lastDerived (K : Type*) [Group K] : Subgroup K :=
  (derivedSeries (srad K) (derivedLen K)).map (srad K).subtype

/-- `r`, the least prime dividing `|D|`. -/
noncomputable def acPrime (K : Type*) [Group K] : ℕ :=
  Nat.minFac (Nat.card (lastDerived K))

/-- **The characteristic elementary abelian subgroup** `AC(K)`.

Qiao, Zhang, *Testing isomorphism of finite groups in time polynomial in the group order*, preprint,
Nov. 3, 2026 (held version sha256 eb9a3355…), §9.2.1, p.94 (PDF p.98): "For a nontrivial group K
with srad(K) ≠ 1, let D be the last nonidentity term of the derived series of srad(K), let r be the
least prime dividing |D|, and let D_r be the unique Sylow r-subgroup of D. As in the overview, set
AC(K) = {x ∈ D_r : x^r = 1}".

`AC K` is the subgroup of `K` generated by the elements `x ∈ D` with `x ^ r = 1`.

**Formalization Note.** `D = (srad K)^{(d)}` with `d` the least index such that
`(srad K)^{(d+1)} = 1`; for finite `K` with `srad K ≠ 1` this is the last nonidentity term. `D` is
abelian and characteristic in `K`, so `{x ∈ D : x^r = 1}` is already a normal subgroup, and it equals
`{x ∈ D_r : x^r = 1}` because every such `x` has order dividing the prime `r`. Generating the normal
subgroup (`normalClosure`) therefore changes nothing; it makes normality available by construction.
`AC K` is only meaningful when `srad K ≠ 1`; the selection `S` below uses the socle otherwise. -/
noncomputable def AC (K : Type*) [Group K] : Subgroup K :=
  Subgroup.normalClosure {x : K | x ∈ lastDerived K ∧ x ^ acPrime K = 1}

instance AC_normal (K : Type*) [Group K] : (AC K).Normal :=
  Subgroup.normalClosure_normal

open Classical in
/-- **The selected characteristic subgroup** `S(K)`.

Qiao, Zhang, preprint, Nov. 3, 2026 (held version sha256 eb9a3355…), §9.2.1, p.94 (PDF p.98): "set
AC(K) = {x ∈ D_r : x^r = 1} and S(K) = AC(K). If srad(K) = 1, set S(K) = Soc(K), a direct product of
nonabelian simple groups."

`S K` is `AC K` when the solvable radical of `K` is nontrivial, and the socle `soc K` otherwise. -/
noncomputable def S (K : Type*) [Group K] : Subgroup K :=
  if srad K = ⊥ then soc K else AC K

instance S_normal (K : Type*) [Group K] : (S K).Normal := by
  unfold S
  split_ifs <;> infer_instance

end GroupIsoPoly


