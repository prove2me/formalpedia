-- title:
--   Canonical analytic-orbit base ideals and chart length budgets
-- statement:
--   For a commutative ring $R$, a ring homomorphism $\phi:R\to(\mathbb C\to\mathbb C)$, and $z\in\mathbb C$, define the ideal
--
--   $$K_{\phi,z}=\{r\in R:\phi(r)\text{ vanishes identically on some neighborhood of }z\}.$$
--
--   Formally this is the kernel of the composite of $\phi$ with the ring homomorphism from functions to germs at $z$. Define the canonical base ideal for an element $f\in R$ by
--
--   $$J_{\phi,z,f}=K_{\phi,z}+(f).$$
--
--   No analyticity assumption is part of these definitions. Analyticity of all the orbit functions will be used in the theorem proving that $K_{\phi,z}$ is prime.
--
--   For the previously defined Weierstrass affine charts, set $A=\mathbb C[X_0,X_1,X_2,X_3]$ and
--
--   $$\phi_j(r)(w)=r(v_j(w)),\qquad
--   J_{j,z,Q}=K_{\phi_j,z}+(Q_j),$$
--
--   where $v_j$ is `extensionChartCoordinates` and $Q_j$ is `extensionChartNormalize j Q`. The definitions `extensionChartEvalHom` and `extensionChartBaseIdeal` record these maps and ideals.
--
--   For fixed period data $L$, coordinates $S$, polynomial $Q$, natural numbers $T,e$, and a finite set $Z\subset\mathbb C$, `ChartOrbitBaseBudget L S Q T e Z` chooses a chart $j\in\{0,1\}$ and a point $z\in Z$ with nonzero chart denominator. It also requires the following bound for every $i\in\{0,1,2\}$ and every prime $\mathfrak p$ below the evaluation kernel at $v_j(z)$ that is minimal over both $P_{iT}(J_{j,z,Q})$ and $P_{(i+1)T}(J_{j,z,Q})$:
--
--   $$\operatorname{length}_{A_{\mathfrak p}}\bigl(A_{\mathfrak p}/P_{iT}(J_{j,z,Q})A_{\mathfrak p}\bigr)\le e.$$
--
--   Here $P_r(J)$ is the previously defined ideal generated by the chart derivatives through order $r$ of all elements of $J$.
--
--   The base ideal is fixed by the definition. Height, normalized-polynomial membership, and terminal derivative containment are theorem conclusions, not fields of this structure. No identification of the germ kernel with the full algebraic-group ideal, or equivalence with arbitrary previously supplied base ideals, is included in the definition.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 5, p. 380: starting ideal obtained by adjoining the polynomial equation to an ambient relation ideal, and derivative ideals contained in evaluation ideals at points of high vanishing. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. The complete theorem constructs the canonical base from the local analytic-orbit kernel and the normalized polynomial, and proves height at least two, membership and terminal derivative containment in both Weierstrass charts. Identification of this germ kernel with the entire algebraic-group ideal is not asserted. The remaining child must select the locus and chart points and prove a uniform total-length degree budget for this specific base ideal; no converse for arbitrary previous bases is claimed.

import Definitions.Def_WeierstrassEllipticZeta_ChartSelectionData
import Mathlib.Order.Filter.Germ.Basic
import Mathlib.Algebra.Algebra.Pi

noncomputable section
open scoped Topology

namespace TranscendenceTheory

/-- Polynomials or ring elements that vanish as germs along an analytic orbit. -/
def analyticOrbitKernel {R : Type*} [CommRing R] (φ : R →+* (ℂ → ℂ)) (z : ℂ) : Ideal R :=
  RingHom.ker ((Filter.Germ.coeRingHom (𝓝 z)).comp φ)

/-- Adjoin the distinguished equation to the orbit's germ kernel. -/
def analyticOrbitBaseIdeal {R : Type*} [CommRing R]
    (φ : R →+* (ℂ → ℂ)) (z : ℂ) (f : R) : Ideal R :=
  analyticOrbitKernel φ z ⊔ Ideal.span {f}

end TranscendenceTheory

namespace WeierstrassEllipticZeta
open TranscendenceTheory

/-- Evaluation along the concrete affine chart orbit. -/
def extensionChartEvalHom (S : Fin 5 → ℂ → ℂ) (c : Fin 2) :
    MvPolynomial (Fin 4) ℂ →+* (ℂ → ℂ) :=
  (AlgHom.pi fun z => MvPolynomial.aeval (extensionChartCoordinates S c z)).toRingHom

/-- The canonical starting ideal for the chart derivative chain. -/
def extensionChartBaseIdeal (S : Fin 5 → ℂ → ℂ) (Q : MvPolynomial (Fin 7) ℂ)
    (c : Fin 2) (z : ℂ) : Ideal (MvPolynomial (Fin 4) ℂ) :=
  analyticOrbitBaseIdeal (extensionChartEvalHom S c) z (extensionChartNormalize c Q)

/-- Only the point and the degree-budget input remain; the base ideal is fixed. -/
structure ChartOrbitBaseBudget (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T e : ℕ) (Z : Finset ℂ) where
  chart : Fin 2
  z : ℂ
  z_mem : z ∈ Z
  chart_ne : S (extensionChartDenominator chart) z ≠ 0
  length_le : ∀ (i : Fin 3) (p : Ideal (MvPolynomial (Fin 4) ℂ)) [p.IsPrime],
    p ≤ RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S chart z)) →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionChartBaseIdeal S Q chart z) (i.val * T)).minimalPrimes →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionChartBaseIdeal S Q chart z) ((i.val + 1) * T)).minimalPrimes →
    Module.length (Localization.AtPrime p)
      ((Localization.AtPrime p) ⧸ (differentialProlongation
        (extensionChartDerivation L.g₂ L.g₃ chart)
        (extensionChartBaseIdeal S Q chart z) (i.val * T)).map
        (algebraMap (MvPolynomial (Fin 4) ℂ) (Localization.AtPrime p))) ≤ (e : ℕ∞)

end WeierstrassEllipticZeta


