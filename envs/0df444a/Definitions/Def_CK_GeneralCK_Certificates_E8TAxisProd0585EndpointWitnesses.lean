    centerALowerYBox.Contains (Y (lower E8TAxisProd0585PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0585PaddedInputs.centerAInput.alpha = ((1741156135795404262119345367673058305863487983 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
