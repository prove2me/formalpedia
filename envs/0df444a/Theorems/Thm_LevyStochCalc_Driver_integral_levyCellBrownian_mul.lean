theorem _root_.LevyStochCalc.Driver.integral_levyCellBrownian_mul (D : LevyDriver.{u, v, w} P d ν) (a b a' b' : Fin d)
    {s t : ℝ} (hs : 0 ≤ s) (hst : s ≤ t) :
    ∫ ω, levyCellBrownian D s t a b ω * levyCellBrownian D s t a' b' ω ∂P
      = (t - s) ^ 2 * ((if a = a' then 1 else 0) * (if b = b' then 1 else 0)
        + (if a = b' then 1 else 0) * (if b = a' then 1 else 0)) := by sorry
