/-
Reduction of `BurauFaithful.burau_three_spec_kernel` to its hard direction, the easy direction
being the already Proved `BurauFaithful.burau_three_spec_twist_zpow`:

* (⟸) a power of the full twist squared dies at `t = -1`;
* (⟹) the hard direction `burau_three_spec_kernel_hard`, i.e. Birman's use of the Coxeter-Moser
  presentation of `M₂ = SL(2,ℤ)` to conclude that the kernel is generated by `Δ⁴ = (σ₁σ₂)⁶`.
-/
import Definitions.Def_BurauFaithful_UnreducedBurau
import Theorems.Thm_BurauFaithful_burau_three_spec_kernel_hard
import Theorems.Thm_BurauFaithful_burau_three_spec_twist_zpow

set_option autoImplicit false

open LaurentPolynomial Matrix BraidsLinksMCG

theorem solution (β : BraidsLinksMCG.ArtinBraidGroup 3) :
    Matrix.GeneralLinearGroup.map (LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ))
        (BurauFaithful.burauRep 3 β) = 1 ↔
      ∃ k : ℤ, β = (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩) ^ (6 * k) := by
  constructor
  · intro h
    exact BurauFaithful.burau_three_spec_kernel_hard β h
  · rintro ⟨k, rfl⟩
    exact BurauFaithful.burau_three_spec_twist_zpow k
