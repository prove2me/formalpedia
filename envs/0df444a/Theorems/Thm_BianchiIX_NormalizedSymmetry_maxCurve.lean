theorem BianchiIX.NormalizedSymmetry.maxCurve {x : NormalizedState} {t₀ t : ℝ} (ht : t ∈ normalizedMaxDomain x t₀) :
    normalizedMaxCurve (A.map x) t₀ t = A.map (normalizedMaxCurve x t₀ t) := by sorry
