/-- **The regime of every axis.** -/
theorem axReg_of (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, AxReg P n src D k := by
  obtain ⟨n₁, h⟩ := r6_axis_nat P hP
  obtain ⟨n₃, hme⟩ := r6_maps_eq P hP
  refine ⟨max n₁ n₃, fun n hn src hsrc D hD k hk => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hax : ∀ i : Fin (D + 1), 0 < sD6 src D i ∧ sD6 src D i < tD6 P n D i := by
    intro i
    have hi : i.val < dP6 P n := by have := i.isLt; omega
    obtain ⟨hs0, hst, -⟩ := h n hn1 src hsrc i.val hi
    exact ⟨hs0, hst⟩
  haveI : ∀ i, NeZero (sD6 src D i) := fun i => ⟨(hax i).1.ne'⟩
  haveI : ∀ i, NeZero (tD6 P n D i) := fun i => ⟨by have := hax i; omega⟩
  obtain ⟨-, hdv⟩ := hme n hn3 src hsrc D hD
  obtain ⟨hdvd, -⟩ := hdv ⟨k, by omega⟩
  obtain ⟨-, hst⟩ := hax ⟨k, by omega⟩
  have hl : 1 ≤ axl6 P n := Nat.one_le_two_pow
  have ht : 0 < axt6 P n k := tF6_pos P n k
  have hdvd' : axl6 P n ∣ axt6 P n k := hdvd
  refine ⟨hl, Nat.div_pos (Nat.le_of_dvd ht hdvd') hl, le_of_lt hst,
    Nat.div_mul_cancel hdvd', ?_⟩
  unfold axpost6 postT
  apply List.prod_pos
  intro a ha
  obtain ⟨i, rfl⟩ := List.mem_ofFn.1 (List.mem_of_mem_drop ha)
  exact tF6_pos P n i

/-- Cost monotonicity of `AxisBody6`. -/
theorem AxisBody6.mono {Pp : ℕ} {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {Isym : List Sym}
    {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp} {dA : Fin HS} {C C' : ℝ}
    (h : AxisBody6 P n src D Isym tbl eX dA C) (hC : C ≤ C') :
    AxisBody6 P n src D Isym tbl eX dA C' := fun k hk s F L l h1 h2 h3 h4 h5 => by
  obtain ⟨c, r, kc⟩ := h k hk s F L l h1 h2 h3 h4 h5; exact ⟨c, r, kc.trans hC⟩

set_option maxHeartbeats 8000000 in
/-- **`AxisU6` from the B-line components.** -/
theorem axisU6_of_sol_aux (P : Prm) (hP : P.Ok) (ap : AxPlan6) (hVC : Val.ValCond6 ap) (hCP : AxCh.ChunkPlan6 ap)
    (hPre : PreNeed6 P ap.pl) (hBud : AxBudget6 P ap) (hSlab : SlabNeed6 P)
    (tab : Fin 1 → IStmt HS 1) (hSw : IL.SwapNeedτ tab P.τ) (hRow : IL2.RowUCP 576 P.τ tab)
    (hFU : FineU6 tab) : AxisU6 P tab := by
  obtain ⟨nF, UF, eF, eB, dF, CF, hdF0, hCF, HF⟩ := hFU
  obtain ⟨nP, UP, eC, eCd, eJ, eJd, Cp, AP, nPr, hCp, HP⟩ :=
    hPre tab hSw hRow ⟨nF, UF, eF, eB, dF, CF, hdF0, hCF, HF⟩ (ρK dF) dAx (ρK_inj dF)
      (fun i => ρK_ne (by left; decide) i) (fun i => ρK_ne (by left; decide) i) (by decide)
      (ρK_lt dF) (by decide)
  obtain ⟨nS, US, e1u, e1d, e3u, e3d, e5u, e5d, e7u, e7d, Cs, AS, nSl, hCs, HSl⟩ :=
    hSlab dAx dAx_free (by decide) (by decide)
  obtain ⟨CB, AB, nB, hCB, HB⟩ := hBud
  obtain ⟨nV, HV⟩ := valAt_of P ap (Val.valNeed6_all' P hP ap hVC)
  obtain ⟨nT, HT⟩ := tabAt_of P (TabBnd.chunkTabBnd6_all P hP)
  obtain ⟨nC, HC⟩ := AxCh.chunkOut6_all P hP ap hCP
  obtain ⟨nR, HR⟩ := axReg_of P hP
  obtain ⟨nQ, HQ⟩ := qok_of P hP
  set A := max AP (max AS AB) with hAd
  set C₀ : ℝ := 8 * Cs + 6 * Cp + (9 + 6 * CF) * CB + 2 with hC₀
  refine ⟨nF + (nP + nS) + 3, famOwn (famApp UF (famApp UP US))
      (ownV nF nP nS eF eB eC eCd eJ eJd e1u e1d e3u e3d e5u e5d e7u e7d dF),
    Fin.natAdd _ 2, dAx, C₀, A, max nPr (max nSl (max nB (max nV (max nT (max nC (max nR nQ)))))),
    by decide, by positivity, ?_⟩
  intro n hn src hsrc D hD E ext idx hidx Isym
  have hnP : nPr ≤ n := by omega
  have hnS : nSl ≤ n := by omega
  have hnB : nB ≤ n := by omega
  have hnV : nV ≤ n := by omega
  have hnT : nT ≤ n := by omega
  have hnC : nC ≤ n := by omega
  have hnR : nR ≤ n := by omega
  have hnQ : nQ ≤ n := by omega
  set tbl := IL.kTableP tab ext with htbl
  have hO := famOwn_right hidx
  have hBase := famOwn_left hidx
  have hFi := famApp_left hBase
  have hPS := famApp_right hBase
  have hPi := famApp_left hPS
  have hSi := famApp_right hPS
  have hFine := (HF E ext _ hFi Isym)
  have hMul : MulOK Isym tbl (NLogN.KFM.pMul E) NLogN.KFUU.MS := IL.kTableP_mulOK tab ext
  have hK : tbl (idx (Fin.natAdd _ 0)) = KR.chunkI2 (NLogN.KFM.pMul E) := by
    rw [hO]; rfl
  have hJ : tbl (idx (Fin.natAdd _ 1)) =
      JK.jKprog.code (NLogN.KFM.pMul E) (fun _ => NLogN.KFM.pMul E) := by
    rw [hO]; rfl
  have hX := hO 2
  -- the cost unit
  have hQ := HQ n hnQ src hsrc
  have hcU0 : 0 ≤ cU6 P n A := le_trans (by positivity) (T_le_cU6 P hP n A)
  have hD1 : (0 : ℝ) < D + 1 := by positivity
  have hK1 : 1 ≤ cU6 P n A / (D + 1) := by
    rw [le_div_iff₀ hD1, one_mul]
    have hdb : dP6 P n + 4 ≤ b'P6 P n := hQ.hdb
    have hb6 : b'P6 P n ^ 6 ≤ TP6 P n := hQ.hb6
    have h1 : D + 1 ≤ TP6 P n := by
      have : b'P6 P n ≤ b'P6 P n ^ 6 := Nat.le_self_pow (by norm_num) _
      omega
    have h2 : ((D + 1 : ℕ) : ℝ) ≤ TP6 P n := by exact_mod_cast h1
    push_cast at h2
    linarith [T_le_cU6 P hP n A]
  have hmono : ∀ (Cx : ℝ) (A' : ℕ), 0 ≤ Cx → A' ≤ A →
      Cx * cU6 P n A' / (D + 1) ≤ Cx * (cU6 P n A / (D + 1)) := by
    intro Cx A' hCx hA'
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right (cU6_mono P hP n hA') hD1.le) hCx
  refine AxisBody6.mono (axisBody6_of_steps (P := P) (n := n) (src := src) (D := D) (dA := dAx)
      (Isym := Isym) (C := 8 * (Cs * cU6 P n AS / (D + 1)) +
      6 * (Cp * cU6 P n AP / (D + 1)) + (9 + 6 * CF) * (CB * cU6 P n AB / (D + 1))) hX
      (by decide) (by decide) (fun k hk => ?_)) ?_
  · obtain ⟨hSC, hSJ⟩ := HP n hnP src hsrc D hD k hk E ext _ hPi Isym
    obtain ⟨hS1, hS3, hS5, hS7⟩ := HSl n hnS src hsrc D hD k hk tab E ext _ hSi Isym
    exact axSteps_at hk hMul hK hJ hFine hCF
      (ρK_regOK hdF0 (by right; decide) (by decide) (by decide))
      (ρK_regOK hdF0 (by right; decide) (by decide) (by decide))
      (fun i => ρK_ne (by left; decide) i) dAx_free dAx_ok (by decide) (by decide)
      hSC hSJ hS1 hS3 hS5 hS7 (HR n hnR src hsrc D hD k hk) (HT n hnT src hsrc D hD k hk)
      (HC n hnC src hsrc D hD k hk) (HV n hnV src hsrc D hD k hk) (HB n hnB src hsrc D hD k hk)
  · have e1 := hmono Cs AS hCs (by omega)
    have e2 := hmono Cp AP hCp (by omega)
    have e3 := hmono CB AB hCB (by omega)
    have h6 : 0 ≤ 9 + 6 * CF := by positivity
    have e3' := mul_le_mul_of_nonneg_left e3 h6
    have eK : C₀ * cU6 P n A / (D + 1) = C₀ * (cU6 P n A / (D + 1)) := mul_div_assoc _ _ _
    rw [eK, hC₀]
    set K := cU6 P n A / (D + 1)
    have : (8 * Cs + 6 * Cp + (9 + 6 * CF) * CB + 2) * K =
        8 * (Cs * K) + 6 * (Cp * K) + (9 + 6 * CF) * (CB * K) + 2 * K := by ring
    rw [this]
    linarith

end J6Seg.Ax

end

