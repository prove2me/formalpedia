section
-- Source module: NLogN.HNumPi
/-!
# `piBits` and `log2Bits` as register programs

Input `n` on register `3`; the result is pushed on register `4`.
Uses registers `0, 1, 2, 40 … 47`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

/-- `M = 2n + 9` on registers `0` and `1`. -/
def mE : Ex HS := .add (.add (.reg 3) (.reg 3)) (.lit 9)

/-- Final rounding: `(c₁·A + c₂·B + 2^{n+8}) / 2^{n+9}` with `A`, `B` on registers `46`, `47`. -/
def roundE (c₁ c₂ : ℤ) : Ex HS :=
  Ex.fdiv (.add (.add (.mul (.lit c₁) (.reg 46)) (.mul (.lit c₂) (.reg 47)))
    (.pow2 (.add (.reg 3) (.lit 8)))) (.pow2 (.add (.reg 3) (.lit 9)))

/-- Two arctan-type series at `M = 2n+9`, combined as `(c₁·A + c₂·B + 2^{n+8}) / 2^{n+9}`. -/
def twoAtanP (x₁ x₂ : ℕ) (σ : ℤ) (c₁ c₂ : ℤ) : RS :=
  NLogN.RS.seqL [push 0 NLogN.mE, push 1 NLogN.mE,
    atanP x₁ σ, push 46 (.reg 2), pop 2,
    atanP x₂ σ, push 47 (.reg 2), pop 2,
    pop 1, pop 0, push 4 (roundE c₁ c₂), pop 47, pop 46]

def piP : RS := twoAtanP 5 239 (-1) 16 (-4)

/-- `log2Bits` uses one series; the second (with `x = 3`, coefficient `0`) is harmless. -/
def log2P : RS := twoAtanP 3 3 1 2 0

end NLogN

namespace NLogN

open IntMul RS

/-- Cost bound of `piP` / `log2P`. -/
def piCost (x₁ x₂ n : ℕ) : ℕ :=
  10 ^ 11 * (2 * n + 11) * (atanB x₁ (2 * n + 9) (2 * n + 9) + atanB x₂ (2 * n + 9) (2 * n + 9) + 6) ^ 2

end NLogN

end

section
-- Source module: NLogN.HNumExp
/-!
# `expBits` as a register program

Inputs `n` on register `5`, `x` on `6`, `y` on `7`; the two components of `expBits n x y` are
pushed on registers `8` and `9`.  Scratch registers `30 … 39`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-! ## Arithmetic facts -/

/-! ## The program -/

/-- `x · 2^(n+9)` -/
def eXE : Ex HS := .mul (.reg 6) (.pow2 (.add (.reg 5) (.lit 9)))
/-- `y · 2^(n+9)` -/
def eYE : Ex HS := .mul (.reg 7) (.pow2 (.add (.reg 5) (.lit 9)))
/-- `2^(2n+9)` -/
def ePE : Ex HS := .pow2 (.add (.add (.reg 5) (.reg 5)) (.lit 9))
/-- `2n+13` -/
def eKE : Ex HS := .add (.add (.reg 5) (.reg 5)) (.lit 13)
/-- `(j+1) 2^N` -/
def dvE : Ex HS := .mul (.add (.reg 33) (.lit 1)) (.reg 32)
def nu1E : Ex HS := .add (.mul (.reg 34) (.reg 30)) (.neg (.mul (.reg 35) (.reg 31)))
def nu2E : Ex HS := .add (.mul (.reg 34) (.reg 31)) (.mul (.reg 35) (.reg 30))
/-- rounding `(S + 2^(n+8)) / 2^(n+9)` of register `i` -/
def rndE (i : Fin HS) : Ex HS :=
  Ex.fdiv (.add (.reg i) (.pow2 (.add (.reg 5) (.lit 8)))) (.pow2 (.add (.reg 5) (.lit 9)))

def expBody : RS :=
  NLogN.RS.seqL [asg 36 (.add (.reg 36) (.reg 34)), asg 37 (.add (.reg 37) (.reg 35)),
    asg 38 (Ex.fdiv nu1E dvE), asg 35 (Ex.fdiv nu2E dvE), asg 34 (.reg 38),
    asg 33 (.add (.reg 33) (.lit 1))]

def expPre : RS :=
  NLogN.RS.seqL [push 30 eXE, push 31 eYE, push 32 ePE, push 33 (.lit 0), push 34 (.reg 32),
    push 35 (.lit 0), push 36 (.lit 0), push 37 (.lit 0), push 38 (.reg 32)]

def expPost : RS :=
  NLogN.RS.seqL [push 8 (NLogN.rndE 36), push 9 (NLogN.rndE 37), pop 38, pop 37, pop 36, pop 35, pop 34, pop 33,
    pop 32, pop 31, pop 30]

def expP : RS := NLogN.RS.seq expPre (NLogN.RS.seq (NLogN.RS.rep 39 eKE expBody) expPost)

/-- The loop invariant, relative to the initial state `s0`. -/
def expInv (N K : ℕ) (X Y : ℤ) (s0 : IState HS) (k : ℕ) (t : IState HS) : Prop :=
  t.G 30 = .int X :: s0.G 30 ∧
  t.G 31 = .int Y :: s0.G 31 ∧
  t.G 32 = .int (2 ^ N) :: s0.G 32 ∧
  t.G 33 = .int k :: s0.G 33 ∧
  t.G 34 = .int (expTerm N X Y k).1 :: s0.G 34 ∧
  t.G 35 = .int (expTerm N X Y k).2 :: s0.G 35 ∧
  t.G 36 = .int (expApprox N k X Y).1 :: s0.G 36 ∧
  t.G 37 = .int (expApprox N k X Y).2 :: s0.G 37 ∧
  t.G 38 = .int (expTerm N X Y k).1 :: s0.G 38 ∧
  t.G 39 = .int ((K : ℤ) - k) :: s0.G 39 ∧
  ∀ j : Fin HS, j.val < 30 ∨ 39 < j.val → t.G j = s0.G j

/-! ## Cost -/

/-- Bit-size parameter: every value the program handles has fewer than `expB n m` bits. -/
def expB (n m : ℕ) : ℕ := (2 * n + 13) * (m + n + 11) + 2 * n + 10

/-- The cost bound of `expP`, polynomial in `n` and the bit sizes of `x`, `y`. -/
def expCost (n zx zy : ℕ) : ℕ := 10 ^ 12 * (n + zx + zy + 20) ^ 5

end NLogN

end

