  | x :: rv, suf, hrv, hsuf => by
    obtain ⟨a, c⟩ := x
    have ha : 1 ≤ a := hrv (a, c) List.mem_cons_self
    have IH := stCostF_le b rv ((a, c) :: suf) (fun p hp => hrv p (List.mem_cons_of_mem _ hp))
