theorem NLogN.KFM.chirpTabPU_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {Δ φ : ℕ}
    (hΦ : ∀ x y : ℤ, zsz x ≤ Δ + 2 → zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (T d : ℕ) (s t : Fin d → ℕ)
    (hst : ∀ i, s i ≤ t i) (ht : ∀ i, 0 < t i) (hT : ∀ i, t i ≤ T)
    (hu : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1)
    (st : IState HS) (LR L1 LXa RD : List Item) (hR : st.G pR = .int (2 ^ Δ) :: LR)
    (hD : st.G rDl = .int (Δ : ℤ) :: L1) (hX : st.G aX = .int (d : ℤ) :: LXa)
    (hdS : st.G NLogN.KFM.dS = ints (descT s t) ++ RD) :
    IRuns I iprog (chirpTabPU pM) st
      ((st.upd NLogN.KFM.dS RD).upd pW (ints (gflat (chirpArr Δ d s t)) ++ st.G pW))
      (cChirpTabU Δ φ (axL s t) (∏ i, t i)) := by sorry
