-- title:
--   Partitioned subprobability measures and their pseudometric
-- statement:
--   A partitioned subprobability measure is a nonnegative summable function $f$ on copies of $\mathbb Z^d$ whose total mass is at most one. The mass $\|f\|$ is its sum. Finite partial isometries compare nearby sites within copies while allowing distant pieces to translate or move to other copies. The discrepancy $d_\varphi(f,g)$ combines twice the absolute mismatch on matched sites, the squared mass left unmatched on both sides, and the degree penalty $2^{-\deg\varphi}$. The distance $d(f,g)$ is the infimum of this discrepancy over finite partial isometries.
--
--   $$
--   d(f,g)=\inf_\varphi\left(2\sum_{u\in A}|f(u)-g(\varphi(u))|+\sum_{u\notin A}f(u)^2+\sum_{u\notin\varphi(A)}g(u)^2+2^{-\deg\varphi}\right).
--   $$
--
--   This is the compact state space used to study the endpoint distribution. Its Borel structure supports probability laws of updated states.
--
--   **Formalization Note** A structure represents $S$ and the topology is generated by $d$-balls. Borel sets identify points at pseudodistance zero, representing the quotient $\mathcal S$. The index uses $\mathbb N$ in place of the paper's positive integers; the extra copy is immaterial. The degree penalty is encoded by an infimum over admissible degrees.
-- source:
--   Bates and Chatterjee, The endpoint distribution of directed polymers, arXiv:1612.03443v5, pp. 18–22, §2.1, (2.1)–(2.4)

import Definitions.Def_PolymerEndpoint_Atomic_Model

open MeasureTheory ProbabilityTheory Filter Finset
open scoped BigOperators ENNReal Topology

namespace PolymerEndpoint.Atomic

structure PSM (d : ℕ) where
  toFun : Cell d → ℝ
  nonneg : ∀ u, 0 ≤ toFun u
  summable : Summable toFun
  mass_le : ∑' u, toFun u ≤ 1

noncomputable def mass {d : ℕ} (f : PSM d) : ℝ := ∑' u, f.toFun u

instance {d : ℕ} : Zero (PSM d) where
  zero := ⟨fun _ => 0, by simp, by simp, by simp⟩

noncomputable def toPSM {d : ℕ} (g : Cell d → ℝ) : PSM d := by
  classical
  exact if h : (∀ u, 0 ≤ g u) ∧ Summable g ∧ ∑' u, g u ≤ 1 then
    ⟨g, h.1, h.2.1, h.2.2⟩ else 0

noncomputable def one {d : ℕ} : PSM d :=
  toPSM (fun u => if u = ((0 : ℕ), (0 : Fin d → ℤ)) then 1 else 0)

noncomputable def ofPMF {d : ℕ} (p : (Fin d → ℤ) → ℝ) : PSM d :=
  toPSM (fun u => if u.1 = 0 then p u.2 else 0)

def diffOpt {d : ℕ} (u v : Cell d) : Option (Fin d → ℤ) :=
  if u.1 = v.1 then some (u.2 - v.2) else none

def closeLt {d : ℕ} (m : ℕ) (u v : Cell d) : Prop :=
  u.1 = v.1 ∧ l1 (u.2 - v.2) < m

def IsIsoDeg {d : ℕ} (A : Finset (Cell d)) (φ : Cell d → Cell d) (m : ℕ) : Prop :=
  1 ≤ m ∧ ∀ u ∈ A, ∀ v ∈ A,
    (closeLt m u v ∨ closeLt m (φ u) (φ v)) →
      diffOpt (φ u) (φ v) = diffOpt u v

noncomputable def dPhi {d : ℕ} (f g : PSM d) (A : Finset (Cell d))
    (φ : Cell d → Cell d) (m : ℕ) : ℝ := by
  classical
  exact 2 * ∑ u ∈ A, |f.toFun u - g.toFun (φ u)| +
    (∑' u, if u ∈ A then 0 else f.toFun u ^ 2) +
    (∑' u, if u ∈ A.image φ then 0 else g.toFun u ^ 2) +
    (1 / 2 : ℝ) ^ m

noncomputable def dist {d : ℕ} (f g : PSM d) : ℝ :=
  ⨅ p : {p : Finset (Cell d) × (Cell d → Cell d) × ℕ //
      IsIsoDeg p.1 p.2.1 p.2.2},
    dPhi f g p.1.1 p.1.2.1 p.1.2.2

instance (d : ℕ) : TopologicalSpace (PSM d) :=
  TopologicalSpace.generateFrom {U | ∃ f : PSM d, ∃ r : ℝ, U = {g | dist f g < r}}

instance (d : ℕ) : MeasurableSpace (PSM d) := borel _
instance (d : ℕ) : BorelSpace (PSM d) := ⟨rfl⟩

end PolymerEndpoint.Atomic


