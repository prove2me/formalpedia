variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (n : ℕ)

theorem comp_str_of_comp_ι {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (x : T ⟶ L.schemeKer n) (hx : x ≫ ι L n = P.1) : x ≫ L.schemeKerStr n = t := by
  rw [← ι_comp_f, ← Category.assoc, hx, P.2]

theorem lift_unique {T : Scheme.{u}} (x y : T ⟶ L.schemeKer n) (h : x ≫ ι L n = y ≫ ι L n) : x = y :=
  hom_ext L n x y h (by rw [← ι_comp_f, ← Category.assoc, h, Category.assoc])

theorem comp_oneK_ι {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    (t ≫ oneK L n) ≫ ι L n = (L.one t).1 := by
  rw [Category.assoc, oneK_ι, one_coe L t]

theorem comp_invK_ι (hc : L.IsCommutative) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    (x : T ⟶ L.schemeKer n) (hx : x ≫ L.schemeKerStr n = t) :
    (x ≫ invK L n hc) ≫ ι L n = (L.inv t (toPt L n x hx)).1 := by
  rw [Category.assoc, invK_ι]
  have h1 := congrArg Subtype.val
    (inv_natural L (L.schemeKerStr n) t x hx (toPt L n (𝟙 _) (Category.id_comp _)))
  rw [schemeHomOverComp_coe] at h1
  rw [h1]
  apply inv_coe_congr L rfl
  rw [schemeHomOverComp_coe, toPt_coe, toPt_coe, Category.id_comp]

theorem comp_mulK_ι (hc : L.IsCommutative) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    (z : T ⟶ pullback (L.schemeKerStr n) (L.schemeKerStr n)) (x y : T ⟶ L.schemeKer n)
    (hzx : z ≫ pullback.fst _ _ = x) (hzy : z ≫ pullback.snd _ _ = y)
    (hx : x ≫ L.schemeKerStr n = t) (hy : y ≫ L.schemeKerStr n = t) :
    (z ≫ mulK L n hc) ≫ ι L n = (L.mul t (toPt L n x hx) (toPt L n y hy)).1 := by
  rw [Category.assoc, mulK_ι]
  have hz : z ≫ (pullback.fst (L.schemeKerStr n) (L.schemeKerStr n) ≫ L.schemeKerStr n) = t := by
    rw [← Category.assoc, hzx, hx]
  have h1 := congrArg Subtype.val
    (L.mul_natural (pullback.fst _ _ ≫ L.schemeKerStr n) t z hz
      (toPt L n (pullback.fst _ _) rfl) (toPt L n (pullback.snd _ _) pullback.condition.symm))
  rw [schemeHomOverComp_coe] at h1
  rw [h1]
  apply mul_coe_congr L rfl
  · rw [schemeHomOverComp_coe, toPt_coe, toPt_coe, ← Category.assoc, hzx]
  · rw [schemeHomOverComp_coe, toPt_coe, toPt_coe, ← Category.assoc, hzy]

theorem comp_endK_ι (a : A ⟶ A) (ha : a ≫ f = f) (hh : IsHomPt L a ha)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    (x : T ⟶ L.schemeKer n) (hx : x ≫ L.schemeKerStr n = t) :
    (x ≫ endK L n a ha hh) ≫ ι L n = (CerednikDrinfeld.QM.mapPt a ha (toPt L n x hx)).1 := by
  rw [Category.assoc, endK_ι, CerednikDrinfeld.QM.mapPt_coe, toPt_coe, Category.assoc]

end KerOps
