    have hL : NLogN.zsz (log2Bits (2 * n + 10)) ≤ 3 * (2 * n + 10) + 14 :=
      NLogN.zsz_le_of_abs (NLogN.log2Bits_lt (2 * n + 10))
    have hA : NLogN.zsz (piBits (2 * n + 10) * j / k) ≤ 3 * (2 * n + 10) + 14 + NLogN.zsz (j : ℤ) :=
      le_trans (NLogN.zsz_ediv_le' (piBits (2 * n + 10) * j) (k : ℤ) (Int.natCast_nonneg k))
        (le_trans (NLogN.zsz_mul_le (piBits (2 * n + 10)) (j : ℤ)) (by omega))
