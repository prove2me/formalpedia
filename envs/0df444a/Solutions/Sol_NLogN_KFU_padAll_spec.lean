      vol_cons, Nat.div_add_mod']
  · have hrF : ¬ i % (F' * AModel.vol B) / AModel.vol B < F := fun h => hc ((Nat.div_lt_iff_lt_mul hY).1 h)
    rw [if_neg (fun h => hrF h.2.1), if_neg hc]

