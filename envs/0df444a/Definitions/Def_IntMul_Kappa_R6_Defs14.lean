-- Source module: Solutions.R6Ifaces
/-!
# Round six: the stack interfaces of the top-level assembly (fixed statements)

This file fixes the names and statements of every stack interface that the round-six top-level
assembly `kappa_final6` (file `R6MFinal.lean`) takes as a hypothesis. Each one is a `Prop`
depending on the parameter record `P : Prm` (and, where it runs inside the machine's table, on
the Lemma 12 table `tab` of the bit network). The interfaces are

| name | piece | intended `Ncost6` row (margin) |
|---|---|---|
| `SetupNeed6` | §9.2 parameters, sources (sieve), register file | lower order (`O(V)` suffices) |
| `CrtNeed6` | `Φ` / `Φ⁻¹` with the E′ CRT reversal | `d` (`1-ε`) and `ℓ (d ln p)^τ` (`max(ε,1-ε)(1-τ)`) |
| `FineNeed6` | fine-bit exposure (Idea A) | feeds `d p^δ` (`1-ε-poly`) |
| `LineNeed6` | `A` lines (PR #5 chirped Gaussian), `B₀` lines (segmented inverse) | `d p^δ` (`1-ε-poly`) |
| `P14Need6` | the uniform Prop 14 `P14UH` (file `R6IL3Iface`, Track D2) | `ℓ d^λ'` (`ε(1-λ')`) |
| `P18IL6` | Prop 18 from `P14UH` | `ℓ d^λ'`, `d`, `ℓ + log₂ p` (`ε`), `p^δ` |

**Weakness.** Every cost bound is stated against the whole unit
`cU6 P n A = V · Ncost6 · (log lg n + 1)^A` (the assembly makes a bounded number of calls, so this
is all it needs); the docstrings name the row the construction is meant to meet. Every error
bound is `errW6 P n · 2^{-p} = 2^{⌊p/2⌋ - p}` (much larger than the frozen constants; the final
rounding has room for it since `γ = 2 d α² ≤ b'/4` and `p = 6 b'`). The interfaces are stated
only at the round-six parameters of `n` for `n ≥ n₁` (`n₁` chosen by the prover), for every
source list satisfying `SrcOK6`. The interfaces used inside the machine's table receive as
hypotheses everything the assembly has about the Lemma 12 table `tab` (`SwapNeedτ`, `RowUCP`,
`FineU6`, `P14UH`).

**Parameters** (all for `n` and `P`): digit bits `b' = b'P6`, `p = 6b'`, `L = LP6`, `T = 2^L`,
`d = dP6`, `ℓ = ℓP6`, `h = ℓ - 1`, `r = 2^ℓ`, `K = ℓ - 1`, the natural `α = αN6 = ⌊√(p/(48d))⌋`,
`γ = 2 d α²`, the number of half axes `d' = dℓ - L`; axis `j < d` has `t_j = 2^h` for `j < d'`
and `t_j = 2^{h+1}` for `j ≥ d'` (`tF6`), so `∏ t_j = T` and the last axis has length `r`.
Sources: `SrcOK6` (odd, pairwise coprime, `t_j - 2w_j < s_j ≤ t_j - w_j`, `w_j = ⌊t_j/(8d²)⌋`,
Jain's window with `η ≈ 1/(8d²) ≤ 1/(4 d L^ε)`), and `μ_j = (∏_{i<j} s_i)⁻¹ mod s_j` (`muR6`).
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFH NLogN.KFM IntMul.OpenAI.RT AModel

noncomputable section

/-! ## Run-time parameters of the machine -/

/-- The natural Gaussian parameter `α = ⌊√(p/(48d))⌋` (so `α² ≤ α2P6`). -/
def αN6 (P : Prm) (n : ℕ) : ℕ := Nat.sqrt (α2P6 P n)

/-- `h = ℓ - 1`. -/
def hN6 (P : Prm) (n : ℕ) : ℕ := ℓP6 P n - 1

/-- The number of half axes `d' = d ℓ - L`. -/
def dpN6 (P : Prm) (n : ℕ) : ℕ := dP6 P n * ℓP6 P n - LP6 P n

/-- Axis `j` is a full axis (`t_j = r`) iff `d' ≤ j`. -/
def bL6 (P : Prm) (n : ℕ) : ℕ → Bool := fun j => decide (dpN6 P n ≤ j)

/-- The padded axis lengths `t_j` (`2^h` or `2^{h+1}`). -/
def tF6 (P : Prm) (n : ℕ) (j : ℕ) : ℕ := if bL6 P n j then 2 ^ hN6 P n * 2 else 2 ^ hN6 P n

/-- The width of the source window of axis `j`: `⌊t_j / (8 d²)⌋`. -/
def wnd6 (P : Prm) (n : ℕ) (j : ℕ) : ℕ := tF6 P n j / (8 * dP6 P n ^ 2)

/-- **Admissible source lengths** for `n`: odd, pairwise coprime, in Jain's windows
`t_j - 2 w_j < s_j ≤ t_j - w_j`. -/
structure SrcOK6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) : Prop where
  odd : ∀ j < dP6 P n, Odd (s j)
  lo : ∀ j < dP6 P n, tF6 P n j - 2 * wnd6 P n j < s j
  hi : ∀ j < dP6 P n, s j ≤ tF6 P n j - wnd6 P n j
  cop : ∀ i j, i < dP6 P n → j < dP6 P n → i ≠ j → Nat.Coprime (s i) (s j)

/-- The CRT inverses `μ_j = (∏_{i<j} s_i)⁻¹ mod s_j`. -/
def muR6 (s : ℕ → ℕ) (j : ℕ) : ℕ := muInv (∏ i ∈ Finset.range j, s i) (s j)

/-- The `Φ` descriptor `[p+2, h, d, b_0..b_{d-1}, s_0..s_{d-1}, μ_0..μ_{d-1}]`. -/
def descPhi6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) : List ℤ :=
  descPhi (pP6 P n + 2) (hN6 P n) (dP6 P n) (bL6 P n) s (muR6 s)

/-- The line-map descriptor `[p, α, h, d, b_0..b_{d-1}, s_0..s_{d-1}]`. -/
def descLine6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) : List ℤ :=
  descLine (pP6 P n) (αN6 P n) (hN6 P n) (dP6 P n) (bL6 P n) s

/-- The chirp descriptor `K :: descLine6`. -/
def descChirp6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) : List ℤ := (KP6 P n : ℤ) :: descLine6 P n s

/-- **The cost unit** `V · Ncost6 · (log lg n + 1)^A`. -/
def cU6 (P : Prm) (n A : ℕ) : ℝ := VP6 P n * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A

/-- **The error allowance** `2^{⌊p/2⌋}` (in units of `2^{-p}`). -/
def errW6 (P : Prm) (n : ℕ) : ℝ := 2 ^ (pP6 P n / 2)

/-! ## The register file left by the setup -/

/-- `d` (for the descriptor copies). -/
abbrev zDd : Fin HS := 25
/-- The stored `Φ` descriptor. -/
abbrev zPh : Fin HS := 26
/-- The stored chirp descriptor. -/
abbrev zCh : Fin HS := 27
/-- The stored line-map descriptor. -/
abbrev zLn : Fin HS := 28

/-- `S = ∏_{j<d} s_j`. -/
def S6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) : ℕ := ∏ j ∈ Finset.range (dP6 P n), s j

/-- `M = ⌈n / b'⌉` digits. -/
def M6 (P : Prm) (n : ℕ) : ℕ := (n + b'P6 P n - 1) / b'P6 P n

/-- **What the machine reads after the setup**: one value on top of each register (the frozen
`KFM.BaseOK` registers with the round-six values), `d` on `zDd`, and the stored `Φ`, chirp and
line-map descriptors on `zPh`, `zCh`, `zLn` (above arbitrary contents). -/
structure BaseOK6 (P : Prm) (n : ℕ) (s : ℕ → ℕ) (t : IState HS) : Prop where
  hS : Hold t KFM.rS (S6 P n s)
  hT : Hold t KFM.rT (2 ^ LP6 P n)
  hT2 : Hold t KFM.rT2 (2 ^ (LP6 P n + 1))
  hM : Hold t KFM.rM (M6 P n)
  hP2 : Hold t KFM.rP2 (2 ^ pP6 P n)
  hG : Hold t KFM.rG (2 ^ (2 * dP6 P n * αN6 P n ^ 2))
  hE2 : Hold t KFM.rE2 (2 ^ (pP6 P n - b'P6 P n - 2))
  hB2 : Hold t KFM.rB2 (2 ^ b'P6 P n)
  hZ : Hold t KFM.rZ (2 * ((S6 P n s : ℤ) - (M6 P n : ℤ)))
  hH : Hold t KFM.rH (2 ^ (pP6 P n - 1))
  hF : Hold t KFM.rF (2 ^ (2 * b'P6 P n + 4))
  hO : Hold t KFM.rO (2 ^ (2 * n))
  hPw : Hold t KFM.rPw (pP6 P n + 2)
  hOne : Hold t KFM.rOne 1
  hD : Hold t zDd (dP6 P n)
  hPh : ∃ L, t.G zPh = ints (descPhi6 P n s) ++ L
  hCh : ∃ L, t.G zCh = ints (descChirp6 P n s) ++ L
  hLn : ∃ L, t.G zLn = ints (descLine6 P n s) ++ L

/-! ## The setup -/

/-! ## `Φ` with the E′ CRT reversal -/

/-- The body of `CrtNeed6` in one table. -/
def CrtBody6 (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eF eB : Fin (7 + E)) (dS : Fin HS) (C₀ : ℝ)
    (A n₁ : ℕ), dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ (Isym : List Sym) (n : ℕ), n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descPhi6 P n src →
    (∀ xs : List ℤ, f 0 = xs ++ l →
      xs.length = vol (KFU.shK (dP6 P n) (KFU.sP (dP6 P n) src)) → Bnd (pP6 P n + 2) xs →
      ∃ c : ℕ, IRuns Isym (IL.kTableP tab ext) (.call eF) (encK s f)
          (encK s (Function.update f 0
            (KFU.PhiD (hN6 P n) (dP6 P n) (bL6 P n) src (muR6 src) xs ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cU6 P n A) ∧
    (∀ ys : List ℤ, f 0 = ys ++ l →
      ys.length = vol (KFU.shR (dP6 P n) (KFU.tP (dP6 P n) (hN6 P n) (bL6 P n))) →
      Bnd (pP6 P n + 2) ys →
      ∃ c : ℕ, IRuns Isym (IL.kTableP tab ext) (.call eB) (encK s f)
          (encK s (Function.update f 0
            (KFU.PhiInvD (hN6 P n) (dP6 P n) (bL6 P n) src (muR6 src) ys ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cU6 P n A)

/-- **`CrtNeed6`: `Φ` and `Φ⁻¹` (§9.3) at the round-six parameters**, with the denotations of the
frozen `KFM.PhiNeed` (`KFU.PhiD` / `KFU.PhiInvD`: digits in the k-order source shape ↔ the padded
reversed box), descriptor `descPhi6` on `dS`, data on stack `0` (`Bnd (p+2)` integers), every
other managed stack empty, unmanaged part preserved.

Cost rows: the CRT axis reversal by E′ (3ℓ permuted selected-bit additions with compact
controls, `O(V ℓ (d ln p)^τ)`, row `ℓ (d ln p)^τ`, margin `max(ε,1-ε)(1-τ) = ε(1-τ)`) and the
prefix moves / padding (`O(V d)`, row `d`, margin `1-ε`). The statement allows `C₀ · cU6`. The
prover may use the bit network's Lemma 12 / Lemma 13 procedures (`SwapNeedτ`, `RowUCP`). -/
def CrtNeed6 (P : Prm) : Prop :=
  ∀ tab : Fin 1 → IStmt HS 1, IL.SwapNeedτ tab P.τ → IL2.RowUCP 576 P.τ tab → CrtBody6 P tab

