-- title:
--   Fibral flatness criterion for a tower of local rings
-- statement:
--   Let $R$, $S$, $S'$ be commutative rings in one universe, equipped with algebra maps $R \to S$, $S \to S'$ and $R \to S'$ that are compatible in the sense that $R \to S$ followed by $S \to S'$ is the map $R \to S'$; assume all three rings are local, that $R \to S$ and $S \to S'$ are local homomorphisms (each pulls the maximal ideal back into the maximal ideal), and that $S$ and $S'$ are Noetherian. Write $I := (\mathfrak m_R)S$ and $I' := (\mathfrak m_R)S'$ for the ideals generated by the images of the maximal ideal of $R$ in $S$ and in $S'$. Since the image of $I$ under $S \to S'$ generates $I'$, the quotient $S'/I'$ is canonically an $S/I$-algebra. The assertion is that if $S'$ is flat as an $R$-module and $S'/I'$ is flat as a module over $S/I$, then $S'$ is flat as an $S$-module. Noetherianity of $R$ is not assumed.
--
--   This is the ring-theoretic form of one direction of the critère de platitude par fibres for a tower of local rings: flatness over the base together with flatness on the closed fibre gives flatness over the intermediate ring. It is applied to stalks of schemes, in the verification that multiplication by $n$ on an abelian scheme is flat.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsLocalRing_flat_of_isScalarTower_of_flat_of_flat_quotient_maximalIdeal_map_univ.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u

theorem IsLocalRing.flat_of_isScalarTower_of_flat_of_flat_quotient_maximalIdeal_map_univ
    {R S S' : Type u} [CommRing R] [CommRing S] [CommRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing S']
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S S')]
    [IsNoetherianRing S] [IsNoetherianRing S'] :
    letI : Algebra (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))
        (S' ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S')) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.mp (le_of_eq
        (by rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq R S S'])))
    Module.Flat R S' →
    Module.Flat (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))
        (S' ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S')) →
    Module.Flat S S' := by sorry
