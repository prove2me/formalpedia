/-!
# B-line IL, B1 follow-up: building the control list, §2 one table entry

**Register convention of the control builder** (all below `56`, none `0`, none in `26–29`;
`lA lC lD = 34–36` are the `rptX` counters, empty in the managed state):

| stack | role |
|---|---|
| `bX = 44` | the source table `srcTab src argOf n'` (input, restored) |
| `bN' = 20`, `bN = 21` | `n'`, `n` (inputs, one value each, preserved) |
| `bSv = 25` | the consumed table entries (scratch, emptied by the restore) |
| `bCur = 30` | the input position (scratch) |
| `bT = 33` | the reversed control list being built (scratch, emptied by the transfer) |
| `bCd = 24`, `bA = 23`, `bW = 22`, `bD = 32` | scratch of one entry |
| `rC = 45`, `rNC = 38` | outputs: `flatC cs` pushed on `rC`, `|cs|` pushed on `rNC` |

Here: `loopMV` (a variable-cost `rptX` over managed states) and **`entry_runs`** (one table
entry: the commands of one output slab pushed reversed onto `bT`, the position updated, the entry
saved on `bSv`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## List level: one step -/

/-! ## Managed-state helpers -/

section ops
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- **A variable-cost `rptX` loop over managed states.** -/
theorem loopMV {X : Fin HS} (hXA : X ≠ lA) (m : ℕ) (s : IState HS) (F : ℕ → Fin HS → List ℤ)
    (hA : ∀ k, F k lA = []) (hC : ∀ k, F k lC = []) (hD : ∀ k, F k lD = []) {LM : List ℤ}
    (hM : F 0 X = (m : ℤ) :: LM) (body : IStmt HS P) (cs : ℕ → ℕ)
    (hb : ∀ k < m, ∀ s', IRuns I iprog body (encK s' (F k)) (encK s' (F (k + 1))) (cs k)) :
    IRuns I iprog (rptX X lA lC lD body) (encK s (F 0)) (encK s (F m))
      ((∑ k ∈ Finset.range m, cs k) + 3000 * (m + 1)) := by
  have H := NLogN.KFM.rptXV_runs (I := I) (iprog := iprog) (X := X) (A := lA) (C := lC) (D := lD)
    hXA (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) m (fun k => encK s (F k))
    (fun k => by simp only [encK_G, hA]) (fun k => by simp only [encK_G, hC])
    (fun k => by simp only [encK_G, hD]) body cs
    (fun k hk LA LC LD => by
      rw [cf3_encK s _ (hA k) (hC k) (hD k), cf3_encK s _ (hA (k + 1)) (hC (k + 1)) (hD (k + 1))]
      exact hb k hk _)
    (ints LM ++ s.G X) (by simp [hM, ints])
  refine H.mono ?_
  rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul]
  have h1 := NLogN.KFT.cRpt_le m
  have h2 := dupCost_le (zsz (m : ℤ))
  have h3 := NLogN.zsz_natCast_le_self' m
  nlinarith

end ops

/-! ## The managed state of the builder -/

/-! ## One entry -/

end J6Seg.Slab

end

