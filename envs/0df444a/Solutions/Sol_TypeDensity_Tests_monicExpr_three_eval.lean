theorem solution (q : ℚ) (hq : 1 < q) (σ : TypeDensity.FactorType) :
    (TypeDensity.monicExpr 3 σ).eval q =
      (if σ = {(3,1)} then (q ^ 2 + 1) / (q ^ 4 + q ^ 3 + q ^ 2 + q + 1) else 0) +
      (if σ = {(1,3)} then q ^ 3 * (q + 1) / (3 * (q ^ 4 + q ^ 3 + q ^ 2 + q + 1)) else 0) +
      (if σ = {(1,1), (2,1)} then
        q * (q ^ 3 + q + 1) / ((q + 1) * (q ^ 4 + q ^ 3 + q ^ 2 + q + 1)) else 0) +
      (if σ = {(1,1), (1,2)} then
        q ^ 3 * (q ^ 2 + q + 1) / (2 * (q + 1) * (q ^ 4 + q ^ 3 + q ^ 2 + q + 1)) else 0) +
      (if σ = {(1,1), (1,1), (1,1)} then
        q ^ 3 * (q ^ 2 - q + 1) / (6 * (q + 1) * (q ^ 4 + q ^ 3 + q ^ 2 + q + 1)) else 0) := by
  obtain ⟨d1, d2, d3, d4, d5⟩ := TypeDensity.Tests.divisorCount_m3 q
  rw [TypeDensity.monicExpr, TypeDensity.Tests.coeff_globalLaw, TypeDensity.Tests.residuePatterns_three]
  repeat rw [Finset.sum_insert (by decide)]
  rw [Finset.sum_singleton, TypeDensity.Tests.coeff_m3Inert, TypeDensity.Tests.coeff_m3Quadratic, TypeDensity.Tests.coeff_m3Tangent q hq, TypeDensity.Tests.coeff_m3Split,
    TypeDensity.Tests.coeff_otherChildren _ [(1, .single 1 3)] (by decide)]
  simp only [TypeDensity.Tests.childProd, List.map_cons, List.map_nil, TypeDensity.Tests.lawProd_cons, TypeDensity.Tests.lawProd_nil, TypeDensity.Tests.coeff_mul_lawOne,
    TypeDensity.Tests.coeff_descend_one, TypeDensity.Tests.single_three_law q hq, Bool.false_eq_true, if_false]
  simp [d1, d2, d3, d4, d5, TypeDensity.Expr.eval, TypeDensity.Tests.eval_pow, Multiset.insert_eq_cons, TypeDensity.Tests.ite_eq_mul_indicator]
  have : q ≠ 0 := by positivity
  have : q + 1 ≠ 0 := by positivity
  have : q ^ 4 + q ^ 3 + q ^ 2 + q + 1 ≠ 0 := by positivity
  field_simp
  ring
