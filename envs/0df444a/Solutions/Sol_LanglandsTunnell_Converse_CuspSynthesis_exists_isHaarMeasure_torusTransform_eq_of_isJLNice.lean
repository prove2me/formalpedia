variable {K : Type} [Field K]

private theorem t0105 (w : InfinitePlace K) (s t : ℝ) : expAt w (s + t) = expAt w s * expAt w t := by
  unfold expAt
  split_ifs with hw
  · rw [Real.exp_add, map_mul]
  · rw [Complex.ofReal_add, Complex.exp_add, map_mul]

private theorem t0106 (w : InfinitePlace K) : expAt w 0 = 1 := by
  unfold expAt
  split_ifs with hw
  · rw [Real.exp_zero]
    exact (ringEquivRealOfIsReal hw).symm.toRingHom.map_one
  · rw [Complex.ofReal_zero, Complex.exp_zero]
    exact (ringEquivComplexOfIsComplex (not_isReal_iff_isComplex.mp hw)).symm.toRingHom.map_one

private theorem t0107 (w : InfinitePlace K) : Continuous (expAt w) := by
  unfold expAt
  split_ifs with hw
  · exact (isometryEquivRealOfIsReal hw).symm.continuous.comp Real.continuous_exp
  · exact (isometryEquivComplexOfIsComplex (not_isReal_iff_isComplex.mp hw)).symm.continuous.comp
      (Complex.continuous_exp.comp Complex.continuous_ofReal)

private theorem t0108 (w : InfinitePlace K) (s : ℝ) : (expUnitAt w s : w.Completion) = expAt w s := rfl

private theorem t0109 (w : InfinitePlace K) (s t : ℝ) :
    expUnitAt w (s + t) = expUnitAt w s * expUnitAt w t := by
  apply Units.ext
  show expAt w (s + t) = expAt w s * expAt w t
  exact t0105 w s t

private theorem t0110 (w : InfinitePlace K) : expUnitAt w 0 = 1 := by
  apply Units.ext
  show expAt w 0 = 1
  exact t0106 w

private theorem t0111 (w : InfinitePlace K) (s : ℝ) : expUnitAt w (-s) = (expUnitAt w s)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← t0109, neg_add_cancel, t0110])

private theorem t0112 (w : InfinitePlace K) : Continuous (expUnitAt w) := by
  rw [Units.continuous_iff]
  refine ⟨t0107 w, ?_⟩
  have h : (fun s => (((expUnitAt w s)⁻¹ : (w.Completion)ˣ) : w.Completion)) = fun s => expAt w (-s) := by
    funext s
    rw [← t0111, t0108]
  exact h ▸ (t0107 w).comp continuous_neg

variable [NumberField K]

private theorem t0113 (w : InfinitePlace K) :
    Continuous (archUnitHom w : (w.Completion)ˣ → (AdeleRing (𝓞 K) K)ˣ) := by
  rw [Units.continuous_iff]
  constructor
  · have h : (fun t : (w.Completion)ˣ => ((archUnitHom w t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K))
        = fun t : (w.Completion)ˣ =>
          ((Pi.mulSingle w (t : w.Completion), (1 : FiniteAdeleRing (𝓞 K) K)) : AdeleRing (𝓞 K) K) := by
      funext t
      refine Prod.ext (t0082 w t) ?_
      exact Subtype.ext (funext fun v => t0038 w t v)
    show Continuous (fun t : (w.Completion)ˣ => ((archUnitHom w t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K))
    rw [h]
    exact ((continuous_mulSingle w).comp Units.continuous_val).prodMk continuous_const
  · have h : (fun t : (w.Completion)ˣ => (((archUnitHom w t)⁻¹ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K))
        = fun t : (w.Completion)ˣ =>
          ((Pi.mulSingle w ((t⁻¹ : (w.Completion)ˣ) : w.Completion), (1 : FiniteAdeleRing (𝓞 K) K)) :
            AdeleRing (𝓞 K) K) := by
      funext t
      rw [← map_inv]
      refine Prod.ext (t0082 w t⁻¹) ?_
      exact Subtype.ext (funext fun v => t0038 w t⁻¹ v)
    rw [h]
    exact ((continuous_mulSingle w).comp (Units.continuous_val.comp continuous_inv)).prodMk continuous_const

private theorem t0114 (t : ℝ) :
    archScale (K := K) t = ∏ w : InfinitePlace K, archUnitHom w (expUnitAt w (t / Module.finrank ℚ K)) := rfl

private theorem t0115 (s t : ℝ) : archScale (K := K) (s + t) = archScale K s * archScale K t := by
  rw [t0114, t0114, t0114, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun w _ => ?_
  rw [add_div, t0109, map_mul]

private theorem t0116 : archScale (K := K) 0 = 1 := by
  rw [t0114]
  refine Finset.prod_eq_one fun w _ => ?_
  rw [zero_div, t0110, map_one]

private theorem t0117 : Continuous (archScale (K := K)) := by
  have h : archScale (K := K) = fun t => ∏ w : InfinitePlace K, archUnitHom w (expUnitAt w (t / Module.finrank ℚ K)) :=
    funext t0114
  rw [h]
  exact continuous_finsetProd _ fun w _ =>
    (t0113 w).comp ((t0112 w).comp (continuous_id.div_const _))

private theorem t0118 (t : ℝ) :
    ((archScale (K := K) t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 = 1 :=
  Subtype.ext (funext fun v => t0046 _ _ v)

private theorem t0119 (t : ℝ) (w : InfinitePlace K) :
    ((archScale (K := K) t : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w = expAt w (t / Module.finrank ℚ K) := by
  rw [archScale, t0047, if_pos (Finset.mem_univ w), t0108]

private theorem t0120 (t : ℝ) (w : InfinitePlace K) :
    archDetNorm w (diagOne (archScale K t)) = Real.exp (t / Module.finrank ℚ K) := by
  rw [t0102, t0119, norm_expAt]

private theorem t0121 (t : ℝ) :
    glFin (𝓞 K) K (diagOne (archScale K t)) ∈ finiteIntegralGL2 (𝓞 K) K := by
  rw [t0101 (t0118 t)]
  exact one_mem _

