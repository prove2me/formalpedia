theorem GlobalTheory.UpperHalfImaginaryForm.upper_basis (b : Module.Basis (Fin n) ℝ (EuclideanSpace ℂ ι)) (i j : Fin n) :
    upper b (b i) (b j) = if i < j then imForm (b i) (b j) else 0 := by sorry
