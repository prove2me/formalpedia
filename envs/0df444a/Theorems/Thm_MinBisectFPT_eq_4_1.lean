-- title:
--   Display (4.1) — $F(\beta)=\exp\sum\Psi(U)$, and the ring facts of §4.2
-- statement:
--   Under the standing assumptions of §4, with $J_t$ the ideal generated by $x$ and $z$ in $R_t$:
--
--   1. $J_t^{q+k+1}=0$.
--   2. $\log F(W)\in J_t$ and $\Psi(W)\in J_t$ for every $W\subseteq\beta$.
--   3. $\log F(W)=\sum_{U\subseteq W}\Psi(U)$ for every $W\subseteq\beta$.
--   4. For every family $\mathcal{U}$ of subsets of $\beta$ with $\mathcal{U}\supseteq\{U\subseteq\beta:\Psi(U)\ne0\}$,
--   $$F(\beta)=\exp\Bigl(\sum_{U\in\mathcal{U}}\Psi(U)\Bigr).\tag{4.1}$$
--
--   The series use $N=q+k$. The display is what lets a small family of sets replace all subsets of the bag.
--
--   Differences from the source:
--   - reading: "every family $\mathcal U\supseteq\{U\subseteq\beta:\Psi(U)\ne0\}$" → every family of subsets of $\beta$ containing that set; reason: $\Psi$ is defined on subsets of $\beta$ only
--   - encoding: $\exp$, $\log$ with any $N$ such that $f^{N+1}=0$ → `expN`, `logN` with $N=q+k$; reason: $J_t^{q+k+1}=0$ and the series do not depend on $N$ (p.10)
-- source:
--   Anand, Kipouridis, Węgrzycki, Counting over Unbreakable Decompositions, STOC 2027 submission (manuscript sha256 8db80a52…), §4.2, p.12, eq. (4.1)

import Mathlib
import Definitions.Def_MinBisectFPT_NodeCtx

open scoped Classical

namespace MinBisectFPT

/-- **Display (4.1) and the ring facts around it.** Anand, Kipouridis, Węgrzycki, STOC 2027 submission (manuscript sha256 8db80a52…), §4.2, p.12: `J_t^{q+k+1} = 0`; `log F(W)` and
`Ψ(U)` lie in `J_t`; `log F(W) = Σ_{U⊆W} Ψ(U)`; and `F(β) = exp(Σ_{U∈𝒰} Ψ(U))` for every family `𝒰` of
subsets of `β` containing `{U ⊆ β : Ψ(U) ≠ 0}`. -/
theorem eq_4_1 {n : ℕ} (ctx : NodeCtx n) :
    ctx.J ctx.q ^ (ctx.q + ctx.k + 1) = ⊥ ∧
    (∀ W, W ⊆ ctx.β → ctx.logF W ∈ ctx.J ctx.q) ∧
    (∀ U, U ⊆ ctx.β → ctx.Psi U ∈ ctx.J ctx.q) ∧
    (∀ W, W ⊆ ctx.β → ctx.logF W = ∑ U ∈ W.powerset, ctx.Psi U) ∧
    ∀ 𝒰 : Finset (Finset (Fin n)), (∀ U ∈ 𝒰, U ⊆ ctx.β) →
      (∀ U, U ⊆ ctx.β → ctx.Psi U ≠ 0 → U ∈ 𝒰) →
        ctx.F ctx.q ctx.β = expN (ctx.q + ctx.k) (∑ U ∈ 𝒰, ctx.Psi U) := by sorry

end MinBisectFPT
