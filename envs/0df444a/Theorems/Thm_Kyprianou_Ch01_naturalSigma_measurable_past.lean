-- title:
--   Past process evaluations are measurable in the Chapter 1 natural filtration
-- statement:
--   For every observed time u no later than s, the value X(u) is measurable with respect to the natural sigma-algebra generated by the process through time s. This is the basic adaptedness property needed to express the compensated Lévy exponential as a past-measurable factor times an independent increment.
-- source:
--   Kyprianou (2006), Chapter 1, natural filtration and Lévy exponential martingale; equivalent to the underlying raw generated filtration PerfCorrMSQ.natFiltr.

import Mathlib
import Definitions.Def_Kyprianou_Ch01_McKeanBrownianStopping
import Definitions.Def_PerfCorrMSQ_NaturalFiltration
open MeasureTheory ProbabilityTheory Kyprianou.Ch01
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch01.naturalSigma_measurable_past
    {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ) (u s : ℝ≥0) (hus : u ≤ s) :
    @Measurable Ω ℝ (naturalSigma X s) inferInstance (X u) := by sorry
