theorem GlobalTheory.TorusDefect.univ_add (φ : AddMonoidAlgebra A Y →ₐ[A] C) (u v : X →+ Y) :
    spMap (φ.comp (mapDomainAlgHom A A (u + v))) ≫ univ A X =
      spMap (φ.comp (mapDomainAlgHom A A u)) ≫ univ A X *
        spMap (φ.comp (mapDomainAlgHom A A v)) ≫ univ A X := by sorry
