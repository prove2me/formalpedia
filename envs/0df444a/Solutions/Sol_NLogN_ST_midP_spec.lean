    (hc : ∀ j : ℕ, c.eval (s.upd m (.int j :: s.G m)) < 0 ↔ μ ≤ j) :
    RepStates C n (srchBody m c) (s.upd m (.int 0 :: s.G m))
      (fun k => s.upd m (.int (min k μ : ℕ) :: s.G m)) where
  nonneg := by rw [hne]; omega
  hw := by simp [srchBody, RS.writes]; exact fun h => hmC h.symm
  h0 := by simp
  hG := fun k => by simp only [IState.upd_G, if_neg (Ne.symm hmC)]
