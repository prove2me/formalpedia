theorem NG.dl : 2 ^ 17 * IntMul.OpenAI.R154.dP n ^ 4 ≤ ℓP n := by
  have h1 := h.d5
  have h2 := h.bl
  have hd : 0 < IntMul.OpenAI.R154.dP n := by have := h.d4; omega
  have e : 2 ^ 18 * IntMul.OpenAI.R154.dP n ^ 5 = IntMul.OpenAI.R154.dP n * (2 * (2 ^ 17 * IntMul.OpenAI.R154.dP n ^ 4)) := by ring
  have h3 : IntMul.OpenAI.R154.dP n * (2 * (2 ^ 17 * IntMul.OpenAI.R154.dP n ^ 4)) ≤ IntMul.OpenAI.R154.dP n * (2 * ℓP n) := by
    rw [← e]; calc 2 ^ 18 * IntMul.OpenAI.R154.dP n ^ 5 ≤ bP n := h1
      _ ≤ 2 * IntMul.OpenAI.R154.dP n * ℓP n := h2
      _ = IntMul.OpenAI.R154.dP n * (2 * ℓP n) := by ring
  have := Nat.le_of_mul_le_mul_left h3 hd
  omega

