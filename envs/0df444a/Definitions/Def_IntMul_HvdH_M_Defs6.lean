-- Source module: NLogN.HGl4
/-!
# Gaussian list primitives, part 4: scaling, `tdiv`, rounding, copying

* `scaleP cN`: `gD : ints u ++ R ↦ gints (u.map (a ↦ (a·2^k, 0))) ++ R` (`gPS = 2^k`).
* `tdivP cN`: `gD : gints W ++ R ↦ gints (W.map (z ↦ (z₁ tdiv 2^k, z₂ tdiv 2^k))) ++ R`
  (`gPT = 2^k`).
* `roundP cN`: `gD : gints Y ++ R ↦ ints (Y.map rnd) ++ R` with
  `rnd z = (S²·z₁·2^(c+1) + 2^p) / 2^(p+1)` (floor division; `gPQ = S²`, `gPC = 2^(c+1)`,
  `gPP = 2^p`, `gPR = 2^(p+1)`); one multiplication call per element.
* `copyP cN`: `gCH : gints A ++ R ↦ gints A ++ R` and `gZA : X ↦ gints A ++ X`.

Floor division and `tdiv` by powers of two use only `quo`/`rem`/`sel` (split-based) expressions.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.GL

open IntMul NLogN

abbrev gCH : Fin HS := 28

/-! ## Restoring the order of a reversed output -/

/-! ## Scaling -/

def scaleBody : RM := RM.seqL [.rs (.push gZB (.shl (.reg gD) (.reg gPS))), .rs (.pop gD),
  .rs (.push gZB (.lit 0))]

def scaleF (k : ℕ) (a : ℤ) : ℤ × ℤ := (a * 2 ^ k, 0)

def scaleP (cN : Fin HS) : RM :=
  .seq (.rep gC1 (.reg cN) scaleBody) (.rs (mvList gZB gD gCV (cnt2 cN)))

/-! ## `tdiv` by a power of two -/

def tdivBody : RM := RM.seqL [.rs (.push gR1 (.reg gD)), .rs (.pop gD),
  .rs (.push gZB (.quo (.reg gR1) (.reg gPT))), .rs (.push gZB (.quo (.reg gD) (.reg gPT))),
  .rs (.pop gD), .rs (.pop gR1)]

def tdivF (k : ℕ) (z : ℤ × ℤ) : ℤ × ℤ := (z.1.tdiv (2 ^ k), z.2.tdiv (2 ^ k))

def tdivP (cN : Fin HS) : RM :=
  .seq (.rep gC1 (.reg cN) tdivBody) (.rs (mvList gZB gD gCV (cnt2 cN)))

/-! ## Rounding -/

def rndX : Ex HS := .add (.shl (.reg gR1) (.reg gPC)) (.reg gPP)
def rndE : Ex HS := .add (.quo rndX (.reg gPR)) (.sel (.rem rndX (.reg gPR)) (.lit (-1)) (.lit 0))

def roundBody : RM := RM.seqL [.mul gR1 gD gPQ, .rs (.pop gD), .rs (.pop gD),
  .rs (.push gZB NLogN.GL.rndE), .rs (.pop gR1)]

/-- The rounding of one entry: `(S2·z₁·2^(c+1) + 2^p) / 2^(p+1)`. -/
def rndF (S2 : ℤ) (c p : ℕ) (z : ℤ × ℤ) : ℤ := (S2 * z.1 * 2 ^ (c + 1) + 2 ^ p) / 2 ^ (p + 1)

def roundP (cN : Fin HS) : RM :=
  .seq (.rep gC1 (.reg cN) NLogN.GL.roundBody) (.rs (mvList gZB gD gCV (.reg cN)))

/-! ## Copying a Gaussian list (keeping the original) -/

def copyBody : RM := RM.seqL [.rs (.push gCH (.reg gZT)), .rs (.push gZA (.reg gZT)),
  .rs (.pop gZT)]

def copyP (cN : Fin HS) : RM :=
  .seq (.rs (mvList gCH gZT gCV (cnt2 cN))) (.rep gC1 (cnt2 cN) copyBody)

end NLogN.GL

end

section
-- Source module: NLogN.HGl5
/-!
# The `tensorGo` combinator, part 1: list lemmas and abstract programs

* `chunkL` / `transposeL` facts (lengths, flattening, membership).
* `LProg M Ctx Pre f C`: an abstract RM program that consumes a Gaussian list `x` (with
  `Pre x`) from its input stack `I` and pushes `gints (f x)` on its output stack `O`, all other
  stacks unchanged, with `ok` and cost `≤ C`, whenever `Ctx` holds.
* `Stab Ctx W`: `Ctx` only depends on stacks outside `W` (and `ip`, `out`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN.GL

open IntMul NLogN IntMul.HvdH.Ref

/-! ## List lemmas -/

/-! ## Abstract programs -/

/-- `Ctx` is insensitive to the stacks in `W` (and only depends on stacks). -/
def Stab (Ctx : IState HS → Prop) (W : List (Fin HS)) : Prop :=
  ∀ s t : IState HS, Ctx s → (∀ j, j ∉ W → t.G j = s.G j) → Ctx t

/-- An abstract list program: `I : gints x ++ R ↦ R`, `O : old ↦ gints (f x) ++ old`. -/
structure LProg (M : MulSpec) (Ctx : IState HS → Prop) (Pre : List (ℤ × ℤ) → Prop)
    (f : List (ℤ × ℤ) → List (ℤ × ℤ)) (C : ℕ) where
  p : RM
  I : Fin HS
  O : Fin HS
  hIO : I ≠ O
  hI : I.val < 55
  hO : O.val < 55
  run : ∀ (s : IState HS) (x : List (ℤ × ℤ)) (R : List Item), Ctx s → Pre x →
    s.G I = gints x ++ R → p.run s = (s.upd I R).upd O (gints (f x) ++ s.G O)
  ok : ∀ (s : IState HS) (x : List (ℤ × ℤ)) (R : List Item), Ctx s → Pre x →
    s.G I = gints x ++ R → p.ok M s
  cost : ∀ (s : IState HS) (x : List (ℤ × ℤ)) (R : List Item), Ctx s → Pre x →
    s.G I = gints x ++ R → p.cost M s ≤ C

/-- An abstract two-input list program (the shape of `fermatW`):
`I1 : gints x ++ R1 ↦ R1`, `I2 : gints y ++ R2 ↦ R2`, `O : old ↦ gints (f x y) ++ old`. -/
structure LProg2 (M : MulSpec) (Ctx : IState HS → Prop)
    (Pre : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop)
    (f : List (ℤ × ℤ) → List (ℤ × ℤ) → List (ℤ × ℤ)) (C : ℕ) where
  p : RM
  I1 : Fin HS
  I2 : Fin HS
  O : Fin HS
  hd : [I1, I2, O].Nodup
  hI1 : I1.val < 55
  hI2 : I2.val < 55
  hO : O.val < 55
  run : ∀ (s : IState HS) (x y : List (ℤ × ℤ)) (R1 R2 : List Item), Ctx s → Pre x y →
    s.G I1 = gints x ++ R1 → s.G I2 = gints y ++ R2 →
    p.run s = ((s.upd I1 R1).upd I2 R2).upd O (gints (f x y) ++ s.G O)
  ok : ∀ (s : IState HS) (x y : List (ℤ × ℤ)) (R1 R2 : List Item), Ctx s → Pre x y →
    s.G I1 = gints x ++ R1 → s.G I2 = gints y ++ R2 → p.ok M s
  cost : ∀ (s : IState HS) (x y : List (ℤ × ℤ)) (R1 R2 : List Item), Ctx s → Pre x y →
    s.G I1 = gints x ++ R1 → s.G I2 = gints y ++ R2 → p.cost M s ≤ C

/-! ## General count expressions -/

end NLogN.GL

end

