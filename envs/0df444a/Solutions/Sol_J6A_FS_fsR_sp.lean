/-!
# A lines, IL side 7: register-file helpers and the parameter block

On the register file `RF v c` of `J6SegILPreJ*` (`Rn` runs):

* `Rn.asgR`, `Rn.pushR`: assignments / pushes of expressions reading only registers of `rg`;
* `Rn.callX`: a call of a number program with inputs on `16, 17, 18, 27` and result on `19`
  (`callC` of `J6SegILPre3`), and `Rn.enX` / `Rn.epX`: `v d := expNeg n k j` /
  `expPos n k j σ`;
* **`parA`**: from the axis descriptor `[k, pre, post, s, t, p, α, d]` on `dA = 31`, the
  registers `1 … 12` become `pre, post, s, t, p, α, m = sWidth p α, H = 2^⌊log₂ m⌋,
  W = H + m + 3, M = t / 16H, win = 8H, f = ⌊log₂ m⌋ + 3` (**`Rn.parA`**).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.PA

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH

/-! ## Expressions on `rg` -/

theorem onRg_mem {e : Ex HS} (h : OnRg e) {j : Fin HS} (hj : j ∈ e.regs) : j ∈ rg := by
  have := List.all_eq_true.1 h j hj
  simpa using this

section rgx
variable {v : Vr} {c : Cs} {W : ℕ}

theorem Rd_onRg {e : Ex HS} (h : OnRg e) : Rd c e := fun j hj => Or.inl (onRg_mem h hj)

theorem clean_onRg {e : Ex HS} (h : OnRg e) : e.Clean :=
  clean_of_regs (fun j hj => rg_lt (onRg_mem h hj))

theorem RB_onRg {e : Ex HS} (h : OnRg e) (hv : BV W v) : RB W v c e :=
  RB_of hv (fun j hj hn => absurd (onRg_mem h hj) hn)

/-- Push of an expression on registers. -/
theorem Rn.pushR {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (he : OnRg e)
    (ho : okR v c e) (ht : Tame (2 ^ W) e) (hv : BV W v) :
    Rn (.push i e) v c (· = v) (Function.update c i (ev v c e :: c i)) (J6Seg.PJ.cT e W) :=
  Rn.push hi hi5 (Rd_onRg he) (clean_onRg he) ho ht (RB_onRg he hv)

theorem okR_regR {j : Fin HS} (h : j ∈ rg) : okR v c (.reg j) := okR_reg (Or.inl h)

theorem okR_plain : ∀ e : Ex HS, Plain e = true → okR v c e
  | .reg j, h => okR_regR (by simpa [Plain] using h)
  | .lit _, _ => trivial
  | .add a b, h => by
    simp only [Plain, Bool.and_eq_true] at h; exact ⟨okR_plain a h.1, okR_plain b h.2⟩
  | .mul a b, h => by
    simp only [Plain, Bool.and_eq_true] at h; exact ⟨okR_plain a h.1, okR_plain b h.2⟩
  | .neg a, h => by simp only [Plain] at h; exact okR_plain a h
  | .sel a x y, h => by
    simp only [Plain, Bool.and_eq_true] at h
    exact okR_sel (okR_plain a h.1.1) (okR_plain x h.1.2) (okR_plain y h.2)
  | .shl _ _, h | .quo _ _, h | .rem _ _, h | .pow2 _, h | .ndiv _ _, h | .nmod _ _, h => by
    simp [Plain] at h

end rgx

/-! ## Calls of the number programs -/

end J6A.PA

