-- Source module: Solutions.KFZDesc
/-!
# KFZ Desc: reading the chirp descriptor (register code)

The chirp descriptor on `cS` is `[K, p, α, h, d, b_0..b_{d−1}, s_0..s_{d−1}]` (`h = ℓ − 1`,
`t_i = 2^{h + b_i}`). **`setupP`** (one register program, leaf registers `4, 8–13`) reads it,
leaves `K, p, h, d, Σ b_i` on the registers `rgK, rgP, rgH, rgD, rgS` (scratch stacks
`55, 50, 51, 53, 54`), builds the chirp-table descriptor `descA 1 L ++ [2 ∏ t_i]` (`KFMU2.descT`)
on stack `35`, and restores the chirp descriptor (**`setupP_sp`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul NLogN.KIL NLogN.KFM RS

theorem zszB {v : ℤ} {k B : ℕ} (h0 : 0 ≤ v) (hv : v ≤ 2 ^ k) (hk : k + 1 ≤ B) : zsz v ≤ B := by
  apply zsz_le_of_lt
  have h1 : v.natAbs ≤ 2 ^ k := by
    have : (v.natAbs : ℤ) ≤ ((2 ^ k : ℕ) : ℤ) := by rw [Int.natAbs_of_nonneg h0]; push_cast; exact hv
    exact_mod_cast this
  calc v.natAbs ≤ 2 ^ k := h1
    _ < 2 ^ (k + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
    _ ≤ 2 ^ B := Nat.pow_le_pow_right (by norm_num) hk

theorem zszN {x k B : ℕ} (hv : x ≤ 2 ^ k) (hk : k + 1 ≤ B) : zsz (x : ℤ) ≤ B :=
  zszB (by positivity) (by exact_mod_cast hv) hk

theorem zszS {x B : ℕ} (hk : x + 1 ≤ B) : zsz (x : ℤ) ≤ B :=
  zszN (Nat.lt_two_pow_self).le hk

