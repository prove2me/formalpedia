-- title:
--   Hidden subgroup $\tilde H = K \oplus \langle s \rangle$
-- statement:
--   For $s \in V$, the subgroup
--   $$
--   \tilde H = K \oplus \langle s \rangle = \{(k, v) \in K \oplus V : v \in \{0, s\}\}
--   $$
--   of $G = K \oplus V$. For a Simon function $f$ with period $s(f)$ it is the hidden subgroup of $\tilde f$, and of the Fractional Padded Simon StateHSP instance.
-- source:
--   Liu–Carrasco–Eisert–Bellante, The power of oracle access, arXiv:2609.35656, p.38 (after Definition 4.8); §4.3, p.39; proof of Theorem 4.10, p.40

import Mathlib
import Definitions.Def_OracleStateHSP_V
import Definitions.Def_OracleStateHSP_K

namespace OracleStateHSP

/-- The hidden subgroup `H̃ = K ⊕ ⟨s⟩ ≤ G = K ⊕ V` of a Padded Simon's problem with period `s`
(Liu–Carrasco–Eisert–Bellante, *The power of oracle access*, arXiv:2609.35656, p.38 after Definition 4.8, and pp.39–40: `H = Z_2^r ⊕ ⟨s(f)⟩`): all of `K` times the
subgroup generated by `s`. -/
def hiddenSubgroup (r : ℕ) {m : ℕ} (s : V m) : AddSubgroup (K r × V m) :=
  AddSubgroup.prod ⊤ (AddSubgroup.zmultiples s)

end OracleStateHSP


