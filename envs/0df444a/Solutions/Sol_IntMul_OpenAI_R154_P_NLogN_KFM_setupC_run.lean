    have hgt := n_gt hn
    have hpow : 2 ^ bP n = 2 * 2 ^ (bP n - 1) := by rw [← pow_succ']; congr 1; omega
    have h2 : 2 ^ bP n < IntMul.OpenAI.Glue.TP n * LP n * 2 := by nlinarith
