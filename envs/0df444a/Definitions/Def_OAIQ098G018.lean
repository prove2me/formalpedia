namespace OAI

namespace SharpPlanar.IntegerIntervals

def zeroBox : CBox := ⟨⟨0,0⟩,⟨0,0⟩⟩
end SharpPlanar.IntegerIntervals

namespace SharpPlanar.IntegerIntervals

def finSum : {N : ℕ} → (Fin N → CBox) → CBox
  | 0, _ => zeroBox
  | N+1, f => (f 0).add (finSum (fun i : Fin N => f i.succ))

end SharpPlanar.IntegerIntervals

end OAI
