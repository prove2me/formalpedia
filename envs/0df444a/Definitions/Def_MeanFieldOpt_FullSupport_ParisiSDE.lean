-- url     : https://prove2.me/theorems/a8bd9ebc-94bf-44d7-b03e-7e833783c1ec
-- title:
--   Strong solutions of the SDE $dX_t=\xi''\gamma\,\partial_x\Phi^\gamma(t,X_t)dt+\sqrt{\xi''}\,dB_t$ (Eq. (6.3))
-- statement:
--   Let $\xi$ be a mixture, $f_0$ a terminal condition, $\gamma \in \mathscr L$ and $\Phi = \Phi^\gamma$. Associated with the Parisi PDE is the stochastic differential equation driven by a Brownian motion $(B_t)_{t\ge0}$:
--
--   $$
--   dX_t = \xi''(t)\gamma(t)\,\partial_x\Phi(t, X_t)\,dt + \sqrt{\xi''(t)}\,dB_t, \qquad X_0 = 0 .
--   $$
--
--   A process $X$ is a **strong solution** on a probability space $(\Omega,\mathcal F,\mathbb P)$ with driving process $B$ if it has continuous paths, is adapted to the completed filtration generated by $B$, and almost surely
--
--   $$
--   X_t = \int_0^t \xi''(s)\gamma(s)\,\partial_x\Phi(s,X_s)\,ds + \int_0^t \sqrt{\xi''(s)}\,dB_s \quad \text{for all } t,
--   $$
--
--   the second integral being an Itô integral. The file also introduces the notation $X_t(\omega)$ for real times $t \ge 0$.
--
--   **Formalization Note** The solution concept is the published `EthierKurtz.SolvesBrownianSDE` in dimension $d = 1$: states are vectors of `EuclideanSpace ℝ (Fin 1)` and the diffusion is a $1\times1$ matrix. The coefficients are defined for all $t \ge 0$: the drift is $\xi''(t)\gamma(t)\partial_x\Phi^\gamma(t,x)$ for $t<1$ and $0$ for $t \ge 1$; the diffusion is $\sqrt{\xi''(t)}$ for $t\le1$ and $0$ for $t > 1$, so the solution is constant after time $1$. $\partial_x\Phi$ is Lean's `deriv` of $x \mapsto \Phi^\gamma(t,x)$. That the driver is a standard Brownian motion is a separate hypothesis of each theorem (`IsBrownianReal` of its single coordinate). `pathAt X t ω` is the real number $X_t(\omega)$.
-- source:
--   El Alaoui, Montanari, Sellke, Optimization of Mean-field Spin Glasses, arXiv:2001.00904v1, p. 23, Eq. (6.3); solved on [0,1] in Lemma 6.5, p. 26

import Mathlib
import Definitions.Def_MeanFieldOpt_FullSupport_PhiL
import Definitions.Def_EthierKurtz_SolvesBrownianSDE

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace MeanFieldOpt.FullSupport

/-- Drift of the SDE (6.3) (arXiv:2001.00904v1, p. 23), `b(t, x) = ξ''(t) γ(t) ∂_xΦ^γ(t, x)` for
`t < 1`, extended by `0` for `t ≥ 1`, as a vector of the one-dimensional Euclidean space. -/
noncomputable def parisiDrift (ξ : Mixture) (f₀ : ℝ → ℝ) (γ : ℝ → ℝ) :
    ℝ≥0 × EthierKurtz.SDEState 1 → EthierKurtz.SDEState 1 := fun p =>
  EuclideanSpace.single 0
    (if (p.1 : ℝ) < 1 then ξ.d2 p.1 * γ p.1 * deriv (PhiL ξ f₀ γ p.1) (p.2 0) else 0)

/-- Diffusion coefficient of the SDE (6.3), `σ(t) = √(ξ''(t))` for `t ≤ 1`, extended by `0` for
`t > 1`, as a `1 × 1` matrix. -/
noncomputable def parisiDiffusion (ξ : Mixture) :
    ℝ≥0 × EthierKurtz.SDEState 1 → EthierKurtz.SDEDiffusion 1 := fun p =>
  EuclideanSpace.single (0, 0) (if (p.1 : ℝ) ≤ 1 then Real.sqrt (ξ.d2 p.1) else 0)

/-- `X` is a strong solution of the SDE (6.3) (arXiv:2001.00904v1, p. 23)
`dX_t = ξ''(t) γ(t) ∂_xΦ^γ(t, X_t) dt + √(ξ''(t)) dB_t`, `X_0 = 0`, driven by `W`, in the sense of
the published `EthierKurtz.SolvesBrownianSDE` in dimension `1` (coefficients extended by `0`
after time `1`). -/
def IsParisiSDESol {Ω : Type*} [MeasurableSpace Ω] (ξ : Mixture) (f₀ : ℝ → ℝ) (γ : ℝ → ℝ)
    (P : Measure Ω) (W X : ℝ≥0 → Ω → EthierKurtz.SDEState 1) : Prop :=
  EthierKurtz.SolvesBrownianSDE P (parisiDiffusion ξ) (parisiDrift ξ f₀ γ) W (fun _ => 0) X

/-- The real value `X_t(ω)` of a one-dimensional process at a real time `t ≥ 0`. -/
noncomputable def pathAt {Ω : Type*} (X : ℝ≥0 → Ω → EthierKurtz.SDEState 1) (t : ℝ) (ω : Ω) : ℝ :=
  X (Real.toNNReal t) ω 0

end MeanFieldOpt.FullSupport


