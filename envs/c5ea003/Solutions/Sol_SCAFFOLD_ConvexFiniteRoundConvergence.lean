section SCAFFOLDBundleModule9
/-! Finite vector-mean inequalities used in SCAFFOLD Appendix B.2, PDF pp. 15-16,
Lemmas 3-4, and Appendix E, PDF pp. 26-35, Lemmas 12-19. -/

noncomputable section
open scoped BigOperators
namespace SCAFFOLD

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem norm_average_sq_le {N : ℕ} (hN : 0 < N) (v : Fin N → E) :
    ‖(N : ℝ)⁻¹ • ∑ i, v i‖ ^ 2 ≤ (N : ℝ)⁻¹ * ∑ i, ‖v i‖ ^ 2 := by
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hsq : ‖∑ i, v i‖ ^ 2 ≤ (N : ℝ) * ∑ i, ‖v i‖ ^ 2 := by
    calc
      _ ≤ (∑ i, ‖v i‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
      _ ≤ _ := by simpa using (sq_sum_le_card_mul_sum_sq
        (s := Finset.univ) (f := fun i ↦ ‖v i‖))
  rw [norm_smul, Real.norm_of_nonneg (by positivity), mul_pow]
  calc
    _ ≤ (N : ℝ)⁻¹ ^ 2 * ((N : ℝ) * ∑ i, ‖v i‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hsq (sq_nonneg _)
    _ = _ := by field_simp

theorem sum_centered_norm_sq {N : ℕ} (hN : 0 < N) (v : Fin N → E) :
    ∑ i, ‖v i - (N : ℝ)⁻¹ • ∑ j, v j‖ ^ 2 =
      ∑ i, ‖v i‖ ^ 2 - (N : ℝ) * ‖(N : ℝ)⁻¹ • ∑ j, v j‖ ^ 2 := by
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  let m := (N : ℝ)⁻¹ • ∑ j, v j
  have hm : ∑ j, v j = (N : ℝ) • m := by simp [m, smul_smul, hN0]
  change ∑ i, ‖v i - m‖ ^ 2 = ∑ i, ‖v i‖ ^ 2 - (N : ℝ) * ‖m‖ ^ 2
  simp_rw [norm_sub_sq_real]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
    ← sum_inner, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [hm, real_inner_smul_left, real_inner_self_eq_norm_sq]
  ring

theorem sum_centered_norm_sq_le {N : ℕ} (hN : 0 < N) (v : Fin N → E) :
    ∑ i, ‖v i - (N : ℝ)⁻¹ • ∑ j, v j‖ ^ 2 ≤ ∑ i, ‖v i‖ ^ 2 := by
  rw [sum_centered_norm_sq hN]
  exact sub_le_self _ (mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _))

theorem sum_sub_mean_eq_zero {N : ℕ} (hN : 0 < N) (v : Fin N → E) :
    ∑ i, (v i - (N : ℝ)⁻¹ • ∑ j, v j) = 0 := by
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  simp [Finset.sum_sub_distrib, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hN0]

theorem average_sub_const {N : ℕ} (hN : 0 < N) (v : Fin N → E) (z : E) :
    (N : ℝ)⁻¹ • ∑ i, (v i - z) = (N : ℝ)⁻¹ • ∑ i, v i - z := by
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  simp [Finset.sum_sub_distrib, ← Nat.cast_smul_eq_nsmul ℝ, smul_sub, smul_smul, hN0]

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule9
/- END Definitions.SCAFFOLD.VectorMoments -/

/- BEGIN Definitions.SCAFFOLD.Sampling -/
section SCAFFOLDBundleModule10
/-!
Uniform fixed-size client sampling for Karimireddy et al., SCAFFOLD,
arXiv:1910.06378v4, Algorithm 1 (PDF p. 4), Appendix E sampling paragraph after
equation (22) (PDF p. 26), and Lemmas 12-13 (PDF pp. 26-28), Section 5.
These lemmas derive the finite population moments and conditional sampling
identities from the published sampling law.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

def fixedSizeSubsets (N S : ℕ) : Finset (Finset (Fin N)) :=
  Finset.univ.powersetCard S

@[simp] theorem mem_fixedSizeSubsets {N S : ℕ} {A : Finset (Fin N)} :
    A ∈ fixedSizeSubsets N S ↔ A.card = S := by
  simp [fixedSizeSubsets, Finset.mem_powersetCard]

@[simp] theorem card_fixedSizeSubsets (N S : ℕ) :
    (fixedSizeSubsets N S).card = Nat.choose N S := by
  simp [fixedSizeSubsets, Finset.card_powersetCard]

theorem subset_inclusion_count {N S : ℕ} (hS : 0 < S) (i : Fin N) :
    ((fixedSizeSubsets N S).filter (i ∈ ·)).card = Nat.choose (N - 1) (S - 1) := by
  simpa [fixedSizeSubsets] using
    Finset.card_filter_powersetCard_subset ({i} : Finset (Fin N)) Finset.univ S
      (Finset.subset_univ _) (by simpa using hS)

theorem choose_inclusion_ratio {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N) :
    (Nat.choose N S : ℝ)⁻¹ * (Nat.choose (N - 1) (S - 1) : ℝ) =
      (S : ℝ) / N := by
  have hrec := Nat.add_one_mul_choose_eq (N - 1) (S - 1)
  rw [Nat.sub_add_cancel hN, Nat.sub_add_cancel hS] at hrec
  have hrecR : (N : ℝ) * Nat.choose (N - 1) (S - 1) = Nat.choose N S * (S : ℝ) :=
    by exact_mod_cast hrec
  have hn : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  have hc : (Nat.choose N S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt (Nat.choose_pos hSN)
  field_simp
  nlinarith [hrecR]

def uniformSubsetAverage {E : Type*} [AddCommMonoid E] [Module ℝ E]
    (N S : ℕ) (f : Finset (Fin N) → E) : E :=
  (Nat.choose N S : ℝ)⁻¹ • ∑ A ∈ fixedSizeSubsets N S, f A

theorem subset_pair_inclusion_count {N S : ℕ} (hS : 2 ≤ S)
    (i j : Fin N) (hij : i ≠ j) :
    ((fixedSizeSubsets N S).filter (fun B ↦ i ∈ B ∧ j ∈ B)).card =
      Nat.choose (N - 2) (S - 2) := by
  simpa [fixedSizeSubsets, hij, Finset.insert_subset_iff] using
    Finset.card_filter_powersetCard_subset ({i, j} : Finset (Fin N)) Finset.univ S
      (Finset.subset_univ _) (by simpa [hij] using hS)

theorem choose_pair_inclusion_ratio {N S : ℕ} (hN : 2 ≤ N) (hS : 2 ≤ S)
    (hSN : S ≤ N) :
    (Nat.choose N S : ℝ)⁻¹ * (Nat.choose (N - 2) (S - 2) : ℝ) =
      ((S : ℝ) * (S - 1)) / ((N : ℝ) * (N - 1)) := by
  have hN1 : 0 < N - 1 := by omega
  have hS1 : 0 < S - 1 := by omega
  have hSN1 : S - 1 ≤ N - 1 := by omega
  have hc : (Nat.choose (N - 1) (S - 1) : ℝ) ≠ 0 := by
    exact_mod_cast Nat.ne_of_gt (Nat.choose_pos hSN1)
  have hrec := choose_inclusion_ratio hN1 hS1 hSN1
  have hsubN : N - 1 - 1 = N - 2 := by omega
  have hsubS : S - 1 - 1 = S - 2 := by omega
  rw [hsubN, hsubS] at hrec
  calc
    _ = ((Nat.choose N S : ℝ)⁻¹ * (Nat.choose (N - 1) (S - 1) : ℝ)) *
        ((Nat.choose (N - 1) (S - 1) : ℝ)⁻¹ * (Nat.choose (N - 2) (S - 2) : ℝ)) := by
      field_simp
    _ = ((S : ℝ) / N) * ((S - 1 : ℕ) : ℝ) / ((N - 1 : ℕ) : ℝ) := by
      rw [choose_inclusion_ratio (by omega) (by omega) hSN, hrec]
      ring
    _ = _ := by
      rw [Nat.cast_sub (by omega : 1 ≤ S), Nat.cast_sub (by omega : 1 ≤ N)]
      simp only [Nat.cast_one]
      simp only [div_eq_mul_inv, mul_inv_rev]
      ring

theorem uniformSubsetAverage_sum {E : Type*} [AddCommMonoid E] [Module ℝ E]
    {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N) (v : Fin N → E) :
    uniformSubsetAverage N S (fun A ↦ ∑ i ∈ A, v i) =
      ((S : ℝ) / N) • ∑ i, v i := by
  classical
  have hex (A : Finset (Fin N)) : (∑ i ∈ A, v i) = ∑ i, if i ∈ A then v i else 0 := by
    simp
  simp_rw [uniformSubsetAverage, hex]
  rw [Finset.sum_comm]
  have hcount (i : Fin N) :
      (∑ A ∈ fixedSizeSubsets N S, if i ∈ A then v i else 0) =
        (Nat.choose (N - 1) (S - 1) : ℝ) • v i := by
    rw [← Finset.sum_filter]
    simp [subset_inclusion_count hS, ← Nat.cast_smul_eq_nsmul ℝ]
  simp_rw [hcount]
  rw [← Finset.smul_sum, smul_smul, choose_inclusion_ratio hN hS hSN]
  simp

theorem uniformSubsetAverage_mean {E : Type*} [AddCommMonoid E] [Module ℝ E]
    {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N) (v : Fin N → E) :
    uniformSubsetAverage N S (fun A ↦ (S : ℝ)⁻¹ • ∑ i ∈ A, v i) =
      (N : ℝ)⁻¹ • ∑ i, v i := by
  have hs : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hS
  have h := uniformSubsetAverage_sum hN hS hSN v
  unfold uniformSubsetAverage at h ⊢
  rw [← Finset.smul_sum, smul_comm, h, smul_smul]
  congr 1
  field_simp

theorem uniformSubsetAverage_add {E : Type*} [AddCommMonoid E] [Module ℝ E]
    (N S : ℕ) (f g : Finset (Fin N) → E) :
    uniformSubsetAverage N S (fun B ↦ f B + g B) =
      uniformSubsetAverage N S f + uniformSubsetAverage N S g := by
  simp only [uniformSubsetAverage, Finset.sum_add_distrib, smul_add]

theorem uniformSubsetAverage_const {E : Type*} [AddCommMonoid E] [Module ℝ E]
    {N S : ℕ} (hSN : S ≤ N) (v : E) : uniformSubsetAverage N S (fun _ ↦ v) = v := by
  have hc : (Nat.choose N S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt (Nat.choose_pos hSN)
  simp [uniformSubsetAverage, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hc]

theorem uniformSubsetAverage_ite_mem_zero {E : Type*} [AddCommMonoid E] [Module ℝ E]
    {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N) (i : Fin N) (u : E) :
    uniformSubsetAverage N S (fun B ↦ if i ∈ B then u else 0) = ((S : ℝ) / N) • u := by
  classical
  unfold uniformSubsetAverage
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, subset_inclusion_count hS, ← Nat.cast_smul_eq_nsmul ℝ,
    smul_smul, choose_inclusion_ratio hN hS hSN]

theorem uniformSubsetAverage_ite_mem {E : Type*} [AddCommGroup E] [Module ℝ E]
    {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N) (i : Fin N) (u v : E) :
    uniformSubsetAverage N S (fun B ↦ if i ∈ B then u else v) =
      ((S : ℝ) / N) • u + (1 - (S : ℝ) / N) • v := by
  classical
  have hex : (fun B : Finset (Fin N) ↦ if i ∈ B then u else v) =
      fun B ↦ v + (if i ∈ B then u - v else 0) := by
    funext B
    split_ifs <;> abel
  rw [hex, uniformSubsetAverage_add, uniformSubsetAverage_const hSN,
    uniformSubsetAverage_ite_mem_zero hN hS hSN]
  module

theorem uniformSubsetAverage_ite_mem_pair {E : Type*} [AddCommMonoid E] [Module ℝ E]
    {N S : ℕ} (hS : 0 < S) (hSN : S ≤ N) (i j : Fin N) (hij : i ≠ j) (u : E) :
    uniformSubsetAverage N S (fun B ↦ if i ∈ B ∧ j ∈ B then u else 0) =
      (((S : ℝ) * (S - 1)) / ((N : ℝ) * (N - 1))) • u := by
  classical
  unfold uniformSubsetAverage
  rw [← Finset.sum_filter]
  by_cases hS2 : 2 ≤ S
  · simp only [Finset.sum_const, subset_pair_inclusion_count hS2 i j hij,
      ← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
      choose_pair_inclusion_ratio (hS2.trans hSN) hS2 hSN]
  · have hS1 : S = 1 := by omega
    have he : (fixedSizeSubsets N S).filter (fun B ↦ i ∈ B ∧ j ∈ B) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro B hB
      have hcard := mem_fixedSizeSubsets.mp (Finset.mem_filter.mp hB).1
      have hsub : ({i, j} : Finset (Fin N)) ⊆ B := by
        simpa [Finset.insert_subset_iff] using (Finset.mem_filter.mp hB).2
      have hc := Finset.card_le_card hsub
      simp only [Finset.card_pair hij] at hc
      omega
    rw [he]
    simp [hS1]

theorem uniformSubsetAverage_finsetSum {E ι : Type*} [AddCommMonoid E] [Module ℝ E]
    (N S : ℕ) (I : Finset ι) (f : ι → Finset (Fin N) → E) :
    uniformSubsetAverage N S (fun B ↦ ∑ i ∈ I, f i B) =
      ∑ i ∈ I, uniformSubsetAverage N S (f i) := by
  unfold uniformSubsetAverage
  rw [Finset.sum_comm, Finset.smul_sum]

theorem uniformSubsetAverage_norm_sum_sq {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N)
    (v : Fin N → E) :
    uniformSubsetAverage N S (fun B ↦ ‖∑ i ∈ B, v i‖ ^ 2) =
      ∑ i, ∑ j, (if i = j then (S : ℝ) / N else
        ((S : ℝ) * (S - 1)) / ((N : ℝ) * (N - 1))) * ⟪v i, v j⟫_ℝ := by
  classical
  have hex (B : Finset (Fin N)) : ‖∑ i ∈ B, v i‖ ^ 2 =
      ∑ i, ∑ j, if i ∈ B ∧ j ∈ B then ⟪v i, v j⟫_ℝ else 0 := by
    rw [← real_inner_self_eq_norm_sq]
    simp only [sum_inner, inner_sum]
    simp [ite_and]
    exact Finset.sum_comm
  simp_rw [hex, uniformSubsetAverage_finsetSum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  by_cases hij : i = j
  · subst j
    simp [uniformSubsetAverage_ite_mem_zero hN hS hSN]
  · rw [uniformSubsetAverage_ite_mem_pair hS hSN i j hij, if_neg hij, smul_eq_mul]

theorem diagonal_weighted_inner_sum {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N : ℕ} (p q : ℝ) (v : Fin N → E) :
    (∑ i, ∑ j, (if i = j then p else q) * ⟪v i, v j⟫_ℝ) =
      (p - q) * ∑ i, ‖v i‖ ^ 2 + q * ‖∑ i, v i‖ ^ 2 := by
  classical
  have hc (i j : Fin N) : (if i = j then p else q) * ⟪v i, v j⟫_ℝ =
      q * ⟪v i, v j⟫_ℝ + (if i = j then (p - q) * ‖v i‖ ^ 2 else 0) := by
    by_cases hij : i = j
    · subst j
      simp only [ite_true, real_inner_self_eq_norm_sq]
      ring
    · simp [hij]
  simp_rw [hc, Finset.sum_add_distrib]
  have hdiag : (∑ i, ∑ j : Fin N, if i = j then (p - q) * ‖v i‖ ^ 2 else 0) =
      (p - q) * ∑ i, ‖v i‖ ^ 2 := by simp [← Finset.mul_sum]
  have hfull : (∑ i, ∑ j, ⟪v i, v j⟫_ℝ) = ‖∑ i, v i‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq]
    simp only [sum_inner, inner_sum]
    exact Finset.sum_comm
  simp only [← Finset.mul_sum]
  rw [hdiag, hfull]
  ring

theorem uniformSubsetAverage_norm_sum_sq_centered_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N)
    (v : Fin N → E) (hv : ∑ i, v i = 0) :
    uniformSubsetAverage N S (fun B ↦ ‖∑ i ∈ B, v i‖ ^ 2) ≤
      ((S : ℝ) / N) * ∑ i, ‖v i‖ ^ 2 := by
  rw [uniformSubsetAverage_norm_sum_sq hN hS hSN, diagonal_weighted_inner_sum, hv]
  simp only [norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, add_zero]
  have hSr : (1 : ℝ) ≤ S := by exact_mod_cast hS
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hq : 0 ≤ ((S : ℝ) * (S - 1)) / ((N : ℝ) * (N - 1)) := by positivity
  exact mul_le_mul_of_nonneg_right (sub_le_self _ hq) (Finset.sum_nonneg fun i _ ↦ sq_nonneg _)

theorem uniformSubsetAverage_smul {E : Type*} [AddCommMonoid E] [Module ℝ E]
    (N S : ℕ) (c : ℝ) (f : Finset (Fin N) → E) :
    uniformSubsetAverage N S (fun B ↦ c • f B) = c • uniformSubsetAverage N S f := by
  unfold uniformSubsetAverage
  rw [← Finset.smul_sum, smul_comm]

theorem uniformSubsetAverage_norm_mean_sq_centered_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N S : ℕ} (hN : 0 < N) (hS : 0 < S) (hSN : S ≤ N)
    (v : Fin N → E) (hv : ∑ i, v i = 0) :
    uniformSubsetAverage N S (fun B ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ B, v i‖ ^ 2) ≤
      (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ‖v i‖ ^ 2) := by
  have hs : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hS
  simp only [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
  have havg : uniformSubsetAverage N S
      (fun B ↦ ((S : ℝ)⁻¹) ^ 2 * ‖∑ i ∈ B, v i‖ ^ 2) =
      ((S : ℝ)⁻¹) ^ 2 * uniformSubsetAverage N S (fun B ↦ ‖∑ i ∈ B, v i‖ ^ 2) :=
    uniformSubsetAverage_smul N S _ _
  rw [havg]
  calc
    _ ≤ ((S : ℝ)⁻¹) ^ 2 * (((S : ℝ) / N) * ∑ i, ‖v i‖ ^ 2) :=
      mul_le_mul_of_nonneg_left (uniformSubsetAverage_norm_sum_sq_centered_le hN hS hSN v hv)
        (sq_nonneg _)
    _ = _ := by field_simp

theorem norm_average_finset_sq_le {E ι : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    {S : ℕ} (hS : 0 < S) (B : Finset ι) (hB : B.card = S) (v : ι → E) :
    ‖(S : ℝ)⁻¹ • ∑ i ∈ B, v i‖ ^ 2 ≤ (S : ℝ)⁻¹ * ∑ i ∈ B, ‖v i‖ ^ 2 := by
  have hSr : (0 : ℝ) < S := by exact_mod_cast hS
  have hsq : ‖∑ i ∈ B, v i‖ ^ 2 ≤ (S : ℝ) * ∑ i ∈ B, ‖v i‖ ^ 2 := by
    calc
      _ ≤ (∑ i ∈ B, ‖v i‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
      _ ≤ _ := by
        simpa [hB] using sq_sum_le_card_mul_sum_sq (s := B) (f := fun i ↦ ‖v i‖)
  rw [norm_smul, Real.norm_of_nonneg (by positivity), mul_pow]
  calc
    _ ≤ ((S : ℝ)⁻¹) ^ 2 * ((S : ℝ) * ∑ i ∈ B, ‖v i‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hsq (sq_nonneg _)
    _ = _ := by field_simp

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
theorem aestronglyMeasurable_subalgebra_sum {E ι : Type*} [NormedAddCommGroup E]
    {H : MeasurableSpace Ω} {v : ι → Ω → E}
    (hm : ∀ i, AEStronglyMeasurable[H] (v i) ν) (B : Finset ι) :
    AEStronglyMeasurable[H] (fun ω ↦ ∑ i ∈ B, v i ω) ν := by
  classical
  induction B using Finset.induction_on with
  | empty => simpa using
      (stronglyMeasurable_const : StronglyMeasurable[H] (fun _ : Ω ↦ (0 : E))).aestronglyMeasurable
  | insert i B hi ih =>
    simp only [Finset.sum_insert hi]
    exact (hm i).add ih

def sampleIndicator (A : Run P ν S K T ηl ηg init) (r : ℕ)
    (B : Finset (Fin N)) (ω : Ω) : ℝ := if A.sample r ω = B then 1 else 0

theorem Run.sampleIndicator_measurable (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) :
    StronglyMeasurable (sampleIndicator A r B) :=
  (A.sample_adapted r hr B).mono (A.history.le _)

theorem sampleIndicator_norm_le_one (A : Run P ν S K T ηl ηg init)
    (r : ℕ) (B : Finset (Fin N)) (ω : Ω) : ‖sampleIndicator A r B ω‖ ≤ 1 := by
  simp only [sampleIndicator]
  split_ifs <;> norm_num

theorem Run.sampleIndicator_integrable (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) :
    Integrable (sampleIndicator A r B) ν :=
  (integrable_const (1 : ℝ)).mono' (A.sampleIndicator_measurable hr B).aestronglyMeasurable
    (Filter.Eventually.of_forall (sampleIndicator_norm_le_one A r B))

theorem Run.sampleIndicator_smul_integrable {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) {F : Ω → E} (hF : Integrable F ν) :
    Integrable (sampleIndicator A r B • F) ν :=
  hF.bdd_smul 1 (A.sampleIndicator_measurable hr B).aestronglyMeasurable
    (Filter.Eventually.of_forall (sampleIndicator_norm_le_one A r B))

theorem Run.sampleIndicator_smul_condExp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) {F : Ω → E}
    (hF : Integrable F ν)
    (hm : AEStronglyMeasurable[A.history (roundTime K r + K)] F ν) :
    ν[sampleIndicator A r B • F | A.history (roundTime K r + K)] =ᵐ[ν]
      fun ω ↦ (if B.card = S then (Nat.choose N S : ℝ)⁻¹ else 0) • F ω := by
  have hp := condExp_smul_of_aestronglyMeasurable_right
    (A.sampleIndicator_integrable hr B) (A.sampleIndicator_smul_integrable hr B hF) hm
  filter_upwards [hp, A.sample_uniform r hr B] with ω hpω huω
  change ν[sampleIndicator A r B | A.history (roundTime K r + K)] ω = _ at huω
  change ν[sampleIndicator A r B • F | A.history (roundTime K r + K)] ω =
    ν[sampleIndicator A r B | A.history (roundTime K r + K)] ω • F ω at hpω
  rw [hpω, huω]

theorem Run.sample_function_expand {E : Type*} [AddCommMonoid E] [Module ℝ E]
    (A : Run P ν S K T ηl ηg init) (r : ℕ) (F : Finset (Fin N) → Ω → E) :
    (fun ω ↦ F (A.sample r ω) ω) = ∑ B, sampleIndicator A r B • F B := by
  classical
  funext ω
  simp [sampleIndicator, Finset.sum_apply]

theorem Run.sample_function_integrable {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (F : Finset (Fin N) → Ω → E)
    (hF : ∀ B, Integrable (F B) ν) : Integrable (fun ω ↦ F (A.sample r ω) ω) ν := by
  rw [A.sample_function_expand]
  exact integrable_finsetSum' _ (fun B _ ↦ A.sampleIndicator_smul_integrable hr B (hF B))

theorem Run.sample_function_memLp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {p : ENNReal} (F : Finset (Fin N) → Ω → E)
    (hF : ∀ B, MemLp (F B) p ν) : MemLp (fun ω ↦ F (A.sample r ω) ω) p ν := by
  rw [A.sample_function_expand]
  apply memLp_finsetSum'
  intro B _
  exact (hF B).smul (memLp_top_of_bound
    (A.sampleIndicator_measurable hr B).aestronglyMeasurable 1
    (Filter.Eventually.of_forall (sampleIndicator_norm_le_one A r B)))

theorem Run.sample_mean_memLp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {p : ENNReal} (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) p ν) :
    MemLp (fun ω ↦ (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω) p ν :=
  A.sample_function_memLp hr _ (fun B ↦
    (memLp_finsetSum B (fun i _ ↦ hv i)).const_smul _)

theorem Run.sample_function_condExp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (F : Finset (Fin N) → Ω → E)
    (hF : ∀ B, Integrable (F B) ν)
    (hm : ∀ B, AEStronglyMeasurable[A.history (roundTime K r + K)] (F B) ν) :
    ν[(fun ω ↦ F (A.sample r ω) ω) | A.history (roundTime K r + K)] =ᵐ[ν]
      fun ω ↦ uniformSubsetAverage N S (fun B ↦ F B ω) := by
  classical
  rw [A.sample_function_expand]
  have hsum := condExp_finsetSum (s := Finset.univ)
    (fun B _ ↦ A.sampleIndicator_smul_integrable hr B (hF B))
    (A.history (roundTime K r + K))
  filter_upwards [hsum, Filter.eventually_all.mpr
    (fun B ↦ A.sampleIndicator_smul_condExp hr B (hF B) (hm B))] with ω hs hu
  rw [hs]
  simp only [Finset.sum_apply]
  simp_rw [hu]
  simp only [ite_smul, zero_smul]
  rw [← Finset.sum_filter, ← Finset.smul_sum]
  congr 1
  have hset : Finset.univ.filter (fun B : Finset (Fin N) ↦ B.card = S) =
      fixedSizeSubsets N S := by ext B; simp
  rw [hset]

theorem Run.sample_sum_condExp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, Integrable (v i) ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    ν[(fun ω ↦ ∑ i ∈ A.sample r ω, v i ω) | A.history (roundTime K r + K)] =ᵐ[ν]
      fun ω ↦ ((S : ℝ) / N) • ∑ i, v i ω := by
  have h := A.sample_function_condExp hr (fun B ω ↦ ∑ i ∈ B, v i ω)
    (fun B ↦ integrable_finsetSum B (fun i _ ↦ hv i))
    (aestronglyMeasurable_subalgebra_sum hm)
  filter_upwards [h] with ω hω
  rw [hω, uniformSubsetAverage_sum P.clients_pos A.sample_pos A.sample_le]

theorem Run.sample_mean_condExp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, Integrable (v i) ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    ν[(fun ω ↦ (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω) |
      A.history (roundTime K r + K)] =ᵐ[ν]
        fun ω ↦ (N : ℝ)⁻¹ • ∑ i, v i ω := by
  have h := A.sample_function_condExp hr (fun B ω ↦ (S : ℝ)⁻¹ • ∑ i ∈ B, v i ω)
    (fun B ↦ (integrable_finsetSum B (fun i _ ↦ hv i)).smul _)
    (fun B ↦ (aestronglyMeasurable_subalgebra_sum hm B).const_smul _)
  filter_upwards [h] with ω hω
  rw [hω, uniformSubsetAverage_mean P.clients_pos A.sample_pos A.sample_le]

theorem Run.sample_sum_integral {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, Integrable (v i) ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    (∫ ω, ∑ i ∈ A.sample r ω, v i ω ∂ν) = ((S : ℝ) / N) • ∑ i, ∫ ω, v i ω ∂ν := by
  calc
    _ = ∫ ω, ν[(fun ω ↦ ∑ i ∈ A.sample r ω, v i ω) |
        A.history (roundTime K r + K)] ω ∂ν := (integral_condExp (A.history.le _)).symm
    _ = ∫ ω, ((S : ℝ) / N) • ∑ i, v i ω ∂ν :=
      integral_congr_ae (A.sample_sum_condExp hr v hv hm)
    _ = _ := by rw [integral_smul, integral_finsetSum _ (fun i _ ↦ hv i)]

theorem Run.refresh_condExp {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (i : Fin N) (u v : Ω → E)
    (hu : Integrable u ν) (hv : Integrable v ν)
    (hum : AEStronglyMeasurable[A.history (roundTime K r + K)] u ν)
    (hvm : AEStronglyMeasurable[A.history (roundTime K r + K)] v ν) :
    ν[(fun ω ↦ if i ∈ A.sample r ω then u ω else v ω) |
      A.history (roundTime K r + K)] =ᵐ[ν]
        fun ω ↦ ((S : ℝ) / N) • u ω + (1 - (S : ℝ) / N) • v ω := by
  have h := A.sample_function_condExp hr
    (fun B ω ↦ if i ∈ B then u ω else v ω)
    (fun B ↦ by
      classical
      by_cases hi : i ∈ B
      · simpa [hi] using hu
      · simpa [hi] using hv)
    (fun B ↦ by
      classical
      by_cases hi : i ∈ B
      · simpa [hi] using hum
      · simpa [hi] using hvm)
  filter_upwards [h] with ω hω
  rw [hω, uniformSubsetAverage_ite_mem P.clients_pos A.sample_pos A.sample_le]

theorem Run.refresh_integral (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (i : Fin N) (u v : Ω → ℝ)
    (hu : Integrable u ν) (hv : Integrable v ν)
    (hum : AEStronglyMeasurable[A.history (roundTime K r + K)] u ν)
    (hvm : AEStronglyMeasurable[A.history (roundTime K r + K)] v ν) :
    (∫ ω, if i ∈ A.sample r ω then u ω else v ω ∂ν) =
      ((S : ℝ) / N) * (∫ ω, u ω ∂ν) + (1 - (S : ℝ) / N) * (∫ ω, v ω ∂ν) := by
  calc
    _ = ∫ ω, ν[(fun ω ↦ if i ∈ A.sample r ω then u ω else v ω) |
        A.history (roundTime K r + K)] ω ∂ν := (integral_condExp (A.history.le _)).symm
    _ = ∫ ω, ((S : ℝ) / N) • u ω + (1 - (S : ℝ) / N) • v ω ∂ν :=
      integral_congr_ae (A.refresh_condExp hr i u v hu hv hum hvm)
    _ = _ := by
      simp only [smul_eq_mul]
      rw [integral_add (hu.const_mul _) (hv.const_mul _), integral_const_mul, integral_const_mul]

theorem Run.sample_mean_sq_centered_condExp_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν)
    (hc : ∀ᵐ ω ∂ν, ∑ i, v i ω = 0) :
    ν[(fun ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω‖ ^ 2) |
      A.history (roundTime K r + K)] ≤ᵐ[ν]
        fun ω ↦ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2) := by
  have h := A.sample_function_condExp hr
    (fun B ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ B, v i ω‖ ^ 2)
    (fun B ↦ ((memLp_finsetSum B (fun i _ ↦ hv i)).const_smul (S : ℝ)⁻¹).norm.integrable_sq)
    (fun B ↦ ((continuous_norm : Continuous (fun x : E ↦ ‖x‖)).pow 2).comp_aestronglyMeasurable
      ((aestronglyMeasurable_subalgebra_sum hm B).const_smul (S : ℝ)⁻¹))
  filter_upwards [h, hc] with ω hω hcω
  rw [hω]
  exact uniformSubsetAverage_norm_mean_sq_centered_le
    P.clients_pos A.sample_pos A.sample_le (fun i ↦ v i ω) hcω

theorem Run.sample_mean_sq_centered_integral_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν)
    (hc : ∀ᵐ ω ∂ν, ∑ i, v i ω = 0) :
    (∫ ω, ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω‖ ^ 2 ∂ν) ≤
      (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖v i ω‖ ^ 2 ∂ν) := by
  have hb : Integrable (fun ω ↦ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2)) ν :=
    ((integrable_finsetSum Finset.univ (fun i _ ↦ (hv i).norm.integrable_sq)).const_mul _).const_mul _
  have h := integral_mono_ae integrable_condExp hb
    (A.sample_mean_sq_centered_condExp_le hr v hv hm hc)
  rw [integral_condExp (A.history.le _), integral_const_mul, integral_const_mul,
    integral_finsetSum _ (fun i _ ↦ (hv i).norm.integrable_sq)] at h
  exact h

theorem Run.sample_mean_variance_condExp_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    ν[(fun ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω -
        (N : ℝ)⁻¹ • ∑ i, v i ω‖ ^ 2) | A.history (roundTime K r + K)] ≤ᵐ[ν]
      fun ω ↦ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2) := by
  let m : Ω → E := fun ω ↦ (N : ℝ)⁻¹ • ∑ i, v i ω
  let w : Fin N → Ω → E := fun i ω ↦ v i ω - m ω
  have hw (i : Fin N) : MemLp (w i) 2 ν :=
    (hv i).sub ((memLp_finsetSum Finset.univ (fun j _ ↦ hv j)).const_smul _)
  have hwm (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)] (w i) ν :=
    (hm i).sub ((aestronglyMeasurable_subalgebra_sum hm Finset.univ).const_smul _)
  have h := A.sample_mean_sq_centered_condExp_le hr w hw hwm
    (Filter.Eventually.of_forall (fun ω ↦ sum_sub_mean_eq_zero P.clients_pos (fun i ↦ v i ω)))
  have hs : (fun ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, w i ω‖ ^ 2) =ᵐ[ν]
      fun ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω - m ω‖ ^ 2 := by
    have hs0 : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
    filter_upwards [A.sample_card r hr] with ω hc
    simp only [w, Finset.sum_sub_distrib, smul_sub, Finset.sum_const,
      ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hc, inv_mul_cancel₀ hs0, one_smul]
  have hce := condExp_congr_ae (m := A.history (roundTime K r + K)) hs
  filter_upwards [h, hce] with ω hω heq
  rw [← heq]
  exact hω.trans (mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left (sum_centered_norm_sq_le P.clients_pos (fun i ↦ v i ω))
      (inv_nonneg.mpr (Nat.cast_nonneg N)))
    (inv_nonneg.mpr (Nat.cast_nonneg S)))

theorem Run.sample_mean_variance_integral_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    (∫ ω, ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω -
        (N : ℝ)⁻¹ • ∑ i, v i ω‖ ^ 2 ∂ν) ≤
      (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖v i ω‖ ^ 2 ∂ν) := by
  have hb : Integrable (fun ω ↦ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2)) ν :=
    ((integrable_finsetSum Finset.univ (fun i _ ↦ (hv i).norm.integrable_sq)).const_mul _).const_mul _
  have h := integral_mono_ae integrable_condExp hb
    (A.sample_mean_variance_condExp_le hr v hv hm)
  rw [integral_condExp (A.history.le _), integral_const_mul, integral_const_mul,
    integral_finsetSum _ (fun i _ ↦ (hv i).norm.integrable_sq)] at h
  exact h

theorem Run.sample_mean_sq_integral_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Fin N → Ω → E)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hm : ∀ i, AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν) :
    (∫ ω, ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω‖ ^ 2 ∂ν) ≤
      (N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖v i ω‖ ^ 2 ∂ν := by
  have hs0 : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
  have hnorm (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)]
      (fun ω ↦ ‖v i ω‖ ^ 2) ν :=
    ((continuous_norm : Continuous (fun x : E ↦ ‖x‖)).pow 2).comp_aestronglyMeasurable (hm i)
  have hI := A.sample_function_integrable hr (fun B ω ↦ ∑ i ∈ B, ‖v i ω‖ ^ 2)
    (fun B ↦ integrable_finsetSum B (fun i _ ↦ (hv i).norm.integrable_sq))
  have h := integral_mono_ae (A.sample_mean_memLp hr v hv).norm.integrable_sq
    (hI.const_mul (S : ℝ)⁻¹) (show
      (fun ω ↦ ‖(S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω‖ ^ 2) ≤ᵐ[ν]
        (fun ω ↦ (S : ℝ)⁻¹ * ∑ i ∈ A.sample r ω, ‖v i ω‖ ^ 2) from by
      filter_upwards [A.sample_card r hr] with ω hc
      exact norm_average_finset_sq_le A.sample_pos _ hc (fun i ↦ v i ω))
  rw [integral_const_mul, A.sample_sum_integral hr
    (fun i ω ↦ ‖v i ω‖ ^ 2) (fun i ↦ (hv i).norm.integrable_sq) hnorm] at h
  simpa only [smul_eq_mul, div_eq_mul_inv, ← mul_assoc, inv_mul_cancel₀ hs0, one_mul] using h

