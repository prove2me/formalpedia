--   Recursive regional data of the released candidate, in tables
-- statement:
--   Recursive regional data below the released global stage, in step coordinates and compact tables: for each of the six level-3 regions, the 88 positive terms with their parent grade triples, block weights and cells (grade triple, split weight, level-2 split parameter); and the pooled level-2 region with its 1104 positive terms. Counts are per unit of the global scale; all weights are numerators over 10^12.
-- source:
--   Alman-Duan-Vassilevska Williams-Xu-Xu-Zhou, More Asymmetry Yields Faster Matrix Multiplication (https://arxiv.org/abs/2404.16349), sections 5-6, applied to the published exact seed of the released parameters. Finite data and its verification; no exponent claim.

import Definitions.Def_mme_recursive_yz_physical_words
import Definitions.Def_mme_recursive_yz_owned_filters
import Mathlib.Data.Fin.VecNotation

open BigOperators MME MME.RecursiveYZ
set_option autoImplicit false
set_option maxRecDepth 100000

namespace MME.RecStage

/-! Recursive regional data below the released global stage, in step coordinates.

Level three has six regions; region `ρ` hashes the 88 positive terms present in it. Each term
carries its parent grade triple, a weight `w` (its global weight times its region weight), and a
list of cells `(grade triple, split weight, level-2 split parameter)`. Block counts are
`w * D^3` and split masses are `w * α * D^2`, per unit of the global scale.

Level two is one pooled region over the 1104 positive level-2 terms, each with its shape, its
block mass and its split parameter. All weights are numerators over `D = 10^12`. -/

def D : ℕ := 1000000000000

/-- The six elementary supported grade triples of one position. -/
def elemT : List (ℕ × ℕ × ℕ) := [(0, 0, 2), (0, 1, 1), (0, 2, 0), (1, 0, 1), (1, 1, 0), (2, 0, 0)]

def coord (k : ℕ) (t : ℕ × ℕ × ℕ) : ℕ := if k = 0 then t.1 else if k = 1 then t.2.1 else t.2.2

/-- Weight (over `D`) of the level-1 split `e, a - e` of the level-2 shape `a`. -/
def jw (a0 a1 a2 s0 e0 e1 e2 : ℕ) : ℕ :=
  if e0 ≤ a0 ∧ e1 ≤ a1 ∧ e2 ≤ a2 ∧ a0 - e0 ≤ 2 ∧ a1 - e1 ≤ 2 ∧ a2 - e2 ≤ 2 then
    if a0 = 0 ∨ a1 = 0 ∨ a2 = 0 then
      if a0 = 4 ∨ a1 = 4 ∨ a2 = 4 then D
      else if a0 = 3 ∨ a1 = 3 ∨ a2 = 3 then D / 2
      else if e0 = a0 - e0 ∧ e1 = a1 - e1 ∧ e2 = a2 - e2 then D - 2 * s0 else s0
    else if e0 = 2 ∨ e1 = 2 ∨ e2 = 2 ∨ a0 - e0 = 2 ∨ a1 - e1 = 2 ∨ a2 - e2 = 2 then s0
    else D / 2 - s0
  else 0

/-- Weight (over `D`) of the mode-`k` complete level-2 word `(w0, w1)` of a child of shape `a`. -/
def childW (a0 a1 a2 s0 k w0 w1 : ℕ) : ℕ :=
  (elemT.map fun e ↦
    if coord k e = w0 ∧ coord k (a0 - e.1, a1 - e.2.1, a2 - e.2.2) = w1 then
      jw a0 a1 a2 s0 e.1 e.2.1 e.2.2 else 0).sum

/-- A triple with the prescribed total, equal to `(a, b, total - a - b)` when `a + b ≤ total`. -/
def normTriple (total a b : ℕ) : Fin 3 → ℕ :=
  ![min a total, min b (total - min a total), total - min a total - min b (total - min a total)]

theorem normTriple_sum (total a b : ℕ) :
    normTriple total a b 0 + normTriple total a b 1 + normTriple total a b 2 = total := by
  simp only [normTriple, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  omega

