private lemma _root_.WeierstrassCurve.eval_Ψ₃_eq' (x : R) :
    (W.Ψ₃).eval x = 3 * x ^ 4 + W.b₂ * x ^ 3 + 3 * W.b₄ * x ^ 2 + 3 * W.b₆ * x + W.b₈ := by
  rw [Ψ₃]
  simp only [eval_C, eval_X, eval_add, eval_mul, eval_pow, eval_ofNat]

