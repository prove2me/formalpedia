section
-- Source module: Solutions.J6SegVal6
/-!
# B-line value bounds 6: `ValNeed6` (assembly)

* `valAx6`: one axis, from `TabB` (the stage tables `≤ 2^(Q+R+2)`), `JAx6` and `ValCond6`.
* **`valNeed6_of`**: `ChunkTabBnd6 P → JNeed6 P → ∀ ap, ValCond6 ap → ValNeed6 P ap`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

/-- The exponent arithmetic (pure). -/
theorem expo_arith {Q R ℓ wA wC xA xC xbA xbC bcA bcC kA kC : ℕ}
    (h7 : 7 * (R + 2) ≤ Q + 13) (hℓ : ℓ < Q)
    (c1 : 9 ≤ wA) (c2 : 29 ≤ wC) (c3 : xbA + 2 ≤ wA) (c4 : xbC + 5 ≤ wC) (c5 : 6 ≤ xA)
    (c6 : 17 ≤ xC) (c7 : 5 ≤ xbA) (c8 : 17 ≤ xbC) (c9 : 1 ≤ bcA) (c10 : 4 ≤ bcC)
    (c11 : 2 * xbA + bcA + 2 ≤ kA) (c12 : 2 * xbC + bcC + 6 ≤ kC) :
    let eY := Q + 1 + 7 * (R + 2) + 2 * ℓ
    let eW := eY + 1 + 2 * Q + 4
    let eY2 := eW + 7 * (R + 2) + 2 * ℓ
    let wd := wA * Q + wC
    let Xb := xbA * Q + xbC
    Q + 1 + 1 ≤ wd ∧ eY + 1 ≤ wd ∧ eW + 1 ≤ wd ∧ eY2 + 1 ≤ wd ∧
    Q + 1 ≤ xA * Q + xC ∧ eW ≤ xA * Q + xC ∧
    max (eY + 1) Q + Q + 4 ≤ Xb ∧ Q + 4 ≤ bcA * Q + bcC ∧
    2 * Xb + 2 * Q + (bcA * Q + bcC) + 6 ≤ kA * Q + kC ∧
    Q ≤ Xb ∧ Xb + 2 * Q + 4 + 1 ≤ wd ∧ Q ≤ eY + 1 := by
  intro eY eW eY2 wd Xb
  have m1 : 9 * Q ≤ wA * Q := Nat.mul_le_mul_right Q c1
  have m2 : (xbA + 2) * Q ≤ wA * Q := Nat.mul_le_mul_right Q c3
  have m3 : 6 * Q ≤ xA * Q := Nat.mul_le_mul_right Q c5
  have m4 : 5 * Q ≤ xbA * Q := Nat.mul_le_mul_right Q c7
  have m5 : 1 * Q ≤ bcA * Q := Nat.mul_le_mul_right Q c9
  have m6 : (2 * xbA + bcA + 2) * Q ≤ kA * Q := Nat.mul_le_mul_right Q c11
  have e2 : (xbA + 2) * Q = xbA * Q + 2 * Q := by ring
  have e6 : (2 * xbA + bcA + 2) * Q = 2 * (xbA * Q) + bcA * Q + 2 * Q := by ring
  rw [e2] at m2; rw [e6] at m6
  have hmax : max (eY + 1) Q = eY + 1 := max_eq_left (by omega)
  simp only [eY, eW, eY2, wd, Xb] at hmax ⊢
  rw [hmax]
  generalize wA * Q = WA at *
  generalize xA * Q = XA at *
  generalize xbA * Q = XBA at *
  generalize bcA * Q = BCA at *
  generalize kA * Q = KA at *
  omega

section ax
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (ap : AxPlan6)

/-- `16 (s+1)^2 < 2^Q` for `p ≥ 3`. -/
theorem s_sq16 {p d s : ℕ} (hp : 3 ≤ p) : 16 * (s + 1) ^ 2 < 2 ^ segPF p d s := by
  have h1 := le_NF_s d s
  have h2 := Nat.lt_size_self (NF d s)
  have h3 : 16 * 2 ^ Nat.size (NF d s) ≤ 2 ^ segPF p d s := by
    rw [show (16 : ℕ) = 2 ^ 4 by norm_num, ← pow_add]
    exact Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega)
  omega

/-- The counter bound fits in `Q` bits: `size (G + 2w + 3s² + 2ws + 10s) ≤ Q`. -/
theorem bc_le' {G w s Q : ℕ} (hG : G ≤ 2 * s + 1) (hw : w ≤ s) (hs : 16 * (s + 1) ^ 2 < 2 ^ Q) :
    Nat.size (G + 2 * w + 3 * s ^ 2 + 2 * w * s + 10 * s) ≤ Q := by
  rw [Nat.size_le]
  have h1 : 2 * w * s ≤ 2 * s * s := Nat.mul_le_mul_right _ (by omega)
  have h2 : G + 2 * w + 3 * s ^ 2 + 2 * w * s + 10 * s ≤ 14 * (s + 1) ^ 2 := by nlinarith
  omega

/-- **One axis.** -/
theorem valAx6_sol_aux (hc : ValCond6 ap)
    (hT : TabB (2 ^ (axQ6 P n src k + (axR6 P n + 2))) (axl6 P n)
      (TT (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)))
    (hJ : JAx6 P n src k) :
    (∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
      GB (axwd6 P n src k ap) (arrS6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrJ6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrW6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrWp6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY26 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrS6 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrWp6 P n src D k L) ∧
      ∀ b < axpre6 P n D k, ∀ c < axpost6 P n D k,
        axJPre6 P n src k ap (lineAt (axG6 P n src k) (axpost6 P n D k) (arrJ6 P n src D k L) b c)) ∧
    (∀ x : List GI, axJPre6 P n src k ap x →
      GB (axwd6 P n src k ap) (liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k)
        (axl6 P n) (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) x)) := by
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12⟩ := hc
  obtain ⟨hws, hJo, hJp⟩ := hJ
  -- the size facts at `Q`
  have hQp : axp6 P n + 1 ≤ axQ6 P n src k := p_succ_le_Q _ _ _
  have h7 : 7 * (axR6 P n + 2) ≤ axQ6 P n src k + 13 := sevenR_le_Q _ _ _
  have hℓ : axfC6 P n < axQ6 P n src k := log_lam_lt_Q _ _ _
  have hl : axl6 P n = 2 ^ axfC6 P n := rfl
  have hwQ : Nat.size (2 * axw6 P n + 1) ≤ axQ6 P n src k := size_w_le_Q _ _ _
  have hsQ : (axs6 src k + 1) ^ 2 < 2 ^ axQ6 P n src k := s_sq_lt_Q _ _ _
  have hG : axG6 P n src k ≤ 2 * axs6 src k + 1 := by
    have h1 := pow_clog_le (LJ (axs6 src k) (axt6 P n k) (lamP (axd6 P n)) (wF (axd6 P n))).length
    have h2 := LJ_length_le_s (axs6 src k) (axt6 P n k) (lamP (axd6 P n)) (wF (axd6 P n))
    show 2 ^ Nat.clog 2 (LJ (axs6 src k) (axt6 P n k) (lamP (axd6 P n)) (wF (axd6 P n))).length ≤ _
    omega
  have hp3 : 3 ≤ axp6 P n := by
    have := b'P6_pos P n; show 3 ≤ pP6 P n; unfold pP6; omega
  have hBc : Nat.size (axG6 P n src k + 2 * axw6 P n + 3 * axs6 src k ^ 2 +
      2 * axw6 P n * axs6 src k + 10 * axs6 src k) ≤ axQ6 P n src k :=
    bc_le' hG hws (s_sq16 hp3)
  have hBc6 : axBc6 P n src k ap ≤ axQ6 P n src k + ap.bcC := by
    show Nat.size _ + ap.bcC ≤ _; omega
  obtain ⟨a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12⟩ :=
    expo_arith (wA := ap.pl.wA) (wC := ap.pl.wC) (xA := ap.xA) (xC := ap.xC) (xbA := ap.xbA)
      (xbC := ap.xbC) (bcA := ap.bcA) (bcC := ap.bcC) (kA := ap.pl.kA) (kC := ap.pl.kC)
      h7 hℓ c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12
  have hwd : axwd6 P n src k ap = ap.pl.wA * axQ6 P n src k + ap.pl.wC := rfl
  have hX : axX6 P n src k ap = 2 ^ (ap.xA * axQ6 P n src k + ap.xC) := rfl
  have hXb : axXb6 P n src k ap = ap.xbA * axQ6 P n src k + ap.xbC := rfl
  -- the `J` output bound in exponent form
  have hout : ∀ (Bv : ℕ) (x : List GI), axQ6 P n src k ≤ Bv → x.length = axG6 P n src k →
      NLogN.Bnd Bv (x.map Prod.fst) → NLogN.Bnd Bv (x.map Prod.snd) →
      ∀ y ∈ liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
        (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) x,
        PB (2 ^ (Bv + 2 * axQ6 P n src k + 4)) y := by
    intro Bv x hBv hx h1 h2 y hy
    have := hJo Bv x hx h1 h2 y hy
    have hle := out_le (w := axw6 P n) hBv hwQ
    exact ⟨this.1.trans hle, this.2.trans hle⟩
  refine ⟨fun L hLl hL => ?_, fun x hx => ?_⟩
  · set Q := axQ6 P n src k with hQ
    set eY := Q + 1 + 7 * (axR6 P n + 2) + 2 * axfC6 P n with heY
    have hS := val_S P n src D k L hQp hL
    have hY := val_Y P n src D k L hl hT hS
    have hJg := val_J P n src D k L (by positivity) hY
    have hW := val_W P n src D k L (B := 2 ^ eY) (B' := 2 ^ (eY + 1 + 2 * Q + 4))
      (by positivity) (by positivity)
      (fun x hxl hxp => hout (eY + 1) x a12 hxl (bnd_parts hxp).1 (bnd_parts hxp).2) hJg
    have hWp := val_Wp P n src D k L (by positivity) hW
    have hY2 := val_Y2 P n src D k L hl hT hWp
    rw [hwd]
    refine ⟨GB_of_PB a1 hS, GB_of_PB a2 hY, GB_of_PB a2 hJg, GB_of_PB a3 hW, GB_of_PB a3 hWp,
      GB_of_PB a4 hY2, ?_, ?_, ?_⟩
    · rw [hX]; exact AB_of_PB (PB_pow_mono a5 hS)
    · rw [hX]; exact AB_of_PB (PB_pow_mono a6 hWp)
    · intro b _ c _
      have hrow := lineAt_PB (G := axG6 P n src k) (post := axpost6 P n D k) (by positivity) hJg b c
      have hb := bnd_parts hrow
      unfold axJPre6
      rw [hXb]
      refine hJp (eY + 1) _ _ _ ?_ ?_ ?_ _ (length_lineAt' _ _ _ _ _) hb.1 hb.2
      · rw [max_eq_left a12] at a7 ⊢; omega
      · exact Nat.le_add_right _ _
      · unfold axkJ6 kJ6
        have m : Q ≤ ap.bcA * Q := Nat.le_mul_of_pos_left _ c9
        have := a9
        show 2 * (ap.xbA * Q + ap.xbC) + 2 * Q + axBc6 P n src k ap + 6 ≤ ap.pl.kA * Q + ap.pl.kC
        omega
  · obtain ⟨hlen, hD1, hD2⟩ := hx
    have h1 := hD1.bv
    have h2 := hD2.bv
    rw [hXb] at h1 h2
    intro y hy
    have := hout _ x a10 hlen h1 h2 y hy
    rw [hwd]
    exact ⟨(zsz_of_abs this.1).trans a11, (zsz_of_abs this.2).trans a11⟩

end ax

