noncomputable abbrev W : (u i).A.Opens :=
  (p S B u i) ⁻¹ᵁ (PrimeSpectrum.basicOpen (r j) ⊓ PrimeSpectrum.basicOpen (r l))

theorem gA₁_p : gA₁ S B u i j ≫ p S B u i = (v₁ S B u i j).f ≫ Spec.map (CommRingCat.ofHom (algebraMap S (C S B i j))) := by
  show gA₁ S B u i j ≫ (u i).f ≫ alg S B i = _
  rw [← Category.assoc, (gA₁_isPullback S B u i j).w, Category.assoc, specρ₁_alg]

include r hrange in
theorem mem_range_gw_gA₁_iff (x : ↥(u i).A) :
    x ∈ Set.range (gw S B u i j incL ≫ gA₁ S B u i j).base ↔ x ∈ W S r B u i j l := by
  have key : ∀ y : ↥(v₁ S B u i j).A, (y ∈ Set.range (gw S B u i j incL).base ↔
      r l ∉ ((p S B u i).base ((gA₁ S B u i j).base y)).asIdeal) := by
    intro y
    rw [range_eq_preimage_of_isPullback (gw_isPullback S B u i j incL), Set.mem_preimage]
    refine (hrange _).trans ?_
    rw [← Scheme.Hom.comp_apply, gA₁_p, Scheme.Hom.comp_apply]
    exact Iff.rfl
  constructor
  · rintro ⟨z, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact ⟨(mem_range_gA₁_iff S r B u i j _).mp ⟨_, rfl⟩, (key _).mp ⟨z, rfl⟩⟩
  · rintro ⟨hxj, hxl⟩
    obtain ⟨y, rfl⟩ := (mem_range_gA₁_iff S r B u i j x).mpr hxj
    obtain ⟨z, rfl⟩ := (key y).mpr hxl
    exact ⟨z, by rw [Scheme.Hom.comp_apply]⟩

noncomputable def ω : ((W S r B u i j l : (u i).A.Opens) : Scheme.{0}) ≅ (w S B u i j incL).A :=
  haveI := isOpenImmersion_gA₁ S r B u i j
  haveI := isOpenImmersion_gw S B u i j incL
  IsOpenImmersion.isoOfRangeEq (W S r B u i j l).ι (gw S B u i j incL ≫ gA₁ S B u i j)
    (by rw [Scheme.Opens.range_ι]; exact (Set.ext (mem_range_gw_gA₁_iff S r B u i j l incL hrange)).symm)

