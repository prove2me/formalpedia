theorem tmod_nat (a b : ℕ) : ((a : ℤ)).tmod (b : ℤ) = ((a % b : ℕ) : ℤ) := rfl
theorem tdiv_nat (a b : ℕ) : ((a : ℤ)).tdiv (b : ℤ) = ((a / b : ℕ) : ℤ) := rfl

theorem clean_of_regs {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
