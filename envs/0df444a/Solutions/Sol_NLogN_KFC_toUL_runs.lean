    have hs2B : s2.G uB = .int (d : ℤ) :: (ints (D.map (fun d : ℕ => (d : ℤ))) ++ .mark :: LB) := by
      rcases (by omega : d = 0 ∨ d = 1) with rfl | rfl <;> simp [s2, s1, Ne.symm hXB, hB]
    have h3 := IRuns.drop (I := I) (iprog := iprog) (s := s2) (i := uB) (a := (d : ℤ)) hs2B
    have hz : zsz (d : ℤ) ≤ 1 := by
      rcases (by omega : d = 0 ∨ d = 1) with rfl | rfl
      · simp [zsz_zero]
      · simp [zsz_one]
    have h4 := ih (2 * c + d) (s2.upd uB (ints (D.map (fun d : ℕ => (d : ℤ))) ++ .mark :: LB))
      (fun x hx => hD x (by simp [hx])) (by simp) (by simp [Ne.symm hXB, hXB, hs2X])
      (by
        rcases (by omega : d = 0 ∨ d = 1) with rfl | rfl <;>
          simpa +decide [s2, s1, Ne.symm hXY] using hY)
    have hb := IRuns.loopT (I := I) (iprog := iprog) (i := uB) (f := isIn)
      (p := (.seq (dbl X uY) (.seq (.ite uB isPos (.op (.mark X)) .skip) (.op (.drop uB)))))
      (s := s) (by rw [IState.cl_def, hB]; exact isIn_int _ _) (h1.seq (h2.seq h3)) h4
    refine hb.mono' ?_ ?_
    · have e : (2 * c + d) * 2 ^ D.length + valM D = c * 2 ^ (d :: D).length + valM (d :: D) := by
        simp only [List.length_cons, valM, pow_succ]; ring
      rw [e]
      rcases (by omega : d = 0 ∨ d = 1) with rfl | rfl <;>
      · simp only [s2, s1]
        apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
          split_ifs <;> simp_all
    · simp only [List.length_cons, valM, pow_succ]
      have e1 : (2 * c + d) * 2 ^ D.length = 2 * (c * 2 ^ D.length) + d * 2 ^ D.length := by ring
      have e2 : c * (2 ^ D.length * 2) = 2 * (c * 2 ^ D.length) := by ring
      rw [e1, e2]
      have hp : 1 ≤ 2 ^ D.length := Nat.one_le_two_pow
      have hc : c ≤ c * 2 ^ D.length := Nat.le_mul_of_pos_right _ hp
      have hdd : d ≤ d * 2 ^ D.length := Nat.le_mul_of_pos_right _ hp
      omega

theorem length_digits_two_le : ∀ n : ℕ, (Nat.digits 2 n).length ≤ n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · simp
  · rw [digits_two_succ n hpos, List.length_cons]
    have := ih (n / 2) (by omega); omega

end KFC

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open IntMul
open NLogN.KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {A X : Fin NLogN.HS} (hAK : A ≠ NLogN.KFC.uK) (hXK : X ≠ NLogN.KFC.uK) (hXR : X ≠ NLogN.KFC.uR) (hXY : X ≠ NLogN.KFC.uY)
    (hXB : X ≠ NLogN.KFC.uB) (s : NLogN.IState NLogN.HS) (n : ℕ) (LA : List NLogN.Item) (hA : s.G A = .int n :: LA)
    (hX : NLogN.KFC.NM (s.G X)) :
    NLogN.IRuns I iprog (NLogN.KFC.toUL A X) s (s.upd X (NLogN.KFC.marks n ++ s.G X)) (NLogN.KFC.cUL n) := by
  have h1 := NLogN.IRuns.dup (I := I) (iprog := iprog) (s := s) hAK hA
  set s1 := s.upd NLogN.KFC.uK (.int n :: s.G NLogN.KFC.uK)
  have h2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := s1) NLogN.KFC.uR 2
  set s2 := s1.upd NLogN.KFC.uR (.int 2 :: s1.G NLogN.KFC.uR)
  have h3 := NLogN.IRuns.mark (I := I) (iprog := iprog) (s := s2) NLogN.KFC.uB
  set s3 := s2.upd NLogN.KFC.uB (.mark :: s2.G NLogN.KFC.uB)
  have h4 := NLogN.KFC.splitL_runs (I := I) (iprog := iprog) n s3 (s.G NLogN.KFC.uK) (s.G NLogN.KFC.uR)
    (by simp +decide [s3, s2, s1]) (by simp +decide [s3, s2, s1])
  set D := (Nat.digits 2 n).reverse
  set s4 := (s3.upd NLogN.KFC.uK (.int 0 :: s.G NLogN.KFC.uK)).upd NLogN.KFC.uB (NLogN.ints (D.map (fun d : ℕ => (d : ℤ))) ++ s3.G NLogN.KFC.uB)
  have h5 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := s4) (i := NLogN.KFC.uK) (a := 0) (L := s.G NLogN.KFC.uK)
    (by simp +decide [s4])
  have h6 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := s4.upd NLogN.KFC.uK (s.G NLogN.KFC.uK)) (i := NLogN.KFC.uR) (a := 2)
    (L := s.G NLogN.KFC.uR) (by simp +decide [s4, s3, s2, s1])
  set s6 := (s4.upd NLogN.KFC.uK (s.G NLogN.KFC.uK)).upd NLogN.KFC.uR (s.G NLogN.KFC.uR)
  have h7 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := s6) NLogN.KFC.uY 0
  set s7 := s6.upd NLogN.KFC.uY (.int 0 :: s6.G NLogN.KFC.uY)
  have h8 := NLogN.KFC.bld_runs (I := I) (iprog := iprog) hXY hXB (s.G NLogN.KFC.uB) (s.G X) hX D 0 s7
    (fun d hd => Nat.digits_lt_base (by norm_num) (List.mem_reverse.1 hd))
    (by simp +decide [s7, s6, s4, s3, s2, s1])
    (by simp +decide [s7, s6, s4, s3, s2, s1, hXK, hXR, hXY, hXB])
    (by simp +decide [s7]; exact NLogN.KFC.NM_int _ _)
  have hv : 0 * 2 ^ D.length + NLogN.KFC.valM D = n := by
    simp only [Nat.zero_mul, Nat.zero_add, D, NLogN.KFC.valM_reverse, Nat.ofDigits_digits]
  rw [hv] at h8
  set s8 := (s7.upd NLogN.KFC.uB (.mark :: s.G NLogN.KFC.uB)).upd X (NLogN.KFC.marks n ++ s.G X)
  have h9 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := s8) (i := NLogN.KFC.uY) (a := 0) (L := s.G NLogN.KFC.uY)
    (by simp +decide [s8, s7, s6, s4, s3, s2, s1, Ne.symm hXY])
  have h10 := NLogN.IRuns.unmark (I := I) (iprog := iprog) (s := s8.upd NLogN.KFC.uY (s.G NLogN.KFC.uY)) (i := NLogN.KFC.uB)
    (L := s.G NLogN.KFC.uB) (by simp +decide [s8, Ne.symm hXB])
  refine (h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq (h8.seq (h9.seq
    h10))))))))).mono' ?_ ?_
  · clear h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 hv
    simp only [s8, s7, s6, s4, s3, s2, s1]
    clear * - hXK hXR hXY hXB
    apply NLogN.IState.ext'
    · intro x; simp only [NLogN.IState.upd_G]
      split_ifs <;> (try subst_vars) <;> simp +decide at *
    · rfl
    · rfl
  · have hL : (Nat.digits 2 n).length ≤ n := NLogN.KFC.length_digits_two_le n
    have hz2 : NLogN.zsz (2 : ℤ) = 2 := by
      have := NLogN.zsz_two_pow 1; simpa using this
    have hd := NLogN.dupCost_le (NLogN.zsz (n : ℤ))
    simp only [NLogN.zsz_zero, hz2, NLogN.KFC.cUL, D, List.length_reverse]
    omega
end
