    (y : Pic0.torsion (ResidueField ↥A) (modularFunctionFieldC (ResidueField ↥A) M) p)
    (hy : (y : Pic0 (ResidueField ↥A) (modularFunctionFieldC (ResidueField ↥A) M)) =
