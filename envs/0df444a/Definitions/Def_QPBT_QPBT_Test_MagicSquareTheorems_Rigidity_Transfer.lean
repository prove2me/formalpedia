/-- Alice's dilated postprocessed effect, typed on the enlarged local space
`ℂ^{ιA × Option MsAnswer}`.  Formalization-only abbreviation. -/
abbrev dilatedEffectA (S : _root_.MIPStarRE.QPBT.Strategy _root_.MIPStarRE.QPBT.msGame) (x : _root_.MIPStarRE.QPBT.MsType) (f : _root_.MIPStarRE.QPBT.MsAnswer → ZMod 2)
    (b : ZMod 2) : _root_.LIDT.MIPStarRE.Quantum.Op (S.ιA × Option _root_.MIPStarRE.QPBT.MsAnswer) :=
  (((_root_.MIPStarRE.QPBT.MagicSquareRigidity.msDilatedStrategy S).A x).postprocess f).effect b

/-- Bob's dilated postprocessed effect, typed on the enlarged local space
`ℂ^{ιB × Option MsAnswer}`.  Formalization-only abbreviation. -/
abbrev dilatedEffectB (S : _root_.MIPStarRE.QPBT.Strategy _root_.MIPStarRE.QPBT.msGame) (y : _root_.MIPStarRE.QPBT.MsType) (f : _root_.MIPStarRE.QPBT.MsAnswer → ZMod 2)
    (b : ZMod 2) : _root_.LIDT.MIPStarRE.Quantum.Op (S.ιB × Option _root_.MIPStarRE.QPBT.MsAnswer) :=
  (((_root_.MIPStarRE.QPBT.MagicSquareRigidity.msDilatedStrategy S).B y).postprocess f).effect b





