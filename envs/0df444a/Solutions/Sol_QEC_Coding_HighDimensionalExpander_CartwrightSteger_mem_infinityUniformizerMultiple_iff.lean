theorem _root_.solution
    (P : BasePrime) (r : Rank)
    (X : Matrix (Fin r.matrixRank) (Fin r.matrixRank)
      (SplittingFunctionField P r)) :
    X ∈ InfinityUniformizerMultiple P r ↔
      ∃ Y, Y ∈ InfinityCyclicLattice P r ∧
        X = (infinityUniformizer P r) • Y := by
  constructor
  · intro hX
    rw [InfinityUniformizerMultiple] at hX
    refine Submodule.span_induction (p := fun X _ =>
      ∃ Y, Y ∈ InfinityCyclicLattice P r ∧
        X = (infinityUniformizer P r) • Y) ?_ ?_ ?_ ?_ hX
    · intro X hX
      exact hX
    · exact ⟨0, (InfinityCyclicLattice P r).zero_mem, by simp⟩
    · rintro X Y hX hY ⟨A, hA, rfl⟩ ⟨B, hB, rfl⟩
      exact ⟨A + B, (InfinityCyclicLattice P r).add_mem hA hB, by
        rw [smul_add]⟩
    · rintro a X hX ⟨Y, hY, rfl⟩
      exact ⟨a • Y, (InfinityCyclicLattice P r).smul_mem a hY, by
        rw [smul_smul, mul_comm, ← smul_smul]⟩
  · rintro ⟨Y, hY, rfl⟩
    exact infinityUniformizer_smul_mem_multiple P r hY
end QEC.Coding.HighDimensionalExpander.CartwrightSteger
