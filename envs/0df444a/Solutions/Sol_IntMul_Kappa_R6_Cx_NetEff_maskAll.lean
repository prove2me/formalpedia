-- Source module: Solutions.R6CxNetMask
/-!
# The scalar identity of the local program by a kernel mask simulation

The gate DAG `L` of the local program is run on **spread** inputs: slot `src t` receives
`256^t` (the coefficient vector `e_t` in base 256), each gate op `a_q += a_r` adds the encoded
vectors, and every intermediate vector is checked to have digits in `{0, 1}` (`Nat.land v LO = v`).
The readout check compares `∑ k · a` with `2 · 256^S` for every triple `S`.

* `vget` / `vset`: one value per leaf of a binary tree (recursor form, raw primitives).
* `enc f = ∑_{t < NV} f t · 256^t`; `simK_sound`: the kernel run encodes `runP ops C`, the run on
  coefficient vectors, and keeps all digits in `{0, 1}`.
* `readChk_sound`: the readout identity on coefficient vectors.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetMask

open NetBT NetSpec NetLoc Finset

noncomputable section

/-! ## Value trees -/

lemma vget_leaf (v p : ℕ) : vget (.leaf v) p = v := rfl
lemma vget_node (l r : BT) (p : ℕ) :
    vget (.node l r) p = cond (Nat.beq (p % 2) 0) (vget l (p / 2)) (vget r (p / 2)) := rfl
lemma vset_leaf (v p x : ℕ) : vset (.leaf v) p x = .leaf x := rfl
lemma vset_node (l r : BT) (p x : ℕ) :
    vset (.node l r) p x = cond (Nat.beq (p % 2) 0) (.node (vset l (p / 2) x) r) (.node l (vset r (p / 2) x)) :=
  rfl

theorem vget_vset : ∀ (d : ℕ) (t : BT), t.wf d = true → ∀ p p', p < 2 ^ d → p' < 2 ^ d →
    ∀ x, vget (vset t p x) p' = if p = p' then x else vget t p'
  | 0, .leaf v, _, p, p', hp, hp', x => by
    have : p = 0 := by simpa using hp
    have : p' = 0 := by simpa using hp'
    subst_vars; simp [vget_leaf, vset_leaf]
  | d + 1, .node l r, hw, p, p', hp, hp', x => by
    simp only [BT.wf, Bool.and_eq_true] at hw
    have hp2 : p / 2 < 2 ^ d := by rw [pow_succ] at hp; omega
    have hp2' : p' / 2 < 2 ^ d := by rw [pow_succ] at hp'; omega
    have key : p = p' ↔ (p % 2 = p' % 2 ∧ p / 2 = p' / 2) := by omega
    rcases Nat.mod_two_eq_zero_or_one p with h0 | h0 <;>
      rcases Nat.mod_two_eq_zero_or_one p' with h1 | h1
    · simp only [vset_node, vget_node, h0, h1, Nat.beq_refl, cond_true]
      rw [vget_vset d l hw.1 _ _ hp2 hp2' x]
      simp only [key, h0, h1, true_and]
    · simp only [vset_node, vget_node, h0, h1, Nat.beq_refl, cond_true,
        show Nat.beq 1 0 = false from rfl, cond_false]
      rw [if_neg (by omega)]
    · simp only [vset_node, vget_node, h0, h1, Nat.beq_refl, cond_true,
        show Nat.beq 1 0 = false from rfl, cond_false]
      rw [if_neg (by omega)]
    · simp only [vset_node, vget_node, h0, h1, show Nat.beq 1 0 = false from rfl, cond_false]
      rw [vget_vset d r hw.2 _ _ hp2 hp2' x]
      simp only [key, h0, h1, true_and]
  | 0, .node _ _, hw, _, _, _, _, _ => by simp [BT.wf] at hw
  | _ + 1, .leaf _, hw, _, _, _, _, _ => by simp [BT.wf] at hw

theorem wf_vset : ∀ (d : ℕ) (t : BT), t.wf d = true → ∀ p x, (vset t p x).wf d = true
  | 0, .leaf v, _, _, _ => rfl
  | d + 1, .node l r, hw, p, x => by
    simp only [BT.wf, Bool.and_eq_true] at hw
    rw [vset_node]
    cases Nat.beq (p % 2) 0 <;> simp [BT.wf, wf_vset d l hw.1, wf_vset d r hw.2, hw.1, hw.2]
  | 0, .node _ _, hw, _, _ => by simp [BT.wf] at hw
  | _ + 1, .leaf _, hw, _, _ => by simp [BT.wf] at hw

lemma wf_mkR : ∀ d, (mkR d).wf d = true
  | 0 => rfl
  | d + 1 => by
    show (BT.node (mkR d) (mkR d)).wf (d + 1) = true
    simp [BT.wf, wf_mkR d]

lemma vget_mkR : ∀ d p, vget (mkR d) p = 0
  | 0, p => rfl
  | d + 1, p => by
    show vget (.node (mkR d) (mkR d)) p = 0
    rw [vget_node]; cases Nat.beq (p % 2) 0 <;> exact vget_mkR d _

/-! ## Bit vectors -/

lemma bvec_lor {a b : ℕ} (h : Nat.land a b = 0) : bvec (Nat.lor a b) = bvec a + bvec b := by
  funext u
  have hu := congrArg (fun n => n.testBit u) h
  simp only [show Nat.land a b = a &&& b from rfl, Nat.testBit_and, Nat.zero_testBit] at hu
  simp only [bvec, Pi.add_apply, show Nat.lor a b = a ||| b from rfl, Nat.testBit_or]
  cases ha : a.testBit u <;> cases hb : b.testBit u <;> simp_all

/-! ## The run on coefficient vectors and its kernel form -/

lemma NR_lt : NR < 2 ^ 16 := by norm_num [NR]

theorem simK_sound (k : BT → Bool) :
    ∀ (ops : List (ℕ × ℕ)) (t : BT) (C : ℕ → ℕ → ℕ), Enc t C → simK k ops t = true →
      ∃ t', Enc t' (runP ops C) ∧ k t' = true ∧ ∀ o ∈ ops, o.1 < NR ∧ o.2 < NR ∧ o.1 ≠ o.2
  | [], t, C, hE, hk => ⟨t, hE, hk, fun _ h => absurd h List.not_mem_nil⟩
  | o :: ops, t, C, hE, hk => by
    have hk' : cond (Nat.blt o.1 NR && Nat.blt o.2 NR && !(Nat.beq o.1 o.2))
        (cond (Nat.beq (Nat.land (vget t o.1) (vget t o.2)) 0)
          (simK k ops (vset t o.1 (Nat.lor (vget t o.1) (vget t o.2)))) false) false = true := hk
    cases hr : (Nat.blt o.1 NR && Nat.blt o.2 NR && !(Nat.beq o.1 o.2))
    · rw [hr] at hk'; simp at hk'
    rw [hr, cond_true] at hk'
    simp only [Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hr
    have hq : o.1 < 2 ^ 16 := lt_trans hr.1.1 NR_lt
    have hr2 : o.2 < 2 ^ 16 := lt_trans hr.1.2 NR_lt
    cases hb : Nat.beq (Nat.land (vget t o.1) (vget t o.2)) 0
    · rw [hb] at hk'; simp at hk'
    rw [hb, cond_true] at hk'
    have hd := Nat.eq_of_beq_eq_true hb
    set C' := Function.update C o.1 (C o.1 + C o.2) with hC'
    have hE' : Enc (vset t o.1 (Nat.lor (vget t o.1) (vget t o.2))) C' := by
      refine ⟨wf_vset 16 t hE.1 _ _, fun q hq' => ?_⟩
      rw [vget_vset 16 t hE.1 _ _ hq hq']
      by_cases e : o.1 = q
      · subst e; rw [if_pos rfl, bvec_lor hd, hC', Function.update_self, hE.2 _ hq, hE.2 _ hr2]
      · rw [if_neg e, hC', Function.update_of_ne (Ne.symm e), hE.2 q hq']
    obtain ⟨t', h1, h2, h3⟩ := simK_sound k ops _ C' hE' hk'
    refine ⟨t', h1, h2, fun o' ho' => ?_⟩
    rcases List.mem_cons.1 ho' with rfl | ho'
    · exact ⟨hr.1.1, hr.1.2, fun e => by rw [e, Nat.beq_refl] at hr; exact absurd hr.2 (by simp)⟩
    · exact h3 o' ho'

/-! ## Placement of the inputs -/

lemma place_support (src : ℕ → ℕ) : ∀ n q t, n ≤ t → place src n q t = 0
  | 0, q, t, _ => rfl
  | n + 1, q, t, h => by
    simp only [place]
    by_cases e : q = src n
    · subst e; rw [Function.update_self]
      simp only [Pi.add_apply, place_support src n _ t (by omega)]
      rw [if_neg (by omega)]
    · rw [Function.update_of_ne e]; exact place_support src n q t (by omega)

theorem placeK_enc (src : ℕ → ℕ) (hsrc : ∀ t, src t < 2 ^ 16) :
    ∀ n, Enc (placeK src n) (place src n)
  | 0 => ⟨wf_mkR 16, fun q _ => by
      show (fun _ => 0) = bvec (vget (mkR 16) q)
      rw [vget_mkR]; funext u; simp [bvec]⟩
  | n + 1 => by
    have ih := placeK_enc src hsrc n
    have hs : src n < 2 ^ 16 := hsrc n
    refine ⟨wf_vset 16 _ ih.1 _ _, fun q hq => ?_⟩
    show _ = bvec (vget (vset (placeK src n) (src n) (Nat.lor (vget (placeK src n) (src n)) (Nat.pow 2 n))) q)
    rw [vget_vset 16 _ ih.1 _ _ hs hq]
    simp only [place]
    by_cases e : src n = q
    · subst e
      have h0 : (vget (placeK src n) (src n)).testBit n = false := by
        have := congrFun (ih.2 _ hs) n
        rw [place_support src n _ n le_rfl] at this
        unfold bvec at this
        by_contra hc
        rw [if_pos (by simpa using hc)] at this
        exact absurd this (by norm_num)
      have hd : Nat.land (vget (placeK src n) (src n)) (Nat.pow 2 n) = 0 := by
        apply Nat.eq_of_testBit_eq; intro u
        simp only [show ∀ a b : ℕ, Nat.land a b = a &&& b from fun _ _ => rfl, Nat.testBit_and,
          Nat.zero_testBit, show Nat.pow 2 n = 2 ^ n from rfl, Nat.testBit_two_pow]
        by_cases hu : n = u
        · subst hu; simp [h0]
        · simp [hu]
      rw [if_pos rfl, Function.update_self, bvec_lor hd, ← ih.2 _ hs]
      congr 1
      funext u
      simp only [bvec, show Nat.pow 2 n = 2 ^ n from rfl, Nat.testBit_two_pow]
      by_cases hu : u = n
      · subst hu; simp
      · simp [hu, Ne.symm hu]
    · rw [if_neg e, Function.update_of_ne (Ne.symm e), ih.2 q hq]

/-! ## The readout check (bit-sliced counters) -/

lemma allR_spec {α : Type} {p : α → Bool} : ∀ {l : List α}, allR p l = true → ∀ a ∈ l, p a = true
  | [], _, a, ha => absurd ha List.not_mem_nil
  | b :: l, h, a, ha => by
    have h' : (p b && allR p l) = true := h
    rw [Bool.and_eq_true] at h'
    rcases List.mem_cons.1 ha with rfl | ha
    · exact h'.1
    · exact allR_spec h'.2 a ha

/-! ## The check for the data -/

lemma gqs_append (a b : List ℕ) : gqs (a ++ b) = gqs a ++ gqs b := by
  simp [gqs, gatesOf, List.flatMap_append]

lemma runP_append (a b : List (ℕ × ℕ)) (C : ℕ → ℕ → ℕ) : runP (a ++ b) C = runP b (runP a C) := by
  simp [runP, List.foldl_append]

end

end IntMul.Kappa.R6.Cx.NetMask

