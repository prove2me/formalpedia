  jl : ∃ L, st.G bJL = .int ((2 * s : ℕ) : ℤ) :: L
  jn : ∃ L, st.G bJN = .int (HvdH.jIter p s t α : ℤ) :: L
  w1 : ∃ R, st.G bW1 = ints (cTab s).flatten ++ R
