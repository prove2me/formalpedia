set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Slab

open IntMul NLogN

theorem monoSrc_sel {s t N : ℕ} (hst : s ≤ t) (htN : t ≤ N) : MonoSrc N N (J6Seg.selSrc s t) := by
  refine ⟨fun l hl k hk => ?_, fun l₁ l₂ k₁ k₂ h12 _ h1 h2 => ?_⟩
  · unfold J6Seg.selSrc at hk
    split_ifs at hk with h
    · cases hk; exact lt_of_lt_of_le (J6Seg.rowSel_lt hst h) htN
  · unfold J6Seg.selSrc at h1 h2
    split_ifs at h1 h2
    cases h1; cases h2
    unfold J6Seg.rowSel
    exact Nat.div_le_div_right (by nlinarith)

theorem monoSrc_j {s t lam w N G : ℕ} (hsN : s ≤ N) : MonoSrc N G (J6Seg.jSrc s t lam w) := by
  refine ⟨fun l hl k hk => ?_, fun l₁ l₂ k₁ k₂ h12 _ h1 h2 => ?_⟩
  · unfold J6Seg.jSrc at hk
    split_ifs at hk with h
    · cases hk; exact lt_of_lt_of_le (J6Seg.LJ_getD_lt h) hsN
  · unfold J6Seg.jSrc at h1 h2
    split_ifs at h1 h2 with ha hb
    cases h1; cases h2
    rw [List.getD_eq_getElem _ _ ha, List.getD_eq_getElem _ _ hb]
    exact (List.pairwise_iff_getElem.1 J6Seg.LJ_sorted _ _ ha hb h12).le

theorem monoSrc_sc {s t lam w N G : ℕ} (hG : (J6Seg.LJ s t lam w).length ≤ G) :
    MonoSrc G N (J6Seg.scSrc s t lam w) := by
  refine ⟨fun l hl k hk => ?_, fun l₁ l₂ k₁ k₂ h12 _ h1 h2 => ?_⟩
  · unfold J6Seg.scSrc at hk
    split_ifs at hk with h
    · cases hk; exact lt_of_lt_of_le (List.idxOf_lt_length_of_mem h) hG
  · unfold J6Seg.scSrc at h1 h2
    split_ifs at h1 h2 with ha hb
    cases h1; cases h2
    by_contra hc
    push_neg at hc
    have i1 := List.idxOf_lt_length_of_mem ha
    have i2 := List.idxOf_lt_length_of_mem hb
    have := List.pairwise_iff_getElem.1 J6Seg.LJ_sorted _ _ i2 i1 hc
    rw [List.getElem_idxOf i1, List.getElem_idxOf i2] at this
    omega

theorem zsz_argO_le (p s t α l : ℕ) : zsz (argO p s t α l) ≤ 2 * p + 6 := by
  unfold argO
  split_ifs
  · apply zsz_le_of_lt
    have h1 := NLogN.BD.dTilde_natAbs_le p s t α l
    have h2 : p < 2 ^ p := Nat.lt_two_pow_self
    have h3 : (2 : ℕ) ^ (2 * p + 6) = 64 * 2 ^ p * 2 ^ p := by ring
    rw [h3]
    calc (IntMul.HvdH.dTilde p s t α l).natAbs ≤ (4 * p + 35) * 2 ^ p := h1
      _ < 64 * 2 ^ p * 2 ^ p := Nat.mul_lt_mul_of_pos_right (by omega) (by positivity)
  · rw [zsz_zero]; omega

