-- title:
--   Extract homogeneous coefficients from ideal membership
-- statement:
--   From membership of a positive coordinate power in an ideal generated by polynomials of common weighted degree D, extract a representation whose coefficients all have the required degree difference. This isolates homogeneous-component extraction; the parent chooses exponents and assembles these representations coordinatewise.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.homogeneous_mem_span_coefficients
    {d k : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Real) (hD : 0 < D) (g : Fin k → MvPolynomial (Fin d) Complex)
    (hhom : ∀ j, (g j).IsWeightedHomogeneous (fun i => (w i : Real)) D)
    (J : Ideal (MvPolynomial (Fin d) Complex))
    (hspan : Ideal.span (Set.range g) = J)
    (i : Fin d) (n : Nat) (hn : 0 < n)
    (hmem : (MvPolynomial.X i : MvPolynomial (Fin d) Complex) ^ n ∈ J) :
    ∃ c : Fin k → MvPolynomial (Fin d) Complex,
      (MvPolynomial.X i : MvPolynomial (Fin d) Complex) ^ n =
        ∑ j : Fin k, c j * g j ∧
      ∀ j, (c j).IsWeightedHomogeneous (fun l => (w l : Real))
        ((n : Real) * (w i : Real) - D) := by sorry
