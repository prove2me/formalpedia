section
-- Source module: Solutions.J6SegGeom
/-!
# Segmented inverse (S2): exact structure of the resampling system (report L1, L2, L4, L8 tail)

Entries of `N = I + E` are `eEx s t α l h = e^{-πα² X/s²}`, `X = eKz s t l h`.
* `eKz_closed` (L1): `X = sn(sn + 2b_{l+h})` with `n = q_{l+h} - q_l`, and `|n| ≥ |h|`, so
  `eEx_le_cf`: `e_{l,h} ≤ e^{-πα²|h|(|h|-1)}` (cross-wrap / cut entries).
* `eEx_recentre` (L2/L4): inside a wrap-free run starting at `c`,
  `e_{c+u, v-u} = D_u T^{(b_c)}_{uv} D_v⁻¹` with `b_c = bOf c / s`, i.e. `MF` of `J6SegToep`.
* `tail_sum` (truncation): `Σ_{|h| > w} e_{l,h} ≤ 4 e^{-πα² w(w+1)}` for `α ≥ 2`.
* `bOf_periodic`, `eEx_periodic`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf

section geom
variable (s t α : ℕ)

/-- Wrap-free runs: `b_{c+j} = b_c + j(t-s)`. -/
lemma bOf_run (c : ℤ) (m : ℕ) (hwf : ∀ j < m, bOf s t (c + j + 1) = bOf s t (c + j) + (t - s)) :
    ∀ j ≤ m, bOf s t (c + j) = bOf s t c + j * (t - s) := by
  intro j
  induction j with
  | zero => intro _; simp
  | succ j ih =>
    intro hj
    have := hwf j (by omega)
    push_cast
    rw [show c + ((j : ℤ) + 1) = c + j + 1 by ring, this, ih (by omega)]
    ring

/-- **Recentred blocks (L2/L4).** Inside a wrap-free run starting at `c`, the entries of `N` are
those of `D T^{(b_c)} D⁻¹`. -/
theorem eEx_recentre (hs : 0 < s) (c : ℤ) (m : ℕ)
    (hwf : ∀ j < m, bOf s t (c + j + 1) = bOf s t (c + j) + (t - s))
    {u v : ℕ} (hu : u ≤ m) (hv : v ≤ m) (huv : u ≠ v) :
    eEx s t α (c + u) ((v : ℤ) - u) =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t c : ℝ) / s) u v := by
  have hr := bOf_run s t c m hwf
  have hbu := hr u hu
  have hbv := hr v hv
  have hne : ((v : ℤ) - u) ≠ 0 := by omega
  unfold eEx MF ddR TF diR
  rw [if_neg hne, ← exp_add, ← exp_add]
  congr 1
  unfold eKz
  rw [show c + (u : ℤ) + ((v : ℤ) - u) = c + v by ring, hbu, hbv]
  have hsR : (s : ℝ) ≠ 0 := by exact_mod_cast hs.ne'
  push_cast
  field_simp
  ring

/-- The diagonal: `D_u T_{uu} D_u⁻¹ = 1`. -/
lemma MF_diag (σ b : ℝ) (u : ℕ) : MF (α : ℝ) σ b u u = 1 := by
  unfold MF TF
  simp only [sub_self, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, add_zero,
    neg_zero, exp_zero, mul_one]
  rw [mul_comm]; exact diR_mul_ddR _ _ u

/-! ### Truncation tail -/

end geom

end J6Seg

end

section
-- Source module: Solutions.J6SegGlob
/-!
# Segmented inverse (S2): the resampling system split into blocks, coupling and tail

For a valid block structure (`BlocksOK`: blocks are wrap-free runs `[st i, st i + len i)` that
partition `[0, s)`, coupling width `w ≤ s`):
* `MxG` (the block part of `N`, entries `δ_{ik} + e_{i,k-i}`) and `MiG` (its exact block inverse
  `D T⁻¹ D⁻¹` from the q-LU) satisfy `M M⁻¹ = I` (`hinvG`, via `eEx_recentre`, `MF_mul_MinvF`);
* row sums: `‖M - I‖, ‖Δ‖ ≤ 2^{-α²θ}` (`rowM`, `rowD`), hence `‖M⁻¹‖ ≤ 8/7` when `α²θ ≥ 3`;
* every coupling column lies in the capacitance set `Jlist` (`col_mem`);
* `nsplit`: `(N x)_i = (M x)_i + (Δ x)_i + drop`, `|drop| ≤ 4 e^{-πα² w(w+1)} ‖x‖`;
* `nearN`: `‖N d‖ ≤ ρ ⇒ ‖d‖ ≤ 8ρ/7` (`‖N - I‖ ≤ 1/8`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section glob
variable {s t α : ℕ} {B : Blocks}

lemma mem_blS {i k : ℕ} : k ∈ blS B i ↔ B.st i ≤ k ∧ k < B.st i + B.len i := by
  simp [blS]

lemma blS_self (hB : BlocksOK s t B) {i : ℕ} (hi : i < s) : i ∈ blS B i := by
  have := hB.cover i hi; rw [mem_blS]; omega

lemma blS_lt (hB : BlocksOK s t B) {i k : ℕ} (hi : i < s) (hk : k ∈ blS B i) : k < s := by
  have := hB.cover i hi; rw [mem_blS] at hk; omega

lemma blS_eq (hB : BlocksOK s t B) {i k : ℕ} (hi : i < s) (hk : k ∈ blS B i) :
    blS B k = blS B i := by
  rw [mem_blS] at hk
  obtain ⟨h1, h2⟩ := hB.cons i hi k hk.1 hk.2
  simp only [blS, h1, h2]

lemma MxG_loc (hB : BlocksOK s t B) (hs : 0 < s) {i : ℕ} (hi : i < s) {u v : ℕ}
    (hu : u < B.len i) (hv : v < B.len i) :
    MxG s t α (B.st i + u) (B.st i + v) =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) u v := by
  unfold MxG
  by_cases huv : u = v
  · subst huv
    rw [MF_diag, kd_self]; simp [eEx]
  · have hk : kd (B.st i + u) (B.st i + v) = 0 := by simp [kd]; omega
    rw [hk, zero_add]
    have e1 : (((B.st i + v : ℕ) : ℤ) - ((B.st i + u : ℕ) : ℤ)) = (v : ℤ) - u := by push_cast; ring
    have e2 : (((B.st i + u : ℕ) : ℤ)) = (B.st i : ℤ) + u := by push_cast; ring
    rw [e1, e2]
    exact eEx_recentre s t α hs (B.st i) (B.len i - 1)
      (fun j hj => hB.wf i hi j (by omega)) (by omega) (by omega) huv

lemma kd_add (c u q : ℕ) : kd (c + u) (c + q) = kd u q := by simp [kd]

/-- **`M M⁻¹ = I`** on each block (exact q-LU inverse of the recentred block). -/
theorem hinvG (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 1 ≤ α) {i : ℕ} (hi : i < s)
    {m : ℕ} (hm : m ∈ blS B i) :
    ∑ j ∈ blS B i, MxG s t α i j * MiG s t α B j m = kd i m := by
  obtain ⟨c1, c2, c3⟩ := hB.cover i hi
  rw [mem_blS] at hm
  have hσ : 0 < (α : ℝ) ^ 2 * ((t : ℝ) / s) := by
    have : (0 : ℝ) < α := by exact_mod_cast hα
    have : (0 : ℝ) < (t : ℝ) / s := div_pos (by exact_mod_cast (by omega : 0 < t))
      (by exact_mod_cast hs)
    positivity
  obtain ⟨u0, hu0⟩ : ∃ u0, i = B.st i + u0 := ⟨i - B.st i, by omega⟩
  obtain ⟨q, hq⟩ : ∃ q, m = B.st i + q := ⟨m - B.st i, by omega⟩
  have hu0n : u0 < B.len i := by omega
  have hqn : q < B.len i := by omega
  rw [blS, sum_Ico_eq_sum_range, show B.st i + B.len i - B.st i = B.len i by omega]
  have e : ∀ v ∈ range (B.len i), MxG s t α i (B.st i + v) * MiG s t α B (B.st i + v) m =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) u0 v *
        MinvF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) (B.len i) v q := by
    intro v hv
    rw [mem_range] at hv
    obtain ⟨h1, h2⟩ := hB.cons i hi (B.st i + v) (by omega) (by omega)
    rw [show MxG s t α i (B.st i + v) = MxG s t α (B.st i + u0) (B.st i + v) by rw [← hu0],
      MxG_loc hB hs hi hu0n hv]
    congr 1
    unfold MiG
    rw [h1, h2, hq]
    congr 1 <;> omega
  rw [sum_congr rfl e, MF_mul_MinvF _ _ _ hσ hu0n hqn, hu0, hq, kd_add]

lemma rpow_neg_le_eighth {x : ℝ} (hx : 3 ≤ x) : (2 : ℝ) ^ (-x) ≤ 1 / 8 := by
  have : (2 : ℝ) ^ (-x) ≤ (2 : ℝ) ^ (-3 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  refine this.trans (le_of_eq ?_)
  rw [Real.rpow_neg (by norm_num)]; norm_num

/-- `‖M - I‖ ≤ 2^{-α²θ}` row-wise. -/
theorem rowM (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) {i : ℕ}
    (hi : i < s) : ∑ k ∈ blS B i, |MxG s t α i k - kd i k| ≤ (2 : ℝ) ^ (-xθ s t α) := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have e : ∑ k ∈ blS B i, |MxG s t α i k - kd i k| =
      ∑ h ∈ (blS B i).image (fun k : ℕ => (k : ℤ) - i), eEx s t α i h := by
    rw [sum_image (fun a _ b _ hab => by simpa using hab)]
    refine sum_congr rfl fun k _ => ?_
    simp only [MxG, add_sub_cancel_left]
    exact abs_of_nonneg (eEx_nonneg s t α _ _)
  rw [e]
  exact (hsum.1.sum_le_tsum _ fun h _ => eEx_nonneg s t α _ _).trans hsum.2

/-- `‖Δ‖ ≤ 2^{-α²θ}` row-wise. -/
theorem rowD (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (i : ℕ) :
    ∑ h ∈ Hset B i, |cfG s t α i h| ≤ (2 : ℝ) ^ (-xθ s t α) := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have e : ∑ h ∈ Hset B i, |cfG s t α i h| = ∑ h ∈ Hset B i, eEx s t α i h :=
    sum_congr rfl fun h _ => abs_of_nonneg (eEx_nonneg s t α _ _)
  rw [e]
  exact (hsum.1.sum_le_tsum _ fun h _ => eEx_nonneg s t α _ _).trans hsum.2

/-- **`‖M⁻¹‖ ≤ 8/7`** (applied to a vector) when `α²θ ≥ 3`. -/
theorem MiG_apply (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 1 ≤ α)
    (hx : 3 ≤ xθ s t α) (f : ℕ → ℝ) (F : ℝ) (hF : ∀ k ∈ range s, |f k| ≤ F) {i : ℕ}
    (hi : i < s) : |Mv (blS B) (MiG s t α B) f i| ≤ 8 / 7 * F := by
  have hm := rpow_neg_le_eighth hx
  have key := Miv_bound (blS B) (MxG s t α) (MiG s t α B) (m := 1 / 8) (F := F) (by norm_num)
    (fun k hk => blS_self hB (blS_lt hB hi hk)) (fun k hk => blS_eq hB hi hk)
    (fun k hk q hq => by
      have hk' := blS_lt hB hi hk
      rw [← blS_eq hB hi hk]
      exact hinvG hB hs hst hα hk' (by rw [blS_eq hB hi hk]; exact hq))
    (fun k hk => by
      have hk' := blS_lt hB hi hk
      rw [← blS_eq hB hi hk]
      exact (rowM hB hs hst (by linarith) hk').trans hm)
    f (fun k hk => hF k (mem_range.2 (blS_lt hB hi hk))) (blS_self hB hi)
  rw [show F / (1 - 1 / 8) = 8 / 7 * F by ring] at key
  exact key

/-- Row sums of `M⁻¹`: `Σ_k |M⁻¹_{ik}| ≤ 8/7` (sign-vector trick). -/
theorem MiG_row (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 1 ≤ α)
    (hx : 3 ≤ xθ s t α) {i : ℕ} (hi : i < s) :
    ∑ k ∈ blS B i, |MiG s t α B i k| ≤ 8 / 7 := by
  set f : ℕ → ℝ := fun k => if 0 ≤ MiG s t α B i k then 1 else -1
  have h := MiG_apply hB hs hst hα hx f 1 (fun k _ => by
    simp only [f]; split_ifs <;> simp) hi
  have e : Mv (blS B) (MiG s t α B) f i = ∑ k ∈ blS B i, |MiG s t α B i k| := by
    unfold Mv; refine sum_congr rfl fun k _ => ?_
    simp only [f]; split_ifs with h0
    · rw [abs_of_nonneg h0, mul_one]
    · rw [abs_of_neg (not_le.1 h0)]; ring
  rw [e, abs_of_nonneg (sum_nonneg fun _ _ => abs_nonneg _)] at h
  linarith

lemma Hset_card (i : ℕ) : (Hset B i).card ≤ 2 * B.w + 1 := by
  unfold Hset
  exact (card_filter_le _ _).trans (card_image_le.trans (by simp))

lemma mem_Hset {i : ℕ} {h : ℤ} (hh : h ∈ Hset B i) :
    -(B.w : ℤ) ≤ h ∧ h ≤ B.w ∧ h ≠ 0 ∧ ¬ ((B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i) := by
  unfold Hset at hh
  rw [mem_filter, mem_image] at hh
  obtain ⟨⟨j, hj, rfl⟩, h1, h2⟩ := hh
  rw [mem_range] at hj
  refine ⟨by omega, by omega, h1, h2⟩

lemma emod_cases (hs : 0 < s) {a : ℤ} (h1 : -(s : ℤ) ≤ a) (h2 : a < 2 * s) :
    (0 ≤ a ∧ a < s ∧ a % s = a) ∨ (s ≤ a ∧ a % s = a - s) ∨ (a < 0 ∧ a % s = a + s) := by
  have hs' : (0 : ℤ) < s := by exact_mod_cast hs
  rcases lt_or_ge a 0 with ha | ha
  · right; right; refine ⟨ha, ?_⟩
    have e : (a + s) % s = a % s := by simp
    rw [← e]; exact Int.emod_eq_of_lt (by omega) (by omega)
  rcases lt_or_ge a s with hb | hb
  · left; exact ⟨ha, hb, Int.emod_eq_of_lt ha hb⟩
  · right; left; refine ⟨hb, ?_⟩
    have e : (a - s + s) % s = (a - s) % s := by simp
    rw [sub_add_cancel] at e
    rw [e]; exact Int.emod_eq_of_lt (by omega) (by omega)

/-- Every coupling column is a near-boundary position (`Jlist`). -/
theorem col_mem (hB : BlocksOK s t B) (hs : 0 < s) {i : ℕ} (hi : i < s) {h : ℤ}
    (hh : h ∈ Hset B i) : col B.s i h ∈ (Jlist B).toFinset := by
  obtain ⟨hw1, hw2, h0, hout⟩ := mem_Hset hh
  have hw := hB.hw
  have hbs := hB.hs
  obtain ⟨ci1, ci2, ci3⟩ := hB.cover i hi
  rw [List.mem_toFinset, Jlist, List.mem_filter, List.mem_range, hbs]
  unfold col
  set j := ((((i : ℤ) + h) % s)).toNat with hj
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : ((j : ℕ) : ℤ) = ((i : ℤ) + h) % s := by
    rw [hj]; exact Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  have hjs : j < s := by
    have := Int.emod_lt_of_pos ((i : ℤ) + h) (by exact_mod_cast hs : (0 : ℤ) < s); omega
  refine ⟨hjs, ?_⟩
  obtain ⟨cj1, cj2, cj3⟩ := hB.cover j hjs
  have key : ¬ (B.st j ≤ i ∧ i < B.st j + B.len j) ∨ (B.st i = B.st j ∧ B.len i = B.len j) := by
    by_cases hc : B.st j ≤ i ∧ i < B.st j + B.len j
    · right; obtain ⟨a, b⟩ := hB.cons j hjs i hc.1 hc.2; exact ⟨a, b⟩
    · left; exact hc
  unfold nearB
  simp only [decide_eq_true_eq]
  omega

end glob

end J6Seg

end

section
-- Source module: Solutions.J6SegStage
/-!
# Segmented inverse (S2): accuracy of the global stages

With `K = (λ+1)E + 1` (`λ` ≥ every block length, `E` the table accuracy in ulps) and `Dm` ≥ every
`D_u = e^{πα²θu²}` used:
* `applyMinv_err`: `|applyMinv V / 2^P - M⁻¹ (V/2^P)| ≤ 9 Dm K (B+1)/2^P` (`|V/2^P| ≤ B`);
* `coupleI_err`: `|coupleI z / 2^P - Δ (z/2^P)| ≤ (2w+1)(1/2 + E Z)/2^P` (`|z/2^P| ≤ Z` on `J`);
* `capI_row`, `capI_apply`: the computed capacitance `C = I + (M⁻¹Δ)|_J` has row deviation
  `≤ 1/7 + λ(2w+1)δ` and `|C z - (z + M⁻¹ Δ z)| ≤ λ(2w+1) δ Z` with `δ = 15 Dm K / 2^P`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section stage
variable {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}

lemma Dm_one (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hT : TabOK P s t α B T E Dm)
    {a : ℕ} (ha : a < s) : 1 ≤ Dm := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have p2 : 1 ≤ (t : ℝ) / s := by rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst
  exact le_trans (one_le_ddR p2 0) (hT.dm a ha 0 (by have := hB.cover a ha; omega))

lemma capI_div (a k : ℕ) :
    (capI P T B a k : ℝ) / 2 ^ P = kd a k + ∑ i ∈ blS B a, ∑ h ∈ Hset B i,
      if col B.s i h = k then (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P else 0 := by
  have hS := two_pow_pos' P
  unfold capI blS kd
  push_cast
  rw [add_div, sum_div]
  congr 1
  · split_ifs <;> simp [hS.ne']
  · refine sum_congr rfl fun i _ => ?_
    rw [sum_div]; refine sum_congr rfl fun h _ => ?_
    split_ifs <;> simp

theorem cap_dev (hB : BlocksOK s t B) (hs : 0 < s) {a : ℕ} (ha' : a < s) :
    ∑ k ∈ (Jlist B).toFinset, |(capI P T B a k : ℝ) / 2 ^ P - kd a k| ≤
      ∑ i ∈ blS B a, ∑ h ∈ Hset B i, |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P| := by
  simp only [capI_div, add_sub_cancel_left]
  calc ∑ k ∈ (Jlist B).toFinset, |∑ i ∈ blS B a, ∑ h ∈ Hset B i,
        if col B.s i h = k then (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P else 0|
      ≤ ∑ k ∈ (Jlist B).toFinset, ∑ i ∈ blS B a, ∑ h ∈ Hset B i,
        if col B.s i h = k then |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P| else 0 := by
        refine sum_le_sum fun k _ => (abs_sum_le_sum_abs _ _).trans (sum_le_sum fun i _ =>
          (abs_sum_le_sum_abs _ _).trans (le_of_eq (sum_congr rfl fun h _ => ?_)))
        split_ifs <;> simp
    _ = _ := by
        rw [sum_comm]; refine sum_congr rfl fun i hi => ?_
        rw [sum_comm]; refine sum_congr rfl fun h hh => ?_
        rw [sum_ite_eq]
        simp [col_mem hB hs (blS_lt hB ha' hi) hh]

/-- Row deviation of the computed capacitance from `I`. -/
theorem cap_row_sol_aux (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha' : a < s) :
    ∑ k ∈ (Jlist B).toFinset, |(capI P T B a k : ℝ) / 2 ^ P - kd a k| ≤
      1 / 7 + lam * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) := by
  set δ := 15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P
  have hδ0 : 0 ≤ δ := by
    have := two_pow_pos' P
    have := Dm_one hB hs hst hT ha'
    positivity
  refine (cap_dev hB hs ha').trans ?_
  have h1 : ∀ i ∈ blS B a, ∑ h ∈ Hset B i, |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P| ≤
      |MiG s t α B a i| * (1 / 8) + (2 * B.w + 1) * δ := by
    intro i hi
    have hb : ∀ h ∈ Hset B i, |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P| ≤
        |MiG s t α B a i| * cfG s t α i h + δ := by
      intro h hh
      have := cap_term hB hs hst hα hx hT hE hlam hP ha' hi hh
      have := abs_sub_abs_le_abs_sub ((fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P)
        (MiG s t α B a i * eEx s t α i h)
      rw [abs_mul, abs_of_nonneg (eEx_nonneg s t α _ _)] at this
      unfold cfG; linarith
    refine (sum_le_sum hb).trans ?_
    rw [sum_add_distrib, ← mul_sum, sum_const, nsmul_eq_mul]
    have hr := (rowD (B := B) hs hst (by linarith) i).trans (rpow_neg_le_eighth hx)
    have hr' : ∑ h ∈ Hset B i, cfG s t α i h ≤ 1 / 8 := by
      refine le_trans (le_of_eq ?_) hr
      exact sum_congr rfl fun h _ => (abs_of_nonneg (eEx_nonneg s t α _ _)).symm
    have hc : ((Hset B i).card : ℝ) ≤ 2 * B.w + 1 := by exact_mod_cast Hset_card i
    have := mul_le_mul_of_nonneg_left hr' (abs_nonneg (MiG s t α B a i))
    have := mul_le_mul_of_nonneg_right hc hδ0
    linarith
  refine (sum_le_sum h1).trans ?_
  rw [sum_add_distrib, ← sum_mul, sum_const, nsmul_eq_mul]
  have hrow := MiG_row hB hs hst (by omega) hx ha'
  have hcard : ((blS B a).card : ℝ) ≤ lam := by
    unfold blS; rw [Nat.card_Ico]; exact_mod_cast (by have := hlam a ha'; omega)
  have := mul_le_mul_of_nonneg_right hcard (by positivity : (0 : ℝ) ≤ (2 * B.w + 1) * δ)
  have : (∑ i ∈ blS B a, |MiG s t α B a i|) * (1 / 8) ≤ 8 / 7 * (1 / 8) :=
    mul_le_mul_of_nonneg_right hrow (by norm_num)
  nlinarith

end stage

end J6Seg

end

theorem solution : type_of% @J6Seg.cap_row_sol_aux := @J6Seg.cap_row_sol_aux
