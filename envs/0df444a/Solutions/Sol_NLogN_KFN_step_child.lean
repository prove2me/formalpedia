  have e1 : ((fun i : Fin t => KFH.stT 1 t S0 0 i) ∘ g) = fun i => 2 ^ pos i * S0 := by
    funext i; simp only [Function.comp_apply, g]; exact stT_one t S0 (pos i) (hpos i)
