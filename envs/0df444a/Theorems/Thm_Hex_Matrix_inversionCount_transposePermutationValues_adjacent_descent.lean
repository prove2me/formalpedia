theorem inversionCount_transposePermutationValues_adjacent_descent
    {n : Nat} (perm : Vector (Fin n) n)
    {i j : Fin n} (hij : i.val + 1 = j.val) (hdesc : perm[j] < perm[i]) :
    inversionCount perm.toList =
      inversionCount (transposePermutationValues perm i j).toList + 1 := by sorry
