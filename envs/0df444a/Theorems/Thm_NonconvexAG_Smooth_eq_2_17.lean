-- title:
--   (2.17) — ‖x^ag_k − x_k‖² ≤ Γ_k Σ_{τ≤k} ((λ_τ − β_τ)²/(Γ_τα_τ)) ‖∇Ψ(x^md_τ)‖²
-- statement:
--   Let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$, using an arbitrary map $\nabla\Psi:\mathbb R^n\to\mathbb R^n$, and let $\Gamma_k$ be as in (2.6). Then for every $k\ge1$,
--   $$\|x^{ag}_k-x_k\|^2\le\Gamma_k\sum_{\tau=1}^k\frac{(\lambda_\tau-\beta_\tau)^2}{\Gamma_\tau\alpha_\tau}\|\nabla\Psi(x^{md}_\tau)\|^2 .$$
--
--   Combined with (2.15), this controls the correction term of the one-step estimate by past gradient norms.
--
--   **Formalization Note** The statement is the outer ends of the chain (2.17). It is stated for any map `g`; no smoothness is used.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 6, (2.17)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.17), p. 6 (outer ends of the chain). -/
theorem eq_2_17 {n : ℕ} (g : E n → E n) (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k →
      ‖xagSeq g α β lam x0 k - xSeq g α β lam x0 k‖ ^ 2 ≤
        Gamma α k * ∑ τ ∈ Finset.Icc 1 k,
          (lam τ - β τ) ^ 2 / (Gamma α τ * α τ) * ‖g (xmdSeq g α β lam x0 τ)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
