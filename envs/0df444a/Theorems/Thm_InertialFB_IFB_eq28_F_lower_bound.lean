-- title:
--   Eq. (28): lower bound on $F_k(q)$ for $q \in \mathrm{dom}\,\Phi$
-- statement:
--   Let $H$ be a real Hilbert space, let Hypothesis H hold, and let $(u_k, y_k)$ be generated by (IFB). For each $q \in \operatorname{dom}\Phi$ there is a constant $C \in \mathbb R$ such that, for every $k \ge 1$,
--   $$F_k(q) \ \ge\ C + \alpha\|u_{k+1} - q\|^2 - \left[\alpha - \frac{a+b}{2\lambda}\right]\|u_k - q\|^2 \ \ge\ C + \alpha\left[\|u_{k+1} - q\|^2 - \|u_k - q\|^2\right],$$
--   where $\alpha = (1+b\lambda)/(2\lambda^2)$.
--
--   This double inequality converts the Liapunov property of $F_k(q)$ into information on the distances $\|u_k - q\|$; it is the bridge to Propositions 6 and 8.
--
--   **Formalization Note** The paper derives (28) from Propositions 2 and 4 "for some constant $C$" and applies it to arbitrary $q$; since Proposition 4 requires $q \in \operatorname{dom}\Phi$, that hypothesis is kept here. Both inequalities of the chain are stated.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 9, Section 2.3, eq. (28)

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_InertialFB_IFB_Algorithm
import Definitions.Def_InertialFB_IFB_Lyapunov

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- **Section 2.3, Eq. (28)** (Attouch–Peypouquet–Redont, p. 9). Under Hypothesis H, for each
`q ∈ dom Φ` there is a constant `C` such that for all `k ≥ 1`
`F_k(q) ≥ C + α‖u_{k+1} - q‖² - [α - (a+b)/(2λ)]‖u_k - q‖² ≥ C + α[‖u_{k+1} - q‖² - ‖u_k - q‖²]`. -/
theorem eq28_F_lower_bound (Φ : H → EReal) (Ψ : H → ℝ) (L a b lam : ℝ)
    (hH : HypothesisH Φ Ψ L a b lam) (u y : ℕ → H) (hIFB : IsIFBSeq Φ Ψ a b lam u y) :
    ∀ q : H, Φ q ≠ ⊤ → ∃ C : ℝ, ∀ k : ℕ, 1 ≤ k →
      C + alphaC b lam * ‖u (k + 1) - q‖ ^ 2 -
          (alphaC b lam - (a + b) / (2 * lam)) * ‖u k - q‖ ^ 2 ≤ auxF a b lam u y k q ∧
      C + alphaC b lam * (‖u (k + 1) - q‖ ^ 2 - ‖u k - q‖ ^ 2) ≤
        C + alphaC b lam * ‖u (k + 1) - q‖ ^ 2 -
          (alphaC b lam - (a + b) / (2 * lam)) * ‖u k - q‖ ^ 2 := by sorry

end InertialFB.IFB
