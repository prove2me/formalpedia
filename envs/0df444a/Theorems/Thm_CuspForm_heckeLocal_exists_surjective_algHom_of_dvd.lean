-- title:
--   Surjection of localised Hecke algebras for N ∣ N'
-- statement:
--   Let $N \mid N'$ be nonzero natural numbers and let $S$ be a set of natural numbers containing every prime divisor of $N'$; here $\mathbb{T}^S(M) =$ [`CuspForm.heckeAlgebra M 2 S`](def/CuspForm_HeckeAlgebra.html#L18) denotes the $\mathbb{Z}$-subalgebra of $\operatorname{End}_{\mathbb{C}} S_2(\Gamma_0(M))$ generated by the operators $T_\ell$ attached to primes $\ell \nmid M$ with $\ell \notin S$ together with the operators $U_q$ attached to primes $q \mid M$ with $q \notin S$ (the hypothesis on $S$ makes the latter set of generators empty for $M = N, N'$). Let $\mathcal{O}$ be a discrete valuation domain, complete for the adic topology of its maximal ideal, with residue field $k$, and let $\theta \colon \mathbb{T}^S(N) \to k$ and $\theta' \colon \mathbb{T}^S(N') \to k$ be ring homomorphisms such that $\theta'(T_\ell) = \theta(T_\ell)$ for every prime $\ell$ with $\ell \nmid N'$, $\ell \nmid N$ and $\ell \notin S$. Assume further that $S_2(\Gamma_0(N))$ and $S_2(\Gamma_0(N'))$ each satisfy [`CuspForm.HasIntegralStructure`](def/CuspForm_IntegralStructure.html#L6), i.e. the $\mathbb{C}$-span of the $\mathbb{Z}$-submodule spanned by those cusp forms all of whose $q$-expansion coefficients are rational integers is the whole space. Write $\mathbb{T}_\theta =$ [`CuspForm.heckeLocal N S 𝒪 θ`](def/CuspForm_HeckeLocal.html#L131) for the localisation of `heckeBaseAlgebra N S 𝒪` at the multiplicative set obtained as the image under `latticeBaseChange N S 𝒪` of the complement of the prime ideal `heckeCharKernel N S 𝒪 θ`, with structure homomorphism $\pi =$ [`CuspForm.heckeLocal.π N S 𝒪 θ`](def/CuspForm_HeckeLocal.html#L151), and similarly $\mathbb{T}_{\theta'}$, $\pi'$ at level $N'$. The assertion is that there exist a ring homomorphism $\mathrm{res} \colon \mathbb{T}^S(N') \to \mathbb{T}^S(N)$ and an $\mathcal{O}$-algebra homomorphism $\Psi \colon \mathbb{T}_{\theta'} \to \mathbb{T}_\theta$ such that $\theta' = \theta \circ \mathrm{res}$, $\mathrm{res}$ is surjective and carries $T_\ell$ to $T_\ell$ for every prime $\ell \nmid N'$ with $\ell \notin S$, the underlying ring homomorphism of $\Psi$ is local, $\Psi$ is surjective, and $\Psi(\pi'(t)) = \pi(\mathrm{res}\,t)$ for all $t \in \mathbb{T}^S(N')$.
--
--   This is the level-transition map between the localised Hecke algebras attached to two levels with a common residual eigensystem, the $\mathbb{T}$-side counterpart of the transition maps between deformation rings used in the induction on the level in the modularity lifting argument. It is used in the construction of patching data and of level-raising Hecke modules, and in the comparison of cotangent spaces and congruence ideals at the two levels.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_heckeLocal_exists_surjective_algHom_of_dvd.lean

import Definitions.Def_CuspForm_HeckeLocal

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem CuspForm.heckeLocal.exists_surjective_algHom_of_dvd
    (N N' : ℕ) [NeZero N] [NeZero N'] (hNN' : N ∣ N') (S : Set ℕ)
    (hN'S : ∀ q : ℕ, q.Prime → q ∣ N' → q ∈ S)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪]
    [IsAdicComplete (IsLocalRing.maximalIdeal 𝒪) 𝒪]
    (θ : CuspForm.heckeAlgebra N 2 S →+* IsLocalRing.ResidueField 𝒪)
    (θ' : CuspForm.heckeAlgebra N' 2 S →+* IsLocalRing.ResidueField 𝒪)
    (hθ' : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN' : ¬ ℓ ∣ N') (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S),
      θ' (CuspForm.heckeAlgebra.T hℓ hℓN' hℓS) = θ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS))
    (hint : CuspForm.HasIntegralStructure N 2) (hint' : CuspForm.HasIntegralStructure N' 2) :
    ∃ (res : CuspForm.heckeAlgebra N' 2 S →+* CuspForm.heckeAlgebra N 2 S)
      (Ψ : CuspForm.heckeLocal N' S 𝒪 θ' →ₐ[𝒪] CuspForm.heckeLocal N S 𝒪 θ),
      θ' = θ.comp res ∧ Function.Surjective res ∧
      (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN' : ¬ ℓ ∣ N') (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S),
        res (CuspForm.heckeAlgebra.T hℓ hℓN' hℓS) = CuspForm.heckeAlgebra.T hℓ hℓN hℓS) ∧
      IsLocalHom (Ψ : CuspForm.heckeLocal N' S 𝒪 θ' →+* CuspForm.heckeLocal N S 𝒪 θ) ∧
      Function.Surjective Ψ ∧
      ∀ t : CuspForm.heckeAlgebra N' 2 S,
        Ψ (CuspForm.heckeLocal.π N' S 𝒪 θ' t) = CuspForm.heckeLocal.π N S 𝒪 θ (res t) := by sorry
