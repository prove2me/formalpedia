section Derivations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 4.12, PDF p. 24. Non-reductivity and the derived-center condition are explicit. -/
theorem eulerElements_centralize_radical (ha : LieAdmissible (G := G))
    (hr : ¬ LieAlgebra.HasCentralRadical ℝ G)
    (hz : LieAlgebra.center ℝ G ≤ LieAlgebra.derivedSeries ℝ G 1) (h : G) (he : EulerElement h) :
    ∀ r ∈ LieAlgebra.radical ℝ G, ⁅h, r⁆ = 0 := by sorry

end Derivations

end

