-- title:
--   Standard real part of a cyclic separating algebra
-- statement:
--   Let $H$ be a complete complex Hilbert space, $M\subseteq B(H)$ a unital complex von Neumann algebra, and $\Omega\in H$ cyclic for both $M$ and its commutant $M'$. Let $K$ be the norm-closed real span of $a\Omega$ with $a\in M$ self-adjoint, and let $iK=\{i\xi:\xi\in K\}$. Then
--
--   $$\overline{K+iK}=H,\qquad K\cap iK=\{0\}.$$
--
--   This identifies the actual closed real part as a standard real subspace, before constructing its modular operators. Orthogonality and real closure use the underlying real Hilbert structure; no modular identity is assumed.
-- source:
--   Operator Algebras and Conformal Field Theory III. Fusion of positive energy representations of LSU(N) using bounded operators, arXiv:math/9806031v1, PDF p. 18, §12: Lemma 1

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P41

noncomputable section

open scoped BigOperators

open MeasureTheory Set

namespace QAlgorithms.Papers.Independent.Intakenext100.P41

section StandardRealPart

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

local instance : InnerProductSpace ℝ H := InnerProductSpace.complexToReal

/-- §12 lemma 1, PDF p.18: the closed real part generated by M_saΩ is standard.
Both cyclicity assumptions are imposed on the actual unital complex von Neumann
algebra and its commutant. The result does not require any modular construction.
The supremum of the two real submodules is their algebraic sum. -/
theorem selfAdjointRealPartStandard (M : VonNeumannAlgebra H) (omega : H)
    (hM : IsCyclicFor M omega) (hCommutant : IsCyclicFor M.commutant omega) :
    ((closedSelfAdjointRealPart M omega) ⊔
      imaginaryRealPart (closedSelfAdjointRealPart M omega)).topologicalClosure = ⊤ ∧
    (closedSelfAdjointRealPart M omega) ⊓
      imaginaryRealPart (closedSelfAdjointRealPart M omega) = ⊥ := by sorry

end StandardRealPart

end QAlgorithms.Papers.Independent.Intakenext100.P41

end
