def precision : ℕ := 160
def endpointLogTwo : DyadicInterval precision := ⟨1013035739299659071135698605846798551586536899314, 1013035739299659071135698605846798551586536901381⟩
def fastLogWitness : FastLogBoxWitness := ⟨0, 1024, 0, 1024⟩

theorem endpointLogTwo_checked :
    logBoxCheck (ofInt precision 2) endpointLogTwo fastLogWitness = true := by decide +kernel

def centerBLowerAlpha : DyadicInterval precision := ⟨2089708961836601552715229851863876864315293726050, 2089708961836601552715229851863876864315293726050⟩
def centerBLowerExp : DyadicInterval precision := ⟨83725694751933551945584007868802200292180059358, 83725694751933551945584007868802200292180190431⟩
