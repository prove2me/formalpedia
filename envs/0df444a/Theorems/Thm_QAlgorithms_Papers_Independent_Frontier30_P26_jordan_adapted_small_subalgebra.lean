-- title:
--   Proposition B.1: Small reductive subalgebra adapted to Jordan decomposition
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g$ be semisimple real and $x=x_s+x_n$ a commuting ad-semisimple/ad-nilpotent Jordan decomposition with $x_n\ne0$. There is a reductive subalgebra $\mathfrak m$ containing $x$ and with $x_n\in[\mathfrak m,\mathfrak m]$ such that
--
--   $$x_s=0\Rightarrow\mathfrak m\cong\mathfrak{sl}_2(\mathbb R),\qquad x_s\ne0\Rightarrow\mathfrak m\cong\mathfrak{gl}_2(\mathbb R),\quad x_s\in\mathfrak z(\mathfrak m).$$
--
--   The containment of $x$ and the first-branch derived membership make explicit the algebra constructed by the proof. No admissibility assumption applies in Appendix B.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 28, Proposition B.1: Small reductive subalgebra adapted to Jordan decomposition

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section LieGeometry

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition B.1, PDF pp. 28–29. The proof's constructed algebra contains x and xn in both branches.
These containments make explicit the source proof's intended adapted-subalgebra meaning. -/
theorem jordan_adapted_small_subalgebra [LieAlgebra.IsSemisimple ℝ G]
    (xs xn : G) (hj : JordanPair xs xn) (hne : xn ≠ 0) :
    ∃ M : LieSubalgebra ℝ G, LieAlgebra.HasCentralRadical ℝ M ∧ xs + xn ∈ M ∧
      xn ∈ bracketSpan M.toSubmodule M.toSubmodule ∧
      (xs = 0 → Nonempty (M ≃ₗ⁅ℝ⁆ LieAlgebra.SpecialLinear.sl (Fin 2) ℝ)) ∧
      (xs ≠ 0 → Nonempty (M ≃ₗ⁅ℝ⁆ Matrix (Fin 2) (Fin 2) ℝ) ∧
        xs ∈ M ∧ ∀ y : M, ⁅xs, (y : G)⁆ = 0) := by sorry

end LieGeometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
