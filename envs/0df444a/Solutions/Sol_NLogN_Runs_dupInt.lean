section
open NLogN
variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}
open NLogN.Runs
theorem solution {q i j t1 t2 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqt1 : q ≠ t1)
    (hqt2 : q ≠ t2) (hij : i ≠ j) (hit1 : i ≠ t1) (hit2 : i ≠ t2) (hjt1 : j ≠ t1) (hjt2 : j ≠ t2)
    (ht12 : t1 ≠ t2) (σ : St S) (z : ℤ) (Ri : List Sym)
    (hi : σ.stk i = (Item.int z).enc ++ Ri) (hRi : bitOf Ri.head? = none)
    (hj : bitOf (σ.stk j).head? = none) (ht1 : bitOf (σ.stk t1).head? = none)
    (ht2 : bitOf (σ.stk t2).head? = none) :
    NLogN.Runs I prog (NLogN.dupInt q i j t1 t2 : Stmt S P) σ
      (σ.set j ((Item.int z).enc ++ σ.stk j)) (dupCost (zsz z) + 17) := by
  unfold NLogN.dupInt
  have htop : σ.top i = some (hdOf z) := by simp [St.top_eq, hi, Item.enc]
  refine Runs.caseTop ?_
  rw [htop]
  simp only [hdOf_sel]
  set B := zbits z
  have h1 := Runs.pop (I := I) (prog := prog) σ i
  set σ1 := σ.pop i
  have h2 := Runs.zip (I := I) (prog := prog) (q := q) (a := j) (b := i) (d := t1) (e := t2)
    hqj hqi hqt1 hqt2 (Ne.symm hij) hjt1 hjt2 hit1 hit2 ht12 true fCopy finNone (σ.stk j) Ri hj
    hRi 0 (fun _ => le_rfl) σ1 [] B false (by simp [σ1, Ne.symm hij]) (by simp [σ1, hi, Item.enc, B])
  rw [zipL_copy false [] B rfl] at h2
  set σ2 := (((σ1.set j (σ.stk j)).set i Ri).set t1
    (pushAll (finNone (zipL fCopy false [] B).2) ((B.map codeBit).reverse ++ σ1.stk t1))).set t2
    (if true = true then (B.map codeBit).reverse ++ σ1.stk t2 else σ1.stk t2)
  have h3 := Runs.moveBits (I := I) (prog := prog) hqt2 hqi (Ne.symm hit2) σ2 B.reverse (σ.stk t2)
    (by simp [σ2, σ1, List.map_reverse, Ne.symm hit2]) ht2
  set σ3 := (σ2.set t2 (σ.stk t2)).set i ((B.reverse.map codeBit).reverse ++ σ2.stk i)
  have h4 := Runs.push (I := I) (prog := prog) σ3 i (hdOf z)
  have h5 := Runs.moveBits (I := I) (prog := prog) hqt1 hqj (Ne.symm hjt1) (σ3.push i (hdOf z))
    B.reverse (σ.stk t1)
    (by simp [σ3, σ2, σ1, List.map_reverse, finNone, pushAll, hit1, Ne.symm hit1, ht12]) ht1
  set σ5 := ((σ3.push i (hdOf z)).set t1 (σ.stk t1)).set j
    ((B.reverse.map codeBit).reverse ++ (σ3.push i (hdOf z)).stk j)
  have h6 := Runs.push (I := I) (prog := prog) σ5 j (hdOf z)
  refine Runs.mono' (Runs.seq h1 (Runs.seq h2 (Runs.seq h3 (Runs.seq h4 (Runs.seq h5 h6))))) ?_ ?_
  · clear h1 h2 h3 h4 h5 h6
    rw [St.ext_iff']; refine ⟨fun x => ?_, rfl, rfl⟩
    by_cases hxj : x = j
    · subst hxj
      simp [σ5, σ3, σ2, σ1, List.map_reverse, Item.enc, hij, Ne.symm hij, hjt1, hjt2, B]
    by_cases hxi : x = i
    · subst hxi
      simp [σ5, σ3, σ2, σ1, List.map_reverse, Item.enc, hij, hit1, hit2, hxj, hi, B]
    simp only [σ5, σ3, σ2, σ1, St.push_stk, St.pop_stk, St.set_stk, hxj, hxi, if_false]
    split_ifs <;> simp_all
  · simp only [dupCost, zipCost, moveCost, zsz, B, List.length_nil, List.length_reverse,
      List.length_map, max_eq_right (Nat.zero_le _)]
    omega
end
