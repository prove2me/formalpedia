    pd 2 (christoffel (gEF5 mu beta) (giEF5 mu beta) 4 2 4) x = -1 / (2 * (1 - x 2) ^ 2) := by
  have h1u := domU5_1mu_pos hx
  rw [pd_congr_of_eqOn isOpen_domU5 hx (eqOn_G4_24 mu beta), pd]
