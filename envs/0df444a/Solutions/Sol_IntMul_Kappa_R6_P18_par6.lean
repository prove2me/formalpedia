/-!
# KFM Par18a: the numeric side conditions of Proposition 18 (`Par18Need`)

All conditions are "polynomial in `b` against `2^ℓ`" or "polynomial in `b` against `2^K`":

* from `params_ok`: `b ≤ 2dℓ`, `dℓ ≤ 2b`, `2^18 d^5 ≤ b`, hence **`b ≤ ℓ²`** and `d < ℓ`;
* `K ≥ (6b)^{εc}/24` gives `b ≤ (24K)^{2^131}`;
* `poly_lt`: `C x^k < 2^x` for large `x` (from `tendsto_pow_const_div_const_pow_of_one_lt`);
* `rb`: `M^{2^m} ≤ b ⇒ M ≤ b^{1/2^m}` (so `d`, `K`, `ℓ` grow).

Main result: **`par18Need : KFV.Par18Need`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.P18M

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RCost KFM

theorem zN (m : ℕ) : zsz (m : ℤ) ≤ m :=
  zsz_le_of_lt (by simpa using (Nat.lt_two_pow_self (n := m)))

theorem fmB_le (n : ℕ) : KFM.fmB n ≤ 2 * (8 * fmA + 10 ^ 7 + 10 ^ 5) * (n + 3) ^ 6 := by
  unfold KFM.fmB
  generalize 8 * fmA + 10 ^ 7 + 10 ^ 5 = F
  have h1 : zsz ((n + 1 : ℕ) : ℤ) + 2 ≤ n + 3 := by have := zN (n + 1); omega
  have h2 : zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1 ≤ (n + 3) ^ 4 + 1 := by
    have := zN ((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4)
    have := Nat.pow_le_pow_left h1 4
    omega
  have h3 : (n + 3) ^ 4 + 1 ≤ 2 * (n + 3) ^ 4 := by
    have : 1 ≤ (n + 3) ^ 4 := Nat.one_le_pow _ _ (by omega)
    omega
  exact le_trans (Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul le_rfl
    (show n + 1 ≤ n + 3 by omega)) h1) (h2.trans h3)) (le_of_eq (by ring))

theorem cU_le (B : ℕ) :
    10 ^ 12 * (B + 2) ^ 3 + 16 * KFUU.cU B ≤ Cu * (2 * B + 3) ^ 6 := by
  have h1 := fmB_le (2 * B)
  have hc : KFUU.cU B = 10 ^ 4 * (B + 1) + KFM.fmB (2 * B) := rfl
  have hCu : Cu = 10 ^ 12 + 16 * 10 ^ 4 + 16 * (2 * (8 * fmA + 10 ^ 7 + 10 ^ 5)) := rfl
  rw [hc, hCu]
  have hX : 1 ≤ 2 * B + 3 := by omega
  have e1 : (B + 2) ^ 3 ≤ (2 * B + 3) ^ 6 :=
    (Nat.pow_le_pow_left (by omega) 3).trans (Nat.pow_le_pow_right hX (by norm_num))
  have e2 : 2 * B + 3 ≤ (2 * B + 3) ^ 6 := by
    simpa using Nat.pow_le_pow_right hX (show 1 ≤ 6 by norm_num)
  linarith

end NLogN.KFV.P18M

end

