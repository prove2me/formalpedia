    (hTA : ∀ k, (T k).G lA = (T 0).G lA) (hTC : ∀ k, (T k).G lC = (T 0).G lC)
    (hTD : ∀ k, (T k).G lD = (T 0).G lD)
    (b : IStmt HS P) (c : ℕ)
    (hb : ∀ k < n, ∀ LA LC LD, IRuns I iprog b (cf3 (T k) lA lC lD LA LC LD)
      (cf3 (T (k + 1)) lA lC lD LA LC LD) c) (LX : List Item) (hX : (T 0).G X = .int (n : ℤ) :: LX) :
    IRuns I iprog (rptX X lA lC lD b) (T 0) (T n) ((n + 1) * (c + 3000)) := by
  refine (KFT.rptX_runs (Pp := P) (I := I) (iprog := iprog) hXA (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) n T hTA hTC hTD b c hb LX hX).mono ?_
  have h1 := cRpt_le n
  have h2 := dupCost_le (zsz (n : ℤ))
  have h3 := zsz_natCast_le_self' n
  nlinarith

