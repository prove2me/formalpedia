-- title:
--   Theorem 7 — regret bounds of full-matrix ADAGRAD in terms of $\|x^*\|_2$ and $\operatorname{tr}(G_T^{1/2})$
-- statement:
--   Let $\mathcal X\subseteq\mathbb R^d$ be closed and convex with $0\in\mathcal X$, let $f_1,f_2,\dots$ and $\varphi$ be convex functions on $\mathbb R^d$ with $\varphi$ minimized over $\mathcal X$ at $x_1=0$, let $\eta>0$, $\delta\ge0$ and $T\ge1$, and let $G_t=\sum_{\tau=1}^tg_\tau g_\tau^\top$ be the outer product matrix of the observed subgradients. Run ADAGRAD with full matrices (Figure 2) for $T$ rounds.
--
--   1. If $x_t$ is generated by the primal-dual subgradient update (3) and $\delta\ge\max_{t\le T}\|g_t\|_2$, then for every $x^*\in\mathcal X$
--   $$R_\phi(T)\le\frac\delta\eta\|x^*\|_2^2+\frac1\eta\|x^*\|_2^2\operatorname{tr}(G_T^{1/2})+\eta\operatorname{tr}(G_T^{1/2}).$$
--   2. If $x_t$ is generated by the composite mirror descent update (4), then for every $x^*\in\mathcal X$
--   $$R_\phi(T)\le\frac\delta\eta\|x^*\|_2^2+\frac1{2\eta}\max_{t\le T}\|x^*-x_t\|_2^2\operatorname{tr}(G_T^{1/2})+\eta\operatorname{tr}(G_T^{1/2}).$$
--
--   Here $R_\phi(T)=\sum_{t=1}^T[f_t(x_t)+\varphi(x_t)-f_t(x^*)-\varphi(x^*)]$ is the regret (2). The bound depends on the data only through $\operatorname{tr}(G_T^{1/2})$, which is small when the subgradients concentrate in a few directions; this is the full-matrix counterpart of the diagonal Theorem 5.
--
--   **Formalization Note** The hypothesis that $\varphi$ is minimized over $\mathcal X$ at $x_1=0$ is the paper's $x_1=\arg\min_{x\in\mathcal X}\varphi(x)$ (p. 2123; Propositions 2 and 3, Corollary 11); without it both bounds fail. The argmin of each update is a predicate, the maximum is over $t\in\{1,\dots,T\}$, $\|\cdot\|_2$ is the Euclidean norm of `EuclideanSpace ℝ (Fin d)`, and $G_T^{1/2}$ is Mathlib's `CFC.sqrt`.
-- source:
--   Duchi, Hazan, Singer, Adaptive Subgradient Methods for Online Learning and Stochastic Optimization, JMLR 12 (2011), p. 2133, Theorem 7 (Algorithm 2 = Figure 2, p. 2134)

import Mathlib
import Definitions.Def_AdaGrad_Full_Algorithm2
open scoped MatrixOrder InnerProductSpace

namespace AdaGrad.Full

/-- Theorem 7 (p. 2133): regret bounds for ADAGRAD with full matrices (Figure 2), for the
primal-dual subgradient update (3) with `δ ≥ max_t ‖g_t‖₂` and for the composite mirror descent
update (4) with `δ ≥ 0`. The regularizer `ϕ` is minimized over `X` at `x_1 = 0`. -/
theorem theorem_7 {d : ℕ} (η δ : ℝ) (hη : 0 < η) (hδ : 0 ≤ δ)
    (X : Set (EuclideanSpace ℝ (Fin d))) (hXc : Convex ℝ X) (hXcl : IsClosed X)
    (h0X : (0 : EuclideanSpace ℝ (Fin d)) ∈ X)
    (f : ℕ → EuclideanSpace ℝ (Fin d) → ℝ) (hf : ∀ t, ConvexOn ℝ Set.univ (f t))
    (ϕ : EuclideanSpace ℝ (Fin d) → ℝ) (hϕ : ConvexOn ℝ Set.univ ϕ)
    (hϕ0 : ∀ y ∈ X, ϕ 0 ≤ ϕ y) (T : ℕ) (hT : 1 ≤ T) :
    (∀ x g : ℕ → EuclideanSpace ℝ (Fin d), IsPrimalDualRun η δ X ϕ f x g T →
      (∀ t ∈ Finset.Icc 1 T, ‖g t‖ ≤ δ) → ∀ xstar ∈ X,
        AdaGrad.Diag.regret f ϕ x xstar T ≤ δ / η * ‖xstar‖ ^ 2 + 1 / η * ‖xstar‖ ^ 2 * (S g T).trace
          + η * (S g T).trace) ∧
    (∀ x g : ℕ → EuclideanSpace ℝ (Fin d), IsMirrorDescentRun η δ X ϕ f x g T →
      ∀ xstar ∈ X,
        AdaGrad.Diag.regret f ϕ x xstar T ≤ δ / η * ‖xstar‖ ^ 2
          + 1 / (2 * η) * (Finset.Icc 1 T).sup' (Finset.nonempty_Icc.mpr hT)
              (fun t => ‖xstar - x t‖ ^ 2) * (S g T).trace
          + η * (S g T).trace) := by sorry

end AdaGrad.Full
