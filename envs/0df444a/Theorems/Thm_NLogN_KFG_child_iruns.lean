    (PT : IStmt HS Pp) (F : List GI → List GI) (hF : BlkT U F) (Q : (Fin HS → List ℤ) → Prop)
    (hQs : ∀ g v0 vP vR, Q g → Q (Function.update (Function.update (Function.update g 0 v0) qP vP)
      NLogN.KFB.rP vR))
    (Bb Z wb wb' cP : ℕ)
