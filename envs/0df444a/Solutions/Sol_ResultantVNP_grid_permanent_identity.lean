lemma unit_sum_single {α : Type} [Fintype α] [DecidableEq α]
    (f : α → ℕ) (hf : ∑ a,f a = 1) : ∃ a,∀ b,f b = if a = b then 1 else 0 := by
  let d := Finsupp.equivFunOnFinite.symm f
  have hd : d.sum (fun _ k => k) = 1 := by
    rw [Finsupp.sum_fintype _ _ (by intros; rfl)]
    exact hf
  obtain ⟨a,ha⟩ := (Finsupp.sum_eq_one_iff d).mp hd
  refine ⟨a,?_⟩
  intro b
  have h := congrArg (fun v : α →₀ ℕ => v b) ha
  simpa [d,Finsupp.single_apply] using h

theorem permutation_of_unit_sums {α : Type} [Fintype α] [DecidableEq α]
    (x : α → α → ℕ) (hr : ∀ i,∑ j,x i j = 1) (hc : ∀ j,∑ i,x i j = 1) :
    ∃ σ : Equiv.Perm α,∀ i j,x i j = if σ i = j then 1 else 0 := by
  choose σ hσ using fun i => unit_sum_single (x i) (hr i)
  choose τ hτ using fun j => unit_sum_single (fun i => x i j) (hc j)
  have hleft : Function.LeftInverse τ σ := by
    intro i
    have h := hτ (σ i) i
    rw [hσ] at h
    by_contra hn
    simp [hn] at h
  have hright : Function.RightInverse τ σ := by
    intro j
    have h := hσ (τ j) j
    rw [hτ] at h
    by_contra hn
    simp [hn] at h
  exact ⟨⟨σ,τ,hleft,hright⟩,hσ⟩

lemma prefix_sum (m : ℕ) (x p : ℕ → ℕ) (h0 : p 0 = 0)
    (hs : ∀ k,k+1 < m → p (k+1) = p k + x k) (i : ℕ) (hi : i < m) :
    p i = ∑ k ∈ Finset.range i,x k := by
  induction i with
  | zero => simpa using h0
  | succ i ih =>
    rw [hs i hi,ih (by omega),Finset.sum_range_succ]

lemma total_sum (m : ℕ) (hm : 1 ≤ m) (x p : ℕ → ℕ) (h0 : p 0 = 0)
    (hs : ∀ k,k+1 < m → p (k+1) = p k + x k)
    (hlast : p (m-1) + x (m-1) = 1) : ∑ k ∈ Finset.range m,x k = 1 := by
  have hp := prefix_sum m x p h0 hs (m-1) (by omega)
  have hm' : m = (m-1)+1 := by omega
  rw [hm',Finset.sum_range_succ,← hp]
  exact hlast

def Valid {m : ℕ} (a : (ZMod m × ZMod m) → GridState) : Prop :=
