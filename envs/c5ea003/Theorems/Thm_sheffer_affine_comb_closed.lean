theorem sheffer_affine_comb_closed{f g : ℝ → ℝ} (hf : f ∈ ShefferAlgebra)
    (hg : g ∈ ShefferAlgebra) (α β γ : ℝ) :
    (fun x => α * f x + β * g x + γ) ∈ ShefferAlgebra := by sorry
