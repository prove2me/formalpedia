/-- A separating parameter chart becomes smooth over the retained parameters on a nonempty
principal open. All coefficient maps are the actual parameter evaluation maps. -/
lemma exists_smooth_parameter_principal_open
    (K A F : Type u) [Field K] [CommRing A] [IsDomain A] [Field F]
    [Algebra K A] [Algebra A F] [Algebra K F] [IsScalarTower K A F]
    [IsFractionRing A F] [Algebra.FiniteType K A]
    (S T : Finset F) (x : S)
    (hb : IsTranscendenceBasis K ((↑) : S → F))
    (hT : (T : Set F) = (S : Set F) \ {x.val})
    [Algebra.IsSeparable (IntermediateField.adjoin K (S : Set F)) F]
    (j : T ↪ S) (hj : ∀ z : T, (j z).val = z.val)
    (a : S → A) (ha : ∀ z : S, algebraMap A F (a z) = z.val) :
    letI : Algebra (MvPolynomial T K) A :=
      (MvPolynomial.aeval (R := K) (fun z : T => a (j z))).toRingHom.toAlgebra
    ∃ b : A, b ≠ 0 ∧ Algebra.Smooth (MvPolynomial T K) (Localization.Away b) := by
  classical
  let R := MvPolynomial T K
  let ev : R →ₐ[K] A := MvPolynomial.aeval (R := K) (fun z : T => a (j z))
  letI : Algebra R A := ev.toRingHom.toAlgebra
  letI : Algebra R F := (MvPolynomial.aeval (R := K) ((↑) : T → F)).toRingHom.toAlgebra
  letI : IsScalarTower K R A := IsScalarTower.of_algebraMap_eq (fun k => (ev.commutes k).symm)
  have hcomp : (IsScalarTower.toAlgHom K A F).comp ev =
      MvPolynomial.aeval (R := K) ((↑) : T → F) := by
    apply MvPolynomial.algHom_ext
    intro z
    simp only [AlgHom.comp_apply, ev, MvPolynomial.aeval_X]
    exact (ha (j z)).trans (hj z)
  letI : IsScalarTower R A F := by
    apply IsScalarTower.of_algebraMap_eq'
    exact congrArg AlgHom.toRingHom hcomp.symm
  letI : Algebra.FiniteType R A := Algebra.FiniteType.of_restrictScalars_finiteType K R A
  letI : Algebra.FinitePresentation R A := Algebra.FinitePresentation.of_finiteType.mp inferInstance
  letI : Algebra.FormallySmooth R F := formallySmooth_parameter_evaluation K F S T x hb hT
  exact exists_smooth_principal_open_of_formallySmooth_fractionField R A F

end PhilipponAlterationProjection



