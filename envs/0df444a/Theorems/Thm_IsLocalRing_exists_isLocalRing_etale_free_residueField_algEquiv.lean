-- title:
--   Lifting a finite separable residue extension to an étale local algebra
-- statement:
--   Let $R$ be a commutative local ring with residue field $\mathrm{ResidueField}\,R$, and let $k'$ be a field equipped with an algebra structure over $\mathrm{ResidueField}\,R$ which is finite as a module over $\mathrm{ResidueField}\,R$ and separable over it. Then there exist a type $E$ together with a commutative ring structure on $E$, a proof that $E$ is local, an $R$-algebra structure on $E$, and a proof that $\mathrm{algebraMap}\,R\,E$ is a local homomorphism (i.e. pulls back the maximal ideal of $E$ into that of $R$), such that: $E$ is finite as an $R$-module; $E$ is free as an $R$-module; the $R$-algebra $E$ is étale; the ideal of $E$ generated by the image of $\mathfrak m_R$ equals $\mathfrak m_E$; and the type of $\mathrm{ResidueField}\,R$-algebra isomorphisms $\mathrm{ResidueField}\,E \simeq k'$ is nonempty. No Noetherian, completeness or excellence hypothesis on $R$ is imposed, and $R$ and $k'$ are taken in `Type`.
--
--   This is the standard existence statement for a finite étale local $R$-algebra realising a prescribed finite separable extension of the residue field, with the maximal ideal of $R$ generating that of the extension; in the classical literature it appears as the construction of unramified extensions of a local ring. It is used in the passage to adic completions, via [`AdicCompletion.exists_moduleFinite_etale_adicCompletion_tensorProduct_of_flat_of_map_maximalIdeal_eq`](thm.html#AdicCompletion.exists_moduleFinite_etale_adicCompletion_tensorProduct_of_flat_of_map_maximalIdeal_eq).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsLocalRing_exists_isLocalRing_etale_free_residueField_algEquiv.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open IsLocalRing

theorem IsLocalRing.exists_isLocalRing_etale_free_residueField_algEquiv
    (R : Type) [CommRing R] [IsLocalRing R]
    (k' : Type) [Field k'] [Algebra (ResidueField R) k'] [Module.Finite (ResidueField R) k']
    [Algebra.IsSeparable (ResidueField R) k'] :
    ∃ (E : Type) (_ : CommRing E) (_ : IsLocalRing E) (_ : Algebra R E) (_ : IsLocalHom (algebraMap R E)),
      Module.Finite R E ∧ Module.Free R E ∧ Algebra.Etale R E ∧
      (maximalIdeal R).map (algebraMap R E) = maximalIdeal E ∧
      Nonempty (ResidueField E ≃ₐ[ResidueField R] k') := by sorry
