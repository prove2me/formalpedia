/-!
# Round six, compact controls (I2C): the value-level mechanism

Colkitt's compact dirty controls, uniform variant (see `jain6/compact/DESIGN.md`).  The state of
one record is `(t, u, y)` (the temporary `T`, the control `U`, the target slot `Y`); the source
slot `x` is a parameter.  Radices: `W = 2^K` (slot segments), `R = 2^G` (compact digits);
`n` low selected positions `j_s = ρ + s K`.

* `dgt W s x = x / W^s % W`; `digits_add`: digit-wise addition without carries;
  `eq_of_digits`: equal low digits and equal high part give equal numbers.
* `segSum tf ru rv rw w0 u v n = Σ_{s<n} w0 rw^s tf (u / ru^s) (v / rv^s)` (the register loop).
* The offsets `oA` (`Y += Σ 2 z_s t_s 2^{j_s}`), `oB` (`Y += Σ z_s (1 - 2 t_s) 2^{j_s}`), `oS`
  (packed selected bits), `oC` (`Σ (y_s xor z_s) R^s`), `oT` (the ideal toggle).
* The pull maps `rT, rU, rY`, the inverse phase `phInv` and the whole pull composite `Psi`.
* **`Psi_good`**: on a good state `Psi` is the ideal map (toggle the `n` low selected bits of `y`
  by those of `x`); `Psi_bij`-type facts are proved at rank level.
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL2C

open Finset

/-! ## Digits -/

theorem dgt_zero (W x : ℕ) : dgt W 0 x = x % W := by simp [dgt]

theorem dgt_succ (W s x : ℕ) : dgt W (s + 1) x = dgt W s (x / W) := by
  simp only [dgt, pow_succ, Nat.div_div_eq_div_mul, mul_comm]

/-- `x = Σ_{s<n} dgt s x W^s + W^n (x / W^n)`. -/
theorem digits_sum (W : ℕ) : ∀ (n x : ℕ),
    (x : ℤ) = ∑ s ∈ range n, (dgt W s x : ℤ) * (W : ℤ) ^ s + (W : ℤ) ^ n * ((x / W ^ n : ℕ) : ℤ)
  | 0, x => by simp
  | n + 1, x => by
    have ih := digits_sum W n (x / W)
    rw [sum_range_succ']
    have h1 : x = x % W + W * (x / W) := (Nat.mod_add_div x W).symm
    have e : x / W ^ (n + 1) = x / W / W ^ n := by
      rw [pow_succ, mul_comm, Nat.div_div_eq_div_mul]
    simp only [dgt_succ, dgt_zero, e]
    have : (x : ℤ) = ((x % W : ℕ) : ℤ) + (W : ℤ) * ((x / W : ℕ) : ℤ) := by exact_mod_cast h1
    rw [this, ih]
    simp only [pow_zero, mul_one, pow_succ]
    rw [mul_add, mul_sum]
    have : ∀ s ∈ range n, (W : ℤ) * ((dgt W s (x / W) : ℤ) * (W : ℤ) ^ s) =
        (dgt W s (x / W) : ℤ) * ((W : ℤ) ^ s * W) := fun s _ => by ring
    rw [sum_congr rfl this]
    ring

theorem eq_of_digits (W n : ℕ) {x x' : ℕ} (hd : ∀ s < n, dgt W s x = dgt W s x')
    (hh : x / W ^ n = x' / W ^ n) : x = x' := by
  have a := digits_sum W n x
  have b := digits_sum W n x'
  have : (x : ℤ) = x' := by
    rw [a, b, hh]
    congr 1
    exact sum_congr rfl fun s hs => by rw [hd s (mem_range.1 hs)]
  exact_mod_cast this

/-- **Digit-wise addition without carries.** -/
theorem digits_add (W : ℕ) (hW : 0 < W) : ∀ (n x : ℕ) (δ : ℕ → ℤ),
    (∀ s < n, 0 ≤ (dgt W s x : ℤ) + δ s ∧ (dgt W s x : ℤ) + δ s < W) →
    ∃ x' : ℕ, (x' : ℤ) = x + ∑ s ∈ range n, δ s * (W : ℤ) ^ s ∧
      (∀ s < n, (dgt W s x' : ℤ) = dgt W s x + δ s) ∧ x' / W ^ n = x / W ^ n
  | 0, x, δ, _ => ⟨x, by simp, fun s hs => absurd hs (by omega), rfl⟩
  | n + 1, x, δ, h => by
    obtain ⟨y', e1, e2, e3⟩ := digits_add W hW n (x / W) (fun s => δ (s + 1)) (fun s hs => by
      have := h (s + 1) (by omega); rwa [dgt_succ] at this)
    have h0 := h 0 (by omega)
    rw [dgt_zero] at h0
    set d0 : ℤ := ((x % W : ℕ) : ℤ) + δ 0
    have hd0 : 0 ≤ d0 := h0.1
    refine ⟨d0.toNat + W * y', ?_, ?_, ?_⟩
    · push_cast
      rw [Int.toNat_of_nonneg hd0, e1, sum_range_succ']
      have hx : (x : ℤ) = ((x % W : ℕ) : ℤ) + (W : ℤ) * ((x / W : ℕ) : ℤ) := by
        exact_mod_cast (Nat.mod_add_div x W).symm
      simp only [d0, pow_zero, mul_one, pow_succ]
      rw [hx, mul_add, mul_sum]
      have : ∀ s ∈ range n, (W : ℤ) * (δ (s + 1) * (W : ℤ) ^ s) = δ (s + 1) * ((W : ℤ) ^ s * W) :=
        fun s _ => by ring
      rw [sum_congr rfl this]
      ring
    · intro s hs
      have hlt : d0.toNat < W := by
        have := h0.2; omega
      have hdiv : (d0.toNat + W * y') / W = y' := by
        rw [Nat.add_mul_div_left _ _ hW, Nat.div_eq_of_lt hlt, zero_add]
      rcases s with _ | s
      · rw [dgt_zero, dgt_zero, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hlt,
          Int.toNat_of_nonneg hd0]
      · rw [dgt_succ, dgt_succ, hdiv, e2 s (by omega)]
    · have hlt : d0.toNat < W := by
        have := h0.2; omega
      have hdiv : (d0.toNat + W * y') / W = y' := by
        rw [Nat.add_mul_div_left _ _ hW, Nat.div_eq_of_lt hlt, zero_add]
      have k : ∀ a, a / W ^ (n + 1) = a / W / W ^ n := fun a => by
        rw [pow_succ, mul_comm, Nat.div_div_eq_div_mul]
      rw [k, k, hdiv, e3]

/-- A number with the same high part as one below `W^n (q+1)`. -/
theorem lt_of_hi {W n x : ℕ} (hW : 0 < W) : x < W ^ n * (x / W ^ n + 1) := by
  have h := Nat.lt_mul_div_succ x (pow_pos hW n)
  linarith [Nat.mul_comm (W ^ n) (x / W ^ n + 1)]

/-! ## The register-loop sum -/

/-- For an even radix, the parity of `u / W^s` is that of its digit. -/
theorem par_dgt {W : ℕ} (hW : 2 ∣ W) (s u : ℕ) : (u / W ^ s) % 2 = dgt W s u % 2 := by
  unfold dgt; rw [Nat.mod_mod_of_dvd _ hW]

/-! ## Parameters and the offsets -/

/-! ## Closed forms of the offsets -/

section Closed

variable {K ρ G n : ℕ}

theorem two_pow_dvd {G : ℕ} (hG : 1 ≤ G) : 2 ∣ 2 ^ G := dvd_pow_self 2 (by omega)

theorem cdiv (u W s : ℕ) : ((u : ℤ) / ((W : ℤ)) ^ s) = ((u / W ^ s : ℕ) : ℤ) := by
  rw [Int.natCast_div]; push_cast; rfl

theorem cdivG (u G s : ℕ) : ((u : ℤ) / ((2 : ℤ) ^ G) ^ s) = ((u / (2 ^ G) ^ s : ℕ) : ℤ) := by
  have := cdiv u (2 ^ G) s; push_cast at this; exact this

theorem cpar {W : ℕ} (hW : 2 ∣ W) (u s : ℕ) :
    ((u / W ^ s : ℕ) : ℤ) % 2 = ((dgt W s u % 2 : ℕ) : ℤ) := by
  exact_mod_cast par_dgt hW s u

theorem oS_eq (hK : 1 ≤ K) (y : ℕ) : oS K ρ G n y =
    ∑ s ∈ range n, ((ybit K ρ s y : ℕ) : ℤ) * ((2 : ℤ) ^ G) ^ s := by
  unfold oS segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cpar (two_pow_dvd hK)]
  unfold ybit seg; ring

theorem oT_eq (hK : 1 ≤ K) (x y : ℕ) : oT K ρ n x y =
    ∑ s ∈ range n, ((ybit K ρ s x : ℕ) * (1 - 2 * (ybit K ρ s y : ℕ)) : ℤ) *
      ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) := by
  unfold oT segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cdivG, cpar (two_pow_dvd hK), cpar (two_pow_dvd hK)]
  unfold ybit seg; ring

end Closed

/-! ## Segment-wise updates of a slot -/

section Slot

variable {K ρ n L : ℕ}

/-- Slots with equal low part, segments and high part are equal. -/
theorem slot_eq {y y' : ℕ} (h0 : y % 2 ^ ρ = y' % 2 ^ ρ) (hs : ∀ s < n, seg K ρ s y = seg K ρ s y')
    (hh : y / 2 ^ ρ / (2 ^ K) ^ n = y' / 2 ^ ρ / (2 ^ K) ^ n) : y = y' := by
  have e : y / 2 ^ ρ = y' / 2 ^ ρ := eq_of_digits (2 ^ K) n (fun s h => hs s h) hh
  rw [← Nat.mod_add_div y (2 ^ ρ), ← Nat.mod_add_div y' (2 ^ ρ), h0, e]

/-- Compact fields: digit-wise addition, staying below `R^n`. -/
theorem cf_add {G : ℕ} {w : ℕ} (hw : w < (2 ^ G) ^ n) (δ : ℕ → ℤ)
    (h : ∀ s < n, 0 ≤ (cdg G s w : ℤ) + δ s ∧ (cdg G s w : ℤ) + δ s < 2 ^ G) :
    ∃ w' : ℕ, (w' : ℤ) = w + ∑ s ∈ range n, δ s * ((2 : ℤ) ^ G) ^ s ∧ w' < (2 ^ G) ^ n ∧
      (∀ s < n, (cdg G s w' : ℤ) = cdg G s w + δ s) := by
  obtain ⟨z, e1, e2, e3⟩ := digits_add (2 ^ G) (by positivity) n w δ (by
    intro s hs; have := h s hs; unfold cdg at this; push_cast at this ⊢; exact this)
  refine ⟨z, by push_cast at e1 ⊢; exact e1, ?_, fun s hs => e2 s hs⟩
  have : w / (2 ^ G) ^ n = 0 := Nat.div_eq_of_lt hw
  have hz := lt_of_hi (W := 2 ^ G) (n := n) (x := z) (by positivity)
  rw [e3, this] at hz; simpa using hz

end Slot

/-! ## Modular pulls -/

/-- `subM` of an exact result. -/
theorem subM_of {Q : ℕ} {a a' : ℕ} {o : ℤ} (h : (a' : ℤ) = a - o) (ha' : a' < Q) :
    subM Q a o = a' := by
  unfold subM; rw [← h, Int.emod_eq_of_lt (by omega) (by omega)]; simp

/-! ## States, the phases, the composites -/

/-! ## Exactness on good states -/

section Good

variable {K ρ G n L : ℕ}

theorem seg_lt (s y : ℕ) : seg K ρ s y < 2 ^ K := Nat.mod_lt _ (by positivity)

theorem two_pow_even (hK : 1 ≤ K) : 2 ^ K = 2 * 2 ^ (K - 1) := by
  rw [← pow_succ']; congr 1; omega

/-- The ideal map on one slot. -/
theorem Tl_spec (hK : 1 ≤ K) (hL : ρ + n * K ≤ L) (x : ℕ) {y : ℕ} (hy : y < 2 ^ L) :
    Tl K ρ n x y < 2 ^ L ∧ Tl K ρ n x y % 2 ^ ρ = y % 2 ^ ρ ∧
      Tl K ρ n x y / 2 ^ ρ / (2 ^ K) ^ n = y / 2 ^ ρ / (2 ^ K) ^ n ∧
      ∀ s < n, (seg K ρ s (Tl K ρ n x y) : ℤ) = seg K ρ s y +
        ((ybit K ρ s x : ℕ) : ℤ) * (1 - 2 * ((ybit K ρ s y : ℕ) : ℤ)) := by
  obtain ⟨y', ey, hy', ly, dy, hhy⟩ := slot_add hK hL hy
    (fun s => ((ybit K ρ s x : ℕ) : ℤ) * (1 - 2 * ((ybit K ρ s y : ℕ) : ℤ))) (by
    intro s hs
    have h1 := seg_lt (K := K) (ρ := ρ) s y
    have hev := two_pow_even hK
    have hxb : ybit K ρ s x < 2 := Nat.mod_lt _ (by norm_num)
    unfold ybit at hxb ⊢
    have h1' : (seg K ρ s y : ℤ) < 2 * 2 ^ (K - 1) := by
      have h1c := h1; rw [hev] at h1c; exact_mod_cast h1c
    have hev' : ((2 : ℤ) ^ K) = 2 * 2 ^ (K - 1) := by exact_mod_cast hev
    rw [hev']
    rcases (show seg K ρ s x % 2 = 0 ∨ seg K ρ s x % 2 = 1 by omega) with h | h <;> rw [h] <;>
      push_cast <;> omega)
  have e : Tl K ρ n x y = y' := by
    unfold Tl; rw [oT_eq hK]
    have : (y : ℤ) + ∑ s ∈ range n, ((ybit K ρ s x : ℕ) * (1 - 2 * (ybit K ρ s y : ℕ)) : ℤ) *
        ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) = y' := by rw [ey]
    rw [this]; simp
  rw [e]; exact ⟨hy', ly, hhy, dy⟩

/-- **The program is the ideal map on good states.** -/
theorem Psi_good_sol_aux (hK : 1 ≤ K) (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) (x : ℕ) {c : CS}
    (hb : Box G n L c) (hg : Good K ρ G n c) : Psi K ρ G n L x c = TlS K ρ n x c := by
  obtain ⟨t, u, y⟩ := c
  obtain ⟨hbt, hbu, hby⟩ := hb
  simp only at hbt hbu hby
  have hev := two_pow_even hK
  -- load
  obtain ⟨u1, eu1, hu1, du1⟩ := cf_add (n := n) (G := G) hbu
    (fun s => ((ybit K ρ s x : ℕ) : ℤ)) (by
    intro s hs
    have h1 := (hg s hs).2.1
    have hxb : ybit K ρ s x < 2 := Nat.mod_lt _ (by norm_num)
    have h3 : cdg G s u + ybit K ρ s x < 2 ^ G := by simp only at h1; omega
    exact ⟨by positivity, by exact_mod_cast h3⟩)
  have s1 : pU G n (-(oS K ρ G n x)) ⟨t, u, y⟩ = ⟨t, u1, y⟩ := by
    simp only [pU]; congr 1
    refine subM_of ?_ hu1
    rw [eu1, oS_eq hK]; ring
  have hv0 : ∀ s < n, 1 ≤ seg K ρ s y ∧ seg K ρ s y + 2 * 2 ^ G < 2 ^ K := by
    intro s hs
    obtain ⟨-, -, g1, g2⟩ := hg s hs
    simp only at g1 g2
    have := Nat.div_add_mod (seg K ρ s y) 2
    have := Nat.mod_lt (seg K ρ s y) (show 0 < 2 by norm_num)
    rw [hev]; omega
  have ht0 : ∀ s < n, cdg G s t + 2 ≤ 2 ^ G := fun s hs => (hg s hs).1
  -- phase 1
  obtain ⟨y2, E2, hy2, ly2, hhy2, dy2⟩ := phInv_spec hK hG hL (u := u1) ⟨hbt, hu1, hby⟩ ht0 hv0
  -- unload
  have s3 : pU G n (oS K ρ G n x) ⟨t, u1, y2⟩ = ⟨t, u, y2⟩ := by
    simp only [pU]; congr 1
    refine subM_of ?_ hbu
    rw [eu1, oS_eq hK]; ring
  -- phase 2
  have hv2 : ∀ s < n, 1 ≤ seg K ρ s y2 ∧ seg K ρ s y2 + 2 * 2 ^ G < 2 ^ K := by
    intro s hs
    obtain ⟨-, -, g1, g2⟩ := hg s hs
    simp only at g1 g2
    have e := dy2 s hs
    have := Nat.div_add_mod (seg K ρ s y) 2
    have := Nat.mod_lt (seg K ρ s y) (show 0 < 2 by norm_num)
    have hz : cdg G s u1 % 2 < 2 := Nat.mod_lt _ (by norm_num)
    unfold ybit at e
    have g1' : (1 : ℤ) ≤ (seg K ρ s y : ℤ) / 2 := by exact_mod_cast g1
    have g2' : (seg K ρ s y : ℤ) / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1) := by exact_mod_cast g2
    have hev' : ((2 : ℤ) ^ K) = 2 * 2 ^ (K - 1) := by exact_mod_cast hev
    have goal : (1 : ℤ) ≤ seg K ρ s y2 ∧ (seg K ρ s y2 : ℤ) + 2 * 2 ^ G < 2 ^ K := by
      rw [e, hev']
      rcases (show cdg G s u1 % 2 = 0 ∨ cdg G s u1 % 2 = 1 by omega) with h | h <;> rw [h] <;>
        push_cast <;> omega
    exact_mod_cast goal
  obtain ⟨y4, E4, hy4, ly4, hhy4, dy4⟩ := phInv_spec hK hG hL (u := u) ⟨hbt, hbu, hy2⟩ ht0 hv2
  have E : Psi K ρ G n L x ⟨t, u, y⟩ = ⟨t, u, y4⟩ := by
    unfold Psi; rw [s1, E2, s3, E4]
  rw [E]
  simp only [TlS]
  congr 1
  obtain ⟨b1, l1, h1, d1⟩ := Tl_spec hK hL x hby
  refine slot_eq (K := K) (ρ := ρ) (n := n) (by rw [l1, ly4, ly2]) (fun s hs => ?_)
    (by rw [h1, hhy4, hhy2])
  have e4 := dy4 s hs
  have e2 := dy2 s hs
  have e1 := d1 s hs
  have du := du1 s hs
  unfold ybit at e4 e2 e1 du
  have hu'' : cdg G s u1 = cdg G s u + seg K ρ s x % 2 := by exact_mod_cast du
  have goal : (seg K ρ s y4 : ℤ) = seg K ρ s (Tl K ρ n x y) := by
    rw [e1, e4, e2]
    rcases (show cdg G s u % 2 = 0 ∨ cdg G s u % 2 = 1 by omega) with h1 | h1 <;>
    rcases (show cdg G s u1 % 2 = 0 ∨ cdg G s u1 % 2 = 1 by omega) with h2 | h2 <;>
    rcases (show seg K ρ s x % 2 = 0 ∨ seg K ρ s x % 2 = 1 by omega) with h3 | h3 <;>
    rcases (show seg K ρ s y % 2 = 0 ∨ seg K ρ s y % 2 = 1 by omega) with h4 | h4 <;>
    rcases (show seg K ρ s y2 % 2 = 0 ∨ seg K ρ s y2 % 2 = 1 by omega) with h5 | h5 <;>
    simp only [h1, h2, h3, h4, h5] at e2 ⊢ <;> push_cast at e2 ⊢ <;> omega
  exact_mod_cast goal

end Good

end IntMul.Kappa.R6.IL2C

