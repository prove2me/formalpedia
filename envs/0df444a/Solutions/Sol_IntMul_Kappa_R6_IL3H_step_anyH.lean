-- Source module: Solutions.KFX7Row
/-!
# KFX §7: `RowUP`, the uniform Lemma 13 row addition

`rowCodeU q` (over `l12prog`) implements `Pm i j` in `SImplQ` form for every admissible parameter
set read from the background registers `36 … 45` (`rowQ`).  The Lemma 13 cost `⌈bnd⌉` plus the
header cost `cHd` is absorbed into `bnd` with the constant `Kc + 8·10^12`, and `ceil_bnd_le` turns
it into the `RowU` form.  The code is placed in `KFM.kTable ext` by relabelling the `l12prog`
calls (`kTable_l12`); no extra procedures are needed (`nR = 0`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly KFN P8Lift

theorem posR_inj' {K e k : ℕ} (hK : 1 ≤ K) (he : K * (mC ^ k * mC - 1) ≤ e) :
    Function.Injective (posR K e k) := by
  intro p p' h
  have a := posR_he he p
  have b := posR_he he p'
  rw [h] at a
  have h1 : K * (p.2.val + mC ^ k * p.1.val) = K * (p'.2.val + mC ^ k * p'.1.val) := by omega
  have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
  have hf : 0 < mC ^ k := by positivity
  have hd : ∀ x : Fin mC × Fin (mC ^ k), (x.2.val + mC ^ k * x.1.val) / mC ^ k = x.1.val ∧
      (x.2.val + mC ^ k * x.1.val) % mC ^ k = x.2.val := fun x => by
    constructor
    · rw [Nat.add_mul_div_left _ _ hf, Nat.div_eq_of_lt x.2.isLt, zero_add]
    · rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt x.2.isLt]
