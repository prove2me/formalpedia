    simp only [List.mem_map, TypeDensity.otherChildren, List.mem_flatMap, List.mem_replicate] at hL
    obtain ⟨z, ⟨ij, -, -, rfl⟩, rfl⟩ := hL
    exact (TypeDensity.state_law_coeff_nonneg q (TypeDensity.finite_field_card_primePower k) _
      (show TypeDensity.State.Valid (.single 1 _) from ⟨Nat.one_pos, Nat.succ_pos _⟩) τ).2 _ (Nat.succ_pos _)
  -- count
  have hC : ∀ m ∈ TypeDensity.residuePatterns n, ((TypeDensity.divisorCount 0 m).eval (q : ℚ) : ℝ)
      = ((S.filter fun D => TypeDensity.HasArray k n D m).card : ℝ) := by
    intro m hm
    rw [← (TypeDensity.affine_divisor_count k n m hm).2, Nat.subtype_card (S.filter fun D ↦ TypeDensity.HasArray k n D m)
      fun D ↦ by simp only [Finset.mem_filter, hS]; exact Iff.rfl]
    simp
  -- measure side
  have hmeas : μ E = ∑ m ∈ TypeDensity.residuePatterns n, ((S.filter fun D => TypeDensity.HasArray k n D m).card : ℝ≥0∞) *
      ((q : ℝ≥0∞)⁻¹ ^ n * TypeDensity.densityValue (TypeDensity.lawCoeff (TypeDensity.arrayLaw m) σ) q) := by
    rw [hsum S hS E hE]
    have h1 : ∀ D ∈ S, μ (E ∩ TypeDensity.residueCell O n (TypeDensity.divisorAffinePolynomial k D)) =
