section CappedPolicyUploadModule9
noncomputable section
open MeasureTheory CappedBaseStock CappedPolicyDynamics CappedPolicyMoments CappedWindowIntegrals
open scoped ENNReal NNReal BigOperators

namespace CappedPolicyWindows

lemma policyWindowInput_delivery_eq (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) (ω : Sample) (i : Fin (c.L + 1)) :
    (policyWindowInput c π t ω).2 i = arrival c (run c π ω (t + i.val)) := by
  have hi : i.val ≤ c.L := by have := i.isLt; omega
  simpa only [windowDelivery, dif_pos i.isLt] using
    windowDelivery_policyWindowInput c π ω t i.val hi

lemma integrable_policyWindowInput_delivery (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (t : ℕ) (i : Fin (c.L + 1)) :
    Integrable (fun ω => ((policyWindowInput c π t ω).2 i : ℝ)) (sampleLaw P) := by
  simp_rw [policyWindowInput_delivery_eq]
  exact integrable_arrival P c π hfinite (t + i.val)

/-- The actual joint law of current inventory and the next L+1 committed deliveries. -/
def policyWindowLaw (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) : WindowLaw (c.L + 1) where
  law := Measure.map (policyWindowInput c π t) (sampleLaw P)
  probability := Measure.isProbabilityMeasure_map (measurable_policyWindowInput c π t).aemeasurable
  inventory_integrable := by
    apply (integrable_map_measure (by fun_prop)
      (measurable_policyWindowInput c π t).aemeasurable).mpr
    exact integrable_inventory P c π hfinite t
  delivery_integrable i := by
    apply (integrable_map_measure (by fun_prop)
      (measurable_policyWindowInput c π t).aemeasurable).mpr
    exact integrable_policyWindowInput_delivery P c π hfinite t i

lemma policyWindowLaw_inventoryMean (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    (∫ w, (w.1 : ℝ) ∂(policyWindowLaw P c π hfinite t).law) = inventoryMean P c π t := by
  change (∫ w : WindowInput (c.L + 1), (w.1 : ℝ)
    ∂Measure.map (policyWindowInput c π t) (sampleLaw P)) = _
  rw [integral_map_of_stronglyMeasurable (measurable_policyWindowInput c π t) (by fun_prop)]
  rfl

lemma policyWindowLaw_deliveryMean (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (t : ℕ) (i : Fin (c.L + 1)) :
    (∫ w, (w.2 i : ℝ) ∂(policyWindowLaw P c π hfinite t).law) =
      arrivalMean P c π (t + i.val) := by
  change (∫ w : WindowInput (c.L + 1), (w.2 i : ℝ)
    ∂Measure.map (policyWindowInput c π t) (sampleLaw P)) = _
  rw [integral_map_of_stronglyMeasurable (measurable_policyWindowInput c π t) (by fun_prop)]
  simp only [policyWindowInput_delivery_eq, arrivalMean]

/-- Uniform finite mixture of integrable input laws. -/
def averageWindowLaw {n : ℕ} (W : ℕ → WindowLaw n) (T : ℕ) (hT : 0 < T) : WindowLaw n where
  law := (T : ℝ≥0∞)⁻¹ • ∑ t ∈ Finset.range T, (W t).law
  probability := by
    constructor
    simp only [Measure.smul_apply, Measure.finsetSum_apply, measure_univ,
      Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one, smul_eq_mul]
    exact ENNReal.inv_mul_cancel (by exact_mod_cast hT.ne') (by finiteness)
  inventory_integrable :=
    (integrable_finsetSum_measure.mpr (fun t _ => (W t).inventory_integrable)).smul_measure
      (by simp [hT.ne'])
  delivery_integrable i :=
    (integrable_finsetSum_measure.mpr (fun t _ => (W t).delivery_integrable i)).smul_measure
      (by simp [hT.ne'])

lemma integral_averageWindowLaw {n : ℕ} (W : ℕ → WindowLaw n)
    (T : ℕ) (hT : 0 < T) (f : WindowInput n → ℝ)
    (hf : ∀ t ∈ Finset.range T, Integrable f (W t).law) :
    (∫ w, f w ∂(averageWindowLaw W T hT).law) =
      (∑ t ∈ Finset.range T, ∫ w, f w ∂(W t).law) / (T : ℝ) := by
  change (∫ w, f w ∂((T : ℝ≥0∞)⁻¹ • ∑ t ∈ Finset.range T, (W t).law)) = _
  rw [integral_smul_measure, integral_finsetSum_measure hf]
  simp [ENNReal.toReal_inv, div_eq_mul_inv, mul_comm]

lemma averageWindowLaw_inventoryMean {n : ℕ} (W : ℕ → WindowLaw n)
    (T : ℕ) (hT : 0 < T) :
    (∫ w, (w.1 : ℝ) ∂(averageWindowLaw W T hT).law) =
      (∑ t ∈ Finset.range T, ∫ w, (w.1 : ℝ) ∂(W t).law) / (T : ℝ) :=
  integral_averageWindowLaw W T hT _ (fun t _ => (W t).inventory_integrable)

lemma averageWindowLaw_deliveryMean {n : ℕ} (W : ℕ → WindowLaw n)
    (T : ℕ) (hT : 0 < T) (i : Fin n) :
    (∫ w, (w.2 i : ℝ) ∂(averageWindowLaw W T hT).law) =
      (∑ t ∈ Finset.range T, ∫ w, (w.2 i : ℝ) ∂(W t).law) / (T : ℝ) :=
  integral_averageWindowLaw W T hT _ (fun t _ => (W t).delivery_integrable i)

lemma windowExpectedInventory_average (P : DemandLaw) {n : ℕ}
    (W : ℕ → WindowLaw n) (T : ℕ) (hT : 0 < T) (m : ℕ) :
    windowExpectedInventory P (averageWindowLaw W T hT) m =
      (∑ t ∈ Finset.range T, windowExpectedInventory P (W t) m) / (T : ℝ≥0∞) := by
  have hmeas : Measurable (fun wd : WindowInput n × DemandPath =>
      (windowInventory wd.1 wd.2 m : ℝ≥0∞)) :=
    (measurable_windowInventory n m).coe_nnreal_ennreal
  unfold windowExpectedInventory
  rw [lintegral_prod _ hmeas.aemeasurable]
  change (∫⁻ w, ∫⁻ d, (windowInventory w d m : ℝ≥0∞) ∂demandPathLaw P
    ∂((T : ℝ≥0∞)⁻¹ • ∑ t ∈ Finset.range T, (W t).law)) = _
  rw [lintegral_smul_measure, lintegral_finsetSum_measure]
  simp_rw [← lintegral_prod _ hmeas.aemeasurable]
  rw [div_eq_mul_inv, mul_comm, smul_eq_mul]

abbrev averagedPolicyWindowLaw (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (T : ℕ) (hT : 0 < T) : WindowLaw (c.L + 1) :=
  averageWindowLaw (policyWindowLaw P c π hfinite) T hT

lemma averagedPolicyWindowLaw_inventoryMean (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤) (T : ℕ) (hT : 0 < T) :
    (∫ w, (w.1 : ℝ) ∂(averagedPolicyWindowLaw P c π hfinite T hT).law) =
      (∑ t ∈ Finset.range T, inventoryMean P c π t) / (T : ℝ) := by
  rw [averageWindowLaw_inventoryMean]
  simp only [policyWindowLaw_inventoryMean]

lemma averagedPolicyWindowLaw_deliveryMean (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
