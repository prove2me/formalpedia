variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

private theorem algebraMap_mem_idealBall {N : Ideal R} (hN : N ≠ ⊥) {r : R} (hr : r ∈ N) :
    algebraMap K (IsDedekindDomain.FiniteAdeleRing R K) (algebraMap R K r) ∈ idealBall R K N := fun v => by
  rw [show (algebraMap K (IsDedekindDomain.FiniteAdeleRing R K) (algebraMap R K r)) v
      = algebraMap K (v.adicCompletion K) (algebraMap R K r) from rfl, valued_algebraMap,
    idealBound_of_ne_bot hN, IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem]
  classical
  exact ((Ideal.iInf_maxPowDividing_eq hN).ge.trans (iInf_le _ v)) hr

end MemGlue
