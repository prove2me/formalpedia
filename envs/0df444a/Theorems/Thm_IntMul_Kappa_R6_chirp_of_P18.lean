theorem IntMul.Kappa.R6.chirp_of_P18 (P : Prm) (hP : P.Ok) (tab : Fin 1 → IStmt HS 1) (H : P18Body6 P tab) :
    ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eC : Fin (7 + E)) (C₀ : ℝ) (A n₁ : ℕ),
      0 ≤ C₀ ∧
    ∀ (Q : Q6), Q.P = P → QOk Q → n₁ ≤ Q.n → ∀ (D : ℕ), Q.d = D + 1 →
    ∀ [∀ i, NeZero (Q.tB D i)],
    ∃ (θt θit at' bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) (ζ : ℂ),
      ζ ^ Q.tB D (Fin.last D) = -1 ∧
      Phases Q.p (twX (Q.tB D) ζ) θt ∧
      Phases Q.p (fun j => (twX (Q.tB D) ζ j)⁻¹) θit ∧
      Phases Q.p (fun j => (starRingEnd ℂ) (chirp (Q.sB D) (Q.tB D) j)) at' ∧
      Phases Q.p (chirp (Q.sB D) (Q.tB D)) bt ∧
      Grid Q.p bt ∧
      ∀ Isym, chirpG6 Isym (IL.kTableP tab ext) eC cS C₀ A Q D θt θit at' bt := by sorry
