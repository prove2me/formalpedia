section hdr
variable {s : IState HS}

theorem sp_tkH (F : Fin HS → List ℤ) {R : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hR5 : R.val < 56) (hRT : R ≠ dT) (hF : F dT = a :: l) (ha : zsz a ≤ B) :
    Sp (tkH R) (encK s F) (encK s (Function.update (Function.update F R (a :: F R)) dT l))
      (5000 * (B + 2)) := by
  have h1 := sp_pushR (s := s) F (i := R) (j := dT) (B := B) hR5 (by decide) hF ha
  have h2 := sp_pop (s := s) (Function.update F R (a :: F R)) (i := dT) (a := a) (l := l) (B := B)
    (by decide) (by rw [Function.update_of_ne (Ne.symm hRT), hF]) ha
  exact (h1.seq h2).mono (by omega)

theorem sp_rtH (F : Fin HS → List ℤ) {R : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hR5 : R.val < 56) (hRT : R ≠ dT) (hF : F R = a :: l) (ha : zsz a ≤ B) :
    Sp (rtH R) (encK s F) (encK s (Function.update (Function.update F dT (a :: F dT)) R l))
      (5000 * (B + 2)) := by
  have h1 := sp_pushR (s := s) F (i := dT) (j := R) (B := B) (by decide) hR5 hF ha
  have h2 := sp_pop (s := s) (Function.update F dT (a :: F dT)) (i := R) (a := a) (l := l) (B := B)
    hR5 (by rw [Function.update_of_ne hRT, hF]) ha
  exact (h1.seq h2).mono (by omega)

theorem tkL_sp {B : ℕ} {r0 w1 w2 o du : List ℤ} :
    ∀ (Rs : List (Fin HS)) (vs : List ℤ) (G : Fin HS → List ℤ) (dt : List ℤ),
    Rs.length = vs.length → (∀ R ∈ Rs, FFree R) → (∀ v ∈ vs, zsz v ≤ B) →
    Sp (tkL Rs) (encK s (AF G r0 w1 w2 o (vs ++ dt) du))
      (encK s (AF (pushAll G Rs vs) r0 w1 w2 o dt du)) (Rs.length * (5000 * (B + 2)) + 1)
  | [], [], G, dt, _, _, _ => by simpa [tkL, pushAll] using Sp.skip (encK s (AF G r0 w1 w2 o dt du))
  | [], _ :: _, _, _, h, _, _ => by simp at h
  | _ :: _, [], _, _, h, _, _ => by simp at h
  | R :: Rs, v :: vs, G, dt, hl, hR, hv => by
    obtain ⟨h5, hne⟩ := hR R (by simp)
    have h1 := sp_tkH (s := s) (AF G r0 w1 w2 o ((v :: vs) ++ dt) du) (R := R) (B := B) h5
      (hne dT (by decide)) (by rw [AF_dt]; rfl) (hv v (by simp))
    rw [AF_ne hne, AFu_ne hne, AFu_dt] at h1
    have h2 := tkL_sp (B := B) (r0 := r0) (w1 := w1) (w2 := w2) (o := o) (du := du) Rs vs (Function.update G R (v :: G R)) dt (by simpa using hl)
      (fun R' h => hR R' (by simp [h])) (fun v' h => hv v' (by simp [h]))
    refine (h1.seq h2).mono ?_
    simp only [List.length_cons]; nlinarith

theorem rtLR_sp {B : ℕ} {r0 w1 w2 o du : List ℤ} :
    ∀ (Rs : List (Fin HS)) (vs : List ℤ) (G : Fin HS → List ℤ) (dt : List ℤ),
    Rs.length = vs.length → Rs.Nodup → (∀ R ∈ Rs, FFree R) → (∀ R ∈ Rs, G R = []) →
    (∀ v ∈ vs, zsz v ≤ B) →
    Sp (rtLR Rs) (encK s (AF (pushAll G Rs vs) r0 w1 w2 o dt du))
      (encK s (AF G r0 w1 w2 o (vs ++ dt) du)) (Rs.length * (5000 * (B + 2)) + 1)
  | [], [], G, dt, _, _, _, _, _ => by simpa [rtLR, pushAll] using Sp.skip (encK s (AF G r0 w1 w2 o dt du))
  | [], _ :: _, _, _, h, _, _, _, _ => by simp at h
  | _ :: _, [], _, _, h, _, _, _, _ => by simp at h
  | R :: Rs, v :: vs, G, dt, hl, hnd, hR, hG, hv => by
    obtain ⟨h5, hne⟩ := hR R (by simp)
    have hRn : R ∉ Rs := (List.nodup_cons.1 hnd).1
    have hG1 : ∀ R' ∈ Rs, Function.update G R (v :: G R) R' = [] := by
      intro R' h'
      rw [Function.update_of_ne (by rintro rfl; exact hRn h')]; exact hG R' (by simp [h'])
    have h1 := rtLR_sp (B := B) (r0 := r0) (w1 := w1) (w2 := w2) (o := o) (du := du) Rs vs (Function.update G R (v :: G R)) dt (by simpa using hl)
      (List.nodup_cons.1 hnd).2 (fun R' h => hR R' (by simp [h])) hG1 (fun v' h => hv v' (by simp [h]))
    have hGR : G R = [] := hG R (by simp)
    have h2 := sp_rtH (s := s) (AF (Function.update G R (v :: G R)) r0 w1 w2 o (vs ++ dt) du)
      (R := R) (a := v) (l := []) (B := B) h5 (hne dT (by decide))
      (by rw [AF_ne hne, Function.update_self, hGR]) (hv v (by simp))
    have hGe : Function.update G R [] = G := by rw [← hGR, Function.update_eq_self]
    rw [AFu_dt, AF_dt, AFu_ne hne, Function.update_idem, hGe] at h2
    refine (h1.seq h2).mono ?_
    simp only [List.length_cons]; nlinarith

end hdr

