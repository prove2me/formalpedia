      refine Hb.mono' ?_ le_rfl
      have e2 : NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.oprod Δ (A.take (k + 1)) B)).reverse =
          NLogN.ints (NLogN.KFB.gflat (B.map (NLogN.KFM.gmulT Δ A[k]))).reverse ++
