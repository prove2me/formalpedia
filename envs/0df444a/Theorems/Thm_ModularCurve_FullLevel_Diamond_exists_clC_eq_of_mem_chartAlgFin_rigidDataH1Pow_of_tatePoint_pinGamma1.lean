        IsSectionThrough r.level.2.2.P Px Py ∧ IsSectionThrough r.level.2.2.Q Qx Qy))
    :

    ∀ (z : ↥K) (hz : z ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j),
      ∃ c : P₀.B₀, clC c = ⟨z, hz⟩ := by sorry
