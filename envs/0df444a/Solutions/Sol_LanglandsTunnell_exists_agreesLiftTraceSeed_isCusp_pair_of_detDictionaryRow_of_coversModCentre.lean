private theorem regular_productionMeasure :
    @Measure.Regular (AdelicGL2 (𝓞 F) F) (productionPinsCompact F).mS _ (productionPinsCompact F).μ := by
  letI : MeasurableSpace (AdelicGL2 (𝓞 F) F) := (productionPinsCompact F).mS
  haveI : BorelSpace (AdelicGL2 (𝓞 F) F) := NumberField.AdelicHaar.borelSpace_glBorel (Fin 2) (𝓞 F) F
