theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (N : ℕ) (k : Type) [Field k] [IsAlgClosed k] [CharZero k] (E : FakeEllipticCurve Λ N k)
    (𝓛 : E.A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛) (hK : (kernelPts E.f E.L 𝓛).Finite)
    (hR : RosatiCompatible E.f E.L 𝓛 E.act E.act_over star)
    (hprim : ∀ (𝓜 Q : E.A.Modules) (m : ℕ), Scheme.Modules.IsInvertible 𝓜 →
      RosatiCompatible E.f E.L 𝓜 E.act E.act_over star → InPicZero E.f E.L Q → Nonempty (𝓛 ≅ 𝓜.tensorPow m ⊗ Q) → m ≤ 1) :
    KernelTrivial E.f E.L 𝓛 := by
  classical
  obtain ⟨hBr1, hBr2⟩ := translation_eq_translate_toUnitPt_and_translate_eq_translation_ofUnitPt k E.f E.L
  have hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(E.f.base ⁻¹' {s}) = ((2 : ℕ) : WithBot ℕ∞) :=
    fun s => by rw [E.dim_fibre s]; rfl

  obtain ⟨H, hH⟩ := exists_addSubgroup_mem_iff_nonempty_pullback_translation_iso k E.f E.L E.comm 𝓛
  have hHk : ∀ Q : E.L.AlgPoints E.comm k,
      Q ∈ H ↔ toUnitPt E.f (RelativeGroupLaw.AlgPoints.toPoint Q) ∈ kernelPts E.f E.L 𝓛 := by
    intro Q
    rw [hH, mem_kernelPts_iff_nonempty_pullback_translate_iso k E.f E.L 𝓛, ← hBr1]
