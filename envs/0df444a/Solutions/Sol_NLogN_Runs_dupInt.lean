section
-- Source module: NLogNP.IntOps
namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem bitG_codeBit (b : Bool) : bitG (codeBit b) = some (codeBit b) := by
  cases b <;> rfl

theorem bitG_of_bitOf {o : Option Sym} (h : bitOf o = none) : o.bind bitG = none := by
  rcases o with _ | s
  · rfl
  · simp only [Option.bind_some, bitG]
    split_ifs with h'
    · rcases h' with rfl | rfl <;> exact absurd h (by decide)
    · rfl

theorem filterMap_bitG (l : List Bool) : (l.map codeBit).filterMap bitG = l.map codeBit := by
  induction l with
  | nil => rfl
  | cons b l ih => simp [List.filterMap_cons, bitG_codeBit, ih]

theorem Runs.moveBits {q src dst : Fin S} (hqs : q ≠ src) (hqd : q ≠ dst) (hsd : src ≠ dst)
    (σ : St S) (l : List Bool) (r : List Sym) (hs : σ.stk src = l.map codeBit ++ r)
    (hr : bitOf r.head? = none) :
    NLogN.Runs I prog (NLogN.moveBits q src dst : Stmt S P) σ
      ((σ.set src r).set dst ((l.map codeBit).reverse ++ σ.stk dst)) (moveCost l.length) := by
  have := Runs.move (I := I) (prog := prog) (g := bitG) hqs hqd hsd σ (l.map codeBit) r hs
    (by intro a ha; obtain ⟨b, _, rfl⟩ := List.mem_map.mp ha; simp [bitG_codeBit])
    (bitG_of_bitOf hr)
  rwa [filterMap_bitG, List.length_map] at this

end NLogN

end

