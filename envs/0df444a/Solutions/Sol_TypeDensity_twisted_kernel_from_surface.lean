  have hβr := TypeDensity.beta_right_chartBase beta
  have hD0 : ∀ r : R, TypeDensity.fullCechDifferential R t x beta d
      ((TypeDensity.chartBase R t x t)^d * TypeDensity.chartBase R t x r, (TypeDensity.chartBase R x t x)^d * TypeDensity.chartBase R x t r) =
          0 := by
    intro r
    change algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) _ -
      (IsLocalization.Away.invSelf (TypeDensity.chartSlope R t x))^d * beta.right _ = 0
    rw [map_mul, map_mul, map_pow, map_pow, hβr, hβr, TypeDensity.chartBase_x_eq, map_mul]
    have hu : (IsLocalization.Away.invSelf (TypeDensity.chartSlope R t x) *
        algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartSlope R t x))^d = 1 := by
      rw [mul_comm, IsLocalization.Away.mul_invSelf, one_pow]
    linear_combination
        (-(algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartBase R t x t)^d *
      algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartBase R t x r))) * hu
  have main : ∀ n : ℕ, ∀ (a : TypeDensity.BlowupChart R t x) (b : TypeDensity.BlowupChart R x t),
      TypeDensity.fullCechDifferential R t x beta d (a, b) ∈
        (Ideal.span {algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartBase R t x t)})^n →
      ∃ r : R, a - (TypeDensity.chartBase R t x t)^d * TypeDensity.chartBase R t x r ∈ (Ideal.span {TypeDensity.chartBase R t x t})^n ∧
        b - (TypeDensity.chartBase R x t x)^d * TypeDensity.chartBase R x t r ∈ (Ideal.span {TypeDensity.chartBase R x t x})^n := by
    intro n
