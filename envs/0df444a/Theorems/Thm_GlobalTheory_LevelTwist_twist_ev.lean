theorem GlobalTheory.LevelTwist.twist_ev (I : TateIso D k Q act e) (g : Sim D)
    (hν : ∀ n m : ℕ, 0 < n → 0 < m → (n : ℤ) ∣ g.ν (n * m) - g.ν n ∧ IsCoprime (g.ν n) (n : ℤ)) (n : ℕ)
