theorem AlgebraicCurve.Place.ordDiff_D_nonneg {K F : Type*} [Field K] [Field F] [Algebra K F] [CharZero K] (x : F)
    [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F] (v : AlgebraicCurve.Place K F) {f : F} (hf : 0 ≤ v.ord f) :
    0 ≤ v.ordDiff (KaehlerDifferential.D K F f) := by sorry
