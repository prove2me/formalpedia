/-! ### piece ArA4c -/
section Piece_ArA4c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA4c: the Jacobian criterion at the generic point of a prime

For a prime `I` of `P₀ = K[σ]` (`K` perfect), with `Pl = (P₀)_I` and `S = κ(I)` its residue field:
* `cotangent_injective`: `S ⊗ I_I → S ⊗ Ω[Pl/K]` is injective (Mathlib's Jacobian criterion, `S/K` formally smooth).
* `tmul_D`: the chain rule `1 ⊗ D p = Σ_v ∂p/∂v (mod I) • (1 ⊗ D v)`.
* `rows_indep`: elements `h j ∈ I` independent in `S ⊗ I_I` have `S`-independent residue Jacobian rows.
-/

set_option autoImplicit false

open TensorProduct KaehlerDifferential IsLocalRing

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K : Type u} [Field K] {σ : Type*} [Fintype σ]

/-- The localization of `K[σ]` at the prime `I`. -/
abbrev PLoc (I : Ideal (MvPolynomial σ K)) [I.IsPrime] := Localization.AtPrime I

/-- The residue field `κ(I)`. -/
abbrev PRes (I : Ideal (MvPolynomial σ K)) [I.IsPrime] := ResidueField (Localization.AtPrime I)

theorem free_ploc (I : Ideal (MvPolynomial σ K)) [I.IsPrime] : Module.Free (PLoc I) Ω[PLoc I⁄K] :=
  Module.free_of_isLocalizedModule I.primeCompl (KaehlerDifferential.map K K (MvPolynomial σ K) (PLoc I))

theorem essFiniteType_pres (I : Ideal (MvPolynomial σ K)) [I.IsPrime] : Algebra.EssFiniteType K (PRes I) :=
  Algebra.EssFiniteType.of_surjective (IsScalarTower.toAlgHom K (PLoc I) (PRes I)) residue_surjective

theorem ker_mem (I : Ideal (MvPolynomial σ K)) [I.IsPrime] {p : MvPolynomial σ K} (hp : p ∈ I) :
    algebraMap (MvPolynomial σ K) (PLoc I) p ∈ RingHom.ker (algebraMap (PLoc I) (PRes I)) := by
  rw [RingHom.mem_ker, ResidueField.algebraMap_eq, residue_eq_zero_iff]
  exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (PLoc I) I p).mpr hp

theorem res_eq_zero_iff (I : Ideal (MvPolynomial σ K)) [I.IsPrime] (p : MvPolynomial σ K) :
    algebraMap (MvPolynomial σ K) (PRes I) p = 0 ↔ p ∈ I := by
  rw [IsScalarTower.algebraMap_apply (MvPolynomial σ K) (PLoc I) (PRes I), ResidueField.algebraMap_eq,
    residue_eq_zero_iff]
  exact IsLocalization.AtPrime.to_map_mem_maximal_iff (PLoc I) I p

/-- **Jacobian criterion** at the generic point of `V(I)`: the conormal map is injective over `κ(I)`. -/
theorem cotangent_injective [PerfectField K] (I : Ideal (MvPolynomial σ K)) [I.IsPrime] :
    Function.Injective (cotangentComplexBaseChange K (PRes I) (PLoc I) (PRes I)) := by
  have := free_ploc I
  have := essFiniteType_pres I
  have h3 : (RingHom.ker (algebraMap (PLoc I) (PRes I))).FG := IsNoetherian.noetherian _
  have h4 : maximalIdeal (PRes I) ≤ RingHom.ker (algebraMap (PRes I) (PRes I)) := by
    rw [IsLocalRing.maximalIdeal_eq_bot]
    exact bot_le
  exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange (R := K) (S := PRes I) (PLoc I)
    (PRes I) residue_surjective h3 h4).mp inferInstance

theorem D_eq_sum (p : MvPolynomial σ K) :
    D K (MvPolynomial σ K) p = ∑ v, MvPolynomial.pderiv v p • D K (MvPolynomial σ K) (MvPolynomial.X v) := by
  conv_lhs => rw [← (mvPolynomialBasis K σ).sum_repr (D K (MvPolynomial σ K) p)]
  simp only [mvPolynomialBasis_repr_apply, mvPolynomialBasis_apply]

theorem tmul_D (I : Ideal (MvPolynomial σ K)) [I.IsPrime] (p : MvPolynomial σ K) :
    (1 : PRes I) ⊗ₜ[PLoc I] D K (PLoc I) (algebraMap (MvPolynomial σ K) (PLoc I) p) =
      ∑ v, algebraMap (MvPolynomial σ K) (PRes I) (MvPolynomial.pderiv v p) •
        ((1 : PRes I) ⊗ₜ[PLoc I] D K (PLoc I) (algebraMap (MvPolynomial σ K) (PLoc I) (MvPolynomial.X v))) := by
  rw [← map_D K K, D_eq_sum, map_sum, tmul_sum]
  refine Finset.sum_congr rfl fun v _ => ?_
  rw [LinearMap.map_smul, map_D, ← algebraMap_smul (PLoc I) (MvPolynomial.pderiv v p), tmul_smul,
    ← algebraMap_smul (PRes I) (algebraMap (MvPolynomial σ K) (PLoc I) (MvPolynomial.pderiv v p)),
    ← IsScalarTower.algebraMap_apply]

/-- Independent conormal classes have independent residue Jacobian rows. -/
theorem rows_indep [PerfectField K] (I : Ideal (MvPolynomial σ K)) [I.IsPrime] {r : ℕ}
    (h : Fin r → MvPolynomial σ K) (hI : ∀ j, h j ∈ I)
    (hli : LinearIndependent (PRes I) (fun j => (1 : PRes I) ⊗ₜ[PLoc I]
      (⟨algebraMap (MvPolynomial σ K) (PLoc I) (h j), ker_mem I (hI j)⟩ :
        RingHom.ker (algebraMap (PLoc I) (PRes I))))) :
    LinearIndependent (PRes I) (fun j (v : σ) =>
      algebraMap (MvPolynomial σ K) (PRes I) (MvPolynomial.pderiv v (h j))) := by
  let ψ : (σ → PRes I) →ₗ[PRes I] PRes I ⊗[PLoc I] Ω[PLoc I⁄K] := Fintype.linearCombination (PRes I)
    (fun v => (1 : PRes I) ⊗ₜ[PLoc I] D K (PLoc I) (algebraMap (MvPolynomial σ K) (PLoc I) (MvPolynomial.X v)))
  have h1 := hli.map' (cotangentComplexBaseChange K (PRes I) (PLoc I) (PRes I))
    (LinearMap.ker_eq_bot.mpr (cotangent_injective I))
  have h2 : (cotangentComplexBaseChange K (PRes I) (PLoc I) (PRes I)) ∘ (fun j => (1 : PRes I) ⊗ₜ[PLoc I]
      (⟨algebraMap (MvPolynomial σ K) (PLoc I) (h j), ker_mem I (hI j)⟩ :
        RingHom.ker (algebraMap (PLoc I) (PRes I)))) = ψ ∘ (fun j (v : σ) =>
      algebraMap (MvPolynomial σ K) (PRes I) (MvPolynomial.pderiv v (h j))) := by
    funext j
    simp only [Function.comp_apply, cotangentComplexBaseChange_tmul, kerToTensor_apply, one_smul, ψ,
      Fintype.linearCombination_apply]
    exact tmul_D I (h j)
  rw [h2] at h1
  exact h1.of_comp ψ

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA4c

/-! ### piece ArA5c -/
section Piece_ArA5c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5c: the coordinate change `x_{i+1} ↦ x_{i+1} + x₀^{c^{i+1}}`

`tauPoly c n ε` is the substitution `x₀ ↦ x₀`, `x_{i+1} ↦ x_{i+1} + ε·x₀^{c^{i+1}}`; `tauEquiv c n` is the
`K`-algebra automorphism of `K[x₀, …, x_n]` it gives (`ε = 1`, inverse `ε = -1`). It fixes constant terms
(`constantCoeff_tau`, for `c ≥ 1`). On power series it is the substitution `tauSub c n` (`hasSubst_tau`), which
extends it (`subst_tau_coe`), fixes constant terms (`constantCoeff_subst_tau`) and transports evaluations of nested
polynomials (`aeval_map_tau`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

variable {K : Type*} [Field K]

open MvPolynomial in
/-- `x₀ ↦ x₀`, `x_{i+1} ↦ x_{i+1} + ε·x₀^{c^{i+1}}`. -/
def tauPoly (c n : ℕ) (ε : K) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) K :=
  Fin.cases (X 0) fun i => X i.succ + C ε * X 0 ^ (c ^ ((i : ℕ) + 1))

theorem tauPoly_zero (c n : ℕ) (ε : K) : tauPoly c n ε 0 = MvPolynomial.X 0 := rfl

theorem tauPoly_succ (c n : ℕ) (ε : K) (i : Fin n) :
    tauPoly c n ε i.succ = MvPolynomial.X i.succ + MvPolynomial.C ε * MvPolynomial.X 0 ^ (c ^ ((i : ℕ) + 1)) := rfl

theorem aeval_tauPoly (c n : ℕ) (ε ε' : K) (i : Fin (n + 1)) :
    MvPolynomial.aeval (tauPoly c n ε) (tauPoly c n ε' i) = tauPoly c n (ε + ε') i := by
  induction i using Fin.cases with
  | zero => simp only [tauPoly_zero, MvPolynomial.aeval_X]
  | succ j =>
    simp only [tauPoly_succ, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq, tauPoly_zero, map_add (MvPolynomial.C (σ := Fin (n + 1)))]
    ring

theorem aeval_tauPoly_comp (c n : ℕ) (ε ε' : K) (h : ε + ε' = 0) :
    (MvPolynomial.aeval (tauPoly c n ε)).comp (MvPolynomial.aeval (tauPoly c n ε')) = AlgHom.id K _ := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rw [AlgHom.comp_apply, MvPolynomial.aeval_X, aeval_tauPoly, h, AlgHom.id_apply]
  induction i using Fin.cases with
  | zero => rfl
  | succ j => rw [tauPoly_succ, MvPolynomial.C_0, zero_mul, add_zero]

/-- The automorphism `τ_c` of `K[x₀, …, x_n]`. -/
def tauEquiv (c n : ℕ) : MvPolynomial (Fin (n + 1)) K ≃ₐ[K] MvPolynomial (Fin (n + 1)) K :=
  AlgEquiv.ofAlgHom (MvPolynomial.aeval (tauPoly c n 1)) (MvPolynomial.aeval (tauPoly c n (-1)))
    (aeval_tauPoly_comp c n 1 (-1) (add_neg_cancel 1)) (aeval_tauPoly_comp c n (-1) 1 (neg_add_cancel 1))

theorem tauEquiv_apply (c n : ℕ) (p : MvPolynomial (Fin (n + 1)) K) :
    tauEquiv c n p = MvPolynomial.aeval (tauPoly c n 1) p := rfl

theorem constantCoeff_tauPoly {c : ℕ} (hc : 1 ≤ c) (n : ℕ) (ε : K) (i : Fin (n + 1)) :
    MvPolynomial.constantCoeff (tauPoly c n ε i) = 0 := by
  induction i using Fin.cases with
  | zero => exact MvPolynomial.constantCoeff_X (R := K) 0
  | succ j =>
    rw [tauPoly_succ, map_add, map_mul, map_pow, MvPolynomial.constantCoeff_X, MvPolynomial.constantCoeff_X,
      zero_pow (pow_pos hc _).ne', mul_zero, add_zero]

/-- `τ_c` fixes constant terms. -/
theorem constantCoeff_tau {c : ℕ} (hc : 1 ≤ c) (n : ℕ) (p : MvPolynomial (Fin (n + 1)) K) :
    MvPolynomial.constantCoeff (tauEquiv c n p) = MvPolynomial.constantCoeff p := by
  rw [tauEquiv_apply]
  induction p using MvPolynomial.induction_on with
  | C a => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    rw [map_mul, map_mul, map_mul, MvPolynomial.aeval_X, constantCoeff_tauPoly hc, MvPolynomial.constantCoeff_X,
      mul_zero, mul_zero]

/-- The power-series substitution `τ̂_c`. -/
abbrev tauSub (c n : ℕ) : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K :=
  fun i => (tauPoly c n (1 : K) i : MvPowerSeries (Fin (n + 1)) K)

theorem constantCoeff_tauSub {c : ℕ} (hc : 1 ≤ c) (n : ℕ) (i : Fin (n + 1)) :
    MvPowerSeries.constantCoeff (tauSub (K := K) c n i) = 0 := by
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPolynomial.coeff_coe]
  exact constantCoeff_tauPoly hc n 1 i

theorem hasSubst_tau {c : ℕ} (hc : 1 ≤ c) (n : ℕ) : MvPowerSeries.HasSubst (tauSub (K := K) c n) :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero (constantCoeff_tauSub (K := K) hc n)

theorem algebraMap_mvPolynomial_eq {σ : Type*} (q : MvPolynomial σ K) :
    algebraMap (MvPolynomial σ K) (MvPowerSeries σ K) q = (q : MvPowerSeries σ K) := by
  rw [MvPowerSeries.algebraMap_apply', Algebra.algebraMap_self, MvPowerSeries.map_id, RingHom.id_apply]

/-- `τ̂_c` extends `τ_c`. -/
theorem subst_tau_coe {c : ℕ} (hc : 1 ≤ c) (n : ℕ) (p : MvPolynomial (Fin (n + 1)) K) :
    MvPowerSeries.subst (tauSub (K := K) c n) (p : MvPowerSeries (Fin (n + 1)) K) =
      ((tauEquiv c n p : MvPolynomial (Fin (n + 1)) K) : MvPowerSeries (Fin (n + 1)) K) := by
  rw [← MvPowerSeries.coe_substAlgHom (hasSubst_tau (K := K) hc n), MvPowerSeries.substAlgHom_coe, tauEquiv_apply]
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.aeval_C, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.coe_C,
      MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  | add p q hp hq => simp only [map_add, hp, hq, MvPolynomial.coe_add]
  | mul_X p i hp => simp only [map_mul, hp, MvPolynomial.coe_mul, MvPolynomial.aeval_X]

/-- `τ̂_c` fixes constant terms. -/
theorem constantCoeff_subst_tau {c : ℕ} (hc : 1 ≤ c) (n : ℕ) (g : MvPowerSeries (Fin (n + 1)) K) :
    MvPowerSeries.constantCoeff (MvPowerSeries.subst (tauSub (K := K) c n) g) = MvPowerSeries.constantCoeff g := by
  have hC : ∀ a : K, MvPowerSeries.substAlgHom (hasSubst_tau (K := K) hc n) (MvPowerSeries.C a) =
      MvPowerSeries.C a := fun a => by
    have := (MvPowerSeries.substAlgHom (hasSubst_tau (K := K) hc n)).commutes a
    rwa [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at this
  have h0 : MvPowerSeries.constantCoeff (g - MvPowerSeries.C (MvPowerSeries.constantCoeff g)) = 0 := by
    rw [map_sub, MvPowerSeries.constantCoeff_C, sub_self]
  have h1 := MvPowerSeries.constantCoeff_subst_eq_zero (hasSubst_tau (K := K) hc n) (constantCoeff_tauSub (K := K) hc n) h0
  rw [← MvPowerSeries.coe_substAlgHom (hasSubst_tau (K := K) hc n), map_sub, hC, map_sub, MvPowerSeries.constantCoeff_C,
    sub_eq_zero] at h1
  rw [← MvPowerSeries.coe_substAlgHom (hasSubst_tau (K := K) hc n)]
  exact h1

/-- `τ̂_c` transports evaluations of nested polynomials: `(τ f)(τ̂ ŷ) = τ̂ (f ŷ)`. -/
theorem aeval_map_tau {c : ℕ} (hc : 1 ≤ c) {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin (n + 1)) K)
    (p : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) :
    MvPolynomial.aeval (fun k => MvPowerSeries.subst (tauSub (K := K) c n) (ŷ k))
        (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom p) =
      MvPowerSeries.subst (tauSub (K := K) c n) (MvPolynomial.aeval ŷ p) := by
  let φ := (MvPowerSeries.substAlgHom (R := K) (hasSubst_tau (K := K) hc n)).toRingHom
  have hφ : ∀ g, MvPowerSeries.subst (tauSub (K := K) c n) g = φ g := fun g => by
    rw [← MvPowerSeries.coe_substAlgHom (hasSubst_tau (K := K) hc n)]
    rfl
  simp only [hφ]
  rw [MvPolynomial.aeval_def, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, MvPolynomial.eval₂_comp_left]
  congr 1
  refine RingHom.ext fun q => ?_
  rw [RingHom.comp_apply, RingHom.comp_apply, algebraMap_mvPolynomial_eq, algebraMap_mvPolynomial_eq, ← hφ,
    subst_tau_coe hc n q]
  rfl

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5c

/-! ### piece ArA5d1 -/
section Piece_ArA5d1


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5d1: the colex-minimal exponent and base-`c` weights

For a nonempty set `S` of exponents `Fin n → ℕ`, its colex-minimal element `α` (compare the last index first) is the
unique minimiser on `S` of the weight `w_c(d) = Σ c^i d_i` once `c` exceeds every `α i` (`colex_min_weight`).
This is the combinatorial core of making a nonzero power series `x_0`-regular by `x_i ↦ x_i + x_0^{c^i}`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

theorem weight_lt_pow {c : ℕ} {n : ℕ} (α : Fin n → ℕ) (hα : ∀ i, α i < c) :
    ∑ i : Fin n, c ^ (i : ℕ) * α i < c ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Fin.sum_univ_castSucc]
    have h1 := ih (fun i => α (Fin.castSucc i)) (fun i => hα _)
    simp only [Fin.coe_castSucc, Fin.val_last] at h1 ⊢
    have h2 : c ^ n * (α (Fin.last n) + 1) ≤ c ^ n * c := Nat.mul_le_mul_left _ (hα _)
    calc ∑ i : Fin n, c ^ (i : ℕ) * α (Fin.castSucc i) + c ^ n * α (Fin.last n)
        < c ^ n + c ^ n * α (Fin.last n) := Nat.add_lt_add_right h1 _
      _ = c ^ n * (α (Fin.last n) + 1) := by ring
      _ ≤ c ^ n * c := h2
      _ = c ^ (n + 1) := by ring

theorem weight_lt_of_colex {c : ℕ} {n : ℕ} (α d : Fin n → ℕ) (hα : ∀ i, α i < c) (k : Fin n)
    (hk : ∀ j, k < j → α j = d j) (hkd : α k < d k) :
    ∑ i : Fin n, c ^ (i : ℕ) * α i < ∑ i : Fin n, c ^ (i : ℕ) * d i := by
  induction n with
  | zero => exact k.elim0
  | succ n ih =>
    rw [Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
    simp only [Fin.coe_castSucc, Fin.val_last]
    induction k using Fin.lastCases with
    | last =>
      have h1 := weight_lt_pow (fun i => α (Fin.castSucc i)) (fun i => hα _)
      have h2 : c ^ n * (α (Fin.last n) + 1) ≤ c ^ n * d (Fin.last n) := Nat.mul_le_mul_left _ hkd
      calc ∑ i : Fin n, c ^ (i : ℕ) * α (Fin.castSucc i) + c ^ n * α (Fin.last n)
          < c ^ n + c ^ n * α (Fin.last n) := Nat.add_lt_add_right h1 _
        _ = c ^ n * (α (Fin.last n) + 1) := by ring
        _ ≤ c ^ n * d (Fin.last n) := h2
        _ ≤ ∑ i : Fin n, c ^ (i : ℕ) * d (Fin.castSucc i) + c ^ n * d (Fin.last n) := Nat.le_add_left _ _
    | cast k' =>
      have hl : α (Fin.last n) = d (Fin.last n) := hk _ (Fin.castSucc_lt_last k')
      have h1 := ih (fun i => α (Fin.castSucc i)) (fun i => d (Fin.castSucc i)) (fun i => hα _) k'
        (fun j hj => hk _ (Fin.castSucc_lt_castSucc_iff.mpr hj)) hkd
      rw [hl]
      exact Nat.add_lt_add_right h1 _

/-- **The colex-minimal exponent** is the unique minimiser of a base-`c` weight on `S`. -/
theorem colex_min_weight {n : ℕ} (S : Set (Fin n → ℕ)) (hS : S.Nonempty) :
    ∃ α ∈ S, ∃ c : ℕ, 2 ≤ c ∧ ∀ d ∈ S, d ≠ α → ∑ i : Fin n, c ^ (i : ℕ) * α i < ∑ i : Fin n, c ^ (i : ℕ) * d i := by
  obtain ⟨a, ⟨α, hαS, rfl⟩, hmin⟩ := WellFounded.has_min wellFounded_lt (toColex '' S) (hS.image _)
  refine ⟨α, hαS, ∑ i, α i + 2, by omega, fun d hd hne => ?_⟩
  have hlt : toColex α < toColex d := by
    rcases lt_trichotomy (toColex α) (toColex d) with h | h | h
    · exact h
    · exact absurd (toColex.injective h).symm hne
    · exact absurd h (hmin _ ⟨d, hd, rfl⟩)
  obtain ⟨k, hk1, hk2⟩ := hlt
  refine weight_lt_of_colex α d (fun i => ?_) k (fun j hj => hk1 j hj) hk2
  have := Finset.single_le_sum (f := α) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
  omega

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5d1

/-! ### piece ArA5e1 -/
section Piece_ArA5e1


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5e1: the maximal ideal of `K[[x₁, …, x_n]]`

* `mem_span_X`: a power series with constant coefficient `0` lies in `(x₁, …, x_n)`.
* `maximalIdeal_eq_span_X`: `𝔪 = (x₁, …, x_n)`, hence (Mathlib's `IsAdicComplete (span (range X))`)
  `K[[x]]` is `𝔪`-adically complete (instance `isAdicComplete_maximalIdeal`), as Weierstrass preparation needs.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

variable {K : Type*} [Field K]

theorem coeff_X_mul_ite {n : ℕ} (i : Fin n) (g : MvPowerSeries (Fin n) K) (d : Fin n →₀ ℕ) :
    MvPowerSeries.coeff d (MvPowerSeries.X i * g) =
      if 1 ≤ d i then MvPowerSeries.coeff (d - Finsupp.single i 1) g else 0 := by
  classical
  rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, one_mul]
  by_cases h1 : 1 ≤ d i
  · rw [if_pos (Finsupp.single_le_iff.mpr h1), if_pos h1]
  · rw [if_neg (fun hle => h1 (Finsupp.single_le_iff.mp hle)), if_neg h1]

theorem mem_span_X {n : ℕ} (f : MvPowerSeries (Fin n) K) (hf : MvPowerSeries.constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)) := by
  classical
  let g : Fin n → MvPowerSeries (Fin n) K := fun i e =>
    if ∀ j < i, e j = 0 then MvPowerSeries.coeff (e + Finsupp.single i 1) f else 0
  have hterm : ∀ d i, MvPowerSeries.coeff d (MvPowerSeries.X i * g i) =
      if (1 ≤ d i ∧ ∀ j < i, d j = 0) then MvPowerSeries.coeff d f else 0 := by
    intro d i
    rw [coeff_X_mul_ite]
    by_cases h1 : 1 ≤ d i
    · have hle : Finsupp.single i 1 ≤ d := Finsupp.single_le_iff.mpr h1
      have hsub : d - Finsupp.single i 1 + Finsupp.single i 1 = d := tsub_add_cancel_of_le hle
      have hj : ∀ j < i, (d - Finsupp.single i 1 : Fin n →₀ ℕ) j = d j := fun j hj => by
        rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne (ne_of_lt hj), Nat.sub_zero]
      rw [if_pos h1]
      change (if ∀ j < i, (d - Finsupp.single i 1 : Fin n →₀ ℕ) j = 0 then
        MvPowerSeries.coeff (d - Finsupp.single i 1 + Finsupp.single i 1) f else 0) = _
      rw [hsub]
      by_cases h2 : ∀ j < i, d j = 0
      · rw [if_pos (fun j hj' => (hj j hj').trans (h2 j hj')), if_pos ⟨h1, h2⟩]
      · rw [if_neg (fun h => h2 fun j hj' => (hj j hj').symm.trans (h j hj')), if_neg (fun h => h2 h.2)]
    · rw [if_neg h1, if_neg (fun h => h1 h.1)]
  have key : f = ∑ i, MvPowerSeries.X i * g i := by
    ext d
    rw [map_sum]
    simp_rw [hterm]
    by_cases hd : d = 0
    · subst hd
      simp [hf]
    · have hne : d.support.Nonempty := Finsupp.support_nonempty_iff.mpr hd
      set i₀ := d.support.min' hne
      have hi₀ : d i₀ ≠ 0 := Finsupp.mem_support_iff.mp (d.support.min'_mem hne)
      have hlow : ∀ j < i₀, d j = 0 := fun j hj => by
        by_contra h
        exact absurd (d.support.min'_le j (Finsupp.mem_support_iff.mpr h)) (not_le.mpr hj)
      rw [Finset.sum_eq_single i₀]
      · rw [if_pos ⟨Nat.one_le_iff_ne_zero.mpr hi₀, hlow⟩]
      · intro i _ hi
        rw [if_neg]
        rintro ⟨h1, h2⟩
        have hle : i₀ ≤ i := d.support.min'_le i (Finsupp.mem_support_iff.mpr (by omega))
        rcases lt_or_eq_of_le hle with h | h
        · exact hi₀ (h2 i₀ h)
        · exact hi h.symm
      · intro h
        exact absurd (Finset.mem_univ i₀) h
  rw [key]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)

theorem maximalIdeal_eq_span_X {n : ℕ} :
    IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) = Ideal.span (Set.range MvPowerSeries.X) := by
  apply le_antisymm
  · intro f hf
    apply mem_span_X f
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      isUnit_iff_ne_zero, not_not] at hf
    exact hf
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      MvPowerSeries.constantCoeff_X]
    exact not_isUnit_zero

instance isAdicComplete_maximalIdeal {n : ℕ} :
    IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K)) (MvPowerSeries (Fin n) K) := by
  rw [maximalIdeal_eq_span_X]
  infer_instance

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5e1

/-! ### piece ArA6a -/
section Piece_ArA6a


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA6a: the coefficient system of a division by a generic monic `P`

Unknowns `Unk d N D = Fin d ⊕ Fin N × Fin D`: the lower coefficients of a monic `P` of degree `d` and the
coefficients of remainders `R_i` of degree `< D`. For a ring hom `θ : E →+* B[X]` and nested polynomials
`hs j, g ∈ E[y₁, …, y_N]`, `eqsys θ hs g d` lists the coefficients of `hs j (R) mod P⁴` and `g (R) mod P` (with
`D = 4d`). Specialising the unknowns at `z` (`aeval_eqsys_inl/inr`) the system vanishes iff `P_z⁴ ∣ hs j (R_z)` and
`P_z ∣ g (R_z)` (`eqsys_vanish_of_dvd`, `dvd_of_eqsys_vanish`); `map_point` compares residues of two specialisations.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

/-- A monic polynomial of degree `d` with the given lower coefficients. -/
def mkP {S : Type*} [CommRing S] (d : ℕ) (a : Fin d → S) : S[X] := X ^ d + ∑ l : Fin d, C (a l) * X ^ (l : ℕ)

/-- A polynomial of degree `< D` with the given coefficients. -/
def mkR {S : Type*} [CommRing S] (D : ℕ) (b : Fin D → S) : S[X] := ∑ l : Fin D, C (b l) * X ^ (l : ℕ)

theorem mkP_monic {S : Type*} [CommRing S] (d : ℕ) (a : Fin d → S) : (mkP d a).Monic :=
  monic_X_pow_add (degree_sum_fin_lt a)

theorem natDegree_mkP_le {S : Type*} [CommRing S] (d : ℕ) (a : Fin d → S) : (mkP d a).natDegree ≤ d :=
  natDegree_le_of_degree_le ((degree_add_le _ _).trans (max_le (degree_X_pow_le d) (degree_sum_fin_lt a).le))

theorem map_mkP {S S' : Type*} [CommRing S] [CommRing S'] (φ : S →+* S') (d : ℕ) (a : Fin d → S) :
    (mkP d a).map φ = mkP d (fun l => φ (a l)) := by
  simp only [mkP, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum, Polynomial.map_mul,
    Polynomial.map_C]

theorem map_mkR {S S' : Type*} [CommRing S] [CommRing S'] (φ : S →+* S') (D : ℕ) (b : Fin D → S) :
    (mkR D b).map φ = mkR D (fun l => φ (b l)) := by
  simp only [mkR, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]

/-- A remainder whose low coefficients vanish is zero. -/
theorem modByMonic_eq_zero_of_coeff {S : Type*} [CommRing S] {F Q : S[X]} (hQ : Q.Monic) {D : ℕ}
    (hD : Q.natDegree ≤ D) (h : ∀ k < D, (F %ₘ Q).coeff k = 0) : F %ₘ Q = 0 := by
  rcases subsingleton_or_nontrivial S with hS | hS
  · ext k
    exact Subsingleton.elim (α := S) _ _
  ext k
  rw [coeff_zero]
  by_cases hk : k < D
  · exact h k hk
  · apply coeff_eq_zero_of_degree_lt
    calc degree (F %ₘ Q) < degree Q := degree_modByMonic_lt F hQ
      _ ≤ (Q.natDegree : WithBot ℕ) := degree_le_natDegree
      _ ≤ (k : WithBot ℕ) := by exact_mod_cast hD.trans (not_lt.mp hk)

section CoeffSystem

variable {B E : Type*} [CommRing B] [CommRing E] (θ : E →+* B[X])

/-- The unknowns. -/
abbrev Unk (d N D : ℕ) := Fin d ⊕ Fin N × Fin D

variable (B) in
/-- The generic monic `P`. -/
def genP (d N D : ℕ) : (MvPolynomial (Unk d N D) B)[X] := mkP d fun l => MvPolynomial.X (Sum.inl l)

variable (B) in
/-- The generic remainders. -/
def genR (d N D : ℕ) (i : Fin N) : (MvPolynomial (Unk d N D) B)[X] := mkR D fun l => MvPolynomial.X (Sum.inr (i, l))

/-- The coefficient map `E → S[X]`. -/
def thetaS (S : Type*) [CommRing S] [Algebra B S] : E →+* S[X] := (mapRingHom (algebraMap B S)).comp θ

/-- Evaluation of a nested polynomial at polynomials. -/
def evS (S : Type*) [CommRing S] [Algebra B S] {N : ℕ} (p : MvPolynomial (Fin N) E) (R : Fin N → S[X]) : S[X] :=
  MvPolynomial.eval₂ (thetaS θ S) R p

theorem map_evS {S S' : Type*} [CommRing S] [CommRing S'] [Algebra B S] [Algebra B S'] (φ : S →ₐ[B] S') {N : ℕ}
    (p : MvPolynomial (Fin N) E) (R : Fin N → S[X]) :
    (evS θ S p R).map φ.toRingHom = evS θ S' p (fun i => (R i).map φ.toRingHom) := by
  unfold evS
  rw [← Polynomial.coe_mapRingHom, MvPolynomial.eval₂_comp_left]
  congr 1
  refine RingHom.ext fun q => ?_
  simp only [thetaS, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_map, AlgHom.toRingHom_eq_coe,
    AlgHom.comp_algebraMap]

/-- The specialised `P`. -/
abbrev Pz {S : Type*} [CommRing S] {d N D : ℕ} (z : Unk d N D → S) : S[X] := mkP d fun l => z (Sum.inl l)

/-- The specialised remainders. -/
abbrev Rz {S : Type*} [CommRing S] {d N D : ℕ} (z : Unk d N D → S) (i : Fin N) : S[X] :=
  mkR D fun l => z (Sum.inr (i, l))

theorem map_genP {S : Type*} [CommRing S] [Algebra B S] {d N D : ℕ} (z : Unk d N D → S) :
    (genP B d N D).map (MvPolynomial.aeval (R := B) z).toRingHom = Pz z := by
  rw [genP, map_mkP]
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]

theorem map_genR {S : Type*} [CommRing S] [Algebra B S] {d N D : ℕ} (z : Unk d N D → S) (i : Fin N) :
    (genR B d N D i).map (MvPolynomial.aeval (R := B) z).toRingHom = Rz z i := by
  rw [genR, map_mkR]
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]

theorem algHom_coeff {Z S : Type*} [CommRing Z] [CommRing S] [Algebra B Z] [Algebra B S] (f : Z →ₐ[B] S)
    (F : Z[X]) (k : ℕ) : f (F.coeff k) = (F.map f.toRingHom).coeff k :=
  (Polynomial.coeff_map _ _).symm

/-- The coefficient system. -/
def eqsys {r N : ℕ} (hs : Fin r → MvPolynomial (Fin N) E) (g : MvPolynomial (Fin N) E) (d : ℕ) :
    Fin r × Fin (4 * d) ⊕ Fin d → MvPolynomial (Unk d N (4 * d)) B :=
  Sum.elim (fun jk => ((evS θ _ (hs jk.1) (genR B d N (4 * d))) %ₘ (genP B d N (4 * d)) ^ 4).coeff jk.2)
    (fun k => ((evS θ _ g (genR B d N (4 * d))) %ₘ genP B d N (4 * d)).coeff k)

theorem aeval_eqsys_inl {S : Type*} [CommRing S] [Algebra B S] {r N : ℕ} (hs : Fin r → MvPolynomial (Fin N) E)
    (g : MvPolynomial (Fin N) E) {d : ℕ} (z : Unk d N (4 * d) → S) (j : Fin r) (k : Fin (4 * d)) :
    MvPolynomial.aeval z (eqsys θ hs g d (Sum.inl (j, k))) = ((evS θ S (hs j) (Rz z)) %ₘ (Pz z) ^ 4).coeff k := by
  rw [eqsys, Sum.elim_inl]
  have hm : ((genP B d N (4 * d)) ^ 4).Monic := (mkP_monic d _).pow 4
  rw [algHom_coeff, map_modByMonic _ hm, Polynomial.map_pow, map_genP, map_evS]
  simp only [map_genR]

theorem aeval_eqsys_inr {S : Type*} [CommRing S] [Algebra B S] {r N : ℕ} (hs : Fin r → MvPolynomial (Fin N) E)
    (g : MvPolynomial (Fin N) E) {d : ℕ} (z : Unk d N (4 * d) → S) (k : Fin d) :
    MvPolynomial.aeval z (eqsys θ hs g d (Sum.inr k)) = ((evS θ S g (Rz z)) %ₘ (Pz z)).coeff k := by
  rw [eqsys, Sum.elim_inr]
  have hm : (genP B d N (4 * d)).Monic := mkP_monic d _
  rw [algHom_coeff, map_modByMonic _ hm, map_genP, map_evS]
  simp only [map_genR]

theorem eqsys_vanish_of_dvd {S : Type*} [CommRing S] [Algebra B S] {r N : ℕ} (hs : Fin r → MvPolynomial (Fin N) E)
    (g : MvPolynomial (Fin N) E) {d : ℕ} (z : Unk d N (4 * d) → S)
    (hh : ∀ j, (Pz z) ^ 4 ∣ evS θ S (hs j) (Rz z)) (hg : Pz z ∣ evS θ S g (Rz z)) :
    ∀ e, MvPolynomial.aeval z (eqsys θ hs g d e) = 0 := by
  rintro (⟨j, k⟩ | k)
  · rw [aeval_eqsys_inl, (modByMonic_eq_zero_iff_dvd ((mkP_monic d _).pow 4)).mpr (hh j), coeff_zero]
  · rw [aeval_eqsys_inr, (modByMonic_eq_zero_iff_dvd (mkP_monic d _)).mpr hg, coeff_zero]

theorem dvd_of_eqsys_vanish {S : Type*} [CommRing S] [Algebra B S] {r N : ℕ} (hs : Fin r → MvPolynomial (Fin N) E)
    (g : MvPolynomial (Fin N) E) {d : ℕ} (z : Unk d N (4 * d) → S)
    (h : ∀ e, MvPolynomial.aeval z (eqsys θ hs g d e) = 0) :
    (∀ j, (Pz z) ^ 4 ∣ evS θ S (hs j) (Rz z)) ∧ Pz z ∣ evS θ S g (Rz z) := by
  refine ⟨fun j => (modByMonic_eq_zero_iff_dvd ((mkP_monic d _).pow 4)).mp ?_,
    (modByMonic_eq_zero_iff_dvd (mkP_monic d _)).mp ?_⟩
  · refine modByMonic_eq_zero_of_coeff ((mkP_monic d _).pow 4)
      (natDegree_pow_le.trans (Nat.mul_le_mul_left 4 (natDegree_mkP_le d _))) fun k hk => ?_
    rw [← aeval_eqsys_inl θ hs g z j ⟨k, hk⟩]
    exact h _
  · refine modByMonic_eq_zero_of_coeff (mkP_monic d _) (natDegree_mkP_le d _) fun k hk => ?_
    rw [← aeval_eqsys_inr θ hs g z ⟨k, hk⟩]
    exact h _

/-- Two specialisations with the same residues have the same residue polynomials. -/
theorem map_point {K' S₁ S₂ : Type*} [CommRing K'] [CommRing S₁] [CommRing S₂] [Algebra B S₁] [Algebra B S₂]
    {ι : Type*} (z₁ : ι → S₁) (z₂ : ι → S₂) (φ₁ : S₁ →+* K') (φ₂ : S₂ →+* K')
    (hB : ∀ b, φ₁ (algebraMap B S₁ b) = φ₂ (algebraMap B S₂ b)) (hz : ∀ u, φ₁ (z₁ u) = φ₂ (z₂ u))
    (W : (MvPolynomial ι B)[X]) :
    (W.map (MvPolynomial.aeval (R := B) z₁).toRingHom).map φ₁ =
      (W.map (MvPolynomial.aeval (R := B) z₂).toRingHom).map φ₂ := by
  rw [Polynomial.map_map, Polynomial.map_map]
  congr 1
  refine MvPolynomial.ringHom_ext (fun b => ?_) (fun u => ?_)
  · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C, hB]
  · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X, hz]

end CoeffSystem

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA6a

/-! ### piece CovA -/
section Piece_CovA


/-!
# S4-EtPBC-A, R4-T2 (A): the algebraic lifting statement `CoverLiftAt`

The two charts of a finite `Y ⟶ P¹_A` are `B₀` (over `A[t]`) and `B₁` (over `A[s]`), both written over `A[X]`,
with overlap `N = B₀[1/t] = B₁[1/s]` (as in `Z2.exists_etale_idem_of_loc`). For a `K`-point `χ : A → K`, the fibre
charts are `F₀`, `F₁`, `F₀₁` (quotients of `B₀`, `B₁`, `N` by `ker χ`), and a finite etale surjective cover of the fibre
is given by finite etale `Fᵢ`-algebras `Eᵢ` with localization maps `ψᵢ : Eᵢ → E₀₁` at `t`, `s`.

**`CoverLiftAt K A χ`**: every such fibre cover is, after an etale neighbourhood `(R', χ')` of `χ`, the fibre
(`θᵢ : E'ᵢ ↠ Eᵢ` with kernel generated by `ker χ'`) of a finite etale cover `E'ᵢ` of the charts of `Y ×_A R'`, glued by
localizations `ψ'ᵢ`; the lift data are bundled as the structure **`CoverLift`**.
-/

set_option autoImplicit false

open Polynomial TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

/-- `ψ : E → E'` is a localization away from `t` (in the explicit form used by `Z2.exists_etale_idem_of_loc`). -/
def IsAwayMap {E E' : Type u} [CommRing E] [CommRing E'] (ψ : E →+* E') (t : E) : Prop :=
  (∀ y : E', ∃ (k : ℕ) (a : E), ψ t ^ k * y = ψ a) ∧ (∀ a : E, ψ a = 0 → ∃ k : ℕ, t ^ k * a = 0)

variable (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]

/-- **The lift data** in the conclusion of `CoverLiftAt` (a structure, so that it is never destructured field by
field): an etale neighbourhood `(R', χ')` of `χ`, finite etale chart algebras `Eᵢ` over `R' ⊗ Bᵢ` glued by localizations
`ψᵢ`, and surjections `θᵢ : Eᵢ ↠ Gᵢ` onto the given fibre cover, with kernel generated by `ker χ'`. -/
structure CoverLift (χ : A →ₐ[K] K) (B₀ B₁ N : Type u) [CommRing B₀] [Algebra A[X] B₀] [Algebra A B₀]
    [CommRing B₁] [Algebra A[X] B₁] [Algebra A B₁] [CommRing N] [Algebra A[X] N] [Algebra A N]
    (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N) (F₀ F₁ F₀₁ : Type u) [CommRing F₀] [CommRing F₁] [CommRing F₀₁]
    [Algebra K F₀] [Algebra K F₁] [Algebra K F₀₁] (β₀ : B₀ →+* F₀) (β₁ : B₁ →+* F₁) (β₀₁ : N →+* F₀₁)
    (G₀ G₁ G₀₁ : Type u) [CommRing G₀] [CommRing G₁] [CommRing G₀₁] [Algebra F₀ G₀] [Algebra F₁ G₁]
    [Algebra F₀₁ G₀₁] (p₀ : G₀ →+* G₀₁) (p₁ : G₁ →+* G₀₁) where
  R' : Type u
  [cR : CommRing R']
  [aR : Algebra A R']
  [eR : Algebra.Etale A R']
  χ' : R' →+* K
  hχ : ∀ a : A, χ' (algebraMap A R' a) = χ a
  E₀ : Type u
  E₁ : Type u
  E₀₁ : Type u
  [c₀ : CommRing E₀]
  [c₁ : CommRing E₁]
  [c₀₁ : CommRing E₀₁]
  [a₀ : Algebra (R' ⊗[A] B₀) E₀]
  [a₁ : Algebra (R' ⊗[A] B₁) E₁]
  [a₀₁ : Algebra (R' ⊗[A] N) E₀₁]
  [f₀ : Module.Finite (R' ⊗[A] B₀) E₀]
  [f₁ : Module.Finite (R' ⊗[A] B₁) E₁]
  [et₀ : Algebra.Etale (R' ⊗[A] B₀) E₀]
  [et₁ : Algebra.Etale (R' ⊗[A] B₁) E₁]
  ψ₀ : E₀ →+* E₀₁
  ψ₁ : E₁ →+* E₀₁
  hψ₀ : ∀ (r : R') (b : B₀), ψ₀ (algebraMap (R' ⊗[A] B₀) E₀ (r ⊗ₜ b)) = algebraMap (R' ⊗[A] N) E₀₁ (r ⊗ₜ φ₀ b)
  hψ₁ : ∀ (r : R') (b : B₁), ψ₁ (algebraMap (R' ⊗[A] B₁) E₁ (r ⊗ₜ b)) = algebraMap (R' ⊗[A] N) E₀₁ (r ⊗ₜ φ₁ b)
  aw₀ : IsAwayMap ψ₀ (algebraMap (R' ⊗[A] B₀) E₀ (1 ⊗ₜ algebraMap A[X] B₀ X))
  aw₁ : IsAwayMap ψ₁ (algebraMap (R' ⊗[A] B₁) E₁ (1 ⊗ₜ algebraMap A[X] B₁ X))
  θ₀ : E₀ →+* G₀
  θ₁ : E₁ →+* G₁
  θ₀₁ : E₀₁ →+* G₀₁
  hθ₀ : ∀ (r : R') (b : B₀), θ₀ (algebraMap (R' ⊗[A] B₀) E₀ (r ⊗ₜ b)) = algebraMap F₀ G₀ (algebraMap K F₀ (χ' r) * β₀ b)
  hθ₁ : ∀ (r : R') (b : B₁), θ₁ (algebraMap (R' ⊗[A] B₁) E₁ (r ⊗ₜ b)) = algebraMap F₁ G₁ (algebraMap K F₁ (χ' r) * β₁ b)
  hθ₀₁ : ∀ (r : R') (n : N), θ₀₁ (algebraMap (R' ⊗[A] N) E₀₁ (r ⊗ₜ n)) =
    algebraMap F₀₁ G₀₁ (algebraMap K F₀₁ (χ' r) * β₀₁ n)
  sθ₀ : Function.Surjective θ₀
  sθ₁ : Function.Surjective θ₁
  kθ₀ : RingHom.ker θ₀ = (RingHom.ker χ').map ((algebraMap (R' ⊗[A] B₀) E₀).comp Algebra.TensorProduct.includeLeftRingHom)
  kθ₁ : RingHom.ker θ₁ = (RingHom.ker χ').map ((algebraMap (R' ⊗[A] B₁) E₁).comp Algebra.TensorProduct.includeLeftRingHom)
  cθ₀ : p₀.comp θ₀ = θ₀₁.comp ψ₀
  cθ₁ : p₁.comp θ₁ = θ₀₁.comp ψ₁

/-- **The algebraic form of T2** at the `K`-point `χ` of `A`. -/
def CoverLiftAt (χ : A →ₐ[K] K) : Prop :=
  ∀ (B₀ B₁ N : Type u) [CommRing B₀] [Algebra A[X] B₀] [Algebra A B₀] [IsScalarTower A A[X] B₀]
    [CommRing B₁] [Algebra A[X] B₁] [Algebra A B₁] [IsScalarTower A A[X] B₁]
    [CommRing N] [Algebra A[X] N] [Algebra A N] [IsScalarTower A A[X] N]
    [Module.Finite A[X] B₀] [Module.Finite A[X] B₁] (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N),
    algebraMap A[X] N X * φ₁ (algebraMap A[X] B₁ X) = 1 →
    (∀ y : N, ∃ (k : ℕ) (a : B₀), algebraMap A[X] N X ^ k * y = φ₀ a) →
    (∀ y : N, ∃ (k : ℕ) (b : B₁), φ₁ (algebraMap A[X] B₁ X) ^ k * y = φ₁ b) →
    (∀ a, φ₀ a = 0 → ∃ k : ℕ, algebraMap A[X] B₀ X ^ k * a = 0) →
    (∀ b, φ₁ b = 0 → ∃ k : ℕ, algebraMap A[X] B₁ X ^ k * b = 0) →
    -- the fibre charts
    ∀ (F₀ F₁ F₀₁ : Type u) [CommRing F₀] [CommRing F₁] [CommRing F₀₁] [Algebra K F₀] [Algebra K F₁] [Algebra K F₀₁]
      (β₀ : B₀ →+* F₀) (β₁ : B₁ →+* F₁) (β₀₁ : N →+* F₀₁),
      (∀ a : A, β₀ (algebraMap A B₀ a) = algebraMap K F₀ (χ a)) →
      (∀ a : A, β₁ (algebraMap A B₁ a) = algebraMap K F₁ (χ a)) →
      (∀ a : A, β₀₁ (algebraMap A N a) = algebraMap K F₀₁ (χ a)) →
      Function.Surjective β₀ → Function.Surjective β₁ → Function.Surjective β₀₁ →
      ∀ (φb₀ : F₀ →+* F₀₁) (φb₁ : F₁ →+* F₀₁), φb₀.comp β₀ = β₀₁.comp φ₀.toRingHom →
        φb₁.comp β₁ = β₀₁.comp φ₁.toRingHom →
      -- the fibre cover
      ∀ (E₀ E₁ E₀₁ : Type u) [CommRing E₀] [CommRing E₁] [CommRing E₀₁] [Algebra F₀ E₀] [Algebra F₁ E₁]
        [Algebra F₀₁ E₀₁], Algebra.Etale F₀ E₀ → Algebra.Etale F₁ E₁ → Module.Finite F₀ E₀ → Module.Finite F₁ E₁ →
        ∀ (ψ₀ : E₀ →+* E₀₁) (ψ₁ : E₁ →+* E₀₁),
          ψ₀.comp (algebraMap F₀ E₀) = (algebraMap F₀₁ E₀₁).comp φb₀ →
          ψ₁.comp (algebraMap F₁ E₁) = (algebraMap F₀₁ E₀₁).comp φb₁ →
          IsAwayMap ψ₀ (algebraMap F₀ E₀ (β₀ (algebraMap A[X] B₀ X))) →
          IsAwayMap ψ₁ (algebraMap F₁ E₁ (β₁ (algebraMap A[X] B₁ X))) →
      -- the lift
      Nonempty (CoverLift K A χ B₀ B₁ N φ₀ φ₁ F₀ F₁ F₀₁ β₀ β₁ β₀₁ E₀ E₁ E₀₁ ψ₀ ψ₁)

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovA

/-! ### piece ArA4d -/
section Piece_ArA4d


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA4d: the Jacobian datum of a prime of `K[σ]`

`jacobian_datum`: for a prime `I` of `K[σ]` (`K` perfect) there are `h₁, …, h_r ∈ I` whose residue Jacobian rows
are independent over `κ(I)` and `G ∉ I` with `G · I ⊆ (h)` (Nakayama in `(K[σ])_I` plus `cotangent_injective`).
-/

set_option autoImplicit false

open TensorProduct KaehlerDifferential IsLocalRing

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K : Type u} [Field K] {σ : Type*} [Fintype σ]

theorem ker_eq_map (I : Ideal (MvPolynomial σ K)) [I.IsPrime] :
    RingHom.ker (algebraMap (PLoc I) (PRes I)) = I.map (algebraMap (MvPolynomial σ K) (PLoc I)) := by
  rw [ResidueField.algebraMap_eq, ker_residue, IsLocalization.AtPrime.map_eq_maximalIdeal I (PLoc I)]

/-- The classes of generators of `I` span `κ(I) ⊗ I_I`. -/
theorem span_tmul_gens (I : Ideal (MvPolynomial σ K)) [I.IsPrime] {t : ℕ} (g : Fin t → MvPolynomial σ K)
    (hg : Ideal.span (Set.range g) = I) (hgI : ∀ l, g l ∈ I) :
    Submodule.span (PRes I) (Set.range fun l => (1 : PRes I) ⊗ₜ[PLoc I]
      (⟨algebraMap (MvPolynomial σ K) (PLoc I) (g l), ker_mem I (hgI l)⟩ :
        RingHom.ker (algebraMap (PLoc I) (PRes I)))) = ⊤ := by
  set V := Submodule.span (PRes I) (Set.range fun l => (1 : PRes I) ⊗ₜ[PLoc I]
      (⟨algebraMap (MvPolynomial σ K) (PLoc I) (g l), ker_mem I (hgI l)⟩ :
        RingHom.ker (algebraMap (PLoc I) (PRes I))))
  have hm : RingHom.ker (algebraMap (PLoc I) (PRes I)) =
      Ideal.span (Set.range (algebraMap (MvPolynomial σ K) (PLoc I) ∘ g)) := by
    have e1 : I.map (algebraMap (MvPolynomial σ K) (PLoc I)) =
        (Ideal.span (Set.range g)).map (algebraMap (MvPolynomial σ K) (PLoc I)) := by rw [hg]
    rw [ker_eq_map, e1, Ideal.map_span, Set.range_comp]
  have key : ∀ y (hy : y ∈ Ideal.span (Set.range (algebraMap (MvPolynomial σ K) (PLoc I) ∘ g))),
      (1 : PRes I) ⊗ₜ[PLoc I] (⟨y, hm ▸ hy⟩ : RingHom.ker (algebraMap (PLoc I) (PRes I))) ∈ V := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨l, rfl⟩ := hx
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero =>
      have e : (⟨0, hm ▸ Submodule.zero_mem _⟩ : RingHom.ker (algebraMap (PLoc I) (PRes I))) = 0 := rfl
      rw [e, tmul_zero]
      exact V.zero_mem
    | add x z hx hz ihx ihz =>
      have e : (⟨x + z, hm ▸ Submodule.add_mem _ hx hz⟩ : RingHom.ker (algebraMap (PLoc I) (PRes I))) =
          ⟨x, hm ▸ hx⟩ + ⟨z, hm ▸ hz⟩ := rfl
      rw [e, tmul_add]
      exact V.add_mem ihx ihz
    | smul a x hx ihx =>
      have e : (⟨a • x, hm ▸ Submodule.smul_mem _ a hx⟩ : RingHom.ker (algebraMap (PLoc I) (PRes I))) =
          a • ⟨x, hm ▸ hx⟩ := rfl
      rw [e, tmul_smul, ← algebraMap_smul (PRes I) a]
      exact V.smul_mem _ ihx
  rw [eq_top_iff]
  rintro z -
  induction z using TensorProduct.induction_on with
  | zero => exact V.zero_mem
  | tmul s x =>
    have e : s ⊗ₜ[PLoc I] x = s • ((1 : PRes I) ⊗ₜ[PLoc I] x) := by rw [smul_tmul', smul_eq_mul, mul_one]
    rw [e]
    refine V.smul_mem s ?_
    have hx : x.1 ∈ Ideal.span (Set.range (algebraMap (MvPolynomial σ K) (PLoc I) ∘ g)) := hm ▸ x.2
    exact key x.1 hx
  | add z w hz hw => exact V.add_mem hz hw

/-- **The Jacobian datum** of a prime `I` of `K[σ]`, `K` perfect. -/
theorem jacobian_datum [PerfectField K] (I : Ideal (MvPolynomial σ K)) [I.IsPrime] :
    ∃ (r : ℕ) (h : Fin r → MvPolynomial σ K), (∀ j, h j ∈ I) ∧
      LinearIndependent (PRes I) (fun j (v : σ) =>
        algebraMap (MvPolynomial σ K) (PRes I) (MvPolynomial.pderiv v (h j))) ∧
      ∃ G ∉ I, ∀ q ∈ I, G * q ∈ Ideal.span (Set.range h) := by
  obtain ⟨t, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian I)
  have hgI : ∀ l, g l ∈ I := fun l => hg ▸ Submodule.subset_span ⟨l, rfl⟩
  set u : Fin t → PRes I ⊗[PLoc I] RingHom.ker (algebraMap (PLoc I) (PRes I)) := fun l =>
    (1 : PRes I) ⊗ₜ[PLoc I] (⟨algebraMap (MvPolynomial σ K) (PLoc I) (g l), ker_mem I (hgI l)⟩ :
      RingHom.ker (algebraMap (PLoc I) (PRes I))) with hu
  have hsp : Submodule.span (PRes I) (Set.range u) = ⊤ := span_tmul_gens I g hg hgI
  obtain ⟨κ, a, ha, hspa, hlia⟩ := exists_linearIndependent' (PRes I) u
  have : Finite κ := Finite.of_injective a ha
  have : Fintype κ := Fintype.ofFinite κ
  set e := Fintype.equivFin κ
  set h : Fin (Fintype.card κ) → MvPolynomial σ K := g ∘ a ∘ e.symm with hh
  have hhI : ∀ j, h j ∈ I := fun j => hgI _
  have hli : LinearIndependent (PRes I) (u ∘ a ∘ e.symm) := hlia.comp e.symm e.symm.injective
  have hsp' : Submodule.span (PRes I) (Set.range (u ∘ a ∘ e.symm)) = ⊤ := by
    rw [← Function.comp_assoc, e.symm.surjective.range_comp, hspa, hsp]
  refine ⟨Fintype.card κ, h, hhI, rows_indep I h hhI hli, ?_⟩
  -- Nakayama: the `h j` generate `I_I`
  let b := Module.Basis.mk hli hsp'.ge
  have hNak := IsLocalRing.span_eq_top_of_tmul_eq_basis (R := PLoc I)
    (M := RingHom.ker (algebraMap (PLoc I) (PRes I)))
    (fun j => (⟨algebraMap (MvPolynomial σ K) (PLoc I) (h j), ker_mem I (hhI j)⟩ :
      RingHom.ker (algebraMap (PLoc I) (PRes I)))) b (fun j => by rw [Module.Basis.mk_apply]; rfl)
  have hgen : ∀ l, ∃ s ∈ I.primeCompl, s * g l ∈ Ideal.span (Set.range h) := by
    intro l
    rw [← IsLocalization.algebraMap_mem_map_algebraMap_iff I.primeCompl (PLoc I), Ideal.map_span,
      ← Set.range_comp]
    have hm : (⟨algebraMap (MvPolynomial σ K) (PLoc I) (g l), ker_mem I (hgI l)⟩ :
        RingHom.ker (algebraMap (PLoc I) (PRes I))) ∈ Submodule.span (PLoc I) (Set.range fun j =>
          (⟨algebraMap (MvPolynomial σ K) (PLoc I) (h j), ker_mem I (hhI j)⟩ :
            RingHom.ker (algebraMap (PLoc I) (PRes I)))) := by
      rw [hNak]
      exact Submodule.mem_top
    have := Submodule.mem_map_of_mem (f := (RingHom.ker (algebraMap (PLoc I) (PRes I))).subtype) hm
    rw [Submodule.map_span, ← Set.range_comp] at this
    exact this
  choose s hs hsg using hgen
  refine ⟨∏ l, s l, I.primeCompl.prod_mem fun l _ => hs l, ?_⟩
  intro q hq
  rw [← hg] at hq
  induction hq using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl⟩ := hx
    rw [← Finset.mul_prod_erase Finset.univ s (Finset.mem_univ l), mul_comm (s l), mul_assoc]
    exact Ideal.mul_mem_left _ _ (hsg l)
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add x z _ _ hx hz => rw [mul_add]; exact Submodule.add_mem _ hx hz
  | smul c x _ hx =>
    rw [smul_eq_mul, mul_left_comm]
    exact Ideal.mul_mem_left _ _ hx

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA4d


