theorem CISO.nonempty_quotient_linearEquiv_tensorProduct_quotient
    (S₀ B : Type) [CommRing S₀] [IsDomain S₀] [CommRing B] [Algebra S₀ B]
    (𝔭₀ : Ideal B) [𝔭₀.IsPrime]
    (hS : ∀ s : S₀, algebraMap S₀ B s ∈ 𝔭₀ → s = 0)
    (𝔓₀ : Ideal (TensorProduct S₀ (FractionRing S₀) B))
    (h𝔓₀u : ∀ 𝔓 : Ideal (TensorProduct S₀ (FractionRing S₀) B), 𝔓.IsPrime →
      Ideal.comap (Algebra.TensorProduct.includeRight : B →ₐ[S₀] TensorProduct S₀ (FractionRing S₀) B) 𝔓 = 𝔭₀ → 𝔓 = 𝔓₀) :
    Nonempty ((TensorProduct S₀ (FractionRing S₀) B ⧸ 𝔓₀) ≃ₗ[FractionRing S₀]
      TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) := by
  classical

  let φq : TensorProduct S₀ (FractionRing S₀) B →ₐ[FractionRing S₀] TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀) :=
    Algebra.TensorProduct.map (AlgHom.id (FractionRing S₀) (FractionRing S₀)) (Ideal.Quotient.mkₐ S₀ 𝔭₀)
  have hφq_tmul : ∀ (f : FractionRing S₀) (b : B), φq (f ⊗ₜ b) = f ⊗ₜ Ideal.Quotient.mk 𝔭₀ b :=
    fun f b => Algebra.TensorProduct.map_tmul _ _ f b
  have hsurj : Function.Surjective φq :=
    Algebra.TensorProduct.map_surjective _ _ Function.surjective_id (Ideal.Quotient.mkₐ_surjective S₀ 𝔭₀)

  letI : Algebra (B ⧸ 𝔭₀) (TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) := Algebra.TensorProduct.rightAlgebra
  haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid (B ⧸ 𝔭₀) (nonZeroDivisors S₀))
      (TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) :=
    IsLocalization.tensorRight (R := S₀) (S := B ⧸ 𝔭₀) (A := FractionRing S₀) (nonZeroDivisors S₀)
  have hle : Algebra.algebraMapSubmonoid (B ⧸ 𝔭₀) (nonZeroDivisors S₀) ≤ nonZeroDivisors (B ⧸ 𝔭₀) := by
    rintro _ ⟨s, hs, rfl⟩
    refine mem_nonZeroDivisors_of_ne_zero fun h => ?_
    have hs0 : (s : S₀) ≠ 0 := nonZeroDivisors.ne_zero hs
    apply hs0
    apply hS
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact h
  haveI hdom : IsDomain (TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (R := B ⧸ 𝔭₀) (S := TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) hle
  have halg : ∀ d : B ⧸ 𝔭₀, algebraMap (B ⧸ 𝔭₀) (TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀)) d =
      (1 : FractionRing S₀) ⊗ₜ d := fun _ => rfl
  have hinjq : Function.Injective (algebraMap (B ⧸ 𝔭₀) (TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀))) :=
    IsLocalization.injective _ hle

  let J : Ideal (TensorProduct S₀ (FractionRing S₀) B) := RingHom.ker φq.toRingHom
  have hJprime : J.IsPrime := RingHom.ker_isPrime φq.toRingHom
  have hJcomap : Ideal.comap
      (Algebra.TensorProduct.includeRight : B →ₐ[S₀] TensorProduct S₀ (FractionRing S₀) B) J = 𝔭₀ := by
    ext b
    rw [Ideal.mem_comap, RingHom.mem_ker]
    show φq ((Algebra.TensorProduct.includeRight : B →ₐ[S₀] _) b) = 0 ↔ b ∈ 𝔭₀
    rw [Algebra.TensorProduct.includeRight_apply, hφq_tmul, ← halg, map_eq_zero_iff _ hinjq,
      Ideal.Quotient.eq_zero_iff_mem]
  have hJ : J = 𝔓₀ := h𝔓₀u J hJprime hJcomap

  let e₁ : (TensorProduct S₀ (FractionRing S₀) B ⧸ J) ≃ₐ[FractionRing S₀]
      TensorProduct S₀ (FractionRing S₀) (B ⧸ 𝔭₀) := Ideal.quotientKerAlgEquivOfSurjective hsurj
  let e₀ : (TensorProduct S₀ (FractionRing S₀) B ⧸ 𝔓₀) ≃ₐ[FractionRing S₀]
      (TensorProduct S₀ (FractionRing S₀) B ⧸ J) := Ideal.quotientEquivAlgOfEq (FractionRing S₀) hJ.symm
  exact ⟨(e₀.trans e₁).toLinearEquiv⟩

