    have hne := ne56 hi
    have hne' := Ne.symm hne
    have h1 := Ex.code_runs (I := I) (iprog := iprog) n s hc hok
    have h2 := IRuns.mv (I := I) (iprog := iprog)
      (s := s.upd 56 (.int (n.eval s) :: s.G 56)) (i := zX.V) (j := i) (a := n.eval s)
      (L := s.G 56) (by simpa using hne) (by simp [IState.upd_G])
