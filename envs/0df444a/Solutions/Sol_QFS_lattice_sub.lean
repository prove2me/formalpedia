open QFS

variable {d : ℕ}
variable {Γ : Configuration (EuclideanSpace ℝ (Fin d))}
variable {ϑ : ℝ}

lemma solution {x y : EuclideanSpace ℝ (Fin d)} (hx : x ∈ QFS.lattice d)
    (hy : y ∈ QFS.lattice d) : x - y ∈ QFS.lattice d := by
  rw [QFS.mem_lattice_iff] at hx hy ⊢
  intro i
  obtain ⟨n, hn⟩ := hx i
  obtain ⟨m, hm⟩ := hy i
  refine ⟨n - m, ?_⟩
  have he : (x - y) i = x i - y i := by simp
  rw [he, hn, hm]
  push_cast
  ring
