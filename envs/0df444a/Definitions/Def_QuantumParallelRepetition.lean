            exactJointPrefixQuestionMass G n
                (insert j fixedX) fixedY
                (Function.update knownX j x) knownY /
              exactJointPrefixQuestionMass
                G n fixedX fixedY knownX knownY =
                G.conditionalXGivenY (knownY j) x := by
          rw [insertion]
