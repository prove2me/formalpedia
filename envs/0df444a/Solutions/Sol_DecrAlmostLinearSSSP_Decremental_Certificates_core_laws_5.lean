lemma Addresses.frame (base : ℕ) {s t : Data} (h : Addresses base s)
    (hf : ∀ k, k ∈ ([568,574,576,578,580] : List ℕ) → t.natReg k = s.natReg k) : Addresses base t :=
  ⟨(hf 568 (by simp)).trans h.root,(hf 574 (by simp)).trans h.next,
    (hf 576 (by simp)).trans h.tail,(hf 578 (by simp)).trans h.head,(hf 580 (by simp)).trans h.flag⟩
lemma fields (base : ℕ) (s : Data) (h : Addresses base s) (hz : s.natReg 56 = 0) :
    (result s).natMem base = 0 ∧ (result s).natMem (base+2) = 0 ∧
    (result s).natMem (base+4) = s.natReg 626 ∧
    (result s).natMem (base+6) = s.natReg 628 ∧
    (result s).natMem (base+8) = s.natReg 648 ∧
    (result s).realMem base = s.realReg 612 ∧
    (result s).realMem (base+2) = s.realReg 602 ∧
    (result s).realMem (base+4) = s.realReg 604 ∧
    (result s).realMem (base+6) = s.realMem (base+6) ∧
    (result s).realMem (base+8) = s.realReg 606 := by
  simp (disch := omega) [result,atoms,Atom.effect,instructionEffect,data,Data.machine,
    h.root,h.next,h.tail,h.head,h.flag,hz]
