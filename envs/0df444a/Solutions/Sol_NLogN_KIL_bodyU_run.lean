  · exact ⟨le_rfl, Nat.coprime_one_right _, hB0⟩

theorem subU_spec {N : ℕ} [NeZero N] (A B Cs : Shape) (P L : ℕ) (rX : Fin HS)
    (hrX : 38 ≤ rX.val ∧ rX.val < 56)
    (hpos : ∀ a ∈ P :: L :: hdShape A B Cs m N, 1 ≤ a) (Bb : ℕ) (R : List Item)
    (hV : zsz ((vol (P :: L :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb) (hSB : SubBnd N Bb)
    {LN LQ LX LB LC : List Item} (t : IState HS) (hNQ : t.G sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rX = .int ((vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G rVB = .int ((vol B : ℕ) : ℤ) :: LB)
    (hC : t.G rVC = .int ((vol Cs : ℕ) : ℤ) :: LC) (xs : List ℤ)
    (hlen : xs.length = vol (P :: L :: hdShape A B Cs m N)) (hb : Bnd Bb xs)
