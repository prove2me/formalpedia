  | base => simp
  | succ b hb ih =>
    rw [Finset.prod_Ioc_succ_top hb, ih]
    have : (0:ℝ) < b := by exact_mod_cast hb
    push_cast
    field_simp
    ring

lemma tel2 (b : ℕ) (hb : 1 ≤ b) :
    ∏ n ∈ Ioc 1 b, (1 + 2 * ((n : ℝ))⁻¹) = ((b : ℝ) + 1) * (b + 2) / 6 := by
