-- Source module: Solutions.J6SegILSlab1
/-!
# B-line IL, B1 (streaming slab pass) §1: the list level

The IL slab pass streams a `(pre, n, m)` array of *units* (an integer, or a pair of integers
for the zipped output pass) block by block. A block is driven by a **command list**
`cs : List (ℤ × ℤ)` of pairs `(op, arg)`:

* `op < 0`: drop the current input slab (`m` units);
* `op = 0`: emit a zero slab (`m` zeros);
* `op > 0`: emit the current input slab mapped unit-wise by `g arg` (the slab is kept).

`runC m g cs B` is the output of one block. For a monotone source `src` (`MonoSrc`),
`ctlOf n n' src argOf` is the command list (drops to the next source slab, then an emit;
a zero emit for `none`; final drops), and **`runC_ctlOf`**: the block output is the block of
`slabPass n n' m src (fun l => g (argOf l))`. **`slabPass_blocks`**: the whole pass is the
concatenation of the block outputs.

**`flat_slabPass`**: for a flattening `φ : α → List γ` with two entries per item and a map `h`
acting entry-wise (`φ (h l x) = (φ x).map (h' l)`), `flatMap φ` commutes with slab passes
(`post ↦ 2 post`). Instances: `gflat` (passes 1, 3, 5) and `pflat` on `zip Y Y₂` (pass 7,
`pflat (zip Y Y₂) = zip (gflat Y) (gflat Y₂)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Commands -/

section cmd
variable {U : Type*}

theorem ctlAux_le (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), cur ≤ n → SrcFrom src n ls cur →
      cur ≤ (ctlAux src argOf ls cur).2 ∧ (ctlAux src argOf ls cur).2 ≤ n
  | [], cur, hc, _ => by simp [ctlAux, hc]
  | l :: ls, cur, hc, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs]
      exact ctlAux_le src argOf n ls cur hc h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      have := ctlAux_le src argOf n ls k h2.le h3
      simp only [ctlAux, hs]
      exact ⟨by omega, this.2⟩

variable [Inhabited U]

theorem srcFrom_of_mono {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    ∀ (j : ℕ) (cur : ℕ), j ≤ n' → (∀ l k, l < j → src l = some k → k ≤ cur) →
      (∀ l k, j ≤ l → l < n' → src l = some k → cur ≤ k) →
      SrcFrom src n ((List.range n').drop j) cur := by
  intro j cur hj hlo hhi
  induction hk : n' - j generalizing j cur with
  | zero =>
    rw [List.drop_of_length_le (by simp; omega)]; trivial
  | succ r ih =>
    have hjn : j < n' := by omega
    rw [List.drop_eq_getElem_cons (by simp; exact hjn)]
    simp only [List.getElem_range]
    unfold SrcFrom
    cases hs : src j with
    | none =>
      exact ih (j + 1) cur (by omega)
        (fun l k hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact hlo l k hl hlk
          · rw [hs] at hlk; cases hlk)
        (fun l k hl hln hlk => hhi l k (by omega) hln hlk) (by omega)
    | some k =>
      refine ⟨hhi j k le_rfl hjn hs, h.1 j hjn k hs, ?_⟩
      exact ih (j + 1) k (by omega)
        (fun l k' hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact h.2 l j k' k hl hjn hlk hs
          · rw [hs] at hlk; cases hlk; exact le_rfl)
        (fun l k' hl hln hlk => h.2 j l k k' (by omega) hln hs hlk) (by omega)

theorem srcFrom_range {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    SrcFrom src n (List.range n') 0 := by
  have := srcFrom_of_mono h 0 0 (Nat.zero_le _) (fun l k hl => absurd hl (Nat.not_lt_zero _))
    (fun _ _ _ _ _ => Nat.zero_le _)
  simpa using this

end cmd

