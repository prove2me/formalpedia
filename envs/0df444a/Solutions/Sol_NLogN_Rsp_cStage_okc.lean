      ex_eval_congr b (fun i hi => h i (Or.inr hi))]
  | .neg a, h => by simp only [Ex.regs] at h; simp only [Ex.cost, ex_cost_congr a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h; simp only [Ex.cost, ex_cost_congr a h, ex_eval_congr a h]
  | .sel c x y, h => by
