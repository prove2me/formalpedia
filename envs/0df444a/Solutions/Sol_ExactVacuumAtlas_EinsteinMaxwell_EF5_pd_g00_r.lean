open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.EF5
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.EF5
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
variable (mu beta Q : ℝ)
theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 1 (gEF5 mu beta 0 0) x = -(2 * mu / x 1 ^ 3 - 4 * beta / x 1 ^ 5) := by
  have hr := domU5_r hx
  rw [gEF5_00_fun, pd]
  -- The slice replaces x 1 by u
  have hslice : (fun u : ℝ => -(1 - mu / (Function.update x 1 u) 1 ^ 2
                               + beta / (Function.update x 1 u) 1 ^ 4))
              = fun u => -(1 - mu / u ^ 2 + beta / u ^ 4) := by
    funext u; simp [Function.update_apply]
  rw [hslice]
  -- Use Atlas Core Deriv lemmas for the shapes that appear
  have h1 : HasDerivAt (fun u => mu / u ^ 2) (-(2 * mu) / x 1 ^ 3) (x 1) := by
    have := ExactVacuumAtlas.Deriv.div_sq mu (x 1) hr
    exact this.congr_deriv (by ring)
  have h2 : HasDerivAt (fun u => beta / u ^ 4) (-(4 * beta) / x 1 ^ 5) (x 1) := by
    have := ExactVacuumAtlas.RNDeriv.div_four beta (x 1) hr
    exact this.congr_deriv (by ring)
  exact ((((hasDerivAt_const (x 1) 1).fun_sub h1).fun_add h2).fun_neg).congr_deriv (by ring) |>.deriv
