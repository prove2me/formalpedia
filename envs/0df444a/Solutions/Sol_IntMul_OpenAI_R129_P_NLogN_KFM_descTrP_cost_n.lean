theorem pushLoop_cost (Bd : RS) (dst : Fin HS) (hdO : dst ≠ mOc) (s : IState HS) (d : ℕ)
    (LD : List Item) (hD : s.G NLogN.KFM.zD = .int (d : ℤ) :: LD) (v : ℕ → ℤ)
    (hB : ∀ (L : List Item) (c : ℕ), 1 ≤ c → c ≤ d →
      Bd.ok ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) ∧
      Bd.run ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) =
        ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)).upd dst
          (.int (v (c - 1)) :: L ++ s.G dst))
    (B C : ℕ) (hzd : zsz (d : ℤ) ≤ B) (hB1 : 1 ≤ B)
    (hbc : ∀ (L : List Item) (c : ℕ), 1 ≤ c → c ≤ d →
