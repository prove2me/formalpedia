open IntMul IntMul.HvdH NLogN

theorem Gd_eq (n : ℕ) : Gd n = Ref.difZ (2 ^ n + 1) := by
  rw [Ref.difZ_eq']; rfl

theorem Gt_eq (n : ℕ) : Gt n = Ref.ditZ (2 ^ n + 1) n := by
  rw [Ref.ditZ_eq']; rfl

theorem fermatW_eq (q : Ref.Params) (U V : List (ℤ × ℤ))
    (hA : ((Ref.chunkL q.r U).map (encRes q.P q.r)).length = 2 ^ q.logOuter)
    (hB : ((Ref.chunkL q.r V).map (encRes q.P q.r)).length = 2 ^ q.logOuter)
    (hC : (Ref.pmulZ (2 ^ q.fn + 1)
        (lvls (Gd q.fn) (descs q.outerAxes 1) ((Ref.chunkL q.r U).map (encRes q.P q.r)))
        (lvls (Gd q.fn) (descs q.outerAxes 1) ((Ref.chunkL q.r V).map (encRes q.P q.r)))).length =
        2 ^ q.logOuter) :
    Ref.fermatW q U V =
      ((lvls (Gt q.fn) (descs q.outerAxes 1).reverse
        (Ref.pmulZ (2 ^ q.fn + 1)
          (lvls (Gd q.fn) (descs q.outerAxes 1) ((Ref.chunkL q.r U).map (encRes q.P q.r)))
          (lvls (Gd q.fn) (descs q.outerAxes 1) ((Ref.chunkL q.r V).map (encRes q.P q.r))))).map
        (scl q.fn q.logOuter)).flatMap (Ref.decBlk (2 ^ q.fn + 1) q.P q.r) := by
  have hF : (0 : ℤ) < 2 ^ q.fn + 1 := by positivity
  have eA : (Ref.chunkL q.r U).map (fun blk => Ref.encBlk q.P q.r blk % q.F) =
      (Ref.chunkL q.r U).map (encRes q.P q.r) := rfl
  have eB : (Ref.chunkL q.r V).map (fun blk => Ref.encBlk q.P q.r blk % q.F) =
      (Ref.chunkL q.r V).map (encRes q.P q.r) := rfl
  unfold Ref.fermatW
  simp only []
  rw [eA, eB, Prm.F_eq, mdif_eq_lvls _ hF _ _ (by rw [hA, Prm.blockSize_outerAxes]),
    mdif_eq_lvls _ hF _ _ (by rw [hB, Prm.blockSize_outerAxes]), ← Gd_eq,
    mdit_eq_lvls _ _ _ _ (by rw [hC, Prm.blockSize_outerAxes]), ← Gt_eq]
  rfl

theorem lvls_all (M : MulSpec) (T : RM) (G : ℕ → ℕ → List ℤ → List ℤ) (cT : ℕ → ℕ)
    (n kb W N J : ℕ) (D : List Desc) (hD : PassOK M T G cT n kb W N J D) (A : List ℤ)
    (hAl : A.length = N) (hAc : Canon (2 ^ n + 1) A) :
    (lvls G D A).length = N ∧ Canon (2 ^ n + 1) (lvls G D A) := by
  simpa using lvls_facts M T G cT n kb W N J D hD A hAl hAc D.length le_rfl

theorem length_flatMap_decBlk (F : ℤ) (P r : ℕ) (C : List ℤ) :
    (C.flatMap (Ref.decBlk F P r)).length = C.length * r := by
  induction C with
  | nil => simp
  | cons z C ih => simp [List.flatMap_cons, ih, Ref.decBlk]; ring

