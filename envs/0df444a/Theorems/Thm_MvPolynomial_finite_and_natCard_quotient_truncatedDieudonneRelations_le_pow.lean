-- title:
--   Finiteness of a truncated Dieudonné ring, with bound pⁿᵇ
-- statement:
--   Let $p$ be a natural number with $0 < p$ (no primality is assumed), and let $n$, $a$, $b$ be natural numbers with $a < b$. Work in the polynomial ring $\mathbb{Z}[F,V]$ in two commuting variables, realised as `MvPolynomial Bool ℤ` with $F = X_{\mathrm{true}}$ and $V = X_{\mathrm{false}}$, and let $I$ be the ideal generated by the three-element set
--   $$\{\,FV - p,\quad V^{n},\quad F^{b} - F^{a}\,\}.$$
--   The assertion is the conjunction of two statements about the quotient ring $\mathbb{Z}[F,V]/I$: first, that it is finite; and second, that its cardinality, measured by `Nat.card`, is at most $p^{\,n b}$. Here the constant $p$ appearing in the first generator is the image of $p$ under the structure map $\mathbb{Z} \to \mathbb{Z}[F,V]$, i.e. `MvPolynomial.C (p : ℤ)`. Note that the exponents $n$ and $b$ are unconstrained apart from $a < b$, so the degenerate cases $n = 0$ (where the quotient is the zero ring) and $a = 0$ are included.
--
--   The quotient in question is the truncated Dieudonné ring attached to the Witt-vector kernel group $W_n[F^b - F^a]$ over the prime field: the commutative Dieudonné ring $\mathbb{Z}[F,V]/(FV-p)$ cut down by $V^n$ and $F^b - F^a$, no $p$-adic completion being needed since $p^n = F^nV^n$ lies in the ideal. The finiteness and the bound $p^{nb}$ on the order are used in the analysis of kernels of Witt-vector endomorphisms, where they feed the construction of an additive homomorphism out of such a kernel.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPolynomial_finite_and_natCard_quotient_truncatedDieudonneRelations_le_pow.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem MvPolynomial.finite_and_natCard_quotient_truncatedDieudonneRelations_le_pow
    (p : ℕ) (hp : 0 < p) (n a b : ℕ) (hab : a < b) :
    Finite (MvPolynomial Bool ℤ ⧸ Ideal.span
        ({MvPolynomial.X true * MvPolynomial.X false - MvPolynomial.C (p : ℤ),
          MvPolynomial.X false ^ n, MvPolynomial.X true ^ b - MvPolynomial.X true ^ a} :
          Set (MvPolynomial Bool ℤ))) ∧
      Nat.card (MvPolynomial Bool ℤ ⧸ Ideal.span
        ({MvPolynomial.X true * MvPolynomial.X false - MvPolynomial.C (p : ℤ),
          MvPolynomial.X false ^ n, MvPolynomial.X true ^ b - MvPolynomial.X true ^ a} :
          Set (MvPolynomial Bool ℤ))) ≤ p ^ (n * b) := by sorry
