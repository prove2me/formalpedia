  have h3 := epi_runs (I := I) (iprog := iprog) hCD
    (((((s.upd C (marks n ++ .int 0 :: s.G C)).upd D (.int 0 :: s.G D))).upd X o).upd Y o') n
    (s.G C) (s.G D) (by simp [Ne.symm hXC, Ne.symm hYC, Ne.symm hCD, hCD])
    (by simp [Ne.symm hXD, Ne.symm hYD])
  refine (h1.seq (hb.seq h3)).mono' ?_ (by omega)
  clear h1 h3 hb
  ((apply NLogN.IState.ext' <;> intros <;>
           simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
         split_ifs <;>
       simp_all +decide))

end KFC

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open IntMul AModel
open NLogN.KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (as : ℕ → ℕ) (P Q B w : ℕ)
    (R L1 L2 L4 L14 : List NLogN.Item) (has : ∀ p, as p ≤ Q)
    (hlen : xs.length = P * Q * B) (hb : NLogN.Bnd w xs)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int B :: L4)
    (h14 : t.G 14 = NLogN.ints ((List.range P).map fun p => (as p : ℤ)) ++ L14) :
    NLogN.IRuns I iprog NLogN.KFC.rotF t
      ((t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.rotAddr Q as) 0 xs) ++ R)).upd 14 L14)
      (NLogN.KFC.cRotF P Q B w) := by
  set r := NLogN.KIL.recR xs Q B
  have hr : ∀ p y, (r p y).length = B := fun p y => NLogN.KIL.length_recR xs Q B p y
  have hbr : ∀ p y, NLogN.Bnd w (r p y) := by
    intro p y a ha
    simp only [r, NLogN.KIL.recR, List.mem_map, List.mem_range] at ha
    obtain ⟨b, -, rfl⟩ := ha
    unfold List.getD
    rcases h : xs[(p * Q + y) * B + b]? with _ | x
    · simp [NLogN.zsz_zero]
    · exact hb x (List.mem_of_getElem? h)
  have hxs : xs = NLogN.KFC.flF (NLogN.KIL.blk3 r Q) 0 P := by
    conv_lhs => rw [← NLogN.KIL.inR_recR hlen]
    simp [NLogN.KIL.inR, NLogN.KFC.flF, List.range_eq_range']; rfl
  have hout : AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.rotAddr Q as) 0 xs = NLogN.KFC.flF (NLogN.KIL.rotBlk r Q as) 0 P := by
    rw [← NLogN.KIL.outR_recR xs P Q B as has]; simp [NLogN.KIL.outR, NLogN.KFC.flF, List.range_eq_range']; rfl
  rw [hout]
  have hlo : (NLogN.KFC.flF (NLogN.KIL.rotBlk r Q as) 0 P).length = P * Q * B := by
    rw [← hout, AModel.pull]; simp [AModel.vol]; ring
  set s1 := (t.upd NLogN.KFC.sCB (NLogN.KFC.marks B ++ .int 0 :: t.G NLogN.KFC.sCB)).upd NLogN.KFC.sDB (.int 0 :: t.G NLogN.KFC.sDB)
  set s2 := (s1.upd NLogN.KFC.sCP (NLogN.KFC.marks P ++ .int 0 :: s1.G NLogN.KFC.sCP)).upd NLogN.KFC.sDP (.int 0 :: s1.G NLogN.KFC.sDP)
  have c2 := NLogN.KFC.coreR_runs (I := I) (iprog := iprog) s2 P Q B w r as R L2 L14
    (.int 0 :: t.G NLogN.KFC.sCP) (.int 0 :: t.G NLogN.KFC.sDP) (.int 0 :: t.G NLogN.KFC.sCB) (.int 0 :: t.G NLogN.KFC.sDB) has hr hbr
    (by simp +decide [s2, s1, h0, ← hxs]) (by simp +decide [s2, s1, h2])
    (by simp +decide [s2, s1, h14, List.range_eq_range'])
    (by simp +decide [s2, s1]) (by simp +decide [s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
    (by simp +decide [s2, s1]) (by simp +decide [s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
  have w2 := NLogN.KFC.wrap2_runs (I := I) (iprog := iprog) (A := 1) (C := NLogN.KFC.sCP) (D := NLogN.KFC.sDP) (X := NLogN.KFC.sX)
    (Y := NLogN.KFC.sTb) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s1 P L1 _ _
    (by simp +decide [s1, h1]) NLogN.KFC.coreR _ c2
  have w1 := NLogN.KFC.wrap2_runs (I := I) (iprog := iprog) (A := 4) (C := NLogN.KFC.sCB) (D := NLogN.KFC.sDB) (X := NLogN.KFC.sX)
    (Y := NLogN.KFC.sTb) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) t B L4 _ _ h4 _ _ w2
  refine w1.mono ?_
  rw [hlo]; unfold NLogN.KFC.cRotF; omega
end
