-- title:
--   The cone generated by functions whose finite sums have nonpositive infima
-- statement:
--   Let $X$ be a set, $S\subseteq X$, and $(u_i)_{i\in\iota}$ a family of real functions on $X$ such that
--
--   1. each $u_i$ is bounded on $S$;
--   2. every finite sum of members of the family (repetitions allowed, including the empty sum) has nonpositive infimum on $S$: for all $i_1,\dots,i_n\in\iota$ and $\varepsilon>0$ there is $t\in S$ with $\sum_{j=1}^n u_{i_j}(t)\le\varepsilon$.
--
--   Then there is a convex cone $K$ of real functions on $X$ (closed under addition and under multiplication by nonnegative reals) containing every $u_i$, all of whose members are bounded on $S$ and have nonpositive infimum on $S$ (for every $\varphi\in K$ and $\varepsilon>0$ there is $t\in S$ with $\varphi(t)\le\varepsilon$).
--
--   One takes for $K$ the set of nonnegative combinations $\sum_j r_j u_{i_j}$; rational combinations reduce to finite sums with repetitions, and real ones are approximated using the boundedness of the $u_i$ on $S$. This is the elementary half of the proof of Pietsch's domination theorem, preparing the cone to which the Hahn–Banach separation step `MasulloGRH.exists_state_nonpos_on_cone` applies.
-- source:
--   Pietsch domination theorem: A. Pietsch, Nuclear Locally Convex Spaces, Springer 1972, Theorem 2.3.3 and its proof (Hahn-Banach separation in the space of bounded functions); used for A. M. Masullo, The Music of the Primes, draft of 20 November 2026, https://math216.wordpress.com/wp-content/uploads/2026/11/the-music-of-the-primes.pdf, Appendix C, Lemma C.2.4.10 (characterizations of nuclearity)

import Mathlib

set_option autoImplicit false

namespace MasulloGRH

theorem exists_cone_of_finite_sums_inf_le (X ι : Type*) (S : Set X) (u : ι → X → ℝ)
    (hu : ∀ i, ∃ M : ℝ, ∀ t ∈ S, |u i t| ≤ M)
    (hsum : ∀ (n : ℕ) (i : Fin n → ι) (ε : ℝ), 0 < ε → ∃ t ∈ S, ∑ j, u (i j) t ≤ ε) :
    ∃ K : Set (X → ℝ), (∀ i, u i ∈ K) ∧ (∀ φ ∈ K, ∀ ψ ∈ K, φ + ψ ∈ K) ∧
      (∀ r : ℝ, 0 ≤ r → ∀ φ ∈ K, r • φ ∈ K) ∧
      (∀ φ ∈ K, ∃ M : ℝ, ∀ t ∈ S, |φ t| ≤ M) ∧
      (∀ φ ∈ K, ∀ ε : ℝ, 0 < ε → ∃ t ∈ S, φ t ≤ ε) := by sorry

end MasulloGRH
