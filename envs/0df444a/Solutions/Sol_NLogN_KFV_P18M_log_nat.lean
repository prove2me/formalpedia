/-- The integer bound `L₁ L₂ ≤ (ℓ + q + 7)(4q + 12)`. -/
theorem log_nat_sol_aux (P ℓ q : ℕ) (hP7 : 7 ≤ P) (hℓP : ℓ ≤ P) (hq1 : 2 ^ q ≤ P) (hq2 : P < 2 ^ (q + 1)) :
    (zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) + 2) *
      (zsz (((zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) ≤
      (ℓ + q + 7) * (4 * q + 12) := by
  have hX : kb P ℓ < 2 ^ (q + 3) := by
    unfold kb
    have : 2 ^ (q + 3) = 4 * 2 ^ (q + 1) := by
      rw [show q + 3 = (q + 1) + 2 by ring, pow_add]; ring
    omega
  have hY : 1 ≤ 2 ^ ℓ := Nat.one_le_two_pow
  have hX8 : 8 ≤ 2 ^ (q + 3) := by
    have := Nat.one_le_two_pow (n := q)
    have e : 2 ^ (q + 3) = 8 * 2 ^ q := by rw [pow_add]; ring
    omega
  have hm : 2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 < 2 ^ (q + ℓ + 5) := by
    have e : 2 ^ (q + ℓ + 5) = 4 * (2 ^ (q + 3) * 2 ^ ℓ) := by
      rw [show q + ℓ + 5 = (q + 3) + ℓ + 2 by ring, pow_add, pow_add]; ring
    have h1 : kb P ℓ * 2 ^ ℓ ≤ (2 ^ (q + 3) - 1) * 2 ^ ℓ := Nat.mul_le_mul_right _ (by omega)
    have h2 : 8 * 2 ^ ℓ ≤ 2 ^ (q + 3) * 2 ^ ℓ := Nat.mul_le_mul_right _ hX8
    rw [e]
    generalize 2 ^ (q + 3) = X at *
    generalize 2 ^ ℓ = Y at *
    generalize kb P ℓ * Y = KY at *
    have h3 : (X - 1) * Y = X * Y - Y := by rw [Nat.sub_mul, one_mul]
    rw [h3] at h1
    generalize X * Y = XY at *
    omega
  have hz1 : zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) ≤ q + ℓ + 5 :=
    zsz_le_of_lt hm
  generalize zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) = Z at *
  have hq : q < P := lt_of_lt_of_le (Nat.lt_two_pow_self) hq1
  have hL : Z + 2 ≤ 3 * P := by omega
  have hL4 : (Z + 2) ^ 4 < 2 ^ (4 * q + 11) := by
    have h1 : (Z + 2) ^ 4 ≤ (3 * P) ^ 4 := Nat.pow_le_pow_left hL 4
    have h2 : P ^ 4 < (2 ^ (q + 1)) ^ 4 := Nat.pow_lt_pow_left hq2 (by norm_num)
    have e1 : (3 * P) ^ 4 = 81 * P ^ 4 := by ring
    have e2 : 2 ^ (4 * q + 11) = 128 * (2 ^ (q + 1)) ^ 4 := by
      rw [← pow_mul, show 4 * q + 11 = 7 + (q + 1) * 4 by ring, pow_add]; norm_num
    omega
  have hz2 : zsz (((Z + 2) ^ 4 : ℕ) : ℤ) ≤ 4 * q + 11 := zsz_le_of_lt hL4
  exact Nat.mul_le_mul (by omega) (by omega)

end NLogN.KFV.P18M

