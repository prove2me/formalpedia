section
-- Source module: Solutions.R6BitLevel
/-!
# Round six, bit side: one level of the generalized Prop. 11

On the shape `P :: (W L') :: hdShape A B Cs m N` (two chunks of `m` fields of size `N`):
split the rows into `W` role streams (plus `T` zero temporaries), run the network with every
edge implemented by its shifts and **one child call per run** (`realEdge`), merge back undoing
`ρ`. With correct children and `C.OK N` this is the chunk interchange (`levelH_correct`).

1. `realEdge_eq`: with children equal to the exact run transpositions, the implemented edge is
   the ideal one (`runArr` of the Bruhat steps).
2. `runArr_runPiv`: on the stream layout, the transpositions of a run `(i, j, r)` are the block
   swap of the field runs `H_i … H_{i+r-1}` and `D_j … D_{j+r-1}`.
3. `levelH_correct`.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {m : ℕ}

/-! ## 1. Implemented edges -/

section Edge

variable {sh : Shape} {N : ℕ} (Λ : Layout sh (m + m) N)

lemma runArr_append (d : R) (l₁ l₂ : List (Step (m + m) N)) (xs : List R) :
    runArr Λ d (l₁ ++ l₂) xs = runArr Λ d l₂ (runArr Λ d l₁ xs) := by
  simp [runArr, List.foldl_append]

lemma runArr_flatMap_runs (runs : List (ℕ × ℕ × ℕ)) (child : ℕ × ℕ × ℕ → List R → List R)
    (hch : ∀ ρ ∈ runs, ∀ ys : List R, ys.length = vol sh →
      child ρ ys = runArr Λ 0 (swapSteps (runPiv m ρ)) ys) :
    ∀ ys : List R, ys.length = vol sh →
      runArr Λ 0 (swapSteps (runs.flatMap (runPiv m))) ys = runs.foldl (fun ys ρ => child ρ ys) ys := by
  induction runs with
  | nil => intro ys _; rfl
  | cons ρ rs ih =>
    intro ys hys
    have e : (swapSteps ((ρ :: rs).flatMap (runPiv m)) : List (Step (m + m) N)) =
        swapSteps (runPiv m ρ) ++ swapSteps (rs.flatMap (runPiv m)) := by
      simp [swapSteps, List.flatMap_cons, List.map_append]
    rw [e, runArr_append, List.foldl_cons, ← hch ρ List.mem_cons_self ys hys]
    refine ih (fun ρ' h => hch ρ' (List.mem_cons_of_mem _ h)) _ ?_
    rw [hch ρ List.mem_cons_self ys hys]
    exact length_runArr Λ 0 _ hys

/-- With exact children, the implemented edge is the ideal one. -/
theorem realEdge_eq (child : ℕ × ℕ × ℕ → List R → List R) (e : Edge m)
    (hch : ∀ ρ ∈ e.runs, ∀ ys : List R, ys.length = vol sh →
      child ρ ys = runArr Λ 0 (swapSteps (runPiv m ρ)) ys)
    {ys : List R} (hys : ys.length = vol sh) :
    realEdge Λ child e ys = runArr Λ 0 (e.steps N) ys := by
  rw [Edge.steps, bruhatSteps, runArr_append, runArr_append, realEdge,
    runArr_flatMap_runs Λ e.runs child hch _ (length_runArr Λ 0 _ hys)]

end Edge

/-! ## 2. Runs on the stream layout are block swaps of field runs -/

section RunBlock

variable {sh : Shape} {N : ℕ} (Λ : Layout sh (m + m) N)

lemma posPairs_runPiv {p p' : ℕ} (hp : ∀ i : Fin m, (Λ.pos (Fin.castAdd m i) : ℕ) = p + i)
    (hp' : ∀ j : Fin m, (Λ.pos (Fin.natAdd m j) : ℕ) = p' + j) {ρ : ℕ × ℕ × ℕ}
    (h : RunOK m ρ) : posPairs Λ (runPiv m ρ) = runPairs (p + ρ.1) (p' + ρ.2.1) ρ.2.2 := by
  obtain ⟨-, -, h1, h2⟩ := h
  simp only [posPairs, runPiv, runPairs, List.map_filterMap]
  rw [← List.filterMap_eq_map]
  apply List.filterMap_congr
  intro k hk
  rw [List.mem_range] at hk
  rw [dif_pos ⟨by omega, by omega⟩]
  simp only [Option.map_some, Function.comp_apply, hp, hp']
  congr 1
  ext <;> simp <;> omega

/-- The transpositions of a valid run, for `H` fields at `p + i` and `D` fields at `p' + j`,
act as the block swap of the two position runs. -/
theorem runArr_runPiv {p p' : ℕ} (hp : ∀ i : Fin m, (Λ.pos (Fin.castAdd m i) : ℕ) = p + i)
    (hp' : ∀ j : Fin m, (Λ.pos (Fin.natAdd m j) : ℕ) = p' + j) (hpp : p + m ≤ p')
    (hlen : p' + m ≤ sh.length) [NeZero N] {ρ : ℕ × ℕ × ℕ} (h : RunOK m ρ) {ys : List R}
    (hys : ys.length = vol sh) :
    runArr Λ 0 (swapSteps (runPiv m ρ)) ys =
      pull sh sh (blockSwap (p + ρ.1) (p' + ρ.2.1) ρ.2.2) 0 ys := by
  obtain ⟨h0, h1, h2, h3⟩ := h
  rw [runArr_eq_pull Λ 0 _ hys]
  apply pull_congr
  intro a ha
  rw [invChain_swapSteps, posPairs_runPiv Λ hp hp' ⟨h0, h1, h2, h3⟩,
    chain_runPairs (by omega) (by rw [ha.length_eq]; omega)]

end RunBlock

/-! ## 3. One level -/

section Level

variable {W T : ℕ} [NeZero W] (C : QHNet R W T m) (N P L' : ℕ) (A B Cs : Shape)

lemma stream_pos_H (L : ℕ) (i : Fin m) :
    (((hdLayout A B Cs m N).cons2 P L).pos (Fin.castAdd m i) : ℕ) = (A.length + 2) + i := by
  simp only [Layout.cons2_pos, hdLayout_pos, hdPos_castAdd]; omega

lemma stream_pos_D (L : ℕ) (j : Fin m) :
    (((hdLayout A B Cs m N).cons2 P L).pos (Fin.natAdd m j) : ℕ) =
      (A.length + B.length + m + 2) + j := by
  simp only [Layout.cons2_pos, hdLayout_pos, hdPos_natAdd]; omega

lemma stream_len (L : ℕ) :
    A.length + B.length + m + 2 + m ≤ (P :: L :: hdShape A B Cs m N).length := by
  simp [length_hdShape]; omega

variable [NeZero N]

/-- With exact children, the implemented edges are the ideal ones on the stream layout. -/
lemma realEdge_stream {child : ℕ × ℕ × ℕ → List R → List R}
    (hch : ChildOKH (R := R) (m := m) N P L' A B Cs child) (e : Edge m)
    (he : ∀ ρ ∈ e.runs, RunOK m ρ) {ys : List R}
    (hys : ys.length = vol (P :: L' :: hdShape A B Cs m N)) :
    realEdge ((hdLayout A B Cs m N).cons2 P L') child e ys =
      runArr ((hdLayout A B Cs m N).cons2 P L') 0 (e.steps N) ys := by
  refine realEdge_eq _ child e (fun ρ hρ zs hzs => ?_) hys
  rw [hch ρ (he ρ hρ) zs hzs, runArr_runPiv _ (stream_pos_H N P A B Cs L')
    (stream_pos_D N P A B Cs L') (by omega) (stream_len N P A B Cs L') (he ρ hρ) hzs]

/-- **Inductive step of the generalized Prop. 11.** With exact children and `C.OK N`, one level
is the interchange of the two chunks (block swap of the two runs of `m` fields). -/
theorem levelH_correct_sol_aux (hOK : C.OK N) {child : ℕ × ℕ × ℕ → List R → List R}
    (hch : ChildOKH (R := R) (m := m) N P L' A B Cs child) {xs : List R}
    (_hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    levelH C N P L' A B Cs child xs =
      pull (P :: W * L' :: hdShape A B Cs m N) (P :: W * L' :: hdShape A B Cs m N)
        (blockSwap (A.length + 2) (A.length + B.length + m + 2) m) 0 xs := by
  simp only [levelH]
  set Λ0 := hdLayout A B Cs m N
  set sh := P :: L' :: hdShape A B Cs m N
  have hins : ∀ w, (rowSplit P W L' (hdShape A B Cs m N) w 0 xs).length = vol sh :=
    fun w => length_rowSplit _ _ _ _ _ _ _
  have hinit : ∀ w, (QHNet.initH (T := T) (vol sh)
      (fun w' => rowSplit P W L' (hdShape A B Cs m N) w' 0 xs) w).length = vol sh := by
    intro w; cases w with
    | inl w => exact hins w
    | inr t => simp [QHNet.initH]
  have key : ∀ w, netRunH (vol sh) (realEdge (Λ0.cons2 P L') child) C.prog
      (QHNet.initH (T := T) (vol sh)
        (fun w' => rowSplit P W L' (hdShape A B Cs m N) w' 0 xs)) (.inl (C.ρ w)) =
      rowSplit P W L' (hdShape A B Cs m N) w 0
        (pull (P :: W * L' :: hdShape A B Cs m N) (P :: W * L' :: hdShape A B Cs m N)
          (rowLift (amap Λ0 swapMat)) 0 xs) := by
    intro w
    have hcg := (netRunH_congr (vol sh) (fun e => runArr (Λ0.cons2 P L') 0 (e.steps N))
      (realEdge (Λ0.cons2 P L') child) (fun e ys hys => length_runArr _ 0 _ hys) C.prog
      (fun e he ys hys => (realEdge_stream N P L' A B Cs hch e (hOK.runs e he) hys).symm)
      _ hinit).1
    rw [← hcg]
    have hid := hOK.ideal sh (Λ0.cons2 P L') _ hins w
    simp only [QHNet.idealOut] at hid
    rw [hid, rowSplit_pull_rowLift _ _ _ _ _ _ (fun x hx => valid_amap Λ0 _ hx)]
    exact pull_congr (fun a ha => (rowLift_amap Λ0 _ ha).symm) _ _
  refine (congrArg (rowMerge P W L' (hdShape A B Cs m N) 0) (funext key)).trans ?_
  rw [rowMerge_rowSplit P W L' _ 0 (by simp)]
  exact pull_congr (fun a ha => by
    rw [rowLift_amap Λ0 _ ha]
    exact amap_swapMat_eq_blockSwap _ (stream_pos_H N P A B Cs (W * L'))
      (stream_pos_D N P A B Cs (W * L')) (by omega) ha) _ _

end Level

end IntMul.Kappa.R6.Bit

end

theorem solution.{u_1} : type_of% @IntMul.Kappa.R6.Bit.levelH_correct_sol_aux.{u_1} := @IntMul.Kappa.R6.Bit.levelH_correct_sol_aux.{u_1}
