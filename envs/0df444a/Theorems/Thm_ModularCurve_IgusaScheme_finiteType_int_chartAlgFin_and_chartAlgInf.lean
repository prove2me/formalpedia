theorem ModularCurve.IgusaScheme.finiteType_int_chartAlgFin_and_chartAlgInf (N : ℕ) [NeZero N] :
    Algebra.FiniteType ℤ
        ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ ↥(modularFunctionFieldFull N) (jFull N)) ∧
      Algebra.FiniteType ℤ
        ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgInf ℤ ↥(modularFunctionFieldFull N) (jFull N)) := by sorry
