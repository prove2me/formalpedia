      Fintype.card (sourceSATTableType source) =
        1 + physicalFormulaTupleCount formula := by
    change Fintype.card
      (sourceSATTableType (srcFormula formula)) = _
    rw [sourceTableType_card,
      ← sourceClauseWeightSum_eq_localTagCount formula]
