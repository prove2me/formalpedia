theorem N25.Endgame.ternary_place_degree_sums25 :
    ∀ n : Fin 4,
      (∑ d ∈ Nat.divisors (n.val + 1), d *
        Nat.card {v : AlgebraicCurve.Place (ZMod 3) F₃25 | v.deg = d}) =
          (![5, 5, 20, 89] : Fin 4 → ℕ) n := by sorry
