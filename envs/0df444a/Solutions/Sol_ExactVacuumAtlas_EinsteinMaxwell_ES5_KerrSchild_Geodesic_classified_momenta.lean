variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) {y : Pt 5} (hy : y ∈ esDomain I)
    (hf : 0 < f (y 1)) (hm : 0 < m (y 1)) (hN : 0 < N (y 1))
    (ha2 : 0 < alphaSq f m N w p a (y 1))
    (hEin : ∀ i j, einsteinMaxwellD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) i j y = 0)
    {v : Fin 5 → ℝ} (hv0 : v ≠ 0)
    (hnull : contract2 (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y v = 0)
    (hric : contract2 (ricciOf (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)) y v = 0) :
    f (y 1) * v 0 / eFun w p a (y 1) ≠ 0 ∧ v 1 ≠ 0 ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 0 =
        -(f (y 1) * v 0 / eFun w p a (y 1) * deriv p (y 1)) ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 3 =
        -(f (y 1) * v 0 / eFun w p a (y 1) * (y 2 * deriv a (y 1))) ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 4 =
        -(f (y 1) * v 0 / eFun w p a (y 1) * ((1 - y 2) * deriv a (y 1))) := by
  obtain ⟨t, ht, hk⟩ :=
    ((vii06_ricci_null_directions hP hy hf hm hN ha2 hEin).2.2.2 v).mp ⟨hv0, hnull, hric⟩
  have he := eFun_ne_zero_of_alphaSq_pos hf ha2
  have hs : Real.sqrt (alphaSq f m N w p a (y 1)) ≠ 0 := (Real.sqrt_pos.mpr ha2).ne'
  rcases hk with hk | hk
  · obtain ⟨h1, h2, h3, h4, h5⟩ := multiple_principal_facts
      (lam := Real.sqrt (alphaSq f m N w p a (y 1))) hf.ne' hm.ne' hN.ne' he ht hs hk
    exact ⟨h1 ▸ ht, h2, h1 ▸ h3, h1 ▸ h4, h1 ▸ h5⟩
  · obtain ⟨h1, h2, h3, h4, h5⟩ := multiple_principal_facts
      (lam := -Real.sqrt (alphaSq f m N w p a (y 1))) hf.ne' hm.ne' hN.ne' he ht
      (neg_ne_zero.mpr hs) hk
    exact ⟨h1 ▸ ht, h2, h1 ▸ h3, h1 ▸ h4, h1 ▸ h5⟩
