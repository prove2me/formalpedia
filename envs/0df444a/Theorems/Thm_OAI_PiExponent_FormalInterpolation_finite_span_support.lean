-- title:
--   Finite support for a generated ideal in a Noetherian ring
-- statement:
--   In a Noetherian commutative ring, the ideal generated by any family is already generated by some finite indexed subfamily.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.RingTheory.Polynomial.Basic

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_span_support
    {R α : Type} [CommRing R] [IsNoetherianRing R]
    (F : α → R) :
    ∃ m : Nat, ∃ idx : Fin m → α,
      Ideal.span (Set.range (fun j : Fin m => F (idx j))) =
        Ideal.span (Set.range F) := by sorry
