/-- **One line on the geometry**, register-driven. -/
theorem rotU_geo {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (l : Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zV : zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = g.V) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R)
    {eP eQ eB ed0 ed1 er ef eK : Ex HS}
    (hsz : ((rotPl eP eQ eB ed0 ed1 er ef eK).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eQ) (n3 : NoLow eB) (n4 : NoLow ed0) (n5 : NoLow ed1)
    (n6 : NoLow er) (n7 : NoLow ef) (n8 : NoLow eK)
    (E1 : ESp eP t Bb ((g.N0 * g.Q * g.N1 * g.Q * g.N2 : ℕ) : ℤ))
    (E2 : ESp eQ t Bb ((g.Q : ℕ) : ℤ)) (E3 : ESp eB t Bb ((g.S2 : ℕ) : ℤ))
    (E4 : ESp ed0 t Bb ((g.N2 * g.Q * g.N1 : ℕ) : ℤ)) (E5 : ESp ed1 t Bb ((g.N2 : ℕ) : ℤ))
    (E6 : ESp er t Bb ((2 : ℤ) ^ ρ)) (E7 : ESp ef t Bb ((f - 1 : ℕ) : ℤ))
    (E8 : ESp eK t Bb ((2 : ℤ) ^ K)) :
    IRuns I iprog (rotU l.sgn l.b eP eQ eB ed0 ed1 er ef eK) t
      (t.upd 0 (ints (rixT g (rot2 g.Q (amt K ρ f l)) xs) ++ R))
      (NLogN.KFX.cRotU K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 w Bb) := by
  have hV : g.V = g.N0 * g.Q * g.N1 * g.Q * g.N2 * g.Q * g.S2 := by
    simp only [Geo.V, Geo.S0, Geo.S1]; ring
  have le : ∀ a : ℕ, 0 < a → a ∣ g.V → zsz (a : ℤ) ≤ Bb := fun a ha hd =>
    le_trans (NLogN.KIL.zsz_nat_le (Nat.le_of_dvd (by have := hg.v; omega) hd)) zV
  rw [hQe] at E2 ⊢
  have H := rotU_runs (I := I) (iprog := iprog) hK hρK hf
    (Nat.mul_pos (Nat.mul_pos hg.n2 hg.q) hg.n1) hg.n2 l hs hb hB2 hbig
    (le _ (Nat.mul_pos (Nat.mul_pos hg.n2 hg.q) hg.n1) ⟨g.N0 * g.Q * g.Q * g.S2, by rw [hV]; ring⟩)
    (le _ hg.n2 ⟨g.N0 * g.Q * g.N1 * g.Q * g.Q * g.S2, by rw [hV]; ring⟩)
    (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.S2 w
    (le _ (by have := hg.n0; have := hg.q; have := hg.n1; have := hg.n2; positivity)
      ⟨g.Q * g.S2, by rw [hV]; ring⟩)
    t xs R (by rw [hlen, hV, hQe]) hbw h0 hsz n1 n2 n3 n4 n5 n6 n7 n8 E1 E2 E3 E4 E5 E6 E7 E8
  rw [← hQe] at H
  have e := pull_rot g hg (amt K ρ f l) (tabA K ρ f (g.N2 * g.Q * g.N1) g.N2 g.Q l)
    (fun p => by simp only [tabA]) xs
  rw [e] at H
  rw [← hQe]
  exact H

theorem xorGenU_sub (d Q j P : ℕ) :
    RS.sub (σX P d Q (2 ^ j)) xorGenU = xorGen d Q j P := by
  simp only [xorGenU, xorBodyU, bEU, RS.sub, Ex.sub]
  rfl

theorem fok_xorGenU : fok xorGenU = true := by
  simp +decide [xorGenU, xorBodyU, bEU, fok, touch, Ex.regs, NLogN.KFD.scr]

theorem σX_none (P d Q r2 : ℤ) {i : Fin HS} (h : 7 ≤ i.val) : σX P d Q r2 i = none := by
  simp only [σX]
  split_ifs <;> subst_vars <;> first | rfl | (exfalso; revert h; decide)

theorem noW_xorGenU (P d Q r2 : ℤ) : NoW (σX P d Q r2) xorGenU := by
  intro i hi
  have : ∀ j ∈ xorGenU.writes, 7 ≤ j.val := by decide
  exact σX_none _ _ _ _ (this i hi)

theorem sclean_σX (P d Q r2 : ℤ) : SClean (σX P d Q r2) := by
  intro i hi
  have : i.val ≤ 6 := by
    by_contra hc
    rw [σX_none P d Q r2 (by omega)] at hi
    simp at hi
  exact notMem_zX (by omega)

theorem xorU_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {d Q j : ℕ} (hd : 0 < d) (hQ : 0 < Q) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (zd : zsz (d : ℤ) ≤ Bb) (zQ : zsz (Q : ℤ) ≤ Bb) (zr : zsz ((2 : ℤ) ^ j) ≤ Bb)
    (P B w : ℕ) (zP : zsz (P : ℤ) ≤ Bb)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = P * 2 * B) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R) {eP eB ed eQ ej : Ex HS}
    (hsz : ((xorPl eP eB ed eQ ej).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eB) (n3 : NoLow ed) (n4 : NoLow eQ) (n5 : NoLow ej)
    (E1 : ESp eP t Bb (P : ℤ)) (E2 : ESp eB t Bb (B : ℤ)) (E3 : ESp ed t Bb (d : ℤ))
    (E4 : ESp eQ t Bb (Q : ℤ)) (E5 : ESp ej t Bb ((2 : ℤ) ^ j)) :
    IRuns I iprog (xorU eP eB ed eQ ej) t
      (t.upd 0 (ints (pull [P, 2, B] [P, 2, B] (KIL.rotAddr 2 (xorA d Q j)) 0 xs) ++ R))
      (cXorU P B w Bb) := by
  have z2 : zsz (2 : ℤ) ≤ Bb := NLogN.KFL.zsz_nat_lt (a := 2) (by
    have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB2
    omega)
  set pl := xorPl eP eB ed eQ ej
  have hE : ∀ p ∈ pl, ∃ v, ESp p.2 t Bb v := by
    intro p hp
    simp only [pl, xorPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, E1⟩, ⟨_, ESp.lit z2⟩, ⟨_, E2⟩, ⟨_, E3⟩, ⟨_, E4⟩, ⟨_, E5⟩]
  have hl : NLogN.KIL.PushOK t Bb pl := by
    refine pushOK_of (by
      intro p hp; simp only [pl, xorPl, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)) ?_ hE
    intro p hp r hr hm
    simp only [pl, xorPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    simp only [pl, xorPl, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
      or_false] at hm
    have : 13 ≤ r.val := by
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl
      · exact n1 r hr
      · simp [Ex.regs] at hr
      · exact n2 r hr
      · exact n3 r hr
      · exact n4 r hr
      · exact n5 r hr
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl <;> revert this <;> decide
  have ev : evalP t pl = [(1, (P : ℤ)), (2, ((2 : ℕ) : ℤ)), (4, (B : ℤ)), (3, (d : ℤ)),
      (5, (Q : ℤ)), (6, (2 : ℤ) ^ j)] := by
    simp only [evalP, pl, xorPl, List.map_cons, List.map_nil, E1.ev, E2.ev, E3.ev, E4.ev, E5.ev,
      Ex.eval]; rfl
  have hnd : (pl.map Prod.fst).Nodup := by simp only [pl, xorPl, List.map_cons, List.map_nil]; decide
  set u := pushSt t (evalP t pl)
  have TG := xorGen_fsp hd hQ hB2 zd zQ zr P zP u (fun _ => []) rfl
  rw [encK_nil, ← encK_upd, encK_nil] at TG
  simp only [List.append_nil] at TG
  set σ := σX P d Q (2 ^ j)
  have hag : Agree σ u := by
    refine agree_pushSt t _ (by rw [evalP_fst]; exact hnd) (fun i v hv => ?_)
    rw [ev]
    simp only [σ, σX] at hv
    split_ifs at hv <;> subst_vars <;> cases hv <;> simp
  have hO : HRef (xorGen d Q j P) (RS.sub σ xorGenU) 0 := by
    rw [xorGenU_sub]; exact HRef.refl _
  have TU := FSp.uni (sclean_σX _ _ _ _) (noW_xorGenU _ _ _ _) hO hag TG
  have has : ∀ p, xorA d Q j p ≤ 2 := fun p => by
    have := Nat.mod_lt (p / d % Q / 2 ^ j) (by norm_num : 0 < 2); simp only [xorA]; omega
  have W := tabRot_runs (I := I) (iprog := iprog) (pl := pl) fok_xorGenU t Bb hl
    (pushVals_le hE) (by simp only [pl, xorPl, List.map_cons, List.map_nil]; decide) (by simp only [pl, xorPl, List.map_cons, List.map_nil]; decide) hnd
    (P := P) (Q := 2) (B := B) (w := w) (by rw [ev]; simp) (by rw [ev]; simp) (by rw [ev]; simp)
    (xorA d Q j) has TU xs R hlen hbw h0
  refine W.mono ?_
  have hpc := pushCost_le_size Bb pl 100 hsz
  have hl6 : pl.length = 6 := rfl
  rw [hl6]
  simp only [cXorU]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  omega

/-- **The last-bit step on the geometry**, register-driven (`j = ρ + (f-1)K`, `E = 2^{fK-j-1}`). -/
theorem xorU_geo {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (zV : zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = g.V) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R) {eP eB ed eQ ej : Ex HS}
    (hsz : ((xorPl eP eB ed eQ ej).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eB) (n3 : NoLow ed) (n4 : NoLow eQ) (n5 : NoLow ej)
    (E1 : ESp eP t Bb ((g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ))
    (E2 : ESp eB t Bb ((2 ^ (ρ + (f - 1) * K) * g.S1 : ℕ) : ℤ))
    (E3 : ESp ed t Bb ((g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ))
    (E4 : ESp eQ t Bb ((g.Q : ℕ) : ℤ)) (E5 : ESp ej t Bb ((2 : ℤ) ^ (ρ + (f - 1) * K))) :
    IRuns I iprog (xorU eP eB ed eQ ej) t
      (t.upd 0 (ints (rixT g (XLc K ρ f) xs) ++ R))
      (cXorU (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)
        w Bb) := by
  set j := ρ + (f - 1) * K
  set E := 2 ^ (f * K - j - 1)
  set D := 2 ^ j
  have hjK : j + 1 ≤ f * K := by
    have : (f - 1) * K + K = f * K := by
      have : f = (f - 1) + 1 := by omega
      conv_rhs => rw [this]
      ring
    omega
  have hQ : g.Q = 2 * D * E := by
    rw [hQe]; simp only [D, E]; rw [← pow_succ', ← pow_add]; congr 1; omega
  have hD : 0 < D := by positivity
  have hE : 0 < E := by positivity
  have hV : g.V = g.N0 * g.Q * g.N1 * E * 2 * (D * g.S1) := by
    simp only [Geo.V, Geo.S0]; rw [hQ]; ring
  have hV0 := hg.v
  have le : ∀ a : ℕ, a ∣ g.V → zsz (a : ℤ) ≤ Bb := fun a hd =>
    le_trans (NLogN.KIL.zsz_nat_le (Nat.le_of_dvd (by omega) hd)) zV
  have H := xorU_runs (I := I) (iprog := iprog) (j := j) (Nat.mul_pos hg.n1 hE) hg.q hB2
    (le _ ⟨g.N0 * g.Q * 2 * (D * g.S1), by rw [hV]; ring⟩)
    (le _ ⟨g.S0 * g.N0, by simp only [Geo.V]; ring⟩)
    (by have := le D ⟨g.N0 * g.Q * g.N1 * E * 2 * g.S1, by rw [hV]; ring⟩; simpa [D] using this)
    (g.N0 * g.Q * g.N1 * E) (D * g.S1) w (le _ ⟨2 * (D * g.S1), by rw [hV]; ring⟩)
    t xs R (by rw [hlen, hV]) hbw h0 hsz n1 n2 n3 n4 n5 E1 E2 E3 E4 E5
  have e := pull_bit g hg hQ hD hE (fun x => gc 2 D x) (xorA (g.N1 * E) g.Q j)
    (fun p => by simp [xorA, gc, D]) xs
  rw [e] at H
  exact H

end NLogN.KFX

