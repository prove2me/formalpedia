theorem xor_two_pow_sc (y j : ℕ) : y ^^^ 2 ^ j = NLogN.KFL.sc 2 (2 ^ j) (1 - y / 2 ^ j % 2) y := by
  apply Nat.eq_of_testBit_eq; intro i
