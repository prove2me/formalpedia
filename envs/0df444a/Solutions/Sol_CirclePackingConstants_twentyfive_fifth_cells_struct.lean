/-- Staircase bound: the horizontal offset of a vertical edge is bounded by four
horizontal compressions (telescoping each row to a wall). -/
lemma stairV (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5) (K : ℝ)
