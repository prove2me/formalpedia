theorem NLogN.KFM.chirp_err (p : ℕ) {MC MCt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} (hMC : BilC MC) (Ec : ℝ)
    (hMCt : ∀ f g, Grid p f → Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 7 / 10 →
      ‖MCt f g - MC f g‖ ≤ Ec * hp p ∧ ‖MCt f g‖ ≤ 1)
    {a at' b bt : ι → ℂ} (ha : Phases p a at') (hb' : Phases p b bt) (hbg : Grid p bt)
    {x : ι → ℂ} (hx : ‖x‖ ≤ 6 / 10) :
    ‖chirpT p MCt bt at' x - a * MC b (a * x)‖ ≤ (Ec + 10) * hp p ∧
      ‖chirpT p MCt bt at' x‖ ≤ 1 := by sorry
