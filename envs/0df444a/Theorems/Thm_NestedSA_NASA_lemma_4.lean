-- title:
--   Lemma 4 — the merit function W decreases along NASA up to the remainders r^{k+1}
-- statement:
--   Let $f,g$ satisfy Assumption 2, let $X$ be closed and convex with $F=f\circ g$ bounded below on $X$, and let $x^k,z^k,u^k$ be generated by Algorithm 1 with constant $\beta_k\equiv\beta>0$ from arbitrary oracle outputs $G^{k+1},s^{k+1},J^{k+1}$ (no probability is involved). Let $c,\gamma>0$ satisfy (3.16),
--   $$2(a\beta-c)(\gamma b-2c)\ge L_g^2(aL_{\nabla f}+\gamma)^2,\qquad a\beta-c\ge0,\quad \gamma b-2c\ge0,$$
--   and let $\tau_k\le1$ and $b\tau_k\le1$ for all $k$. With $d^k=y^k-x^k$ and the remainder $r^{k+1}$ of (3.18) (with the factor $\gamma$ on the noise term, see below), for every $N\ge1$
--   $$c\sum_{k=0}^{N-1}\tau_k\big(\|d^k\|^2+\|g(x^k)-u^k\|^2\big)\le W(x^0,z^0,u^0)+\sum_{k=0}^{N-1}r^{k+1}.$$
--
--   This is the deterministic core of the analysis: the merit function $W$ decreases by a multiple of the step and tracking errors, up to second-order and martingale-type remainders whose expectations Proposition 1 bounds.
--
--   **Formalization Note** The paper prints $b^2\|g(x^{k+1})-G^{k+1}\|^2$ in $r^{k+1}$; its proof establishes $\gamma b^2\|g(x^{k+1})-G^{k+1}\|^2$, and the printed version is false (with $f\equiv g\equiv0$, $z^0=0$, $u^0=0$, $s^{k}\equiv0$, $\gamma=2$, $c=1$, $a=b=\beta=1$, $N=2$, $\tau_1=1$, $G^1\ne0$, $G^2=0$ the left side is twice the printed right side). The hypotheses $\tau_k\le1$ (so that $x^k\in X$), $b\tau_k\le1$, and the nonnegativity of both factors in (3.16) are used by the proof but not printed in the lemma.
-- source:
--   Ghadimi, Ruszczyński, Wang, A Single Time-Scale Stochastic Approximation Method for Nested Stochastic Optimization, arXiv:1812.01094v2, p. 10, Lemma 4, (3.16)–(3.18)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_NestedSA_NASA_Basic
import Definitions.Def_NestedSA_NASA_Model

namespace NestedSA.NASA

/-- Lemma 4, (3.17) (p. 10), pathwise and with the corrected remainder `r^{k+1}` (`rTerm`, factor `γb²` on the
noise term). Let `x, z, u` be generated by Algorithm 1 from any oracle outputs `G, s, J`, with constant `β_k ≡ β`,
under Assumption 2, with `F = f ∘ g` bounded below on `X` and `F* = inf_X F`. If `c, γ > 0` satisfy (3.16)
`2(aβ − c)(γb − 2c) ≥ L_g²(aL_∇f + γ)²` with both factors nonnegative, and `τ_k ≤ 1`, `bτ_k ≤ 1` for all `k`, then
for every `N ≥ 1`, `c Σ_{k<N} τ_k(‖d^k‖² + ‖g(x^k) − u^k‖²) ≤ W(x⁰, z⁰, u⁰) + Σ_{k<N} r^{k+1}`. -/
theorem lemma_4 {n m : ℕ} (X : Set (EuclideanSpace ℝ (Fin n))) (hX_cl : IsClosed X) (hX_cvx : Convex ℝ X)
    (P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hP : SpectralProjGrad.Shared.IsProjOnto X P)
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (Lf Lg Ldf Ldg : ℝ) (hA2 : Assumption2 f g Lf Lg Ldf Ldg)
    (hF_bdd : BddBelow ((fun x => f (g x)) '' X))
    (a b β : ℝ) (τ : ℕ → ℝ) (x0 z0 : EuclideanSpace ℝ (Fin n)) (u0 : EuclideanSpace ℝ (Fin m))
    (x z : ℕ → EuclideanSpace ℝ (Fin n)) (u G s : ℕ → EuclideanSpace ℝ (Fin m))
    (J : ℕ → (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)))
    (hrun : IsRun X P a b β τ x0 z0 u0 x z u G s J)
    (c γ : ℝ) (hc : 0 < c) (hγ : 0 < γ) (hcβ : c ≤ a * β) (hcγ : 2 * c ≤ γ * b)
    (h316 : Lg ^ 2 * (a * Ldf + γ) ^ 2 ≤ 2 * (a * β - c) * (γ * b - 2 * c))
    (hτ_one : ∀ k, τ k ≤ 1) (hbτ : ∀ k, b * τ k ≤ 1) :
    ∀ N : ℕ, 1 ≤ N →
      c * ∑ k ∈ Finset.range N, τ k * (‖ybar P (x k) (z k) β - x k‖ ^ 2 + ‖g (x k) - u k‖ ^ 2) ≤
        W P f g X a γ β x0 z0 u0 +
          ∑ k ∈ Finset.range N, rTerm P f g a b γ β Lf Lg Ldf Ldg τ x z u G s J k := by sorry

end NestedSA.NASA
