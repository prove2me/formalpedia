-- title:
--   Theorem 6 — the nonquadratic method of multipliers (9) finds an optimal multiplier, and limit points of $x^k$ solve (7)
-- statement:
--   Consider the convex program
--   $$\text{minimize } f(x)\quad\text{such that}\quad Ax = b,\ x \in X, \tag{7}$$
--   where $f : \mathbb R^n \to (-\infty,+\infty]$ is lower semicontinuous and convex, $A$ is an $m\times n$ matrix, $b\in\mathbb R^m$, $X\subseteq\mathbb R^n$ is closed and convex, and $\inf\{f(x)\mid x\in X\} < \infty$. Its dual functional is
--   $$d(p) = \inf_{x\in X}\bigl\{ f(x) + \langle p, Ax - b\rangle \bigr\},$$
--   assumed not identically $-\infty$; an optimal (Lagrange) multiplier is a maximizer of $d$ over $\mathbb R^m$.
--
--   Let $h$ be a Bregman function with zone $\mathbb R^m$ and $\operatorname{im}(\nabla h) = \mathbb R^m$, let $h^*$ be its convex conjugate, and let $\{c_k\}_{k\ge0}$ be positive scalars with positive infimum. Let $\{(x^k,p^k)\}_{k\ge0} \subseteq \mathbb R^n\times\mathbb R^m$ conform to the recursion
--   $$x^{k+1} \in \operatorname*{arg\,min}_{x\in X}\Bigl\{ f(x) + \tfrac{1}{c_k} h^*\bigl(\nabla h(p^k) + c_k(Ax - b)\bigr)\Bigr\},\qquad p^{k+1} = \nabla h^*\bigl(\nabla h(p^k) + c_k(Ax^{k+1} - b)\bigr). \tag{9}$$
--   Then:
--
--   1. if an optimal multiplier exists, $\{p^k\}$ converges to an optimal multiplier, and every limit point of $\{x^k\}$ solves (7);
--   2. if no optimal multiplier exists, $\{p^k\}$ is unbounded.
--
--   With $h(p) = \frac12\|p\|^2$, (9) is the classical (quadratic) method of multipliers; the theorem covers the whole family of nonquadratic penalties generated by Bregman functions with zone $\mathbb R^m$ and surjective gradient.
--
--   **Formalization Note** $A$ is a continuous linear map between `EuclideanSpace ℝ (Fin n)` and `EuclideanSpace ℝ (Fin m)`. "Zone $\mathbb R^m$" is the Bregman structure with $S$ the whole space; $\operatorname{im}\nabla h = \mathbb R^m$ is surjectivity of $\nabla h$. Recursion (9) uses the real value of $h^*$, which is finite everywhere under $\operatorname{im}\nabla h = \mathbb R^m$; the arg min is a minimality predicate. "Limit point" is a subsequential limit; "unbounded" is "the range of $k \mapsto p^k$ is not bounded". This statement is the first two sentences of the conclusion of Theorem 6; the third (existence of infinite sequences) is the separate item `theorem6_existence`.
-- source:
--   Eckstein, Nonlinear proximal point algorithms using Bregman functions, with applications to convex programming, Math. Oper. Res. 18(1) (1993), pp. 212–213, Theorem 6 (first two sentences of the conclusion)

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_fenchelConjugate
import Definitions.Def_BregmanPPA_Convergence_Model
import Definitions.Def_BregmanPPA_EqMult_EqConstrainedProgram

open InertialFB.IFB ConvexOptimization Filter Topology

namespace BregmanPPA.EqMult
theorem theorem6 {n m : ℕ}
    (A : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m))
    (b : EuclideanSpace ℝ (Fin m)) (X : Set (EuclideanSpace ℝ (Fin n)))
    (f : EuclideanSpace ℝ (Fin n) → EReal)
    (hP : IsEqProgram X f) (hd : ∃ p, dualEq A b X f p ≠ ⊥)
    (h : EuclideanSpace ℝ (Fin m) → ℝ) (hh : BregmanPPA.Convergence.IsBregmanFunction Set.univ h)
    (him : Function.Surjective (gradient h))
    (c : ℕ → ℝ) (hc : ∀ k, 0 < c k) (hcinf : ∃ ε > 0, ∀ k, ε ≤ c k)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (p : ℕ → EuclideanSpace ℝ (Fin m))
    (hrun : IsEqMultRun A b X f h c x p) :
    ((∃ q, IsOptimalMultiplier A b X f q) →
      (∃ pstar, IsOptimalMultiplier A b X f pstar ∧ Tendsto p atTop (𝓝 pstar)) ∧
      ∀ (φ : ℕ → ℕ) (x' : EuclideanSpace ℝ (Fin n)), StrictMono φ →
        Tendsto (x ∘ φ) atTop (𝓝 x') → IsSolution7 A b X f x') ∧
    ((¬ ∃ q, IsOptimalMultiplier A b X f q) → ¬ Bornology.IsBounded (Set.range p)) := by sorry
end BregmanPPA.EqMult
