    calc
      ‖R‖ = ‖(R + E) - E‖ := by congr 1 <;> abel
      _ ≤ ‖R + E‖ + ‖E‖ := norm_sub_le _ _
  have hsplit : (1 : ℝ) / q = 2 * ((1 : ℝ) / (2 * q)) := by
    field_simp
  rw [hphase]
  linarith
end TaoFivePrimes
