/-- On `[0, s)` the list form reads `B0P` (the periodic version used by `lemma19_fp`). -/
theorem b0L_eq_B0P (p s t α : ℕ) (V : List (ℤ × ℤ)) :
    b0L p s t α V = (List.range s).map (B0P p s t α fun j => V.getD j (0, 0)) := by
  unfold b0L B0P
  apply List.map_congr_left
  intro l hl
  rw [List.mem_range] at hl
  rw [Nat.mod_eq_of_lt hl]

