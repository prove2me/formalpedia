/-!
# The linear complexity hierarchy and its saturation at `n = 2L`

Two facts about the family `lfsrWords K L n` of length-`n` files generated by an
order-`L` LFSR, both first observed numerically (see `ComputationalEvidence.md`)
and proved here.

* **Nesting.** `lfsrWords_subset_succ`: an order-`L` file is also an
  order-`(L+1)` file (pad the taps with a leading zero).  Hence
  `lowComplexityWords_eq_lfsrWords`: the union over all orders `≤ M` is just the
  order-`M` family — the classifier hierarchy is a genuine filtration, and the
  quantitative bound `q^{2M+1}` of `PRNGLinearComplexity` can be sharpened to the
  single-order bound `q^{2M}`.

* **Saturation.** `card_lfsrWords_saturate`: for `n ≥ 2L` the number of
  order-`L` files of length `n` does not depend on `n`.  Longer observation
  windows reveal no new order-`L` files: `2L` symbols already separate them all.
  This is the counting shadow of the `2L` determination theorem.
-/

open Catalog.Probability.SeedRec

variable {K : Type*} [CommRing K] {L m n : ℕ}



theorem restrictWord_pref {S α : Type*} (g : PRNG S α) (h : m ≤ n) (s : S) :
    restrictWord h (g.pref n s) = g.pref m s := by
  funext i
  rfl

variable (K) [Fintype K] [DecidableEq K]






variable [Nontrivial K] (L n : ℕ) [NeZero L]










open Catalog.Probability.SeedRec in
theorem solution(h : L ≤ n) :
    Fintype.card K ^ L ≤ (lfsrWords K L n).card := by
  classical
  have hinj : Function.Injective fun σ : Fin L → K => (lfsrPRNG (0 : Fin L → K)).pref n σ := by
    intro σ σ' hσ
    have : restrictWord h ((lfsrPRNG (0 : Fin L → K)).pref n σ)
        = restrictWord h ((lfsrPRNG (0 : Fin L → K)).pref n σ') :=
      congrArg (restrictWord h) hσ
    rw [restrictWord_pref, restrictWord_pref] at this
    exact lfsr_pref_injective (0 : Fin L → K) this
  have hsub : (Finset.univ.image fun σ : Fin L → K => (lfsrPRNG (0 : Fin L → K)).pref n σ)
      ⊆ lfsrWords K L n := by
    intro x hx
    simp only [Finset.mem_image] at hx
    obtain ⟨σ, -, rfl⟩ := hx
    rw [mem_lfsrWords]
    exact ⟨0, σ, rfl⟩
  have hcard := Finset.card_le_card hsub
  rwa [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fun,
    Fintype.card_fin] at hcard
