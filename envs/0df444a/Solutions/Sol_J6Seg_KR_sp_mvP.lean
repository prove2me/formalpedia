variable {s : IState HS}

theorem sp_pushR (f : Fin HS → List ℤ) {i j : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hi : i.val < 56) (hj : j.val < 56) (hf : f j = a :: l) (ha : zsz a ≤ B) :
    Sp (.push i (.reg j)) (encK s f) (encK s (Function.update f i (a :: f i))) (4000 * (B + 2)) := by
  have h := Sp.push s f (i := i) (e := .reg j) (B := B) hi (clean_reg hj) (ok_reg hf) trivial
    (bnd_reg hf ha)
  rw [eval_reg hf] at h
  exact h.mono (by simp only [Ex.size]; omega)

theorem sp_pop (f : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hi : i.val < 56) (hf : f i = a :: l) (ha : zsz a ≤ B) :
    Sp (.pop i) (encK s f) (encK s (Function.update f i l)) (2 * B + 2) := Sp.pop s f hi hf ha

end steps

/-! ## Moving pairs -/

theorem sp_mvP_sol_aux {X Y T C R : Fin HS} (hXY : X ≠ Y) (hXT : X ≠ T) (hXC : X ≠ C) (hYT : Y ≠ T)
    (hYC : Y ≠ C) (hTC : T ≠ C) (hRX : R ≠ X) (hRY : R ≠ Y) (hRT : R ≠ T) (hRC : R ≠ C)
    (hX5 : X.val < 56) (hY5 : Y.val < 56) (hT5 : T.val < 56) (hC5 : C.val < 56)
    (hR5 : R.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (z : List GI) (lx lr : List ℤ)
    (hX : f X = gflat z ++ lx) (hT : f T = []) (hC : f C = [])
    (hR : f R = (z.length : ℤ) :: lr) (B : ℕ) (hz : GB B z) (hn : zsz (z.length : ℤ) ≤ B) :
    Sp (mvP X Y T C R) (encK s f)
      (encK s (Function.update (Function.update f X lx) Y (gflat z.reverse ++ f Y)))
      (cMvP z.length B) := by
  set N := z.length with hN
  let F : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update f X (gflat (z.drop k) ++ lx)) Y (gflat (z.take k).reverse ++ f Y)
  have hF0 : F 0 = f := by
    funext j; simp only [F, Function.update_apply, List.drop_zero, List.take_zero, List.reverse_nil,
      gflat_nil, List.nil_append]
    split_ifs with h1 h2 <;> (try subst h1) <;> (try subst h2) <;> simp_all
  have hFN : F N = Function.update (Function.update f X lx) Y (gflat z.reverse ++ f Y) := by
    simp only [F, hN, List.drop_length, List.take_length, gflat_nil, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by
    simp only [F, Function.update_apply, if_neg hYC.symm, if_neg hXC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (mvPB X Y T) (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (30000 * (B + 2)) := by
    intro k hk
    have hd : z.drop k = z[k] :: z.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : z.take (k + 1) = z.take k ++ [z[k]] := (List.take_concat_get' z k hk).symm
    have hb := hz _ (List.getElem_mem hk)
    set G := Function.update (F k) C [(N : ℤ) - k] with hG
    have gX : G X = z[k].1 :: z[k].2 :: (gflat (z.drop (k + 1)) ++ lx) := by
      simp only [hG, F, Function.update_apply, if_neg hXC, if_neg hXY, if_true, hd, gflat_cons,
        List.cons_append]
    have gT : G T = [] := by
      simp only [hG, F, Function.update_apply, if_neg hTC, if_neg hYT.symm, if_neg hXT.symm, hT]
    have s1 := sp_pushR (s := s) G (i := T) hT5 hX5 gX hb.1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G T (z[k].1 :: G T) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have s2 := sp_pop (s := s) G1 (i := X) hX5 (by rw [hG1, Function.update_apply, if_neg hXT, gX]) hb.1
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 X (z[k].2 :: (gflat (z.drop (k + 1)) ++ lx)) := ⟨_, rfl⟩
    rw [← hG2] at s2
    have s3 := sp_pushR (s := s) G2 (i := Y) hY5 hX5 (by rw [hG2, Function.update_apply, if_pos rfl]) hb.2
    obtain ⟨G3, hG3⟩ : ∃ G3, G3 = Function.update G2 Y (z[k].2 :: G2 Y) := ⟨_, rfl⟩
    rw [← hG3] at s3
    have s4 := sp_pop (s := s) G3 (i := X) hX5
      (by rw [hG3, Function.update_apply, if_neg hXY, hG2, Function.update_apply, if_pos rfl]) hb.2
    obtain ⟨G4, hG4⟩ : ∃ G4, G4 = Function.update G3 X (gflat (z.drop (k + 1)) ++ lx) := ⟨_, rfl⟩
    rw [← hG4] at s4
    have s5 := sp_pushR (s := s) G4 (i := Y) (j := T) (l := []) hY5 hT5
      (by simp only [hG4, hG3, hG2, hG1, Function.update_apply, if_neg hXT.symm, if_neg hYT.symm,
        if_true, gT]) hb.1
    obtain ⟨G5, hG5⟩ : ∃ G5, G5 = Function.update G4 Y (z[k].1 :: G4 Y) := ⟨_, rfl⟩
    rw [← hG5] at s5
    have s6 := sp_pop (s := s) G5 (i := T) (l := []) hT5
      (by simp only [hG5, hG4, hG3, hG2, hG1, Function.update_apply, if_neg hXT.symm,
        if_neg hYT.symm, if_true, gT]) hb.1
    refine ((s1.seq (s2.seq (s3.seq (s4.seq (s5.seq s6))))).congr ?_).mono (by omega)
    congr 1
    funext j
    simp only [hG5, hG4, hG3, hG2, hG1, hG, F, Function.update_apply]
    by_cases h1 : j = T
    · subst h1; simp [hXT.symm, hYT.symm, hTC, hT]
    by_cases h2 : j = X
    · subst h2; simp [hXT, hXY, hXC]
    by_cases h3 : j = Y
    · subst h3
      simp only [hXY.symm, hYT, hYC, if_false, if_true, ↓reduceIte, ht, List.reverse_append,
        List.reverse_cons, List.reverse_nil, List.nil_append, List.singleton_append, gflat_cons,
        List.cons_append]
    · simp [h1, h2, h3]

  have H := Sp.rep (C := C) (n := .reg R) (b := mvPB X Y T) (s := s) (F := F) (N := N) (B := B)
    (c := 30000 * (B + 2)) hC5 hFC
    (by simp [mvPB, RS.writes, hXC.symm, hYC.symm, hTC.symm]) (clean_reg hR5) (ok_reg hFR) trivial
    (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0, hFN] at H
  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

