theorem PadicAlgCl.exists_apply_eq_pow_pow_of_pow_eq_one_of_not_dvd (q : ℕ) [Fact q.Prime]
    (m : ℕ) (hm : ¬ q ∣ m) (σ : PadicAlgCl q ≃ₐ[ℚ_[q]] PadicAlgCl q) :
    ∃ k : ℕ, ∀ x : PadicAlgCl q, x ^ m = 1 → σ x = x ^ (q ^ k) := by sorry
