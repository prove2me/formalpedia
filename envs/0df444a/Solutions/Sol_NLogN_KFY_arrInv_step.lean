theorem rot_ne_nil {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) : (List.ofFn (KFM.tB n)).rotate k ≠ [] := by
  have hd : 0 < IntMul.OpenAI.Glue.dP n := by have := (KFM.setup_facts hn).2.1; omega
  rw [← List.length_pos_iff_ne_nil, List.length_rotate, List.length_ofFn]; exact hd

