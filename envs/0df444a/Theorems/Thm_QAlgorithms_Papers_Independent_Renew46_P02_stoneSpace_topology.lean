-- title:
--   Theorem 7.14: Topology of the Stone space
-- statement:
--   Let $B$ be a Boolean algebra, $Z$ its Stone points (unital Boolean homomorphisms to $\{0,1\}$), and $\widehat a=\{z:z(a)=1\}$. The topology generated by these characteristic sets has exactly the open subsets
--
--   $$
--   G\text{ open}\iff \forall z\in G,\ \exists a\in B:\ z\in\widehat a\subseteq G.
--   $$
--
--   With this topology $Z$ is compact Hausdorff, its clopen sets form a basis, and its clopen sets are exactly $\{\widehat a:a\in B\}$. This describes the topology as well as the full clopen representation.
-- source:
--   Abelian von Neumann algebras, measure algebras and L^\infty-spaces, arXiv:2108.06406v2, PDF p. 33, Theorem 7.14

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P02

noncomputable section

open MeasureTheory Set

open scoped ENNReal Topology CompactlySupported

namespace QAlgorithms.Papers.Independent.Renew46.P02

universe u v

/-- Theorem 7.14, PDF pp.33--34: compact Hausdorff, the explicit open-set
criterion, a clopen basis, and the complete list of clopens. -/
theorem stoneSpace_topology (B : Type u) [BooleanAlgebra B] :
    letI : TopologicalSpace (StonePoint B) := stoneTopology B
    CompactSpace (StonePoint B) ∧ T2Space (StonePoint B) ∧
      (∀ G : Set (StonePoint B), IsOpen G ↔
        ∀ z ∈ G, ∃ a : B, z ∈ stoneSet a ∧ stoneSet a ⊆ G) ∧
      TopologicalSpace.IsTopologicalBasis {G : Set (StonePoint B) | IsClopen G} ∧
      {G : Set (StonePoint B) | IsClopen G} = Set.range (stoneSet (B := B)) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P02

end
