-- title:
--   Theorem 12.16 — aperiodicity, irreducibility, and conditional positive recurrence under back-pressure (goal)
-- statement:
--   This is the goal theorem of the mission.
--
--   **Theorem 12.16.** Consider a packet network satisfying (12.1) and Assumption 12.1, operating
--   under the back-pressure control policy. The DTMC $Z$ is aperiodic and irreducible.
--   Furthermore, if the stability condition (12.26) is satisfied, then $Z$ is positive recurrent.
--
--   Combined with Theorem 12.8 and Proposition 12.9 (mission XII), this shows the back-pressure
--   policy is maximally stable under the standing assumptions — the chapter's discrete-time
--   counterpart to mission VIII's Theorem 9.12.
--
--   **Formalization note.** The irreducibility/aperiodicity conjunct carries no dependence on the
--   load hypothesis; the positive-recurrence conjunct is a separate, hypothesis-gated implication.
--   As in Lemma 12.18, the chain is the DTMC generated by the back-pressure policy from the
--   primitives (`IsPolicyChain`), and the properties are asserted on the state space $\mathcal X$
--   of states reachable from $0$ (every state reaches $0$), which is what the proof establishes and
--   what holds; the chapter's standing structure (Section 12.2 under Assumption 12.4, Section 12.1's
--   stochastic assumptions including (12.1)) is carried explicitly.
-- source:
--   Dai & Harrison, Processing Networks: Fluid Models and Stability, pre-publication draft 2020-4-2, p. 240, Theorem 12.16

import Mathlib
import Definitions.Def_ProcessingNetworks_PacketNetworks_BackPressurePolicy
import Definitions.Def_ProcessingNetworks_PacketNetworks_BPAmbientChain
import Definitions.Def_ProcessingNetworks_PacketNetworks_MarkovianPolicy
import Definitions.Def_ProcessingNetworks_PacketNetworks_SchedulesAndConfigurations

namespace ProcessingNetworks.PacketNetworks

open MeasureTheory ProbabilityTheory

/-- Theorem 12.16, Dai & Harrison p. 240 (PDF p. 256) — the goal theorem of this mission. Consider
a packet network satisfying (12.1) and Assumption 12.1 (with the chapter's standing structure: `S`
from (12.10) under Assumption 12.4, primitives satisfying Section 12.1's standing assumptions with
arrival rate vector `λ`, which include (12.1)), operating under the back-pressure control policy
`f`; `jump` is the one-step kernel of the DTMC `Z` generated by `f`. Then `Z` is aperiodic and
irreducible (every state reaches `0`; on the state space `𝒳` of states reachable from `0` the
chain is irreducible and aperiodic), unconditionally. Furthermore, if the stability condition
(12.26) is satisfied, then `Z` is positive recurrent (on `𝒳`). -/
theorem back_pressure_stability
    {I J K : ℕ} {Ω : Type*} [MeasureSpace Ω] [IsProbabilityMeasure (ℙ : Measure Ω)]
    (dat : PacketNetworkData I J) (h121 : SatisfiesAssumption121 dat)
    (cfg : LinkConfigData J K) (h124 : SatisfiesAssumption124 cfg)
    (S : Finset (Fin J → ℕ)) (hS : IsScheduleSet cfg S)
    (lam : Fin I → ℝ) (P : PacketPrimitives I J Ω) (hP : PrimitiveAssumptions P lam)
    (hBP : IsBackPressurePolicy dat S P.f)
    (jump : (Fin I → ℕ) → PMF (Fin I → ℕ)) (hjump : IsPolicyChain dat P jump) :
    ((∀ z : Fin I → ℕ, (0 : Fin I → ℕ) ∈ reachableFrom jump z) ∧
      IrreducibleOn jump (reachableFrom jump 0) ∧
      AperiodicOn jump (reachableFrom jump 0)) ∧
    ((∃ shat ∈ hullFinset S, ∀ i, lam i < (R dat).mulVec shat i) →
      PositiveRecurrentOn jump (reachableFrom jump 0)) := by sorry

end ProcessingNetworks.PacketNetworks
