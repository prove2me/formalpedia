theorem zL_regs : ∀ p ∈ NLogN.KFX.zL, ∀ r ∈ p.2.regs, r ∉ NLogN.KFX.zL.map Prod.fst := by decide

theorem agree_σM {t : IState HS} {vW vNt vFa vFb vQ vB vR2 vGx vN0 vN1 vN2 vN3 vA vK2 vF vK : ℤ}
    (h1 : ∃ L, t.G mW = .int vW :: L) (h2 : ∃ L, t.G mNt = .int vNt :: L)
    (h3 : ∃ L, t.G mFa = .int vFa :: L) (h4 : ∃ L, t.G mFb = .int vFb :: L)
    (h5 : ∃ L, t.G mQ = .int vQ :: L) (h6 : ∃ L, t.G mB = .int vB :: L)
    (h7 : ∃ L, t.G mR2 = .int vR2 :: L) (h8 : ∃ L, t.G mGx = .int vGx :: L)
    (h9 : ∃ L, t.G mN0 = .int vN0 :: L) (h10 : ∃ L, t.G mN1 = .int vN1 :: L)
    (h11 : ∃ L, t.G mN2 = .int vN2 :: L) (h12 : ∃ L, t.G mN3 = .int vN3 :: L)
    (h13 : ∃ L, t.G mA = .int vA :: L) (h14 : ∃ L, t.G mK2 = .int vK2 :: L)
    (h15 : ∃ L, t.G mF = .int vF :: L) (h16 : ∃ L, t.G mK = .int vK :: L) :
    Agree (σM vW vNt vFa vFb vQ vB vR2 vGx vN0 vN1 vN2 vN3 vA vK2 vF vK) t := by
  intro x v hx
  unfold σM at hx
  by_cases c1 : x = mW
  · rw [if_pos c1] at hx; obtain rfl := Option.some.inj hx; subst c1; exact h1
  rw [if_neg c1] at hx
  by_cases c2 : x = mNt
  · rw [if_pos c2] at hx; obtain rfl := Option.some.inj hx; subst c2; exact h2
  rw [if_neg c2] at hx
  by_cases c3 : x = mFa
  · rw [if_pos c3] at hx; obtain rfl := Option.some.inj hx; subst c3; exact h3
  rw [if_neg c3] at hx
  by_cases c4 : x = mFb
  · rw [if_pos c4] at hx; obtain rfl := Option.some.inj hx; subst c4; exact h4
  rw [if_neg c4] at hx
  by_cases c5 : x = mQ
  · rw [if_pos c5] at hx; obtain rfl := Option.some.inj hx; subst c5; exact h5
  rw [if_neg c5] at hx
  by_cases c6 : x = mB
  · rw [if_pos c6] at hx; obtain rfl := Option.some.inj hx; subst c6; exact h6
  rw [if_neg c6] at hx
  by_cases c7 : x = mR2
  · rw [if_pos c7] at hx; obtain rfl := Option.some.inj hx; subst c7; exact h7
  rw [if_neg c7] at hx
  by_cases c8 : x = mGx
  · rw [if_pos c8] at hx; obtain rfl := Option.some.inj hx; subst c8; exact h8
  rw [if_neg c8] at hx
  by_cases c9 : x = mN0
  · rw [if_pos c9] at hx; obtain rfl := Option.some.inj hx; subst c9; exact h9
  rw [if_neg c9] at hx
  by_cases c10 : x = mN1
  · rw [if_pos c10] at hx; obtain rfl := Option.some.inj hx; subst c10; exact h10
  rw [if_neg c10] at hx
  by_cases c11 : x = mN2
  · rw [if_pos c11] at hx; obtain rfl := Option.some.inj hx; subst c11; exact h11
  rw [if_neg c11] at hx
  by_cases c12 : x = mN3
  · rw [if_pos c12] at hx; obtain rfl := Option.some.inj hx; subst c12; exact h12
  rw [if_neg c12] at hx
  by_cases c13 : x = mA
  · rw [if_pos c13] at hx; obtain rfl := Option.some.inj hx; subst c13; exact h13
  rw [if_neg c13] at hx
  by_cases c14 : x = mK2
  · rw [if_pos c14] at hx; obtain rfl := Option.some.inj hx; subst c14; exact h14
  rw [if_neg c14] at hx
  by_cases c15 : x = mF
  · rw [if_pos c15] at hx; obtain rfl := Option.some.inj hx; subst c15; exact h15
  rw [if_neg c15] at hx
  by_cases c16 : x = mK
  · rw [if_pos c16] at hx; obtain rfl := Option.some.inj hx; subst c16; exact h16
  rw [if_neg c16] at hx
  exact absurd hx (by simp)

theorem σF_val {i j : Fin mC} (hij : (i : ℕ) ≠ j) (x : Fin 3) : (σF i j x : ℕ) = σR i j x := by
  have hl := s_lt (i := i) (j := j) hij
  unfold σF; simp only
  apply Nat.mod_eq_of_lt
  unfold σR; split_ifs <;> omega

theorem σF_mono {i j : Fin mC} (hij : (i : ℕ) ≠ j) : σF i j 0 < σF i j 1 ∧ σF i j 1 < σF i j 2 := by
  have h := rows_lt hij
  constructor <;> rw [Fin.lt_def, σF_val hij, σF_val hij] <;> simp [σR] <;> omega

theorem posR_he {k K e : ℕ} (he : K * (mC ^ k * mC - 1) ≤ e) (p : Fin mC × Fin (mC ^ k)) :
    posR K e k p + K * (p.2.val + mC ^ k * p.1.val) = e := by
  have h1 := p.1.isLt; have h2 := p.2.isLt
  have h3 : mC ^ k * p.1.val ≤ mC ^ k * (mC - 1) := Nat.mul_le_mul_left _ (by omega)
  have h4 : mC ^ k * (mC - 1) = mC ^ k * mC - mC ^ k := Nat.mul_sub_one _ _
  have h6 : mC ^ k ≤ mC ^ k * mC := Nat.le_mul_of_pos_right _ (by norm_num [mC])
  have h5 : p.2.val + mC ^ k * p.1.val ≤ mC ^ k * mC - 1 := by omega
  have := Nat.mul_le_mul_left K h5
  unfold posR; omega

theorem shR_eq {k K e T S0 B : ℕ} {i j : Fin mC} (hij : (i : ℕ) ≠ j) :
    KFR.shR K (mC ^ k) e T S0 B (σF i j) =
      rect (N0R k K e T B i j) (N1R k K e i j) (N2R k K e i j) (N3R k K e S0 i j) (mC ^ k * K) := by
  simp only [KFR.shR, N0R, N1R, N2R, N3R, srw, σF_val hij]; rfl

theorem vol_rowRect {k K e T S0 B r : ℕ} {i j : Fin mC} (hij : (i : ℕ) ≠ j) (hp : PF k K e T S0 B r) :
    vol (rect (N0R k K e T B i j) (N1R k K e i j) (N2R k K e i j) (N3R k K e S0 i j) (mC ^ k * K)) =
      B * 2 ^ T * S0 := by
  rw [← NLogN.KFX.shR_eq hij]
  exact KFR.shR_vol (posR_he hp.he') hp.ht (σF_mono hij)

theorem zL_size : (NLogN.KFX.zL.map fun p => p.2.size + 1).sum ≤ 20 := by decide

theorem cHd_le {Bb M a b d1 d2 : ℕ} (hM : M ≤ Bb) (ha : a ≤ 10000 * 10 ^ 7 * (Bb + 2) ^ 2 + 1)
    (hb : b ≤ 20 * 10 ^ 7 * (Bb + 2) ^ 2 + 1) (hd1 : d1 ≤ 2) (hd2 : d2 ≤ 2 * Bb + 2) :
    a + (b + (M * (NLogN.KFX.cZ Bb + 30) + 30) + (d1 + d2)) + (13 * (2 * Bb + 2) + 1) ≤ cHd Bb := by
  unfold cHd NLogN.KFX.cZ
  have h1 : M * (2 * (4 * 10 ^ 7 * (Bb + 2) ^ 2) + 30) ≤ (Bb + 2) * (2 * (4 * 10 ^ 7 * (Bb + 2) ^ 2) + 30) :=
    Nat.mul_le_mul_right _ (by omega)
  generalize hX : Bb + 2 = X at *
  have hX2 : 2 ≤ X := by omega
  have h2 : X ^ 2 ≤ X ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h3 : X ≤ X ^ 2 := by nlinarith
  have h4 : X * (2 * (4 * 10 ^ 7 * X ^ 2) + 30) = 8 * 10 ^ 7 * X ^ 3 + 30 * X := by ring
  rw [h4] at h1
  have : 1 ≤ X ^ 3 := by nlinarith
  omega

theorem ESp.ofG {t : IState HS} {x : Fin HS} {v : ℤ} {L : List Item} {Bb : ℕ}
    (h : t.G x = .int v :: L) (hx : x.val < 56) (hb : zsz v ≤ Bb) : ESp (.reg x) t Bb v :=
  ⟨KFL.clean_all _ (by simp [Ex.regs, hx]), IState.isInt_of h,
    by show zsz (t.top x) ≤ Bb; rw [IState.top_eq h]; exact hb, IState.top_eq h⟩

