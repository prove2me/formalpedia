variable {α : Type*}

theorem AModelL12.l12bin_correct_paper {child : Oracle α} {d : α} {W m q Kp : ℕ}
    (hspec : OracleSpec child d W m q Kp) (hm : 2 ≤ m) (hW : 1 ≤ W) (ρ : ℕ)
    (P G B : ℕ) {e u : ℕ} (he : e ≤ m ^ Kp) (hu : 2 ^ u ≤ q ^ e) (xs : List α) :
    l12bin child W m q Kp ρ e u [P] [G] [B] d xs =
      pull [P, 2 ^ u, G, 2 ^ u, B] [P, 2 ^ u, G, 2 ^ u, B] (swapPos 1 3) d xs := by sorry
