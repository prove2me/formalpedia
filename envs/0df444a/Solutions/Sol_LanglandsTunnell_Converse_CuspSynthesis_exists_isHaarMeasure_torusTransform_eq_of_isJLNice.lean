private theorem t0491 {ι : Type} (t : Finset ι) (f : ι → ℝ) (hf : ∀ i ∈ t, 0 ≤ f i) (z : ℂ) :
    (((∏ i ∈ t, f i : ℝ)) : ℂ) ^ z = ∏ i ∈ t, ((f i : ℝ) : ℂ) ^ z := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | insert a t ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, Complex.ofReal_mul,
      Complex.mul_cpow_ofReal_nonneg (hf a (Finset.mem_insert_self a t))
        (Finset.prod_nonneg fun i hi => hf i (Finset.mem_insert_of_mem hi)) z,
      ih fun i hi => hf i (Finset.mem_insert_of_mem hi)]

