-- Source module: NLogNP.SSMain
namespace NLogN

open IntMul

section blen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

end blen

theorem mainN0_facts (n : ℕ) :
    2 * n < mainN0 n ∧ 1 ≤ mainN0 n ∧ 2 ^ fmK (mainN0 n) ∣ mainN0 n ∧
      fmL (mainN0 n) = zsz ((n + 1 : ℕ) : ℤ) + 2 := by
  set e := zsz ((n + 1 : ℕ) : ℤ) with he
  have h1 : n + 1 < 2 ^ e := by
    have := natAbs_lt_zsz ((n + 1 : ℕ) : ℤ); rw [Int.natAbs_natCast] at this; exact this
  have hL : fmL (mainN0 n) = e + 2 := by
    simp only [fmL, mainN0]; rw [zsz_natCast_two_pow]
  refine ⟨?_, Nat.one_le_two_pow, ?_, hL⟩
  · show 2 * n < 2 ^ (e + 1); rw [pow_succ]; omega
  · apply pow_dvd_pow
    simp only [fmK, hL]; omega

end NLogN

end

section
open NLogN
open IntMul
set_option maxHeartbeats 2000000
theorem solution {I : List Sym} (n : ℕ) (s : IState NS) (a b : ℕ) (ha : a < 2 ^ n)
    (hb : b < 2 ^ n) (LP LN LF : List Item) (hA : s.G ARG = [.int (b : ℤ), .int (a : ℤ)])
    (hT1 : s.G T1 = [.int (2 ^ n)]) (hT2 : s.G T2 = [.int (2 ^ n)])
    (hP : s.G PRM = .int (mainN0 n) :: LP) (hN : s.G RN = .int (2 ^ mainN0 n) :: LN)
    (hF : s.G RF = .int (2 ^ mainN0 n + 1) :: LF) :
    ∃ t, IRuns I ssProg (.seq (.call 1) (.seq (.op (.shl T1 T2)) (.op (.write ARG T1)))) s t
      (fmPhi (mainN0 n) + shlCost n + outRCost (2 * n)) ∧ t.out = s.out ++ bin (2 * n) (a * b) := by
  obtain ⟨hN0, hN01, hdiv, -⟩ := mainN0_facts n
  have hab : a * b < 2 ^ (2 * n) := by rw [two_mul, pow_add]; exact Nat.mul_lt_mul'' ha hb
  have hnN : 2 ^ (2 * n) < 2 ^ mainN0 n := Nat.pow_lt_pow_right (by norm_num) hN0
  have hab' : ((a * b : ℕ) : ℤ) < 2 ^ mainN0 n := by exact_mod_cast hab.trans hnN
  have hmod : ((b : ℤ) * (a : ℤ)) % (2 ^ mainN0 n + 1) = ((a * b : ℕ) : ℤ) := by
    rw [Int.emod_eq_of_lt (by positivity) (by push_cast at hab' ⊢; linarith)]; push_cast; ring
  have ha' : (a : ℤ) ≤ 2 ^ mainN0 n := by
    have : a < 2 ^ mainN0 n := lt_of_lt_of_le ha (Nat.pow_le_pow_right (by norm_num) (by omega))
    exact_mod_cast this.le
  have hb' : (b : ℤ) ≤ 2 ^ mainN0 n := by
    have : b < 2 ^ mainN0 n := lt_of_lt_of_le hb (Nat.pow_le_pow_right (by norm_num) (by omega))
    exact_mod_cast this.le
  have r1 := fm_spec' (I := I) (iprog := ssProg) 1 2 3 4 rfl rfl rfl rfl (mainN0 n) hN01
    (Or.inr hdiv) s b a [] LP LN LF ⟨by positivity, hb'⟩ ⟨by positivity, ha'⟩ hA hP hN hF
  rw [hmod] at r1
  set s1 := s.upd ARG [.int ((a * b : ℕ) : ℤ)] with hs1
  have r2 := IRuns.op (I := I) (iprog := ssProg) (IOp.Step.shl (s := s1) (i := T1) (j := T2)
    (a := 2 ^ n) (m := n) (Li := []) (Lj := []) (by decide) (by simp +decide [s1, hT1])
    (by simp +decide [s1, hT2]))
  set s2 := s1.upd T1 [.int (2 ^ n * 2 ^ n)] with hs2
  have r3 := IRuns.op (I := I) (iprog := ssProg) (IOp.Step.write (s := s2) (i := ARG) (j := T1)
    (n := a * b) (m := 2 * n) (Li := []) (Lj := []) (by decide) hab (by simp +decide [s2, s1])
    (by simp +decide [s2]; ring))
  refine ⟨_, (IRuns.seq r1 (IRuns.seq r2 r3)).mono (le_of_eq (add_assoc _ _ _).symm), ?_⟩
  simp [s2, s1]
end
