    (fun _ => 1) (fun n _ => ?_) (fun n _ => ?_) (fun _ _ => le_rfl)
    (fun x _ y _ => hG.ts _ _) (fun x _ y _ _ hc => hG.side_inj hc)
  · rw [kD_eq hcard hinj]; push_cast; ring
  · split_ifs <;> rcases hσ with rfl | rfl <;> simp

