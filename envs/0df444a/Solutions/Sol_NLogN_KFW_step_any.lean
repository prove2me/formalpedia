theorem Wc_ge3 : 3 ≤ P8Lift.Wc := by norm_num
theorem sc_pos : 0 < P8Lift.sc := by norm_num

theorem dw_gate {W A n : ℕ} (h : n ≤ A) : 3 * n + 3 * W ≤ dwloc W A := by
  unfold dwloc; omega

theorem dw_loc0 {W A : ℕ} : 0 + (0 + 2) * W ≤ dwloc W A := by
  unfold dwloc; omega

theorem Mph_le_Mloc : Mph ≤ Mloc := by
  unfold Mph Mloc
  generalize P8Lift.Wc = W
  generalize NLogN.KFW.A0 = A
  generalize 12 * mC + 30 = c
  have h1 : W + 3 ≤ (W + A + 10) ^ 2 := le_trans (by omega) (Nat.le_self_pow (by norm_num) _)
  calc 10 ^ 12 * c * (W + 3) ≤ 10 ^ 13 * c * (W + 3) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by norm_num))
    _ ≤ 10 ^ 13 * c * (W + A + 10) ^ 2 := Nat.mul_le_mul_left _ h1

theorem dw_diag {α : Type} {W A : ℕ} (L : List α) (h : L.length ≤ W) :
    (L.map fun _ => 0 + (0 + 2) * W).sum ≤ dwloc W A := by
  simp only [List.map_const', List.sum_replicate, smul_eq_mul, zero_add]
  unfold dwloc
  have : L.length * (2 * W) ≤ W * (2 * W) := Nat.mul_le_mul_right _ h
  have e : W * (2 * W) = 2 * W * W := by ring
  omega

theorem Lc_eq : Lc = P8Lift.complexIface.net.length := by unfold Lc; rfl

theorem ES_mono_succ (k : ℕ) : ES k ≤ ES (k + 1) := by
  show ES k ≤ NLogN.KFW.cL + P8Lift.sc * ES k
  have : ES k ≤ P8Lift.sc * ES k := Nat.le_mul_of_pos_left _ sc_pos
  omega

theorem eLoc_le_one (a : P8Lift.RStep (Fin P8Lift.Wc) mC) : eLoc a ≤ 1 := by
  cases a with
  | gate G =>
    simp only [eLoc]
    split
    · unfold gδ; split_ifs <;> omega
    · omega
  | _ => simp [eLoc]

theorem cL_le : NLogN.KFW.cL ≤ Lc := by
  rw [Lc_eq]; unfold NLogN.KFW.cL
  generalize P8Lift.complexIface.net = l
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.sum_cons, List.length_cons]
    have := eLoc_le_one a
    omega

theorem ES_le_Eb : ∀ k, ES k ≤ Eb Lc P8Lift.sc k
  | 0 => by simp [ES, Eb]
  | k + 1 => by
    show NLogN.KFW.cL + P8Lift.sc * ES k ≤ Lc + P8Lift.sc * Eb Lc P8Lift.sc k
    have := ES_le_Eb k
    have := cL_le
    have : P8Lift.sc * ES k ≤ P8Lift.sc * Eb Lc P8Lift.sc k := Nat.mul_le_mul_left _ (ES_le_Eb k)
    omega

theorem gAt_some {G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ} {as : List KFG.Atom}
    (h : gAt G = some as) : GAt G as := by
  unfold gAt at h
  split_ifs at h with hh
  · cases h; exact Classical.choose_spec hh

theorem gDiag_some {G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ} {U : Finset (Fin P8Lift.Wc)}
    (h : gDiag G = some U) : G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 := by
  unfold gDiag at h
  split_ifs at h with hh
  · cases h; exact Classical.choose_spec hh

theorem gDiag_isSome {G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ}
    (h : ∃ U : Finset (Fin P8Lift.Wc), G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1) :
    ∃ U, gDiag G = some U := by
  unfold gDiag
  rw [dif_pos h]
  exact ⟨_, rfl⟩

theorem zszN_lt {x k : ℕ} (h : x < 2 ^ k) : zsz (x : ℤ) ≤ k :=
  zsz_le_of_lt (by rw [Int.natAbs_natCast]; exact h)

theorem psiR_Y {r Z H : ℕ} (hHZ : H + 1 < 2 ^ Z) : KFR.PsiR r Z H ≤ 17 * Yu r Z H := by
  unfold KFR.PsiR
  have hz : zsz ((H : ℤ) + 1) ≤ Z := by
    have e : ((H : ℤ) + 1) = ((H + 1 : ℕ) : ℤ) := by push_cast; ring
    rw [e]
    exact zszN_lt hHZ
  have h1 : (Z + zsz ((H : ℤ) + 1) + 2) ^ 3 ≤ (2 * (Z + 2)) ^ 3 :=
    Nat.pow_le_pow_left (by omega) 3
  have h2 : r * (H + 1) * zsz ((H : ℤ) + 1) / (Z + 2) ≤ r * (H + 1) := by
    apply Nat.div_le_of_le_mul
    have : r * (H + 1) * zsz ((H : ℤ) + 1) ≤ r * (H + 1) * (Z + 2) :=
      Nat.mul_le_mul_left _ (by omega)
    linarith
  have h3 := yu_z r Z H
  have h4 := yu_r r Z H
  have h5 : r * (H + 1) ≤ r * (2 * H + 21) := Nat.mul_le_mul_left _ (by omega)
  have e : (2 * (Z + 2)) ^ 3 = 8 * (Z + 2) ^ 3 := by ring
  have hY8 := yu_8 r Z H
  have hYd : Yu r Z H = r * (2 * H + 21) + (Z + 2) ^ 3 := rfl
  have hZ8 : 8 ≤ (Z + 2) ^ 3 := by
    have : 2 ^ 3 ≤ (Z + 2) ^ 3 := Nat.pow_le_pow_left (by omega) 3
    simpa using this
  omega

/-- The row-step cost in the unit. -/
theorem rowB_le {Kc : ℝ} (hKc : 0 ≤ Kc) {K n r Z H k : ℕ} (hHZ : H + 1 < 2 ^ Z) :
    (Kc * (K + 2) + 1) * (n : ℝ) * ((r : ℝ) * (H + 1) * ((mC : ℝ) ^ k + 1) ^ τ50 +
      (KFR.PsiR r Z H : ℝ)) ≤
    18 * (Kc * (K + 2) + 1) * ((mC : ℝ) ^ k + 1) ^ τ50 * ((n * Yu r Z H : ℕ) : ℝ) := by
  have hG : (1 : ℝ) ≤ ((mC : ℝ) ^ k + 1) ^ τ50 := one_le_Gam mC k τ50_nonneg
  have hP : (KFR.PsiR r Z H : ℝ) ≤ 17 * (Yu r Z H : ℝ) := by exact_mod_cast psiR_Y hHZ
  have hr : (r : ℝ) * (H + 1) ≤ (Yu r Z H : ℝ) := by
    have : r * (H + 1) ≤ Yu r Z H := le_trans (Nat.mul_le_mul_left _ (by omega)) (yu_r r Z H)
    exact_mod_cast this
  have hCR : 0 ≤ Kc * (K + 2) + 1 := by positivity
  have hY0 : (0 : ℝ) ≤ (Yu r Z H : ℝ) := by positivity
  set G := ((mC : ℝ) ^ k + 1) ^ τ50
  have k1 : (r : ℝ) * (H + 1) * G + (KFR.PsiR r Z H : ℝ) ≤ 18 * G * (Yu r Z H : ℝ) := by
    have a : (r : ℝ) * (H + 1) * G ≤ (Yu r Z H : ℝ) * G := mul_le_mul_of_nonneg_right hr (by linarith)
    have b : 17 * (Yu r Z H : ℝ) ≤ 17 * G * (Yu r Z H : ℝ) := by nlinarith
    nlinarith
  push_cast
  have hn : (0 : ℝ) ≤ n := by positivity
  calc (Kc * (K + 2) + 1) * (n : ℝ) * ((r : ℝ) * (H + 1) * G + (KFR.PsiR r Z H : ℝ))
      ≤ (Kc * (K + 2) + 1) * (n : ℝ) * (18 * G * (Yu r Z H : ℝ)) :=
        mul_le_mul_of_nonneg_left k1 (by positivity)
    _ = _ := by ring

section Step

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {σ : Fin HS → Option ℤ} {K t S0 r H Z k e B Bn : ℕ}

theorem nodeZ_of {K t S0 r H Z k e B Bn : ℕ} (hB : B = P8Lift.Wc * Bn) (hS : 1 ≤ S0) (hr : 1 ≤ r)
    (hBn : 1 ≤ Bn) (hK : 1 ≤ K) (het : e - e % K + K ≤ t)
    (hV : zsz ((Vb K t S0 r H (k + 1) B : ℕ) : ℤ) ≤ Z) : NodeZ K t S0 r H Z k e B Bn := by
  have hle : ∀ x, x ≤ Vb K t S0 r H (k + 1) B → zsz (x : ℤ) ≤ Z := fun x hx =>
    le_trans (zsz_natCast_le hx) hV
  have hWn : P8Lift.Wc * (nN Bn t S0 * r) = B * 2 ^ t * S0 * r := by rw [hB]; simp only [nN]; ring
  have het' : e < t := by have := Nat.mod_lt e (show K > 0 by omega); omega
  have hm1 : mC ^ k ≤ mC ^ (k + 1 + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hm2 : mC * mC ^ k ≤ mC ^ (k + 1 + 1) := by
    rw [← pow_succ']; exact Nat.pow_le_pow_right (by norm_num) (by omega)
  have hm3 : K ≤ K * mC ^ (k + 1 + 1) := Nat.le_mul_of_pos_right _ (by positivity)
  have hm4 : K * mC ^ k ≤ K * mC ^ (k + 1 + 1) := Nat.mul_le_mul_left _ hm1
  have hB1 : Bn ≤ B := by rw [hB]; exact Nat.le_mul_of_pos_left _ Wc_pos
  have hBB : B ≤ B * 2 ^ t * S0 * r := by
    have : 1 ≤ 2 ^ t * S0 * r := by
      have := Nat.one_le_two_pow (n := t)
      have := Nat.mul_le_mul this hS
      have := Nat.mul_le_mul this hr
      simpa using this
    calc B = B * 1 := by ring
      _ ≤ B * (2 ^ t * S0 * r) := Nat.mul_le_mul_left _ this
      _ = B * 2 ^ t * S0 * r := by ring
  have hES := ES_mono_succ (k + 1)
  have hWc : 3 ≤ P8Lift.Wc := Wc_ge3
  unfold Vb at hV hle
  refine ⟨hle _ (by rw [hWn]; omega), hle _ (by rw [hWn]; omega), hle _ (by omega),
    hle _ (by omega), hle _ (by omega), hle _ (by omega), hle _ (by omega), ?_⟩
  have := hle 16 (by omega)
  have h16 : zsz ((16 : ℕ) : ℤ) = 5 := by
    have := NLogN.zsz_two_pow 4
    norm_num at this ⊢; exact this
  omega

theorem stepC_diag {Pp : ℕ} (jL : Fin Pp) (rowC : IStmt HS Pp)
    {G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ} {U : Finset (Fin P8Lift.Wc)}
    (hg : gAt G = none) (hU : gDiag G = some U) :
    stepC jL rowC (.gate G) = seqLQ phStepC (negSteps (m := mC) U.toList) := by
  simp only [stepC]
  rw [hg, hU]

theorem yu_monoZ {r Z Z' H : ℕ} (h : Z ≤ Z') : Yu r Z H ≤ Yu r Z' H := by
  unfold Yu
  have : (Z + 2) ^ 3 ≤ (Z' + 2) ^ 3 := Nat.pow_le_pow_left (by omega) 3
  omega

/-- The row wrapper with the data size `Z` and the register size `Zr`. -/
theorem cost_row2 {Bn t S0 r Z Zr H x : ℕ} (hZZ : Z ≤ Zr) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn)
    (cost : ℕ → ℕ) (hx : x + 2 * P8Lift.Wc ≤ H) :
    cWrapQ P8Lift.Wc (nN Bn t S0 * r) Z 0 0
      (fun x => cFrame 10 1 Zr + cost x + (10 * (2 * Zr + 2) + 1)) x ≤
      cost x + Mloc * ((P8Lift.Wc * nN Bn t S0) * Yu r Zr H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hW : 1 ≤ P8Lift.Wc := by norm_num
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := 0) (dw := 0) (x := x) hW hn
    (fun x => cFrame 10 1 Zr + cost x + (10 * (2 * Zr + 2) + 1)) (by omega)
  have hF := cFrame_Y 10 1 r Zr H
  have hYm : Yu r Z H ≤ Yu r Zr H := yu_monoZ hZZ
  refine h1.trans ?_
  unfold Mloc
  generalize P8Lift.Wc = W at hW ⊢
  generalize NLogN.KFW.A0 = A
  set n := nN Bn t S0
  set Y := Yu r Zr H
  have hY8 := yu_8 r Zr H
  have h5 := yu_z1 r Zr H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  have hYP : Y ≤ W * n * Y := Nat.le_mul_of_pos_left _ (by omega)
  have hPm : W * n * Yu r Z H ≤ W * n * Y := Nat.mul_le_mul_left _ hYm
  set P := W * n * Y with hP
  have hPm' : 10 ^ 12 * (W + 2) * (W * n * Yu r Z H) ≤ 10 ^ 12 * (W + 2) * P :=
    Nat.mul_le_mul_left _ hPm
  have k : 10 * (1 + 1) * 10 ^ 8 * Y + 1 + (10 * (2 * Zr + 2) + 1) +
      10 ^ 12 * (W + 2) * P ≤ 10 ^ 13 * (12 * mC + 30) * (W + A + 10) ^ 2 * P := by
    have a : (W + 2) + 1 ≤ (W + A + 10) ^ 2 :=
      le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
    have b : 10 ^ 12 * ((W + 2) + 1) * P ≤ 10 ^ 13 * (12 * mC + 30) * (W + A + 10) ^ 2 * P := by
      apply Nat.mul_le_mul_right
      have : 10 ^ 12 * ((W + 2) + 1) ≤ 10 ^ 12 * (W + A + 10) ^ 2 := Nat.mul_le_mul_left _ a
      have : 10 ^ 12 * (W + A + 10) ^ 2 ≤ 10 ^ 13 * (12 * mC + 30) * (W + A + 10) ^ 2 :=
        Nat.mul_le_mul_right _ (by omega)
      omega
    have e : 10 ^ 12 * ((W + 2) + 1) * P = 10 ^ 12 * (W + 2) * P + 10 ^ 12 * P := by ring
    omega
  omega

end Step

end NLogN.KFW

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFW
open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {σ : Fin HS → Option ℤ} {K t S0 r H Z k e B Bn : ℕ}
theorem solution {rowC : NLogN.IStmt NLogN.HS Pp} {Kc : ℝ} (hRow : NLogN.KFW.RowU Isym tbl rowC Kc) (hKc : 0 ≤ Kc)
    {jL : Fin Pp} (hj : tbl jL = NLogN.KFW.levC jL rowC)
    (hN : NLogN.KFW.NodeR σ K t S0 r H k e B Bn) (hB : B = P8Lift.Wc * Bn)
    (hK6 : 6 ≤ K) (hr : 1 ≤ r) (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (Zr : ℕ) (hZZ : Z ≤ Zr) (hZr : Zr + 2 ≤ r)
    (hHZ : H + 1 < 2 ^ Z) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn)
    (hKe : K * (NLogN.KFW.mC ^ (k + 1) - 1) ≤ e) (het : e - e % K + K ≤ t)
    (hz16 : NLogN.zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z)
    (hV : NLogN.zsz ((NLogN.KFW.Vb K t S0 r H (k + 1) B : ℕ) : ℤ) ≤ Zr) (cI : ℕ)
    (IH : ∀ h : Fin NLogN.KFW.mC, NLogN.KFW.SImplQ Isym tbl (fun s => NLogN.KFW.Agree (NLogN.KFW.σChild σ K k e Bn h) s) 0 H r
      (fun c : Fin (NLogN.KFW.mC ^ k) => 2 ^ ((e - h.val * (K * NLogN.KFW.mC ^ k)) - K * c.val) * S0) (NLogN.KFW.nN Bn t S0)
      (Butterfly.tens Butterfly.Cm) (NLogN.KFW.levC jL rowC) (NLogN.KFW.ES k) (NLogN.KFN.DWb NLogN.KFW.Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 k) (fun _ => cI))
    (a : P8Lift.RStep (Fin P8Lift.Wc) NLogN.KFW.mC) (ha : a ∈ P8Lift.complexIface.net) :
    ∃ (dw c : ℕ), NLogN.KFW.RImplQ Isym tbl (fun s => NLogN.KFW.Agree σ s) 0 H r (NLogN.KFW.nN Bn t S0) (NLogN.KFW.stN K e k S0)
        (a.den (Butterfly.tens Butterfly.Cm)) (NLogN.KFW.stepC jL rowC a) (NLogN.KFW.eSt k a) dw (fun _ => c) ∧
      dw ≤ (if a.isChild then NLogN.KFN.DWb NLogN.KFW.Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 k + (NLogN.KFN.Eb NLogN.KFW.Lc P8Lift.sc k + 2) * P8Lift.Wc
        else NLogN.KFN.dwloc P8Lift.Wc NLogN.KFW.A0) ∧
      (c : ℝ) ≤ (if a.isChild then (cI : ℝ) else 0) +
        ((NLogN.KFW.Mloc : ℝ) + 18 * (Kc * (K + 2) + 1) * ((NLogN.KFW.mC : ℝ) ^ k + 1) ^ NLogN.KFN.τ50) *
          ((P8Lift.Wc * NLogN.KFW.nN Bn t S0 * NLogN.KFW.Yu r Zr H : ℕ) : ℝ) := by
  have hK : 1 ≤ K := by omega
  have NZ := NLogN.KFW.nodeZ_of (H := H) (k := k) hB hS hr hBn hK het hV
  have hQ : ∀ s, (fun s => NLogN.KFW.Agree σ s) s → NLogN.KFW.Agree σ s := fun s h => h
  have hn : 1 ≤ NLogN.KFW.nN Bn t S0 := NLogN.KFW.one_le_nN hBn hS
  set P := P8Lift.Wc * NLogN.KFW.nN Bn t S0 * NLogN.KFW.Yu r Zr H with hP
  have hG0 : (0 : ℝ) ≤ 18 * (Kc * (K + 2) + 1) * ((NLogN.KFW.mC : ℝ) ^ k + 1) ^ τ50 := by positivity
  have hP0 : (0 : ℝ) ≤ (P : ℝ) := by positivity
  -- a local step with an `ℕ` bound `Mloc P`
  have loc : ∀ (U : NLogN.IStmt NLogN.HS Pp) (e' dw : ℕ) (cost : ℕ → ℕ),
      NLogN.KFW.RImplQ Isym tbl (fun s => NLogN.KFW.Agree σ s) 0 H r (NLogN.KFW.nN Bn t S0) (NLogN.KFW.stN K e k S0) (a.den (Butterfly.tens Butterfly.Cm)) U e'
        dw cost → (∀ w, w + dw ≤ H → cost w ≤ NLogN.KFW.Mloc * P) → U = NLogN.KFW.stepC jL rowC a → e' = NLogN.KFW.eSt k a →
      dw ≤ NLogN.KFN.dwloc P8Lift.Wc NLogN.KFW.A0 → a.isChild = false →
      ∃ (dw c : ℕ), NLogN.KFW.RImplQ Isym tbl (fun s => NLogN.KFW.Agree σ s) 0 H r (NLogN.KFW.nN Bn t S0) (NLogN.KFW.stN K e k S0)
        (a.den (Butterfly.tens Butterfly.Cm)) (NLogN.KFW.stepC jL rowC a) (NLogN.KFW.eSt k a) dw (fun _ => c) ∧
      dw ≤ (if a.isChild then NLogN.KFN.DWb NLogN.KFW.Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 k + (NLogN.KFN.Eb NLogN.KFW.Lc P8Lift.sc k + 2) * P8Lift.Wc
        else NLogN.KFN.dwloc P8Lift.Wc NLogN.KFW.A0) ∧
      (c : ℝ) ≤ (if a.isChild then (cI : ℝ) else 0) +
        ((NLogN.KFW.Mloc : ℝ) + 18 * (Kc * (K + 2) + 1) * ((NLogN.KFW.mC : ℝ) ^ k + 1) ^ NLogN.KFN.τ50) * (P : ℝ) := by
    intro U e' dw cost R hc hU he hd hch
    subst hU he
    refine ⟨dw, NLogN.KFW.Mloc * P, R.mono (fun w _ hw => hc w hw), ?_, ?_⟩
    · simp only [hch, Bool.false_eq_true, if_false]; exact hd
    simp only [hch, Bool.false_eq_true, if_false, zero_add]
    have h1 : (0 : ℝ) ≤ 18 * (Kc * (K + 2) + 1) * ((NLogN.KFW.mC : ℝ) ^ k + 1) ^ NLogN.KFN.τ50 * (P : ℝ) :=
      mul_nonneg hG0 hP0
    rw [Nat.cast_mul, add_mul]
    exact le_add_of_nonneg_right h1
  cases a with
  | gate G =>
    by_cases hat : ∃ as, NLogN.KFW.GAt G as
    · obtain ⟨as, hg⟩ : ∃ as, NLogN.KFW.gAt G = some as := ⟨_, by unfold NLogN.KFW.gAt; rw [dif_pos hat]⟩
      obtain ⟨hA, hok, hts, hG⟩ := NLogN.KFW.gAt_some hg
      have R := NLogN.KFW.stepQ_gate (Isym := Isym) (tbl := tbl) (lo := 0) (hi := H) hN hQ hr hS hBn as hok
        hts Zr NZ.z2
      rw [← hG] at R
      refine loc _ _ _ _ R (fun w hw => NLogN.KFW.cost_gate hn as hA hok hw) (by simp [NLogN.KFW.stepC, hg])
        (by simp [NLogN.KFW.eSt, P8Lift.RStep.isChild, NLogN.KFW.eLoc, hg]) (NLogN.KFW.dw_gate hA) rfl
    · have hD : ∃ U : Finset (Fin P8Lift.Wc),
          G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 := by
        rcases NLogN.KFW.gclass_A0 G ha with h | h
        · exact absurd h hat
        · exact h
      obtain ⟨U, hU⟩ := NLogN.KFW.gDiag_isSome hD
      have hg : NLogN.KFW.gAt G = none := by unfold NLogN.KFW.gAt; rw [dif_neg hat]
      have hGU := NLogN.KFW.gDiag_some hU
      have R := NLogN.KFW.stepQ_fixG (Isym := Isym) (tbl := tbl) (lo := 0) (hi := H) hN hQ hr hS hBn hK hKe
        het Zr NZ.z16 NZ.ze1 NZ.zu U
      rw [← hGU] at R
      have hlen : (NLogN.KFN.negSteps (m := NLogN.KFW.mC) U.toList).length ≤ P8Lift.Wc := by
        simp only [NLogN.KFN.negSteps, List.length_map, Finset.length_toList]
        exact (Finset.card_le_univ U).trans (le_of_eq (Fintype.card_fin _))
      exact loc _ _ _ _ R (fun w hw => NLogN.KFW.cost_fixG hS hBn NZ.z3 U hw) (NLogN.KFW.stepC_diag jL rowC hg hU).symm
        (by simp [NLogN.KFW.eSt, P8Lift.RStep.isChild, NLogN.KFW.eLoc, hg]) (NLogN.KFW.dw_diag _ hlen) rfl
  | rowAdd w i j hij =>
    have hz16' : NLogN.zsz ((16 * (P8Lift.Wc * (NLogN.KFW.nN Bn t S0 * r)) : ℕ) : ℤ) ≤ Z := by
