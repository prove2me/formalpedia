theorem tab_abs {n n' A : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} (hs : MonoSrc n n' src)
    (hnA : n ≤ 2 ^ A) (ha : ∀ l < n', |argOf l| ≤ 2 ^ A) :
    ∀ y ∈ srcTab src argOf n', |y| ≤ 2 ^ A := by
  intro y hy
  simp only [srcTab, List.mem_flatMap, List.mem_range, List.mem_cons, List.not_mem_nil,
    or_false] at hy
  obtain ⟨l, hl, rfl | rfl⟩ := hy
  · cases hk : src l with
    | none => simp [J6Seg.Slab.code]; exact one_le_pow₀ (by norm_num)
    | some k =>
      have := hs.1 l hl k hk
      simp only [J6Seg.Slab.code]
      exact abs_nat_le (by omega)
  · exact ha l hl

theorem zsz_A {a : ℤ} {A : ℕ} (h : |a| ≤ 2 ^ A) : zsz a ≤ A + 1 := by
  simpa using zsz_le_AD (D := 1) h le_rfl

set_option maxHeartbeats 1000000 in
theorem ctlPh_runs_sol_aux {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} (s0 : IState HS)
    (F : Fin HS → List ℤ) {Rn Rn' : Fin HS} (hR5 : Rn.val < 56) (hR5' : Rn'.val < 56)
    (dR : Rn ≠ 20 ∧ Rn ≠ 21) (dR' : Rn' ≠ 20 ∧ Rn' ≠ 21 ∧ Rn' ≠ 38 ∧ Rn' ≠ 44 ∧ Rn' ≠ 45)
    {n n' A : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} (hs : MonoSrc n n' src) {LN LN' : List ℤ}
    (hFN : F Rn = (n : ℤ) :: LN) (hFN' : F Rn' = (n' : ℤ) :: LN')
    (h44 : F 44 = srcTab src argOf n') (h43 : F 43 = []) (h34 : F 34 = []) (h35 : F 35 = [])
    (h36 : F 36 = []) (hnA : n ≤ 2 ^ A) (hnA' : n' ≤ 2 ^ A) (ha : ∀ l < n', |argOf l| ≤ 2 ^ A)
    (hA : 2 ≤ A) :
    IRuns I iprog (ctlPh Rn Rn') (encK s0 F)
      (encK s0 (update (update (update F 44 []) 38 (((n + n' : ℕ) : ℤ) :: F 38)) 45
