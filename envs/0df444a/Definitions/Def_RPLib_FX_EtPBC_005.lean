-- ===== S4.Def_RP_EtPBC_A_EIdem =====
section

/-!
# S4-EtPBC-A, M4(E), EIdem: clopen sets, idempotents, and lifting clopens to a relative normalization

* `exists_idem`: a clopen open `C ⊆ X` is `X.basicOpen e` for an idempotent `e ∈ Γ(X, ⊤)`;
* `isClopen_basicOpen`: the basic open of an idempotent global section is clopen;
* **`exists_clopen_lift`**: for `h : X ⟶ W` (qcqs, `W` affine) and a clopen `C ⊆ X` there is a clopen `C'` of the relative
  normalization with `h.toNormalization ⁻¹ᵁ C' = C`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

universe u

/-- **The idempotent of a clopen subset.** -/
theorem exists_idem {X : Scheme.{u}} (C : X.Opens) (hC : IsClosed (C : Set X)) :
    ∃ e : Γ(X, ⊤), IsIdempotentElem e ∧ X.basicOpen e = C := by
  let D : X.Opens := ⟨(C : Set X)ᶜ, hC.isOpen_compl⟩
  have hsup : C ⊔ D = ⊤ := by
    ext x
    simp only [Opens.coe_sup, Set.mem_union, SetLike.mem_coe, Opens.coe_top, Set.mem_univ, iff_true]
    exact em _
  have hinf : C ⊓ D = ⊥ := by
    ext x
    simp [D]
  have hsub : Subsingleton (X.sheaf.obj.obj (op (C ⊓ D))) :=
    CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hinf)
  let q : (CommRingCat.of (RingHom.eqLocus
      (RingHom.comp (X.sheaf.obj.map (homOfLE inf_le_left : C ⊓ D ⟶ C).op).hom
        (RingHom.fst (X.sheaf.obj.obj (op C)) (X.sheaf.obj.obj (op D))))
      (RingHom.comp (X.sheaf.obj.map (homOfLE inf_le_right : C ⊓ D ⟶ D).op).hom
        (RingHom.snd (X.sheaf.obj.obj (op C)) (X.sheaf.obj.obj (op D)))))) :=
    ⟨((1 : Γ(X, C)), (0 : Γ(X, D))), @Subsingleton.elim _ hsub _ _⟩
  have hq : IsIdempotentElem q := Subtype.ext (Prod.ext (one_mul _) (zero_mul _))
  let p : Γ(X, C ⊔ D) := (X.sheaf.objSupIsoProdEqLocus C D).inv q
  have hp : IsIdempotentElem p := hq.map (X.sheaf.objSupIsoProdEqLocus C D).inv.hom
  have hp1 : X.presheaf.map (homOfLE le_sup_left : C ⟶ C ⊔ D).op p = 1 :=
    X.sheaf.objSupIsoProdEqLocus_inv_fst C D q
  have hp0 : X.presheaf.map (homOfLE le_sup_right : D ⟶ C ⊔ D).op p = 0 :=
    X.sheaf.objSupIsoProdEqLocus_inv_snd C D q
  have h1 : C ⊓ X.basicOpen p = C := by
    rw [← X.basicOpen_res p (homOfLE le_sup_left : C ⟶ C ⊔ D).op, hp1]
    exact X.basicOpen_of_isUnit isUnit_one
  have h0 : D ⊓ X.basicOpen p = ⊥ := by
    rw [← X.basicOpen_res p (homOfLE le_sup_right : D ⟶ C ⊔ D).op, hp0]
    exact X.basicOpen_zero D
  let e : Γ(X, ⊤) := X.presheaf.map (homOfLE hsup.ge : (⊤ : X.Opens) ⟶ C ⊔ D).op p
  refine ⟨e, hp.map (X.presheaf.map (homOfLE hsup.ge : (⊤ : X.Opens) ⟶ C ⊔ D).op).hom, ?_⟩
  have hle : X.basicOpen p ≤ C ⊔ D := X.basicOpen_le p
  calc X.basicOpen e = ⊤ ⊓ X.basicOpen p := X.basicOpen_res p _
    _ = (C ⊔ D) ⊓ X.basicOpen p := congrArg (· ⊓ X.basicOpen p) hsup.symm
    _ = C ⊓ X.basicOpen p ⊔ D ⊓ X.basicOpen p := inf_sup_right _ _ _
    _ = C := by rw [h1, h0, sup_bot_eq]

/-- **The basic open of an idempotent global section is clopen.** -/
theorem isClopen_basicOpen {X : Scheme.{u}} (e : Γ(X, ⊤)) (he : IsIdempotentElem e) :
    IsClopen (X.basicOpen e : Set X) := by
  have hdisj : ∀ x, x ∈ X.basicOpen e → x ∉ X.basicOpen (1 - e) := by
    intro x h1 h2
    have h3 : x ∈ X.basicOpen (e * (1 - e)) := by
      rw [X.basicOpen_mul]
      exact ⟨h1, h2⟩
    rw [show e * (1 - e) = 0 by rw [mul_sub, mul_one, he.eq, sub_self], X.basicOpen_zero] at h3
    exact h3
  have hcov : ∀ x, x ∈ X.basicOpen e ∨ x ∈ X.basicOpen (1 - e) := by
    intro x
    rw [X.mem_basicOpen_top, X.mem_basicOpen_top, map_sub, map_one]
    exact IsLocalRing.isUnit_or_isUnit_one_sub_self _
  refine ⟨?_, (X.basicOpen e).isOpen⟩
  have h : (X.basicOpen e : Set X) = (X.basicOpen (1 - e) : Set X)ᶜ := by
    ext x
    exact ⟨hdisj x, fun h => (hcov x).resolve_right h⟩
  rw [h]
  exact (X.basicOpen (1 - e)).isOpen.isClosed_compl

theorem isIntegral_of_idem {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] (e : A)
    (he : IsIdempotentElem e) : IsIntegral R e := by
  refine ⟨(Polynomial.X - Polynomial.C 0) * (Polynomial.X - Polynomial.C 1),
    (Polynomial.monic_X_sub_C 0).mul (Polynomial.monic_X_sub_C 1), ?_⟩
  rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
    Polynomial.eval₂_C, map_zero, map_one, sub_zero, mul_sub, mul_one, he.eq, sub_self]

end RamanujanPetersson.EtPBC.GenGeo

end

end

-- ===== S4.Def_RP_EtPBC_A_O2MV =====
section

/-!
# S4-EtPBC-A, O2 (MV route), MV: the Mayer-Vietoris sequence of free sheaves

For a commutative square `p₁ ≫ w = p₂ ≫ v` of `P.Etale` (`W' ⟶ W, U ⟶ Z`):
* `freeMap_comp`; `stalk_freeMap_injective`/`_surjective` (fibre map injective/surjective ⇒ stalk map so);
* `mvC`: the short complex `Λ[W'] ⟶ Λ[W] ⊞ Λ[U] ⟶ Λ[Z]` (maps `(Λ[p₁], -Λ[p₂])`, `Λ[w] + Λ[v]`);
* **`mvC_shortExact`**: short exact when every fibre of `Z` is subsingleton and at every point either the fibre of
  `W` is a singleton and `p₂` is bijective on fibres, or the fibre of `U` is a singleton and `p₁` is so;
* **`mv_exists`**: a class `β ∈ Ext^{n+1}(Λ[Z], F)` killed by `Λ[w]` and `Λ[v]` is `ε.comp κ`, `κ ∈ Ext^n(Λ[W'], F)`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtPBC.GenAlg

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

theorem stalk_biprod_eq {A B : EtSh Λ P} (x : P) (z : stalk Λ (A ⊞ B) x) :
    z = (((geomPtAt x).stalkF Λ).map biprod.inl).hom ((((geomPtAt x).stalkF Λ).map biprod.fst).hom z) +
      (((geomPtAt x).stalkF Λ).map biprod.inr).hom ((((geomPtAt x).stalkF Λ).map biprod.snd).hom z) := by
  have h := congrArg (fun φ => (((geomPtAt x).stalkF Λ).map φ).hom z) (biprod.total (X := A) (Y := B))
  simp only [Functor.map_add, Functor.map_comp, ModuleCat.hom_add, ModuleCat.hom_comp, LinearMap.add_apply,
    LinearMap.comp_apply] at h
  have hid : (((geomPtAt x).stalkF Λ).map (𝟙 (A ⊞ B))).hom z = z :=
    congrArg (fun φ => φ.hom z) (((geomPtAt x).stalkF Λ).map_id (A ⊞ B))
  exact (h.trans hid).symm

theorem stalk_biprod_ext {A B : EtSh Λ P} (x : P) {z z' : stalk Λ (A ⊞ B) x}
    (h1 : (((geomPtAt x).stalkF Λ).map biprod.fst).hom z = (((geomPtAt x).stalkF Λ).map biprod.fst).hom z')
    (h2 : (((geomPtAt x).stalkF Λ).map biprod.snd).hom z = (((geomPtAt x).stalkF Λ).map biprod.snd).hom z') :
    z = z' := by
  rw [stalk_biprod_eq x z, stalk_biprod_eq x z', h1, h2]

section Stalks

end Stalks

end RamanujanPetersson.EtPBC.EtMV

end

