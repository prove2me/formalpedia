variable {E : ℕ}
theorem solution (ext : Fin E → NLogN.IStmt NLogN.HS (7 + E)) :
    ∃ Kc : ℝ, 0 < Kc ∧ ∀ (Isym : List NLogN.Sym) {K r Z : ℕ}, 6 ≤ K → 1 ≤ r →
      80 * Z * (Z + 2) ≤ 2 ^ K →
      NLogN.KFN.RowHyp Isym (NLogN.KFM.kTable ext) K (100 ^ 3) r Z (NLogN.KFR.PsiR r Z) (Kc * (K + 2) + 1) NLogN.KFN.τ50 ∧
        0 ≤ Kc * (K + 2) + 1 ∧ Monotone (NLogN.KFR.PsiR r Z) ∧ ∀ v, Z + 2 ≤ NLogN.KFR.PsiR r Z v := by
  obtain ⟨Kc, hKc, H⟩ := NLogN.KFR.closedHyps_uncond
  refine ⟨Kc, hKc, fun Isym K r Z hK hr hKZ => ?_⟩
  obtain ⟨h1, h2, h3, h4⟩ := H Isym hK hr hKZ
  exact ⟨NLogN.KFM.RowHyp.relabel (NLogN.KFM.kTable_l12 ext) h1, h2, h3, h4⟩
end
