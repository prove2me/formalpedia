set_option autoImplicit false

namespace InfoLossLAR.WorstCase

open QAlgorithms.Complexity

/-- The actual published instruction semantics is complex-linear. -/
noncomputable def instrLinearMap {n : ℕ} (instruction : Instr n) :
    QState n →ₗ[ℂ] QState n where
  toFun := instruction.apply
  map_add' ψ φ := by
    funext x
    cases instruction <;>
      simp [Instr.apply, apply1, cnotState, mul_add, Finset.sum_add_distrib]
  map_smul' z ψ := by
    funext x
    cases instruction <;>
      simp [Instr.apply, apply1, cnotState, mul_left_comm, ← Finset.mul_sum]

/-- A sequential layer, with its actual fold order, as a linear map. -/
noncomputable def runLayerLinearMap {n : ℕ} (layer : List (Instr n)) :
    QState n →ₗ[ℂ] QState n :=
  layer.foldl (fun U instruction => (_root_.InfoLossLAR.WorstCase.instrLinearMap instruction).comp U) LinearMap.id

@[simp] theorem runLayerLinearMap_apply {n : ℕ} (layer : List (Instr n)) (ψ : QState n) :
    _root_.InfoLossLAR.WorstCase.runLayerLinearMap layer ψ = runLayer layer ψ := by
  have hfold (l : List (Instr n)) (U : QState n →ₗ[ℂ] QState n) :
      l.foldl (fun V instruction => (_root_.InfoLossLAR.WorstCase.instrLinearMap instruction).comp V) U ψ =
        runLayer l (U ψ) := by
    induction l generalizing U with
    | nil => rfl
    | cons i rest ih =>
      simpa only [List.foldl_cons, runLayer, _root_.InfoLossLAR.WorstCase.instrLinearMap, LinearMap.comp_apply,
        LinearMap.coe_mk, AddHom.coe_mk] using ih ((_root_.InfoLossLAR.WorstCase.instrLinearMap i).comp U)
  exact hfold layer LinearMap.id

/-- The circuit semantics as a linear map. -/
noncomputable def runLayeredLinearMap {n : ℕ} (circuit : Layered n) :
    QState n →ₗ[ℂ] QState n :=
  circuit.foldl (fun U layer => (_root_.InfoLossLAR.WorstCase.runLayerLinearMap layer).comp U) LinearMap.id

@[simp] theorem runLayeredLinearMap_apply {n : ℕ} (circuit : Layered n) (ψ : QState n) :
    _root_.InfoLossLAR.WorstCase.runLayeredLinearMap circuit ψ = runLayered circuit ψ := by
  have hfold (c : Layered n) (U : QState n →ₗ[ℂ] QState n) :
      c.foldl (fun V layer => (_root_.InfoLossLAR.WorstCase.runLayerLinearMap layer).comp V) U ψ =
        runLayered c (U ψ) := by
    induction c generalizing U with
    | nil => rfl
    | cons l rest ih =>
      simpa only [List.foldl_cons, runLayered, LinearMap.comp_apply,
        _root_.InfoLossLAR.WorstCase.runLayerLinearMap_apply] using ih ((_root_.InfoLossLAR.WorstCase.runLayerLinearMap l).comp U)
  exact hfold circuit LinearMap.id

/-- The complete concrete Clifford+T circuit preserves Euclidean norm. -/
noncomputable def circuitIsometry {n : ℕ} (circuit : Layered n) :
    EuclideanSpace ℂ (Bits n) →ₗᵢ[ℂ] EuclideanSpace ℂ (Bits n) where
  toFun ψ := WithLp.toLp 2 (runLayered circuit (WithLp.ofLp ψ))
  map_add' ψ φ := by
    apply WithLp.ofLp_injective
    simpa only [_root_.InfoLossLAR.WorstCase.runLayeredLinearMap_apply, WithLp.ofLp_add, WithLp.ofLp_toLp] using
      (_root_.InfoLossLAR.WorstCase.runLayeredLinearMap circuit).map_add (WithLp.ofLp ψ) (WithLp.ofLp φ)
  map_smul' z ψ := by
    apply WithLp.ofLp_injective
    simpa only [_root_.InfoLossLAR.WorstCase.runLayeredLinearMap_apply, WithLp.ofLp_smul, WithLp.ofLp_toLp, RingHom.id_apply] using
      (_root_.InfoLossLAR.WorstCase.runLayeredLinearMap circuit).map_smul z (WithLp.ofLp ψ)
  norm_map' ψ := by
    change ‖(WithLp.toLp 2 (runLayered circuit (WithLp.ofLp ψ)) : EuclideanSpace ℂ (Bits n))‖ = ‖ψ‖
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1
    simp only [EuclideanSpace.norm_sq_eq]
    simpa only [Complex.normSq_eq_norm_sq] using
      _root_.InfoLossLAR.WorstCase.runLayered_mass circuit (WithLp.ofLp ψ)

/-- Finite-dimensional norm preservation gives a semantic inverse for every circuit.
This does not claim a generator or a complexity bound for inverse circuit descriptions. -/
noncomputable def circuitUnitary {n : ℕ} (circuit : Layered n) :
    EuclideanSpace ℂ (Bits n) ≃ₗᵢ[ℂ] EuclideanSpace ℂ (Bits n) :=
  LinearIsometryEquiv.ofSurjective (_root_.InfoLossLAR.WorstCase.circuitIsometry circuit)
    ((LinearMap.injective_iff_surjective (f := (_root_.InfoLossLAR.WorstCase.circuitIsometry circuit).toLinearMap)).1
      (_root_.InfoLossLAR.WorstCase.circuitIsometry circuit).injective)

@[simp] theorem circuitUnitary_apply {n : ℕ} (circuit : Layered n)
    (ψ : EuclideanSpace ℂ (Bits n)) :
    _root_.InfoLossLAR.WorstCase.circuitUnitary circuit ψ = WithLp.toLp 2 (runLayered circuit (WithLp.ofLp ψ)) := rfl

end InfoLossLAR.WorstCase

end

section












































set_option autoImplicit false

namespace InfoLossLAR.WorstCase
open QAlgorithms.Complexity

/-- Composition on one wire is multiplication of the two-by-two gate matrices. -/
theorem apply1_comp {n : ℕ} (U V : Matrix Bool Bool ℂ) (i : Fin n) (ψ : QState n) :
    apply1 U i (apply1 V i ψ) = apply1 (U * V) i ψ := by
  funext x
  simp only [apply1, Function.update_self, Function.update_idem, Matrix.mul_apply]
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro b _
  apply Finset.sum_congr rfl
  intro c _
  ring

@[simp] theorem apply1_one {n : ℕ} (i : Fin n) (ψ : QState n) :
    apply1 1 i ψ = ψ := by
  funext x
  simp [apply1, Matrix.one_apply]

/-- Iterating an actual one-wire instruction is taking a matrix power. -/
theorem apply1_iterate {n : ℕ} (U : Matrix Bool Bool ℂ) (i : Fin n) (k : ℕ)
    (ψ : QState n) : (apply1 U i)^[k] ψ = apply1 (U ^ k) i ψ := by
  induction k generalizing ψ with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply, ih, _root_.InfoLossLAR.WorstCase.apply1_comp, pow_succ]

 theorem _root_.InfoLossLAR.WorstCase.hMat_sq : hMat ^ 2 = 1 := by
  simpa only [pow_two, hMat, QAlgorithms.hadamard, Complex.ofReal_inv] using QAlgorithms.hadamard_mul_self

 theorem _root_.InfoLossLAR.WorstCase.xMat_sq : xMat ^ 2 = 1 := by
  ext a b
  cases a <;> cases b <;> simp [pow_two, Matrix.mul_apply, xMat]

 theorem _root_.InfoLossLAR.WorstCase.sMat_four : sMat ^ 4 = 1 := by
  have hdiag : sMat = Matrix.diagonal (fun a : Bool => if a then Complex.I else 1) := by
    ext a b
    cases a <;> cases b <;> simp [sMat]
  rw [hdiag, Matrix.diagonal_pow]
  ext a b
  cases a <;> cases b <;> norm_num [Matrix.diagonal_apply]

 theorem _root_.InfoLossLAR.WorstCase.tMat_eight : tMat ^ 8 = 1 := by
  have hphase : Complex.exp (Complex.I * Real.pi / 4) ^ 8 = 1 := by
    rw [← Complex.exp_nat_mul]
    calc
      _ = Complex.exp (2 * Real.pi * Complex.I) := by congr 1; ring
      _ = 1 := Complex.exp_two_pi_mul_I
  have hdiag : tMat = Matrix.diagonal (fun a : Bool =>
      if a then Complex.exp (Complex.I * Real.pi / 4) else 1) := by
    ext a b
    cases a <;> cases b <;> simp [tMat]
  rw [hdiag, Matrix.diagonal_pow]
  ext a b
  cases a <;> cases b <;> simp [hphase]

/-- A period for each gate in the platform's fixed gate set. -/
def instrPeriod {n : ℕ} : Instr n → ℕ
  | .h _ => 2
  | .s _ => 4
  | .t _ => 8
  | .x _ => 2
  | .cnot _ _ _ => 2

/-- Every gate has an exact finite period, including the implemented CNOT permutation. -/
theorem instr_period {n : ℕ} (g : Instr n) (ψ : QState n) :
    (g.apply)^[_root_.InfoLossLAR.WorstCase.instrPeriod g] ψ = ψ := by
  cases g with
  | h i => simp only [_root_.InfoLossLAR.WorstCase.instrPeriod, Instr.apply, _root_.InfoLossLAR.WorstCase.apply1_iterate, _root_.InfoLossLAR.WorstCase.hMat_sq, _root_.InfoLossLAR.WorstCase.apply1_one]
  | s i => simp only [_root_.InfoLossLAR.WorstCase.instrPeriod, Instr.apply, _root_.InfoLossLAR.WorstCase.apply1_iterate, _root_.InfoLossLAR.WorstCase.sMat_four, _root_.InfoLossLAR.WorstCase.apply1_one]
  | t i => simp only [_root_.InfoLossLAR.WorstCase.instrPeriod, Instr.apply, _root_.InfoLossLAR.WorstCase.apply1_iterate, _root_.InfoLossLAR.WorstCase.tMat_eight, _root_.InfoLossLAR.WorstCase.apply1_one]
  | x i => simp only [_root_.InfoLossLAR.WorstCase.instrPeriod, Instr.apply, _root_.InfoLossLAR.WorstCase.apply1_iterate, _root_.InfoLossLAR.WorstCase.xMat_sq, _root_.InfoLossLAR.WorstCase.apply1_one]
  | cnot i j hij =>
    funext x
    simp only [_root_.InfoLossLAR.WorstCase.instrPeriod, Instr.apply, Function.iterate_succ_apply,
      Function.iterate_zero_apply, cnotState]
    congr 1
    funext k
    by_cases hkj : k = j
    · subst k
      simp [Function.update_of_ne hij]
    · simp [Function.update_of_ne hkj]


/-- The inverse uses only the same fixed gate set, with at most seven gates. -/
def inverseInstr {n : ℕ} (g : Instr n) : List (Instr n) :=
  List.replicate (_root_.InfoLossLAR.WorstCase.instrPeriod g - 1) g

theorem runLayer_replicate {n : ℕ} (k : ℕ) (g : Instr n) (ψ : QState n) :
    runLayer (List.replicate k g) ψ = (g.apply)^[k] ψ := by
  induction k generalizing ψ with
  | zero => rfl
  | succ k ih => simpa only [List.replicate_succ, runLayer, List.foldl_cons,
      Function.iterate_succ_apply] using ih (g.apply ψ)

@[simp] theorem inverseInstr_left {n : ℕ} (g : Instr n) (ψ : QState n) :
    runLayer (_root_.InfoLossLAR.WorstCase.inverseInstr g) (g.apply ψ) = ψ := by
  have hp : 1 ≤ _root_.InfoLossLAR.WorstCase.instrPeriod g := by cases g <;> simp [_root_.InfoLossLAR.WorstCase.instrPeriod]
  rw [_root_.InfoLossLAR.WorstCase.inverseInstr, _root_.InfoLossLAR.WorstCase.runLayer_replicate, ← Function.iterate_succ_apply,
    Nat.succ_eq_add_one, Nat.sub_add_cancel hp]
  exact _root_.InfoLossLAR.WorstCase.instr_period g ψ

@[simp] theorem inverseInstr_right {n : ℕ} (g : Instr n) (ψ : QState n) :
    g.apply (runLayer (_root_.InfoLossLAR.WorstCase.inverseInstr g) ψ) = ψ := by
  have hp : 1 ≤ _root_.InfoLossLAR.WorstCase.instrPeriod g := by cases g <;> simp [_root_.InfoLossLAR.WorstCase.instrPeriod]
  rw [_root_.InfoLossLAR.WorstCase.inverseInstr, _root_.InfoLossLAR.WorstCase.runLayer_replicate, ← Function.iterate_succ_apply' g.apply,
    Nat.succ_eq_add_one, Nat.sub_add_cancel hp]
  exact _root_.InfoLossLAR.WorstCase.instr_period g ψ



/-- Reverse the instruction sequence and replace each gate by its exact inverse. -/
def inverseGates {n : ℕ} (gates : List (Instr n)) : List (Instr n) :=
  gates.reverse.flatMap _root_.InfoLossLAR.WorstCase.inverseInstr

@[simp] theorem runLayer_append {n : ℕ} (gates rest : List (Instr n)) (ψ : QState n) :
    runLayer (gates ++ rest) ψ = runLayer rest (runLayer gates ψ) := by
  exact List.foldl_append

@[simp] theorem inverseGates_cons {n : ℕ} (g : Instr n) (gates : List (Instr n)) :
    _root_.InfoLossLAR.WorstCase.inverseGates (g :: gates) = _root_.InfoLossLAR.WorstCase.inverseGates gates ++ _root_.InfoLossLAR.WorstCase.inverseInstr g := by
  simp [_root_.InfoLossLAR.WorstCase.inverseGates]







































end InfoLossLAR.WorstCase




