theorem contDiffOn_c_div_pow (c : ℝ) (k : ℕ) (n : WithTop ℕ∞) {s : Set ℝ} (hs : ∀ x ∈ s, x ≠ 0) :
    ContDiffOn ℝ n (fun x => c / x ^ k) s :=
  contDiffOn_const.div (contDiffOn_id.pow k) (fun x hx => pow_ne_zero k (hs x hx))

theorem contDiffOn_bstar (Rh Ri Q j : ℝ) (n : WithTop ℕ∞) {s : Set ℝ} (hs : ∀ x ∈ s, x ≠ 0) :
    ContDiffOn ℝ n (bstar Rh Ri Q j) s := by
  have h := contDiffOn_c_div_pow (kc Rh Ri Q j) 1 n hs
  rw [bstar_eq]; simpa using h

/-- **Existence of the magnetic potential:** `L b_* = 2Qj/R³` on the exterior. -/
theorem Lop_bstar {Rh Ri Q j : ℝ} (hRi : 0 ≤ Ri) (hlt : Ri < Rh) (hQ : Q ^ 2 = 3 * Rh * Ri / 4)
    {R : ℝ} (hR : R ∈ Ioi Rh) : Lop Rh Ri Q (bstar Rh Ri Q j) R = 2 * Q * j / R ^ 3 := by
  have hR0 := (bg_pos hRi hlt hR).2.2.1
  rw [bstar_eq, Lop_c_div hQ _ hR0.ne']
  unfold kc
  field_simp [n1_ne hRi hlt]

theorem bstar_mag {Rh Ri Q j : ℝ} (hRi : 0 ≤ Ri) (hlt : Ri < Rh) :
    MagClass Rh (bstar Rh Ri Q j) := by
  have hRh : 0 < Rh := lt_of_le_of_lt hRi hlt
  refine ⟨contDiffOn_bstar Rh Ri Q j 2 (fun x hx => (bg_pos hRi hlt hx).2.2.1.ne'), ?_, ?_⟩
  · refine ⟨Rh / 2, by positivity, bstar Rh Ri Q j, ?_, fun _ _ => rfl⟩
    exact contDiffOn_bstar Rh Ri Q j 1 (fun x hx => by have := hx.1; intro h; rw [h] at this; linarith)
  · refine ⟨|kc Rh Ri Q j|, abs_nonneg _, Rh + 1, by linarith, fun R hR => ?_⟩
    have hR0 : 0 < R := by linarith
    rw [(hasDerivAt_bstar Rh Ri Q j hR0.ne').deriv, bstar_eq]
    refine ⟨le_of_eq ?_, le_of_eq ?_⟩
    · rw [abs_div, abs_of_pos hR0]
    · rw [abs_div, abs_neg, abs_of_pos (by positivity : (0 : ℝ) < R ^ 2)]

