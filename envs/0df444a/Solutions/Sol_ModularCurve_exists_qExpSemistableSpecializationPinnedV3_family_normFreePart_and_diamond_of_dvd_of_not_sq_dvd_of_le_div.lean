          (hI'f : (I'.subgroupOf (P.inertiaSubgroupIn ℚ)).FiniteIndex),
        ∀ y ∈ ModularCurve.normFreePartAt M p, ∀ (hy : y ∈ (𝒟 I hI hIμ hIf).dom)
          (hσy : ModularCurve.diamondOneBar M u (σ • y) ∈ (𝒟 I' hI' hI'μ hI'f).dom),
          (AlgebraicCurve.GluedPic0.toPic0Pair _
              ((𝒟 I' hI' hI'μ hI'f).sp ⟨ModularCurve.diamondOneBar M u (σ • y), hσy⟩)).2 =
            (AlgebraicCurve.GluedPic0.toPic0Pair _ ((𝒟 I hI hIμ hIf).sp ⟨y, hy⟩)).2) ∧

