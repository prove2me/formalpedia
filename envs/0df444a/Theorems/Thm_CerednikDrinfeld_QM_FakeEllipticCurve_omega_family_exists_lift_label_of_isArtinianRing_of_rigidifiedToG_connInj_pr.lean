          (g : S →ₐ[C] S') (x : PR.obj S),
          θ S' (PR.map g x) = (Omega K₀ π).map (g.restrictScalars 𝒪) (θ S x)))
    (hθ : (∀ (S : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (hS : IsNilpotent (algebraMap 𝒪 S π))
