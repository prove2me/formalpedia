theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ)
    (r : ℕ) (hδ : 0 < Φ.natDegree) (a : Fin (Φ.natDegree * r) → O)
    (ha : a ∈ TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r)) :
    ∃ B : Fin Φ.natDegree → Polynomial (AdjoinRoot Φ), (∀ i, (B i).Monic) ∧
      (∀ i, (B i).natDegree = r) ∧
      (∀ i, (B i).map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ i ^ r) ∧
      ∏ i, B i = (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) ∧
      (∀ B₀ : Polynomial (AdjoinRoot Φ), B₀.Monic → B₀.natDegree = r →
        B₀.map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ 0 ^ r →
        B₀ ∣ (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) → B₀ = B ⟨0, hδ⟩) ∧
      TypeDensity.selectBlock O Φ r a = TypeDensity.coeffVec r (B ⟨0, hδ⟩) ∧
      TypeDensity.monicPolyO (TypeDensity.selectBlock O Φ r a) = B ⟨0, hδ⟩ := by
  obtain ⟨B, ⟨hBm, hBd, hBr, hBp⟩, -⟩ := TypeDensity.block_splitting O Φ hΦ r a ha
  obtain ⟨_, _, _, hmax, -, hcomp, -, -⟩ := TypeDensity.unramified_is_dvr O Φ hΦ
  set i0 : Fin Φ.natDegree := ⟨0, hδ⟩
  have huniq : ∀ B₀ : Polynomial (AdjoinRoot Φ), B₀.Monic → B₀.natDegree = r →
      B₀.map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ 0 ^ r →
      B₀ ∣ (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) → B₀ = B i0 := by
    intro B₀ hB₀m hB₀d hB₀r hdvd
    obtain ⟨C₀, hC₀⟩ := hdvd
    have hC₀m : C₀.Monic := Polynomial.Monic.of_mul_monic_left hB₀m
      (hC₀ ▸ (TypeDensity.monic_poly_reconstruct O _ a).1.map _)
    set C := ∏ j ∈ Finset.univ.erase i0, B j
    have hprod : B i0 * C = B₀ * C₀ := by
      rw [Finset.mul_prod_erase _ _ (Finset.mem_univ _), hBp, hC₀]
    have hcop := (TypeDensity.conjugate_roots_distinct O Φ hΦ).2.2.2.2.2
    refine (TypeDensity.hensel_factor_unique_of_dvd (AdjoinRoot Φ) (B i0) C B₀ C₀ (hBm i0)
      (Polynomial.monic_prod_of_monic _ _ (fun j _ => hBm j)) hB₀m hC₀m hprod
      (TypeDensity.map_residue_eq_of_map_baseReduce_eq hmax (by rw [hBr, hB₀r]))
      (TypeDensity.isCoprime_map_residue hmax ?_)).1.symm
    rw [Polynomial.map_prod]
    refine IsCoprime.prod_right (fun j hj => ?_)
    rw [hBr, hBr]
    exact (hcop i0 j (Finset.ne_of_mem_erase hj).symm).pow
  have hw : ∃ B₀ : Polynomial (AdjoinRoot Φ), B₀.Monic ∧ B₀.natDegree = r ∧
      B₀.map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ 0 ^ r ∧
      B₀ ∣ (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) :=
    ⟨B i0, hBm i0, hBd i0, hBr i0, hBp ▸ Finset.dvd_prod_of_mem _ (Finset.mem_univ _)⟩
  have hs : TypeDensity.selectBlock O Φ r a = TypeDensity.coeffVec r (B i0) := by
    unfold TypeDensity.selectBlock
    rw [dif_pos hw]
    obtain ⟨h1, h2, h3, h4⟩ := Classical.choose_spec hw
    rw [huniq _ h1 h2 h3 h4]
  refine ⟨B, hBm, hBd, hBr, hBp, huniq, hs, ?_⟩
  rw [hs]
  exact (TypeDensity.monic_poly_reconstruct _ r (TypeDensity.coeffVec r (B i0))).2.2.2 _ (hBm i0) (hBd i0)
