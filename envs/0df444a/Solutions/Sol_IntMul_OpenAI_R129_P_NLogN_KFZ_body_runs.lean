theorem Regs.ev_P : xP.ok (NLogN.KIL.encK s F) ∧ xP.Bnd (NLogN.KIL.encK s F) B ∧ xP.eval (NLogN.KIL.encK s F) = p := by
  have := hB.big; unfold dlV at this
  exact ⟨ok_reg hR.P, bnd_reg hR.P (NLogN.KFZ.zsz_small (by omega)), eval_reg hR.P⟩

theorem Regs.ev_D : NLogN.KFZ.xD.ok (NLogN.KIL.encK s F) ∧ NLogN.KFZ.xD.Bnd (NLogN.KIL.encK s F) B ∧ NLogN.KFZ.xD.eval (NLogN.KIL.encK s F) = d := by
  have := hB.big; unfold dlV at this
  exact ⟨ok_reg hR.D, bnd_reg hR.D (NLogN.KFZ.zsz_small (by omega)), eval_reg hR.D⟩

theorem Regs.ev_L : NLogN.KFZ.eL.ok (NLogN.KIL.encK s F) ∧ NLogN.KFZ.eL.Bnd (NLogN.KIL.encK s F) B ∧
    NLogN.KFZ.eL.eval (NLogN.KIL.encK s F) = ((d * h + σ : ℕ) : ℤ) := by
  have := hB.big; unfold dlV at this
  have hdh : d * h ≤ d * h + σ := Nat.le_add_right _ _
  simp only [NLogN.KFZ.eL, NLogN.KFZ.xD, xH, NLogN.KFZ.xS, Ex.ok, Ex.Bnd, Ex.eval, top_encK hR.D, top_encK hR.H, top_encK hR.S]
  refine ⟨⟨⟨ok_reg hR.D, ok_reg hR.H⟩, ok_reg hR.S⟩, ⟨⟨NLogN.KFZ.zsz_small (by omega), NLogN.KFZ.zsz_small (by omega),
    by exact_mod_cast NLogN.KFZ.zsz_small (x := d * h) (by omega)⟩, NLogN.KFZ.zsz_small (by omega),
    by exact_mod_cast NLogN.KFZ.zsz_small (x := d * h + σ) (by omega)⟩, by push_cast; ring⟩

theorem Regs.ev_N : NLogN.KFZ.eN.ok (NLogN.KIL.encK s F) ∧ NLogN.KFZ.eN.Bnd (NLogN.KIL.encK s F) B ∧
    NLogN.KFZ.eN.eval (NLogN.KIL.encK s F) = 2 ^ (d * h + σ) := by
  obtain ⟨o, b, e⟩ := hR.ev_L (s := s) hB
  have := hB.big; unfold dlV at this
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_2N : e2N.ok (NLogN.KIL.encK s F) ∧ e2N.Bnd (NLogN.KIL.encK s F) B ∧
    e2N.eval (NLogN.KIL.encK s F) = ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ) := by
  obtain ⟨o, b, e⟩ := hR.ev_N (s := s) hB
  have := hB.big; unfold dlV at this
  show (True ∧ NLogN.KFZ.eN.ok (NLogN.KIL.encK s F)) ∧ (zsz (2 : ℤ) ≤ B ∧ NLogN.KFZ.eN.Bnd (NLogN.KIL.encK s F) B ∧
    zsz (2 * NLogN.KFZ.eN.eval (NLogN.KIL.encK s F)) ≤ B) ∧ 2 * NLogN.KFZ.eN.eval (NLogN.KIL.encK s F) = _
  rw [e]
  refine ⟨⟨trivial, o⟩, ⟨by rw [zsz_two']; omega, b,
    zszB (by positivity) (by rw [← pow_succ']) (k := d * h + σ + 1) (by omega)⟩, by push_cast; rfl⟩

theorem Regs.ev_Dl : eDl.ok (NLogN.KIL.encK s F) ∧ eDl.Bnd (NLogN.KIL.encK s F) B ∧
    eDl.eval (NLogN.KIL.encK s F) = (dlV p h d : ℤ) := by
  have := hB.big; unfold dlV at this ⊢
  simp only [eDl, xP, xH, NLogN.KFZ.xD, Ex.ok, Ex.Bnd, Ex.eval, top_encK hR.P, top_encK hR.H, top_encK hR.D]
  have z : ∀ x : ℕ, x ≤ 2 * p + 2 * h + d + 8 → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFZ.zsz_small (by omega)
  refine ⟨⟨⟨⟨trivial, ok_reg hR.P⟩, ⟨trivial, ok_reg hR.H⟩⟩, ⟨ok_reg hR.D, trivial⟩⟩, ⟨⟨⟨z 2 (by omega),
    z p (by omega), by exact_mod_cast z (2 * p) (by omega)⟩, ⟨z 2 (by omega), z h (by omega),
    by exact_mod_cast z (2 * h) (by omega)⟩, by exact_mod_cast z (2 * p + 2 * h) (by omega)⟩,
    ⟨z d (by omega), z 8 (by omega), by exact_mod_cast z (d + 8) (by omega)⟩,
    by exact_mod_cast z (2 * p + 2 * h + (d + 8)) (by omega)⟩, by push_cast; ring⟩

theorem Regs.ev_Dl2 : eDl2.ok (NLogN.KIL.encK s F) ∧ eDl2.Bnd (NLogN.KIL.encK s F) B ∧
    eDl2.eval (NLogN.KIL.encK s F) = 2 ^ dlV p h d := by
  obtain ⟨o, b, e⟩ := hR.ev_Dl (s := s) hB
  have := hB.big
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_G : eG.ok (NLogN.KIL.encK s F) ∧ eG.Bnd (NLogN.KIL.encK s F) B ∧
    eG.eval (NLogN.KIL.encK s F) = (NLogN.KFZ.gV p h d : ℤ) := by
  have := hB.big; unfold dlV at this; unfold NLogN.KFZ.gV
  simp only [eG, xP, xH, NLogN.KFZ.xD, Ex.ok, Ex.Bnd, Ex.eval, top_encK hR.P, top_encK hR.H, top_encK hR.D]
  have z : ∀ x : ℕ, x ≤ 2 * p + 2 * h + d + 8 → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFZ.zsz_small (by omega)
  refine ⟨⟨⟨ok_reg hR.P, ⟨trivial, ok_reg hR.H⟩⟩, ⟨ok_reg hR.D, trivial⟩⟩, ⟨⟨z p (by omega),
    ⟨z 2 (by omega), z h (by omega), by exact_mod_cast z (2 * h) (by omega)⟩,
    by exact_mod_cast z (p + 2 * h) (by omega)⟩,
    ⟨z d (by omega), z 8 (by omega), by exact_mod_cast z (d + 8) (by omega)⟩,
    by exact_mod_cast z (p + 2 * h + (d + 8)) (by omega)⟩, by push_cast; ring⟩

theorem Regs.ev_G2 : eG2.ok (NLogN.KIL.encK s F) ∧ eG2.Bnd (NLogN.KIL.encK s F) B ∧
    eG2.eval (NLogN.KIL.encK s F) = 2 ^ NLogN.KFZ.gV p h d := by
  obtain ⟨o, b, e⟩ := hR.ev_G (s := s) hB
  have := hB.big; unfold dlV at this; unfold NLogN.KFZ.gV
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_P2 : eP2.ok (NLogN.KIL.encK s F) ∧ eP2.Bnd (NLogN.KIL.encK s F) B ∧
    eP2.eval (NLogN.KIL.encK s F) = 2 ^ p := by
  obtain ⟨o, b, e⟩ := hR.ev_P (s := s) hB
  have := hB.big; unfold dlV at this
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_Hk (k : ℕ) (hk : k ≤ 2) : (Ex.add xH (.lit (k : ℤ))).ok (NLogN.KIL.encK s F) ∧
    (Ex.add xH (.lit (k : ℤ))).Bnd (NLogN.KIL.encK s F) B ∧
    (Ex.add xH (.lit (k : ℤ))).eval (NLogN.KIL.encK s F) = ((h + k : ℕ) : ℤ) := by
  have := hB.big; unfold dlV at this
  simp only [xH, Ex.ok, Ex.Bnd, Ex.eval, top_encK hR.H]
  exact ⟨⟨ok_reg hR.H, trivial⟩, ⟨NLogN.KFZ.zsz_small (by omega), NLogN.KFZ.zsz_small (by omega),
    by exact_mod_cast NLogN.KFZ.zsz_small (x := h + k) (by omega)⟩, by push_cast; ring⟩

theorem Regs.ev_R : eR.ok (NLogN.KIL.encK s F) ∧ eR.Bnd (NLogN.KIL.encK s F) B ∧ eR.eval (NLogN.KIL.encK s F) = 2 ^ (h + 1) := by
  obtain ⟨o, b, e⟩ := hR.ev_Hk (s := s) hB 1 (by norm_num)
  have := hB.big; unfold dlV at this
  simp only [Nat.cast_one] at o b e
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_2R : e2R.ok (NLogN.KIL.encK s F) ∧ e2R.Bnd (NLogN.KIL.encK s F) B ∧
    e2R.eval (NLogN.KIL.encK s F) = 2 ^ (h + 2) := by
  obtain ⟨o, b, e⟩ := hR.ev_Hk (s := s) hB 2 (by norm_num)
  have := hB.big; unfold dlV at this
  simp only [Nat.cast_ofNat] at o b e
  exact ev_pow2 o b e (by omega)

theorem Regs.ev_No : eNo.ok (NLogN.KIL.encK s F) ∧ eNo.Bnd (NLogN.KIL.encK s F) B ∧
    eNo.eval (NLogN.KIL.encK s F) = 2 ^ (d * h + σ - (h + 1)) := by
  obtain ⟨o, b, e⟩ := hR.ev_L (s := s) hB
  obtain ⟨o1, b1, e1⟩ := hR.ev_Hk (s := s) hB 1 (by norm_num)
  simp only [Nat.cast_one] at o1 b1 e1
  have := hB.big; have hL := hB.hL; unfold dlV at this
  have ev : ((d * h + σ : ℕ) : ℤ) + -((h + 1 : ℕ) : ℤ) = ((d * h + σ - (h + 1) : ℕ) : ℤ) := by
    rw [Nat.cast_sub hL]; ring
  have oA : (Ex.add NLogN.KFZ.eL (.neg (.add xH (.lit 1)))).ok (NLogN.KIL.encK s F) := ⟨o, o1⟩
  have eA : (Ex.add NLogN.KFZ.eL (.neg (.add xH (.lit 1)))).eval (NLogN.KIL.encK s F) =
      ((d * h + σ - (h + 1) : ℕ) : ℤ) := by
    show NLogN.KFZ.eL.eval (NLogN.KIL.encK s F) + -(Ex.add xH (.lit 1)).eval (NLogN.KIL.encK s F) = _
    rw [e, e1, ev]
  have bA : (Ex.add NLogN.KFZ.eL (.neg (.add xH (.lit 1)))).Bnd (NLogN.KIL.encK s F) B := by
    show NLogN.KFZ.eL.Bnd (NLogN.KIL.encK s F) B ∧ (Ex.add xH (.lit 1)).Bnd (NLogN.KIL.encK s F) B ∧
      zsz (NLogN.KFZ.eL.eval (NLogN.KIL.encK s F) + -(Ex.add xH (.lit 1)).eval (NLogN.KIL.encK s F)) ≤ B
    refine ⟨b, b1, ?_⟩
    rw [e, e1, ev]; exact NLogN.KFZ.zsz_small (by omega)
  exact ev_pow2 oA bA eA (by omega)

end Ev

section Setter

variable {s : IState HS} {F : Fin HS → List ℤ} {B : ℕ}

theorem setter (l : List (Fin HS × Ex HS))
    (hl : ∀ q ∈ l, q.1.val < 56 ∧ q.2.Clean ∧ q.2.size ≤ 30 ∧ q.2.ok (NLogN.KIL.encK s F) ∧
      q.2.Bnd (NLogN.KIL.encK s F) B ∧ ∀ q' ∈ l, q'.1 ∉ q.2.regs)
    (vs : List (Fin HS × ℤ)) (hvs : l.map (fun q => (q.1, q.2.eval (NLogN.KIL.encK s F))) = vs) :
    Sp (pushes l) (NLogN.KIL.encK s F) (NLogN.KIL.encK s (pushF F vs)) (l.length * (31 * 10 ^ 7 * (B + 2) ^ 2) + 1) ∧
    Sp (NLogN.KFZ.popsL (l.map Prod.fst)) (NLogN.KIL.encK s (pushF F vs)) (NLogN.KIL.encK s F) (l.length * (2 * B + 2) + 1) := by
  constructor
  · rw [← hvs]; exact pushes_sp s B 30 l F hl
  · have e1 : l.map Prod.fst = vs.map Prod.fst := by rw [← hvs, List.map_map]; rfl
    have e2 : l.length = vs.length := by rw [← hvs, List.length_map]
    rw [e1, e2]
    refine NLogN.KFZ.popsL_sp s B vs F (fun q hq => ?_)
    rw [← hvs] at hq
    obtain ⟨q0, hq0, rfl⟩ := List.mem_map.1 hq
    obtain ⟨a1, -, -, -, a5, -⟩ := hl q0 hq0
    exact ⟨a1, Ex.zsz_eval_le _ B _ a5⟩

variable {p h d σ K : ℕ} (hR : Regs F p h d σ K) (hB : RB p h d σ K B)
include hR hB

theorem z01 (c : ℕ) (hc : c ≤ 1) : zsz (c : ℤ) ≤ B := by
  have := hB.big; unfold dlV at this; exact NLogN.KFZ.zsz_small (by omega)

theorem Regs.sT1 :
    let vs : List (Fin HS × ℤ) := [(NLogN.KFM.pR, 2 ^ dlV p h d), (rDl, (dlV p h d : ℤ)), (aX, (d : ℤ))]
    Sp (pushes setT1) (NLogN.KIL.encK s F) (NLogN.KIL.encK s (pushF F vs)) (3 * (31 * 10 ^ 7 * (B + 2) ^ 2) + 1) ∧
    Sp (NLogN.KFZ.popsL (setT1.map Prod.fst)) (NLogN.KIL.encK s (pushF F vs)) (NLogN.KIL.encK s F) (3 * (2 * B + 2) + 1) := by
  intro vs
  obtain ⟨o1, b1, e1⟩ := hR.ev_Dl2 (s := s) hB
  obtain ⟨o2, b2, e2⟩ := hR.ev_Dl (s := s) hB
  obtain ⟨o3, b3, e3⟩ := hR.ev_D (s := s) hB
  refine setter setT1 (fun q hq => ?_) vs (by simp only [setT1, List.map, e1, e2, e3, vs])
  simp only [setT1, List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o1, b1, by decide⟩
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o2, b2, by decide⟩
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o3, b3, by decide⟩

theorem Regs.sRC :
    let vs : List (Fin HS × ℤ) := [(nX2, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)),
      (nX, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)), (pX2, 0), (NLogN.KFM.pR, 2 ^ NLogN.KFZ.gV p h d)]
    Sp (pushes setRC) (NLogN.KIL.encK s F) (NLogN.KIL.encK s (pushF F vs)) (4 * (31 * 10 ^ 7 * (B + 2) ^ 2) + 1) ∧
    Sp (NLogN.KFZ.popsL (setRC.map Prod.fst)) (NLogN.KIL.encK s (pushF F vs)) (NLogN.KIL.encK s F) (4 * (2 * B + 2) + 1) := by
  intro vs
  obtain ⟨o1, b1, e1⟩ := hR.ev_2N (s := s) hB
  obtain ⟨o2, b2, e2⟩ := hR.ev_G2 (s := s) hB
  refine setter setRC (fun q hq => ?_) vs (by simp only [setRC, List.map, e1, e2, vs, Ex.eval])
  simp only [setRC, List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl | rfl
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o1, b1, by decide⟩
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o1, b1, by decide⟩
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, trivial,
      by exact z01 hR hB 0 (by norm_num), by decide⟩
  · exact ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by decide, o2, b2, by decide⟩

