theorem cLoop2_le {pk b φD B BH J Z Φ : ℕ} {φT : ℕ → ℕ} :
    ∀ ds : List (ℕ × List ℤ × List ℤ),
      (∀ d ∈ ds, Nat.clog 2 (2 * d.1) ≤ J ∧ zsz ((b * (2 * d.1) : ℕ) : ℤ) ≤ Z ∧
        φT d.1 ≤ (d.1 + 1) * Φ) →
      cLoop2 pk b φD φT B BH ds ≤ (sumN ds + ds.length) * Yb pk b φD Φ B BH J Z + 30
  | [], _ => by simp [cLoop2]
  | d :: ds, h => by
    obtain ⟨h1, h2, h3⟩ := h d (List.mem_cons_self ..)
    have hb := cBlk2_le (pk := pk) (φD := φD) (B := B) (BH := BH) h1 h2 h3
    have ih := cLoop2_le (pk := pk) (φD := φD) (B := B) (BH := BH) ds
      (fun d' hd' => h d' (List.mem_cons_of_mem _ hd'))
    simp only [cLoop2, sumN, List.length_cons]
    have e : (d.1 + sumN ds + (ds.length + 1)) * Yb pk b φD Φ B BH J Z =
        (d.1 + 1) * Yb pk b φD Φ B BH J Z + (sumN ds + ds.length) * Yb pk b φD Φ B BH J Z := by ring
    rw [e]; omega

theorem length_dsEnc2 (b : ℕ) : ∀ ds : List (ℕ × List ℤ × List ℤ),
    (∀ d ∈ ds, d.2.1.length = d.1 ∧ d.2.2.length = d.1) →
      (dsEnc2 b ds).length = 4 * ds.length + 2 * sumN ds
  | [], _ => by simp [dsEnc2, sumN]
  | d :: ds, h => by
    obtain ⟨h1, h2⟩ := h d (List.mem_cons_self ..)
    have ih := length_dsEnc2 b ds (fun d' hd' => h d' (List.mem_cons_of_mem _ hd'))
    simp only [dsEnc2, List.flatMap_cons, List.length_append, sumN, List.length_cons] at ih ⊢
    rw [ih, length_encD2, h1, h2]; ring

theorem length_le_sumN : ∀ ds : List (ℕ × List ℤ × List ℤ), (∀ d ∈ ds, 1 ≤ d.1) →
    ds.length ≤ sumN ds
  | [], _ => by simp [sumN]
  | d :: ds, h => by
    have := h d (List.mem_cons_self ..)
    have ih := length_le_sumN ds (fun d' hd' => h d' (List.mem_cons_of_mem _ hd'))
    simp only [sumN, List.length_cons]; omega

/-- **The chunk kernel in closed form.** -/
theorem cKer2_le {pk b lam φD B BH J Z Φ : ℕ} {φT : ℕ → ℕ} (ds : List (ℕ × List ℤ × List ℤ))
    (hds : ∀ d ∈ ds, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧
      Nat.clog 2 (2 * d.1) ≤ J ∧ zsz ((b * (2 * d.1) : ℕ) : ℤ) ≤ Z ∧ φT d.1 ≤ (d.1 + 1) * Φ)
    (hsum : sumN ds ≤ lam) :
    cKer2 pk b lam φD φT B BH ds ≤
      10 ^ 9 * (lam + 1) * (BH + B + 2) + 2 * lam * Yb pk b φD Φ B BH J Z + 10 ^ 4 := by
  have hL := cLoop2_le (pk := pk) (φD := φD) (B := B) (BH := BH) (J := J) (Z := Z) (Φ := Φ)
    (φT := φT) ds (fun d hd => by obtain ⟨_, _, _, a, b', c⟩ := hds d hd; exact ⟨a, b', c⟩)
  have hE := length_dsEnc2 b ds (fun d hd => by obtain ⟨_, a, b', _⟩ := hds d hd; exact ⟨a, b'⟩)
  have hn := length_le_sumN ds (fun d hd => (hds d hd).1)
  have hY : (sumN ds + ds.length) * Yb pk b φD Φ B BH J Z ≤ 2 * lam * Yb pk b φD Φ B BH J Z :=
    Nat.mul_le_mul_right _ (by omega)
  unfold cKer2 cMvP
  rw [hE]
  have h2 : 2 * (lam - sumN ds) ≤ 2 * lam := by omega
  have h3 : (8 + 4 * lam + (4 * ds.length + 2 * sumN ds)) ≤ 10 * (lam + 1) := by omega
  have h4 : (8 + 4 * lam + (4 * ds.length + 2 * sumN ds)) * (14000 * (BH + 2)) ≤
      10 * (lam + 1) * (14000 * (BH + 2)) := Nat.mul_le_mul_right _ h3
  have h5 : (2 * (lam - sumN ds) + 1) * 40000 * (BH + 2) ≤ (2 * lam + 1) * 40000 * (BH + 2) := by
    apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; omega
  have m1 : (lam + 1) * (BH + 2) ≤ (lam + 1) * (BH + B + 2) := Nat.mul_le_mul_left _ (by omega)
  have m2 : (lam + 1) * (B + 2) ≤ (lam + 1) * (BH + B + 2) := Nat.mul_le_mul_left _ (by omega)
  have m3 : BH + 2 ≤ (lam + 1) * (BH + B + 2) := by
    calc BH + 2 ≤ BH + B + 2 := by omega
      _ ≤ (lam + 1) * (BH + B + 2) := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : (lam + 1) * 40000 * (BH + 2) = 40000 * ((lam + 1) * (BH + 2)) := by ring
  have e2 : (lam + 1) * 40000 * (B + 2) = 40000 * ((lam + 1) * (B + 2)) := by ring
  have e3 : (2 * lam + 1) * 40000 * (BH + 2) ≤ 80000 * ((lam + 1) * (BH + 2)) := by
    calc (2 * lam + 1) * 40000 * (BH + 2) ≤ (2 * (lam + 1)) * 40000 * (BH + 2) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by omega))
      _ = 80000 * ((lam + 1) * (BH + 2)) := by ring
  have e4 : 10 * (lam + 1) * (14000 * (BH + 2)) = 140000 * ((lam + 1) * (BH + 2)) := by ring
  have e5 : 10 ^ 9 * (lam + 1) * (BH + B + 2) = 1000000000 * ((lam + 1) * (BH + B + 2)) := by ring
  rw [e1, e2, e5, show (10 : ℕ) ^ 4 = 10000 by norm_num]
  omega

end J6Seg.KR

end

