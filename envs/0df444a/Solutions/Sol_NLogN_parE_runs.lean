  have hzk : NLogN.zsz (k : ℤ) ≤ n := le_trans (NLogN.zsz_natCast_le_self k) hkn
  have e1 : -(k : ℤ) + n = ((n - k : ℕ) : ℤ) := by omega
  have e2 : -1 + (n : ℤ) = ((n - 1 : ℕ) : ℤ) := by omega
  have hz1 : NLogN.zsz ((n - k : ℕ) : ℤ) ≤ n := le_trans (NLogN.zsz_natCast_le (by omega)) hzn
  have hz2 : NLogN.zsz ((n - 1 : ℕ) : ℤ) ≤ n := le_trans (NLogN.zsz_natCast_le (by omega)) hzn
  set s1 := s.upd NLogN.PW (.int (n - k : ℕ) :: s.G NLogN.PW) with hs1
  have h1 : NLogN.IRuns I iprog (.seq (.op (.dup NLogN.T3 NLogN.PW)) (.seq (.op (.dup NLogN.T1 NLogN.T4)) (.seq (.op (.neg NLogN.T4))
      (.op (.add NLogN.T4 NLogN.PW NLogN.PW))))) s s1 (2000 * (n + 3)) := by
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, hT3, hT1, e1]
    refine ⟨by rw [hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := NLogN.dupCost_le (NLogN.zsz (n : ℤ)); have := NLogN.dupCost_le (NLogN.zsz (k : ℤ))
    have := NLogN.addIntCost_mono (show NLogN.zsz (-(k : ℤ)) + NLogN.zsz (n : ℤ) ≤ 2 * n by rw [NLogN.zsz_neg]; omega)
    have := NLogN.addIntCost_le (2 * n)
    omega
  have h2 := NLogN.pow2_runs (I := I) pP hP (n - k) s1 (s.G NLogN.PW) (by simp [s1])
  set s2 := s1.upd NLogN.PW (.int (2 ^ (n - k)) :: s.G NLogN.PW) with hs2
  set s3 := (s2.upd NLogN.W2 (.int (2 ^ (n - k)) :: s.G NLogN.W2)).upd NLogN.PW (.int (n - 1 : ℕ) :: s.G NLogN.PW) with hs3
  have h3 : NLogN.IRuns I iprog (.seq (.op (.mv NLogN.PW NLogN.W2)) (.seq (.op (.dup NLogN.T3 NLogN.PW)) (.seq (.op (.const NLogN.T4 (-1)))
      (.op (.add NLogN.T4 NLogN.PW NLogN.PW))))) s2 s3 (2000 * (n + 3)) := by
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, hs2, hs1, hT3, e2, NLogN.zsz_neg_one]
    refine ⟨by rw [hs3, hs2, hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ (n - k))); have := NLogN.zsz_two_pow (n - k)
    have := NLogN.dupCost_le (NLogN.zsz (n : ℤ))
    have := NLogN.addIntCost_mono (show 1 + NLogN.zsz (n : ℤ) ≤ 2 * n by omega)
    have := NLogN.addIntCost_le (2 * n)
    omega
  have h4 := NLogN.pow2_runs (I := I) pP hP (n - 1) s3 (s.G NLogN.PW) (by simp [s3])
  have h5g : ∀ s' : NLogN.IState NLogN.NS, s'.G NLogN.PW = .int (2 ^ (n - 1)) :: s.G NLogN.PW → s'.G NLogN.T3 = .int n :: L3 →
      s'.G NLogN.T2 = .int Q :: L2 → s'.G NLogN.T1 = .int k :: L1 → s'.G NLogN.ZZ = .int ℓ :: LZ →
      NLogN.IRuns I iprog (.seq (.op (.mv NLogN.PW NLogN.HB)) (.seq (.op (.mv NLogN.T3 NLogN.PRM)) (.seq (.op (.drop NLogN.T2))
        (.seq (.op (.drop NLogN.T1)) (.op (.drop NLogN.ZZ)))))) s'
        ((((((s'.upd NLogN.PW (s.G NLogN.PW)).upd NLogN.HB (.int (2 ^ (n - 1)) :: s'.G NLogN.HB)).upd NLogN.T3 L3).upd NLogN.PRM
          (.int n :: s'.G NLogN.PRM)).upd NLogN.T2 L2).upd NLogN.T1 L1 |>.upd NLogN.ZZ LZ) (2000 * (N + 3)) := by
    intro s' h hh3 hh2 hh1 hhz
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, h, hh3, hh2, hh1, hhz]
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ (n - 1))); have := NLogN.zsz_two_pow (n - 1)
    have := NLogN.moveIntCost_le (NLogN.zsz (n : ℤ))
    have := NLogN.zsz_natCast_le_self Q; have := NLogN.zsz_natCast_le_self ℓ
    omega
  have h5 := h5g (s3.upd NLogN.PW (.int (2 ^ (n - 1)) :: s.G NLogN.PW)) (by simp)
    (by simp +decide [s3, s2, s1, hT3]) (by simp +decide [s3, s2, s1, hT2])
    (by simp +decide [s3, s2, s1, hT1]) (by simp +decide [s3, s2, s1, hZ])
  refine (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 (NLogN.IRuns.seq h3 (NLogN.IRuns.seq h4 h5)))).mono' ?_ ?_
  · simp only [hs3, hs2, hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · simp only [NLogN.pow2CostS]; omega
end
