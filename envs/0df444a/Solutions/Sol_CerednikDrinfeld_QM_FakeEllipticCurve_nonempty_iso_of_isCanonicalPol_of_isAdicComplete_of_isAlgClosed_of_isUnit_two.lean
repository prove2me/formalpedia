theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (N : ℕ) (R : Type) [CommRing R] (h2 : IsUnit (2 : R)) [IsLocalRing R] [IsNoetherianRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] [IsAlgClosed (IsLocalRing.ResidueField R)]
    (E : FakeEllipticCurve Λ N R)
    (𝓛 𝓛' : E.A.Modules) (h : E.IsCanonicalPol star 𝓛) (h' : E.IsCanonicalPol star 𝓛') :
    Nonempty (𝓛 ≅ 𝓛') := by

  have hne : ∀ k : ℕ, IsLocalRing.maximalIdeal R ^ (k + 1) ≠ ⊤ := fun k =>
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.pow_le_self (Nat.succ_ne_zero k))
  have inst_nt : ∀ k : ℕ, Nontrivial (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1)) := fun k => Ideal.Quotient.nontrivial_iff.mpr (hne k)
  have inst_loc : ∀ k : ℕ, IsLocalRing (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1)) := fun k =>
    haveI := inst_nt k; IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have inst_ac : ∀ k : ℕ, @IsAlgClosed (@IsLocalRing.ResidueField (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1)) _ (inst_loc k)) _ := by
    intro k
    letI := inst_nt k; letI := inst_loc k
    haveI : IsLocalHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (k + 1))) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hs : Function.Surjective (IsLocalRing.ResidueField.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (k + 1)))) := by
      intro y
      obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact ⟨IsLocalRing.residue R r, by simp [IsLocalRing.ResidueField.map_residue]⟩
    exact IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _
      ⟨(IsLocalRing.ResidueField.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (k + 1)))).injective, hs⟩)
  have inst_art : ∀ k : ℕ, @IsArtinianRing (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1)) _ := by
    intro k
    letI := inst_nt k; letI := inst_loc k
    haveI : IsLocalHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (k + 1))) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    refine (isArtinianRing_iff_isNilpotent_maximalIdeal _).mpr ⟨k + 1, ?_⟩
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective,
      ← Ideal.map_pow, Ideal.map_quotient_self]
    rfl

  let AR := pullback E.f (Spec.map (CommRingCat.ofHom (algebraMap R R)))
  let fstR := pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap R R)))
  have hw : ∀ k : ℕ, pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap R (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1))))) ≫ E.f
