/-- `∂_c Γ_{a,db} = ½(∂_c∂_b g_{ad} + ∂_c∂_d g_{ab} − ∂_c∂_a g_{db})`. -/
theorem pd_chr1 (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (c a d b : Fin n) :
    pd c (chr1 g a d b) y = (hessG g c b a d y + hessG g c d a b y - hessG g c a d b y) / 2 := by
  have hU := hm.isOpen
  have h := (((hasDerivAt_pd hU (contDiffOn_pd hU (hm.smooth a d) b) hy c).add
    (hasDerivAt_pd hU (contDiffOn_pd hU (hm.smooth a b) d) hy c)).sub
    (hasDerivAt_pd hU (contDiffOn_pd hU (hm.smooth d b) a) hy c)).div_const 2
  exact pd_eq_of_hasDerivAt h

end formula

