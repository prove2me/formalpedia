section FramedPtConstr

variable {B : Type} [CommRing B] {N g : ℕ} (P : Polynomial ℚ) (m : ℕ) (C : KCtx B N g (hilbertFunctionOf N P m)) (n : ℕ)
  (hFH : ∀ (R : Type) [CommRing R] (Xf : FramedPolarisedAbelianScheme g N n R),
      ∃ q : Point R N (hilbertFunctionOf N P m), ∀ (d : ℕ), m ≤ d →
        ∀ (F : MvPolynomial (Fin (N + 1)) R) (hF : F.IsHomogeneous d),
          (F ∈ q.I ↔ ∀ i : Fin (N + 1),
            Xf.frame.toProj.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0))
  (hΦ5 : ∀ (A : Type) [CommRing A] (p : Point A N (hilbertFunctionOf N P m)) (d : ℕ), m ≤ d →
      ∀ (F : MvPolynomial (Fin (N + 1)) A) (hF : F.IsHomogeneous d),
        (F ∈ p.I ↔ ∀ i : Fin (N + 1),
            (C.Φ A p).2.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0))
  (hUNIQ : ∀ (A : Type) [CommRing A] (Z Z' : Scheme.{0})
      (ι : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
      (ι' : Z' ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)),
      IsClosedImmersion ι → IsClosedImmersion ι' →
      (∀ (d : ℕ), m ≤ d → ∀ (F : MvPolynomial (Fin (N + 1)) A) (hF : F.IsHomogeneous d),
        ((∀ i : Fin (N + 1),
            ι.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0) ↔ (∀ i : Fin (N + 1),
            ι'.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0))) →
      ∃ e : Z ≅ Z', e.hom ≫ ι' = ι)

noncomputable def fpt (R : Type) [CommRing R] (Xf : FramedPolarisedAbelianScheme g N n R) : Point R N (hilbertFunctionOf N P m) :=
  (hFH R Xf).choose

theorem fpt_spec (R : Type) [CommRing R] (Xf : FramedPolarisedAbelianScheme g N n R) :
    ∀ (d : ℕ), m ≤ d → ∀ (F : MvPolynomial (Fin (N + 1)) R) (hF : F.IsHomogeneous d),
      (F ∈ (fpt P m n hFH R Xf).I ↔ ∀ i : Fin (N + 1),
            Xf.frame.toProj.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0) :=
  (hFH R Xf).choose_spec

include hΦ5 hUNIQ in

theorem fpt_iso (R : Type) [CommRing R] (Xf : FramedPolarisedAbelianScheme g N n R) :
    ∃ e : (C.Φ R (fpt P m n hFH R Xf)).1 ≅ Xf.A, e.hom ≫ Xf.frame.toProj = (C.Φ R (fpt P m n hFH R Xf)).2 :=
  hUNIQ R _ _ (C.Φ R (fpt P m n hFH R Xf)).2 Xf.frame.toProj (C.Φ_closed R _).1 Xf.frame_isClosedImmersion
    (fun d hd F hF => ((hΦ5 R _ d hd F hF).symm.trans (fpt_spec P m n hFH R Xf d hd F hF)))

theorem isPullback_over_projSpace {R R' : Type} [CommRing R] [CommRing R'] [Algebra R R']
    {Z Z' : Scheme.{0}} (ι : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R))
    (ι' : Z' ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R')) (e : Z' ⟶ Z)
    (hsq : IsPullback e (ι' ≫ ProjSpace.π R' N) (ι ≫ ProjSpace.π R N) (Spec.map (CommRingCat.ofHom (algebraMap R R'))))
    (hcomp : e ≫ ι = ι' ≫ ProjSpace.map R R' N) :
    IsPullback e ι' ι (ProjSpace.map R R' N) :=
  IsPullback.of_bot (by simpa only [Category.assoc] using hsq) hcomp (AlgebraicGeometry.ProjSpace.isPullback_map R R' N)

include hΦ5 hUNIQ in

theorem fpt_nat (R R' : Type) [CommRing R] [CommRing R'] [Algebra B R] [Algebra B R'] (φ : R →ₐ[B] R')
    (Xf : FramedPolarisedAbelianScheme g N n R) (Xf' : FramedPolarisedAbelianScheme g N n R')
    (hX : FramedPolarisedAbelianScheme.IsPullback φ.toRingHom Xf Xf') :
    (fpt P m n hFH R' Xf').I = Ideal.map (MvPolynomial.map φ.toRingHom) (fpt P m n hFH R Xf).I := by
  letI : Algebra R R' := φ.toRingHom.toAlgebra
  obtain ⟨y, hy⟩ := C.ptH_map R R' φ.toRingHom (fpt P m n hFH R Xf)
  rw [← hy]
  congr 1
  symm

  obtain ⟨ebc, hpb, hcomp⟩ := C.Φ_bc R R' (fpt P m n hFH R Xf) y hy
  obtain ⟨eR, heR⟩ := fpt_iso P m C n hFH hΦ5 hUNIQ R Xf
  obtain ⟨eR', heR'⟩ := fpt_iso P m C n hFH hΦ5 hUNIQ R' Xf'
  obtain ⟨gA, hg, -, -, -, hframe⟩ := hX
  apply C.Φ_inj R' y (fpt P m n hFH R' Xf')

  have sq1 : IsPullback (ebc ≫ eR.hom) (C.Φ R' y).2 Xf.frame.toProj (ProjSpace.map R R' N) := by
    have h0 : IsPullback ebc (C.Φ R' y).2 (C.Φ R (fpt P m n hFH R Xf)).2 (ProjSpace.map R R' N) :=
      isPullback_over_projSpace _ _ ebc hpb hcomp

    refine IsPullback.of_iso h0 (Iso.refl _) eR (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp [heR]
    · simp
  have sq2 : IsPullback gA Xf'.frame.toProj Xf.frame.toProj (ProjSpace.map R R' N) := by
    refine isPullback_over_projSpace _ _ gA ?_ hframe.symm
    rw [Xf'.frame.toProj_π, Xf.frame.toProj_π]; exact hg

  let E : (C.Φ R' y).1 ≅ Xf'.A := sq1.isoIsPullback _ _ sq2
  have hE : E.hom ≫ Xf'.frame.toProj = (C.Φ R' y).2 := IsPullback.isoIsPullback_hom_snd _ _ _ _
  exact ⟨E ≪≫ eR'.symm, by rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, ← heR', Iso.inv_hom_id_assoc, hE]⟩

noncomputable def framedPt : C.FramedPt n :=
  ⟨fun R _ _ Xf => fpt P m n hFH R Xf, fun R _ _ Xf => fpt_iso P m C n hFH hΦ5 hUNIQ R Xf,
    fun R R' _ _ _ _ φ Xf Xf' hX => fpt_nat P m C n hFH hΦ5 hUNIQ R R' φ Xf Xf' hX⟩

end FramedPtConstr
