section Rec

theorem length_kmul (r p ρ : ℕ) (zx zy : List GI) : (kmul r p ρ zx zy).length = r := by
  simp [kmul]

theorem toC_eq_mk (z : GI) : NLogN.KFB.toC z = ⟨z.1, z.2⟩ := by
  apply Complex.ext <;> simp [NLogN.KFB.toC]

/-- **The output record is the numerator record of `Q_p(u v / r)`** for `r = 2^ρ`. -/
theorem toC_kmul {r p ρ : ℕ} (hr : r = 2 ^ ρ) {zx zy : List GI} {u v : Fin r → ℂ}
    (hx : ∀ i : Fin r, NLogN.KFB.toC (zx.getD i 0) = 2 ^ p * u i)
    (hy : ∀ i : Fin r, NLogN.KFB.toC (zy.getD i 0) = 2 ^ p * v i) (j : Fin r) :
    NLogN.KFB.toC ((kmul r p ρ zx zy).getD j 0) = 2 ^ p * ppq r p u v j := by
  have h2 : (2 : ℂ) ^ p ≠ 0 := pow_ne_zero _ two_ne_zero
  have hu : ∀ i : Fin r, u i = (((2 : ℝ) ^ p)⁻¹ : ℝ) * ⟨reF zx i, imF zx i⟩ := by
    intro i
    have := hx i
    rw [toC_eq_mk] at this
    push_cast
    rw [show (⟨((reF zx i : ℤ) : ℝ), ((imF zx i : ℤ) : ℝ)⟩ : ℂ) = 2 ^ p * u i from this]
    field_simp
  have hv : ∀ i : Fin r, v i = (((2 : ℝ) ^ p)⁻¹ : ℝ) * ⟨reF zy i, imF zy i⟩ := by
    intro i
    have := hy i
    rw [toC_eq_mk] at this
    push_cast
    rw [show (⟨((reF zy i : ℤ) : ℝ), ((imF zy i : ℤ) : ℝ)⟩ : ℂ) = 2 ^ p * v i from this]
    field_simp
  have hg := ncv_gauss _ (reF zx) (imF zx) (reF zy) (imF zy) u v hu hv j
  have hj := j.isLt
  rw [List.getD_eq_getElem _ _ (by simp [kmul])]
  simp only [kmul, List.getElem_map, List.getElem_range]
  unfold ppq
  rw [hg]
  have e : (r : ℂ)⁻¹ * (((((2 : ℝ) ^ p)⁻¹ : ℝ) : ℂ) ^ 2 *
      ⟨(((cnv r (reF zx) (reF zy) j - cnv r (reF zx) (reF zy) (j + r)) -
        (cnv r (imF zx) (imF zy) j - cnv r (imF zx) (imF zy) (j + r)) : ℤ) : ℝ),
       (((cnv r (reF zx) (imF zy) j - cnv r (reF zx) (imF zy) (j + r)) +
        (cnv r (imF zx) (reF zy) j - cnv r (imF zx) (reF zy) (j + r)) : ℤ) : ℝ)⟩) =
      ((2 : ℂ) ^ p)⁻¹ ^ 2 * ⟨((hRe r zx zy j - hRe r zx zy (j + r) : ℤ) : ℝ),
        ((hIm r zx zy j - hIm r zx zy (j + r) : ℤ) : ℝ)⟩ / ((2 ^ ρ : ℕ) : ℂ) := by
    have e1 : (((((2 : ℝ) ^ p)⁻¹ : ℝ) : ℂ)) = ((2 : ℂ) ^ p)⁻¹ := by push_cast; rfl
    rw [e1, div_eq_mul_inv]
    have e2 : ((hRe r zx zy j - hRe r zx zy (j + r) : ℤ) : ℝ) =
        (((cnv r (reF zx) (reF zy) j - cnv r (reF zx) (reF zy) (j + r)) -
        (cnv r (imF zx) (imF zy) j - cnv r (imF zx) (imF zy) (j + r)) : ℤ) : ℝ) := by
      unfold hRe; push_cast; ring
    have e3 : ((hIm r zx zy j - hIm r zx zy (j + r) : ℤ) : ℝ) =
        (((cnv r (reF zx) (imF zy) j - cnv r (reF zx) (imF zy) (j + r)) +
        (cnv r (imF zx) (reF zy) j - cnv r (imF zx) (reF zy) (j + r)) : ℤ) : ℝ) := by
      unfold hIm; push_cast; ring
    rw [e2, e3]
    have hrC : ((r : ℕ) : ℂ) = ((2 ^ ρ : ℕ) : ℂ) := by rw [hr]
    rw [hrC]
    ring
  rw [e, Qp_normalized, toC_eq_mk, show ((2 : ℂ) ^ p) = (((2 : ℝ) ^ p : ℝ) : ℂ) by push_cast; rfl]
  apply Complex.ext
  · rw [Complex.re_ofReal_mul]; simp only; field_simp
  · rw [Complex.im_ofReal_mul]; simp only; field_simp

end Rec

