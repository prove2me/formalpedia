-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (I J A B : Fin 4) :
    riemFL g gi E Θ I J A B x = fdir E A (omL g gi E Θ I B J) x - fdir E B (omL g gi E Θ I A J) x
      + ∑ L, (omL g gi E Θ I A L x * Omega g gi E Θ B x L J - omL g gi E Θ I B L x * Omega g gi E Θ A x L J)
      - ∑ C, cfr E Θ C A B x * omL g gi E Θ I C J x := by
  unfold riemFL Rfr
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.mul_apply, mul_sub, mul_add, Finset.sum_sub_distrib, Finset.sum_add_distrib]
  rw [fdir_omL hN hx, fdir_omL hN hx]
  have h1 : ∀ P R : Fin 4, ∑ K, etaNull I K * ∑ L, Omega g gi E Θ P x K L * Omega g gi E Θ R x L J
      = ∑ L, omL g gi E Θ I P L x * Omega g gi E Θ R x L J := by
    intro P R
    simp only [omL, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun L _ => Finset.sum_congr rfl fun K _ => by ring
  have h2 : ∑ K, etaNull I K * ∑ C, cfr E Θ C A B x * Omega g gi E Θ C x K J
      = ∑ C, cfr E Θ C A B x * omL g gi E Θ I C J x := by
    simp only [omL, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun C _ => Finset.sum_congr rfl fun K _ => by ring
  rw [h1, h1, h2]
  ring
