theorem Module.Basis.repr_apply_mem_of_mem_ideal_smul_top {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N] {κ : Type*} (b : Module.Basis κ R N) (I : Ideal R) {x : N} (hx : x ∈ (I • ⊤ : Submodule R N)) (k : κ) :
    b.repr x k ∈ I := by sorry
