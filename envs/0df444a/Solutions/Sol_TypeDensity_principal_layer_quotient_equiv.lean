open TypeDensity
open scoped BigOperators ENNReal

theorem solution (A : Type) [CommRing A] (e : A) (j : ℕ)
    (he : Function.Injective (fun a : A ↦ e*a)) :
    ∃ L : (A ⧸ Ideal.span {e}) ≃ₗ[A] TypeDensity.PrincipalLayer A e j, ∀ a : A,
    (L (Ideal.Quotient.mk (Ideal.span {e}) a)).val = TypeDensity.principalLayerMap A e j a := by
  have hk := TypeDensity.principal_layer_map_kernel A e j he
  have hr := TypeDensity.principal_layer_map_range A e j
  refine ⟨((Submodule.quotEquivOfEq _ _ hk.symm).trans
    (LinearMap.quotKerEquivRange (TypeDensity.principalLayerMap A e j))).trans (LinearEquiv.ofEq _ _ hr), ?_⟩
  intro a
  rfl
