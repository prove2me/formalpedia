-- title:
--   §5, pp. 12–15 — Markov branching process with immigration: Q-matrix (5.1), mechanisms ψ, φ, root s₀, sequences ∆W, W, κ, π, ϖ and the functions ℋ^[y(x)
-- statement:
--   A **Markov branching process with immigration (MBI)** with parameters $(\alpha,\mu,p,\beta,\nu,q)$ is the continuous-time Markov chain on $E=\{0,1,2,\dots\}$ generated by the Q-matrix
--
--   $$
--   Q(x,y)=\begin{cases}\mu(y-x+1)\alpha x+\nu(y-x)\beta, & y\ge x+1,\\ -(\alpha+p)x-(\beta+q), & y=x,\\ \mu(0)\alpha x, & y=x-1,\\ 0, & y\le x-2,\end{cases}
--   $$
--
--   where $\alpha>0$, $\mu=(\mu(j))_{j\ge0}$ is a probability measure with $\mu(0)>0$ and $\mu(1)=0$, $p\ge0$, $\beta\ge0$, $\nu=(\nu(j))_{j\ge1}$ is a probability measure (with $\nu(0):=0$) and $q\ge0$. The killing rate is $Q(x,\partial)=px+q$. If $\beta=q=0$ the MBI is a **Markov branching process (MBP)**.
--
--   The file defines:
--
--   1. the **branching** and **immigration mechanisms** $\psi(s)=\alpha(\mu^*[s]-s)-ps$ and $\phi(s)=\beta(1-\nu^*[s])+q$ on $[0,1]$, where $f^*[s]=\sum_{y\ge0}s^yf(y)$, and $s_0=\inf\{s>0:\psi(s)=0\}\in(0,1]$;
--   2. the tails $\bar\mu(k)=1-\sum_{j\le k}\mu(j)$, $\bar\nu(k)=1-\sum_{j\le k}\nu(j)$, and the sequences of Lemma 5.1: $\Delta W(0)=1/(\alpha\mu(0))$, $\Delta W(k+1)=\frac1{\mu(0)}\sum_{j=0}^k\Delta W(j)\big(\bar\mu(k-j+1)+\frac p\alpha\big)$, $W(k)=\sum_{j=0}^k\Delta W(j)$, $\kappa(k)=\beta(\Delta W\star\bar\nu)(k)+qW(k)$, $\pi(0)=\varpi(0)=1$, $\pi(k+1)=\frac1{k+1}(\pi\star\kappa)(k)$, $\varpi(k+1)=-\frac1{k+1}(\varpi\star\kappa)(k)$, with the convolution $(f\star g)(x)=\sum_{y=0}^xf(x-y)g(y)$;
--   3. $W(z)=0$ for $z\le-1$, and for $x,y\ge0$
--   $$\mathscr H^{[y}(x)=\sum_{l=0}^{y-x-1}\pi(y-x-1-l)\,\frac{(W\star\varpi)(l)}{l+x+1}\qquad(=0\text{ if }y\le x);$$
--   4. $I(x)=\int_0^{s_0}\frac{v^x}{\psi(v)}\exp\!\big(-\int_0^v\frac{\phi(u)}{\psi(u)}du\big)dv\in[0,\infty]$ and $\Lambda(s)=\int_0^s\frac{du}{\psi(u)}$.
--
--   These are the ingredients of Lemmas 5.1–5.3 and Theorem 5.4.
--
--   **Formalization Note** The MBI is the chain of the companion definition file with state set $\mathbb Z\cap[0,\infty)$ and Q-matrix `mbiQ P` (set to $0$ outside $E\times E$). $s_0$ is the infimum of the zeros of $\psi$ in $(0,1]$; this set is nonempty since $\psi(0)=\alpha\mu(0)>0\ge-p=\psi(1)$. $I(x)$ is a Lebesgue integral of a nonnegative function with values in $[0,\infty]$, because it diverges in the recurrent case. The recursions use natural-number subtraction only with $j\le k$.
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, pp. 12–16, Section 5, (5.1), Lemma 5.1, Lemma 5.2, Theorem 5.4

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
open scoped ENNReal Topology
open Filter MeasureTheory Finset

namespace SkipFreeFluct.MBI

/-!
# Markov branching processes with immigration (MBIs)

Loeffen, Patie, Wang, arXiv:2208.14425v1, Section 5, pp. 12–15: the Q-matrix (5.1), the
branching and immigration mechanisms `ψ`, `φ`, the root `s₀`, the sequences `∆W`, `W`, `κ`, `π`,
`ϖ` of Lemma 5.1 and the functions `ℋ^{[y}(x)` of Theorem 5.4. The MBI is the chain of
`Def_SkipFreeFluct_MBI_Chain` with state space `E = ℤ ∩ [0, ∞) = Set.Ici 0` and Q-matrix `mbiQ P`.
-/

/-- Parameters `(α, µ, p, β, ν, q)` of an MBI (p. 12). -/
structure MBIParams where
  /-- branching rate `α` -/
  alpha : ℝ
  /-- offspring law `µ = (µ(j))_{j ≥ 0}` -/
  mu : ℕ → ℝ
  /-- per-individual killing rate `p` -/
  p : ℝ
  /-- immigration rate `β` -/
  beta : ℝ
  /-- immigration batch law `ν = (ν(j))_{j ≥ 1}`, with `ν(0) := 0` -/
  nu : ℕ → ℝ
  /-- constant killing rate `q` -/
  q : ℝ

/-- The parameter constraints of p. 12: `α > 0`, `µ` a probability measure on `{0, 1, 2, …}`
with `µ(0) > 0` and `µ(1) = 0`, `p ≥ 0`, `β ≥ 0`, `ν` a probability measure on `{1, 2, …}`
(`ν(0) = 0`), `q ≥ 0`. -/
def MBIParams.Valid (P : MBIParams) : Prop :=
  0 < P.alpha ∧ (∀ j, 0 ≤ P.mu j) ∧ HasSum P.mu 1 ∧ 0 < P.mu 0 ∧ P.mu 1 = 0 ∧ 0 ≤ P.p ∧
  0 ≤ P.beta ∧ (∀ j, 0 ≤ P.nu j) ∧ P.nu 0 = 0 ∧ HasSum P.nu 1 ∧ 0 ≤ P.q

/-- The MBI Q-matrix (5.1), for `x, y ≥ 0`:
`Q(x, y) = µ(y - x + 1) α x + ν(y - x) β` if `y ≥ x + 1`, `-(α + p) x - (β + q)` if `y = x`,
`µ(0) α x` if `y = x - 1`, `0` if `y ≤ x - 2`; and `0` outside `E × E`. -/
noncomputable def mbiQ (P : MBIParams) (x y : ℤ) : ℝ :=
  if 0 ≤ x ∧ 0 ≤ y then
    if x + 1 ≤ y then P.mu (y - x + 1).toNat * P.alpha * x + P.nu (y - x).toNat * P.beta
    else if y = x then -(P.alpha + P.p) * x - (P.beta + P.q)
    else if y = x - 1 then P.mu 0 * P.alpha * x
    else 0
  else 0

/-- The branching mechanism `ψ(s) = α(µ*[s] - s) - p s`, `s ∈ [0, 1]` (p. 12). -/
noncomputable def psi (P : MBIParams) (s : ℝ) : ℝ :=
  P.alpha * ((∑' j : ℕ, P.mu j * s ^ j) - s) - P.p * s

/-- The immigration mechanism `φ(s) = β(1 - ν*[s]) + q`, `s ∈ [0, 1]` (p. 12). -/
noncomputable def phiImm (P : MBIParams) (s : ℝ) : ℝ :=
  P.beta * (1 - ∑' j : ℕ, P.nu j * s ^ j) + P.q

/-- `s₀ = inf{s > 0 : ψ(s) = 0}` (p. 12), with `ψ` defined on `[0, 1]`. Under `Valid` the set is
nonempty (`ψ(0) = αµ(0) > 0 ≥ -p = ψ(1)` and `ψ` is continuous on `[0, 1]`), so `s₀ ∈ (0, 1]`. -/
noncomputable def s0 (P : MBIParams) : ℝ :=
  sInf {s : ℝ | s ∈ Set.Ioc (0 : ℝ) 1 ∧ psi P s = 0}

/-- Tail of `µ`: `µ̄(k) = 1 - ∑_{0 ≤ j ≤ k} µ(j)` (Lemma 5.1). -/
noncomputable def muBar (P : MBIParams) (k : ℕ) : ℝ := 1 - ∑ j ∈ range (k + 1), P.mu j

/-- Tail of `ν`: `ν̄(k) = 1 - ∑_{0 ≤ j ≤ k} ν(j)`, with `ν(0) = 0` (Lemma 5.1). -/
noncomputable def nuBar (P : MBIParams) (k : ℕ) : ℝ := 1 - ∑ j ∈ range (k + 1), P.nu j

/-- `∆W` of Lemma 5.1: `∆W(0) = 1/(α µ(0))` and
`∆W(k + 1) = (1/µ(0)) ∑_{j=0}^{k} ∆W(j) (µ̄(k - j + 1) + p/α)` (natural subtraction with
`j ≤ k`). -/
noncomputable def dW (P : MBIParams) : ℕ → ℝ
  | 0 => 1 / (P.alpha * P.mu 0)
  | k + 1 => 1 / P.mu 0 *
      ∑ j : Fin (k + 1), dW P j * (muBar P (k - j + 1) + P.p / P.alpha)
decreasing_by exact j.isLt

/-- `W(k) = ∑_{j=0}^{k} ∆W(j)` (Lemma 5.1). -/
noncomputable def W (P : MBIParams) (k : ℕ) : ℝ := ∑ j ∈ range (k + 1), dW P j

/-- `W` extended by `0` to negative integers ("we set `W(z) = 0` for `z ≤ -1`", Theorem 5.4). -/
noncomputable def Wz (P : MBIParams) (z : ℤ) : ℝ := if z < 0 then 0 else W P z.toNat

/-- `κ(k) = β (∆W ⋆ ν̄)(k) + q W(k)` (Lemma 5.1), with `(f ⋆ g)(k) = ∑_{j=0}^{k} f(k - j) g(j)`. -/
noncomputable def kappa (P : MBIParams) (k : ℕ) : ℝ :=
  P.beta * (∑ j ∈ range (k + 1), dW P (k - j) * nuBar P j) + P.q * W P k

/-- The measure `π` of Lemma 5.1: `π(0) = 1`, `π(k + 1) = (1/(k + 1)) (π ⋆ κ)(k)`. -/
noncomputable def piSeq (P : MBIParams) : ℕ → ℝ
  | 0 => 1
  | k + 1 => 1 / ((k : ℝ) + 1) * ∑ j : Fin (k + 1), piSeq P (k - j) * kappa P j
decreasing_by omega

/-- The signed measure `ϖ` of Lemma 5.1: `ϖ(0) = 1`, `ϖ(k + 1) = -(1/(k + 1)) (ϖ ⋆ κ)(k)`. -/
noncomputable def varpi (P : MBIParams) : ℕ → ℝ
  | 0 => 1
  | k + 1 => -(1 / ((k : ℝ) + 1)) * ∑ j : Fin (k + 1), varpi P (k - j) * kappa P j
decreasing_by omega

/-- Convolution `(f ⋆ g)(l) = ∑_{j=0}^{l} f(l - j) g(j)` of sequences on `ℕ` (p. 12). -/
noncomputable def conv (f g : ℕ → ℝ) (l : ℕ) : ℝ := ∑ j ∈ range (l + 1), f (l - j) * g j

/-- `ℋ^{[y}(x) = ∑_{l=0}^{y-x-1} π(y - x - 1 - l) (W ⋆ ϖ)(l)/(l + x + 1)` for `x, y ≥ 0`
(Theorem 5.4), the sum being `0` if `y ≤ x` (the range `range (y - x)` is then empty; inside
the sum `l < y - x`, so `y - x - 1 - l` is a true difference). -/
noncomputable def calH (P : MBIParams) (y x : ℕ) : ℝ :=
  ∑ l ∈ range (y - x), piSeq P (y - x - 1 - l) * conv (W P) (varpi P) l / ((l : ℝ) + x + 1)

/-- `I(x) = ∫_0^{s₀} v^x/ψ(v) exp(-∫_0^v φ(u)/ψ(u) du) dv ∈ [0, ∞]` (Theorem 5.4(1)), as a
`lintegral` of the integrand, which is nonnegative on `(0, s₀)`; it may be `∞`. -/
noncomputable def IntI (P : MBIParams) (x : ℕ) : ℝ≥0∞ :=
  ∫⁻ v in Set.Ioo 0 (s0 P),
    ENNReal.ofReal (v ^ x / psi P v * Real.exp (-∫ u in (0 : ℝ)..v, phiImm P u / psi P u))

/-- `Λ(s) = ∫_0^s 1/ψ(u) du`, `s ∈ [0, s₀)` (Lemma 5.2). -/
noncomputable def Lam (P : MBIParams) (s : ℝ) : ℝ := ∫ u in (0 : ℝ)..s, 1 / psi P u

/-- The MBI is a Markov branching process (MBP): `β = q = 0` (p. 12). -/
def IsMBP (P : MBIParams) : Prop := P.beta = 0 ∧ P.q = 0

end SkipFreeFluct.MBI


