section
-- Source module: Solutions.R6CrtTab
/-!
# CRT reversal §1: the digit-selector rotation `rotDU`

A copy of KFUU's uniform shift `rotCU` (KFUURot2–5) whose coefficient of field `j` is
`cFd = μ · (P_j / D) mod Q` (register `oDc = D`) instead of `μ P_j mod Q`.  With all field sizes
equal to `Q` and `D = Q^k`, the coefficient is `μ · [j = k]`, so `rotDU` adds `μ · a_k` to the
target digit: one shear `y += μ x_k` of the additive-swap reversal (see `jain6/crt/DESIGN.md`).
`rotDU_runs`: the KFU form `pull … (rotG i Q (fun a => lf cs a % Q))`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFC AModel AModelL12 NLogN.KFUU

/-- The divisor register `D` of the coefficient. -/
abbrev oDc : Fin HS := 21

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The digit-selector coefficient `μ · (P_j / D) mod Q`. -/
def cEd : Ex HS := .nmod (.mul (.reg oMu) (.ndiv (.reg oPr) (.reg oDc))) (.reg oQ)

/-- Its value: `μ · (P_j / D) mod Q` (for `D = Q^k` and all sizes `Q`: `μ · [j = k]`). -/
def cFd (sF : ℕ → ℕ) (μ D Q j : ℕ) : ℕ := μ * (Pv sF j / D) % Q

/-- One step of the coefficient loop. -/
def coefBd : RS :=
  .seq (.push sSC (cEd)) (.seq (.push sSAM (.ndiv (.reg oPi) (.reg oPr)))
    (.seq (.push sSM (.ndiv (.reg oPi) (.mul (.reg oPr) (.reg oSQ))))
      (.seq (.push sSA (.reg oSQ)) (.seq (.asg oPr (.mul (.reg oPr) (.reg oSQ)))
        (.seq (.push oSP (.reg oSQ)) (.pop oSQ))))))

/-- The managed lists after `k` steps. -/
def cfFd (f0 : Fin HS → List ℤ) (sF : ℕ → ℕ) (μ D Q i k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update f0
      oSQ (((List.range i).map fun j => (sF j : ℤ)).drop k))
      oSP (((List.range k).map fun j => (sF j : ℤ)).reverse))
      oPr [(Pv sF k : ℤ)])
      sSC (((List.range k).map fun j => (cFd sF μ D Q j : ℤ)).reverse))
      sSAM (((List.range k).map fun j => ((Pv sF i / Pv sF j : ℕ) : ℤ)).reverse))
      sSM (((List.range k).map fun j => ((Pv sF i / Pv sF (j + 1) : ℕ) : ℤ)).reverse))
      sSA (((List.range k).map fun j => (sF j : ℤ)).reverse)

/-- The coefficient loop. -/
def coefLd : RS := .rep oCC (.reg oI) (coefBd)

/-- The stage list of target `i`. -/
def acLd (sF : ℕ → ℕ) (μ D Q i : ℕ) : List (ℕ × ℕ) :=
  ((List.range i).map sF).zip ((List.range i).map (cFd sF μ D Q))

/-- The table set-up. -/
def tabUd : RS :=
  .seq (.push oPr (.lit 1)) (.seq (NLogN.mvK oSP oSQ oCM (.reg oI)) (.seq (coefLd)
    (.seq (.pop oPr) (.seq (.push sNQ (.neg (.reg oQ))) (.seq (.push 14 (.lit 0))
      (.seq (.rep oCS (.reg oI) stageU) (.seq (.push 1 (.reg oPi))
        (.seq (.push 2 (.reg oQ)) (.push 4 (.reg oBv))))))))))

/-- The managed lists at the end of the set-up. -/
def tabEndd (sF : ℕ → ℕ) (μ D Q i Pi Bv : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (fun _ => []) oSP ((List.range i).map fun j => (sF j : ℤ)).reverse)
    14 (tbl Q (acLd sF μ D Q i))) 1 [(Pi : ℤ)]) 2 [(Q : ℤ)]) 4 [(Bv : ℤ)]) sNQ [-(Q : ℤ)]

/-- One uniform shift. -/
def rotDU : IStmt HS Pp := .seq (tabUd).code (.seq rotF postU.code)

/-- The coefficients of target `i`. -/
def csUd (sF : ℕ → ℕ) (μ D Q i : ℕ) : List ℕ := (List.range i).map (cFd sF μ D Q)

end NLogN.KFUU.R6Crt

end

section
-- Source module: Solutions.R6CrtAlg
/-!
# CRT reversal §2: the address algebra of the additive-swap reversal

Addresses of the shape `SH n Q T = replicate n Q ++ T` (the `n` main digits of size `Q`, then an
arbitrary tail `T`).  With `m = n / 2`, `x` = digits `[0, m)`, `y` = digits `[n-m, n)`:

* `shr Q i k μ` — digit `i` := digit `i` − `μ ·` digit `k` (mod `Q`): the pull map of one
  digit-selector rotation `rotDU` (`rotG_shr`);
* `lsetK … sig μ m` — the `m` shears of one rotation set (target `n-m+j`, control
  `ctl sig m j = σ j` or `j`);
* `bsw n m` — exchange of the digit blocks `x` and `y` (one composite Lemma 12 swap).

**`word_rev`**: `L(-σ) ∘ S ∘ L(σ) ∘ L(-1) ∘ S ∘ L(1) ∘ S ∘ L(σ) ∘ L(-1) = revH n` on valid
addresses (as a composite pull map; see `jain6/crt/DESIGN.md`).  The proof computes the digits in
`ZMod Q` block by block.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFUU.R6Crt

open IntMul KIL AModel NLogN.KFUU

/-! ## Shapes and maps -/

/-- `n` main digits of size `Q`, then the tail `T`. -/
def SH (n Q : ℕ) (T : Shape) : Shape := List.replicate n Q ++ T

/-- One shear: digit `i` := digit `i` − `μ ·` digit `k` mod `Q`. -/
def shr (Q i k μ : ℕ) (b : List ℕ) : List ℕ :=
  b.set i ((b.getD i 0 + Q - μ * b.getD k 0 % Q) % Q)

/-- The control digit of target `n - m + j`. -/
def ctl (sig : Bool) (m j : ℕ) : ℕ := if sig then m - 1 - j else j

/-- The first `k` shears of a rotation set (pull map after `k` loop iterations). -/
def lsetK (Q n m : ℕ) (sig : Bool) (μ : ℕ) : ℕ → List ℕ → List ℕ
  | 0 => id
  | k + 1 => lsetK Q n m sig μ k ∘ shr Q (n - m + k) (ctl sig m k) μ

/-- Exchange of the blocks `[0, m)` and `[n-m, n)`. -/
def bsw (n m : ℕ) (b : List ℕ) : List ℕ :=
  (b.take n).drop (n - m) ++ ((b.take (n - m)).drop m ++ (b.take m ++ b.drop n))

/-! ## The selector table -/

/-! ## Digits -/

/-- The `ZMod Q` digit function of an address. -/
def dg (Q : ℕ) (b : List ℕ) (p : ℕ) : ZMod Q := ((b.getD p 0 : ℕ) : ZMod Q)

/-! ## The rotation sets -/

/-! ## The block swap -/

/-! ## The word -/

/-- The pull map of `p2E`: the nine stages in execution order `L(-σ), S, L(σ), L(-1), S, L(1), S,
L(σ), L(-1)` (the first executed stage is the outermost function). -/
def word (Q n : ℕ) : List ℕ → List ℕ :=
  lsetK Q n (n / 2) true (Q - 1) (n / 2) ∘ bsw n (n / 2) ∘ lsetK Q n (n / 2) true 1 (n / 2) ∘
    lsetK Q n (n / 2) false (Q - 1) (n / 2) ∘ bsw n (n / 2) ∘ lsetK Q n (n / 2) false 1 (n / 2) ∘
    bsw n (n / 2) ∘ lsetK Q n (n / 2) true 1 (n / 2) ∘ lsetK Q n (n / 2) false (Q - 1) (n / 2)

