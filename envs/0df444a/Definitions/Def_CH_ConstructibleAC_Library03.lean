    F5_mem_rudimentaryClosure hfibers (self_mem_rudimentaryClosure U)
  have heq : F5 (F8 r (F0 p p)) U = fiber r p := by
    apply ZFSet.ext
    intro q
    simp [F0]
  rwa [heq] at hunion

/-- A rudimentary set coding a relation on nonempty tuples over `U`. -/
