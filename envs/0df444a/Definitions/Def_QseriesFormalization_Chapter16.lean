/-- Truncated LHS: `∑_{n=0}^N p(5n+4) q^n`. Uses `partitionCount` from Ch 1. -/
def mbiLHSTrunc (q : R) (N : Nat) : R :=
  natSum (fun n => (Ch01.partitionCount (5 * n + 4) : R) * q ^ n) N

