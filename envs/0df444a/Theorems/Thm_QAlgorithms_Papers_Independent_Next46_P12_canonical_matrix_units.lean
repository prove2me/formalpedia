-- title:
--   Corollary 1.8: diagonal matrix units
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Choose a GT basis $\{v_T:T\mapsto\lambda\}$ for each simple $V^\lambda$. Let $\phi^\lambda_{S,T}\in A_n$ be transported through the same split identification from the endomorphism sending $v_T$ to $v_S$, sending the other basis vectors to zero, and acting as zero on the other simple blocks. Then
--
--   $$\epsilon(\lambda)=\sum_{T\mapsto\lambda}\phi^\lambda_{T,T},\qquad\epsilon_T=\phi^\lambda_{T,T}\quad(T\mapsto\lambda).$$
--
--   The formulas identify the canonical projectors with diagonal matrix units of the chosen GT bases.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 7, Corollary 1.8: diagonal matrix units

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Corollary 1.8, source PDF pp. 6–7. The inverse identification and the matrix
units are constructed from the chosen GT bases, and both displayed identities are retained. -/
theorem canonical_matrix_units (D : Tower k AA) (n : ℕ)
    (b : (lam : (D.split n).Label) →
      Module.Basis (TowerPathsTo D n lam) k (SimpleSpace (D.split n) lam))
    (hb : ∀ lam t, b lam t ∈ gtLine D lam t.val) :
    (∀ lam, centralIdempotent (D.split n) lam =
      ∑ t : TowerPathsTo D n lam, gtMatrixUnit D lam (b lam) t t) ∧
    (∀ lam (t : TowerPathsTo D n lam), pathIdempotent D t.val = gtMatrixUnit D lam (b lam) t t) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
