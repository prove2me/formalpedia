    rw [h r (by simp), flatten_length_of R (fun x hx => h x (by simp [hx]))]; ring

theorem keyBit_iff (k : ℕ) (r : List ℤ) (h : 0 ≤ key r) :
    keyBit k r = true ↔ key r / 2 ^ k % 2 = 1 := by
  unfold keyBit
  have h2 : 0 ≤ key r / 2 ^ k := Int.ediv_nonneg h (by positivity)
  rw [show r.headD 0 = key r from rfl, Int.tdiv_eq_ediv_of_nonneg h,
    Int.tmod_eq_emod_of_nonneg h2]
  rcases Int.emod_two_eq (key r / 2 ^ k) with e | e <;> simp [e]

theorem key_mod_succ (k : ℕ) (x : ℤ) (h : 0 ≤ x) :
    x % 2 ^ (k + 1) = x % 2 ^ k + 2 ^ k * (x / 2 ^ k % 2) := by
  lift x to ℕ using h
  have := Nat.mod_pow_succ (x := x) (b := 2) (k := k)
  exact_mod_cast this

theorem radixPass_sorted (k : ℕ) (L : List (List ℤ)) (hn : ∀ r ∈ L, 0 ≤ key r)
    (hL : SortedMod k L) : SortedMod (k + 1) (radixPass k L) := by
  have hz : ∀ r ∈ L, keyBit k r = false → key r % 2 ^ (k + 1) = key r % 2 ^ k := by
    intro r hr hb
    have h0 := hn r hr
    rw [key_mod_succ k _ h0]
    have : key r / 2 ^ k % 2 = 0 := by
      rcases Int.emod_two_eq (key r / 2 ^ k) with e | e
      · exact e
      · exact absurd ((keyBit_iff k r h0).2 e) (by simp [hb])
    rw [this]; ring
  have ho : ∀ r ∈ L, keyBit k r = true → key r % 2 ^ (k + 1) = key r % 2 ^ k + 2 ^ k := by
    intro r hr hb
    rw [key_mod_succ k _ (hn r hr), (keyBit_iff k r (hn r hr)).1 hb]; ring
  have hlt : ∀ r : List ℤ, key r % 2 ^ k < 2 ^ k := fun r => Int.emod_lt_of_pos _ (by positivity)
  have hge : ∀ r : List ℤ, 0 ≤ key r % 2 ^ k := fun r => Int.emod_nonneg _ (by positivity)
  unfold radixPass SortedMod
  rw [List.pairwise_append]
  refine ⟨?_, ?_, ?_⟩
  · refine (hL.sublist List.filter_sublist).imp_of_mem ?_
    intro a b ha hb hab
    simp only [List.mem_filter, Bool.not_eq_true'] at ha hb
    rw [hz a ha.1 (by simpa using ha.2), hz b hb.1 (by simpa using hb.2)]; exact hab
  · refine (hL.sublist List.filter_sublist).imp_of_mem ?_
    intro a b ha hb hab
    simp only [List.mem_filter] at ha hb
    rw [ho a ha.1 ha.2, ho b hb.1 hb.2]; linarith
  · intro a ha b hb
    simp only [List.mem_filter, Bool.not_eq_true'] at ha hb
    rw [hz a ha.1 (by simpa using ha.2), ho b hb.1 hb.2]
    linarith [hlt a, hge b]

theorem radixSort_sorted (kb : ℕ) (L : List (List ℤ)) (hn : ∀ r ∈ L, 0 ≤ key r) :
    SortedMod kb (radixSort kb L) := by
