theorem ReciprocityTheory.ChartRestriction.G.AR.Up.FactorialDivisibilityBounds.rfac_eq (la : Wt X.Ψ r) :
    rfac X la x (X.flowV e s x) τ = Real.exp (∑ i : Fin r, (la τ i : ℝ) / 2 *
