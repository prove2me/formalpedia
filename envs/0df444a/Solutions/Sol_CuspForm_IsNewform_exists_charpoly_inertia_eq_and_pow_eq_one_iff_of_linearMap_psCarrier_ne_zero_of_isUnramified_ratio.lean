  obtain ⟨c, hc⟩ : ∃ c : ℕ, m = q ^ c := by
    rcases hm with ⟨-, h1⟩ | ⟨h2, h8⟩
    · exact ⟨1, by rw [h1, pow_one]⟩
    · exact ⟨3, by rw [h8, h2]; norm_num⟩
  subst hc
  exact CuspForm.PSQ.caseB_core hg lam S O' hlamO' chig hchig iota ρ hρ q hqlam Φ hΦ0 hΦg μ₁ μ₂ f hfequiv hf0
    hratio K hinjK c χ hχ2 hχ1 M' h hh hqM' S' chih hchih φ' hcoeff

