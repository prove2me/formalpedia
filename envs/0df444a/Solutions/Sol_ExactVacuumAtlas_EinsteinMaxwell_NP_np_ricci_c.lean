  have a20 : ∀ A, omL g gi E Θ 2 A 0 x = -omL g gi E Θ 0 A 2 x := fun A => hN.omL_antisymm hx 2 A 0
  have a30 : ∀ A, omL g gi E Θ 3 A 0 x = -omL g gi E Θ 0 A 3 x := fun A => hN.omL_antisymm hx 3 A 0
