/-!
# Round six, bit network: Bruhat profiles of the edge classes (flag basis, ℚ)

For transformed label data (vectors `x, y` with `y ⬝ x = 1`, idempotents `π`) satisfying the
genericity conditions, the projectors `qM M` of the edge classes have the claimed pivots, hence
edges with the claimed runs (`edge_of_pivs`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset
open scoped Kronecker

section Class

variable {h : ℕ}

section Data

variable (x₁ y₁ x₂ y₂ : Fin (h + 4) → ℚ)

/-- The rank-one row factor of the data corner block. -/
def dU (i : ℕ) : ℚ := if hi : i < h + 3 then x₁ ⟨i, by omega⟩ * x₂ ⟨i, by omega⟩ else 0

/-- The rank-one column factor of the data corner block. -/
def dV (γ : ℕ) : ℚ :=
  if hγ : γ < h + 3 then y₁ ⟨γ, by omega⟩ * y₂ ⟨h + 3, by omega⟩ + y₁ ⟨h + 3, by omega⟩ * y₂ ⟨γ, by omega⟩
  else y₁ ⟨h + 3, by omega⟩ * y₂ ⟨h + 3, by omega⟩

end Data

/-! ## Side edges: factorization through `Fin n` -/

section Side

/-- `(1 ⊗ x)` and `(1 ⊗ yᵀ)` (stage one), `(x ⊗ 1)`, `(yᵀ ⊗ 1)` (stage two). -/
def Cx (x : Fin (h + 4) → ℚ) : Matrix (Pr (h + 4)) (Fin (h + 4)) ℚ :=
  Matrix.of fun u a => if u.1 = a then x u.2 else 0
def Ry (y : Fin (h + 4) → ℚ) : Matrix (Fin (h + 4)) (Pr (h + 4)) ℚ :=
  Matrix.of fun a v => if a = v.1 then y v.2 else 0
def Cx2 (x : Fin (h + 4) → ℚ) : Matrix (Pr (h + 4)) (Fin (h + 4)) ℚ :=
  Matrix.of fun u a => if u.2 = a then x u.1 else 0
def Ry2 (y : Fin (h + 4) → ℚ) : Matrix (Fin (h + 4)) (Pr (h + 4)) ℚ :=
  Matrix.of fun a v => if a = v.2 then y v.1 else 0

/-- The flag frame, rows (`Te`) and columns (`Te'`). -/
noncomputable def Te : Matrix (Fin ((h + 4) * (h + 4))) (Pr (h + 4)) ℚ := Tm.submatrix flagEquiv id
noncomputable def Te' : Matrix (Pr (h + 4)) (Fin ((h + 4) * (h + 4))) ℚ := Ti.submatrix id flagEquiv

variable (x y : Fin (h + 4) → ℚ)

end Side

end Class

