open Real

namespace ExactVacuumAtlas.Schwarzschild.Iso

/-! ### Cartesian form -/

/-! ### Elementary algebra of the radial map -/

theorem rad_eq (M ρ : ℝ) (hρ : ρ ≠ 0) : rad M ρ = (2 * ρ + M) ^ 2 / (4 * ρ) := by
  unfold rad; field_simp; ring

theorem rad_sub (M ρ : ℝ) (hρ : ρ ≠ 0) : rad M ρ - 2 * M = (2 * ρ - M) ^ 2 / (4 * ρ) := by
  unfold rad; field_simp; ring

/-- `r > 2M` on both branches (`ρ > 0`, `ρ ≠ M/2`). -/
theorem rad_gt (M ρ : ℝ) (hρ : 0 < ρ) (hne : ρ ≠ M / 2) : 2 * M < rad M ρ := by
  have h : rad M ρ - 2 * M = (2 * ρ - M) ^ 2 / (4 * ρ) := rad_sub M ρ hρ.ne'
  have hpos : 0 < (2 * ρ - M) ^ 2 / (4 * ρ) := by
    apply div_pos _ (by linarith)
    have : 2 * ρ - M ≠ 0 := fun h0 => hne (by linarith)
    positivity
  linarith

theorem rad_pos (M ρ : ℝ) (hM : 0 ≤ M) (hρ : 0 < ρ) : 0 < rad M ρ := by
  unfold rad
  have : 0 < 1 + M / (2 * ρ) := by positivity
  positivity

/-- `r (r − 2M) = ((2ρ + M)(2ρ − M)/(4ρ))²`. -/
theorem rad_mul_sub (M ρ : ℝ) (hρ : ρ ≠ 0) :
    rad M ρ * (rad M ρ - 2 * M) = ((2 * ρ + M) * (2 * ρ - M) / (4 * ρ)) ^ 2 := by
  rw [rad_sub M ρ hρ, rad_eq M ρ hρ]; field_simp; try ring

theorem sqrt_rad_in (M ρ : ℝ) (hρ : 0 < ρ) (hρM : ρ < M / 2) :
    Real.sqrt (rad M ρ * (rad M ρ - 2 * M)) = (2 * ρ + M) * (M - 2 * ρ) / (4 * ρ) := by
  rw [rad_mul_sub M ρ hρ.ne']
  have e : ((2 * ρ + M) * (2 * ρ - M) / (4 * ρ)) ^ 2 = ((2 * ρ + M) * (M - 2 * ρ) / (4 * ρ)) ^ 2 := by
    ring
  rw [e]
  apply Real.sqrt_sq
  apply div_nonneg _ (by linarith)
  apply mul_nonneg (by linarith) (by linarith)

/-- `ρ₋(r(ρ)) = ρ` on the inner branch. -/
theorem radInvIn_rad (M ρ : ℝ) (hρ : 0 < ρ) (hρM : ρ < M / 2) : radInvIn M (rad M ρ) = ρ := by
  unfold radInvIn
  rw [sqrt_rad_in M ρ hρ hρM, rad_eq M ρ hρ.ne']
  field_simp; ring

theorem sq_sqrt_rr (M r : ℝ) (hr : 2 * M < r) (hr0 : 0 < r) :
    Real.sqrt (r * (r - 2 * M)) ^ 2 = r * (r - 2 * M) :=
  Real.sq_sqrt (by nlinarith)

/-- `√(r(r−2M)) < r − M` for `M > 0`, `r > 2M` (so `ρ₋ > 0`). -/
theorem sqrt_rr_lt (M r : ℝ) (hM : 0 < M) (hr : 2 * M < r) (hr0 : 0 < r) :
    Real.sqrt (r * (r - 2 * M)) < r - M := by
  rw [Real.sqrt_lt' (by linarith)]
  nlinarith

/-- `r − 2M < √(r(r−2M))` for `M > 0`, `r > 2M` (so `ρ₋ < M/2`). -/
theorem lt_sqrt_rr (M r : ℝ) (hM : 0 < M) (hr : 2 * M < r) (hr0 : 0 < r) :
    r - 2 * M < Real.sqrt (r * (r - 2 * M)) := by
  rw [Real.lt_sqrt (by linarith)]
  nlinarith

theorem radInvIn_pos (M r : ℝ) (hM : 0 < M) (hr : 2 * M < r) (hr0 : 0 < r) : 0 < radInvIn M r := by
  unfold radInvIn
  have := sqrt_rr_lt M r hM hr hr0
  linarith

theorem radInvIn_lt (M r : ℝ) (hM : 0 < M) (hr : 2 * M < r) (hr0 : 0 < r) : radInvIn M r < M / 2 := by
  unfold radInvIn
  have := lt_sqrt_rr M r hM hr hr0
  linarith

/-- `r(ρ₋(r)) = r` for `M > 0`, `r > 2M`. -/
theorem rad_radInvIn (M r : ℝ) (hM : 0 < M) (hr : 2 * M < r) (hr0 : 0 < r) :
    rad M (radInvIn M r) = r := by
  have hpos := radInvIn_pos M r hM hr hr0
  rw [rad_eq M _ hpos.ne']
  unfold radInvIn at hpos ⊢
  have hs := sq_sqrt_rr M r hr hr0
  rw [div_eq_iff (ne_of_gt (by linarith))]
  linear_combination hs

/-- `dr/dρ = 1 − M²/(4ρ²)`. -/
theorem hasDerivAt_rad (M ρ : ℝ) (hρ : ρ ≠ 0) :
    HasDerivAt (rad M) (1 - M ^ 2 / (4 * ρ ^ 2)) ρ := by
  have h1 : HasDerivAt (fun u => 1 + M / (2 * u)) (0 - M * 2 / (2 * ρ) ^ 2) ρ := by
    have := ((hasDerivAt_const ρ M).div ((hasDerivAt_id' ρ).const_mul 2) (by positivity))
    refine (this.const_add 1).congr_deriv ?_
    ring
  have h := (hasDerivAt_id' ρ).fun_mul (h1.fun_pow 2)
  refine h.congr_deriv ?_
  push_cast
  field_simp
  ring

end ExactVacuumAtlas.Schwarzschild.Iso

