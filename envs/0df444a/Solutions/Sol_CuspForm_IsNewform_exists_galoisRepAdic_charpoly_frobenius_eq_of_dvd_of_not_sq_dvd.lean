section Galois

variable {J : Type} [AddCommGroup J] [Module HeckeAlg J] {p : ℕ} [Fact p.Prime]
variable [Module ℤ_[p] (ModularCurve.TateModule p J)]

def PadicSmulNormalForm (p : ℕ) [Fact p.Prime] (J : Type) [AddCommGroup J] [Module HeckeAlg J]
    [Module ℤ_[p] (ModularCurve.TateModule p J)] : Prop :=
  ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
    ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n

lemma natCast_padic_smul' (hsmul : PadicSmulNormalForm p J) (k : ℕ) (x : ModularCurve.TateModule p J) :
    ((k : ℤ_[p]) • x : ModularCurve.TateModule p J) = k • x := by
  apply Subtype.ext
  funext n
  rw [hsmul, map_natCast, ZMod.val_natCast]
  have hx : p ^ n • (x : ℕ → J) n = 0 := ModularCurve.TateModule.pow_smul_apply x.2 n
  change (k % p ^ n) • (x : ℕ → J) n = ((k • x : ModularCurve.TateModule p J) : ℕ → J) n
  rw [Submodule.coe_smul_of_tower, Pi.smul_apply]
  conv_rhs => rw [← Nat.div_add_mod k (p ^ n)]
  rw [add_smul, mul_comm, mul_smul, hx, smul_zero, zero_add]

variable [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J]
variable (hsmul : PadicSmulNormalForm p J)

def galTateEnd (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    ModularCurve.TateModule p J →ₗ[ℤ_[p]] ModularCurve.TateModule p J where
  toFun x := ⟨σ • (x : ℕ → J), ModularCurve.TateModule.smul_mem σ x.2⟩
  map_add' x y := Subtype.ext (smul_add σ (x : ℕ → J) (y : ℕ → J))
  map_smul' a x := by
    apply Subtype.ext
    funext n
    change σ • (((a • x : ModularCurve.TateModule p J) : ℕ → J) n) =
      ((a • (⟨σ • (x : ℕ → J), ModularCurve.TateModule.smul_mem σ x.2⟩ : ModularCurve.TateModule p J) : ModularCurve.TateModule p J) :
        ℕ → J) n
    rw [hsmul, hsmul]
    change σ • ((PadicInt.toZModPow n a).val • (x : ℕ → J) n) =
      (PadicInt.toZModPow n a).val • (σ • (x : ℕ → J) n)
    exact smul_comm _ _ _

@[scoped simp] lemma galTateEnd_apply_coe (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (x : ModularCurve.TateModule p J) : ((galTateEnd hsmul σ x : ModularCurve.TateModule p J) : ℕ → J) = σ • (x : ℕ → J) :=
  rfl

def galTate : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* Module.End ℤ_[p] (ModularCurve.TateModule p J)
    where
  toFun := galTateEnd hsmul
  map_one' := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact one_smul _ (x : ℕ → J)
  map_mul' σ τ := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact mul_smul σ τ (x : ℕ → J)

@[scoped simp] lemma galTate_apply (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    galTate hsmul σ = galTateEnd hsmul σ := rfl

variable (𝒪'' : Type) [CommRing 𝒪''] [Algebra ℤ_[p] 𝒪'']

def ρbc :
    (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →*
      Module.End 𝒪'' (𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J) :=
  (Module.End.baseChangeHom ℤ_[p] 𝒪'' (ModularCurve.TateModule p J)).toRingHom.toMonoidHom.comp (galTate hsmul)

lemma ρbc_apply (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    ρbc hsmul 𝒪'' σ = (galTateEnd hsmul σ).baseChange 𝒪'' := rfl

@[scoped simp] lemma ρbc_tmul (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (a : 𝒪'')
    (x : ModularCurve.TateModule p J) : ρbc hsmul 𝒪'' σ (a ⊗ₜ x) = a ⊗ₜ galTateEnd hsmul σ x := rfl

theorem unram_baseChange (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hT : ∀ x : ModularCurve.TateModule p J, galTateEnd hsmul σ x = x) : ρbc hsmul 𝒪'' σ = 1 := by
  have h1 : galTate hsmul σ = 1 := LinearMap.ext hT
  change (Module.End.baseChangeHom ℤ_[p] 𝒪'' (ModularCurve.TateModule p J)).toRingHom (galTate hsmul σ) = 1
  rw [h1, map_one]

theorem cont_baseChange [IsLocalRing 𝒪''] (hp : (p : 𝒪'') ∈ IsLocalRing.maximalIdeal 𝒪'')
    (hT : ∀ n : ℕ, ∃ L : IntermediateField ℚ (AlgebraicClosure ℚ), FiniteDimensional ℚ L ∧
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, (∀ x ∈ L, σ x = x) →
        ∀ x : ModularCurve.TateModule p J, ∃ y : ModularCurve.TateModule p J, p ^ n • y = galTateEnd hsmul σ x - x) :
    GaloisActionIsAdicContinuous 𝒪'' (ρbc hsmul 𝒪'') := by
  intro n
  obtain ⟨L, hLfin, hL⟩ := hT n
  refine ⟨L, hLfin, fun σ hσ m => ?_⟩
  induction m using TensorProduct.induction_on with
  | zero => simp
  | tmul a x =>
    obtain ⟨y, hy⟩ := hL σ hσ x
    rw [ρbc_tmul, ← TensorProduct.tmul_sub, ← hy, ← natCast_padic_smul' hsmul,
      TensorProduct.tmul_smul, Nat.cast_smul_eq_nsmul, ← Nat.cast_smul_eq_nsmul 𝒪'', Nat.cast_pow]
    exact Submodule.smul_mem_smul (Ideal.pow_mem_pow hp n) Submodule.mem_top
  | add m₁ m₂ h₁ h₂ =>
    have : ρbc hsmul 𝒪'' σ (m₁ + m₂) - (m₁ + m₂)
        = (ρbc hsmul 𝒪'' σ m₁ - m₁) + (ρbc hsmul 𝒪'' σ m₂ - m₂) := by
      rw [map_add]; abel
    rw [this]
    exact Submodule.add_mem _ h₁ h₂

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J] in

lemma finite_free_baseChange [Module.Finite ℤ_[p] (ModularCurve.TateModule p J)]
    [Module.Free ℤ_[p] (ModularCurve.TateModule p J)] :
    Module.Finite 𝒪'' (𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J) ∧
      Module.Free 𝒪'' (𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J) :=
  ⟨inferInstance, inferInstance⟩

variable [SMulCommClass HeckeAlg ℤ_[p] (ModularCurve.TateModule p J)]

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J] in

def heckeTate : HeckeAlg →+* Module.End ℤ_[p] (ModularCurve.TateModule p J) :=
  Module.toModuleEnd ℤ_[p] (ModularCurve.TateModule p J) (S := HeckeAlg)

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J] in
@[scoped simp] lemma heckeTate_apply (t : HeckeAlg) (x : ModularCurve.TateModule p J) :
    heckeTate (p := p) (J := J) t x = t • x := rfl

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J] in

def Tbc : HeckeAlg →+* Module.End 𝒪'' (𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J) :=
  (Module.End.baseChangeHom ℤ_[p] 𝒪'' (ModularCurve.TateModule p J)).toRingHom.comp heckeTate

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J] in
@[scoped simp] lemma Tbc_tmul (t : HeckeAlg) (a : 𝒪'') (x : ModularCurve.TateModule p J) :
    Tbc 𝒪'' t (a ⊗ₜ[ℤ_[p]] x) = a ⊗ₜ (t • x) := rfl

omit [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J]
  [SMulCommClass HeckeAlg ℤ_[p] (ModularCurve.TateModule p J)] in

lemma nsmul_tmul_right (k : ℕ) (a : 𝒪'') (x : ModularCurve.TateModule p J) :
    (k • (a ⊗ₜ[ℤ_[p]] x) : 𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J) = a ⊗ₜ (k • x) := by
  induction k with
  | zero => simp
  | succ k ih => rw [succ_nsmul, ih, succ_nsmul, TensorProduct.tmul_add]

theorem quad_baseChange (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (t : HeckeAlg) (ℓ : ℕ)
    (hT : ∀ x : ModularCurve.TateModule p J,
      galTateEnd hsmul σ (galTateEnd hsmul σ x) - t • galTateEnd hsmul σ x + ℓ • x = 0) :
    ∀ m : 𝒪'' ⊗[ℤ_[p]] ModularCurve.TateModule p J,
      ρbc hsmul 𝒪'' σ (ρbc hsmul 𝒪'' σ m) - Tbc 𝒪'' t (ρbc hsmul 𝒪'' σ m) + (ℓ : 𝒪'') • m = 0 := by
  intro m
  induction m using TensorProduct.induction_on with
  | zero => simp
  | tmul a x =>
    rw [ρbc_tmul, ρbc_tmul, Tbc_tmul, Nat.cast_smul_eq_nsmul, nsmul_tmul_right,
      ← TensorProduct.tmul_sub, ← TensorProduct.tmul_add, hT x, TensorProduct.tmul_zero]
  | add m₁ m₂ h₁ h₂ =>
    have : ρbc hsmul 𝒪'' σ (ρbc hsmul 𝒪'' σ (m₁ + m₂)) - Tbc 𝒪'' t (ρbc hsmul 𝒪'' σ (m₁ + m₂))
          + (ℓ : 𝒪'') • (m₁ + m₂)
        = (ρbc hsmul 𝒪'' σ (ρbc hsmul 𝒪'' σ m₁) - Tbc 𝒪'' t (ρbc hsmul 𝒪'' σ m₁) + (ℓ : 𝒪'') • m₁)
          + (ρbc hsmul 𝒪'' σ (ρbc hsmul 𝒪'' σ m₂) - Tbc 𝒪'' t (ρbc hsmul 𝒪'' σ m₂)
            + (ℓ : 𝒪'') • m₂) := by
      rw [map_add, map_add, map_add, smul_add]; abel
    rw [this, h₁, h₂, add_zero]

end Galois

