    rzGc U E0 Θ0 B ε μ ν y
      = ((coMat (rzTh U E0 Θ0 B ε) y)ᵀ * etaNull * coMat (rzTh U E0 Θ0 B ε) y) μ ν := by
  rw [quad_eta_apply]; rfl

variable (hN : NullFrameData g0 gi0 E0 Θ0 U)
include hN

end props

