theorem solution (R : Type) [CommRing R] (t x : R)
    [(Ideal.span ({t,x} : Set R)).IsMaximal] (B : Type) [CommRing B] [Algebra (TypeDensity.BlowupChart R t x) B]
    [IsLocalization.Away (TypeDensity.chartSlope R t x) B] (Q : Ideal B) [Q.IsMaximal]
    (htP : TypeDensity.chartBase R t x t ∈ Q.comap (algebraMap (TypeDensity.BlowupChart R t x) B)) :
    (Q.comap (algebraMap (TypeDensity.BlowupChart R t x) B)).IsMaximal := by
  set P := Q.comap (algebraMap (TypeDensity.BlowupChart R t x) B)
  let _ : Field (R ⧸ Ideal.span ({t,x} : Set R)) := Ideal.Quotient.field _
  obtain ⟨e0, hC, hX⟩ := TypeDensity.exceptional_chart_is_affine_line R t x
  let ψ : TypeDensity.BlowupChart R t x →+* Polynomial (R ⧸ Ideal.span ({t,x} : Set R)) :=
    e0.toRingHom.comp (Ideal.Quotient.mk (TypeDensity.exceptionalLevelIdeal R t x 1))
  have hψs : Function.Surjective ψ :=
    e0.surjective.comp Ideal.Quotient.mk_surjective
  have hψZ : ψ (TypeDensity.chartSlope R t x) = Polynomial.X := hX
  have hker : RingHom.ker ψ ≤ P := fun a ha ↦ by
    have h1 : e0 (Ideal.Quotient.mk (TypeDensity.exceptionalLevelIdeal R t x 1) a) = 0 := ha
    rw [map_eq_zero_iff _ e0.injective, Ideal.Quotient.eq_zero_iff_mem, TypeDensity.exceptionalLevelIdeal,
      pow_one] at h1
    exact (Ideal.span_le.mpr (by simpa using htP)) h1
  have hmapP : (P.map ψ).IsPrime := Ideal.map_isPrime_of_surjective hψs hker
  rw [← sup_eq_left.mpr hker, ← Ideal.comap_map_of_surjective' ψ hψs P]
  have key : ∃ f ∈ P.map ψ, f ≠ 0 := by
    by_cases h1 : TypeDensity.chartSlope R t x - 1 ∈ P
    · refine ⟨ψ (TypeDensity.chartSlope R t x - 1), Ideal.mem_map_of_mem _ h1, ?_⟩
      rw [map_sub, map_one, hψZ]
      exact Polynomial.X_sub_C_ne_zero 1
    · obtain ⟨y, i, hi, hy⟩ := Ideal.IsMaximal.exists_inv (inferInstance : Q.IsMaximal) h1
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (TypeDensity.chartSlope R t x)) y
      have hg : a * (TypeDensity.chartSlope R t x - 1) - (s : TypeDensity.BlowupChart R t x) ∈ P := by
        change algebraMap (TypeDensity.BlowupChart R t x) B _ ∈ Q
        have hs := IsLocalization.mk'_spec B a s
        have : algebraMap (TypeDensity.BlowupChart R t x) B
            (a * (TypeDensity.chartSlope R t x - 1) - (s : TypeDensity.BlowupChart R t x))
            = - (algebraMap (TypeDensity.BlowupChart R t x) B s * i) := by
          rw [map_sub, map_mul, ← hs]
          linear_combination (algebraMap (TypeDensity.BlowupChart R t x) B s) * hy
        rw [this]
        exact Q.neg_mem_iff.mpr (Q.mul_mem_left _ hi)
      refine ⟨_, Ideal.mem_map_of_mem _ hg, ?_⟩
      obtain ⟨n, hn⟩ := s.2
      intro h0
      have := congrArg (Polynomial.eval 1) h0
      rw [map_sub, map_mul, ← hn, map_pow, map_sub, map_one, hψZ] at this
      simp at this
  obtain ⟨f, hf, hf0⟩ := key
  have : (P.map ψ).IsMaximal :=
    IsPrime.to_maximal_ideal fun hbot ↦ hf0 (by rwa [hbot, Ideal.mem_bot] at hf)
