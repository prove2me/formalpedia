-- Source module: Solutions.KFV1Coef
/-!
# KFV §1: Lemma 16's computed procedures on coefficient vectors

The IL works on record coefficients (`RecRep r F zs (xs.map C.co)`), so the computed procedures
`procQ` / `procQI` of `GlueError` / `GlueProp18` (over a coefficient model `C` of `R`) are
transported to lists of coefficient vectors `Fin r → ℂ`:

* `nrotS s v`: the negacyclic rotation by `s` (`(y^s z)` in coefficients), read off the doubled
  record `[v, -v]` (`dbl`): `nrotS s v q = dbl v ((q + 2r - s mod 2r) mod 2r)`;
  `co_ypow`, `co_yp_mul`: `co (y^e z) = nrotS (e mod 2r) (co z)`.
* `twLc`, `layerQc`, `compRc`, `compRIc`, `procQc`, `procQIc`: the coefficient versions;
  **`co_procQ`**, **`co_procQI`**: `(procQ … xs).map co = procQc … (xs.map co)` (and `procQI`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open Finset Butterfly AModel Synth GlueLayout GlueP14 GlueError GlueProp18

/-! ## 1. Negacyclic rotation -/

section Rot

variable {r : ℕ}

/-- The doubled record `[v, -v]` (zero beyond `2r`). -/
def dbl (v : Fin r → ℂ) (k : ℕ) : ℂ :=
  if h : k < r then v ⟨k, h⟩ else if h2 : k < 2 * r then -v ⟨k - r, by omega⟩ else 0

/-- Negacyclic rotation by `s`. -/
def nrotS (s : ℕ) (v : Fin r → ℂ) : Fin r → ℂ :=
  fun q => NLogN.KFV.dbl v ((q + 2 * r - s % (2 * r)) % (2 * r))

end Rot

/-! ## 2. Monomials in coefficients -/

section Mono

variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)

/-- The exponent `e mod 2r` as a natural number. -/
def sOf (r : ℕ) (e : ℤ) : ℕ := (e % (2 * r : ℤ)).toNat

end Mono

/-! ## 3. Rounds on coefficients -/

section Rounds

variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)
variable {D : ℕ} {sh : Shape} {ι : Type} [Fintype ι] [DecidableEq ι]

/-- `J_E` on coefficient vectors. -/
noncomputable def twLc (r : ℕ) (sh : Shape) (Ex : ℕ → ℤ) (xs : List (Fin r → ℂ)) :
    List (Fin r → ℂ) :=
  (List.range (AModel.vol sh)).map fun j => nrotS (sOf r (Ex j)) (xs.getD j 0)

/-- The computed layer on coefficients: `Q_p ∘ H0^{⊗}`. -/
noncomputable def layerQc (p : ℕ) (Sb : SelBits sh ι) (xs : List (Fin r → ℂ)) :
    List (Fin r → ℂ) :=
  QpArr p (selOp Sb (Butterfly.tens H0) xs)

/-- The computed forward round on coefficients. -/
noncomputable def compRc (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List (Fin r → ℂ)) :
    List (Fin r → ℂ) :=
  twLc r sh Ex (layerQc p Sb xs)

/-- The computed opposite round on coefficients. -/
noncomputable def compRIc (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List (Fin r → ℂ)) :
    List (Fin r → ℂ) :=
  layerQc p Sb (twLc r sh (fun j => -Ex j) xs)

/-- The computed forward procedure on coefficients (rounds `n-1, …, 0`). -/
noncomputable def procQc (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ℕ → List (Fin r → ℂ) → List (Fin r → ℂ) :=
  runDown fun h => compRc p (Sb h) (roundEx L ℓ h (P h))

/-- The computed opposite procedure on coefficients (rounds `0, …, n-1`). -/
noncomputable def procQIc (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (n : ℕ)
    (xs : List (Fin r → ℂ)) : List (Fin r → ℂ) :=
  (List.range n).foldl (fun u k => compRIc p (Sb k) (roundEx L ℓ k (P k)) u) xs

end Rounds

end NLogN.KFV

end

