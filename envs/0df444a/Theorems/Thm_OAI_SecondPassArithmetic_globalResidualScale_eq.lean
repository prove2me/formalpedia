variable {ι : Type*} [DecidableEq ι]
  (p : ι → OAI.SecondPassArithmetic.O) (hp : ∀ i,p i ≠ 0) [∀ i,(Ideal.span {p i}).IsMaximal]
  (hcop : Pairwise (Function.onFun IsCoprime (fun i => Ideal.span {p i})))
  (hg : ∀ i,lambda ∉ Ideal.span {p i})
include hp
omit [∀ (i : ι), (span {p i}).IsMaximal] hp

theorem OAI.SecondPassArithmetic.globalResidualScale_eq (ell : ℝ) (side : Bool) (x : GlobalSecondData ι) :
    secondExpansionScale p (globalFirstColumnScale p ell x side/primeProductNorm p x.firstCommon)
      (primeSubsetGenerator (fun i => Ideal.span {p i}) (x.source.sourceCommon\x.source.divisor))
      (expansionSupportData x.common x.firstDivisor x.source) = globalActualResidualScale p ell side x := by sorry
