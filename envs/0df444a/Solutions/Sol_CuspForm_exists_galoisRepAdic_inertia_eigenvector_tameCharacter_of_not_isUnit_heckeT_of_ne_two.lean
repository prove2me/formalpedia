private theorem exists_isPrimitiveRoot {p : ℕ} (hp : p.Prime) : ∃ ζ : AlgebraicClosure ℚ, IsPrimitiveRoot ζ p := by
  haveI : NeZero (p : AlgebraicClosure ℚ) := ⟨Nat.cast_ne_zero.mpr hp.ne_zero⟩
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root (cyclotomic p (AlgebraicClosure ℚ)) (by
