theorem solution (R : Type) [CommRing R] (t x : R)
    [(Ideal.span ({t,x} : Set R)).IsMaximal] (hreg : TypeDensity.RegularParameterPair R t x) (d : ℕ)
    (c : Fin (d + 1) → R) (i₀ : Fin (d + 1)) (hi₀ : c i₀ ∉ Ideal.span {t,x}) :
    (∑ i : Fin (d+1), c i * t^(d - i.val) * x^i.val) ∉ (Ideal.span {t,x})^(d+1) := by
  intro hF
  set φ := TypeDensity.chartBase R t x with hφ
  set Z := TypeDensity.chartSlope R t x with hZ
  have hrel : φ t * Z = φ x := TypeDensity.blowup_chart_relation R t x
  have hinjd : IsLeftRegular (φ t ^ d) :=
    IsLeftRegular.pow d (TypeDensity.blowup_exceptional_parameter_regular R t x hreg)
  set P : TypeDensity.BlowupChart R t x := ∑ i : Fin (d+1), φ (c i) * Z ^ i.val with hP
  have hFP : φ (∑ i : Fin (d+1), c i * t^(d - i.val) * x^i.val) = φ t ^ d * P := by
    rw [map_sum, hP, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    have hi : i.val ≤ d := Nat.lt_succ_iff.mp i.2
    simp only [map_mul, map_pow]
    rw [← hrel, mul_pow]
    have : φ t ^ d = φ t ^ (d - i.val) * φ t ^ i.val := by
      rw [← pow_add, Nat.sub_add_cancel hi]
    rw [this]; ring
  have hmem : φ (∑ i : Fin (d+1), c i * t^(d - i.val) * x^i.val) ∈ (Ideal.span {φ t})^(d+1) := by
    have h1 : φ (∑ i : Fin (d+1), c i * t^(d - i.val) * x^i.val) ∈ Ideal.map φ
        ((Ideal.span {t,x})^(d+1)) :=
      Ideal.mem_map_of_mem _ hF
    rw [Ideal.map_pow] at h1
    refine Ideal.pow_right_mono ?_ _ h1
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨y, hy, rfl⟩
    rcases hy with rfl | hy
    · exact Ideal.subset_span rfl
    · have : y = x := by simpa using hy
      subst this
      rw [SetLike.mem_coe, ← hrel]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem
  obtain ⟨w, hw⟩ := hmem
  rw [hFP] at hw
  have hPw : P = φ t * w := hinjd <| show φ t ^ d * P = φ t ^ d * (φ t * w) by
    rw [← mul_assoc, ← pow_succ, ← hw]; ring
  obtain ⟨e, he1, he2⟩ := TypeDensity.exceptional_chart_is_affine_line R t x
  have hQ : (∑ i : Fin (d+1), TypeDensity.levelBase R t x 1 (c i) * TypeDensity.levelSlope R t x 1 ^ i.val)
      = Ideal.Quotient.mk (TypeDensity.exceptionalLevelIdeal R t x 1) P := by
    rw [hP, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp [TypeDensity.levelBase, TypeDensity.levelSlope, hφ, hZ]
  have hzero : Ideal.Quotient.mk (TypeDensity.exceptionalLevelIdeal R t x 1) P = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem, hPw, TypeDensity.exceptionalLevelIdeal, pow_one]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  have h0 := congrArg e (hQ.trans hzero)
  rw [map_sum, map_zero] at h0
  have h1 := congrArg (fun p => Polynomial.coeff p i₀.val) h0
  simp only [map_mul, map_pow, he1, he2, Polynomial.finsetSum_coeff, Polynomial.coeff_zero] at h1
  rw [Finset.sum_eq_single i₀] at h1
  · exact hi₀ (Ideal.Quotient.eq_zero_iff_mem.mp (by simpa using h1))
  · intro b _ hb
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    have : i₀.val ≠ b.val := fun h => hb (Fin.ext h).symm
    simp [this]
  · simp
