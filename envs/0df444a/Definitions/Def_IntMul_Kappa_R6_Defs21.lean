-- Source module: Solutions.R6IL2CStep
/-!
# Round six, compact controls (I2C): the steps of the compact program on records

* `swRec_runs`: a Lemma 12 swap (`IL2.swE`) of two fields of the same size on the record array
  `flR recs M` is `recs ∘ swP`.
* `rotRec_runs`: a uniform table rotation (`rotR`) on the record array is `recs ∘ rotP`.
* The four segment terms `tmA, tmB, tmS, tmC` (`SegTR`).
* The offsets of the program depend only on the digits (`oA_mod`, …), and the table entries of the
  ten rotations are the offsets of the pulls (`rotYA_eq`, …): every step is `Lay.stepP`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS AModel AModelL12 Finset

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

/-! ## The swap -/

/-- The conclusion of `IL2.swE_spec` for the constant `Ksw`. -/
def SwOK (tab : Fin 1 → IStmt HS 1) (l12 : IStmt HS 1) (τ : ℝ) (Ksw : ℝ) : Prop :=
  ∀ (u : ℕ) (Pre G Suf : Shape), 1 ≤ u →
    (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
    ∀ (I : List Sym) (t : IState HS) (xs : List (ZMod 2)) (R : List Item),
    t.G 0 = ints (enc2 xs) ++ R →
    xs.length = vol (binShape Pre G Suf (2 ^ u)) →
    ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (vol (binShape Pre G Suf (2 ^ u)) : ℤ) + 3 →
    eP.size + eG.size + eS.size + eU.size ≤ 50 →
    KFX.NoK eP → KFX.NoK eG → KFX.NoK eS → KFX.NoK eU →
    ESp eP t Bb (vol Pre : ℤ) → ESp eG t Bb (vol G : ℤ) → ESp eS t Bb (vol Suf : ℤ) →
    ESp eU t Bb (u : ℤ) →
    ∃ c : ℕ, IRuns I tab (IL2.swE l12 eP eG eS eU) t
      (t.upd 0 (ints (pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
        (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)) ++ R)) c ∧
      (c : ℝ) ≤ Ksw * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ

/-! ## The rotation -/

/-! ## The segment terms -/

/-- `2 (a mod 2) (b mod R)`. -/
def tmA : Ex HS := .mul (.lit 2) (.mul (.nmod (.reg rU) (.lit 2)) (.nmod (.reg rV) (.reg pR)))
def tfA (R : ℤ) (a b : ℤ) : ℤ := 2 * (a % 2) * (b % R)

/-- `(a mod 2) (1 - 2 (b mod R))`. -/
def tmB : Ex HS :=
  .mul (.nmod (.reg rU) (.lit 2)) (.add (.lit 1) (.mul (.lit (-2)) (.nmod (.reg rV) (.reg pR))))
def tfB' (R : ℤ) (a b : ℤ) : ℤ := (a % 2) * (1 - 2 * (b % R))

/-- `a mod 2`. -/
def tmS : Ex HS := .nmod (.reg rU) (.lit 2)
def tfS (a b : ℤ) : ℤ := a % 2

/-- `(a mod 2 + b mod 2) mod 2`. -/
def tmC : Ex HS := .nmod (.add (.nmod (.reg rU) (.lit 2)) (.nmod (.reg rV) (.lit 2))) (.lit 2)
def tfC (a b : ℤ) : ℤ := (a % 2 + b % 2) % 2

/-! ## Offsets through digits -/

end IntMul.Kappa.R6.IL2C

