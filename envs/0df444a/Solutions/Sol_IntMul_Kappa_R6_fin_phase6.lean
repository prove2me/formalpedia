-- Source module: Solutions.KFMBig8
/-!
# KFM Big8: the rounding passes

After `Z` (`mulP`), `conj; ×S; ×S; ×2^{2b+4}; round_p` maps each numerator `v` of `cnj Z` to
`rndV v = round((S·(S·v))·2^{2b+4} / 2^p)`.

* **`round_pt`**: if `2^{2b+4} S (S · cnj Z_k)` is within `1/2` of the natural `c`, the two rounded
  numerators at `k` are `c` and `0`.
* `gR_zero`: zeros stay zero (the padding).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open Complex AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

theorem gR_eq (p b S : ℕ) (v : ℤ) :
    rndV p b S v = ((S : ℤ) * ((S : ℤ) * v) * 2 ^ (2 * b + 4) + 2 ^ (p - 1)).tdiv (2 ^ p) := by
  simp [rndV]

theorem gR_zero (p b S : ℕ) (hp : 1 ≤ p) : rndV p b S 0 = 0 := by
  rw [gR_eq]
  simp only [mul_zero, zero_mul, zero_add]
  exact Int.tdiv_eq_zero_of_lt (by positivity) (pow_lt_pow_right₀ (by norm_num) (by omega))

/-- **Rounding at one point.** -/
theorem round_pt (p b S : ℕ) (hp : 1 ≤ p) (z : GI) (c : ℕ)
    (h : ‖(2 : ℂ) ^ (2 * b + 4) * (S : ℂ) * ((S : ℂ) * starRingEnd ℂ (toC z / 2 ^ p)) - (c : ℂ)‖ <
      1 / 2) :
    rndV p b S z.1 = c ∧ rndV p b S (-z.2) = 0 := by
  set X1 : ℤ := (S : ℤ) * ((S : ℤ) * z.1) * 2 ^ (2 * b + 4) with hX1
  set X2 : ℤ := (S : ℤ) * ((S : ℤ) * (-z.2)) * 2 ^ (2 * b + 4) with hX2
  set w := (2 : ℂ) ^ (2 * b + 4) * (S : ℂ) * ((S : ℂ) * starRingEnd ℂ (toC z / 2 ^ p)) with hw
  have key : w - c = (((X1 : ℝ) / 2 ^ p - c : ℝ) : ℂ) + (((X2 : ℝ) / 2 ^ p : ℝ) : ℂ) * I := by
    rw [hw, hX1, hX2]
    simp only [map_div₀, map_pow, toC, map_add, map_mul, Complex.conj_ofReal, Complex.conj_I,
      map_intCast, map_natCast, map_ofNat]
    push_cast
    ring
  have h1 : (w - c).re = (X1 : ℝ) / 2 ^ p - c := by
    rw [key]
    simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im, Complex.I_re,
      Complex.I_im]
    ring
  have h2 : (w - c).im = (X2 : ℝ) / 2 ^ p := by
    rw [key]
    simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re, Complex.I_re,
      Complex.I_im]
    ring
  have hre : |(X1 : ℝ) / 2 ^ p - ((c : ℤ) : ℝ)| < 1 / 2 := by
    push_cast
    calc |(X1 : ℝ) / 2 ^ p - c| = |(w - c).re| := by rw [h1]
      _ ≤ ‖w - c‖ := Complex.abs_re_le_norm _
      _ < 1 / 2 := h
  have him : |(X2 : ℝ) / 2 ^ p - ((0 : ℤ) : ℝ)| < 1 / 2 := by
    push_cast
    calc |(X2 : ℝ) / 2 ^ p - 0| = |(w - c).im| := by rw [h2, sub_zero]
      _ ≤ ‖w - c‖ := Complex.abs_im_le_norm _
      _ < 1 / 2 := h
  refine ⟨?_, ?_⟩
  · rw [gR_eq]; exact tdiv_round p hp X1 c (by positivity) hre
  · rw [gR_eq]; exact tdiv_round p hp X2 0 le_rfl him

/-! ## The passes -/

end

