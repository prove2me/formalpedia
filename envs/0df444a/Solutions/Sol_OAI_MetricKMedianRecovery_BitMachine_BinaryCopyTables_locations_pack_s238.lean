  rw [he,List.map_cons,encode,head_cons]
  have hm : h=H.min' hH := by
    have hh:=@Finset.sorted_zero_eq_min' (Fin n) _ H (by rw [Finset.length_sort];exact hH.card_pos)
    simpa only [he,List.getElem_cons_zero] using hh
