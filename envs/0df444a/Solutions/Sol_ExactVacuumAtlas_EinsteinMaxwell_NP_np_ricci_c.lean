  obtain ⟨e00, e01, e02, e03, e10, e11, e12, e13, e20, e21, e22, e23, e30, e31, e32, e33⟩ := eta_vals
  simp only [Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL', e00, e01, e02, e03, e10, e11, e12,
    e13, e20, e21, e22, e23, e30, e31, e32, e33, zero_mul, mul_zero, add_zero, zero_add, sub_zero, zero_sub,
    neg_zero, one_mul, mul_one, neg_mul, mul_neg, neg_neg, zero_div]
  try (clear e00 e01 e02 e03 e10 e11 e12 e13 e20 e21 e22 e23 e30 e31 e32 e33)))
  simp only [npTau, npPiB, npRho, npTauB, npPi, npSigma, npEps, npEpsB, npGamma, npGammaB, npKappa]
