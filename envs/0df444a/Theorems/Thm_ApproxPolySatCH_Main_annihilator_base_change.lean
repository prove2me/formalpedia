-- title:
--   Claim 7 — Annihilator generator persists over the algebraic closure
-- statement:
--   Let $K=\overline{k}$ and let $\bar f$ denote the images of the polynomials $f_i$ under $k\hookrightarrow K$. If the substitution kernel of $f$ over $k$ is generated by $H$, then the substitution kernel of $\bar f$ over $K$ is generated by the scalar extension $\bar H$:
--   $$\ker\big(K[Y]\to K[X],\,Y_i\mapsto \bar f_i\big)=(\bar H).$$
--   No irreducibility of $\bar H$ is asserted. This is precisely the algebraic-closure presentation used in Claim 7, via flatness of the field extension $K/k$.
-- source:
--   STOC 2027 submission #1125, Claim 7 and proof, pp.17–18 (the notation $\bar H$ and $\bar I$ is on p.17; the proof is on p.18).

import Definitions.Def_ApproxPolySatCH_Main_ResultantLanguages

set_option autoImplicit false

theorem ApproxPolySatCH.Main.annihilator_base_change {k : Type} [Field k] {n : ℕ}
    (f : Fin (n + 1) → Poly k n) (H : Poly k (n + 1))
    (hker : annihilator f = Ideal.span {H}) :
    annihilator (extendedSystem f) =
      Ideal.span {MvPolynomial.map (algebraMap k (Constants k)) H} := by sorry
