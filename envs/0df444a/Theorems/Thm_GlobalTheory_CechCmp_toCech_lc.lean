theorem GlobalTheory.CechCmp.toCech_lc {n : ℕ} (cc : Fin n → R) (f : Fin n → CatCoh.C1 (capF s U hU hinf)) :
    toCech s U hU hinf (∑ a, cc a • f a) =
      fun i j => ∑ a, constFn s (U i ⊓ U j) (cc a) * toCech s U hU hinf (f a) i j := by sorry
