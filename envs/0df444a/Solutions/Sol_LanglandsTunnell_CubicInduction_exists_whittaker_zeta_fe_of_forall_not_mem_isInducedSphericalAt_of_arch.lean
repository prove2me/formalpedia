private theorem apply_iota_globalPoints_mul_mirabolicTranslate_mul {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ : IsPrincipalInvariantAddChar ℚ ψ) {W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (d : GL (Fin 2) ℚ) (hd : d ∈ unipotentNormalizer ℚ) (i : MirabolicIndex ℚ)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g)) =
      W (mirabolicTranslate (mirabolicReindex d hd i) * g) := by
  obtain ⟨x, hx⟩ := exists_mul_mirabolicRep_eq d hd i

  have e : iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g) =
      upperUnipotent3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x) 0 0 *
        (mirabolicTranslate (mirabolicReindex d hd i) * g) :=
    calc iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g)
        = iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ i)) * g :=
          (mul_assoc _ _ _).symm
      _ = iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (d * mirabolicRep ℚ i)) * g := by
          simp only [map_mul]
      _ = iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (unipotentGL2 x * mirabolicRep ℚ (mirabolicReindex d hd i))) * g :=
          congrArg (fun y => iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ y) * g) hx
      _ = upperUnipotent3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x) 0 0 *
            iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ (mirabolicReindex d hd i))) * g := by
          simp only [map_mul, iota_globalPoints_unipotentGL2]
      _ = upperUnipotent3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x) 0 0 *
            (mirabolicTranslate (mirabolicReindex d hd i) * g) := mul_assoc _ _ _
  calc W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g))
      = W (upperUnipotent3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x) 0 0 *
          (mirabolicTranslate (mirabolicReindex d hd i) * g)) := congrArg W e
    _ = ψ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x + 0) * W (mirabolicTranslate (mirabolicReindex d hd i) * g) :=
        hW (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) x) 0 0 _
    _ = W (mirabolicTranslate (mirabolicReindex d hd i) * g) := by simp only [add_zero, hψ x, one_mul]

private theorem hasSum_mirabolicTranslate_comp_mul_iff {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ : IsPrincipalInvariantAddChar ℚ ψ) {W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (d : GL (Fin 2) ℚ) (hd : d ∈ unipotentNormalizer ℚ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (S : ℂ) :
    HasSum (fun i : MirabolicIndex ℚ => W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g)))
        S ↔
      HasSum (fun i : MirabolicIndex ℚ => W (mirabolicTranslate i * g)) S := by
  have e : (fun i : MirabolicIndex ℚ => W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * (mirabolicTranslate i * g))) =
      (fun i : MirabolicIndex ℚ => W (mirabolicTranslate i * g)) ∘ mirabolicReindex d hd := by
    funext i
    exact apply_iota_globalPoints_mul_mirabolicTranslate_mul hψ hW d hd i g
  exact (congrArg (fun f : MirabolicIndex ℚ → ℂ => HasSum f S) e).to_iff.trans (Equiv.hasSum_iff _)

private theorem apply_iota_globalPoints_mul_iota {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ : IsPrincipalInvariantAddChar ℚ ψ) {W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (d : GL (Fin 2) ℚ) (hd : d ∈ unipotentNormalizer ℚ) (i : MirabolicIndex ℚ)
    (h : AdelicGL2 (𝓞 ℚ) ℚ) :
    W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ i) * h)) =
      W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ (mirabolicReindex d hd i)) * h)) := by
  have := apply_iota_globalPoints_mul_mirabolicTranslate_mul hψ hW d hd i (iota (𝓞 ℚ) ℚ h)
  simpa only [mirabolicTranslate, map_mul, mul_assoc] using this

private theorem hasWhittakerHalfPlane_of_tsum_eq {W₁ W₂ : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ}
    (h : ∀ g : AdelicGL2 (𝓞 ℚ) ℚ,
      (∑' i : MirabolicIndex ℚ,
          (‖W₁ (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ i) * g))‖₊ : ENNReal)) =
        ∑' i : MirabolicIndex ℚ, (‖W₂ (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ i) * g))‖₊ : ENNReal))
    (h₂ : HasWhittakerHalfPlane W₂) : HasWhittakerHalfPlane W₁ := by
  obtain ⟨σ₀, hσ₀⟩ := h₂
  refine ⟨σ₀, fun σ hσ D hD => ?_⟩
  simp only [h]
  exact hσ₀ σ hσ D hD

private theorem hasWhittakerHalfPlane_comp_mul {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ : IsPrincipalInvariantAddChar ℚ ψ) {W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (d : GL (Fin 2) ℚ) (hd : d ∈ unipotentNormalizer ℚ) (hhp : HasWhittakerHalfPlane W) :
    HasWhittakerHalfPlane fun g => W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) * g) :=
  hasWhittakerHalfPlane_of_tsum_eq (fun h => by
    simp_rw [apply_iota_globalPoints_mul_iota hψ hW d hd]
    exact Equiv.tsum_eq (mirabolicReindex d hd)
      fun i => (‖W (iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ (mirabolicRep ℚ i) * h))‖₊ : ENNReal)) hhp

end
