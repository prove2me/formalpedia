    (hN : s.G NLogN.RN = .int (2 ^ n) :: LN) (hF : s.G NLogN.RF = .int (2 ^ n + 1) :: LF)
    (hP : s.G NLogN.PRM = .int n :: LP) (h2 : s.G NLogN.W2 = .int (2 ^ (n - k)) :: L2)
    (hH : s.G NLogN.HB = .int (2 ^ (n - 1)) :: LH) (hE : s.G NLogN.DE = .int (2 ^ (2 * Q)) :: LE)
    (hRQ : s.G NLogN.RQ = .int (2 ^ Q) :: LQ) :
