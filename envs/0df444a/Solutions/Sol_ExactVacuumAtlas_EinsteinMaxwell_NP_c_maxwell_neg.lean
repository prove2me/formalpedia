local notation "FK" => faradayKN a Q

variable (hτ : KNCTan M a Q U τ)
include hτ

/-! #### Frame derivatives commute with the complex combination -/

theorem fdir_cPhi2 (hx : x ∈ U) (A : Fin 4) : fdir EK A (cPhi2 M a Q τ) x
    = fdir EK A (FfrFVar FK τ.fR EK τ.BR 3 1) x + I * fdir EK A (FfrFVar FK τ.fI EK τ.BI 3 1) x :=
  fdir_cplx hτ.isOpen hx (RealFrameTangent.kn_FfrFVar hτ.isOpen hτ.sub hτ.re 3 1)
    (RealFrameTangent.kn_FfrFVar hτ.isOpen hτ.sub hτ.im 3 1) A

/-! #### Step 2: complexified identities with the sources kept -/

/-! #### Step 3–4: the sources vanish on `U` -/

variable (hL : CLinEM M a Q U τ)
include hL

omit hτ in
theorem clin_LJ_re {y : Pt 4} (hy : y ∈ U) (j : Fin 4) : linMaxwell gK giK FK τ.hR τ.fR j y = 0 :=
  ((cplx_eq_zero_iff _ τ y).1 (hL.maxwell y hy j)).1
omit hτ in
theorem clin_LJ_im {y : Pt 4} (hy : y ∈ U) (j : Fin 4) : linMaxwell gK giK FK τ.hI τ.fI j y = 0 :=
  ((cplx_eq_zero_iff _ τ y).1 (hL.maxwell y hy j)).2
omit hτ in
theorem clin_LH_re {y : Pt 4} (hy : y ∈ U) (i j k : Fin 4) : linFaraday τ.fR i j k y = 0 :=
  ((cplx_eq_zero_iff (fun _ f => linFaraday f i j k) τ y).1 (hL.faraday y hy i j k)).1
omit hτ in
theorem clin_LH_im {y : Pt 4} (hy : y ∈ U) (i j k : Fin 4) : linFaraday τ.fI i j k y = 0 :=
  ((cplx_eq_zero_iff (fun _ f => linFaraday f i j k) τ y).1 (hL.faraday y hy i j k)).2

theorem HfrVar_zero_re {y : Pt 4} (hy : y ∈ U) (A K C : Fin 4) : HfrVar FK τ.fR EK τ.BR A K C y = 0 := by
  simp [HfrVar_KN (hτ.sub hy), clin_LH_re hL hy]
theorem HfrVar_zero_im {y : Pt 4} (hy : y ∈ U) (A K C : Fin 4) : HfrVar FK τ.fI EK τ.BI A K C y = 0 := by
  simp [HfrVar_KN (hτ.sub hy), clin_LH_im hL hy]
theorem JfrVar_zero_re {y : Pt 4} (hy : y ∈ U) (K : Fin 4) : JfrVar gK giK FK τ.hR τ.fR ΘK τ.BR K y = 0 := by
  simp [JfrVar_KN (hτ.sub hy), clin_LJ_re hL hy]
theorem JfrVar_zero_im {y : Pt 4} (hy : y ∈ U) (K : Fin 4) : JfrVar gK giK FK τ.hI τ.fI ΘK τ.BI K y = 0 := by
  simp [JfrVar_KN (hτ.sub hy), clin_LJ_im hL hy]

theorem cSrc3_zero (hg : ∀ y ∈ U, cPhi2 M a Q τ y = 0) : ∀ y ∈ U, cSrc3 M a Q τ y = 0 := by
  intro y hy
  have hd := (fdir_cPhi2 hτ hy 0).symm.trans (fdir_eq_zero_of hτ.isOpen hy hg 0)
  have g0 := hg y hy
  simp only [cPhi2, cplx, phi2Var] at g0
  simp only [cSrc3, cplx, srcS3, HfrVar_zero_re hτ hL hy, HfrVar_zero_im hτ hL hy, JfrVar_zero_re hτ hL hy,
    JfrVar_zero_im hτ hL hy]
  linear_combination hd - (npRho gK giK EK ΘK y - 2 * npEps gK giK EK ΘK y) * g0

theorem cSrc4_zero (hg : ∀ y ∈ U, cPhi2 M a Q τ y = 0) : ∀ y ∈ U, cSrc4 M a Q τ y = 0 := by
  intro y hy
  have hd := (fdir_cPhi2 hτ hy 2).symm.trans (fdir_eq_zero_of hτ.isOpen hy hg 2)
  have g0 := hg y hy
  simp only [cPhi2, cplx, phi2Var] at g0
  simp only [cSrc4, cplx, srcS4, HfrVar_zero_re hτ hL hy, HfrVar_zero_im hτ hL hy, JfrVar_zero_re hτ hL hy,
    JfrVar_zero_im hτ hL hy]
  linear_combination hd - (npTau gK giK EK ΘK y - 2 * npBeta gK giK EK ΘK y) * g0

