theorem J6Seg.PJ.Rn.fsIs (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r cw i : ℕ} (h5 : u 5 = r) (h3 : u 3 = cw) (h2 : u 2 = i)
    (hi : i < cw) (hcw : cw ≤ r) (hr : r < m) (h4 : u 4 = Lg L r) :
    Rn (progL fsI) u c (fun u' => (∀ i ∉ ([6, 7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update c 41 ((if bandS mw cB (Lg L r) (Lg L (r - cw + i)) then
          fdiv Q (Mf r (r - cw + i)) (Mf (r - cw + i) (r - cw + i)) else 0) :: c 41))
      (costL W (m * m + m) fsI) := by sorry
