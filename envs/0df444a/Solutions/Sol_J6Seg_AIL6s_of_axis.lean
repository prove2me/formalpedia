theorem extL_idx {EA nU : ℕ} (tab : Fin 1 → IStmt HS 1) (extA : Fin EA → IStmt HS (7 + EA))
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (body : IStmt HS (7 + (EA + 0 + 0 + 0 + (nU + 1)))) (i : Fin nU) :
    IL.kTableP tab (extL extA U body) (idxL EA nU i) = U _ (idxL EA nU) i := by
  unfold extL
  refine (mTab4_own tab extA ext0 ext0 ext0 (ownL U (idxL EA nU) body) (Fin.castSucc i)).trans ?_
  unfold ownL
  rw [dif_pos (by simp)]
  rfl

theorem extL_body {EA nU : ℕ} (tab : Fin 1 → IStmt HS 1) (extA : Fin EA → IStmt HS (7 + EA))
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (body : IStmt HS (7 + (EA + 0 + 0 + 0 + (nU + 1)))) :
    IL.kTableP tab (extL extA U body) (gO4 EA 0 0 0 (nU + 1) (Fin.last nU)) = body := by
  unfold extL
  refine (mTab4_own tab extA ext0 ext0 ext0 (ownL U (idxL EA nU) body) (Fin.last nU)).trans ?_
  unfold ownL
  rw [dif_neg (by simp)]

