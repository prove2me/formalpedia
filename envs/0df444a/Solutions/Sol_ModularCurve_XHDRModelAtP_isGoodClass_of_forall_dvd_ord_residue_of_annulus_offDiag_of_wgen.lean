  set f₀ : ↥(xHFunctionFieldBar M H) := f * u₀ ^ n with hf₀_def
  have hf₀gu : ∃ h : f₀ ∈ Rpd.R₁.integers, Rpd.R₁.residue ⟨f₀, h⟩ ≠ 0 := gu_mul Rpd.R₁ ⟨h₁, hr₁⟩ (gu_pow Rpd.R₁ hu₀gu n)
  obtain ⟨hf₀₁, hf₀r₁⟩ := hf₀gu
  have hf₀0 : f₀ ≠ 0 := gu_ne_zero Rpd.R₁ ⟨hf₀₁, hf₀r₁⟩
  have hf₀div : ∀ W, (n : ℤ) * EE W = W.ord f₀ := by
