theorem TypeDensity.cell_assignment_exists (k : Type) [Field k] [Finite k] (s : State) (hs : s.Valid)
    (P : TangentPattern s.degree) (hP : Allowed s P) (Dv : ExceptionalDivisor k)
    (hDv : HasPattern k s Dv P) :
    Nonempty (CellAssignment k s P Dv) := by sorry
