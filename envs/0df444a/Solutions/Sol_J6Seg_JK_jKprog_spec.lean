  have bT : B1 dTJ = body ++ [] := by simp +decide [hB1, hdrSt, update_apply]; try rfl
  have bCR : B1 CR = [] := by
    simp +decide only [hB1, hdrSt, update_apply, ↓reduceIte]; exact hF0 _ (by decide) (by decide)
  have bCM : B1 CM = [] := by
    simp +decide only [hB1, hdrSt, update_apply, ↓reduceIte]; exact hF0 _ (by decide) (by decide)
