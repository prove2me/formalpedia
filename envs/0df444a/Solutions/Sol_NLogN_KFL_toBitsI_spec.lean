        (by simp +decide [t1, T, cf, hCw, hll]) (by simp +decide [t1, T, cf, hDw]) hLCw hLDw hlb
      refine (m1.seq m2).mono' ?_ ?_
      · clear m1 m2
        have e1 : L.drop ((k + 1) * (w + 1)) = D'.drop w := by
          rw [show (k + 1) * (w + 1) = m + 1 + w by simp only [m]; ring, ← List.drop_drop,
            ← List.drop_drop]
          show (D.drop 1).drop w = _
          rw [hD']; rfl
        have e2 : L.take ((k + 1) * (w + 1)) = L.take m ++ a :: l := by
          rw [show (k + 1) * (w + 1) = m + (w + 1) by simp only [m]; ring, List.take_add]
          show L.take m ++ D.take (w + 1) = _
          rw [hD']; rfl
        simp only [t1, T, cf, e1, e2]
        rw [List.reverse_append, List.reverse_cons]
        simp only [ints_append, List.append_assoc]
        clear hDD hD' hDb hlb hab hm hDl hD'l hll e1 e2
        ((apply NLogN.IState.ext' <;> intros <;>
                 simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
               split_ifs <;>
             simp_all +decide))
        all_goals rfl
      · have h1 := mv_cost_le hab
        simp only [cMB, hll, kap] at h1 ⊢; nlinarith)
  have e0 : cf (T 0) cCN cDN (marks n ++ LCN) LDN = s := by
    simp only [T, cf, Nat.zero_mul, List.drop_zero, List.take_zero]
    rw [← hO, ← hCN, ← hDN]; simp [ints]
  have e1 : cf (T n) cCN cDN (marks n ++ LCN) LDN =
      (s.upd cO RO).upd 0 (ints L.reverse ++ s.G 0) := by
    rw [← hCN, ← hDN]
    simp only [T, cf, ← hL, List.drop_length, List.take_length]; simp [ints]; ((apply NLogN.IState.ext' <;> intros <;>
                                                                                       simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                                                                     split_ifs <;>
                                                                                   simp_all +decide))
  rw [e0, e1] at hu
  exact hu

theorem toCore_runs (s : IState HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, zsz x ≤ w)
    (R L2 LCw LDw LCN LDN : List Item)
    (h0 : s.G 0 = ints xs ++ R) (h2 : s.G cR2 = .int 2 :: L2)
    (hCw : s.G cCw = marks w ++ LCw) (hDw : s.G cDw = LDw) (hLCw : NM LCw) (hLDw : NM LDw)
    (hCN : s.G cCN = marks xs.length ++ LCN) (hDN : s.G cDN = LDN) (hLCN : NM LCN)
    (hLDN : NM LDN) :
    IRuns I iprog toCore s (s.upd 0 (ints (bitsL w xs) ++ R))
      (xs.length * (cBody1 w + 64) + 60 + (xs.length * (cMB w + 64) + 60)) := by
  have h1 := fwdLoop_runs (I := I) (iprog := iprog) s xs w hxs R L2 LCw LDw LCN LDN h0 h2 hCw hDw
    hLCw hLDw hCN hDN hLCN hLDN
  set s1 := (s.upd 0 R).upd cO (ints (bitsL w xs).reverse ++ s.G cO)
  have h2' := mvBack_runs (I := I) (iprog := iprog) s1 xs.length w (bitsL w xs).reverse
    (by rw [List.length_reverse, length_bitsL]) (fun x hx => bnd_bitsL w xs x (List.mem_reverse.1 hx))
    (s.G cO) LCw LDw LCN LDN (by simp +decide [s1, ints_reverse])
    (by simp +decide [s1, hCw]) (by simp +decide [s1, hDw]) hLCw hLDw
    (by simp +decide [s1, hCN]) (by simp +decide [s1, hDN]) hLCN hLDN
  refine (h1.seq h2').mono' ?_ le_rfl
  clear h1 h2'
  simp only [s1, List.reverse_reverse]
  ((apply NLogN.IState.ext' <;> intros <;>
           simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
         split_ifs <;>
       simp_all +decide))

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFL
open IntMul KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, NLogN.zsz x ≤ w)
    (R : List NLogN.Item) (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.IRuns I iprog (NLogN.KFL.toBitsI xs.length w) t (t.upd 0 (NLogN.ints (NLogN.KFL.bitsL w xs) ++ R)) (NLogN.KFL.cTo xs.length w) := by
  have c1 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t) NLogN.KFL.cPN (xs.length : ℤ)
  set t1 := t.upd NLogN.KFL.cPN (.int (xs.length : ℤ) :: t.G NLogN.KFL.cPN)
  have c2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t1) NLogN.KFL.cPW (w : ℤ)
  set t2 := t1.upd NLogN.KFL.cPW (.int (w : ℤ) :: t1.G NLogN.KFL.cPW)
  have c3 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t2) NLogN.KFL.cR2 2
  set t3 := t2.upd NLogN.KFL.cR2 (.int 2 :: t2.G NLogN.KFL.cR2)
  set u := (t3.upd NLogN.KFL.cCN (NLogN.KFC.marks xs.length ++ .int 0 :: t3.G NLogN.KFL.cCN)).upd NLogN.KFL.cDN (.int 0 :: t3.G NLogN.KFL.cDN)
  set v := (u.upd NLogN.KFL.cCw (NLogN.KFC.marks w ++ .int 0 :: u.G NLogN.KFL.cCw)).upd NLogN.KFL.cDw (.int 0 :: u.G NLogN.KFL.cDw)
  have hc := NLogN.KFL.toCore_runs (I := I) (iprog := iprog) v xs w hxs R (t.G NLogN.KFL.cR2) (.int 0 :: t.G NLogN.KFL.cCw)
    (.int 0 :: t.G NLogN.KFL.cDw) (.int 0 :: t.G NLogN.KFL.cCN) (.int 0 :: t.G NLogN.KFL.cDN)
    (by simp +decide [v, u, t3, t2, t1, h0]) (by simp +decide [v, u, t3, t2, t1])
    (by simp +decide [v, u, t3, t2, t1]) (by simp +decide [v, u, t3, t2, t1]) (NLogN.KFC.NM_int _ _)
    (NLogN.KFC.NM_int _ _) (by simp +decide [v, u, t3, t2, t1]) (by simp +decide [v, u, t3, t2, t1])
    (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
  have wi := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := NLogN.KFL.cPW) (C := NLogN.KFL.cCw) (D := NLogN.KFL.cDw) (X := 0)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) u w (t1.G NLogN.KFL.cPW) _ (by simp +decide [u, t3, t2]) _ _ hc
  have wo := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := NLogN.KFL.cPN) (C := NLogN.KFL.cCN) (D := NLogN.KFL.cDN) (X := 0)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) t3 xs.length (t.G NLogN.KFL.cPN) _ (by simp +decide [t3, t2, t1]) _ _ wi
  set t4 := t3.upd 0 (NLogN.ints (NLogN.KFL.bitsL w xs) ++ R)
  have d1 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t4) (i := NLogN.KFL.cR2) (a := 2) (L := t.G NLogN.KFL.cR2)
    (by simp +decide [t4, t3, t2, t1])
  have d2 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t4.upd NLogN.KFL.cR2 (t.G NLogN.KFL.cR2)) (i := NLogN.KFL.cPW)
    (a := (w : ℤ)) (L := t.G NLogN.KFL.cPW) (by simp +decide [t4, t3, t2, t1])
  have d3 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := (t4.upd NLogN.KFL.cR2 (t.G NLogN.KFL.cR2)).upd NLogN.KFL.cPW (t.G NLogN.KFL.cPW))
    (i := NLogN.KFL.cPN) (a := (xs.length : ℤ)) (L := t.G NLogN.KFL.cPN) (by simp +decide [t4, t3, t2, t1])
  refine (c1.seq (c2.seq (c3.seq (wo.seq (d1.seq (d2.seq d3)))))).mono' ?_ ?_
  · clear c1 c2 c3 wo wi hc d1 d2 d3
    simp only [t4, t3, t2, t1]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have z2 : NLogN.zsz (2 : ℤ) = 2 := NLogN.zsz_two'
    rw [z2]; unfold NLogN.KFL.cTo; omega
end
