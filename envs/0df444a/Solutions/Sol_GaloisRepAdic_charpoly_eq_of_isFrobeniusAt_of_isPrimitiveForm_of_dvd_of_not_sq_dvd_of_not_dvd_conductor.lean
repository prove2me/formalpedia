          = ψL (b ℓ) ∧
        Λ' (ModularCurve.rationalDiamondOne lam (ModularCurve.JOne (M₀ * q)) ℓ) * ψL (e ℓ) = 1 := by
    intro ℓ hℓ hℓM hℓS'
    have h12 := hT' ℓ hℓ hℓM hℓS'
    refine ⟨Subtype.ext ?_, Subtype.ext ?_⟩
    · rw [IntermediateField.coe_mul, hΛ'val, hψLval, hψLval]
