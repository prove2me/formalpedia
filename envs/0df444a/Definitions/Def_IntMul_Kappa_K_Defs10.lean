section
-- Source module: Solutions.KILList
/-!
# KIL list layer: block transposes and their `pull` denotations

Arrays on `[P, q, M, B]` are described by a record function `r p y m : List ℤ` (each of length
`B`).  `inp r P q M` lists the records in the order `(p, y, m)`, `outF r P q M` in the order
`(p, m, y)`.  Moving the field `q` behind the field `M` maps `inp` to `outF` (and back).
-/

namespace NLogN.KIL

open AModel

/-- One block in input order `(y, m)`. -/
def blkIn (r : ℕ → ℕ → ℕ → List ℤ) (q M p : ℕ) : List ℤ :=
  (List.range q).flatMap fun y => (List.range M).flatMap fun m => r p y m

/-- One block in output order `(m, y)`. -/
def blkOut (r : ℕ → ℕ → ℕ → List ℤ) (q M p : ℕ) : List ℤ :=
  (List.range M).flatMap fun m => (List.range q).flatMap fun y => r p y m

def inp (r : ℕ → ℕ → ℕ → List ℤ) (P q M : ℕ) : List ℤ := (List.range P).flatMap (blkIn r q M)

def outF (r : ℕ → ℕ → ℕ → List ℤ) (P q M : ℕ) : List ℤ := (List.range P).flatMap (blkOut r q M)

/-- Records of an array stored on `[P, q, M, B]`. -/
def recOf (xs : List ℤ) (q M B p y m : ℕ) : List ℤ :=
  (List.range B).map fun b => xs.getD (((p * q + y) * M + m) * B + b) 0

/-- Records of an array stored on `[P, M, q, B]`. -/
def recOf' (xs : List ℤ) (q M B p y m : ℕ) : List ℤ :=
  (List.range B).map fun b => xs.getD (((p * M + m) * q + y) * B + b) 0

/-- Exchange of the address digits `1` and `2`. -/
def gS (a : List ℕ) : List ℕ := [a.getD 0 0, a.getD 2 0, a.getD 1 0, a.getD 3 0]

