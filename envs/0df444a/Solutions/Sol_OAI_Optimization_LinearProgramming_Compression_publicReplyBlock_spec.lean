theorem sizePublicWords_spec (m : Memory ℚ) (q : ℚ) (k : ℕ) {P : ℚ → Prop}
    (safe : m.AllData P) (hk : m.index 0 = k) (inrange : q.num.natAbs < 2^k ∧ q.den < 2^k)
