-- Source module: Solutions.R6MTab
/-!
# Round-six machine: the top level and merged tables

* **`kappa_of_big6`**: the frozen `KFM.kappa_of_big` with the round-six final reduction
  `kappaBound_of_machine6`: a merged table with the FM multiplier at `pM` and a large-`n`
  procedure meeting `BigSpec` with cost `Tb` inside `C₀ (V · Ncost6 · (log lg n + 1)^A + n)` gives
  `KappaBound κ` for every `κ < P.gap`.
* **`mExt4`**: four interface tables `kTableP tab ext_i` and the machine's own procedures merged
  into one `kTableP tab (mExt4 …)` (the frozen `KFM.mExt` with one more slot and `kTable → kTableP
  tab`); **`mTab4_g1 … mTab4_g4`**, **`mTab4_own`** are the hypotheses of `IRuns.relabel`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IL

noncomputable section

/-! ## The top level -/

/-! ## Merging four interface tables -/

section Merge

variable {E₁ E₂ E₃ E₄ E₀ : ℕ}

/-- The merged extension list `[ext₁, ext₂, ext₃, ext₄, own]`. -/
def mExt4 (ext₁ : Fin E₁ → IStmt HS (7 + E₁)) (ext₂ : Fin E₂ → IStmt HS (7 + E₂))
    (ext₃ : Fin E₃ → IStmt HS (7 + E₃)) (ext₄ : Fin E₄ → IStmt HS (7 + E₄))
    (own : Fin E₀ → IStmt HS (7 + (E₁ + E₂ + E₃ + E₄ + E₀))) :
    Fin (E₁ + E₂ + E₃ + E₄ + E₀) → IStmt HS (7 + (E₁ + E₂ + E₃ + E₄ + E₀)) := fun k =>
  if h1 : k.val < E₁ then (ext₁ ⟨k.val, h1⟩).ren id (gI E₁ _ 0 (by omega))
  else if h2 : k.val < E₁ + E₂ then (ext₂ ⟨k.val - E₁, by omega⟩).ren id (gI E₂ _ E₁ (by omega))
  else if h3 : k.val < E₁ + E₂ + E₃ then
    (ext₃ ⟨k.val - (E₁ + E₂), by omega⟩).ren id (gI E₃ _ (E₁ + E₂) (by omega))
  else if h4 : k.val < E₁ + E₂ + E₃ + E₄ then
    (ext₄ ⟨k.val - (E₁ + E₂ + E₃), by omega⟩).ren id (gI E₄ _ (E₁ + E₂ + E₃) (by omega))
  else own ⟨k.val - (E₁ + E₂ + E₃ + E₄), by omega⟩

variable (tab : Fin 1 → IStmt HS 1) (ext₁ : Fin E₁ → IStmt HS (7 + E₁))
  (ext₂ : Fin E₂ → IStmt HS (7 + E₂)) (ext₃ : Fin E₃ → IStmt HS (7 + E₃))
  (ext₄ : Fin E₄ → IStmt HS (7 + E₄)) (own : Fin E₀ → IStmt HS (7 + (E₁ + E₂ + E₃ + E₄ + E₀)))

/-- The merged table. -/
abbrev mTab4 : Fin (7 + (E₁ + E₂ + E₃ + E₄ + E₀)) → IStmt HS (7 + (E₁ + E₂ + E₃ + E₄ + E₀)) :=
  kTableP tab (mExt4 ext₁ ext₂ ext₃ ext₄ own)

/-- The index maps of the four interface tables. -/
def g4₁ (E₁ E₂ E₃ E₄ E₀ : ℕ) : Fin (7 + E₁) → Fin (7 + (E₁ + E₂ + E₃ + E₄ + E₀)) :=
  gI E₁ _ 0 (by omega)

/-- Index of the machine's own procedure `k`. -/
def gO4 (E₁ E₂ E₃ E₄ E₀ : ℕ) (k : Fin E₀) : Fin (7 + (E₁ + E₂ + E₃ + E₄ + E₀)) :=
  ⟨E₁ + E₂ + E₃ + E₄ + k.val + 7, by omega⟩

end Merge

end

end IntMul.Kappa.R6

