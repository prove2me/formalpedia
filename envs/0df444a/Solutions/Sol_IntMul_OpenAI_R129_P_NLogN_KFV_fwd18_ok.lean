theorem clrT_fsp (s : IState HS) (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) {U : ℕ}
    (hA : g NLogN.KFV.gA = []) {LM : List Item} (hM : (NLogN.KIL.encK s (colSt g T 0)).G tbM = .int (T.length : ℤ) :: LM)
    (hT : ∀ t ∈ T, t.1 ≤ U ∧ t.2.1 ≤ U ∧ t.2.2 ≤ U) (hmU : T.length ≤ U) :
    FSp clrT (NLogN.KIL.encK s (colSt g T 0)) (NLogN.KIL.encK s g)
      (cLp T.length (6 * zsz (U : ℤ) + 6) (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have z : ∀ x : ℕ, x ≤ U → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zB (by simpa using hx)
  have L0 := FSp.repReg (C := NLogN.KFV.gA) (r := tbM) (b := clrB) (s := s) (F := colSt g T) (N := T.length)
    (c := 6 * B + 6) (Bb := B) (by decide) (by decide)
    (fun k => by simp +decide [colSt, Function.update_apply, hA]) (by decide) hM (z _ hmU) ?_
  · refine L0.congr ?_
    congr 1; funext x
    simp only [colSt, Function.update_apply]
    split_ifs <;> subst_vars <;> simp
  intro k hk
  have hk' : k < (T.map fun t => (t.1 : ℤ)).length := by simpa using hk
  have ht := hT _ (List.getElem_mem (show k < T.length from hk))
  set g0 := Function.update (colSt g T k) NLogN.KFV.gA [(T.length : ℤ) - k]
  have hC : g0 tbC = (T[k].1 : ℤ) :: ((T.map fun t => (t.1 : ℤ)).drop (k + 1) ++ g tbC) := by
    simp +decide [g0, colSt, Function.update_apply, List.drop_eq_getElem_cons hk']
  have S1 := Sp.pop s g0 (i := tbC) (B := B) (by decide) hC (z _ ht.1)
  set g1 := Function.update g0 tbC ((T.map fun t => (t.1 : ℤ)).drop (k + 1) ++ g tbC)
  have hK : g1 tbK = (T[k].2.1 : ℤ) :: ((T.map fun t => (t.2.1 : ℤ)).drop (k + 1) ++ g tbK) := by
    simp +decide [g1, g0, colSt, Function.update_apply,
      List.drop_eq_getElem_cons (show k < (T.map fun t => (t.2.1 : ℤ)).length by simpa using hk)]
  have S2 := Sp.pop s g1 (i := tbK) (B := B) (by decide) hK (z _ ht.2.1)
  set g2 := Function.update g1 tbK ((T.map fun t => (t.2.1 : ℤ)).drop (k + 1) ++ g tbK)
  have hL : g2 tbL = (T[k].2.2 : ℤ) :: ((T.map fun t => (t.2.2 : ℤ)).drop (k + 1) ++ g tbL) := by
    simp +decide [g2, g1, g0, colSt, Function.update_apply,
      List.drop_eq_getElem_cons (show k < (T.map fun t => (t.2.2 : ℤ)).length by simpa using hk)]
  have S3 := Sp.pop s g2 (i := tbL) (B := B) (by decide) hL (z _ ht.2.2)
  refine (FSp.of_norep rfl (S1.seq (S2.seq S3))).congr ?_ |>.mono (by omega)
  congr 1; funext x
  simp only [g2, g1, g0, colSt, Function.update_apply]
  split_ifs <;> subst_vars <;> simp_all +decide

