  · intro z
    have hnum : ((z.num : ℚ)).den.Coprime p := by simp
    have hden : ((z.den : ℚ)).den.Coprime p := by simp
    have hden0 : (⟨(z.den : ℚ), hden⟩ : baseRing p) ∈ nonZeroDivisors (baseRing p) := by
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h
