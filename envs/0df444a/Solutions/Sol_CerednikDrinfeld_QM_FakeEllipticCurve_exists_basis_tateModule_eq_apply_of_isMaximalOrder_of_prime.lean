    hB Λ hΛ E Ω ℓ hℓK

  haveI : Module.Finite ℤ ↥Λ := Module.Finite.iff_fg.mpr hΛ.isOrder.fg
  haveI : Module.Free ℤ ↥Λ := Module.free_of_finite_type_torsion_free'
  let bΛ := Module.Free.chooseBasis ℤ ↥Λ

  let w : Module.Free.ChooseBasisIndex ℤ ↥Λ → TateModule ℓ (E.L.AlgPoints E.comm Ω) := fun j => ρ (bΛ j) x
