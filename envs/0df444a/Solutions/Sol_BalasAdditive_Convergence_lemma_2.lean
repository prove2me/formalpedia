import Definitions.Def_BalasAdditive_Convergence_Algorithm

set_option autoImplicit false

namespace BalasAdditive.Convergence.Lemma2Counterexample

open BalasAdditive.Convergence
open Classical

private def j0 : Fin 2 := ⟨0, by decide⟩
private def j1 : Fin 2 := ⟨1, by decide⟩
private def i0 : Fin 1 := ⟨0, by decide⟩

private theorem j0_ne_j1 : j0 ≠ j1 := by decide

private theorem univ_fin2 : (Finset.univ : Finset (Fin 2)) = {j0, j1} := by
  ext ⟨val, hval⟩
  simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
  have h01 : val = 0 ∨ val = 1 := by omega
  rcases h01 with rfl | rfl <;> simp [j0, j1]

/-- Minimal 2-variable, 1-constraint zero-one program witnessing the failure of `lemma_2`
when `τ` is generated by a downward branching step (`Step.three_b`) prior to any feasible
solution lowering the ceiling from `⊤`. -/
private def cexP : Problem 2 1 where
  lp :=
    { A := fun _ _ => (-2 : ℝ)
      b := fun _ => (-3 : ℝ)
      c := fun _ => (0 : ℝ) }
  hc := fun _ => le_rfl

private theorem cexP_A (i : Fin 1) (j : Fin 2) : cexP.lp.A i j = -2 := rfl

private theorem min_neg_two : min (-2 : ℝ) 0 = -2 :=
  min_eq_left (by linarith)

private theorem slack_empty (i : Fin 1) : cexP.lp.slack ∅ i = -3 := by
  simp [BinaryLP.slack, cexP]

private theorem slack_j0 (i : Fin 1) : cexP.lp.slack {j0} i = -1 := by
  simp [BinaryLP.slack, cexP]
  linarith

private theorem slack_univ (i : Fin 1) : cexP.lp.slack Finset.univ i = 1 := by
  rw [univ_fin2]
  simp [BinaryLP.slack, cexP, Finset.sum_pair j0_ne_j1]
  linarith

private theorem not_feasible_empty : ¬ cexP.lp.Feasible ∅ := by
  intro hf
  have h := hf i0
  rw [slack_empty] at h
  linarith

private theorem not_feasible_j0 : ¬ cexP.lp.Feasible {j0} := by
  intro hf
  have h := hf i0
  rw [slack_j0] at h
  linarith

private theorem feasible_univ : cexP.lp.Feasible Finset.univ := by
  intro i
  rw [slack_univ]
  linarith

private theorem chosen_of_mem (J X : Finset (Fin 2)) {j : Fin 2} (hj : j ∈ X) :
    Chosen cexP J X j := by
  refine ⟨hj, ?_, ?_⟩
  · intro q _
    simp [choiceValue, cexP]
  · intro q _ _
    simp [cexP]

private theorem init_N0 : (init cexP).N 0 = Finset.univ := by
  have hceil : ceilingFrom cexP ([].map Record.J ++ [∅]) = ⊤ := by
    simp [ceilingFrom, not_feasible_empty]
  change newN cexP [] [] ∅ = Finset.univ
  ext j
  simp only [newN, Finset.mem_filter, Finset.mem_univ, true_and, iff_true]
  refine ⟨by simp [inheritedC], ?_, ?_⟩
  · rw [hceil, top_le_iff]
    exact WithTop.coe_ne_top
  · intro hall
    have hA := hall i0 (by rw [slack_empty]; linarith)
    rw [cexP_A] at hA
    linarith

private noncomputable def σ₁ : State 2 :=
  appendSolution cexP (init cexP) 0 {j0} {j0}

private theorem step_init_σ₁ : Step cexP (init cexP) σ₁ := by
  have hlat : (init cexP).latest = ∅ := by simp [State.latest, State.J, init]
  have hlen : (init cexP).history.length - 1 = 0 := by simp [init]
  have hN0_ne : ((init cexP).N ((init cexP).history.length - 1)).Nonempty := by
    rw [hlen, init_N0]
    exact ⟨j0, Finset.mem_univ j0⟩
  have hstrict : relationsStrict cexP (init cexP).latest
      ((init cexP).N ((init cexP).history.length - 1)) := by
    rw [hlat, hlen, init_N0]
    intro i _
    rw [slack_empty, negativeSum, univ_fin2, Finset.sum_pair j0_ne_j1, cexP_A, cexP_A, min_neg_two]
    linarith
  have hchoice : Chosen cexP (init cexP).latest
      ((init cexP).N ((init cexP).history.length - 1)) j0 := by
    apply chosen_of_mem
    rw [hlen, init_N0]
    exact Finset.mem_univ j0
  simpa [σ₁, hlen] using
    Step.three_b (init cexP) j0 rfl (hlat ▸ not_feasible_empty) hN0_ne hstrict hchoice

private theorem reachable_σ₁ : Reachable cexP σ₁ :=
  Relation.ReflTransGen.single step_init_σ₁

private theorem σ₁_len : σ₁.history.length = 2 := by
  simp [σ₁, appendSolution, init]

private theorem σ₁_J0 : σ₁.J 0 = ∅ := by
  simp [σ₁, appendSolution, init, State.J]

private theorem σ₁_J1 : σ₁.J 1 = {j0} := by
  simp [σ₁, appendSolution, init, State.J]

private theorem σ₁_latest : σ₁.latest = {j0} := by
  simp [State.latest, σ₁_len, σ₁_J1]

private theorem σ₁_snapshotC0 : σ₁.snapshotC 0 = {j0} := by
  simp [σ₁, appendSolution, init, cancelAt, State.snapshotC]

private theorem ceiling_σ₁ : ceiling cexP σ₁ = ⊤ := by
  have hmap : σ₁.history.map Record.J = [∅, {j0}] := by
    simp [σ₁, appendSolution, init, State.J]
  rw [ceiling, hmap]
  simp [ceilingFrom, not_feasible_empty, not_feasible_j0]

private theorem σ₁_N1 : σ₁.N 1 = {j1} := by
  have hJ_union : (init cexP).J 0 ∪ {j0} = {j0} := by simp [init, State.J]
  have hN1_def : σ₁.N 1 = newN cexP (init cexP).history
      (cancelAt (init cexP).cancelled 0 {j0}) {j0} := by
    have h1 : σ₁.N 1 = newN cexP (init cexP).history
        (cancelAt (init cexP).cancelled 0 {j0}) ((init cexP).J 0 ∪ {j0}) := by
      simp [σ₁, appendSolution, init, State.N]
    rw [h1, hJ_union]
  have hss : (∅ : Finset (Fin 2)) ⊂ {j0} :=
    Finset.Nonempty.empty_ssubset (Finset.singleton_nonempty j0)
  have hinh : inheritedC (init cexP).history
      (cancelAt (init cexP).cancelled 0 {j0}) {j0} = {j0} := by
    unfold inheritedC
    have hlen1 : (init cexP).history.length = 1 := rfl
    rw [hlen1, Finset.range_one, Finset.singleton_biUnion]
    have hJ0_eq : (((init cexP).history[0]?).map Record.J).getD ∅ = ∅ := rfl
    have hcs0_eq : ((cancelAt (init cexP).cancelled 0 {j0})[0]?).getD ∅ = {j0} := rfl
    rw [hJ0_eq, if_pos hss, hcs0_eq]
  have hceil : ceilingFrom cexP ((init cexP).history.map Record.J ++ [{j0}]) = ⊤ := by
    have hlist : (init cexP).history.map Record.J ++ [{j0}] = [∅, {j0}] := by
      simp [init]
    rw [hlist]
    simp [ceilingFrom, not_feasible_empty, not_feasible_j0]
  rw [hN1_def]
  ext j
  simp only [newN, Finset.mem_filter, Finset.mem_univ, true_and]
  rw [hinh, hceil]
  have hj_cases : j = j0 ∨ j = j1 := by
    have h := Finset.mem_univ j
    rwa [univ_fin2, Finset.mem_insert, Finset.mem_singleton] at h
  rcases hj_cases with rfl | rfl
  · simp [j0_ne_j1]
  · simp only [Finset.mem_singleton, j0_ne_j1.symm, not_false_eq_true, true_and, iff_true]
    refine ⟨?_, ?_⟩
    · rw [top_le_iff]
      exact WithTop.coe_ne_top
    · intro hall
      have hA := hall i0 (by rw [slack_j0]; linarith)
      rw [cexP_A] at hA
      linarith

private noncomputable def τ₁ : State 2 :=
  appendSolution cexP σ₁ 1 {j1} {j1}

private theorem step_σ₁_τ₁ : Step cexP σ₁ τ₁ := by
  have hlen : σ₁.history.length - 1 = 1 := by rw [σ₁_len]
  have hN1_ne : (σ₁.N (σ₁.history.length - 1)).Nonempty := by
    rw [hlen, σ₁_N1]
    exact Finset.singleton_nonempty j1
  have hstrict : relationsStrict cexP σ₁.latest (σ₁.N (σ₁.history.length - 1)) := by
    rw [σ₁_latest, hlen, σ₁_N1]
    intro i _
    rw [slack_j0, negativeSum, Finset.sum_singleton, cexP_A, min_neg_two]
    linarith
  have hchoice : Chosen cexP σ₁.latest (σ₁.N (σ₁.history.length - 1)) j1 := by
    apply chosen_of_mem
    rw [hlen, σ₁_N1]
    exact Finset.mem_singleton_self j1
  simpa [τ₁, hlen] using
    Step.three_b σ₁ j1 rfl (σ₁_latest ▸ not_feasible_j0) hN1_ne hstrict hchoice

private theorem τ₁_len : τ₁.history.length = σ₁.history.length + 1 := by
  simp [τ₁, appendSolution]

private theorem τ₁_currentC1 : τ₁.currentC 1 = {j1} := by
  simp [τ₁, σ₁, appendSolution, init, cancelAt, State.currentC]

end BalasAdditive.Convergence.Lemma2Counterexample

open BalasAdditive.Convergence
open BalasAdditive.Convergence.Lemma2Counterexample

set_option linter.unusedVariables false in
theorem solution : ¬ (∀ {n m : ℕ} (P : Problem n m) (σ τ : State n)
    (hr : Reachable P σ)
    (hτ : τ = σ ∨ (Step P σ τ ∧ τ.history.length = σ.history.length + 1)) (k : ℕ)
    (hk : k < σ.history.length - 1)
    (hancestor : σ.J k ⊂ σ.latest)
    (hcancel : ∀ p, k < p → p ≤ σ.history.length - 1 → σ.N p = τ.currentC p)
    (J : Finset (Fin n)) (hfeas : P.lp.Feasible J)
    (hstrict : σ.J k ⊂ J)
    (hcost : (↑(P.lp.cost J) : WithTop ℝ) < ceiling P σ),
    Disjoint (J \ σ.J k) (σ.snapshotC k)) := by
  intro hlem2
  have hk : 0 < σ₁.history.length - 1 := by rw [σ₁_len]; decide
  have hanc : σ₁.J 0 ⊂ σ₁.latest := by
    rw [σ₁_J0, σ₁_latest]
    exact Finset.Nonempty.empty_ssubset (Finset.singleton_nonempty j0)
  have hcancel : ∀ p, 0 < p → p ≤ σ₁.history.length - 1 → σ₁.N p = τ₁.currentC p := by
    intro p hp0 hple
    rw [σ₁_len] at hple
    have hp1 : p = 1 := by omega
    subst hp1
    rw [σ₁_N1, τ₁_currentC1]
  have hstrict : σ₁.J 0 ⊂ (Finset.univ : Finset (Fin 2)) := by
    rw [σ₁_J0]
    exact Finset.Nonempty.empty_ssubset ⟨j0, Finset.mem_univ j0⟩
  have hcost : (↑(cexP.lp.cost Finset.univ) : WithTop ℝ) < ceiling cexP σ₁ := by
    rw [ceiling_σ₁]
    exact WithTop.coe_lt_top _
  have hdisj := hlem2 cexP σ₁ τ₁ reachable_σ₁ (Or.inr ⟨step_σ₁_τ₁, τ₁_len⟩) 0 hk hanc hcancel
    Finset.univ feasible_univ hstrict hcost
  rw [σ₁_J0, σ₁_snapshotC0] at hdisj
  have hj0_left : j0 ∈ (Finset.univ : Finset (Fin 2)) \ ∅ := by simp
  have hj0_right : j0 ∈ ({j0} : Finset (Fin 2)) := Finset.mem_singleton_self j0
  exact Finset.disjoint_left.mp hdisj hj0_left hj0_right
