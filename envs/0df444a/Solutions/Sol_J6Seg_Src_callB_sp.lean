    Int.toNat_natCast, e10]
  split_ifs <;> simp_all [expPos]

set_option maxHeartbeats 2000000 in
theorem expPosP_ok (n k j σ : ℕ) (s : IState HS) (L16 L17 L18 L27 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) (h27 : s.G 27 = .int σ :: L27) : expPosP.ok s := by
  have e10 : ((n : ℤ) + n + 10).toNat = 2 * n + 10 := by omega
  simp (config := {decide := true}) only [expPosP, seqL, run_seq, RS.ok]
  rw [piP_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)]
  rw [log2P_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)]
  rw [expNegFixP_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, h16])
    (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)
    (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])]
  simp (config := {decide := true}) [RS.run_push_G, RS.run_pop_G, IState.upd_G, Ex.eval,
    IState.top, IState.IsInt, h16, h17, h18, h27, Ex.ok, Ex.Clean, Ex.regs, zX_all, m10E, xPosE]
  repeat' (first
    | apply piP_ok'
    | apply log2P_ok'
    | apply expNegFixP_ok'
    | apply Ex.ediv_ok
    | apply Ex.max0_ok
    | apply And.intro)
