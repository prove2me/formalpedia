  have h2 : NLogN.IRuns I iprog (.seq (.op (.const NLogN.T4 (-(NLogN.fmThr : ℤ)))) (.op (.add NLogN.T4 NLogN.ZZ NLogN.ZZ)))
      (s.upd NLogN.ZZ (.int (NLogN.zsz (N : ℤ)) :: s.G NLogN.ZZ)) (s.upd NLogN.ZZ (.int (-(NLogN.fmThr : ℤ) + NLogN.fmL N) :: s.G NLogN.ZZ))
      (1000 * (NLogN.fmL N + 15)) := by
