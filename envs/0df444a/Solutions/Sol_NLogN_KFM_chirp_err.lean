open NLogN
open NLogN.KFM
open Complex
variable {ι : Type*} [Fintype ι]
theorem solution (p : ℕ) {MC MCt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} (hMC : NLogN.KFM.BilC MC) (Ec : ℝ)
    (hMCt : ∀ f g, NLogN.KFM.Grid p f → NLogN.KFM.Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 7 / 10 →
      ‖MCt f g - MC f g‖ ≤ Ec * NLogN.KFM.hp p ∧ ‖MCt f g‖ ≤ 1)
    {a at' b bt : ι → ℂ} (ha : NLogN.KFM.Phases p a at') (hb' : NLogN.KFM.Phases p b bt) (hbg : NLogN.KFM.Grid p bt)
    {x : ι → ℂ} (hx : ‖x‖ ≤ 6 / 10) :
    ‖NLogN.KFM.chirpT p MCt bt at' x - a * MC b (a * x)‖ ≤ (Ec + 10) * NLogN.KFM.hp p ∧
      ‖NLogN.KFM.chirpT p MCt bt at' x‖ ≤ 1 := by
  have h0 := NLogN.KFM.hp_pos p
  have na : ‖a‖ ≤ 1 := NLogN.KFM.pi_le zero_le_one ha.e
  have nbt : ‖bt‖ ≤ 1 := NLogN.KFM.pi_le zero_le_one hb'.t1
  have ndb : ‖bt - b‖ ≤ 2 * NLogN.KFM.hp p := NLogN.KFM.pi_le (by positivity) hb'.t
  obtain ⟨e0, n0⟩ := NLogN.KFM.phase_err p a at' x ha.e ha.t ha.t1 (hx.trans (by norm_num))
  set x0 := NLogN.KFM.QA p (at' * x)
  obtain ⟨hc, hc1⟩ := hMCt bt x0 hbg (NLogN.KFM.QA_grid _ _) nbt (n0.trans (hx.trans (by norm_num)))
  set y0 := MCt bt x0
  obtain ⟨e1, n1⟩ := NLogN.KFM.phase_err p a at' y0 ha.e ha.t ha.t1 hc1
  refine ⟨?_, n1.trans hc1⟩
  have hb := NLogN.KFM.bil_err hMC b bt (a * x) x0
  have nb : ‖b‖ ≤ 1 := NLogN.KFM.pi_le zero_le_one hb'.e
  have e2 : NLogN.KFM.chirpT p MCt bt at' x - a * MC b (a * x) =
      (NLogN.KFM.QA p (at' * y0) - a * y0) + a * (y0 - MC bt x0) + a * (MC bt x0 - MC b (a * x)) := by
    simp only [NLogN.KFM.chirpT]; ring
  rw [e2]
  have nax : ‖a * x‖ ≤ 1 := (NLogN.KFM.norm_mul_le' _ _).trans (by nlinarith [norm_nonneg a, norm_nonneg x])
  have t2 : ‖a * (y0 - MC bt x0)‖ ≤ Ec * NLogN.KFM.hp p :=
    (NLogN.KFM.norm_mul_le' _ _).trans (by nlinarith [norm_nonneg (y0 - MC bt x0), norm_nonneg a])
  have t3 : ‖a * (MC bt x0 - MC b (a * x))‖ ≤ 6 * NLogN.KFM.hp p := by
    refine (NLogN.KFM.norm_mul_le' _ _).trans ?_
    have : ‖MC bt x0 - MC b (a * x)‖ ≤ 6 * NLogN.KFM.hp p := by
      refine hb.trans ?_
      have nx0 : ‖x0‖ ≤ 1 := n0.trans (hx.trans (by norm_num))
      nlinarith [norm_nonneg (bt - b), norm_nonneg (x0 - a * x), norm_nonneg x0, norm_nonneg b]
    nlinarith [norm_nonneg (MC bt x0 - MC b (a * x)), norm_nonneg a]
  calc _ ≤ ‖NLogN.KFM.QA p (at' * y0) - a * y0‖ + ‖a * (y0 - MC bt x0)‖ +
        ‖a * (MC bt x0 - MC b (a * x))‖ := norm_add₃_le
    _ ≤ 4 * NLogN.KFM.hp p + Ec * NLogN.KFM.hp p + 6 * NLogN.KFM.hp p := add_le_add (add_le_add e1 t2) t3
    _ = (Ec + 10) * NLogN.KFM.hp p := by ring
end
