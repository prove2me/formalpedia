theorem solution (U : TypeDensity.SurfaceUniverse) (i : U.ι) (hnt : (U.M i).s.terminal = false)
    (hIH : ∀ i' : U.ι, (U.M i').s.rank < (U.M i).s.rank → U.LawStatement i') (σ : TypeDensity.FactorType) :
    (U.M i).μ (U.exitEvent σ 0 i) = TypeDensity.densityValue (TypeDensity.lawCoeff (TypeDensity.exitLaw (U.M i).s) σ) (U.M i).q *
        (U.M i).μ (U.M i).stateSet ∧
    0 ≤ (TypeDensity.lawCoeff (TypeDensity.exitLaw (U.M i).s) σ).eval ((U.M i).q : ℚ) ∧
      MeasurableSet (U.exitEvent σ 0 i) := by
  classical
  obtain ⟨hq, -, -, -, -⟩ := TypeDensity.universe_basic_facts U i
  have hmeas : MeasurableSet (U.exitEvent σ 0 i) :=
    ((TypeDensity.recursion_events_measurable U i hnt hIH) i rfl 0 σ).2.1
  set M := U.M i with hM
  set s := M.s with hs
  set qq : ℚ := (M.q : ℚ) with hqq
  -- the per-cell rational weight
  let F : M.cellIndex → ℚ := fun c =>
    (TypeDensity.divisorProbability s (M.cellDegree c)).eval qq *
      (TypeDensity.lawCoeff (TypeDensity.lawProd ((M.childList c).map fun z => TypeDensity.lawDescend z.1 (TypeDensity.stateLaw z.2))) σ).eval qq
  have hFnn : ∀ c : U.exitCells i, 0 ≤ F c.1 := by
    intro c
    exact mul_nonneg ((TypeDensity.divisor_probability_pos M.q hq s _ 2 le_rfl).1.le)
      (TypeDensity.exit_cell_coeff_nonneg U i hIH c σ)
  have hbox_sub : ∀ c σ', U.typeBox i c σ' ⊆ M.cell c := by
    intro c σ' x hx
    simp only [TypeDensity.SurfaceUniverse.typeBox, Set.mem_iUnion] at hx
    obtain ⟨τ, _, hx⟩ := hx
    exact hx.1
  have hbox_eq : ∀ c : U.exitCells i, U.typeBox i c.1 σ = U.exitEvent σ 0 i ∩ M.cell c.1 := by
    intro c
    ext x
    constructor
    · intro hx
      exact ⟨Set.mem_iUnion.2 ⟨c, hx⟩, hbox_sub _ _ hx⟩
    · rintro ⟨hE, hc⟩
      obtain ⟨c', hx'⟩ := Set.mem_iUnion.1 hE
      by_cases h : c'.1 = c.1
      · rw [← h]; exact hx'
      · exact absurd (U.cells_disjoint i hnt h) (Set.not_disjoint_iff.2 ⟨x, hbox_sub _ _ hx', hc⟩)
  let : ∀ P, Fintype (TypeDensity.patternDivisors (IsLocalRing.ResidueField M.R) s P) :=
    fun P => @Fintype.ofFinite _ (U.divisors_finite i P)
  let : Fintype (U.exitCells i) := by unfold TypeDensity.SurfaceUniverse.exitCells; infer_instance
  have hsum : (M.μ (U.exitEvent σ 0 i)) = ∑ c : U.exitCells i, ENNReal.ofReal ((F c.1 : ℚ) : ℝ) *
      M.μ M.stateSet := by
    rw [show U.exitEvent σ 0 i = ⋃ c : U.exitCells i, U.typeBox i c.1 σ from rfl]
    rw [MeasureTheory.measure_iUnion, tsum_fintype]
    · exact Finset.sum_congr rfl fun c _ => TypeDensity.exit_cell_type_mass U i hnt hIH c σ
    · intro c c' hcc'
      have hne : c.1 ≠ c'.1 := fun h => hcc' (Subtype.ext h)
      exact (U.cells_disjoint i hnt hne).mono (hbox_sub _ _) (hbox_sub _ _)
    · intro c
      rw [hbox_eq c]
      exact hmeas.inter (U.cell_measurable i hnt c.1)
  have hrat : ∑ c : U.exitCells i, F c.1 = (TypeDensity.lawCoeff (TypeDensity.exitLaw s) σ).eval qq :=
    TypeDensity.exit_cell_weight_sum U i hnt σ
  refine ⟨?_, ?_, hmeas⟩
  · rw [hsum, ← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg
      (fun c _ => by exact_mod_cast hFnn c)]
    change _ = ENNReal.ofReal (((TypeDensity.lawCoeff (TypeDensity.exitLaw s) σ).eval qq : ℚ) : ℝ) * _
    rw [← hrat]
    push_cast
    rfl
  · rw [← hrat]
    exact Finset.sum_nonneg fun c _ => hFnn c
