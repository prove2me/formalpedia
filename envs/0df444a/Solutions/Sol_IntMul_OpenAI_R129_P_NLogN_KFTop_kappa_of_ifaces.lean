  have h2 := (src_facts hn j hj).2.2.1
  have hc := (src_facts hn j hj).2.2.2.2
  refine ⟨by omega, ?_, (mu_spec (prodN n j) (srcN n j) (by omega) hc).1⟩
  set i : Fin (D + 1) := ⟨j, by omega⟩
