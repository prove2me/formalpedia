-- title:
--   Measurability of marked integrals on past regions
-- statement:
--   The sigma algebra generated by counts on measurable subsets of the region is contained in the past filtration, so the proved measurable local mark integral is measurable in the past.
-- source:
--   Kyprianou (2006), Chapter 4, Exercise 4.5, adaptedness of physical cutoff processes.

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
import Theorems.Thm_Kyprianou_Ch02_prmMarkedIntegralMeasurableLocalEvalSigmaV1
open MeasureTheory ProbabilityTheory Set LevyStochCalc.Poisson
open scoped NNReal ENNReal
set_option autoImplicit false

namespace Kyprianou.Ch04
theorem pastMarkedIntegralMeasurableV1 {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (ν : Measure ℝ) [SigmaFinite ν] (F : Filtration NNReal (inferInstance : MeasurableSpace Ω))
    (N : PoissonRandomMeasure.{0,0,0} P ν)
    (T : NNReal) (D : Set (ℝ × ℝ)) (hD : MeasurableSet D)
    (hPast : ∀ C : Set (ℝ × ℝ), C ⊆ D → MeasurableSet C →
      Measurable[F T] (fun ω => N.N ω C)) :
    Measurable[F T] (fun ω => ∫ z in D, z.2 ∂(N.N ω)) := by
  sorry
end Kyprianou.Ch04
