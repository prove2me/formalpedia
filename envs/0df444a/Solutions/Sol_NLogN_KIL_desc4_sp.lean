  have h : 0 < W ^ K := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
  exact Nat.mul_div_le _ _

end NLogN.KIL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12
theorem solution (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) {M B : ℕ} (hM : NLogN.zsz (M : ℤ) ≤ B)
    {W K R : ℕ} (hW : 1 ≤ W) (v : Fin NLogN.HS → ℕ) (hv : ∀ i ∈ NLogN.KIL.regD, v i ≤ M)
    (vK : v NLogN.KIL.aK = K) (vR : v NLogN.KIL.aQR = R) (hF23 : F 23 = []) (hWK : W ^ K ≤ R) (hRM : 2 * R ≤ M)
    (hWM : W ≤ M) :
    ∃ v', (∀ i, i ∉ [NLogN.KIL.aWK, NLogN.KIL.aRp] → v' i = v i) ∧ v' NLogN.KIL.aWK = W ^ K ∧ v' NLogN.KIL.aRp = AModelL12.padRows W K R ∧
      NLogN.KIL.Sp (NLogN.KIL.desc4 W) (NLogN.KIL.encK s (NLogN.KIL.regState F v NLogN.KIL.regD)) (NLogN.KIL.encK s (NLogN.KIL.regState F v' NLogN.KIL.regD))
        (100 * (K + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  have SA := NLogN.KIL.Sp.asgs s F NLogN.KIL.regD hM [(NLogN.KIL.aWK, .lit 1)] v
    ⟨by decide, by decide, hv _ (by decide), fun j hj => by simp [NLogN.KIL.NE.regs] at hj,
      by simp only [NLogN.KIL.NE.OK]; have : W ^ K ≥ 1 := Nat.one_le_pow _ _ hW; omega, trivial⟩
  set v1 := NLogN.KIL.evalA [(NLogN.KIL.aWK, .lit 1)] v with hv1
  have v1T : v1 NLogN.KIL.aWK = 1 := by simp [v1, NLogN.KIL.evalA, NLogN.KIL.NE.val]
  have v1K : v1 NLogN.KIL.aK = K := by simp +decide [v1, NLogN.KIL.evalA, vK, Function.update_apply]
  have v1R : v1 NLogN.KIL.aQR = R := by simp +decide [v1, NLogN.KIL.evalA, vR, Function.update_apply]
  have hWk : ∀ k ≤ K, W ^ k ≤ W ^ K := fun k hk => Nat.pow_le_pow_right hW hk
  have SB := NLogN.KIL.Sp.repA s F NLogN.KIL.regD hM (C := 23) (by decide) (by decide) hF23 (NLogN.KIL.mulL NLogN.KIL.aWK W)
    (by simp +decide [NLogN.KIL.mulL])
    (.reg NLogN.KIL.aK) trivial v1 (fun j hj => by
      simp [NLogN.KIL.NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by simp only [NLogN.KIL.NE.OK]; rw [v1K]; exact le_trans (by
        have := Nat.lt_pow_self (n := K) (show 1 < 2 by omega)
        have := Nat.pow_le_pow_left (show 2 ≤ 2 by omega) K
        exact (hv NLogN.KIL.aK (by decide)).trans' (by rw [vK])) le_rfl)
    (by
      intro k hk
      simp only [NLogN.KIL.NE.val, v1K] at hk
      rw [NLogN.KIL.iter_mulL, v1T]
      have hk2 : W ^ k * W ≤ W ^ K := by rw [← pow_succ]; exact hWk _ hk
      have hk3 : W ^ k ≤ W ^ K := hWk _ hk.le
      exact NLogN.KIL.okA_mulL (by decide) (by decide) hWM (by simp; omega) (by simp; omega))
  simp only [NLogN.KIL.NE.val, v1K] at SB
  rw [NLogN.KIL.iter_mulL, v1T, one_mul] at SB
  set v2 := Function.update v1 NLogN.KIL.aWK (W ^ K) with hv2
  have v2W : v2 NLogN.KIL.aWK = W ^ K := by simp [v2]
  have v2R : v2 NLogN.KIL.aQR = R := by simp +decide [v2, v1R, Function.update_apply]
  have hpos : 0 < W ^ K := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
  have hpr := NLogN.KIL.padRows_le W K R hW
  have SC := NLogN.KIL.Sp.asgs s F NLogN.KIL.regD hM [(NLogN.KIL.aRp, NLogN.KIL.rpE)] v2
    ⟨by decide, by decide, by
        simp +decide only [v2, v1, NLogN.KIL.evalA, Function.update_apply]; simp +decide; exact hv _ (by decide),
      fun j hj => by
        simp [NLogN.KIL.rpE, NLogN.KIL.NE.regs] at hj
        rcases hj with rfl | rfl | rfl <;> exact ⟨by decide, Or.inl (by decide)⟩,
      by
        simp only [NLogN.KIL.rpE, NLogN.KIL.NE.OK, NLogN.KIL.NE.val, v2W, v2R]
        refine ⟨by omega, ⟨⟨⟨by omega, by omega, by omega⟩, by omega, by omega⟩, by omega, hpos⟩, ?_⟩
        exact le_trans hpr (by omega),
      trivial⟩
  refine ⟨_, ?_, ?_, ?_, (SA.seq (SB.seq SC)).mono ?_⟩
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    simp [NLogN.KIL.evalA, Function.update_of_ne hi.1, Function.update_of_ne hi.2, v2, v1]
  · simp +decide [NLogN.KIL.evalA, Function.update_apply, v2W]
  · simp only [NLogN.KIL.evalA, Function.update_self, NLogN.KIL.rpE, NLogN.KIL.NE.val, v2W, v2R, AModelL12.padRows]
  · simp only [NLogN.KIL.szA, NLogN.KIL.mulL, NLogN.KIL.rpE, NLogN.KIL.NE.size, NLogN.KIL.NE.toEx, NLogN.Ex.size]
    have hB1 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    nlinarith
end
