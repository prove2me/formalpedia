theorem solution (O R : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R] (S : TypeDensity.SurfaceData O R)
    (e : (TypeDensity.BlowupChart R S.t S.x ⧸ TypeDensity.chartExceptional R S.t S.x) ≃+* Polynomial
      (IsLocalRing.ResidueField R)) (he : ∀ r : R,
      e (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (TypeDensity.chartBase R S.t S.x r)) =
      Polynomial.C (IsLocalRing.residue R r))
    (heZ : e (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (TypeDensity.chartSlope R S.t S.x)) = Polynomial.X)
    (φ : TypeDensity.AffineDirection (IsLocalRing.ResidueField R)) :
    (TypeDensity.directionPoint R S.t S.x e φ).IsMaximal ∧
    TypeDensity.chartBase R S.t S.x S.t ∈ TypeDensity.directionPoint R S.t S.x e φ ∧
    (TypeDensity.chartSlope R S.t S.x ∈ TypeDensity.directionPoint R S.t S.x e φ ↔ φ =
      TypeDensity.zeroAffine (IsLocalRing.ResidueField R)) ∧
    ((TypeDensity.directionPoint R S.t S.x e φ).map (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x))).map e =
    Ideal.span {φ.val} ∧ Module.length R (TypeDensity.BlowupChart R S.t S.x ⧸ TypeDensity.directionPoint R S.t S.x e φ) =
    (φ.val.natDegree : ℕ∞) ∧ Function.Injective (TypeDensity.directionPoint R S.t S.x e) := by
  set k := IsLocalRing.ResidueField R
  set A := TypeDensity.BlowupChart R S.t S.x
  set ψ : A →+* Polynomial k :=
    e.toRingHom.comp (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x))
  have hψ : Function.Surjective ψ :=
    e.surjective.comp Ideal.Quotient.mk_surjective
  have hP : ∀ φ' : TypeDensity.AffineDirection k,
      TypeDensity.directionPoint R S.t S.x e φ' = (Ideal.span {φ'.val}).comap ψ := fun _ ↦ rfl
  have hmap : ∀ φ' : TypeDensity.AffineDirection k,
      ((TypeDensity.directionPoint R S.t S.x e φ').map (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x))).map e
        = Ideal.span {φ'.val} := by
