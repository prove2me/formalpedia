  have hYR : (0 : ℝ) < Y := by exact_mod_cast hY0
  push_cast at h2'
  have hl := Real.log_le_log (by positivity) h2'
  rw [Real.log_mul (by positivity) (by positivity), Real.log_pow] at hl
  linarith

theorem sqrt_mono {t y : ℝ} (ht : 1 ≤ t) (hty : t ≤ y) : t - 2 * √t ≤ y - 2 * √y := by
