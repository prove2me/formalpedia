    ((O ⊗[ℤ_[p]] T) ⧸ (Ideal.span {(p : O) ^ k} • (⊤ : Submodule O (O ⊗[ℤ_[p]] T))))
      ≃ₗ[ℤ_[p]]
    ∀ _ : Module.Free.ChooseBasisIndex ℤ_[p] O, T ⧸ (((p : ℤ_[p]) ^ k) • ⊤ : Submodule ℤ_[p] T) :=
  letI := Classical.decEq (Module.Free.ChooseBasisIndex ℤ_[p] O)
