  ⟨le_max_left _ _,max_le zero_le_one (min_le_left _ _)⟩

theorem quickScore_clipped (x : ℚ) : quickScore (qclamp x)=qscore (qclamp x) := quickScore_eq (qclamp_domain x)
theorem quickJ_clipped (x : ℚ) : quickJ (qclamp x)=qprimitive (qclamp x) := quickJ_eq (qclamp_domain x)

