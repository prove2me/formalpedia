  have : A * D + 1 + 2 ≤ (A * D + 3) ^ 2 := by nlinarith
  calc (e.size + 1) * 2000 * (A * D + 1 + 2) ≤ (e.size + 1) * 2000 * (A * D + 3) ^ 2 :=
