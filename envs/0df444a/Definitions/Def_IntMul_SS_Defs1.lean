-- Source module: NLogNP.Add
/-!
# Binary words on stacks; addition

A word `A : List Bool` (least significant bit first) sits on a stack as `A.map codeBit`, so its
least significant bit is on top.  A word ends where the stack stops showing bits.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def bitOf : Option Sym → Option Bool
  | some 0 => some false
  | some 1 => some true
  | _ => none

@[simp] theorem bitOf_zero : bitOf (some 0) = some false := rfl
@[simp] theorem bitOf_one : bitOf (some 1) = some true := rfl

/-- Value of a little-endian word. -/
def wval : List Bool → ℕ
  | [] => 0
  | b :: l => b.toNat + 2 * wval l

section
variable {q a b d e : Fin S} (hqa : q ≠ a) (hqb : q ≠ b) (hqd : q ≠ d) (hqe : q ≠ e)
  (hab : a ≠ b) (had : a ≠ d) (hae : a ≠ e) (hbd : b ≠ d) (hbe : b ≠ e) (hde : d ≠ e)
  (ra rb Q : List Sym) (hra : bitOf ra.head? = none) (hrb : bitOf rb.head? = none)

end

end NLogN

end

section
-- Source module: NLogNP.Zip
/-!
# A generic two-input bit transducer with carry

`zip q a b d e keep f fin` runs least-significant-bit first over the words on top of `a` and `b`
(a missing bit reads as `0`), with a one-bit carry `c`.  At each position it pushes the output
bit of `f x y c` on `d` and continues with the new carry; the bits of `b` are copied onto `e`
when `keep`.  When both words are exhausted it pushes the symbols `fin c` on `d`.
Addition, subtraction, negation and copying are instances.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-- Output bits and final carry. -/
def zipL (f : Bool → Bool → Bool → Bool × Bool) : Bool → List Bool → List Bool → List Bool × Bool
  | c, [], [] => ([], c)
  | c, x :: A, [] => let r := zipL f (f x false c).2 A []; ((f x false c).1 :: r.1, r.2)
  | c, [], y :: B => let r := zipL f (f false y c).2 [] B; ((f false y c).1 :: r.1, r.2)
  | c, x :: A, y :: B => let r := zipL f (f x y c).2 A B; ((f x y c).1 :: r.1, r.2)

def zipδ (q a b d e : Fin S) (keep : Bool) (f : Bool → Bool → Bool → Bool × Bool)
    (fin : Bool → List Sym) : List (Option Sym) → List (Op S)
  | [some c, ta, tb] =>
    if bitOf ta = none ∧ bitOf tb = none then
      (fin (decide (c = 1))).map (Op.push d) ++ [.pop q, .push q hlt]
    else
      let x := (bitOf ta).getD false
      let y := (bitOf tb).getD false
      let r := f x y (decide (c = 1))
      (if (bitOf ta).isSome then [.pop a] else []) ++
        (if (bitOf tb).isSome then .pop b :: (if keep then [.push e (codeBit y)] else []) else [])
        ++ [.push d (codeBit r.1), .pop q, .push q (codeBit r.2)]
  | _ => [.pop q, .push q hlt]

def zip (q a b d e : Fin S) (keep : Bool) (f : Bool → Bool → Bool → Bool × Bool)
    (fin : Bool → List Sym) (c0 : Bool) : Stmt S P :=
  machine q [a, b] (codeBit c0) (zipδ q a b d e keep f fin)

def zipCost (B m : ℕ) : ℕ := (m + 1) * (B + 59) + 3

/-- Pushing a list of symbols in order. -/
def pushAll (l : List Sym) (D : List Sym) : List Sym := l.reverse ++ D

section
variable {q a b d e : Fin S} (hqa : q ≠ a) (hqb : q ≠ b) (hqd : q ≠ d) (hqe : q ≠ e)
  (hab : a ≠ b) (had : a ≠ d) (hae : a ≠ e) (hbd : b ≠ d) (hbe : b ≠ e) (hde : d ≠ e)
  (keep : Bool) (f : Bool → Bool → Bool → Bool × Bool) (fin : Bool → List Sym)
  (ra rb Q : List Sym) (hra : bitOf ra.head? = none) (hrb : bitOf rb.head? = none)

def zipCfg (σ : St S) (c : Sym) (A B : List Bool) (D E : List Sym) : St S :=
  ((((σ.set a (A.map codeBit ++ ra)).set b (B.map codeBit ++ rb)).set d D).set e E).set q (c :: Q)

end

end NLogN

end

