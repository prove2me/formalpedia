/-!
# B-line axis budget 1: closed-form bounds on the chunk kernel `cKer2`

* `cKG_le`, `cBlk2_le`: one block (with `j ≤ J`, `zsz (2nb) ≤ Z`, `φT ≤ Φ`):
  `cBlk2 n … ≤ (n+1) · Yb` with `Yb = 10^13 (BH+B+b+pk+10)(J+1)(Z+5) + 10 φD + Φ'`;
* `cLoop2_le`, **`cKer2_le`**: `cKer2 … ds ≤ 10^9 (λ+1)(BH+B+2) + 2(λ+1)·Yb + 10^4` for block
  lists with `1 ≤ n ≤ λ`, `Σ n ≤ λ`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

theorem pow2Cost_le' (E : ℕ) : pow2Cost E ≤ 2000 * (E + 1) * (zsz (E : ℤ) + 4) := by
  unfold pow2Cost addIntCost addMagCost subMagCost zipCost moveCost
  set a := zsz (E : ℤ)
  nlinarith

theorem cKG_le {j m B J Z : ℕ} (hj : j ≤ J) (hm : zsz (m : ℤ) ≤ Z) :
    cKG j m B ≤ 10 ^ 6 * (J + 1) * (B + 2) + 2000 * (m + 1) * (Z + 4) := by
  unfold cKG cP2
  have h1 := pow2Cost_le' m
  have h2 : 2000 * (m + 1) * (zsz (m : ℤ) + 4) ≤ 2000 * (m + 1) * (Z + 4) := by
    apply Nat.mul_le_mul_left; omega
  have h3 : j * (20000 * (B + 2) + 8000 * (B + 2) + 30) ≤ J * (20000 * (B + 2) + 8000 * (B + 2) + 30) :=
    Nat.mul_le_mul_right _ hj
  unfold moveCost
  nlinarith

theorem cBlk2_le_sol_aux {n pk b φD φT B BH J Z Φ : ℕ} (hj : Nat.clog 2 (2 * n) ≤ J)
    (hZ : zsz ((b * (2 * n) : ℕ) : ℤ) ≤ Z) (hΦ : φT ≤ (n + 1) * Φ) :
    cBlk2 n pk b φD φT B BH + 30 ≤ (n + 1) * Yb pk b φD Φ B BH J Z := by
  have hK := cKG_le (B := BkN b n) hj hZ
  have hR := cRec_le (2 * n) pk b 0 φT
  unfold cBlk2 cBlk Yb
  set X := BH + B + b + pk + 10 with hXdef
  have hX10 : 10 ≤ X := by omega
  have hXB : BH + 2 ≤ X := by omega
  have hXB2 : B + 2 ≤ X := by omega
  set N1 := (n + 1) * X with hN1
  have eN1 : N1 = n * X + X := by rw [hN1]; ring
  set M := N1 * (J + 1) * (Z + 5) with hM
  set A := (n + 1) * φD with hA
  set Bv := (n + 1) * Φ with hBv
  have eR : (n + 1) * (10 ^ 13 * X * (J + 1) * (Z + 5) + 10 * φD + 16000 * Φ)
      = 10 ^ 13 * M + 10 * A + 16000 * Bv := by rw [hM, hA, hBv, hN1]; ring
  rw [eR]
  have hXN : X ≤ N1 := by rw [eN1]; omega
  have hNJ : N1 * (J + 1) ≤ M := by
    rw [hM]; calc N1 * (J + 1) = N1 * (J + 1) * 1 := by ring
      _ ≤ N1 * (J + 1) * (Z + 5) := Nat.mul_le_mul_left _ (by omega)
  have hNZ : N1 * (Z + 5) ≤ M := by
    rw [hM]; calc N1 * (Z + 5) = N1 * (Z + 5) * 1 := by ring
      _ ≤ N1 * (Z + 5) * (J + 1) := Nat.mul_le_mul_left _ (by omega)
      _ = N1 * (J + 1) * (Z + 5) := by ring
  have hN1J : N1 ≤ N1 * (J + 1) := Nat.le_mul_of_pos_right _ (by omega)
  have p1 : (n + 1) * (B + 2) ≤ N1 := Nat.mul_le_mul_left _ hXB2
  have p2 : (2 * n + 1) * (b + 0 + pk + 10) ≤ 2 * N1 := by
    calc (2 * n + 1) * (b + 0 + pk + 10) ≤ (2 * (n + 1)) * X :=
          Nat.mul_le_mul (by omega) (by omega)
      _ = 2 * N1 := by rw [hN1]; ring
  have p3 : b * (2 * n) ≤ 2 * (n * X) := by
    calc b * (2 * n) ≤ X * (2 * n) := Nat.mul_le_mul_right _ (by omega)
      _ = 2 * (n * X) := by ring
  have hBk : BkN b n + 2 ≤ 8 * N1 := by unfold BkN; omega
  have q1 : 10 ^ 6 * (J + 1) * (BkN b n + 2) ≤ 8 * 10 ^ 6 * M := by
    calc 10 ^ 6 * (J + 1) * (BkN b n + 2) ≤ 10 ^ 6 * (J + 1) * (8 * N1) :=
          Nat.mul_le_mul_left _ hBk
      _ = 8 * 10 ^ 6 * (N1 * (J + 1)) := by ring
      _ ≤ 8 * 10 ^ 6 * M := Nat.mul_le_mul_left _ hNJ
  have q2 : 2000 * (b * (2 * n) + 1) * (Z + 4) ≤ 4000 * M := by
    calc 2000 * (b * (2 * n) + 1) * (Z + 4) ≤ 2000 * (2 * N1) * (Z + 5) :=
          Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) (by omega)
      _ = 4000 * (N1 * (Z + 5)) := by ring
      _ ≤ 4000 * M := Nat.mul_le_mul_left _ hNZ
  have hDG : cDG n φD B ≤ 2 * A + 400000 * N1 := by
    unfold cDG
    calc (n + 1) * (2 * φD + 400000 * (B + 2)) = 2 * A + 400000 * ((n + 1) * (B + 2)) := by
          rw [hA]; ring
      _ ≤ 2 * A + 400000 * N1 := by linarith [p1]
  have hMv : cMvP n B ≤ 40000 * N1 := by
    unfold cMvP
    calc (n + 1) * 40000 * (B + 2) = 40000 * ((n + 1) * (B + 2)) := by ring
      _ ≤ 40000 * N1 := by linarith [p1]
  have hMv2 : cMvP (2 * n) B ≤ 80000 * N1 := by
    unfold cMvP
    calc (2 * n + 1) * 40000 * (B + 2) ≤ (2 * (n + 1)) * 40000 * (B + 2) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by omega))
      _ = 80000 * ((n + 1) * (B + 2)) := by ring
      _ ≤ 80000 * N1 := by linarith [p1]
  have hTS : cTS n pk b φT B ≤ 2 * 10 ^ 12 * N1 + 8000 * Bv := by
    unfold cTS
    have : (n + 1) * 200000 * (B + 2) = 200000 * ((n + 1) * (B + 2)) := by ring
    linarith [hR, hΦ, p1, p2, hMv2]
  linarith [hK, q1, q2, hDG, hMv, hTS, hBk, hXN, hN1J, hNJ, hX10]

end J6Seg.KR

