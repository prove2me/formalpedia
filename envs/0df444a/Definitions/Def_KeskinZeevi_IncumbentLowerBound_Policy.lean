-- title:
--   Non-anticipating pricing policy on [l, u] and the price process it generates in the incumbent price model
-- statement:
--   A **pricing policy** on $[l,u]$ is a sequence of Borel measurable functions $\pi_1, \pi_2, \dots$ with values in $[l,u]$, where $\pi_1$ is a constant and $\pi_{t+1}$ is a function of the history $H_t = ((D_1,p_1), \dots, (D_t,p_t))$ of demands and prices observed through period $t$ (§2, p. 1145). A policy sees neither the slope $\beta$ nor the demand shocks; the known constants $\hat p$ and $\hat D$ may enter its rules.
--
--   Given a model, a slope $\beta$ and a realization $\epsilon_1, \epsilon_2, \dots$ of the demand shocks, the policy generates prices recursively:
--   $$p_1 = \pi_1, \qquad D_t = \hat D + \beta (p_t - \hat p) + \epsilon_t, \qquad p_{t+1} = \pi_{t+1}(H_t).$$
--   The demand equation is (19), $D_t = \hat D + \beta x_t + \epsilon_t$ with $x_t = p_t - \hat p$.
--
--   **Formalization Note.** Periods are indexed from $0$ in Lean: Lean period $t$ is the paper's period $t+1$, and `rule t` is the paper's $\pi_{t+1}$. The history $H_t$ is encoded as a function `Fin t → ℝ × ℝ` whose entry $i$ is the pair (demand, price) of the paper's period $i+1$. Since `Fin 0 → ℝ × ℝ` has one element, `rule 0` is the constant first price $\pi_1$. The policy outputs prices in $[l,u]$, and the deviations $x_t = p_t - \hat p$ are derived from them. Defining the price process from the shocks by this recursion realizes, on the noise probability space, the law of the history under $\pi$ and $\beta$ (the density (23)).
-- source:
--   Keskin and Zeevi, Dynamic Pricing with an Unknown Demand Model, Operations Research 62(5), 2014, p. 1145, Section 2, and p. 1149, Section 3.4, Eq. (19)

import Mathlib
import Definitions.Def_KeskinZeevi_IncumbentLowerBound_Model

namespace KeskinZeevi.IncumbentLowerBound

/-- A deterministic non-anticipating pricing policy on `[l, u]` (§2, p. 1145), single product.
Periods are indexed from `0` in Lean: Lean period `t` is the paper's period `t + 1`.
`rule t` maps the history `H_t = ((D₁, p₁), …, (D_t, p_t))`, encoded as `Fin t → ℝ × ℝ`
(entry `i` is the pair (demand, price) of the paper's period `i + 1`), to the price of the
paper's period `t + 1`. For `t = 0` the history type `Fin 0 → ℝ × ℝ` has a single element, so
`rule 0` is the constant first price `π₁`. Every rule is Borel measurable and takes values in
`[l, u]`. A policy outputs prices, not deviations; it sees neither the slope `β` nor the demand
shocks (the known constants `p̂`, `D̂` may be built into its rules). -/
structure Policy (l u : ℝ) where
  /-- `rule t` is the paper's `π_{t+1}`, a function of the history `H_t` -/
  rule : (t : ℕ) → (Fin t → ℝ × ℝ) → ℝ
  measurable_rule : ∀ t, Measurable (rule t)
  rule_mem : ∀ t (h : Fin t → ℝ × ℝ), rule t h ∈ Set.Icc l u

/-- The price sequence generated by policy `π` in the model `M` under slope `β`, along one
sequence of demand shocks `e` (Lean indices from `0`): `pricePath M π β e t = π.rule t H_t`,
where the history `H_t` records, for each earlier Lean period `i < t`, the realized demand
`D = D̂ + β (pricePath M π β e i − p̂) + e i` (Eq. (19), `D_t = D̂ + β x_t + ε_t` with
`x_t = p_t − p̂`) and the price `pricePath M π β e i`. This is the recursion `p₁ = π₁`,
`p_{t+1} = π_{t+1}(H_t)` of §2 (p. 1145) in the incumbent price setting of §3.4 (p. 1149). -/
noncomputable def pricePath (M : Model) (π : Policy M.l M.u) (β : ℝ) (e : ℕ → ℝ) : ℕ → ℝ
  | t => π.rule t (fun i : Fin t =>
      (M.DHat + β * (pricePath M π β e i - M.pHat) + e i, pricePath M π β e i))
termination_by t => t
decreasing_by exact i.isLt

end KeskinZeevi.IncumbentLowerBound


