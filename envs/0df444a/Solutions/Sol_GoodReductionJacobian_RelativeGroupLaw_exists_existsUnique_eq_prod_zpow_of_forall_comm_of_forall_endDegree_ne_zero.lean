variable {K : Type u} [Field K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}

local infixl:80 " ⊚ " => NeronModelInfra.schemeHomOverComp

def IsHom (L : RelativeGroupLaw K f) (β : SchemeHomOver f f) : Prop :=
  ∀ ⦃T : Scheme.{u}⦄ (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
    (L.mul t x y) ⊚ β = L.mul t (x ⊚ β) (y ⊚ β)

theorem comp_mul (L : RelativeGroupLaw K f) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (z : SchemeHomOver t f) (β γ : SchemeHomOver f f) :
    z ⊚ (L.mul f β γ) = L.mul t (z ⊚ β) (z ⊚ γ) := by
  have h := L.mul_natural f t z.1 z.2 β γ
  have e : ∀ δ : SchemeHomOver f f, GoodReductionJacobian.schemeHomOverComp z.1 z.2 δ = z ⊚ δ :=
    fun δ => Subtype.ext rfl
  rw [e, e, e] at h
  exact h

private theorem _root_.P2mKcFGComm.comp_one (L : RelativeGroupLaw K f) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (z : SchemeHomOver t f) : z ⊚ (L.one f) = L.one t := by
  have h := L.one_natural f t z.1 z.2
  have e : GoodReductionJacobian.schemeHomOverComp z.1 z.2 (L.one f) = z ⊚ (L.one f) := Subtype.ext rfl
  rw [e] at h
  exact h

p2m_export "P2mKcFGComm" "comp_one"
theorem comp_inv (L : RelativeGroupLaw K f) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (z : SchemeHomOver t f) (β : SchemeHomOver f f) :
    z ⊚ (L.inv f β) = L.inv t (z ⊚ β) := by
  letI := L.pointGroup t
  have h : (z ⊚ (L.inv f β)) * (z ⊚ β) = 1 := by
    change L.mul _ (z ⊚ (L.inv f β)) (z ⊚ β) = L.one _
    rw [← comp_mul, L.inv_mul_cancel, comp_one]
  exact eq_inv_of_mul_eq_one_left h

theorem IsHom.comp_one {L : RelativeGroupLaw K f} {β : SchemeHomOver f f} (H : IsHom L β)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) : (L.one t) ⊚ β = L.one t := by
  letI := L.pointGroup t
  have h := H t (L.one t) (L.one t)
  rw [L.one_mul] at h
  have h' : ((L.one t) ⊚ β) * 1 = ((L.one t) ⊚ β) * ((L.one t) ⊚ β) := by
    rw [mul_one]; exact h
  exact (mul_left_cancel h').symm

theorem nsmul_eq_pow (L : RelativeGroupLaw K f) (hc : L.IsCommutative) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of K)) (n : ℕ) (x : SchemeHomOver t f) :
    L.nsmul t n x = (letI := L.pointCommGroup hc t; x ^ n) := by
  letI := L.pointCommGroup hc t
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [RelativeGroupLaw.nsmul_succ, ih, pow_succ]
      rfl

theorem IsHom.comp_pow {L : RelativeGroupLaw K f} (hc : L.IsCommutative) {β : SchemeHomOver f f}
    (H : IsHom L β) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (n : ℕ) (x : SchemeHomOver t f) :
    (letI := L.pointCommGroup hc t; x ^ n) ⊚ β = (letI := L.pointCommGroup hc t; (x ⊚ β) ^ n) := by
  letI := L.pointCommGroup hc t
  induction n with
  | zero => exact H.comp_one t
  | succ n ih =>
      rw [pow_succ, pow_succ]
      change (L.mul t (x ^ n) x) ⊚ β = L.mul t ((x ⊚ β) ^ n) (x ⊚ β)
      rw [H, ih]

theorem IsHom.comp_inv_pt {L : RelativeGroupLaw K f} {β : SchemeHomOver f f} (H : IsHom L β)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x : SchemeHomOver t f) :
    (L.inv t x) ⊚ β = L.inv t (x ⊚ β) := by
  letI := L.pointGroup t
  have h := H t (L.inv t x) x
  rw [L.inv_mul_cancel, H.comp_one] at h
  have h' : ((L.inv t x) ⊚ β) * (x ⊚ β) = 1 := h.symm
  exact eq_inv_of_mul_eq_one_left h'

theorem comp_pow_right (L : RelativeGroupLaw K f) (hc : L.IsCommutative) {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of K)} (x : SchemeHomOver t f) (β : SchemeHomOver f f) (n : ℕ) :
    x ⊚ (letI := L.pointCommGroup hc f; β ^ n) = (letI := L.pointCommGroup hc t; (x ⊚ β) ^ n) := by
  letI := L.pointCommGroup hc f
  letI := L.pointCommGroup hc t
  induction n with
  | zero => exact comp_one L x
  | succ n ih =>
      rw [pow_succ, pow_succ]
      change x ⊚ (L.mul f (β ^ n) β) = L.mul t ((x ⊚ β) ^ n) (x ⊚ β)
      rw [comp_mul, ih]

theorem IsHom.comp {L : RelativeGroupLaw K f} {β γ : SchemeHomOver f f} (hβ : IsHom L β) (hγ : IsHom L γ) :
    IsHom L (β ⊚ γ) := by
  intro T t x y
  rw [← NeronModelInfra.schemeHomOverComp_assoc, ← NeronModelInfra.schemeHomOverComp_assoc,
    ← NeronModelInfra.schemeHomOverComp_assoc, hβ, hγ]

def EndPt (L : RelativeGroupLaw K f) (_hc : L.IsCommutative) : Type u := SchemeHomOver f f

scoped instance (L : RelativeGroupLaw K f) (hc : L.IsCommutative) : CommGroup (EndPt L hc) :=
  L.pointCommGroup hc f

def KPt (L : RelativeGroupLaw K f) (_hc : L.IsCommutative) : Type u :=
  SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f

scoped instance (L : RelativeGroupLaw K f) (hc : L.IsCommutative) : CommGroup (KPt L hc) :=
  L.pointCommGroup hc _

def commSubgroup (L : RelativeGroupLaw K f) (hc : L.IsCommutative) {ι : Type v} (c : ι → SchemeHomOver f f)
    (hcHom : ∀ j, IsHom L (c j)) : Subgroup (EndPt L hc) where
  carrier := {β | IsHom L (β : SchemeHomOver f f) ∧ ∀ j, (c j) ⊚ (β : SchemeHomOver f f) = (β : SchemeHomOver f f) ⊚ (c j)}
  mul_mem' := by
    intro β γ hβ hγ
    refine ⟨?_, fun j => ?_⟩
    · intro T t x y
      change (L.mul t x y) ⊚ (L.mul f β γ) = L.mul t (x ⊚ (L.mul f β γ)) (y ⊚ (L.mul f β γ))
      letI := L.pointCommGroup hc t
      rw [comp_mul, comp_mul, comp_mul, hβ.1, hγ.1]
      change ((x ⊚ β) * (y ⊚ β)) * ((x ⊚ γ) * (y ⊚ γ)) = ((x ⊚ β) * (x ⊚ γ)) * ((y ⊚ β) * (y ⊚ γ))
      rw [mul_mul_mul_comm]
    · change (c j) ⊚ (L.mul f β γ) = (L.mul f β γ) ⊚ (c j)
      rw [comp_mul, hβ.2 j, hγ.2 j]
      exact (hcHom j f β γ).symm
  one_mem' := by
    refine ⟨?_, fun j => ?_⟩
    · intro T t x y
      change (L.mul t x y) ⊚ (L.one f) = L.mul t (x ⊚ (L.one f)) (y ⊚ (L.one f))
      rw [comp_one, comp_one, comp_one, L.one_mul]
    · change (c j) ⊚ (L.one f) = (L.one f) ⊚ (c j)
      rw [comp_one, IsHom.comp_one (hcHom j)]
  inv_mem' := by
    intro β hβ
    refine ⟨?_, fun j => ?_⟩
    · intro T t x y
      change (L.mul t x y) ⊚ (L.inv f β) = L.mul t (x ⊚ (L.inv f β)) (y ⊚ (L.inv f β))
      letI := L.pointCommGroup hc t
      rw [comp_inv, comp_inv, comp_inv, hβ.1]
      change ((x ⊚ β) * (y ⊚ β))⁻¹ = (x ⊚ β)⁻¹ * (y ⊚ β)⁻¹
      rw [mul_inv]
    · change (c j) ⊚ (L.inv f β) = (L.inv f β) ⊚ (c j)
      rw [comp_inv, hβ.2 j]
      exact (IsHom.comp_inv_pt (hcHom j) f β).symm

