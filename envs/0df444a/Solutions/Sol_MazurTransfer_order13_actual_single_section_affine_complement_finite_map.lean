  apply RingHom.ext
  intro b
  change algebraMap (CoordinateRing R) (ordinaryInfinityLocalization R) (b : CoordinateRing R) =
    infinityLocalizedInclusion R ((recoveredReciprocalPatchEquiv R h104)
