private def paperTreeRows : RowTree → List Piece
  | .leaf p => [p]
  | .branch _ l r => paperTreeRows l ++ paperTreeRows r

private def paperTreeEdges : RowTree → ℚ → ℚ → Bool
  | .leaf p, a, b => decide (p.lo=a ∧ p.hi=b)
  | .branch t l r, a, b => paperTreeEdges l a t && paperTreeEdges r t b

private theorem paperTreeCovers (tree : RowTree) (a b : ℚ)
    (ok : paperTreeEdges tree a b=true)
    (mem : ∀ p∈paperTreeRows tree, p∈pieces) :
    tree.covers (·∈pieces) a b := by
  induction tree generalizing a b with
  | leaf p =>
    exact ⟨mem p (by simp [paperTreeRows]),of_decide_eq_true ok⟩
  | branch t l r il ir =>
    obtain ⟨hl,hr⟩ := Bool.and_eq_true_iff.mp ok
    exact ⟨il a t hl (fun p hp => mem p (List.mem_append_left _ hp)),
           ir t b hr (fun p hp => mem p (List.mem_append_right _ hp))⟩

