section
-- Source module: Solutions.KFWC8
/-!
# KFW C-layer 8: the scalar `b^D` by an 8-way selection

`MD D = MD (D mod 8)` (`MD_mod8`): the scalar kernel needs only `D mod 8` in its code.  The fixed
code `mdC` tests `D mod 8 < j + 1` for `j = 0 … 6` and runs the kernel `qopU [MD j]` on chunk `0`
of the layer (level frame `mdF`).

**`mdQ`**: `mdC` implements `tensF (kerAt 0 (b^D • 1))` on the layer, scale `D/2 + D mod 2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The level frame of the scalar kernel (chunk `0`, bit `ρ + K (D - 1)`). -/
def mdF : List (Fin HS × NE) :=
  [(2, .mul (.reg 1) (.reg 22)), (6, .lit 0), (7, .lit 1),
    (8, .add (.reg 23) (.mul (.reg 1) (.sub (.reg 22) (.lit 1)))),
    (9, .reg 21), (10, .lit 1)]

/-- The scalar kernel for `D mod 8 = j`. -/
def mdK {Pp : ℕ} (j : ℕ) : IStmt HS Pp := withPushI (fr mdF) (fcode (qopU [MD j] eB1L eGL))

/-- The test `D mod 8 < j + 1` (value `0` when true). -/
def mdCond (j : ℕ) : NE := .lt (.mod (.reg 22) (.lit 8)) (.lit (j + 1)) (.lit 0) (.lit 1)

/-- The selection chain from `j` with `f` tests. -/
def mdT {Pp : ℕ} : ℕ → ℕ → IStmt HS Pp
  | j, 0 => mdK j
  | j, f + 1 => testC 16 (mdCond j) (mdK j) (mdT (j + 1) f)

/-- The scalar pass. -/
def mdC {Pp : ℕ} : IStmt HS Pp := mdT 0 7

/-- Cost of the scalar kernel. -/
def cMdK (N Z Bz w : ℕ) : ℕ :=
  cFrame 6 12 Bz + 400 * (ck N Z w + xLeaf Z) + (6 * (2 * Bz + 2) + 1)

/-- Cost of one test. -/
def cMdT (Bz : ℕ) : ℕ := cFrame 1 12 Bz + 25 + (1 * (2 * Bz + 2) + 1)

section MD

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

end MD

end NLogN.KFW

end

