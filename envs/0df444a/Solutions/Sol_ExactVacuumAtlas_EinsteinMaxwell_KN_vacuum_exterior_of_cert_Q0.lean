-- ==== solution ====
open Real
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.KN
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
theorem solution (M a : ℝ) (hM : 0 < M) :
    VacuumCertificate (KerrBL.gKerr M a) (KerrBL.giKerr M a) (domKN M a 0) :=
  (toVacuum (cert_Q0_exterior M a hM) (fun _ _ _ _ => rfl)).congr
    (fun i j => (gQ0 M a i j).mono (domKN_subset_domReg hM))
    (fun i j => (giQ0 M a i j).mono (domKN_subset_domReg hM))
