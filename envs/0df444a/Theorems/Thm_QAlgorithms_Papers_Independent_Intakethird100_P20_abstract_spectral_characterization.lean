-- title:
--   abstract-spectral-characterization
-- statement:
--   Let $L$ be a complete orthomodular lattice with its designated orthocomplement, and let $D(L)$ be its proper dual ideals, with the topology generated by membership. If $f:D(L)\to\mathbb R$ is upper semicontinuous and sends nonempty intersections to real suprema, then there is a unique bounded right-continuous spectral family $E$ such that
--
--   $$f(J)=\inf\{\lambda\in\mathbb R:E_\lambda\in J\}\qquad(J\in D(L)).$$
--
--   This is the announced abstract spectral-family characterization; no operator representation is asserted for an arbitrary lattice.
-- source:
--   Observables I: Stone Spectra, arXiv:math-ph/0509020v1, PDF p. 11, abstract-spectral-characterization

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P20

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakethird100.P20

open Set TopologicalSpace

open QAlgorithms.Papers.Independent.Next46.P33 (Projection)

open scoped Topology

universe u v

/-- abstract-spectral-characterization; de Groote, Observables I, PDF p./pp. 11.
-/
theorem abstract_spectral_characterization {L : Type u} [CompleteLattice L] (perp : L → L)
    (horth : IsOrthomodular perp) (f : DualIdeal L → ℝ) (hf : IsAbstractObservable f) :
    ∃! E : ℝ → L, IsBoundedSpectralFamily E ∧ f = dualSpectralValue E := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P20

end
