-- Source module: Solutions.KFMU1
/-!
# KFM U1: uniform counted repetition and uniform pointwise passes

`UNIFORM.md`: the count of a repetition is run-time data. `rptX X A C D b` is KFT's `rpt` with the
literal count replaced by a copy (`dup`) of the top of stack `X`.

* **`rptX_runs`**: as `rpt_runs`, from a state whose `X` holds `n`; cost `+ dupCost (zsz n) + 17`.
* **`mvBackU_runs`**, **`gmulPU_runs`**, **`itemPU_runs`**: KFM's `mvBack`/`gmulP`/`itemP` with the
  counts on `nX = 30` (`N`) and `nX2 = 31` (`2N`), and the instances **`shlPU_runs`**,
  **`roundPU_runs`**, **`smulPU_runs`**, **`gmulPU_kTable`**. The bodies (`entryB`, `mvB`, `shlB`,
  `roundB`, `smulB`) are KFM's, unchanged (stacks 43–53, 60–62; leaf procedures).

**Nesting.** Every spec here is frame-preserving: the final state is the initial one with only the
output stacks changed, for arbitrary contents of all other stacks (including the scratch 43–53,
60–62, whose contents are restored). So a pass may run inside a caller that keeps data on those
stacks, e.g. KFV's parameter stacks 50–55. The counters avoid KFV6Loop's stacks 20–23.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFT

open IntMul KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end NLogN.KFT

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem mvBackU_runs (X : Fin HS) (hX0 : X ≠ 0) (hXO : X ≠ pO) (hXA : X ≠ pA)
    (hXC : X ≠ pC) (hXD : X ≠ pD) (LX : List Item) (L : List ℤ) (B : ℕ) (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS)
    (LO : List Item) (hO : s.G pO = ints L ++ LO) (hX : s.G X = .int (L.length : ℤ) :: LX) :
    IRuns I iprog (rptX X pA pC pD mvB) s
      ((s.upd pO LO).upd 0 (ints L.reverse ++ s.G 0))
      (L.length * (110 * (B + 1) + 64) + 60 + cRpt L.length + (dupCost (zsz (L.length : ℤ)) + 17)) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd pO (ints (L.drop k) ++ LO)).upd 0 (ints (L.take k).reverse ++ s.G 0)
  have h := rptX_runs (I := I) (iprog := iprog) (X := X) (A := pA) (C := pC) (D := pD) hXA (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) mvB
    (110 * (B + 1))
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have H := IRuns.mv (I := I) (iprog := iprog) (s := cf3 (T k) pA pC pD LA LC LD) (i := pO)
        (j := 0) (a := L[k]) (L := ints (L.drop (k + 1)) ++ LO) (by decide)
        (by simp +decide only [T, cf3, IState.upd_G, if_true, if_false]; rw [hd]; rfl)
      refine H.mono' ?_ ?_
      · have ht : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have e2 : ints (L.take (k + 1)).reverse = .int L[k] :: ints (L.take k).reverse := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear H e2 ht hd
        ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
      · have := moveIntCost_le (zsz L[k]); omega)
  have h := h LX (by simp [T, hX0, hXO, hX])
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil]
    rw [← hO]; simp [ints]
  have e1 : T L.length = (s.upd pO LO).upd 0 (ints L.reverse ++ s.G 0) := by
    simp only [T, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at h
  exact h

end NLogN.KFM

