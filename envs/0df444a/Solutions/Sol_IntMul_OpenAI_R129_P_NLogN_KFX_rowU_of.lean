theorem TB : T + 1 ≤ Bb := by
  have h := NLogN.KIL.zsz_nat_le (hp.TV (H := H))
  have e : zsz (((2 ^ T : ℕ)) : ℤ) = T + 1 := by push_cast; exact NLogN.zsz_two_pow T
  omega

