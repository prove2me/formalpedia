-- Source module: Solutions.R6IL2CKey
/-!
# Round six, compact controls (I2C): the key program of the correction

`keyProgC` computes, for the record index `m` on register `rm`, the key
`κ m = l.stepP (fun x c => TlS x (Psi x c)) m` (the pull composite of the program followed by the
ideal map) and pushes it on `rK` (`keyProgC_fsp`).  The layout parameters are read from the
registers `24 … 35` and `13` (`QL`); the values `x, t, u, y` live on `4, 5, 9, 12`.
Each of the eleven value updates is one segment loop (`vStep`, `vStep_fsp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## The segment step with register radices -/

set_option maxHeartbeats 2000000 in
theorem segStepR_fsp_sol_aux {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ}
    (hT : SegTR T tf Bb Tm Rv) (s : IState HS) (G : Fin HS → List ℤ) (hGc : G rC = [])
    {tgt : Fin HS} (ht56 : tgt.val < 56) (htA : tgt ≠ rA) (htU : tgt ≠ rU) (htV : tgt ≠ rV)
    (htW : tgt ≠ rW) (htC : tgt ≠ rC) {a0 : ℤ} {lt : List ℤ} (hGt : G tgt = a0 :: lt)
    (za0 : zsz a0 ≤ Bb) {ru rv rw : ℤ} {n : ℕ} {Lu Lv Lw LR LN : List Item}
    (hRu : (encK s G).G pRu = .int ru :: Lu) (hRv : (encK s G).G pRv = .int rv :: Lv)
    (hRw : (encK s G).G pRw = .int rw :: Lw) (hRR : (encK s G).G pR = .int Rv :: LR)
    (hNn : (encK s G).G pN = .int (n : ℤ) :: LN)
    (hru : 0 < ru) (hrv : 0 < rv) (hrw : 2 ≤ rw)
    (zru : zsz ru ≤ Bb) (zrv : zsz rv ≤ Bb) (zrw : zsz rw ≤ Bb) (hnb : zsz (n : ℤ) ≤ Bb)
    {eu ev ew ea efin : Ex HS} {u v w a r : ℤ}
    (hu : 0 ≤ u) (hv : 0 ≤ v) (hw : 0 < w) (hub : zsz u ≤ Bb) (hvb : zsz v ≤ Bb)
    (hTm : 1 ≤ Tm) (hbig : |a| + Tm * w * rw ^ n < 2 ^ Bb)
    (hrv' : NoSeg ev) (hrw' : NoSeg ew) (hra : NoSeg ea)
    (Eu : ESp eu (encK s G) Bb u) (Ev : ESp ev (encK s G) Bb v) (Ew : ESp ew (encK s G) Bb w)
    (Ea : ESp ea (encK s G) Bb a)
    (Efin : ∀ G' : Fin HS → List ℤ, G' rA = (a + segSum tf ru rv rw w u v n) :: G rA →
      (∀ i, i ≠ rA → i ≠ rU → i ≠ rV → i ≠ rW → G' i = G i) → ESp efin (encK s G') Bb r) :
    FSp (segStepR eu ev ew ea T tgt efin) (encK s G)
      (encK s (Function.update G tgt (r :: lt)))
      (cStepR T Bb n (eu.size + ev.size + ew.size + ea.size + efin.size)) := by
  -- push u
  have S1 := Sp.pushQ s G (i := rU) (by decide) Eu.clean Eu.ok Eu.bnd
  rw [Eu.ev] at S1
  set G1 := Function.update G rU (u :: G rU) with hG1
  have Ev1 : ESp ev (encK s G1) Bb v := Ev.congr (fun i hi => by
    simp only [encK_G, G1]; rw [upd_ne (hrv' i hi).2.1])
  have S2 := Sp.pushQ s G1 (i := rV) (by decide) Ev1.clean Ev1.ok Ev1.bnd
  rw [Ev1.ev] at S2
  set G2 := Function.update G1 rV (v :: G1 rV) with hG2
  have Ew2 : ESp ew (encK s G2) Bb w := Ew.congr (fun i hi => by
    simp only [encK_G, G2, G1]
    rw [upd_ne (hrw' i hi).2.2.1, upd_ne (hrw' i hi).2.1])
  have S3 := Sp.pushQ s G2 (i := rW) (by decide) Ew2.clean Ew2.ok Ew2.bnd
  rw [Ew2.ev] at S3
  set G3 := Function.update G2 rW (w :: G2 rW) with hG3
  have Ea3 : ESp ea (encK s G3) Bb a := Ea.congr (fun i hi => by
    simp only [encK_G, G3, G2, G1]
    rw [upd_ne (hra i hi).2.2.2, upd_ne (hra i hi).2.2.1, upd_ne (hra i hi).2.1])
  have S4 := Sp.pushQ s G3 (i := rA) (by decide) Ea3.clean Ea3.ok Ea3.bnd
  rw [Ea3.ev] at S4
  set G4 := Function.update G3 rA (a :: G3 rA) with hG4
  have g4A : G4 rA = a :: G rA := by
    simp only [G4]; rw [Function.update_self]; simp only [G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
  have g4W : G4 rW = w :: G rW := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [Function.update_self]
    simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]
  have g4V : G4 rV = v :: G rV := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [Function.update_self]; simp only [G1]; rw [upd_ne (by decide)]
  have g4U : G4 rU = u :: G rU := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [upd_ne (by decide)]; simp only [G1]; rw [Function.update_self]
  have g4o : ∀ j, j ≠ rA → j ≠ rU → j ≠ rV → j ≠ rW → G4 j = G j := by
    intro j h1 h2 h3 h4
    simp only [G4, G3, G2, G1]; rw [upd_ne h1, upd_ne h4, upd_ne h3, upd_ne h2]
  have g4c : G4 rC = [] := by rw [g4o rC (by decide) (by decide) (by decide) (by decide)]; exact hGc
  have e4 : ∀ j, j ≠ rA → j ≠ rU → j ≠ rV → j ≠ rW → (encK s G4).G j = (encK s G).G j :=
    fun j h1 h2 h3 h4 => encK_G_eq (g4o j h1 h2 h3 h4)
  have SL := segLoopR_fsp hT s G4 g4c
    (by rw [e4 _ (by decide) (by decide) (by decide) (by decide)]; exact hRu)
    (by rw [e4 _ (by decide) (by decide) (by decide) (by decide)]; exact hRv)
    (by rw [e4 _ (by decide) (by decide) (by decide) (by decide)]; exact hRw)
    (by rw [e4 _ (by decide) (by decide) (by decide) (by decide)]; exact hRR)
    hru hrv hrw zru zrv zrw a u v w hu hv hw n
    (by rw [e4 _ (by decide) (by decide) (by decide) (by decide)]; exact hNn)
    hub hvb hnb hTm hbig
  have e0 : segFR G4 tf ru rv rw a u v w 0 = G4 :=
    segFR_zero _ _ _ _ _ _ _ _ _ (by simp [g4A]) (by simp [g4U]) (by simp [g4V]) (by simp [g4W])
  rw [e0] at SL
  set G5 := segFR G4 tf ru rv rw a u v w n with hG5
  have g5A : G5 rA = (a + segSum tf ru rv rw w u v n) :: G rA := by
    simp only [G5]; rw [segFR_rA, g4A]; rfl
  have g5o : ∀ j, j ≠ rA → j ≠ rU → j ≠ rV → j ≠ rW → G5 j = G j := by
    intro j h1 h2 h3 h4; simp only [G5]
    rw [segFR_ne _ _ _ _ _ _ _ _ _ _ h1 h2 h3 h4, g4o j h1 h2 h3 h4]
  have Ef := Efin G5 g5A g5o
  have g5t : G5 tgt = a0 :: lt := by rw [g5o tgt htA htU htV htW]; exact hGt
  have S6 := Sp.asgQ s G5 (i := tgt) ht56 g5t za0 Ef.clean Ef.ok Ef.bnd
  rw [Ef.ev] at S6
  set G6 := Function.update G5 tgt (r :: lt) with hG6
  have hacc := segSum_abs (ru := ru) (rv := rv) hT.abs hrw hw.le u v n
  have hpn : (0 : ℤ) < rw ^ n := by positivity
  have hTw : (0 : ℤ) ≤ Tm * w := by positivity
  have g6A : G6 rA = (a + segSum tf ru rv rw w u v n) :: G rA := by
    simp only [G6]; rw [upd_ne htA.symm]; exact g5A
  have S7 := Sp.pop s G6 (B := Bb) (by decide) g6A (KFL.zsz_le_of_abs (by
    have := abs_add_le a (segSum tf ru rv rw w u v n)
    have : Tm * w * (rw ^ n - 1) ≤ Tm * w * rw ^ n := by nlinarith
    linarith))
  set G7 := Function.update G6 rA (G rA) with hG7
  have g7W : G7 rW = w * rw ^ n :: G rW := by
    simp only [G7, G6]
    rw [upd_ne (by decide), upd_ne htW.symm]; simp only [G5]; rw [segFR_rW, g4W]; rfl
  have S8 := Sp.pop s G7 (B := Bb) (by decide) g7W (KFL.zsz_le_of_abs (by
    rw [abs_of_pos (by positivity)]
    have := abs_nonneg a
    have : w * rw ^ n ≤ Tm * w * rw ^ n := by
      have : 0 ≤ w * rw ^ n := by positivity
      nlinarith
    linarith))
  set G8 := Function.update G7 rW (G rW) with hG8
  have g8V : G8 rV = v / rv ^ n :: G rV := by
    simp only [G8, G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne htV.symm]; simp only [G5]
    rw [segFR_rV, g4V]; rfl
  have S9 := Sp.pop s G8 (B := Bb) (by decide) g8V
    (le_trans (zsz_ediv_le hv (by positivity)) hvb)
  set G9 := Function.update G8 rV (G rV) with hG9
  have g9U : G9 rU = u / ru ^ n :: G rU := by
    simp only [G9, G8, G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne htU.symm]
    simp only [G5]; rw [segFR_rU, g4U]; rfl
  have S10 := Sp.pop s G9 (B := Bb) (by decide) g9U
    (le_trans (zsz_ediv_le hu (by positivity)) hub)
  set G10 := Function.update G9 rU (G rU) with hG10
  have hfin : G10 = Function.update G tgt (r :: lt) := by
    funext j
    simp only [G10]
    by_cases h1 : j = rU
    · subst h1; rw [Function.update_self, upd_ne htU.symm]
    rw [upd_ne h1]; simp only [G9]
    by_cases h2 : j = rV
    · subst h2; rw [Function.update_self, upd_ne htV.symm]
    rw [upd_ne h2]; simp only [G8]
    by_cases h3 : j = rW
    · subst h3; rw [Function.update_self, upd_ne htW.symm]
    rw [upd_ne h3]; simp only [G7]
    by_cases h4 : j = rA
    · subst h4; rw [Function.update_self, upd_ne htA.symm]
    rw [upd_ne h4]
    simp only [G6]
    by_cases h5 : j = tgt
    · subst h5; rw [Function.update_self, Function.update_self]
    rw [upd_ne h5, upd_ne h5]
    exact g5o j h4 h1 h2 h3
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    ((FSp.of_norep rfl S4).seq (SL.seq ((FSp.of_norep rfl S6).seq ((FSp.of_norep rfl S7).seq
    ((FSp.of_norep rfl S8).seq ((FSp.of_norep rfl S9).seq (FSp.of_norep rfl S10)))))))))
  refine (H.congr (by rw [hfin])).mono ?_
  simp only [cStepR, Ex.size]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  generalize cLp n (cSegItR T Bb) Bb = Y
  generalize eu.size = a1
  generalize ev.size = a2
  generalize ew.size = a3
  generalize ea.size = a4
  generalize efin.size = a5
  ring_nf; omega

