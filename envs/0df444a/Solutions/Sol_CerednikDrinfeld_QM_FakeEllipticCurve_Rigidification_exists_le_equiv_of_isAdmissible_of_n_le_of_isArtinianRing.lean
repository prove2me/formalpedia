theorem act_pow_represents_pushPt
    {r : ℕ} [Fact r.Prime] {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {k₀ : Type} [CommRing k₀]
    (A₀ : FakeEllipticCurve Λ N k₀) (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (X₀ : FormalODModule r k₀) (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2) (hA₀ : A₀.IsFormalModuleVia coord X₀ θ₀)
    (h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ) (k : ℕ) :
    (∀ i, MvPowerSeries.constantCoeff (X₀.act ((r : Zp2 r) ^ k) i) = 0) ∧
    ∀ (B' : Type) [CommRing B'] [Algebra k₀ B'] (J : Ideal B') (n : ℕ),
        J ^ (n + 1) = ⊥ → ∀ s : Fin 2 → B', (∀ i, s i ∈ J) →
          θ₀ B' (fun i => MvFormalGroup.nilEval n (X₀.act ((r : Zp2 r) ^ k) i) s) =
            pushPt (A₀.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩) (A₀.act_over _) (θ₀ B' s) := by
  refine ⟨(X₀.isLawHom_act _).1, ?_⟩
  intro B' _ _ J n hJ s hs
  have hn : (((r ^ k : ℕ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    have := hΛℤ ((r ^ k : ℕ) : ℤ); exact_mod_cast this
  have key := FakeEllipticCurve.apply_nilEval_natCast_eq_mapPt_act_of_isFormalModuleVia
    A₀ coord hcoord X₀ θ₀ hA₀ h1 (r ^ k) hn B' J n hJ s hs
  have hser : ((r ^ k : ℕ) : MvFormalGroup.End X₀.F).toPowerSeries = X₀.act ((r : Zp2 r) ^ k) := by
    rw [MvFormalGroup.End.toPowerSeries_natCast, ← FormalODModule.act_natCast, Nat.cast_pow]
  rw [hser] at key
  rw [key]
  have hm : (⟨(((r ^ k : ℕ)) : ℚ), hn⟩ : ↥Λ) = ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := Subtype.ext (by push_cast; norm_cast)
  have gen : ∀ (m m' : ↥Λ), m = m' →
      ∀ P : SchemeHomOver (Scheme.specOver (𝒪 := k₀) B') A₀.f,
        mapPt (A₀.act m) (A₀.act_over m) P = pushPt (A₀.act m') (A₀.act_over m') P := by
    rintro m _ rfl P; rfl
  exact gen _ _ hm _

