-- Source module: Solutions.KFNRole
/-!
# KFN: the role streams of a network invocation

A network state on `W` roles is stored role-major: role `w` is a list `X w` of `n` records, and
record `j` of a role carries the group address `fbit st j : Addr m κ` (selected bits with record
strides `st`, `KFNSel`).  `roleOpF st n A X` is the action of a network operator
`A : ROp (Fin W) m κ` on these streams.

* `roleOpF_mul`, `roleOpF_one`: the operator calculus.
* `roleOpF_blockOp`, `roleOpF_wireOp`, `roleOpF_roleDiag`: block operators act per role.
* The steps of `P8Lift.RStep`: `roleOpF_gate` (a linear combination of whole roles),
  `roleOpF_perm` (role permutation), `roleOpF_phase`, `roleOpF_rowAdd`, `roleOpF_child`
  (`selOpF` on one role; a child acts with the restricted strides of its slot).
* **`roleOpF_net`**: the network acts as the sequence of its steps, and for an interface
  (`Prop8IfaceR.correct`) **`roleOpF_iface`**: running the steps of `J.net` one after the other
  computes `selOpF st n (tens Cm)` on every role.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open AModel Matrix Finset P8Lift Butterfly

section Role

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {M : Type*} [AddCommMonoid M]
  [Module ℂ M]

theorem roleOpF_blockOp (st : Fin m × κ → ℕ) (n : ℕ) (A : Fin W → Butterfly.Op (Fin m × κ))
    (X : Fin W → List M) (w : Fin W) :
    roleOpF st n (blockOp A) X w = selOpF st n (A w) (X w) := by
  simp only [roleOpF, selOpF]
  refine List.map_congr_left fun j _ => ?_
  rw [Fintype.sum_prod_type, Finset.sum_eq_single w]
  · simp [blockOp]
  · intro v _ hv
    refine Finset.sum_eq_zero fun y _ => ?_
    simp [blockOp, Ne.symm hv]
  · simp

theorem roleOpF_wireOp (st : Fin m × κ → ℕ) (n : ℕ) (w : Fin W) (A : Butterfly.Op (Fin m × κ))
    {X : Fin W → List M} (hX : ∀ w, (X w).length = n) :
    roleOpF st n (wireOp w A) X = Function.update X w (selOpF st n A (X w)) := by
  funext v
  rw [wireOp, roleOpF_blockOp]
  by_cases hv : v = w
  · subst hv; simp
  · rw [if_neg hv, Function.update_of_ne hv, selOpF_one (hX v)]

/-! ## The steps -/

theorem roleOpF_rowAdd (st : Fin m × κ → ℕ) (n : ℕ) (T : Butterfly.Op κ) (w : Fin W) (i j : Fin m)
    (hij : i ≠ j) {X : Fin W → List M} (hX : ∀ w, (X w).length = n) :
    roleOpF st n ((RStep.rowAdd w i j hij : RStep (Fin W) m).den T) X =
      Function.update X w (selOpF st n (Pm i j) (X w)) := by
  rw [den_rowAdd, roleOpF_wireOp _ _ _ _ hX]

/-! ## The network -/

end Role

end NLogN.KFN

