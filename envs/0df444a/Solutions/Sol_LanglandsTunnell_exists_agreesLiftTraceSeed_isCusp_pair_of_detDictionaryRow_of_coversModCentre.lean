  rw [← under_eq_ratPrime_ratOf u] at hmem
  have hmem2 : algebraMap (𝓞 ℚ) (𝓞 (↥(_root_.LanglandsTunnell.P0.fixFld (_root_.LanglandsTunnell.P5.sylowH e)))) ((ratOf u : ℕ) : 𝓞 ℚ)
