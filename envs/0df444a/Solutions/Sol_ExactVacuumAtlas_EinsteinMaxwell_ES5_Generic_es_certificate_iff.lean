open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.Generic
variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ}
theorem solution (hE : ESData R B D A H W Φ Ψ) (hne : R.Nonempty)
    (hsig : ∀ r ∈ R, 0 < A r ∧ 0 < H r ∧ 0 < B r * D r) :
    EMCertificateD (esMetric B D A H W) (esInverse B D A H W) (esFaraday Φ Ψ) (esDomain R) ↔
      ReducedSystem B D A H W Φ Ψ R := by
  constructor
  · intro hc r hr
    have hx := ptR_mem hr
    have h := (field_equations_iff hE (ptR r) hx).mp
      ⟨fun a b => hc.einstein _ hx a b, fun b => hc.maxwell _ hx b, fun a b c => hc.closed _ hx a b c⟩
    rw [ptR_one] at h
    exact h
  · intro h
    obtain ⟨r0, hr0⟩ := hne
    exact
      { isOpen := isOpen_esDomain hE.isOpen
        nonempty := ⟨ptR r0, ptR_mem hr0⟩
        symm := fun x _ i j => esMetric_symm B D A H W x i j
        inv := fun x hx => esInverse_mul B D A H W x (hE.nB _ hx.1) (hE.nD _ hx.1) (hE.nA _ hx.1)
          (hE.nH _ hx.1) hx.2.1.ne' (sub_pos.mpr hx.2.2).ne'
        smooth := esMetric_smooth B D A H W hE.cB hE.cD hE.cA hE.cH hE.cW
        smooth_inv := esInverse_smooth B D A H W hE.cB hE.cD hE.cA hE.cH hE.cW hE.nB hE.nD hE.nA hE.nH
        smooth_F := esFaraday_smooth hE.isOpen hE.cΦ hE.cΨ
        antisymm := fun x _ i j => esFaraday_antisymm Φ Ψ x i j
        lorentz := fun x hx => esMetric_lorentz B D A H W x (hsig _ hx.1).1 (hsig _ hx.1).2.1
          (hsig _ hx.1).2.2 hx.2.1 hx.2.2
        einstein := fun x hx => ((field_equations_iff hE x hx).mpr (h (x 1) hx.1)).1
        maxwell := fun x hx => ((field_equations_iff hE x hx).mpr (h (x 1) hx.1)).2.1
        closed := fun x hx => ((field_equations_iff hE x hx).mpr (h (x 1) hx.1)).2.2 }
