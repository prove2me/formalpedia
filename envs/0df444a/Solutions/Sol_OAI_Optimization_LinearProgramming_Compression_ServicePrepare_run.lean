  rw [scalarInvariant] at ea eb ec
  refine ⟨t,_,?_,ea.seq (eb.seq (ec.seq et)),?_,?_,ready.oddAddress,?_,ready.liveWord,ready.rankWord,ready.tableWords table⟩
