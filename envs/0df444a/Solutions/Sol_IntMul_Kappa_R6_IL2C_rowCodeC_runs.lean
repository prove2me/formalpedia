/-! ## The strides of a row addition -/

theorem strd_vol (N0 N1 N2 N3 L : ℕ) (t : Fin 3) :
    strd (IL2C.gR N0 N1 N2 N3 L) t = vol ((rect N0 N1 N2 N3 L).drop (slotF t + 1)) := by
  obtain ⟨a, ha⟩ := t
  have : a = 0 ∨ a = 1 ∨ a = 2 := by omega
  rcases this with rfl | rfl | rfl
  · show (IL2C.gR N0 N1 N2 N3 L).S0 = _
    simp [IL2C.gR, Geo.S0, Geo.S1, Geo.S2, rect, slotF, vol]; ring
  · show (IL2C.gR N0 N1 N2 N3 L).S1 = _
    simp [IL2C.gR, Geo.S1, Geo.S2, rect, slotF, vol]; ring
  · show (IL2C.gR N0 N1 N2 N3 L).S2 = _
    simp [IL2C.gR, Geo.S2, rect, slotF, vol]

theorem fin3_lt_iff {g : Fin 3 → ℕ} (h01 : g 0 < g 1) (h12 : g 1 < g 2) (a b : Fin 3) :
    a < b ↔ g a < g b := by
  fin_cases a <;> fin_cases b <;> simp <;> omega

section Geo

variable {m F K e T S0 B r : ℕ} {i j : Fin m}

theorem strd_row (hp : IL3F.PF m F K e T S0 B r) (hij : (i : ℕ) ≠ j) :
    strd (IL2C.gR (IL3F.N0R m F K e T B i j) (IL3F.N1R m F K e i j) (IL3F.N2R m F K e i j)
      (IL3F.N3R m F K e S0 i j) (F * K)) (pxR i j) = 2 ^ IL3F.srw m K e F i * S0 ∧
    strd (IL2C.gR (IL3F.N0R m F K e T B i j) (IL3F.N1R m F K e i j) (IL3F.N2R m F K e i j)
      (IL3F.N3R m F K e S0 i j) (F * K)) (pyR i j) = 2 ^ IL3F.srw m K e F j * S0 := by
  have hm3 : 3 ≤ m := by have := hp.m16; omega
  haveI : NeZero F := ⟨by have := hp.f1; omega⟩
  have hsh := IL3F.shR_eq (F := F) (K := K) (e := e) (T := T) (S0 := S0) (B := B) hm3 hij
  have hW := fun t => IL3F.shR_weightF (IL3F.posR_he hp.he') hp.ht (IL2.σF_mono hm3 hij)
    (S0 := S0) (B := B) t
  have hpx : IL2.σF i j (pxR i j) = i := Fin.ext (by rw [IL2.σF_val hm3 hij, σR_px])
  have hpy : IL2.σF i j (pyR i j) = j := Fin.ext (by rw [IL2.σF_val hm3 hij, σR_py])
  constructor
  · rw [strd_vol, ← hsh, hW, hpx]
  · rw [strd_vol, ← hsh, hW, hpy]

theorem px_lt_iff (hm : 3 ≤ m) (hij : (i : ℕ) ≠ j) : pxR i j < pyR i j ↔ (i : ℕ) < j := by
  have h := rows_lt hij
  have e := fin3_lt_iff (g := σR i j) (by simp [σR]; omega) (by simp [σR]; omega) (pxR i j) (pyR i j)
  rw [e, σR_px, σR_py]

end Geo

