  · simp only [Category.assoc, KerOps.oneK_str, Category.comp_id]

theorem VC_transfer {T₂ : Type} [CommRing T₂] (ψ : T →+* T₂) (E₂ : FakeEllipticCurve Λ N₀ T₂)
