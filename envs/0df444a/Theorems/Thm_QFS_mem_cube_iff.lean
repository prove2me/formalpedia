import Definitions.Def_QFS_Translate
import Definitions.Def_QFS_Defs
import Definitions.Def_QFS_Cubes
import Mathlib

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option maxSynthPendingDepth 3

open Real Set Metric Finset

open QFS

variable {d : ℕ}

/-! ## Definition 2.5: cubes -/

lemma QFS.mem_cube_iff {h : ℝ} {u x : EuclideanSpace ℝ (Fin d)} :
    x ∈ cube h u ↔ infNorm (x - u) < h / 2 := by sorry
