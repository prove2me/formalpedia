theorem child10_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu047.lin : ℝ) ≤ (S : ℝ) * logProd gu047.lo) :
    (gu051.lfin : ℝ) ≤ (S : ℝ) * logProd gu051.top ∧
