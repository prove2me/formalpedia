/-- **Sum of squares.** `q(z) + α² q(v) = L²/(DfH) + (α² + β²)(A/(4U) v₂² + A U v₄²)`,
`L = f a' v₀ + H e v₃`, `U = u(1-u)`. -/
theorem frame_sum_of_squares {f D A H u : ℝ} (hf : f ≠ 0) (hD : D ≠ 0) (hA : A ≠ 0)
    (hH : H ≠ 0) (hu : u ≠ 0) (hv : 1 - u ≠ 0) (e a1 a0 : ℝ) (v : Fin 5 → ℝ) :
    frameQ f D A H u (frameZ f D A H u e a1 a0 v) + alphaSqFrame f D H e a1 * frameQ f D A H u v =
      (f * a1 * v 0 + H * e * v 3) ^ 2 / (D * f * H) +
        (alphaSqFrame f D H e a1 + betaSqFrame A a0) *
          (A / (4 * u * (1 - u)) * v 2 ^ 2 + A * u * (1 - u) * v 4 ^ 2) := by
  simp only [frameQ, frameZ, alphaSqFrame, betaSqFrame, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons,
    Matrix.tail_cons]
