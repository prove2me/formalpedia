-- title:
--   Proof of Proposition 5.1, p. 485 — f(x^r) is nonincreasing; if not ↓ −∞, it has a finite limit, f(x^{r+1}) − f(x^r) → 0, and every cluster point z has f(z) ≤ lim f(x^r) < ∞
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3 and either C1 or C2, and let $\{x^r\}$ be a sequence generated by the BCD method (2)–(3) from $x^0\in\operatorname{dom}f$ with any choice of blocks. Then $f(x^{r+1})\le f(x^r)$ for all $r$. Moreover, if $\{f(x^r)\}$ does not decrease to $-\infty$, then $\{f(x^r)\}$ converges to a finite limit, $f(x^{r+1})-f(x^r)\to0$, and every cluster point $z$ of $\{x^r\}$ satisfies
--   $$f(z)\le\lim_{r\to\infty}f(x^r)<\infty,$$
--   so $z\in\operatorname{dom}f$.
--
--   This is the opening step of the proof of Proposition 5.1: it separates the two alternatives of the proposition and places every cluster point in the effective domain.
--
--   **Formalization Note.** The limit of the nonincreasing sequence is written as its infimum in the extended reals. "Does not decrease to $-\infty$" is the negation of convergence to $-\infty$. The differences $f(x^{r+1})-f(x^r)$ are taken between real numbers (`toReal`), which is exact here because every $f(x^r)$ is finite: $f(x^r)\le f(x^0)<\infty$ and $f>-\infty$. Blocks are 0-based; $f_0,f_k$ never take the value $-\infty$.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), p. 485, proof of Proposition 5.1, first paragraph

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem values_antitone_clusterPt_mem_dom {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (s : ℕ → Fin N) (x : ℕ → TsengBCD.Stationary.X n) (hrun : TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x) :
    Antitone (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) ∧
      (¬ Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 ⊥) →
        (⨅ r, TsengBCD.Stationary.fSum f0 fk (x r)) ≠ ⊥ ∧
        Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 (⨅ r, TsengBCD.Stationary.fSum f0 fk (x r))) ∧
        Tendsto (fun r => (TsengBCD.Stationary.fSum f0 fk (x (r + 1))).toReal - (TsengBCD.Stationary.fSum f0 fk (x r)).toReal) atTop (𝓝 0) ∧
        ∀ z, MapClusterPt z atTop x →
          TsengBCD.Stationary.fSum f0 fk z ≤ ⨅ r, TsengBCD.Stationary.fSum f0 fk (x r) ∧ TsengBCD.Stationary.fSum f0 fk z ≠ ⊤) := by sorry

end TsengBCD.Hemivariate
