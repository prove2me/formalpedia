theorem NLogN.GL.scaleP_all (M : MulSpec) (cN : Fin HS) (hcN : IsCnt cN) (k m Q N : ℕ) (s : IState HS)
    (u : List ℤ) (R LN LS : List Item) (hU : s.G gD = ints u ++ R) (hl : u.length = N)
    (hN : s.G cN = .int N :: LN) (hS : s.G gPS = .int (2 ^ k) :: LS)
    (hub : ∀ x ∈ u, zsz x ≤ m) (hQ : m + k + 1 ≤ Q) (hNQ : zsz ((2 * N : ℕ) : ℤ) ≤ Q) :
    (scaleP cN).run s = s.upd gD (gints (u.map (scaleF k)) ++ R) ∧
    (scaleP cN).ok M s ∧
