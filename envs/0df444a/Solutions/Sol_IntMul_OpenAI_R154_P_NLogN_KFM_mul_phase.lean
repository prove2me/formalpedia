theorem toC_gconj (z : GI) : toC (NLogN.KFM.gconj z) = starRingEnd ℂ (toC z) := by
  apply Complex.ext <;> simp [toC, NLogN.KFM.gconj]

theorem RepPad.conj {p : ℕ} {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    {zs : List GI} {u : ((i : Fin d) → ZMod (s i)) → ℂ} (h : RepPad p s t zs u) :
    RepPad p s t (zs.map NLogN.KFM.gconj) (cnj u) := by
  have hg0 : NLogN.KFM.gconj 0 = 0 := rfl
  obtain ⟨⟨hl, hz⟩, rfl⟩ := (repPad_iff hst u).1 h
  refine (repPad_iff hst _).2 ⟨⟨by simp [hl], padZ_map NLogN.KFM.gconj hg0 hz⟩, ?_⟩
  funext k
  rw [funP_map p s t NLogN.KFM.gconj hg0, NLogN.KFM.toC_gconj, cnj, funP, map_div₀, map_pow, map_ofNat]

/-- The pointwise product `Q_p(u · v)` on the numerators. -/
theorem toC_gmulT (p : ℕ) (z w : GI) :
    toC (gmulT p z w) / 2 ^ p = Butterfly.Qp p ((toC z / 2 ^ p) * (toC w / 2 ^ p)) := by
  have e : (toC z / 2 ^ p) * (toC w / 2 ^ p) = toC (gmul z w) / 2 ^ (p + p) := by
    rw [toC_gmul, pow_add]; field_simp
  rw [e, KFH.Qp_toC p p, gmulT_eq]

theorem gmulT_zero (p : ℕ) (w : GI) : gmulT p 0 w = 0 := by
  simp [gmulT]

theorem RepPad.gmul {p : ℕ} {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    {zs ws : List GI} {u v : ((i : Fin d) → ZMod (s i)) → ℂ} (hu : RepPad p s t zs u)
    (hv : RepPad p s t ws v) :
    RepPad p s t (List.zipWith (gmulT p) zs ws) (QA p (u * v)) := by
  obtain ⟨⟨hl, hz⟩, rfl⟩ := (repPad_iff hst u).1 hu
  obtain ⟨⟨hl', hz'⟩, rfl⟩ := (repPad_iff hst v).1 hv
  have hget : ∀ x < (List.ofFn t).prod,
      (List.zipWith (gmulT p) zs ws).getD x 0 = gmulT p (zs.getD x 0) (ws.getD x 0) := by
    intro x hx
    rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_zipWith,
      List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)]
  refine (repPad_iff hst _).2 ⟨⟨by simp [hl, hl'], fun x hx hn => ?_⟩, ?_⟩
  · rw [hget x hx, hz x hx hn, gmulT_zero]
  · funext k
    have hx := encode_lt (valid_kL hst k)
    simp only [QA, Pi.mul_apply, funP]
    rw [hget _ hx, NLogN.KFM.toC_gmulT]

end

