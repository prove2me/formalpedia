  intro i j hij
  obtain ⟨_, _, hdvr, hmax, -, -, -, -⟩ := TypeDensity.unramified_is_dvr O Φ hΦ
  have hBm : (TypeDensity.monicPolyO b).Monic := (TypeDensity.monic_poly_reconstruct (AdjoinRoot Φ) r b).1
  refine TypeDensity.coprime_of_coprime_residue_dvr (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ)) _ _
