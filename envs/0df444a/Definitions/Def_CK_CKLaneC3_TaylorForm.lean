  have h1 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d2 (ys + u * (y - ys)) * (y - ys) ^ 1)
      (j.d3 (ys + u * (y - ys)) * (y - ys) ^ (1 + 1)) u := by
