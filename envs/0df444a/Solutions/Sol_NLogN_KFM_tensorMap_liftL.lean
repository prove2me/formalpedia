variable (a : Fin d → ℕ) (K : Fin d → ℕ → ℕ → ℂ) (A : Fin d → (ℕ → ℂ) → (ℕ → ℂ))

lemma mem_boxF {l : List (Fin d)} {j m : Fin d → ℕ} :
    m ∈ boxF a l j ↔ ∀ i, (i ∈ l → m i < a i) ∧ (i ∉ l → m i = j i) := by
  simp only [boxF, Fintype.mem_piFinset]
  refine forall_congr' fun i => ?_
  by_cases h : i ∈ l <;> simp [h]

theorem sliceComp_sum (hA : ∀ i x m, A i x m = ∑ n ∈ range (a i), K i m n * x n) :
    ∀ (l : List (Fin d)), l.Nodup → ∀ (x : (Fin d → ℕ) → ℂ) (j : Fin d → ℕ),
      sliceComp A l x j = ∑ m ∈ boxF a l j, (∏ i ∈ l.toFinset, K i (j i) (m i)) * x m
  | [], _, x, j => by
    simp only [sliceComp, id, List.toFinset_nil, prod_empty, one_mul]
    have : boxF a [] j = {j} := by
      ext m
      rw [mem_boxF, mem_singleton]
      constructor
      · intro h; funext i; exact (h i).2 (List.not_mem_nil)
      · intro h i; subst h; exact ⟨fun hi => absurd hi List.not_mem_nil, fun _ => rfl⟩
    rw [this, sum_singleton]
  | i :: l, hnd, x, j => by
    rw [List.nodup_cons] at hnd
    obtain ⟨hil, hnd⟩ := hnd
    simp only [sliceComp, Function.comp]
    rw [sliceComp_sum hA l hnd]
    -- expand the first slice map
    have hy : ∀ m ∈ boxF a l j, sliceMap i (A i) x m =
        ∑ n ∈ range (a i), K i (j i) n * x (Function.update m i n) := by
      intro m hm
      have hmi : m i = j i := ((mem_boxF a).1 hm i).2 hil
      simp only [sliceMap, hA, hmi]
    rw [Finset.sum_congr rfl (fun m hm => by rw [hy m hm])]
    simp only [Finset.mul_sum]
    rw [← Finset.sum_product']
    refine Finset.sum_nbij' (fun q => Function.update q.1 i q.2)
      (fun m => (Function.update m i (j i), m i)) ?_ ?_ ?_ ?_ ?_
    · rintro ⟨m, n⟩ hq
      rw [mem_product] at hq
      obtain ⟨hm, hn⟩ := hq
      rw [mem_range] at hn
      rw [mem_boxF]
      intro k
      by_cases hk : k = i
      · subst hk; simp [hn]
      · rw [Function.update_of_ne hk]
        have := (mem_boxF a).1 hm k
        simp only [List.mem_cons, hk, false_or]
        exact this
    · intro m hm
      rw [mem_boxF] at hm
      rw [mem_product, mem_range, mem_boxF]
      dsimp only
      refine ⟨fun k => ?_, (hm i).1 (by simp)⟩
      by_cases hk : k = i
      · subst hk; simp [hil]
      · rw [Function.update_of_ne hk]
        have := hm k
        simp only [List.mem_cons, hk, false_or] at this
        exact this
    · rintro ⟨m, n⟩ hq
      rw [mem_product] at hq
      have hmi : m i = j i := ((mem_boxF a).1 hq.1 i).2 hil
      simp only [Function.update_idem, Function.update_self, Prod.mk.injEq, and_true]
      rw [← hmi, Function.update_eq_self]
    · intro m _
      simp
    · rintro ⟨m, n⟩ hq
      rw [mem_product] at hq
      simp only [List.toFinset_cons]
      rw [Finset.prod_insert (by simpa using hil), Function.update_self]
      have e : ∏ k ∈ l.toFinset, K k (j k) (Function.update m i n k) =
          ∏ k ∈ l.toFinset, K k (j k) (m k) := by
        refine Finset.prod_congr rfl fun k hk => ?_
        have hk' : k ≠ i := fun h => hil (h ▸ List.mem_toFinset.1 hk)
        rw [Function.update_of_ne hk']
