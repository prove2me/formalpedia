lemma enqueue_empty_eval (b : Core) (B N : ℕ) (K : ℝ) (state : State b) (e : Edge b) (g : Machine) (s : Data)
    (h : Image b B K state s) (hs : CoreSource.Image B (CoreMemory.sourceRecord b B) N g s)
    (hB : b.input.n ≤ B) (hp : state.pending = []) (he : s.natReg 560 = CoreMemory.encodedEdge b e) :
