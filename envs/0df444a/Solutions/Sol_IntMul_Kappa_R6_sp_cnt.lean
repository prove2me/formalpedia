-- Source module: Solutions.KFMS0
/-!
# KFM S0: generic counted loops of register programs (`RS.rep`) for the setup arithmetic

The setup parameters (§9.2: `d, K, α, L, ℓ, r, s_i, μ_i, …`) are small numbers (`O(log n)` bits)
computed by register programs `RS` (nlogn `HReg`; `RS.code_runs` gives the IL run). This file
proves one generic loop lemma, so that every parameter program is a short instance:

* **`genLoop_run`**: `rep i n body` with `n = N`, where on the iteration-`k` state `lpSt … k c`
  (counter `N − k` on `i`, accumulator `c` on `a`) `body` only replaces the accumulator by
  `G k c`. The result is `accSeq G a0 N` on `a`; all else unchanged.
* **`genLoop_cost`**: cost `≤ (|n|+1)·10^7(B+2)² + N·(C + 4·10^7(B+2)² + 30) + 32` when each
  body run costs `≤ C`.
* Instances: **`sumSeq`** (`G k c = c + g (N − k)`, so the result is `a0 + Σ_{x=1}^{N} g x`,
  **`accSeq_sum`**) and **`satSq`** (`G k c = min(c², cap)`, `m` squarings give
  `min(x^{2^m}, cap)`, **`accSeq_satSq`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS

/-! ## Instances -/

theorem accSeq_sumG (g : ℕ → ℤ) (N a0 : ℤ) (N' : ℕ) :
    ∀ k ≤ N', accSeq (sumG g N') a0 k = a0 + ∑ j ∈ Finset.range k, g (N' - j)
  | 0, _ => by simp [accSeq]
  | k + 1, hk => by
    rw [accSeq, accSeq_sumG g N a0 N' k (by omega), Finset.sum_range_succ, sumG]; ring

theorem sum_Icc_eq_range (g : ℕ → ℤ) : ∀ N : ℕ,
    ∑ x ∈ Finset.Icc 1 N, g x = ∑ j ∈ Finset.range N, g (j + 1)
  | 0 => by simp
  | N + 1 => by
    rw [Finset.sum_Icc_succ_top (by omega), Finset.sum_range_succ, sum_Icc_eq_range g N]

/-- The full sum: `a0 + Σ_{x = 1}^{N} g x`. -/
theorem accSeq_sum (g : ℕ → ℤ) (a0 : ℤ) (N : ℕ) :
    accSeq (sumG g N) a0 N = a0 + ∑ x ∈ Finset.Icc 1 N, g x := by
  rw [accSeq_sumG g 0 a0 N N le_rfl, sum_Icc_eq_range]
  congr 1
  rw [← Finset.sum_range_reflect (fun j => g (j + 1)) N]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  simp only [Finset.mem_range] at hj
  congr 1; omega

end NLogN.KFM

end

