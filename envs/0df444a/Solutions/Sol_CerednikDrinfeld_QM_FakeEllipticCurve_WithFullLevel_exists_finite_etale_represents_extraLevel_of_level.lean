variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {N' : ℕ} {S : Type} [CommRing S]

theorem isFinite_ker (E : FakeEllipticCurve Λ N' S) (N : ℕ) (hN : IsUnit ((N : ℕ) : S)) :
    IsFinite (E.L.schemeKerStr N) :=
  (FakeEllipticCurve.isFinite_and_etale_schemeKerStr_of_isUnit E N hN).1
theorem etale_ker (E : FakeEllipticCurve Λ N' S) (N : ℕ) (hN : IsUnit ((N : ℕ) : S)) :
    Etale (E.L.schemeKerStr N) :=
  (FakeEllipticCurve.isFinite_and_etale_schemeKerStr_of_isUnit E N hN).2

theorem exists_geomPoint (s : ↥(Spec (CommRingCat.of S))) :
    ∃ (k : Type) (_ : Field k) (_ : IsAlgClosed k) (sk : S →+* k),
      Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k) = s := by
  let κ := s.asIdeal.ResidueField
  let k := AlgebraicClosure κ
  refine ⟨k, inferInstance, inferInstance, (algebraMap κ k).comp (algebraMap S κ), ?_⟩
  apply PrimeSpectrum.ext
  rw [Spec.map_apply]

  show Ideal.comap ((algebraMap κ k).comp (algebraMap S κ)) (IsLocalRing.closedPoint k).asIdeal = s.asIdeal
  have hbot : (IsLocalRing.closedPoint k).asIdeal = ⊥ :=
    IsLocalRing.isField_iff_maximalIdeal_eq.mp (Field.toIsField k)
  rw [hbot, ← RingHom.ker_eq_comap_bot]
  ext x
  rw [RingHom.mem_ker, RingHom.comp_apply, map_eq_zero_iff _ (algebraMap κ k).injective, ← RingHom.mem_ker,
    Ideal.ker_algebraMap_residueField]

theorem finrank_ker (E : FakeEllipticCurve Λ N' S) (N : ℕ) [NeZero N] (hN : IsUnit ((N : ℕ) : S))
    (s : ↥(Spec (CommRingCat.of S))) : (E.L.schemeKerStr N).finrank s = N ^ 4 := by
  obtain ⟨k, _, _, sk, hs⟩ := exists_geomPoint (S := S) s
  obtain ⟨E', g, hg, hmul, hact, hlev, hlev'⟩ := FakeEllipticCurve.exists_isPullback_levelIff sk E
  obtain ⟨gN, hgN, hgNι⟩ := RelativeGroupLaw.exists_isPullback_schemeKerStr_of_isPullback sk E.L E'.L g hg hmul N
  haveI : IsFinite (E.L.schemeKerStr N) := isFinite_ker E N hN
  haveI : Etale (E.L.schemeKerStr N) := etale_ker E N hN
  haveI : SmoothOfRelativeDimension 2 E'.f := FakeEllipticCurve.smoothOfRelativeDimension_two k E'
  have h4 := (RelativeGroupLaw.isFinite_schemeKerStr_and_finrank_eq_pow_and_finrank_schemeNsmul_eq_pow k E'.f E'.L
    E'.comm E'.bundle 2 N (NeZero.ne N)).2.1
  rw [← hs, ← Scheme.Hom.finrank_of_isPullback _ _ _ _ hgN, h4]

end rank
