variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem one_le_vol : ∀ (A : Shape), (∀ a ∈ A, 1 ≤ a) → 1 ≤ AModel.vol A
  | [], _ => by simp
  | a :: A, h => by
    rw [vol_cons]
    exact Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by have := h a (by simp); omega)
      (by have := one_le_vol A (fun b hb => h b (by simp [hb])); omega))

theorem bnd_pull {w : ℕ} (sh sh' : Shape) (g : List ℕ → List ℕ) {xs : List ℤ} (h : Bnd w xs) :
    Bnd w (AModel.pull sh sh' g 0 xs) := by
  intro a ha
  simp only [AModel.pull, List.mem_map, List.mem_range] at ha
