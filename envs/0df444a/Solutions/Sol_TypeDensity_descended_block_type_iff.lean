    have h1 := Polynomial.natDegree_pos_iff_degree_pos.mpr
        (Polynomial.degree_pos_of_irreducible hΦ.2)
    rwa [Polynomial.Monic.natDegree_map hΦ.1] at h1
  obtain ⟨hbij, hdesc, -, hdiv⟩ := TypeDensity.block_descent_bijection O Φ hΦ r
  set b := TypeDensity.selectBlock O Φ r a with hb_def
  have hb : b ∈ TypeDensity.blockCell O Φ r := hbij.mapsTo ha
  set B := TypeDensity.monicPolyO b with hB_def
  have hBm : B.Monic := (hdiv a ha).1
  have hBdvd : B ∣ (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) := (hdiv a ha).2
  -- translation
