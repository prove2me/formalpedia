theorem MeasureEquivalenceRigidity.tendsto_mean_along_real_roots
    (F : ℝ → ℝ) (hFle : ∀ b, F b ≤ 1)
    (hsmall : ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
      ∀ b : ℝ, |b| < δ → 1 - ε ≤ F b) (a : ℝ) :
    Tendsto (fun n : ℕ => F (a / ((n+1 : ℕ) : ℝ))) atTop (𝓝 1) := by sorry
