-- title:
--   (4.9), proof of Theorem 4.2, p. 8 — the Lagrangian gradient with λₖ₊₁, μₖ₊₁, vₖ, uₖ is at most εₖ
-- statement:
--   Let $\{x_k\}$ be generated by Algorithm 3.1 for problem (2.1), with $C^1$ data, and let $\lambda_{k+1}$, $\mu_{k+1}$ be the first-order multiplier estimates
--   $$[\lambda_{k+1}]_i=[\bar\lambda_k]_i+\rho_k[h_1(x_k)]_i,\qquad[\mu_{k+1}]_i=\max\{0,[\bar\mu_k]_i+\rho_k[g_1(x_k)]_i\}.$$
--   Then for every outer iteration $k\ge 1$ the vector
--   $$\delta_k=\nabla f(x_k)+\sum_{i=1}^{m_1}[\lambda_{k+1}]_i\nabla[h_1(x_k)]_i+\sum_{i=1}^{p_1}[\mu_{k+1}]_i\nabla[g_1(x_k)]_i+\sum_{i=1}^{m_2}[v_k]_i\nabla[h_2(x_k)]_i+\sum_{j=1}^{p_2}[u_k]_j\nabla[g_2(x_k)]_j$$
--   satisfies $\|\delta_k\|\le\varepsilon_k$, and moreover $u_k\ge 0$ and $\mu_{k+1}\ge 0$ componentwise.
--
--   This identifies the residual of the subproblem's stopping test (3.1) with the residual of the KKT conditions of the original problem (2.1), with $\lambda_{k+1}$, $\mu_{k+1}$, $v_k$, $u_k$ as approximate multipliers. It is the first step of the proof of Theorem 4.2.
--
--   **Formalization Note.** The page writes "for all $k\in\mathbb N$"; the statement is for the outer iterations $k\ge 1$, where Step 2 defines $x_k$. The existence of $\delta_k$ with $\|\delta_k\|\le\varepsilon_k$ is written as the norm bound on the left-hand side itself. The norm is the Euclidean norm of $\mathbb R^n$.
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, p. 8, proof of Theorem 4.2, (4.9)

import Mathlib
import Definitions.Def_AugLagLLC_KKT_Setting

namespace AugLagLLC.KKT

open Filter Topology

/-- (4.9), proof of Theorem 4.2, p. 8: at every outer iteration `k ≥ 1` of a run of
Algorithm 3.1, the gradient of the Lagrangian of (2.1) at `xₖ` with the multiplier estimates
`λₖ₊₁` (3.5), `μₖ₊₁` (3.7), `vₖ`, `uₖ` has Euclidean norm at most `εₖ`; moreover `uₖ ≥ 0` and
`μₖ₊₁ ≥ 0`. -/
theorem eq_4_9 {n m1 p1 m2 p2 : ℕ} (P : Problem n m1 p1 m2 p2) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin p1 → ℝ} {ε : ℕ → ℝ}
    (hpar : Problem.IsParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin p1 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin p2 → ℝ}
    (hrun : P.IsRun τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    (k : ℕ) (hk : 1 ≤ k) :
    ‖gradient P.f (x k)
        + ∑ i, P.lamNext x ρ lamBar k i • gradient (P.h1 i) (x k)
        + ∑ i, P.muNext x ρ muBar k i • gradient (P.g1 i) (x k)
        + ∑ i, v k i • gradient (P.h2 i) (x k)
        + ∑ j, u k j • gradient (P.g2 j) (x k)‖ ≤ ε k ∧
      (∀ j, 0 ≤ u k j) ∧ (∀ i, 0 ≤ P.muNext x ρ muBar k i) := by sorry

end AugLagLLC.KKT
