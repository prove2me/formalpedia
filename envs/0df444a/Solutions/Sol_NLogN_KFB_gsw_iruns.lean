    simp only [V, vol_append, vol_cons]
  have hle : ∀ x : ℕ, x ≤ V → zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (zsz_nat_le hx) hV
  have hBq : vol (B ++ [q]) = vol B * q := by simp [vol_append, vol]
  have hqC : vol ([q] ++ Cs) = q * vol Cs := by simp [vol_append, vol]
  have hBq1 : 1 ≤ vol (B ++ [q]) := by rw [hBq]; exact Nat.mul_pos hB hq
  have hqC1 : 1 ≤ vol ([q] ++ Cs) := by rw [hqC]; exact Nat.mul_pos hq hC
