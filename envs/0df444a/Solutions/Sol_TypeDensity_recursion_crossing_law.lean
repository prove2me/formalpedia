theorem solution (U : TypeDensity.SurfaceUniverse) (i : U.ι) (a b c h : ℕ)
    (hs : (U.M i).s = TypeDensity.State.crossing a b c h)
    (hIH : ∀ i' : U.ι, (U.M i').s.rank < (U.M i).s.rank → U.LawStatement i') :
    U.LawStatement i := by
  have hnt : (U.M i).s.terminal = false := by rw [hs]; rfl
  have hv : (U.M i).s.Valid := (U.M i).valid
  have h560 := (TypeDensity.single_state_return_chain U i hnt)
  have h551 := (TypeDensity.state_law_unfold _ hv hnt).2 a b c h hs
  refine ⟨fun σ => ?_, ?_, ?_⟩
  · have e := ((h560 σ).2 a b c h hs).1
    obtain ⟨m, nn, ms⟩ := TypeDensity.exit_event_zero_mass U i hnt hIH σ
    rw [e, h551]
    exact ⟨ms, nn, m⟩
  · have e := ((h560 (default)).2 a b c h hs).2
    rw [e]
    exact (TypeDensity.recursion_events_measurable U i hnt hIH i rfl 0 default).2.2.1
  · exact MeasureTheory.measure_mono_null
      ((TypeDensity.nonterminating_subset_return_or_bad U i hnt).2 a b c h hs)
      (TypeDensity.bad_exit_null U i hnt hIH 0 i rfl)
