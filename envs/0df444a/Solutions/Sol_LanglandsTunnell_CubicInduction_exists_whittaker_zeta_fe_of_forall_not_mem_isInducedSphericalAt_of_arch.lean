section

private def finPlace (v : HeightOneSpectrum (𝓞 ℚ)) : (v.adicCompletion ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ :=
  (Units.map (finIncl (𝓞 ℚ) ℚ)).comp (localUnit (𝓞 ℚ) ℚ v)

private def archPart : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* (InfiniteAdeleRing ℚ)ˣ :=
  Units.map (RingHom.fst (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)).toMonoidHom

private theorem archPart_archIdeleHom (a : (InfiniteAdeleRing ℚ)ˣ) : archPart (archIdeleHom a) = a :=
  Units.ext rfl

private theorem archPart_finPlace
    (v : HeightOneSpectrum (𝓞 ℚ)) (u : (v.adicCompletion ℚ)ˣ) : archPart (finPlace v u) = 1 :=
  Units.ext rfl

private theorem finiteUnitsComponent_archIdeleHom (w : HeightOneSpectrum (𝓞 ℚ)) (a : (InfiniteAdeleRing ℚ)ˣ) :
    finiteUnitsComponent (𝓞 ℚ) ℚ w (archIdeleHom a) = 1 :=
  Units.ext rfl

private theorem finiteUnitsComponent_finPlace_self (v : HeightOneSpectrum (𝓞 ℚ)) (u : (v.adicCompletion ℚ)ˣ) :
    finiteUnitsComponent (𝓞 ℚ) ℚ v (finPlace v u) = u :=
  Units.ext (localUnit_apply_self (𝓞 ℚ) ℚ v u)

private theorem finiteUnitsComponent_finPlace_of_ne (v : HeightOneSpectrum (𝓞 ℚ)) (u : (v.adicCompletion ℚ)ˣ)
    {w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ≠ v) : finiteUnitsComponent (𝓞 ℚ) ℚ w (finPlace v u) = 1 :=
  Units.ext (localUnit_apply_of_ne (𝓞 ℚ) ℚ v u hw)

private theorem idele_ext' {a b : (AdeleRing (𝓞 ℚ) ℚ)ˣ} (h₁ : archPart a = archPart b)
    (h₂ : ∀ w : HeightOneSpectrum (𝓞 ℚ), finiteUnitsComponent (𝓞 ℚ) ℚ w a = finiteUnitsComponent (𝓞 ℚ) ℚ w b) :
    a = b :=
  Units.ext (Prod.ext (congrArg Units.val h₁) (Subtype.ext (funext fun w => congrArg Units.val (h₂ w))))

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))

private def embHom : TorusProduct T →* (AdeleRing (𝓞 ℚ) ℚ)ˣ where
  toFun t := archIdeleHom t.2 * ∏ v : T, finPlace v (t.1 v)
  map_one' := by simp
  map_mul' s t := by
    simp only [Prod.fst_mul, Prod.snd_mul, Pi.mul_apply, map_mul, Finset.prod_mul_distrib]
    exact mul_mul_mul_comm _ _ _ _

private theorem embHom_apply (t : TorusProduct T) : embHom T t = archIdeleHom t.2 * ∏ v : T, finPlace v (t.1 v) := rfl

private theorem archPart_embHom (t : TorusProduct T) : archPart (embHom T t) = t.2 := by
  simp [embHom_apply, map_prod, archPart_archIdeleHom, archPart_finPlace]

private theorem finiteUnitsComponent_embHom_of_mem (t : TorusProduct T) (v : T) :
    finiteUnitsComponent (𝓞 ℚ) ℚ v (embHom T t) = t.1 v := by
  classical
  rw [embHom_apply, map_mul, finiteUnitsComponent_archIdeleHom, one_mul, map_prod,
    Finset.prod_eq_single v (fun w _ hwv => ?_) (fun h => (h (Finset.mem_univ v)).elim),
    finiteUnitsComponent_finPlace_self]
  exact finiteUnitsComponent_finPlace_of_ne _ _ (Subtype.val_injective.ne hwv).symm

private theorem finiteUnitsComponent_embHom_of_not_mem
    (t : TorusProduct T) {w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ∉ T) :
    finiteUnitsComponent (𝓞 ℚ) ℚ w (embHom T t) = 1 := by
  rw [embHom_apply, map_mul, finiteUnitsComponent_archIdeleHom, one_mul, map_prod]
  exact Finset.prod_eq_one fun v _ =>
    finiteUnitsComponent_finPlace_of_ne _ _ fun h => hw (h ▸ v.2)

private def coords (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : TorusProduct T :=
  (fun v : T => finiteUnitsComponent (𝓞 ℚ) ℚ v a, archPart a)

private theorem coords_leftInverse : Function.LeftInverse (coords T) (embHom T) := fun t =>
  Prod.ext (funext fun v => finiteUnitsComponent_embHom_of_mem T t v) (archPart_embHom T t)

private theorem coords_embHom (t : TorusProduct T) : coords T (embHom T t) = t :=
  coords_leftInverse T t

private theorem embHom_injective : Function.Injective (embHom T) :=
  (coords_leftInverse T).injective

private theorem partAt_eq_embHom_coords (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : partAt ℚ T a = embHom T (coords T a) := by
  refine idele_ext' (Units.ext ?_) fun w => ?_
  · exact (partAt_fst ℚ T a).trans (congrArg Units.val (archPart_embHom T (coords T a))).symm
  · by_cases hw : w ∈ T
    · rw [finiteUnitsComponent_embHom_of_mem T _ ⟨w, hw⟩]
      exact Units.ext (partAt_snd_of_mem ℚ T a hw)
    · rw [finiteUnitsComponent_embHom_of_not_mem T _ hw]
      exact Units.ext (partAt_snd_of_not_mem ℚ T a hw)

private theorem partAt_mem_range (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : partAt ℚ T a ∈ Set.range (embHom T) :=
  ⟨coords T a, (partAt_eq_embHom_coords T a).symm⟩

private theorem partAt_embHom (t : TorusProduct T) : partAt ℚ T (embHom T t) = embHom T t := by
  rw [partAt_eq_embHom_coords, coords_embHom]

private theorem partAt_embHom_mul (t : TorusProduct T) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    partAt ℚ T (embHom T t * a) = embHom T t * partAt ℚ T a := by
  rw [map_mul, partAt_embHom]

private theorem embHom_mem_unitIdelesOutside (t : TorusProduct T) :
    embHom T t ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))) := by
  rw [NumberField.AdeleRing.mem_unitIdelesOutside_iff, IsDedekindDomain.FiniteAdeleRing.mem_unitIdelesOutside_iff]
  intro v hv
  have h1 : finiteUnitsComponent (𝓞 ℚ) ℚ v (embHom T t) = 1 := finiteUnitsComponent_embHom_of_not_mem T t hv
  have h2 : finiteUnitsComponent (𝓞 ℚ) ℚ v (embHom T t)⁻¹ = 1 := by rw [map_inv, h1, inv_one]
  constructor
  · change ((embHom T t : AdeleRing (𝓞 ℚ) ℚ)).2 v ∈ _
    rw [show ((embHom T t : AdeleRing (𝓞 ℚ) ℚ)).2 v = 1 from congrArg Units.val h1]
    exact one_mem _
  · change (((embHom T t)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 v ∈ _
    rw [show (((embHom T t)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 v = 1 from congrArg Units.val h2]
    exact one_mem _

end

section

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))

private theorem localUnit_val_eq (v : HeightOneSpectrum (𝓞 ℚ)) (u : (v.adicCompletion ℚ)ˣ) :
    ((localUnit (𝓞 ℚ) ℚ v u : (FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : FiniteAdeleRing (𝓞 ℚ) ℚ) =
      finAdeleSingleAt ℚ v ((u : v.adicCompletion ℚ) - 1) + 1 := by
  classical
  refine Subtype.ext (funext fun w => ?_)
  change Function.update (1 : ∀ w : HeightOneSpectrum (𝓞 ℚ), w.adicCompletion ℚ) v (u : v.adicCompletion ℚ) w =
    finAdeleSingleAt ℚ v ((u : v.adicCompletion ℚ) - 1) w + 1
  by_cases hw : w = v
  · subst hw
    rw [Function.update_self, finAdeleSingleAt_apply_self, sub_add_cancel]
  · rw [Function.update_of_ne hw, finAdeleSingleAt_apply_of_ne ℚ v _ hw, zero_add]
    rfl

private theorem continuous_finIncl : Continuous (finIncl (𝓞 ℚ) ℚ) :=
  continuous_const.prodMk continuous_id

private theorem continuous_finPlace (v : HeightOneSpectrum (𝓞 ℚ)) : Continuous (finPlace v) := by
  have hval : Continuous fun u : (v.adicCompletion ℚ)ˣ =>
      ((localUnit (𝓞 ℚ) ℚ v u : (FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : FiniteAdeleRing (𝓞 ℚ) ℚ) := by
    simp only [localUnit_val_eq]
    exact ((continuous_finAdeleSingleAt ℚ v).comp (Units.continuous_val.sub continuous_const)).add continuous_const
  refine Units.continuous_iff.mpr ⟨continuous_finIncl.comp hval, ?_⟩
  have h : (fun u : (v.adicCompletion ℚ)ˣ => (((finPlace v u)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ)) =
      fun u => finIncl (𝓞 ℚ) ℚ ((localUnit (𝓞 ℚ) ℚ v u⁻¹ : (FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : FiniteAdeleRing (𝓞 ℚ) ℚ) :=
    funext fun u => by rw [← map_inv]; rfl
  rw [h]
  exact continuous_finIncl.comp (hval.comp continuous_inv)

private theorem continuous_embHom : Continuous (embHom T) := by
  change Continuous fun t : TorusProduct T => archIdeleHom t.2 * ∏ v : T, finPlace v (t.1 v)
  exact (continuous_archIdeleHom.comp continuous_snd).mul
    (continuous_finsetProd _ fun v _ => (continuous_finPlace v).comp ((continuous_apply v).comp continuous_fst))

private theorem continuous_archPart : Continuous archPart := by
  refine Units.continuous_iff.mpr ⟨continuous_fst.comp Units.continuous_val, ?_⟩
  have h : (fun a : (AdeleRing (𝓞 ℚ) ℚ)ˣ => ((archPart a)⁻¹ : (InfiniteAdeleRing ℚ)ˣ).val) =
      fun a => ((a⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 :=
    funext fun a => by rw [← map_inv]; rfl
  rw [h]
  exact continuous_fst.comp Units.continuous_coe_inv

private theorem continuous_finiteUnitsComponent (w : HeightOneSpectrum (𝓞 ℚ)) :
    Continuous (finiteUnitsComponent (𝓞 ℚ) ℚ w) := by
  have heval : Continuous fun x : FiniteAdeleRing (𝓞 ℚ) ℚ => x w := RestrictedProduct.continuous_eval w
  refine Units.continuous_iff.mpr ⟨heval.comp (continuous_snd.comp Units.continuous_val), ?_⟩
  have h : (fun a : (AdeleRing (𝓞 ℚ) ℚ)ˣ => ((finiteUnitsComponent (𝓞 ℚ) ℚ w a)⁻¹ : (w.adicCompletion ℚ)ˣ).val) =
      fun a => ((a⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 w :=
    funext fun a => by rw [← map_inv]; rfl
  rw [h]
  exact heval.comp (continuous_snd.comp Units.continuous_coe_inv)

private theorem continuous_coords : Continuous (coords T) := by
  unfold coords
  exact (continuous_pi fun v : T => continuous_finiteUnitsComponent (v : HeightOneSpectrum (𝓞 ℚ))).prodMk
    continuous_archPart

private theorem isClosedEmbedding_embHom : Topology.IsClosedEmbedding (embHom T) :=
  (coords_leftInverse T).isClosedEmbedding (continuous_coords T) (continuous_embHom T)

private def integralUnitSet : Set (AdeleRing (𝓞 ℚ) ℚ)ˣ :=
  Units.embedProduct (AdeleRing (𝓞 ℚ) ℚ) ⁻¹'
    ((({1} : Set (InfiniteAdeleRing ℚ)) ×ˢ integralFiniteAdeles (𝓞 ℚ) ℚ) ×ˢ
      (MulOpposite.op '' (({1} : Set (InfiniteAdeleRing ℚ)) ×ˢ integralFiniteAdeles (𝓞 ℚ) ℚ)))

private theorem isCompact_integralUnitSet : IsCompact integralUnitSet := by
  have hA : IsCompact ((({1} : Set (InfiniteAdeleRing ℚ)) ×ˢ integralFiniteAdeles (𝓞 ℚ) ℚ)) :=
    isCompact_singleton.prod (AdelicLevel.isCompact_integralFiniteAdeles (𝓞 ℚ) ℚ)
  exact Units.isClosedEmbedding_embedProduct.isCompact_preimage (hA.prod (hA.image MulOpposite.continuous_op))

private theorem unitPart_mem_integralUnitSet (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : unitPart ℚ T a ∈ integralUnitSet := by
  have hmem := finitePartUnits_unitPart_mem_unitIdeles ℚ T a
  rw [IsDedekindDomain.FiniteAdeleRing.mem_unitIdeles_iff] at hmem
  have hfst : ((unitPart ℚ T a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 = 1 := unitPart_fst ℚ T a
  have hfst' : (((unitPart ℚ T a)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 = 1 := by
    have h : (((unitPart ℚ T a)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 *
        ((unitPart ℚ T a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 = 1 :=
      congrArg Prod.fst (Units.inv_mul (unitPart ℚ T a))
    rwa [hfst, mul_one] at h
  have hsnd : ((unitPart ℚ T a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 ∈ integralFiniteAdeles (𝓞 ℚ) ℚ :=
    fun v => by simpa using hmem.1 v
  have hsnd' : (((unitPart ℚ T a)⁻¹ : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 ∈ integralFiniteAdeles (𝓞 ℚ) ℚ :=
    fun v => by have h := hmem.2 v; rwa [← map_inv, val_finitePartUnits] at h
  refine Set.mem_preimage.mpr (Set.mem_prod.mpr ⟨Set.mem_prod.mpr ⟨hfst, hsnd⟩, ?_⟩)
  exact ⟨_, Set.mem_prod.mpr ⟨hfst', hsnd'⟩, rfl⟩

private theorem mem_mul_image_of_mem {a : (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (ha : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))))
    {B : Set (AdeleRing (𝓞 ℚ) ℚ)ˣ} (hB : partAt ℚ T a ∈ B) :
    a ∈ (fun p : (AdeleRing (𝓞 ℚ) ℚ)ˣ × (AdeleRing (𝓞 ℚ) ℚ)ˣ => p.1 * p.2) '' (B ×ˢ integralUnitSet) := by
  have ha' : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ
      ((↑T : Set (HeightOneSpectrum (𝓞 ℚ))) ∪ {v | v ∈ ([] : List (HeightOneSpectrum (𝓞 ℚ)))}) := by
    rw [NumberField.AdeleRing.mem_unitIdelesOutside_iff,
      IsDedekindDomain.FiniteAdeleRing.mem_unitIdelesOutside_iff] at ha ⊢
    exact fun v hv => ha v fun h => hv (Set.mem_union_left _ h)
  have hdec := eq_partAt_mul_prod_mul_unitPart ℚ T [] (fun v hv => (List.not_mem_nil hv).elim) List.nodup_nil a ha'
  simp only [List.map_nil, List.prod_nil, mul_one] at hdec
  exact ⟨(partAt ℚ T a, unitPart ℚ T a), Set.mem_prod.mpr ⟨hB, unitPart_mem_integralUnitSet T a⟩, hdec.symm⟩

end

section

open MeasureTheory

attribute [local instance] ideleBorel borelSpace_ideleBorel isHaarMeasure_idelicHaar

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))

private theorem map_embHom_mul_sPartMeasure (t : TorusProduct T) :
    Measure.map (fun a => embHom T t * a) (sPartMeasure ℚ T) = sPartMeasure ℚ T := by
  have hU : MeasurableSet (NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))) :
      Set (AdeleRing (𝓞 ℚ) ℚ)ˣ) := (isOpen_unitIdelesOutside ℚ _).measurableSet
  have hpre : (fun a => embHom T t * a) ⁻¹'
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))) :
        Set (AdeleRing (𝓞 ℚ) ℚ)ˣ) =
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))) :
        Set (AdeleRing (𝓞 ℚ) ℚ)ˣ) :=
    Set.ext fun a => Subgroup.mul_mem_cancel_left _ (embHom_mem_unitIdelesOutside T t)
  have hcomp : (fun a => embHom T t * a) ∘ partAt ℚ T = partAt ℚ T ∘ fun a => embHom T t * a :=
    funext fun a => (partAt_embHom_mul T t a).symm
  rw [sPartMeasure, Measure.map_map (measurable_const_mul _) (measurable_partAt ℚ T), hcomp,
    ← Measure.map_map (measurable_partAt ℚ T) (measurable_const_mul _)]
  congr 1
  conv_lhs => rw [← hpre]
  rw [← Measure.restrict_map (measurable_const_mul _) hU, map_mul_left_eq_self]

private theorem sPartMeasure_preimage_embHom_mul
    (t : TorusProduct T) {B : Set (AdeleRing (𝓞 ℚ) ℚ)ˣ} (hB : MeasurableSet B) :
    sPartMeasure ℚ T ((fun a => embHom T t * a) ⁻¹' B) = sPartMeasure ℚ T B := by
  rw [← Measure.map_apply (measurable_const_mul _) hB, map_embHom_mul_sPartMeasure]

private theorem image_embHom_preimage_mul (g : TorusProduct T) (s : Set (TorusProduct T)) :
    embHom T '' ((fun x => g * x) ⁻¹' s) = (fun a => embHom T g * a) ⁻¹' (embHom T '' s) := by
  ext x
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨g * a, ha, map_mul (embHom T) g a⟩
  · rintro ⟨b, hb, hx⟩
    refine ⟨g⁻¹ * b, ?_, ?_⟩
    · show g * (g⁻¹ * b) ∈ s
      rwa [mul_inv_cancel_left]
    · rw [map_mul (embHom T), map_inv (embHom T), hx, inv_mul_cancel_left]

variable [∀ v : HeightOneSpectrum (𝓞 ℚ), MeasurableSpace (v.adicCompletion ℚ)ˣ]
  [∀ v : HeightOneSpectrum (𝓞 ℚ), BorelSpace (v.adicCompletion ℚ)ˣ]
  [∀ v : HeightOneSpectrum (𝓞 ℚ), SecondCountableTopology (v.adicCompletion ℚ)ˣ]
  [MeasurableSpace (InfiniteAdeleRing ℚ)ˣ] [BorelSpace (InfiniteAdeleRing ℚ)ˣ]
  [SecondCountableTopology (InfiniteAdeleRing ℚ)ˣ]

private theorem measurableEmbedding_embHom : MeasurableEmbedding (embHom T) :=
  (isClosedEmbedding_embHom T).measurableEmbedding

private theorem sPartMeasure_compl_range : sPartMeasure ℚ T (Set.range (embHom T))ᶜ = 0 := by
  rw [sPartMeasure, Measure.map_apply (measurable_partAt ℚ T) (measurableEmbedding_embHom T).measurableSet_range.compl]
  have h : partAt ℚ T ⁻¹' (Set.range (embHom T))ᶜ = ∅ :=
    Set.eq_empty_of_forall_notMem fun a ha => ha (partAt_mem_range T a)
  rw [h, measure_empty]

private def pulledBack : Measure (TorusProduct T) :=
  Measure.comap (embHom T) (sPartMeasure ℚ T)

private theorem pulledBack_apply (s : Set (TorusProduct T)) : pulledBack T s = sPartMeasure ℚ T (embHom T '' s) :=
  (measurableEmbedding_embHom T).comap_apply _ _

private theorem map_embHom_pulledBack : Measure.map (embHom T) (pulledBack T) = sPartMeasure ℚ T := by
  rw [pulledBack, (measurableEmbedding_embHom T).map_comap]
  exact Measure.restrict_eq_self_of_ae_mem (ae_iff.mpr (sPartMeasure_compl_range T))

private scoped instance isMulLeftInvariant_pulledBack : (pulledBack T).IsMulLeftInvariant := by
  refine ⟨fun g => Measure.ext fun s hs => ?_⟩
  rw [Measure.map_apply (measurable_const_mul g) hs, pulledBack_apply, pulledBack_apply, image_embHom_preimage_mul,
    sPartMeasure_preimage_embHom_mul T g ((measurableEmbedding_embHom T).measurableSet_image.mpr hs)]

private scoped instance isFiniteMeasureOnCompacts_pulledBack : IsFiniteMeasureOnCompacts (pulledBack T) := by
  refine ⟨fun K hK => ?_⟩
  have hKi : IsCompact (embHom T '' K) := hK.image (continuous_embHom T)
  have hbig : IsCompact ((fun p : (AdeleRing (𝓞 ℚ) ℚ)ˣ × (AdeleRing (𝓞 ℚ) ℚ)ˣ => p.1 * p.2) ''
      ((embHom T '' K) ×ˢ integralUnitSet)) :=
    (hKi.prod isCompact_integralUnitSet).image continuous_mul
  rw [pulledBack_apply, sPartMeasure, Measure.map_apply (measurable_partAt ℚ T) hKi.isClosed.measurableSet,
    Measure.restrict_apply' (isOpen_unitIdelesOutside ℚ _).measurableSet]
  refine lt_of_le_of_lt (measure_mono fun a ha => ?_) hbig.measure_lt_top
  exact mem_mul_image_of_mem T ha.2 ha.1

variable (μ : ∀ v : HeightOneSpectrum (𝓞 ℚ), Measure (v.adicCompletion ℚ)ˣ) (μArch : Measure (InfiniteAdeleRing ℚ)ˣ)

private def torusMeasure : Measure (TorusProduct T) :=
  (Measure.pi fun v : T => μ v).prod μArch

variable [∀ v, (μ v).IsHaarMeasure] [μArch.IsHaarMeasure]
  [∀ v : HeightOneSpectrum (𝓞 ℚ), LocallyCompactSpace (v.adicCompletion ℚ)ˣ]
  [LocallyCompactSpace (InfiniteAdeleRing ℚ)ˣ]

private scoped instance isHaarMeasure_torusMeasure : (torusMeasure T μ μArch).IsHaarMeasure := by
  unfold torusMeasure
  infer_instance

private theorem exists_sPartMeasure_eq_smul_map :
    ∃ r : ℝ≥0, 0 < r ∧ sPartMeasure ℚ T = r • Measure.map (embHom T) (torusMeasure T μ μArch) := by
  have h : pulledBack T = Measure.haarScalarFactor (pulledBack T) (torusMeasure T μ μArch) • torusMeasure T μ μArch :=
    Measure.isMulLeftInvariant_eq_smul (pulledBack T) (torusMeasure T μ μArch)
  have hmain : sPartMeasure ℚ T =
      Measure.haarScalarFactor (pulledBack T) (torusMeasure T μ μArch) •
        Measure.map (embHom T) (torusMeasure T μ μArch) := by
    conv_lhs => rw [← map_embHom_pulledBack T, h]
    rw [Measure.map_smul]
  refine ⟨_, pos_iff_ne_zero.mpr fun hr => sPartMeasure_ne_zero ℚ T ?_, hmain⟩
  rw [hmain, hr, zero_smul]

end

section

open MeasureTheory

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
variable [∀ v : HeightOneSpectrum (𝓞 ℚ), MeasurableSpace (v.adicCompletion ℚ)ˣ]
  [MeasurableSpace (InfiniteAdeleRing ℚ)ˣ]
variable (μ : ∀ v : HeightOneSpectrum (𝓞 ℚ), Measure (v.adicCompletion ℚ)ˣ) [∀ v, SigmaFinite (μ v)]
  (μArch : Measure (InfiniteAdeleRing ℚ)ˣ) [SigmaFinite μArch]

private theorem integral_torusMeasure_prod_mul (φ : ∀ v : T, ((v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ)ˣ → ℂ)
    (φArch : (InfiniteAdeleRing ℚ)ˣ → ℂ) :
    ∫ t, (∏ v : T, φ v (t.1 v)) * φArch t.2 ∂((Measure.pi fun v : T => μ v).prod μArch) =
      (∏ v : T, ∫ x, φ v x ∂(μ v)) * ∫ y, φArch y ∂μArch := by
  rw [integral_prod_mul (fun x : ∀ v : T, ((v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ)ˣ => ∏ v : T, φ v (x v))
      φArch,
    integral_fintype_prod_eq_prod φ]

omit [SigmaFinite μArch] in

private theorem integrable_torusMeasure_prod_mul (φ : ∀ v : T, ((v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ)ˣ → ℂ)
    (hφ : ∀ v : T, Integrable (φ v) (μ v)) (φArch : (InfiniteAdeleRing ℚ)ˣ → ℂ) (hφArch : Integrable φArch μArch) :
    Integrable (fun t => (∏ v : T, φ v (t.1 v)) * φArch t.2) ((Measure.pi fun v : T => μ v).prod μArch) :=
  Integrable.mul_prod (Integrable.fintype_prod_dep hφ) hφArch

end

