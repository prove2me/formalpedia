-- title:
--   Proposition 7.50 — analytically measurable ε-optimal and universally measurable exact selectors for lower semianalytic functions
-- statement:
--   Let $X$ and $Y$ be Borel spaces, $D\subseteq X\times Y$ an analytic set, and $f:D\to R^*$ a lower semianalytic function. Define $f^*:\mathrm{proj}_X(D)\to R^*$ by $f^*(x)=\inf_{y\in D_x}f(x,y)$.
--
--   **(a)** For every $\varepsilon>0$ there exists an analytically measurable function $\varphi:\mathrm{proj}_X(D)\to Y$ such that $\mathrm{Gr}(\varphi)\subseteq D$ and, for all $x\in\mathrm{proj}_X(D)$,
--   $$f[x,\varphi(x)]\le\begin{cases}f^*(x)+\varepsilon&\text{if }f^*(x)>-\infty,\\-1/\varepsilon&\text{if }f^*(x)=-\infty.\end{cases}$$
--
--   **(b)** The set
--   $$I=\{x\in\mathrm{proj}_X(D)\mid f(x,y_x)=f^*(x)\text{ for some }y_x\in D_x\}$$
--   is universally measurable, and for every $\varepsilon>0$ there exists a universally measurable function $\varphi:\mathrm{proj}_X(D)\to Y$ such that $\mathrm{Gr}(\varphi)\subseteq D$ and, for all $x\in\mathrm{proj}_X(D)$,
--   $$f[x,\varphi(x)]=f^*(x)\quad\text{if }x\in I,\qquad f[x,\varphi(x)]\le\begin{cases}f^*(x)+\varepsilon&\text{if }x\notin I,\ f^*(x)>-\infty,\\-1/\varepsilon&\text{if }x\notin I,\ f^*(x)=-\infty.\end{cases}$$
--
--   This is the selection theorem used throughout Chapters 8–9 to construct ε-optimal and optimal policies in Borel-space dynamic programming without semicontinuity or compactness assumptions.
--
--   **Formalization Note** $R^*$ is `EReal`, and $f^*(x)+\varepsilon$ is `EReal` addition of a real $\varepsilon$, which is unambiguous (it equals $+\infty$ when $f^*(x)=+\infty$). The case split keeps the book's $-1/\varepsilon$ bound where $f^*(x)=-\infty$; "analytically measurable" is with respect to the σ-algebra $\mathscr A_X$ generated by the analytic sets, not the power set.
-- source:
--   Bertsekas & Shreve, Stochastic Optimal Control: The Discrete-Time Case, Athena Scientific 1996, pp. 184–185, Proposition 7.50 (Eqs. (114)–(116) of Chapter 7)

import Mathlib
import Definitions.Def_BertsekasShreve_AnalyticSelection_BorelSpace
import Definitions.Def_BertsekasShreve_AnalyticSelection_Measurability
import Definitions.Def_BertsekasShreve_AnalyticSelection_LowerSemianalytic

open MeasureTheory

namespace BertsekasShreve.AnalyticSelection

/-- **Proposition 7.50** (pp. 184–185). Let `X`, `Y` be Borel spaces, `D ⊆ X × Y` analytic and
`f : D → R*` lower semianalytic, with `f*(x) = inf_{y ∈ D_x} f(x, y)` on `proj_X(D)`.
(a) For every `ε > 0` there is an analytically measurable `φ : proj_X(D) → Y` with graph in `D`
and `f(x, φ x) ≤ f*(x) + ε` where `f*(x) > -∞`, `f(x, φ x) ≤ -1/ε` where `f*(x) = -∞`.
(b) The set `I` where the infimum is attained is universally measurable, and for every `ε > 0`
there is a universally measurable `φ : proj_X(D) → Y` with graph in `D`, `f(x, φ x) = f*(x)` on
`I`, and the bounds of (a) off `I`. -/
theorem lower_semianalytic_selection {X Y : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X] [IsBorelSpace X]
    [TopologicalSpace Y] [MeasurableSpace Y] [BorelSpace Y] [IsBorelSpace Y]
    (D : Set (X × Y)) (hD : AnalyticSet D) (f : D → EReal) (hf : IsLowerSemianalytic D f) :
    -- (a)
    (∀ ε : ℝ, 0 < ε →
      ∃ (φ : (Prod.fst '' D) → Y) (hφ : ∀ x : Prod.fst '' D, ((x : X), φ x) ∈ D),
        IsAnalyticallyMeasurableFun (Prod.fst '' D) φ ∧
        ∀ x : Prod.fst '' D,
          (partialInf D f x ≠ ⊥ → f ⟨((x : X), φ x), hφ x⟩ ≤ partialInf D f x + (ε : EReal)) ∧
          (partialInf D f x = ⊥ → f ⟨((x : X), φ x), hφ x⟩ ≤ ((-1 / ε : ℝ) : EReal))) ∧
    -- (b)
    (IsUniversallyMeasurable (attainSet D f) ∧
      ∀ ε : ℝ, 0 < ε →
        ∃ (φ : (Prod.fst '' D) → Y) (hφ : ∀ x : Prod.fst '' D, ((x : X), φ x) ∈ D),
          IsUniversallyMeasurableFun (Prod.fst '' D) φ ∧
          ∀ x : Prod.fst '' D,
            ((x : X) ∈ attainSet D f → f ⟨((x : X), φ x), hφ x⟩ = partialInf D f x) ∧
            ((x : X) ∉ attainSet D f → partialInf D f x ≠ ⊥ →
              f ⟨((x : X), φ x), hφ x⟩ ≤ partialInf D f x + (ε : EReal)) ∧
            ((x : X) ∉ attainSet D f → partialInf D f x = ⊥ →
              f ⟨((x : X), φ x), hφ x⟩ ≤ ((-1 / ε : ℝ) : EReal))) := by sorry

end BertsekasShreve.AnalyticSelection
