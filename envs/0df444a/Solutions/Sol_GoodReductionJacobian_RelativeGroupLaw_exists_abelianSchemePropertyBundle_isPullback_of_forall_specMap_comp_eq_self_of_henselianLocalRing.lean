    let y₁ : SchemeHomOver tK gK := NeronModelInfra.schemeHomOverComp x₁ e
    have hy₁ : LAK.IsTorsionPoint tK (ℓ ^ v) y₁ :=
      isTorsionPoint_map_of_mul (LB.genericFibre K) LAK tK (fun z => NeronModelInfra.schemeHomOverComp z e)
        (fun z w => hemul _ z w) (ℓ ^ v) x₁ hx₁

    let x : SchemeHomOver tΩ gK := GoodReductionJacobian.schemeHomOverComp ψ hψ y₁
    have hx : LAK.IsTorsionPoint tΩ (ℓ ^ v) x :=
      LAK.isTorsionPoint_schemeHomOverComp tK tΩ ψ hψ (ℓ ^ v) hy₁

    have hfix : Spec.map (CommRingCat.ofHom (σ : Ω →+* Ω)) ≫ x.1 = x.1 := hunr A hA σ hσ v x hx

    have hxval : x.1 = ψ ≫ x₁.1 ≫ e.1 := by
