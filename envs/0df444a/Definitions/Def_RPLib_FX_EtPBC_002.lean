-- ===== S4.Def_RP_EtPBC_A_Z2Pi0 =====
section

/-!
# S4-EtPBC-A, (Z): idempotents of the fibre of a finite cover of `P¹_A` spread out to an etale neighbourhood

Algebraic form of the `π₀` lemma: `A` noetherian, `p` prime, chart algebras `B₀` (over `A[t]`), `B₁` (over `A[s]`),
both finite over `A[X]`, overlap algebra `N`, `φ₀ : B₀ →ₐ[A[X]] N`, `φ₁ : B₁ →ₐ[A] N`.

* `secAlg φ₀ φ₁`: the global sections `{(a, b) | φ₀ a = φ₁ b}` as an `A`-subalgebra of `B₀ × B₁`;
  `secAlg_finite`: it is finite over `A` (Z1, `twoChart_fg`).
* `fibreMap p φ₀ φ₁ : secAlg →ₐ[A] κ(p) ⊗ B₀ × κ(p) ⊗ B₁` and `fibreUnit p B₀ B₁`.
* `includeRight_eq_of_sub_mem`: `x ≡ y mod p B` gives `1 ⊗ x = 1 ⊗ y` in `κ(p) ⊗ B`.
* **`exists_etale_idem_twoChart`**: chart elements `ε₀`, `ε₁` idempotent mod `p` and agreeing mod `p` on the overlap
  come, after an etale `A → A'` with a prime `P` over `p` and `κ(p) ≅ κ(P)`, from an idempotent of `A' ⊗ secAlg`.
-/

set_option autoImplicit false

open Polynomial
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Z2

universe u v w w'

variable {A : Type u} [CommRing A]

section Fib

/-- `x ≡ y mod p B` gives `1 ⊗ x = 1 ⊗ y` in `κ(p) ⊗ B`. -/
theorem includeRight_eq_of_sub_mem (p : Ideal A) [p.IsPrime] {B : Type v} [CommRing B] [Algebra A B] {x y : B}
    (h : x - y ∈ p.map (algebraMap A B)) :
    (Algebra.TensorProduct.includeRight : B →ₐ[A] p.ResidueField ⊗[A] B) x =
      Algebra.TensorProduct.includeRight y := by
  rw [← sub_eq_zero, ← map_sub]
  have hle : p.map (algebraMap A B) ≤
      RingHom.ker (Algebra.TensorProduct.includeRight (R := A) (A := p.ResidueField) (B := B)).toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    show (Algebra.TensorProduct.includeRight : B →ₐ[A] p.ResidueField ⊗[A] B) (algebraMap A B r) = 0
    rw [AlgHom.commutes,
      Algebra.TensorProduct.algebraMap_apply, Ideal.algebraMap_residueField_eq_zero.mpr hr, TensorProduct.zero_tmul]
  exact hle h

/-- The structure map `κ(p) → κ(p) ⊗ B₀ × κ(p) ⊗ B₁`. -/
def fibreUnit (p : Ideal A) [p.IsPrime] (B₀ : Type v) (B₁ : Type w) [CommRing B₀] [Algebra A B₀] [CommRing B₁]
    [Algebra A B₁] : p.ResidueField →ₐ[A] (p.ResidueField ⊗[A] B₀) × (p.ResidueField ⊗[A] B₁) :=
  (Algebra.TensorProduct.includeLeft (S := A)).prod (Algebra.TensorProduct.includeLeft (S := A))

end Fib

section TwoChart

variable {B₀ : Type v} {B₁ : Type w} {N : Type w'}
  [CommRing B₀] [Algebra A[X] B₀] [Algebra A B₀] [IsScalarTower A A[X] B₀]
  [CommRing B₁] [Algebra A[X] B₁] [Algebra A B₁] [IsScalarTower A A[X] B₁]
  [CommRing N] [Algebra A[X] N] [Algebra A N] [IsScalarTower A A[X] N]

/-- The global sections `{(a, b) | φ₀ a = φ₁ b}` as an `A`-subalgebra of `B₀ × B₁`. -/
def secAlg (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N) : Subalgebra A (B₀ × B₁) :=
  AlgHom.equalizer ((φ₀.restrictScalars A).comp (AlgHom.fst A B₀ B₁)) (φ₁.comp (AlgHom.snd A B₀ B₁))

omit [Algebra A[X] B₁] [IsScalarTower A A[X] B₁] in
theorem mem_secAlg (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N) (x : B₀ × B₁) :
    x ∈ secAlg φ₀ φ₁ ↔ φ₀ x.1 = φ₁ x.2 := Iff.rfl

/-- Reduction of global sections to the fibre at `p`, chartwise. -/
def fibreMap (p : Ideal A) [p.IsPrime] (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N) :
    secAlg φ₀ φ₁ →ₐ[A] (p.ResidueField ⊗[A] B₀) × (p.ResidueField ⊗[A] B₁) :=
  (Algebra.TensorProduct.includeRight.comp ((AlgHom.fst A B₀ B₁).comp (secAlg φ₀ φ₁).val)).prod
    (Algebra.TensorProduct.includeRight.comp ((AlgHom.snd A B₀ B₁).comp (secAlg φ₀ φ₁).val))

end TwoChart

end RamanujanPetersson.EtPBC.Z2

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3Two =====
section

/-!
# S4-EtPBC-A, (Z): the `π₀` lemma with localization hypotheses on the charts

The charts of a finite cover of `P¹_A` are `B₀` (over `A[t]`) and `B₁` (over `A[s]`), the overlap `N` is both
`B₀[1/t]` and `B₁[1/s]`, and `t s = 1` on `N`. Here `X` acts as `t` on `B₀` and `N`, as `s` on `B₁`.

* `away_surj`, `away_zero`: the two halves of `IsLocalization.Away r S` in the form used below.
* **`exists_etale_idem_of_loc`**: `exists_etale_idem_twoChart` with the conditions `h₁`, `hgen`, `hloc`, `hk₀`, `hk₁`
  replaced by `t s = 1` and the localization conditions (`hs₀`, `hz₀` for `N = B₀[1/t]`, `hs₁`, `hz₁` for
  `N = B₁[1/s]`).
-/

set_option autoImplicit false

open Polynomial
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Z2

universe u v w w'

section Away

variable {R : Type v} {S : Type w} [CommRing R] [CommRing S] [Algebra R S]

theorem away_surj (r : R) [IsLocalization.Away r S] (y : S) :
    ∃ (k : ℕ) (a : R), algebraMap R S r ^ k * y = algebraMap R S a := by
  obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, h⟩ := IsLocalization.surj (Submonoid.powers r) y
  exact ⟨k, a, by rw [← map_pow, mul_comm]; exact h⟩

theorem away_zero (r : R) [IsLocalization.Away r S] (a : R) (h : algebraMap R S a = 0) :
    ∃ k : ℕ, r ^ k * a = 0 := by
  obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers r) S a).mp h
  exact ⟨k, hk⟩

end Away

end RamanujanPetersson.EtPBC.Z2

end

