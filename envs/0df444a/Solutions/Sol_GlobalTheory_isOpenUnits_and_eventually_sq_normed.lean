    [Module.Finite F R] :
    IsOpenUnits R ∧ ∀ᶠ v in 𝓝 (1 : R), ∃ s : R, s ^ 2 = v := by
  haveI : CompleteSpace R := FiniteDimensional.complete F R
  refine ⟨⟨Units.isOpenEmbedding_val⟩, ?_⟩
  have hd := hasStrictFDerivAt_pow (𝕜 := F) 2 (x := (1 : R))
