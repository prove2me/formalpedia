theorem iso_symm {S : Type u} [CommRing S] {E E' : FakeEllipticCurve Λ N S} (h : FakeEllipticCurve.Iso E E') :
    FakeEllipticCurve.Iso E' E := by
  obtain ⟨e, he, hmul, hact, hlev⟩ := h
  have he' : e.inv ≫ E.f = E'.f := by rw [← he, Iso.inv_hom_id_assoc]
  have hround : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E'.f),
      mapPt e.hom he (mapPt e.inv he' P) = P := fun t P =>
    Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have hround' : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      mapPt e.inv he' (mapPt e.hom he P) = P := fun t P =>
    Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.hom_inv_id, Category.comp_id])
  refine ⟨e.symm, he', ?_, ?_, ?_⟩
  · intro T t P Q
    have h := hmul t (mapPt e.inv he' P) (mapPt e.inv he' Q)
    rw [hround, hround] at h
    show mapPt e.inv he' (E'.L.mul t P Q) = E.L.mul t (mapPt e.inv he' P) (mapPt e.inv he' Q)
    rw [← h, hround']
  · intro x
    show E'.act x ≫ e.inv = e.inv ≫ E.act x
    rw [← cancel_mono e.hom, Category.assoc, Category.assoc, hact x, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
  · intro T t P
    have h := hlev t (mapPt e.inv he' P)
    rw [hround] at h
    exact h.symm

theorem mapPt_one {S : Type u} [CommRing S] {E E' : FakeEllipticCurve Λ N S} (φ : E.A ⟶ E'.A) (hφ : φ ≫ E'.f = E.f)
    (hhom : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f),
      mapPt φ hφ (E.L.mul t P Q) = E'.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) : mapPt φ hφ (E.L.one t) = E'.L.one t := by
  have h := hhom t (E.L.one t) (E.L.one t)
  rw [E.L.one_mul] at h

  letI := E'.L.pointGroup t
  have h' : (mapPt φ hφ (E.L.one t)) * (mapPt φ hφ (E.L.one t)) = mapPt φ hφ (E.L.one t) := h.symm
  exact mul_eq_left.mp h'

theorem exists_mapPt_F_eq (k : Type u) [Field k] (ℓ : ℕ) [Fact ℓ.Prime] [CharP k ℓ] [PerfectRing k ℓ]
    {E Eℓ : FakeEllipticCurve Λ N k} (D : FrobeniusVerschiebungData ℓ E Eℓ)
    (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) Eℓ.f) :
    ∃ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) E.f, mapPt D.F D.F_over x = P := by

  have hS1 : Spec.map (CommRingCat.ofHom (frobenius k ℓ)) ≫ Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) =
      𝟙 (Spec (CommRingCat.of k)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : (frobenius k ℓ).comp ((frobeniusEquiv k ℓ).symm : k →+* k) = RingHom.id k :=
      RingHom.ext fun x => frobenius_apply_frobeniusEquiv_symm k ℓ x
    rw [this, CommRingCat.ofHom_id, Spec.map_id]
  have hS2 : Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) ≫ Spec.map (CommRingCat.ofHom (frobenius k ℓ)) =
      𝟙 (Spec (CommRingCat.of k)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : ((frobeniusEquiv k ℓ).symm : k →+* k).comp (frobenius k ℓ) = RingHom.id k :=
      RingHom.ext fun x => frobeniusEquiv_symm_apply_frobenius k ℓ x
    rw [this, CommRingCat.ofHom_id, Spec.map_id]

  have hx : (Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) ≫ P.1 ≫ D.pr) ≫ E.f = 𝟙 _ := by
    rw [Category.assoc, Category.assoc, D.pr_isPullback.w, ← Category.assoc P.1, P.2, Category.id_comp, hS2]
  refine ⟨⟨Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) ≫ P.1 ≫ D.pr, hx⟩, ?_⟩
  apply Subtype.ext
  show (Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) ≫ P.1 ≫ D.pr) ≫ D.F = P.1
  apply D.pr_isPullback.hom_ext
  · rw [Category.assoc, D.F_frobenius k (Spec.map (CommRingCat.ofHom ((frobeniusEquiv k ℓ).symm : k →+* k)) ≫ P.1 ≫ D.pr),
      ← Category.assoc, hS1, Category.id_comp]
  · rw [Category.assoc, D.F_over, hx, P.2]

