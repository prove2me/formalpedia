open WeierstrassCurve

theorem WeierstrassCurve.variableChange_mk_neg_one_smul_eq_self
    {R : Type*} [CommRing R] (W : WeierstrassCurve R) :
    (⟨-1, 0, -W.a₁, -W.a₃⟩ : VariableChange R) • W = W := by sorry
