section Naturality

variable (p : ℕ) [Fact p.Prime]
variable {A : Type v} [CommRing A] [Bialgebra (ZMod p) A] [Coalgebra.IsCocomm (ZMod p) A]
variable [Module.Finite (ZMod p) A] [Module.Free (ZMod p) A]
variable {B : Type v} [CommRing B] [Bialgebra (ZMod p) B] [Coalgebra.IsCocomm (ZMod p) B]
variable [Module.Finite (ZMod p) B] [Module.Free (ZMod p) B]

private theorem coalgHom_verschiebung (g : A →ₗc[ZMod p] B) (a : A) :
    g (verschiebung p A a) = verschiebung p B (g a) := by
  set b := Module.Free.chooseBasis (ZMod p) B
  apply b.ext_elem
  intro i
  rw [← Basis.coord_apply, ← Basis.coord_apply, dual_apply_verschiebung p B (g a) (b.coord i)]
  have hpull := congrArg (fun w : WithConv (A →ₗ[ZMod p] ZMod p) => w.ofConv a)
    (convPow_comp_coalgHom (WithConv.toConv (b.coord i) : WithConv (B →ₗ[ZMod p] ZMod p)) g p)
  calc (b.coord i) (g (verschiebung p A a))
      = ((b.coord i) ∘ₗ g.toLinearMap) (verschiebung p A a) := rfl
    _ = ((WithConv.toConv ((b.coord i) ∘ₗ g.toLinearMap) : WithConv (A →ₗ[ZMod p] ZMod p)) ^ p).ofConv a :=
        dual_apply_verschiebung p A a _
    _ = ((WithConv.toConv (b.coord i) : WithConv (B →ₗ[ZMod p] ZMod p)) ^ p).ofConv (g a) := hpull

private theorem toLinearMap_comp_verschiebung (g : A →ₗc[ZMod p] B) :
    g.toLinearMap ∘ₗ verschiebung p A = verschiebung p B ∘ₗ g.toLinearMap :=
  LinearMap.ext fun a => coalgHom_verschiebung p g a

end Naturality
