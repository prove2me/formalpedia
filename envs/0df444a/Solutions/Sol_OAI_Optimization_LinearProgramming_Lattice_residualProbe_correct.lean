theorem probeRowsQ_some {n p : ℕ} (oracle : (Fin p → ℤ) → Bool) (P : Fin n → Fin p → ℚ) (k : ℕ)
    {ys : Fin n → ℚ} (h : SignQueries.run oracle (probeRowsQ P k) = some ys) :
