          (∀ v : Place (AlgebraicClosure ℚ) F, v'.toValuationSubring.comap (algebraMap F FC) ≠ v.toValuationSubring) →
            (D' : Divisor A.valuation.Completion FC) v' = 0) →
        ι' (Pic0.mk D) = Pic0.mk D') →
      ∀ x : Pic0 (AlgebraicClosure ℚ) F,
        ι' (Pic0.correspondence φ'β φ'α hφ'β hφ'α hFI'β hfin'α hN'α x) =
          Pic0.correspondence φβ φα hφβ hφα hFIβ hfinα hNα (ι' x))
    (ℓ : Nat.Primes)

    (ιT : Pic0 (AlgebraicClosure ℚ) F →+ Pic0 A.valuation.Completion FC)
    (hpin : ∀ (D : Divisor.degZero (K := AlgebraicClosure ℚ) (F := F))
        (D' : Divisor.degZero (K := A.valuation.Completion) (F := FC)),
      (∀ (v' : Place A.valuation.Completion FC) (v : Place (AlgebraicClosure ℚ) F),
        v'.toValuationSubring.comap (algebraMap F FC) = v.toValuationSubring →
          (D' : Divisor A.valuation.Completion FC) v' = (D : Divisor (AlgebraicClosure ℚ) F) v) →
      (∀ v' : Place A.valuation.Completion FC,
        (∀ v : Place (AlgebraicClosure ℚ) F, v'.toValuationSubring.comap (algebraMap F FC) ≠ v.toValuationSubring) →
          (D' : Divisor A.valuation.Completion FC) v' = 0) →
      ιT (Pic0.mk D) = Pic0.mk D')

    (hex : ∀ D : Divisor.degZero (K := AlgebraicClosure ℚ) (F := F),
      ∃ D' : Divisor.degZero (K := A.valuation.Completion) (F := FC),
        (∀ (v' : Place A.valuation.Completion FC) (v : Place (AlgebraicClosure ℚ) F),
          v'.toValuationSubring.comap (algebraMap F FC) = v.toValuationSubring →
            (D' : Divisor A.valuation.Completion FC) v' = (D : Divisor (AlgebraicClosure ℚ) F) v) ∧
        (∀ v' : Place A.valuation.Completion FC,
          (∀ v : Place (AlgebraicClosure ℚ) F, v'.toValuationSubring.comap (algebraMap F FC) ≠ v.toValuationSubring) →
            (D' : Divisor A.valuation.Completion FC) v' = 0))

    (N : ℕ) {ad bd : ℚ} (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd])
    (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    (e : ↥(ribbonKernel 𝒞) ≃ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (hiso : ∀ x y : ↥(ribbonKernel 𝒞),
      ribbonGram (classSetDegeneracyData Rd nd) (e x) (e y) = ribbonGram 𝒞 x y)
    (hK : ∀ z : ↥(ribbonKernel 𝒞),
      β.pushforward (α.pullback z) = e.symm (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ (e z))) :
    ∀ (u : (pdTransport 𝒰₀.P e hiso).TorusPoints) (c : Pic0 (AlgebraicClosure ℚ) F),
      𝒰₀.eFull (torusPull 𝒰₀.P e hiso u) = ιT c →
        𝒰₀.eFull (torusPull 𝒰₀.P e hiso
          ((pdTransport 𝒰₀.P e hiso).precomp (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ) u)) =
          ιT (Pic0.correspondence φ'β φ'α hφ'β hφ'α hFI'β hfin'α hN'α c) := by
  intro u c hu

  obtain ⟨D, rfl⟩ := Pic0.mk_surjective c
  obtain ⟨DC, hover, hoff⟩ := hex D
  have hc : ιT (Pic0.mk D) = Pic0.mk DC := hpin D DC hover hoff

  have h1 : 𝒰₁.eFull ((torusPull 𝒰₀.P e hiso u).comp β.pushforward) =
      Pic0.mk ⟨Divisor.pullbackAlong φβ hφβ (DC : Divisor A.valuation.Completion FC),
        Divisor.pullbackAlong_mem_degZero φβ hφβ hFIβ DC.2⟩ :=
    hconorm _ DC _ (hu.trans hc) rfl
  have h2 : 𝒰₀.eFull (((torusPull 𝒰₀.P e hiso u).comp β.pushforward).comp α.pullback) =
      Pic0.mk ⟨Divisor.pushforwardAlong φα hφα
          (Divisor.pullbackAlong φβ hφβ (DC : Divisor A.valuation.Completion FC)),
        Divisor.pushforwardAlong_mem_degZero φα hφα (Divisor.pullbackAlong_mem_degZero φβ hφβ hFIβ DC.2)⟩ :=
    hnorm _ _ _ h1 rfl

  have hT : torusPull 𝒰₀.P e hiso
      ((pdTransport 𝒰₀.P e hiso).precomp (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ) u) =
      ((torusPull 𝒰₀.P e hiso u).comp β.pushforward).comp α.pullback := by
    apply LinearMap.ext
    intro z
    rw [torusPull_apply, PeriodDatum.precomp_apply, LinearMap.comp_apply, LinearMap.comp_apply, torusPull_apply, hK,
      LinearEquiv.apply_symm_apply]
  rw [hT, h2, hHBC ιT hpin (Pic0.mk D), hc, Pic0.correspondence_mk]
  rfl

end heckeAway
