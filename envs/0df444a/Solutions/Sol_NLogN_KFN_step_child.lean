theorem Xf_mono {r : ℕ} {Ψ : ℕ → ℕ} (hΨ : Monotone Ψ) : Monotone (Xf r Ψ) := by
  intro a b h
  unfold Xf
  have := hΨ h
  have : r * (a + 1) ≤ r * (b + 1) := Nat.mul_le_mul_left _ (by omega)
  omega

theorem affK_top_le {K x e t : ℕ} (hx : x ≤ e) (ht : e - e % K + K ≤ t) : x - x % K + K ≤ t := by
  have h1 := Nat.mod_add_div x K
  have h2 := Nat.mod_add_div e K
  have h3 : K * (x / K) ≤ K * (e / K) := Nat.mul_le_mul_left _ (Nat.div_le_div_right hx)
  omega

/-- The bits of one row (`h`) of a stride-`K` row family. -/
theorem affK_child {K t m k : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ} (h : AffK2 K t m k pos)
    (a : Fin m) : AffK K t (fun c : Fin (m ^ k) => pos (a, c)) := by
  obtain ⟨e, he, ht⟩ := h
  refine ⟨e - K * (m ^ k * a.val), fun c => ?_, affK_top_le (Nat.sub_le _ _) ht⟩
  have := he (a, c)
  simp only at this
  rw [Nat.mul_add] at this
  show pos (a, c) + K * c.val = e - K * (m ^ k * a.val)
  omega

section LocalBounds

variable {r Z : ℕ} {Ψ : ℕ → ℕ}

theorem cAtom_X {W n w D : ℕ} (hW : 1 ≤ W) (hn : 1 ≤ n) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
