theorem Sp.zipK {A Z O C : Fin HS} (hAZ : A ≠ Z) (hAO : A ≠ O) (hZO : Z ≠ O) (hAC : A ≠ C)
    (hZC : Z ≠ C) (hOC : O ≠ C) (hA5 : A.val < 56) (hZ5 : Z.val < 56) (hO5 : O.val < 56)
