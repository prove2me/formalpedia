      ((baseline.val : ℤ)+x.2.1)%(x.1.1.length : ℤ)=(x.2.2 : ℤ) := by
    rw [←he,Int.natCast_inj]
  simp only [_root_.Integration9_9.TM2NativeBodyKernel.term,hm,_root_.Integration9_9.TM2NativeSliceProbability.slice,_root_.CurrentAFT.RationalProposalProgram.safeEntry]






