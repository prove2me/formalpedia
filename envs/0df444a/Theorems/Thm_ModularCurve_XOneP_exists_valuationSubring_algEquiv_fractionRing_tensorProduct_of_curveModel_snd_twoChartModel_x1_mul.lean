theorem ModularCurve.XOneP.exists_valuationSubring_algEquiv_fractionRing_tensorProduct_of_curveModel_snd_twoChartModel_x1_mul
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hM : 5 ≤ M) (hpM : ¬ p ∣ M)
    (L : Type) [Field L] [CharZero L] [IsCyclotomicExtension {p} ℚ L]
