    (hc13 : c 13 = []) (hc53 : c 53 = []) (hc54 : c 54 = []) (hcu : c Cu = [])
    {P R sN tN lam aN A pk b M q : ℕ} {ℓ : ℤ} {lr : List ℤ}
    (hi : StIn2 u P R sN tN lam aN A) (hPA : P ≤ A) (TB : TabB P R sN tN aN lam A)
    (h26 : u 26 = pk) (h28 : u 28 = b) (hpkM : pk ≤ M) (hbM : b ≤ M) (h4l : 4 * lam ≤ 2 ^ A)
    (hl : 1 ≤ lam) (hsA : sN ≤ 2 ^ A) (hqA : q * lam ≤ 2 ^ A) (hq : q ≤ 2 ^ A)
    (hcL : c L = ℓ :: lr) (hℓ : |ℓ| ≤ 2 ^ A) :
    Sp (chB2 O L) (encK s (RF (CS u q) c))
      (encK s (RF (CS u ((q : ℤ) - 1)) (Function.update (Function.update c O
        ((((tabQ2 P R sN tN lam aN pk b q).length : ℤ) :: tabQ2 P R sN tN lam aN pk b q) ++ c O)) L
        ((ℓ + (1 + ((tabQ2 P R sN tN lam aN pk b q).length : ℤ))) :: lr))))
      (cCh2 P R A lam M) := by
  have hA := hi.A2
  have HA := partA2_sp s u c hO hO5 hO13 hO50 hc13 hc53 hc54 hcu hi hPA TB h28 h4l
    hl hsA hqA hq
  set ds := J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q
  set W := RA P R sN tN lam aN u q
  have hqv : |((q : ℕ) : ℤ)| ≤ 2 ^ A := by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast hq
  have i0 := hi.CS hqv
  have hWz : zr W = W := by simp only [W, RA, bS]; exact zr_zr _
  have Wpar : ∀ j : Fin HS, ¬ Wk j → j ≠ 1 → j ≠ 7 → j ≠ 8 → W j = CS u q j := by
    intro j hj a b' c'
    simp only [W, RA, bS]; rw [zr_ne hj, upd_ne c', upd_ne b', upd_ne a]
  have hWV : VB W A := by
    simp only [W, RA, bS]
    refine zr_VB (VB_upd (VB_upd (VB_upd i0.vb 1 ?_) 7 ?_) 8 ?_)
    · rw [abs_of_nonneg (by positivity)]
      have := bst_iter_le sN tN lam (st := q * lam) (min_le_left sN (q * lam + lam)) lam
      exact_mod_cast (show _ ≤ 2 ^ A by omega)
    · rw [abs_of_nonneg (by positivity)]
      have : (preD P R sN tN lam aN (min sN (q * lam + lam)) (q * lam) lam).length ≤ lam := by
        simp only [preD, List.length_map]; exact blFrom_len sN tN lam _ lam _
      have := hi.lam
      exact_mod_cast (show _ ≤ 2 ^ A by omega)
    · rw [abs_of_nonneg (by positivity)]
      have : J6Seg.KR.sumN (preD P R sN tN lam aN (min sN (q * lam + lam)) (q * lam) lam) ≤ lam :=
        J6Seg.KR.sumN_descsOf hl _ q
      have := hi.lam
      exact_mod_cast (show _ ≤ 2 ^ A by omega)
  have iW : StIn2 W P R sN tN lam aN A := i0.of' hWV (fun j hj => Wpar j
    (by unfold Wk; rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
    (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
    (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
    (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide))
  have W7 : W 7 = ds.length := by
    simp only [W, RA, bS]; rw [zr_ne (by unfold Wk; decide)]; simp; rfl
  have W8 : W 8 = J6Seg.KR.sumN ds := by
    simp only [W, RA, bS]; rw [zr_ne (by unfold Wk; decide)]; simp; rfl
  have par : ∀ j : Fin HS, ¬ Wk j → j ≠ 1 → j ≠ 6 → j ≠ 7 → j ≠ 8 → W j = u j := fun j a b' c' d e =>
    by rw [Wpar j a b' d e, CS_par u q a b' c' d e]
  set c1 := Function.update c O (J6Seg.KR.dsEnc2 b ds ++ c O)
  have c1u : c1 Cu = [] := by simp only [c1]; rw [Function.update_of_ne hOC.symm, hcu]
  have HB := partB_sp s W c1 hO hO5 hOC c1u iW hWz hPA TB
  set c2 := Function.update c1 O ((diL P R sN tN lam aN).reverse ++
        ((giL P R sN tN lam aN).reverse ++ ((gamL P R sN tN lam aN).reverse ++
        ((ddL P R sN tN lam aN).reverse ++ c1 O))))
  have c2L : c2 L = ℓ :: lr := by
    simp only [c2, c1]; rw [Function.update_of_ne hOL.symm, Function.update_of_ne hOL.symm, hcL]
  have hsn : J6Seg.KR.sumN ds ≤ lam := J6Seg.KR.sumN_descsOf hl _ q
  have HC := partC2_sp s W c2 hO hO5 hL hL5 hOL (q := q) hA hWV iW.h9 iW.h10 iW.h24
    (by rw [par 26 (by unfold Wk; decide) (by decide) (by decide) (by decide) (by decide), h26])
    (by rw [par 28 (by unfold Wk; decide) (by decide) (by decide) (by decide) (by decide), h28])
    W7 W8 (by simp only [W, RA, bS]; rw [zr_ne (by unfold Wk; decide)]; simp [CS]) hsn hpkM hbM c2L hℓ
  have hlen := dsEnc2_length b ds (fun d hd => by
    obtain ⟨_, h2, h3, _⟩ := J6Seg.KR.descsOf_ok hl _ q d hd; exact ⟨h2, h3⟩)
  have htl : (tabQ2 P R sN tN lam aN pk b q).length = 8 + 4 * lam + (4 * ds.length + 2 * J6Seg.KR.sumN ds) := by
    simp only [tabQ2, J6Seg.KR.tabK2, List.length_append, List.length_cons, List.length_nil,
      List.length_reverse, diL, giL, gamL, ddL, List.length_map, List.length_range]
    rw [← hlen]; ring
  refine Sp.mono (Sp.congr (HA.seq (HB.seq HC)) ?_) (le_of_eq rfl)
  congr 2
  · funext j
    by_cases j6 : j = 6
    · subst j6; simp [CS]
    by_cases j1 : j = 1
    · subst j1; simp [CS, Z]
    by_cases j7 : j = 7
    · subst j7; simp [CS, Z]
    by_cases j8 : j = 8
    · subst j8; simp [CS, Z]
    rw [upd_ne j8, upd_ne j7, upd_ne j1, upd_ne j6]
    by_cases hw : Wk j
    · rw [← hWz, show zr W j = 0 by unfold zr; unfold Wk at hw; rw [if_pos hw]]
      have := CS_wk u ((q : ℤ) - 1) j hw; rw [this]
    · rw [Wpar j hw j1 j7 j8, CS_par u q hw j1 j6 j7 j8, CS_par u _ hw j1 j6 j7 j8]
  · simp only [c2, c1, Function.update_idem, Function.update_self, htl]
    rw [Function.update_comm hOL, Function.update_comm hOL]
    congr 2
    simp only [tabQ2, J6Seg.KR.tabK2, List.cons_append, List.nil_append, List.append_assoc, List.append_eq]
    rw [← hlen]

end J6Seg.PreT

