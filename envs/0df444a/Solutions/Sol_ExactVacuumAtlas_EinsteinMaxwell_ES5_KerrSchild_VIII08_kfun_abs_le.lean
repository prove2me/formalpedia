  have hB0 : 0 ≤ 3 * |j| + Aq := by positivity
  have ht0 : (0:ℝ) ≤ t := ht.1
  have htK : (0:ℝ) < 1 / 3 := by norm_num
  have hA0 : (0:ℝ) < AcK t := lt_of_lt_of_le htK (AcK_ge ht)
  have hA2 : (1 / 3) ^ 2 ≤ AcK t ^ 2 := by
    have h1 := AcK_ge ht
    nlinarith [h1, hA0]
  have h1x := one_sub_ge ht
  have hBabs := Bfun_abs_le (j := j) hq hAq ht
  have hb1 : 0 ≤ |Bfun j q t| := abs_nonneg _
  have hdenpos : (0:ℝ) < (2 / 3) * ((1 / 3) ^ 2) := by norm_num
  have harg : (0:ℝ) < (1 - t) * AcK t ^ 2 := by nlinarith
  have hden : (2 / 3) * ((1 / 3) ^ 2) ≤ |(1 - t) * AcK t ^ 2| := by
