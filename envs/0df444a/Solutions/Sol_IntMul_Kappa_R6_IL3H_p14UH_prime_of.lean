-- Source module: Solutions.R6IL3Top15
/-!
# Round six, item language (I3): the cost closure of the uniform Proposition 14

Under `Hyp14` (with `Zr = Bz = 3 Z`, level costs `CBc c Kc G Cc θ`, `0 ≤ θ ≤ lamp`), the cost of
the entry procedure `p14CH` plus the call overhead is at most

  `C0c c Kc Cc · (n r) · (w + 1) · (zsz p + 1) · D^lamp`,

`C0c c Kc Cc = 20125 (Kc + 2)(2 W' + 12)(Cc + 10^14 (2m+1)) + 10^17 (Sc c + 1)(2 W' + 14)`.

The kernel levels contribute `(q₀ + q_B) · CB 1 · n U` with `q₀ + q_B ≤ 3 D^lamp`
(hypothesis (3)) and `CB 1 ≤ (Kc + 2)(G + 2)(Cc + D₀)`, `G + 2 ≤ (2 W' + 12)(zsz p + 1)`;
the middle level `401 · CB E · n' U ≤ 802 (Kc+2)(G+2)(Cc+D₀) D^lamp n U`; the loops
`(G + d + q₀ + q_B) (Sc+1) U` and `z_a (Sc+1)(3Z+3)^2 ≤ 27 (Sc+1) r`; `U ≤ 25 r (w+1)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

theorem C0c_nonneg (c : Cfg) {Kc Cc : ℝ} (hKc : 0 ≤ Kc) (hCc : 0 ≤ Cc) : 0 ≤ C0c c Kc Cc := by
  unfold C0c
  have a : 0 ≤ (Kc + 2) * (2 * (c.Wr : ℝ) + 12) := mul_nonneg (by linarith) (by positivity)
  have b : (0 : ℝ) ≤ Cc + 10 ^ 14 * (2 * c.m + 1) := by positivity
  have d : (0 : ℝ) ≤ 10 ^ 17 * (((Sc c + 1 : ℕ) : ℝ) * (2 * c.Wr + 14)) := by positivity
  have := mul_nonneg a b
  linarith

namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

end Hyp14

end IntMul.Kappa.R6.IL3H

