-- title:
--   Proof of Proposition 6.1, Case 1, p. 23 — on 𝔅(w̄; η, ν) the gap L_γ(w^{k+1}) − L_γ(w̄) is at most (κ₂c₅)²‖w^k − w^{k+1}‖²
-- statement:
--   Let Assumptions 1 and 2 hold, let $\delta_k$ be set by (8), and let $\{w^k\}=\{(u^k,v^k,p^k)\}$ be generated by NAPP-AL. Let $\bar w$ be an accumulation point of $\{w^k\}$, and suppose $\mathcal L_\gamma$ has the Kurdyka–Łojasiewicz property at $\bar w$ with exponent $\theta=\tfrac12$ and constants $\eta,\nu,\kappa_2>0$. Write $\Lambda^*=\mathcal L_\gamma(\bar w)$.
--
--   Then there is $c_5>0$ such that for every $k$ with $\|w^{k+1}-\bar w\|<\eta$ and $\Lambda^*<\mathcal L_\gamma(w^{k+1})<\Lambda^*+\nu$,
--
--   $$\mathcal L_\gamma(w^{k+1})-\Lambda^*\le\kappa_2^2\operatorname{dist}^2\big(0,\partial\mathcal L_\gamma(w^{k+1})\big)\quad\text{and}\quad\mathcal L_\gamma(w^{k+1})-\Lambda^*\le(\kappa_2c_5)^2\|w^k-w^{k+1}\|^2.$$
--
--   This is Case 1 of the proof of Proposition 6.1: it combines the KL inequality with the residual bound of Theorem 4.1(iv), and it is the only nontrivial case of that proof.
--
--   **Formalization Note.** The page prints "$\operatorname{dist}^2(0,\mathcal L_\gamma(w^{k+1}))$" without $\partial$ and writes $\mathbb R^{n\times d\times m}$ for $\mathbb R^n\times\mathbb R^d\times\mathbb R^m$; the statement uses $\partial\mathcal L_\gamma$ and the product space. The first inequality is stated in $[0,+\infty]$, with $\operatorname{dist}(0,\emptyset)=+\infty$. The page's $c_5$ is the constant of Theorem 4.1(iv); here it is asserted to exist, before $k$. "Generated by NAPP-AL" carries the standing hypotheses of Theorem 4.1 (Assumptions 1–2 and (8)), which the proof uses through Theorem 4.1(iv).
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 23, proof of Proposition 6.1, Case 1

import Mathlib
import Definitions.Def_NAPPAL_KL_Setting

namespace NAPPAL.KL
theorem proposition_6_1_case_1 {n d m : ℕ} (P : Problem n d m) (LG LH L0 : ℝ)
    (LOmj : Fin m → ℝ) (LK : ℝ) (K : E n → ℝ) (β γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → E n)
    (v : ℕ → E d) (p : ℕ → E m) (hrun : RunHyp P LG LH L0 LOmj LK K β γ σ δ ε u v p)
    (wbar : W n d m) (hcl : MapClusterPt wbar Filter.atTop (wseq u v p)) (η ν κ2 : ℝ)
    (hKL : HasKLAt P γ wbar (1 / 2) η ν κ2) :
    ∃ c5 : ℝ, 0 < c5 ∧ ∀ k : ℕ, wdist (wseq u v p (k + 1)) wbar < η →
      augLag P γ wbar < augLag P γ (wseq u v p (k + 1)) →
      augLag P γ (wseq u v p (k + 1)) < augLag P γ wbar + ν →
      ENNReal.ofReal (augLag P γ (wseq u v p (k + 1)) - augLag P γ wbar) ≤
          (ENNReal.ofReal κ2 * distZero (dAugLag P γ (wseq u v p (k + 1)))) ^ 2 ∧
        augLag P γ (wseq u v p (k + 1)) - augLag P γ wbar ≤
          (κ2 * c5) ^ 2 * wdist (wseq u v p k) (wseq u v p (k + 1)) ^ 2 := by sorry
end NAPPAL.KL
