-- Source module: Solutions.KFHRec
/-!
# KFH: fixed-point record arrays and the `Q_p` truncation pass

**Record format.**  The array of Proposition 14 is a list `xs` of records, each record `r`
complex coefficients (`Fin r → ℂ`).  On the item stacks it is a Gaussian list `zs` (two integer
items per coefficient, `gflat`), records consecutive, coefficients in order, with one common
scale: `RecRep r F zs xs` says coefficient `c` of record `j` is `toC zs[j r + c] / 2^F`.
The scale `F` (number of fractional bits) is bookkeeping, not data: every halving of §5.4 is
`F ↦ F + 1` and costs nothing; the numerators stay exact (this is the guarded format of §5.4
with the reserved fractional zeros left implicit).  Bit widths are tracked by `GB w zs`.

**Truncation.** `truncP Δ N` replaces each of the `N` integer items `a` on top of stack `0` by
`a.tdiv 2^Δ` (truncation toward zero, `Ex.quo`, linear cost).  On numerators at scale
`p + Δ` this is exactly `Q_p` (`truncNum_tdiv`): `truncP_rep` gives
`RecRep r p zs' (QpArr p xs)` from `RecRep r (p + Δ) zs xs`.  Cost `O(N (w + Δ)) + O(Z)`
(`truncP_fsp`), no `Bb` factor.  The same pass with an exact divisor is the renormalisation step.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

/-! ## The record format -/

/-! ## Truncation toward zero of a dyadic numerator -/

/-- Disk outputs truncate to numerators of at most `p + 1` bits. -/
theorem GB_trunc_disk {r p : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r p zs xs)
    (hd : ∀ j (hj : j < xs.length) c, ‖xs[j] c‖ ≤ 1) : GB (p + 1) zs := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hr : 0 < r := by
    have h1 : zs.length = xs.length * r := h.1
    have : xs.length * r ≠ 0 := by omega
    exact Nat.pos_of_ne_zero (right_ne_zero_of_mul this)
  set j := i / r
  have hj : j < xs.length := by
    rw [h.1] at hi; exact (Nat.div_lt_iff_lt_mul hr).2 hi
  set c : Fin r := ⟨i % r, Nat.mod_lt _ hr⟩
  have hi' : i = j * r + c := by simp [j, c, Nat.div_add_mod']
  have e := h.2 j c hj
  rw [← hi', List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj] at e
  have hn := hd j hj c
  have hz : ‖toC zs[i]‖ ≤ 2 ^ p := by
    rw [e, norm_mul]; simp only [norm_pow, Complex.norm_ofNat]
    calc (2 : ℝ) ^ p * ‖xs[j] c‖ ≤ 2 ^ p * 1 := by gcongr
      _ = 2 ^ p := mul_one _
  have k : ∀ a : ℤ, |(a : ℝ)| ≤ 2 ^ p → zsz a ≤ p + 1 := by
    intro a ha
    apply zsz_le_of_lt
    have : (a.natAbs : ℝ) ≤ 2 ^ p := by rw [Nat.cast_natAbs]; exact_mod_cast ha
    have : a.natAbs ≤ 2 ^ p := by exact_mod_cast this
    rw [pow_succ]; have := Nat.one_le_two_pow (n := p); omega
  have hre : (toC zs[i]).re = zs[i].1 := by simp [toC]
  have him : (toC zs[i]).im = zs[i].2 := by simp [toC]
  constructor
  · apply k; rw [← hre]; exact (Complex.abs_re_le_norm _).trans hz
  · apply k; rw [← him]; exact (Complex.abs_im_le_norm _).trans hz

/-! ## The truncation pass -/

end NLogN.KFH

