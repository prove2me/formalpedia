  have hFN : F N = Function.update f X lx := by simp only [F, hN, List.drop_length, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by simp only [F, Function.update_apply, if_neg hXC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (.pop X) (encK s (Function.update (F k) C [(N : ℤ) - k]))
