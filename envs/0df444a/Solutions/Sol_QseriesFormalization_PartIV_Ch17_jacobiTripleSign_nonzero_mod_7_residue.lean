    · left; exact h0
    · right; left; exact h1
    · right; right; exact h3
    · -- (n : ZMod 7) = 6.  Then k mod 7 = 3, so jts ≡ 0 mod 7.  Contradicts h.
      exfalso
      apply h
      rw [hk_eq, jacobiTripleSign_triangular]
