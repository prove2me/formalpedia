-- Source module: Solutions.J6SegLn5
/-!
# Segmented inverse (S2), machine side 5: the coefficient streams of the backward kernel

For a sorted line `L` and a border predicate `bd` (border positions: the cyclic wrap), the
back-substitution sum of row `r` splits into

* a band part over the next `W` rows (`cbOf W r`, zero on border rows and off the pattern), and
* a border part over all later border rows (`czOf r`, against `accB` with flags `flOf`).

**`hsplit_of`**: the split is exact (the hypothesis of `bwdK_eq`), given the window property
`hwin`: a non-border pattern entry `(L_r, L_q)` with `r < q` has `q ≤ r + W`.
**`win_of_band`**: for a strictly increasing `L`, a band of half-width `W` in positions gives
the window `W` in indices.
-/

open Finset

namespace J6Seg

section split
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ)
  (bd : ℕ → Prop) [DecidablePred bd]

variable {P S L A bd}

lemma sum_getD_list (l : List ℕ) (f : ℕ → ℤ) :
    ∑ i ∈ range l.length, f (l.getD i 0) = (l.map f).sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    rw [List.length_cons, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, List.map_cons, List.sum_cons]
    rw [ih]; ring

lemma getD_range_map_any {n u : ℕ} {f : ℕ → ℤ} (hu : u < n) :
    ((List.range n).map f).getD u 0 = f u := by
  rw [List.getD_eq_getElem _ _ (by simp; omega)]; simp

lemma fmul_ite (c : Prop) [Decidable c] (a z : ℤ) :
    fmul P (if c then a else 0) z = if c then fmul P a z else 0 := by
  split_ifs
  · rfl
  · exact fmul_zero_left P z

lemma getD_map_lt {l : List ℕ} {f : ℕ → ℤ} {i : ℕ} (hi : i < l.length) :
    (l.map f).getD i 0 = f (l.getD i 0) := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getD_eq_getElem _ _ hi, List.getElem_map]

/-- **The coefficient split of the back-substitution sum.** -/
theorem hsplit_of_sol_aux (b : ℕ → ℤ) (W : ℕ) (hsort : L.Pairwise (· < ·)) (r : ℕ) (hr : r < L.length)
    (hwin : ∀ q, r < q → q < L.length → ¬ bd (L.getD q 0) → S (L.getD r 0) (L.getD q 0) →
      q ≤ r + W) :
    bsum P S L A b r = dotF P (cbOf P S L A bd W r) (accZ P S L A b (r + 1)) +
      dotF P (czOf P S L A bd r) (accB P S L A b (flOf L bd) (r + 1)) := by
  have hget : ∀ i j, i < L.length → j < L.length → i < j → L.getD i 0 < L.getD j 0 := by
    intro i j hi hj hij
    rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj]
    exact (List.pairwise_iff_getElem.1 hsort) i j hi hj hij
  have hinj : ∀ i j, i < L.length → j < L.length → L.getD i 0 = L.getD j 0 → i = j := by
    intro i j hi hj he
    rcases lt_trichotomy i j with h | h | h
    · exact absurd he (ne_of_lt (hget i j hi hj h))
    · exact h
    · exact absurd he (ne_of_gt (hget j i hj hi h))
  -- the sum over positions as a sum over indices
  set F : ℕ → ℤ := fun q => if S (L.getD r 0) (L.getD q 0) then
    fmul P (Aseq P S L A r (L.getD r 0) (L.getD q 0)) (zW P S L A b q) else 0 with hF
  have hset : (L.drop (r + 1)).toFinset = (Ico (r + 1) L.length).image (fun q => L.getD q 0) := by
    ext x
    simp only [List.mem_toFinset, Finset.mem_image, Finset.mem_Ico, List.mem_iff_getElem,
      List.length_drop, List.getElem_drop]
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨r + 1 + i, ⟨by omega, by omega⟩, by rw [List.getD_eq_getElem _ _ (by omega)]⟩
    · rintro ⟨q, ⟨h1, h2⟩, rfl⟩
      refine ⟨q - (r + 1), by omega, ?_⟩
      rw [List.getD_eq_getElem _ _ h2]
      have : r + 1 + (q - (r + 1)) = q := by omega
      simp only [this]
  have h1 : bsum P S L A b r = ∑ q ∈ Ico (r + 1) L.length, F q := by
    unfold bsum
    rw [Finset.sum_filter, hset, Finset.sum_image (fun i hi j hj he =>
      hinj i j (Finset.mem_Ico.1 (Finset.mem_coe.1 hi)).2 (Finset.mem_Ico.1 (Finset.mem_coe.1 hj)).2 he)]
    rfl
  rw [h1]
  have h2 : ∑ q ∈ Ico (r + 1) L.length, F q = ∑ q ∈ Ico (r + 1) L.length, (if bd (L.getD q 0) then 0 else F q)
      + ∑ q ∈ Ico (r + 1) L.length, (if bd (L.getD q 0) then F q else 0) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    split_ifs <;> simp
  rw [h2]
  congr 1
  · -- band part
    set K : ℕ → ℤ := fun i => fmul P ((cbOf P S L A bd W r).getD i 0)
      ((accZ P S L A b (r + 1)).getD i 0) with hK
    have hKin : ∀ i, r + 1 + i < L.length → K i =
        (if bd (L.getD (r + 1 + i) 0) then 0 else F (r + 1 + i)) ∨ W ≤ i := by
      intro i hi
      by_cases hiW : W ≤ i
      · exact Or.inr hiW
      left
      simp only [hK, hF]
      rw [cbOf, getD_range_map_any (by omega)]
      have hz : (accZ P S L A b (r + 1)).getD i 0 = zW P S L A b (r + 1 + i) := by
        unfold accZ
        rw [List.getD_eq_getElem _ _ (by simp; omega)]
        simp [List.getElem_range']
      rw [hz, fmul_ite]
      by_cases hb : bd (L.getD (r + 1 + i) 0)
      · rw [if_neg (fun h => h.2.1 hb), if_pos hb]
      · by_cases hS : S (L.getD r 0) (L.getD (r + 1 + i) 0)
        · rw [if_pos ⟨hi, hb, hS⟩, if_neg hb, if_pos hS]
        · rw [if_neg (fun h => hS h.2.2), if_neg hb, if_neg hS]
    have hKout : ∀ i, L.length ≤ r + 1 + i → K i = 0 := by
      intro i hi
      simp only [hK]
      have : (accZ P S L A b (r + 1)).getD i 0 = 0 := by
        unfold accZ
        rw [List.getD_eq_default _ _ (by simp; omega)]
      rw [this, fmul_zero_right]
    have hKW : ∀ i, W ≤ i → K i = 0 := by
      intro i hi
      simp only [hK]
      rw [List.getD_eq_default _ _ (by simp [cbOf]; omega), fmul_zero_left]
    have hG0 : ∀ i, W ≤ i → r + 1 + i < L.length →
        (if bd (L.getD (r + 1 + i) 0) then 0 else F (r + 1 + i)) = 0 := by
      intro i hi him
      by_cases hb : bd (L.getD (r + 1 + i) 0)
      · rw [if_pos hb]
      · simp only [hb, if_false, hF]
        rw [if_neg]
        intro hS
        have := hwin (r + 1 + i) (by omega) him hb hS
        omega
    unfold dotF
    rw [Finset.sum_Ico_eq_sum_range]
    have hlen : (cbOf P S L A bd W r).length = W := by simp [cbOf]
    rw [hlen]
    -- both sides equal the sum of `K` over `range (L.length - (r+1) + W)`
    have eL : ∑ i ∈ range (L.length - (r + 1)),
        (if bd (L.getD (r + 1 + i) 0) then 0 else F (r + 1 + i)) =
        ∑ i ∈ range (L.length - (r + 1) + W), K i := by
      rw [← Finset.sum_range_add_sum_Ico _ (show L.length - (r + 1) ≤ L.length - (r + 1) + W by omega)]
      rw [Finset.sum_eq_zero (s := Ico _ _) (fun i hi => by
        simp only [Finset.mem_Ico] at hi; exact hKout i (by omega)), add_zero]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      simp only [Finset.mem_range] at hi
      rcases hKin i (by omega) with h | h
      · exact h.symm
      · rw [hKW i h, hG0 i h (by omega)]
    have eR : ∑ i ∈ range W, K i = ∑ i ∈ range (L.length - (r + 1) + W), K i := by
      rw [← Finset.sum_range_add_sum_Ico _ (show W ≤ L.length - (r + 1) + W by omega)]
      rw [Finset.sum_eq_zero (s := Ico _ _) (fun i hi => by
        simp only [Finset.mem_Ico] at hi; exact hKW i hi.1), add_zero]
    rw [eL, eR]
  · -- border part
    unfold dotF
    have hlen : (czOf P S L A bd r).length = (bIdx L bd r).length := by simp [czOf]
    rw [hlen]
    have e1 : ∑ i ∈ range (bIdx L bd r).length, fmul P ((czOf P S L A bd r).getD i 0)
        ((accB P S L A b (flOf L bd) (r + 1)).getD i 0) =
        ∑ i ∈ range (bIdx L bd r).length, F ((bIdx L bd r).getD i 0) := by
      refine Finset.sum_congr rfl (fun i hi => ?_)
      simp only [Finset.mem_range] at hi
      have ea : (accB P S L A b (flOf L bd) (r + 1)) = (bIdx L bd r).map (zW P S L A b) := rfl
      rw [ea, czOf, getD_map_lt hi, getD_map_lt hi, fmul_ite]
      all_goals rfl
    have hnd : (bIdx L bd r).Nodup := by
      unfold bIdx
      first
        | exact List.Nodup.filter _ List.nodup_range'
        | exact List.Nodup.filter _ (List.nodup_range' _ _)
        | simp [List.Nodup.filter, List.nodup_range']
    rw [e1, sum_getD_list, ← List.sum_toFinset _ hnd]
    have hfs : (bIdx L bd r).toFinset = (Ico (r + 1) L.length).filter (fun q => bd (L.getD q 0)) := by
      ext q
      simp only [bIdx, List.mem_toFinset, List.mem_filter, List.mem_range', Finset.mem_filter,
        Finset.mem_Ico, flOf, decide_eq_true_eq]
      constructor
      · rintro ⟨⟨i, hi, rfl⟩, h⟩
        refine ⟨⟨by omega, by omega⟩, ?_⟩
        by_contra hb; simp only [if_neg hb] at h; simp at h
      · rintro ⟨⟨h1, h2⟩, h⟩
        exact ⟨⟨q - (r + 1), by omega, by omega⟩, by simp only [if_pos h]; decide⟩
    rw [hfs, Finset.sum_filter]

end split

end J6Seg

end

theorem solution : type_of% @J6Seg.hsplit_of_sol_aux := @J6Seg.hsplit_of_sol_aux
