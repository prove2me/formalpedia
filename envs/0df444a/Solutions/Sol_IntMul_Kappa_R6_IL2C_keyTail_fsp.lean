-- Source module: Solutions.R6IL2CKeyRunA
/-!
# Round six, compact controls (I2C): the run of the key program, part A

Definitions and the six pushes of `keyProgC` (`keyPush_fsp`, continuation style).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

theorem scv (Q S v k : ℕ) : (k : ℤ) / ((Q : ℤ) * S) * ((Q : ℤ) * S) + (v : ℤ) * S + (k : ℤ) % S =
    ((sc Q S v k : ℕ) : ℤ) := by
  unfold sc; push_cast; rfl

section Ex

variable {t : IState HS} {Bb : ℕ}

theorem eSc {rQ rS rv rn : Fin HS} {Q S v k M : ℕ} {LQ LS Lv Lk : List Item}
    (hQ : t.G rQ = .int (Q : ℤ) :: LQ) (hS : t.G rS = .int (S : ℤ) :: LS)
    (hv : t.G rv = .int (v : ℤ) :: Lv) (hk : t.G rn = .int (k : ℤ) :: Lk)
    (hrQ : rQ.val < 56) (hrS : rS.val < 56) (hrv : rv.val < 56) (hrn : rn.val < 56)
    (hS0 : 0 < S) (hQ0 : 0 < Q) (hvQ : v < Q) (hkM : k ≤ M) (hQS : Q * S ≤ M)
    (zB : ∀ z : ℕ, z ≤ 3 * M → zsz (z : ℤ) ≤ Bb) :
    ESp (scK rQ rS rv rn) t Bb ((sc Q S v k : ℕ) : ℤ) := by
  rw [← scv]
  have hQS0 : 0 < Q * S := Nat.mul_pos hQ0 hS0
  have zQ := zB Q (by nlinarith)
  have zS := zB S (by nlinarith)
  have zk := zB k (by omega)
  have EQ := ESp.ofG' (Bb := Bb) hQ hrQ zQ
  have ES := ESp.ofG' (Bb := Bb) hS hrS zS
  have Ek := ESp.ofG' (Bb := Bb) hk hrn zk
  have Ev := ESp.ofG' (Bb := Bb) hv hrv (zB v (by nlinarith))
  have EQS := ESp.mul EQ ES (by have := zB (Q * S) (by omega); push_cast at this; exact this)
  have e1 : (k : ℤ) / ((Q : ℤ) * S) = ((k / (Q * S) : ℕ) : ℤ) := by push_cast; rfl
  have E1 := ESp.ndiv Ek EQS (by positivity) (by positivity)
    (by rw [e1]; exact zB _ (le_trans (Nat.div_le_self _ _) (by omega)))
  have h2 : k / (Q * S) * (Q * S) ≤ k := Nat.div_mul_le_self _ _
  have E2 := ESp.mul E1 EQS (by
    rw [e1]; have := zB (k / (Q * S) * (Q * S)) (by omega); push_cast at this; exact this)
  have hvS : v * S ≤ Q * S := Nat.mul_le_mul_right _ hvQ.le
  have E3 := ESp.mul Ev ES (by have := zB (v * S) (by omega); push_cast at this; exact this)
  have E4 := ESp.add E2 E3 (by
    rw [e1]; have := zB (k / (Q * S) * (Q * S) + v * S) (by omega); push_cast at this; exact this)
  have e5 : (k : ℤ) % (S : ℤ) = ((k % S : ℕ) : ℤ) := by push_cast; rfl
  have E5 := ESp.nmod Ek ES (by positivity) (by positivity)
    (by rw [e5]; exact zB _ (le_trans (Nat.mod_le _ _) (by omega)))
  have hk3 : k % S ≤ k := Nat.mod_le _ _
  exact ESp.add E4 E5 (by
    rw [e1, e5]
    have := zB (k / (Q * S) * (Q * S) + v * S + k % S) (by omega); push_cast at this; exact this)

end Ex

