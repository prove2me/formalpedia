theorem resEquiv_residue {R : Type} [CommRing R] [IsLocalRing R] {k : Type} [Field k]
    (resR : R →+* k) (hresR : Function.Surjective resR) (hkerR : RingHom.ker resR = maximalIdeal R) (r : R) :
    resEquiv resR hresR hkerR (residue R r) = resR r :=
  Ideal.Quotient.lift_mk (maximalIdeal R) resR (fun r hr => by rwa [← hkerR, RingHom.mem_ker] at hr)

