-- title:
--   Rule (3.6) gives $(k+1)\gamma_k \to 1/(\mu_C\eta + \mu_B)$
-- statement:
--   Let $\mu_B \ge 0$, $\mu_C > 0$, $\eta \in (0,1)$ and $\gamma_0 > 0$, and let $(\gamma_k)_{k \ge 0}$ be generated by the stepsize rule (3.6). Then
--   $$\lim_{k \to \infty} (k+1)\gamma_k = \frac{1}{\mu_C\eta + \mu_B}.$$
--
--   Hence $\gamma_k^2 = O(1/(k+1)^2)$, which turns the telescoped form of (3.9) into the rate of Theorem 3.3, Part 1.
-- source:
--   Davis and Yin, A Three-Operator Splitting Scheme and its Optimization Applications, Set-Valued Var. Anal. 25 (2017), https://doi.org/10.1007/s11228-017-0421-z, p. 845, Section 3.3, proof of Theorem 3.3, Part 1 (unnumbered display)

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_Stepsizes

open Filter Topology

namespace ThreeOpSplitting.Accel

/-- Proof of Theorem 3.3, Part 1 (p. 845): for the stepsizes (3.6),
`lim_{k→∞} (k + 1)γ_k = 1/(μ_Cη + μ_B)`. -/
theorem stepsize_limit_part1 (μB μC η γ0 : ℝ)
    (hμB : 0 ≤ μB) (hμC : 0 < μC) (hη0 : 0 < η) (hη1 : η < 1) (hγ0 : 0 < γ0) :
    Tendsto (fun k : ℕ => ((k : ℝ) + 1) * stepsPart1 μB μC η γ0 k) atTop
      (𝓝 (1 / (μC * η + μB))) := by sorry

end ThreeOpSplitting.Accel
