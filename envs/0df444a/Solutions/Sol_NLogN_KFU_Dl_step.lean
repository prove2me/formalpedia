-- Source module: Solutions.KFURevBase
/-!
# KFU §3: labelled layouts for the axis reversal

Addresses of the working array are tracked through *layouts*: lists of atom labels (`2j` is the
main part of axis `j`, of size `mz j`; `2j+1` is its extra bit, of size `2`, present when
`bg j`).  An axis of size `tz j = mz j · (2 if bg j)` is the pair `[mz j, 2]` in row-major order.

* `Dl ax0 lay xs`: the array `xs` (shape `ax0.map tz`) viewed in the layout `lay`.
* `POp g σ n`: an address map `g = permIdx σ` on `n` digits, `σ` onto `[0, n)`.
* `Dl_step`: a program realizing `pull (g lay').map asz → lay'.map asz` by `g` turns
  `Dl ax0 (g lay')` into `Dl ax0 lay'`.  `swapPos` and `KIL.swapMid` are `POp`s.
* `Dl_layA`: for the standard layout `layA ax` of an axis order `ax`, `Dl` is an ordinary pull
  onto `ax.map tz`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFU

open AModel AModelL12

/-! ## Position permutations -/

theorem POp.getElem {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ} (hP : POp g σ n) {b : List ℕ}
    (hb : b.length = n) {i : ℕ} (hi : i < (g b).length) :
    (g b)[i] = b[σ i]'(by rw [hb]; exact hP.lt i (by rw [hP.length hb] at hi; exact hi)) := by
  have hi' : i < n := by rw [hP.length hb] at hi; exact hi
  simp only [hP.eq b hb, getElem_permIdx]
  rw [List.getD_eq_getElem _ _ (by rw [hb]; exact hP.lt i hi')]

theorem POp.nodup {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ} (hP : POp g σ n) {l : List ℕ}
    (hl : l.length = n) (hnd : (g l).Nodup) : l.Nodup := by
  rw [List.nodup_iff_injective_get]
  intro ⟨j1, h1⟩ ⟨j2, h2⟩ he
  simp only [List.get_eq_getElem] at he
  obtain ⟨i1, hi1, rfl⟩ := hP.surj j1 (by omega)
  obtain ⟨i2, hi2, rfl⟩ := hP.surj j2 (by omega)
  have g1 := hP.getElem hl (i := i1) (by rw [hP.length hl]; exact hi1)
  have g2 := hP.getElem hl (i := i2) (by rw [hP.length hl]; exact hi2)
  have : (g l)[i1]'(by rw [hP.length hl]; exact hi1) = (g l)[i2]'(by rw [hP.length hl]; exact hi2) := by
    rw [g1, g2]; exact he
  have := (List.Nodup.getElem_inj_iff hnd).1 this
  subst this; rfl

