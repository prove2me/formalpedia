section linAlg

lemma exists_smul_mem_span {S M ι : Type} [CommRing S] [Nontrivial S] [AddCommGroup M] [Module S M]
    [Module.Finite S M] [Fintype ι]
    (v : ι → M) (hv : LinearIndependent S v) (hcard : Module.finrank S M ≤ Fintype.card ι) (x : M) :
    ∃ c : S, c ≠ 0 ∧ c • x ∈ Submodule.span S (Set.range v) := by
  classical
  let w : Option ι → M := fun o => o.elim x v
  have hdep : ¬ LinearIndependent S w := by
    intro hw
    have := hw.fintype_card_le_finrank
    rw [Fintype.card_option] at this
    omega
  rw [Fintype.not_linearIndependent_iff] at hdep
  obtain ⟨g, hg, i, hi⟩ := hdep
  rw [Fintype.sum_option] at hg
  have hg0 : g none ≠ 0 := by
    intro h0
    rw [h0, zero_smul, _root_.zero_add] at hg
    have hall : ∀ j, g (some j) = 0 := Fintype.linearIndependent_iff.1 hv (fun j => g (some j)) hg
    cases i with
    | none => exact hi h0
    | some j => exact hi (hall j)
  refine ⟨g none, hg0, ?_⟩
  have : g none • x = -(∑ j, g (some j) • v j) := by
    rw [eq_neg_iff_add_eq_zero]; exact hg
  rw [this]
  refine Submodule.neg_mem _ (Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ ?_)
  exact Submodule.subset_span ⟨j, rfl⟩

end linAlg

section squeeze

lemma surjective_of_isIntegrallyClosed {D R : Type} [CommRing D] [IsDomain D] [IsIntegrallyClosed D]
    [CommRing R] [IsDomain R] (φ : D →+* R) (hφ : Function.Injective φ)
    (hint : ∀ r : R, ∃ p : D[X], p.Monic ∧ p.eval₂ φ r = 0)
    (hfrac : ∀ r : R, ∃ d a : D, φ d ≠ 0 ∧ φ d * r = φ a) :
    Function.Surjective φ := by
  classical
  letI : Algebra D R := φ.toAlgebra
  let L := FractionRing R
  let ι : R →+* L := algebraMap R L
  have hι : Function.Injective ι := IsFractionRing.injective R L
  have halg : algebraMap D L = ι.comp φ := IsScalarTower.algebraMap_eq D R L

  haveI : IsFractionRing D L := by
    refine ⟨⟨?_, ?_, ?_⟩⟩
    · rintro ⟨y, hy⟩
      have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
      have : (algebraMap D L y) ≠ 0 := by
        rw [halg]
        change ι (φ y) ≠ 0
        exact fun h => hy0 (hφ (by rw [map_zero]; exact hι (by rw [map_zero]; exact h)))
      exact isUnit_iff_ne_zero.mpr this
    · intro z
      obtain ⟨r₁, r₂, hr₂, rfl⟩ := IsFractionRing.div_surjective (A := R) z
      obtain ⟨d₁, a₁, hd₁, h₁⟩ := hfrac r₁
      obtain ⟨d₂, a₂, hd₂, h₂⟩ := hfrac r₂
      have hr₂0 : r₂ ≠ 0 := nonZeroDivisors.ne_zero hr₂
      have ha₂ : a₂ ≠ 0 := by
        intro h; apply mul_ne_zero hd₂ hr₂0; rw [h₂, h, map_zero]
      have hd₁0 : d₁ ≠ 0 := fun h => hd₁ (by rw [h, map_zero])
      refine ⟨⟨d₂ * a₁, ⟨d₁ * a₂, mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hd₁0 ha₂)⟩⟩, ?_⟩
      simp only [halg]
      change ι r₁ / ι r₂ * ι (φ (d₁ * a₂)) = ι (φ (d₂ * a₁))
      have hιr₂ : ι r₂ ≠ 0 := fun h => hr₂0 (hι (by rw [map_zero]; exact h))
      rw [map_mul, map_mul, map_mul, map_mul, ← h₁, ← h₂, map_mul, map_mul]
      have e1 : ι r₁ / ι r₂ * (ι (φ d₁) * (ι (φ d₂) * ι r₂)) = ι r₁ * ι (φ d₁) * ι (φ d₂) * (ι r₂ / ι r₂) := by
        ring
      rw [e1, div_self hιr₂, mul_one]; ring
    · intro x y hxy
      refine ⟨1, ?_⟩
      rw [halg] at hxy
      have : φ x = φ y := hι hxy
      rw [hφ this]
  intro r

  obtain ⟨p, hp, hpr⟩ := hint r
  have hintL : IsIntegral D (ι r) := by
    refine ⟨p, hp, ?_⟩
    rw [halg, ← Polynomial.hom_eval₂, hpr, map_zero]
  obtain ⟨y, hy⟩ := (isIntegrallyClosed_iff L).1 (inferInstance : IsIntegrallyClosed D) hintL
  exact ⟨y, hι hy⟩

end squeeze

section Dquot

variable {S : Type} [CommRing S]

lemma isDomain_adjoinRoot_quotient_span_root (h : S[X])
    (hdom : IsDomain (S ⧸ Ideal.span {h.coeff 0})) :
    IsDomain (AdjoinRoot h ⧸ Ideal.span {AdjoinRoot.root h}) := by
  classical
  let χ : AdjoinRoot h →+* S ⧸ Ideal.span {h.coeff 0} :=
    AdjoinRoot.lift (Ideal.Quotient.mk _) 0 (by
      rw [eval₂_at_zero, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.subset_span rfl)
  have hχsurj : Function.Surjective χ := by
    intro y
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨AdjoinRoot.of h s, by simp [χ, AdjoinRoot.lift_of]⟩
  have hof0 : AdjoinRoot.of h (h.coeff 0) ∈ Ideal.span {AdjoinRoot.root h} := by
    have hh : AdjoinRoot.mk h (X * h.divX + C (h.coeff 0)) = 0 := by rw [X_mul_divX_add]; exact AdjoinRoot.mk_self
    rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C] at hh
    have : AdjoinRoot.of h (h.coeff 0) = -(AdjoinRoot.root h * AdjoinRoot.mk h h.divX) := by
      rw [eq_neg_iff_add_eq_zero, add_comm]; exact hh
    rw [this]
    exact neg_mem (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl))
  have hker : RingHom.ker χ = Ideal.span {AdjoinRoot.root h} := by
    apply le_antisymm
    · intro d hd
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective d
      rw [RingHom.mem_ker] at hd
      simp only [χ, AdjoinRoot.lift_mk, eval₂_at_zero, Ideal.Quotient.eq_zero_iff_mem,
        Ideal.mem_span_singleton] at hd
      obtain ⟨s, hs⟩ := hd
      rw [← X_mul_divX_add p, map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, hs, map_mul]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)) ?_
      exact Ideal.mul_mem_right _ _ hof0
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [χ, AdjoinRoot.lift_root]
  rw [← hker]
  exact MulEquiv.isDomain (S ⧸ Ideal.span {h.coeff 0}) (RingHom.quotientKerEquivOfSurjective hχsurj).toMulEquiv

end Dquot

