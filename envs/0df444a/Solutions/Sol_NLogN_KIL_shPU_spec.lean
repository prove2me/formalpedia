variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
theorem solution [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : AModel.Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : NLogN.IState NLogN.HS) (xs : List ℤ) (Bb : ℕ) (R : List NLogN.Item)
    (hlen : xs.length = AModel.vol sh) (hb : NLogN.Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : NLogN.zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : AModel.vol (ac.map Prod.fst) = AModel.vol A) (htbl : NLogN.KIL.tbl Q ac = NLogN.KIL.tbl Q (A.zip (NLogN.KIL.csOf Λ c A)))
    {LA LC LM LAM LN LP LQ LC' : List NLogN.Item}
    (hS : NLogN.KIL.StgOK t Q ac LA LC LM LAM) (hNQ : t.G NLogN.KIL.sNQ = .int (-(Q : ℤ)) :: LN)
    (hPA : t.G NLogN.KIL.sPA = .int (AModel.vol A : ℤ) :: LP) (hQQ : t.G NLogN.KIL.sQQ = .int (Q : ℤ) :: LQ)
    (hPC : t.G NLogN.KIL.sPC = .int (AModel.vol C : ℤ) :: LC') :
    NLogN.KIL.Sp (NLogN.KIL.shPU ac.length) t (NLogN.KIL.postSt t (AModel.shiftArr Λ i 1 c 0 xs) R LA LC LM LAM)
      (NLogN.KIL.cShiftUU ac.length (AModel.vol A * (Q * AModel.vol C)) Bb) := by
  have H := NLogN.KIL.sh_generic NLogN.KIL.rotP _ A C t xs (AModel.shiftArr Λ i 1 c 0 xs) Bb R hB1 hQ1 hP1 hV hQ2 h0 ac hac
    hvol hS hNQ hPA hQQ hPC (fun u h0' h1 h2 h4 h14 => NLogN.KIL.rotP_shift_spec Λ i c hc A C hsh hA u xs Bb
      R (t.G 1) (t.G 2) (t.G 4) (t.G 14) hlen hb hB1 hQ1 hP1 hV h0' h1 h2 h4
      (by rw [h14, htbl, NLogN.KIL.tbl_eq_offs]))
  refine H.mono (NLogN.KIL.sh_cost (VA := AModel.vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega)
    (by omega))) (Nat.zero_le _)
    (Nat.add_le_add_right (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by norm_num))) _) ?_)
  rw [← hvol]; exact NLogN.KIL.stCost_le_vol (fun p hp => (hac p hp).1)
end
