      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(13/6250:ℝ)^2/24 < 2*(83/400:ℝ)/(1-(83/400:ℝ)^2)^2)
