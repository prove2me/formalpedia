section
-- Source module: NLogN.HRspEM
/-!
# The banded pass `resL` computes `Eapprox` and `Dapprox` (componentwise)
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN

/-- Steps `[0, 1, …, 1]` (length `s`): output `l` reads from position `l`. -/
def eDel (s : ℕ) : List ℕ := (List.range s).map fun l => if l = 0 then 0 else 1

/-- The `eTerm` weight of offset `i` (`h = i - m`) for output `l` (`0` for `h = 0`). -/
def eW (p s t α i l : ℕ) : ℤ :=
  if i = HvdH.eWidth p α then 0 else
    HvdH.expNeg p (s ^ 2) (α ^ 2 * (HvdH.eKz s t l ((i : ℤ) - (HvdH.eWidth p α : ℤ))).toNat)

def eTab (p s t α : ℕ) : List (List ℤ) :=
  (List.range (2 * HvdH.eWidth p α + 1)).map fun i => (List.range s).map fun l => NLogN.Rsp.eW p s t α i l

/-- The list form of `Eapprox` on a slice of length `s`. -/
def eapL (p s t α : ℕ) (u : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map (HvdH.Eapprox p s t α fun j => u.getD j (0, 0))

/-! ## `Dapprox` -/

/-- The single-row table of `dTilde`. -/
def dTab (p s t α : ℕ) : List (List ℤ) := [(List.range s).map (HvdH.dTilde p s t α)]

def dapL (p s t α : ℕ) (u : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map (HvdH.Dapprox p s t α fun j => u.getD j (0, 0))

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspJ1
/-!
# Pointwise loops on integer lists: halving, signed accumulation
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-! ## halving -/

def hBody (X T : Fin HS) : RS := NLogN.RS.seq (push T (.quo (.reg X) (.lit 2))) (pop X)

def halfLoop (X T C : Fin HS) (n : Ex HS) : RS := rep C n (hBody X T)

def hSt (X T : Fin HS) (s : IState HS) (L : List ℤ) (R : List Item) (j : ℕ) : IState HS :=
  (s.upd X (ints (L.drop j) ++ R)).upd T (ints ((L.take j).map fun x => x.tdiv 2).reverse ++ s.G T)

/-- Halve every entry (rounding towards zero) of the `n`-list on `X` (`n` on `K`). -/
def halfP (X T C K : Fin HS) : RS := NLogN.RS.seq (halfLoop X T C (.reg K)) (mvK T X C (.reg K))

/-! ## signed accumulation `A += ±X` -/

def sgF (ng : Bool) (a w : ℤ) : ℤ := a + (if ng then -w else w)

def sgV (ng : Bool) : ℤ := if ng then -1 else 1

def aE (X A Sg : Fin HS) : Ex HS := .add (.reg A) (.sel (.reg Sg) (.neg (.reg X)) (.reg X))

def aBody (X A Sg T W : Fin HS) : RS :=
  NLogN.RS.seq (push T (NLogN.Rsp.aE X A Sg)) (NLogN.RS.seq (pop A) (NLogN.RS.seq (push W (.reg X)) (pop X)))

structure Dist6 (X A Sg T W C : Fin HS) : Prop where
  d : [X, A, Sg, T, W, C].Nodup
  lt : ∀ i ∈ [X, A, Sg, T, W, C], i.val < 56

def aSt (X A T W : Fin HS) (s : IState HS) (ng : Bool) (Lw La : List ℤ) (RX RA : List Item)
    (j : ℕ) : IState HS :=
  (((s.upd X (ints (Lw.drop j) ++ RX)).upd A (ints (La.drop j) ++ RA)).upd T
    (ints ((List.zipWith (sgF ng) La Lw).take j).reverse ++ s.G T)).upd W
    (ints (Lw.take j).reverse ++ s.G W)

/-- `A += ±X` pointwise (sign from `Sg`: `-1` subtracts), lists of length `n` on `K`;
`X` is restored. -/
def addP (X A Sg T W C K : Fin HS) : RS :=
  NLogN.RS.seq (rep C (.reg K) (aBody X A Sg T W)) (NLogN.RS.seq (mvK T A C (.reg K)) (mvK W X C (.reg K)))

/-- Cost bound of `addP`. -/
def addCost (n B : ℕ) : ℕ := 3 * (4000 * (B + 2) + n * (40000 * (B + 2)) + 32)

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspJM
/-!
# List form of `Japprox`: iterates `vL`, alternating partial sums `accL`
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN

def halfL (u : List (ℤ × ℤ)) : List (ℤ × ℤ) := u.map fun z => (z.1.tdiv 2, z.2.tdiv 2)

/-- Pointwise `a ± w` on Gaussian lists. -/
def gsgF (ng : Bool) (a w : ℤ × ℤ) : ℤ × ℤ := (sgF ng a.1 w.1, sgF ng a.2 w.2)

/-- The iterates `ṽ⁽ʲ⁾` as lists of length `s`. -/
def vL (p s t α : ℕ) (u : List (ℤ × ℤ)) : ℕ → List (ℤ × ℤ)
  | 0 => halfL u
  | j + 1 => eapL p s t α (vL p s t α u j)

/-- Alternating partial sums. -/
def accL (p s t α : ℕ) (u : List (ℤ × ℤ)) (n : ℕ) : List (ℤ × ℤ) :=
  (List.range s).map fun l =>
    (∑ j ∈ Finset.range n, (-1) ^ j * ((vL p s t α u j).getD l (0, 0)).1,
     ∑ j ∈ Finset.range n, (-1) ^ j * ((vL p s t α u j).getD l (0, 0)).2)

/-! ## agreement with `vIter` / `Japprox` -/

/-- The list form of `Japprox`. -/
def japL (p s t α : ℕ) (u : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map (HvdH.Japprox p s t α fun j => u.getD j (0, 0))

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspJ
/-!
# `Japprox` on a slice: the `E` pass (`gresP` against the `E` tables) iterated with signed
accumulation
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-- The registers / tables that `gresP` reads, set for the `E` pass. -/
structure EParams (σ : IState HS) (p s t α : ℕ) : Prop where
  ks : ∃ L, σ.G Ks = .int (s : ℤ) :: L
  ka : ∃ L, σ.G Ka = .int (sOff s (HvdH.eWidth p α) : ℤ) :: L
  kn : ∃ L, σ.G KN = .int ((s + (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) :: L
  br : ∃ L, σ.G BR = .int (2 ^ p) :: L
  bn : ∃ L, σ.G BN = .int (s : ℤ) :: L
  bnr : ∃ L, σ.G BNR = .int ((2 * HvdH.eWidth p α + 1 : ℕ) : ℤ) :: L
  bnw : ∃ L, σ.G BNW = .int ((s * (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) :: L
  bw : ∃ R, σ.G NLogN.Rsp.BW = ints (eTab p s t α).flatten ++ R
  bd : ∃ R, σ.G BD = ints ((eDel s).map (Nat.cast : ℕ → ℤ)) ++ R

/-- The stacks `EParams` depends on. -/
def eRegs : List (Fin HS) := [Ks, Ka, KN, BR, BN, BNR, BNW, NLogN.Rsp.BW, BD]

/-! ## The `J` loop -/

abbrev JA : Fin HS := 36
abbrev JT : Fin HS := 37
abbrev JW : Fin HS := 38
abbrev JS : Fin HS := 39
abbrev JC : Fin HS := 40
abbrev JN : Fin HS := 41
abbrev JK : Fin HS := 42
abbrev JL : Fin HS := 43

def jBody : RM :=
  RM.seqL [.rs (addP CU JA JS JT JW JK JL), gresP, .rs (asg JS (.neg (.reg JS)))]

def jSt (s1 : IState HS) (p s t α : ℕ) (u : List (ℤ × ℤ)) (RU RA LS : List Item) (j : ℕ) :
    IState HS :=
  ((s1.upd CU (gints (vL p s t α u j) ++ RU)).upd JA (ints (pairInts (accL p s t α u j)) ++ RA)).upd
    JS (.int (sgV (decide (j % 2 = 1))) :: LS)

/-- Cost of one round of the `J` loop. -/
def jRoundCost (s NR mm Φ B : ℕ) : ℕ :=
  addCost (2 * s) B + (gresCost s NR s mm Φ B 1 + 3 * 2000 * (B + 2))

/-- `Japprox` on the Gaussian slice on `CU` (length `s`; `JL = 2s`, `JN = n` rounds, `E`
parameters set). -/
def JP : RM :=
  RM.seqL [.rs (halfP CU JT JK JL), .rs (push JS (.lit 1)), .rs (NLogN.Rsp.zerosP JA JK (.reg JL)),
    .rep JC (.reg JN) jBody, .rs (popK CU JK (.reg JL)), .rs (mvK JA JT JK (.reg JL)),
    .rs (mvK JT CU JK (.reg JL)), .rs (pop JS)]

/-- Cost bound of `JP`. -/
def jCost (s NR n mm Φ B : ℕ) : ℕ :=
  10 * (4000 * (B + 2) + (2 * s) * (30000 * (B + 2)) + 32) +
    n * (jRoundCost s NR mm Φ B + 8000 * (B + 2) + 30)

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspStage
/-!
# A `gresP` stage with its scalar parameters pushed from expressions (and popped afterwards)
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-! ## congruence of expressions -/

/-! ## the stage -/

/-- Expressions for the seven scalar parameters of `gresP`. -/
structure SArgs where
  eKs : Ex HS
  eKa : Ex HS
  eKN : Ex HS
  eBR : Ex HS
  eBN : Ex HS
  eBNR : Ex HS
  eBNW : Ex HS

def SArgs.l (A : SArgs) : List (Ex HS) := [A.eKs, A.eKa, A.eKN, A.eBR, A.eBN, A.eBNR, A.eBNW]

def stTg : List (Fin HS) := [Ks, Ka, KN, BR, BN, BNR, BNW]

def pushesP (A : SArgs) : RS :=
  NLogN.RS.seq (push Ks A.eKs) (NLogN.RS.seq (push Ka A.eKa) (NLogN.RS.seq (push KN A.eKN) (NLogN.RS.seq (push BR A.eBR)
    (NLogN.RS.seq (push BN A.eBN) (NLogN.RS.seq (push BNR A.eBNR) (push BNW A.eBNW))))))

def popsP : RS :=
  NLogN.RS.seq (pop BNW) (NLogN.RS.seq (pop BNR) (NLogN.RS.seq (pop BN) (NLogN.RS.seq (pop BR) (NLogN.RS.seq (pop KN) (NLogN.RS.seq (pop Ka) (pop Ks))))))

/-- `gresP` with its parameters pushed from `A` (and popped afterwards). -/
def stageP (A : SArgs) : RM := .seq (.rs (pushesP A)) (.seq gresP (.rs popsP))

/-- Expressions read no target register. -/
def SArgs.Good (A : SArgs) : Prop := ∀ e ∈ A.l, ∀ i ∈ e.regs, i ∉ stTg ∧ i.val < 56

/-- The state after the pushes. -/
def pSt (s0 : IState HS) (v : Fin 7 → ℤ) : IState HS :=
  ((((((s0.upd Ks (.int (v 0) :: s0.G Ks)).upd Ka (.int (v 1) :: s0.G Ka)).upd KN
    (.int (v 2) :: s0.G KN)).upd BR (.int (v 3) :: s0.G BR)).upd BN (.int (v 4) :: s0.G BN)).upd
    BNR (.int (v 5) :: s0.G BNR)).upd BNW (.int (v 6) :: s0.G BNW)

def SArgs.v (A : SArgs) (s0 : IState HS) : Fin 7 → ℤ :=
  ![A.eKs.eval s0, A.eKa.eval s0, A.eKN.eval s0, A.eBR.eval s0, A.eBN.eval s0, A.eBNR.eval s0,
    A.eBNW.eval s0]

/-- The parameter expressions are linear, clean, defined and `B`-bounded at `s0`. -/
def SArgs.Fine (A : SArgs) (s0 : IState HS) (B : ℕ) : Prop :=
  ∀ e ∈ A.l, e.Clean ∧ e.Lin ∧ e.ok s0 ∧ e.Bnd s0 B ∧ e.size ≤ 3

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspBM
/-!
# List form of `bapL`: `ptL`, `cselL`, `japL`, `dapL`, `psL`
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN

/-! ## `C̃`: the gather `r_l = round(t l / s)` -/

/-- `r_l = ⌊(2 t l + s) / (2 s)⌋`. -/
def cR (s t l : ℕ) : ℕ := (2 * t * l + s) / (2 * s)

/-- Steps of `r`: `[r_0, r_1 - r_0, …]` (`r_0 = 0`). -/
def cDel (s t : ℕ) : List ℕ := (List.range s).map fun l => cR s t l - cR s t (l - 1)

/-- The (single-row) weight table of `C̃`: all ones. -/
def cTab (s : ℕ) : List (List ℤ) := [List.replicate s 1]

/-- List form of `C̃` (input length `t`, output length `s`). -/
def cselL (s t : ℕ) (v : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map fun l => v.getD (cR s t l) (0, 0)

/-! ## permutations as key lists for `permP` -/

def gRec (z : ℤ × ℤ) : List ℤ := [z.1, z.2]

/-- `P̃_t` as a list: `(P̃_t V)_k = V_{-sk mod t}`. -/
def ptL (s t : ℕ) (V : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range t).map fun (k : ℕ) => V.getD (-((s : ZMod t) * (k : ZMod t))).val (0, 0)

/-- Target index of record `j` for `P̃_t`: `-s⁻¹ j mod t`. -/
def ptKeys (s t : ℕ) : List ℕ :=
  (List.range t).map fun (j : ℕ) => (-((s : ZMod t)⁻¹ * (j : ZMod t))).val

/-- `P̃_s⁻¹` as a list: `(P̃_s⁻¹ W)_j = W_{t⁻¹ j mod s}`. -/
def psL (s t : ℕ) (W : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map fun (j : ℕ) => W.getD ((t : ZMod s)⁻¹ * (j : ZMod s)).val (0, 0)

/-- Target index of record `i` for `P̃_s⁻¹`: `t i mod s`. -/
def psKeys (s t : ℕ) : List ℕ := (List.range s).map fun i => t * i % s

/-! ## the composition -/

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspBap
/-!
# The `bapL` slice program

`bapP = P̃_s⁻¹ ∘ D̃' ∘ J̃' ∘ C̃ ∘ P̃_t` on the slice stack `CU`:
* `P̃_t`, `P̃_s⁻¹`: `permP 2` relocated (stack `0 ↔ CU`, key stack `3 ↔ KS`);
* `C̃`: a `gresP` stage with one all-ones weight row (tables relocated `BW ↔ W1`, `BD ↔ D1`);
* `J̃'`: `JP` (the `E` parameters / tables are the native ones);
* `D̃'`: a `gresP` stage with the diagonal table (relocated `BW ↔ W3`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-! ## relocated stages -/

/-- `σ` fixes `CU`, the parameter stacks and every register read by `A`. -/
def StFix (σ : Equiv.Perm (Fin HS)) (A : SArgs) : Prop :=
  σ CU = CU ∧ (∀ i ∈ stTg, σ i = i) ∧ ∀ e ∈ A.l, ∀ i ∈ e.regs, σ i = i

/-! ## registers and the program -/

/-- `s` (slice output length). -/
abbrev PS : Fin HS := 44
/-- `2^p`. -/
abbrev PR : Fin HS := 24
/-- The `P̃_s⁻¹` key list. -/
abbrev KS : Fin HS := 47
/-- The `C̃` weight table (all ones). -/
abbrev W1 : Fin HS := 46
/-- The `C̃` step table. -/
abbrev D1 : Fin HS := 45
/-- The `D̃'` weight table. -/
abbrev W3 : Fin HS := 0

/-- Parameters of the `C̃` stage: input length `t` (stack `1`), offset `0`, one row, `R = 1`. -/
def Ac : SArgs := ⟨.reg 1, .lit 0, .add (.reg 1) (.lit 1), .lit 1, .reg PS, .lit 1, .reg PS⟩

/-- Parameters of the `D̃'` stage. -/
def Ad : SArgs := ⟨.reg PS, .lit 0, .add (.reg PS) (.lit 1), .reg NLogN.Rsp.PR, .reg PS, .lit 1, .reg PS⟩

def σt : Equiv.Perm (Fin HS) := swapsPerm [(0, CU)]
def σs : Equiv.Perm (Fin HS) := swapsPerm [(0, CU), (3, KS)]
def σc : Equiv.Perm (Fin HS) := swapsPerm [(NLogN.Rsp.BW, W1), (BD, D1)]
def σd : Equiv.Perm (Fin HS) := swapsPerm [(NLogN.Rsp.BW, W3)]

/-- `P̃_t`: `permP` with the records on `CU`, `n = t` on `1`, `kb` on `2`, keys on `3`. -/
def ptP : RS := (permP 2).ren σt

/-- `P̃_s⁻¹`: `permP` with the records on `CU`, `n = s` pushed on `1`, `kb` on `2`, keys on `KS`. -/
def psP : RS := NLogN.RS.seq (push 1 (.reg PS)) (NLogN.RS.seq ((permP 2).ren σs) (pop 1))

/-- **The `bapL` slice program.** -/
def bapP : RM := RM.seqL [.rs ptP, (stageP Ac).ren σc, JP, (stageP Ad).ren σd, .rs psP]

/-! ## the precondition -/

/-- Parameter stacks and tables of `bapP` (all slice-independent, left intact). -/
structure BParams (σ : IState HS) (p s t α kb : ℕ) : Prop where
  pt : ∃ L, σ.G 1 = .int (t : ℤ) :: L
  pk : ∃ L, σ.G 2 = .int (kb : ℤ) :: L
  kt : ∃ R, σ.G 3 = natInts (ptKeys s t) ++ R
  ks : ∃ R, σ.G KS = natInts (psKeys s t) ++ R
  ps : ∃ L, σ.G PS = .int (s : ℤ) :: L
  pr : ∃ L, σ.G NLogN.Rsp.PR = .int (2 ^ p) :: L
  e : EParams σ p s t α
  jl : ∃ L, σ.G JL = .int ((2 * s : ℕ) : ℤ) :: L
  jn : ∃ L, σ.G JN = .int (HvdH.jIter p s t α : ℤ) :: L
  w1 : ∃ R, σ.G W1 = ints (cTab s).flatten ++ R
  d1 : ∃ R, σ.G D1 = ints ((cDel s t).map (Nat.cast : ℕ → ℤ)) ++ R
  w3 : ∃ R, σ.G W3 = ints (dTab p s t α).flatten ++ R

/-! ## run -/

/-! ## ok and cost -/

/-- Cost of one relocated `gresP` stage (pushes + `gresP` + pops). -/
def stCost (len NR n mm Φ B dmax : ℕ) : ℕ :=
  7 * (4 * 2000 * (B + 2)) + gresCost len NR n mm Φ B dmax + 7 * (2 * B + 2)

/-- Cost bound of `bapP`: two permutations, the `C̃` and `D̃'` stages and the `J̃'` loop. -/
def bapCost (p s t α kb mm Φ B : ℕ) : ℕ :=
  10 ^ 6 * (kb + 1) * (t + 1) * (2 + 1) * (B + kb + 2 + 4) +
  stCost t 1 s mm Φ B (t / s + 1) +
  jCost s (2 * HvdH.eWidth p α + 1) (HvdH.jIter p s t α) mm Φ B +
  stCost s 1 s mm Φ B 1 +
  (2 * 2000 * (B + 2) + 10 ^ 6 * (kb + 1) * (s + 1) * (2 + 1) * (B + kb + 2 + 4) + (2 * B + 2))

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspBTab
/-!
# Table builders for `bapP`

One-row tables built by `row1P T RK wP` (`TRI := 1` pushed, `tabP`, popped), with a single-push
weight program `push T e`:
* `cTabP` : `ints (cTab s).flatten` (all ones) on `W1`;
* `eDelP` : `ints (eDel s)` on `BD`;
* `cDelP` : `ints (cDel s t)` on `D1`;
* `psKeysP` : `natInts (psKeys s t)` on `KS`;
* `ptKeysP` : `natInts (ptKeys s t)` on `3` (needs `TU = (s⁻¹ mod t)`).
Scalars: `TS = s`, `TT = t`, `TU`; counters `TCI`, `TCK`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-- `s⁻¹ mod t` (for the `P̃_t` keys). -/
abbrev TU : Fin HS := 29

/-! ## generic one-row builder -/

def row1P (T RK : Fin HS) (wP : RS) : RS :=
  NLogN.RS.seq (push TRI (.lit 1)) (NLogN.RS.seq (tabP T TCI TCK TRI RK wP) (pop TRI))

/-! ## `cTab`: all ones -/

def cTabP : RS := row1P W1 TS (push W1 (.lit 1))

/-! ## `eDel` -/

def eDelE : Ex HS := .sel (.add (.reg TCK) (.lit (-2))) (.lit 0) (.lit 1)

def eDelP : RS := row1P BD TS (push BD eDelE)

/-! ## `cDel` -/

def kE1 : Ex HS := .add (.reg TCK) (.lit (-2))
def cRE : Ex HS := .ndiv (.add (.mul (.add (.reg NLogN.Rsp.TT) (.reg NLogN.Rsp.TT)) kE) (.reg TS)) (.add (.reg TS) (.reg TS))
def cRE1 : Ex HS :=
  .ndiv (.add (.mul (.add (.reg NLogN.Rsp.TT) (.reg NLogN.Rsp.TT)) kE1) (.reg TS)) (.add (.reg TS) (.reg TS))
def cDelE : Ex HS := .sel kE1 (.lit 0) (.add cRE (.neg cRE1))

def cDelP : RS := row1P D1 TS (push D1 cDelE)

/-! ## the permutation keys -/

