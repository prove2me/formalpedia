    (hT : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
        ((e (heckeGen ℓ • x)).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (X.vertexHecke ℓ).mulVec ((e x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) ∧
        ((e (heckeGen ℓ • x)).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (X.vertexHecke ℓ).mulVec ((e x).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ))
    (hU : ∀ x : Xo,
        ((e (heckeGen ⟨s, hs⟩ • x)).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) =
            (X.vertexHecke ⟨s, hs⟩).mulVec ((e x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) - ((e x).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) ∧
        ((e (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = ((s : ℕ) : ℤ) • ((e x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ))
    {Ψo : Type} [AddCommGroup Ψo] [Module HeckeAlg Ψo]
    (eΨ : Ψo ≃+ ribbonComponentGroup X.degeneracyData)
    (hΨ : ∀ (ℓ : Nat.Primes) (c : Ψo) (φ : Module.Dual ℤ ↥(ribbonKernel X.degeneracyData)),
        eΨ c = ribbonComponentGroupProj X.degeneracyData φ →
          eΨ (heckeGen ℓ • c) = ribbonComponentGroupProj X.degeneracyData (φ ∘ₗ heckeKernelMap X.heckeData ℓ))
    (𝔪 : Ideal HeckeAlg) [𝔪.IsMaximal] (heis : ¬ IsEventuallyEisenstein 𝔪) :
    Module.finrank (HeckeAlg ⧸ 𝔪) ↥(heckeTorsion Ψo 𝔪) ≤
      Module.finrank (HeckeAlg ⧸ 𝔪) (Xo ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Xo))) := by
  classical

  obtain ⟨n₁, hn₁, n₂, hn₂, padj, hpadj, hcommE, hcommV, hinter, hkerS, hsymE, hsymV, hn₁eq, hn₂eq, hfrobE, hfrobV, hadj⟩ :=
    ModularCurve.SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X

  obtain ⟨c3_1, c3_2, c3_3, c3_4, c3_5⟩ :=
    ModularCurve.SSLevelDatum.degeneracyMatrix_mulVec_padj_and_edgeHecke_companion_laws M s q' hs hq5 hsq' hq'M hsM A X padj hadj

  obtain ⟨cb_a, cb_b, cb_inv, cb_w, cb_U⟩ :=
    ModularCurve.SSLevelDatum.atkinLehnerPerm_swap_degeneracy_and_width_and_edgeHecke_adjoint M s q' hs hq5 hsq' hq'M hsM A X

  have honto := ModularCurve.SSLevelDatum.exists_mem_characterLattice_degeneracyMatrix_mulVec_eq_pair M s q' hs hq5 hsq' hq'M hsM A X

  have hPD : ∀ (N ℓ : ℕ) [NeZero N] [NeZero ℓ] [Fact ℓ.Prime],
      (N : (IsLocalRing.ResidueField ↥A)) ≠ 0 → (ℓ : (IsLocalRing.ResidueField ↥A)) ≠ 0 →
        AlgebraicCurve.HasPrincipalDivisors (IsLocalRing.ResidueField ↥A)
          ↥(charLDegeneracyRoof (IsLocalRing.ResidueField ↥A) N ℓ) :=
    fun N ℓ _ _ _ hN hℓ => ModularCurve.hasPrincipalDivisors_charLDegeneracyRoof (IsLocalRing.ResidueField ↥A) N ℓ hN hℓ
  obtain ⟨adjE, adjV, hcAE, hcAV, hAE, hAV, hdegAE, hdegAV, hkerAE, hinterA, hAEoff, hAVoff, hAVs, hAEs⟩ :=
    InstAdj.exists_widthAdjoint_pair M s q' hs hq5 hsq' hq'M hsM A X hPD
  have hdiv := fun (ℓ : Nat.Primes) (hℓ : ¬ (ℓ : ℕ) ∣ (M * q') * s) =>
    InstAdj.heckeOffDiagDivides_pair M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hℓ

  have hM0 : M ≠ 0 := NeZero.ne M
  have hq0 : q' ≠ 0 := (Fact.out : q'.Prime).ne_zero
  have hs0 : s ≠ 0 := hs.ne_zero
  have hmem : ∀ ℓ : Nat.Primes, ℓ ∈ badPrimes M s q' ↔ (ℓ : ℕ) ∣ (M * q') * s := mem_badPrimes_iff hM0 hq0 hs0
  have hsmem : (⟨s, hs⟩ : Nat.Primes) ∈ badPrimes M s q' := (hmem _).2 (dvd_mul_left s (M * q'))
  have hnot1 : ∀ ℓ : Nat.Primes, ℓ ∉ badPrimes M s q' → ¬ (ℓ : ℕ) ∣ (M * q') * s := fun ℓ h h' => h ((hmem ℓ).2 h')
  have hnot2 : ∀ ℓ : Nat.Primes, ℓ ∉ badPrimes M s q' → ¬ (ℓ : ℕ) ∣ M * q' := fun ℓ h h' => h ((hmem ℓ).2 (dvd_mul_of_dvd_left h' s))
  have hne_of : ∀ ℓ : Nat.Primes, ℓ ≠ ⟨s, hs⟩ → (ℓ : ℕ) ≠ s := fun ℓ h h' => h (Subtype.ext h')

  have Leqv : ∀ ℓ : Nat.Primes, ℓ ≠ ⟨s, hs⟩ → ∀ (i : Fin 2) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ),
      jointDelta X.degeneracyData i ((X.edgeHecke ℓ).mulVecLin x) = (X.vertexHecke ℓ).mulVecLin (jointDelta X.degeneracyData i x) := by
    intro ℓ hℓ i x
    rw [jointDelta_eq, jointDelta_eq, Matrix.mulVecLin_apply, Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
      hinter i ℓ (hne_of ℓ hℓ)]
  have LkerE : ∀ (ℓ : Nat.Primes) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ),
      x ∈ ribbonKernel X.degeneracyData → (X.edgeHecke ℓ).mulVec x ∈ ribbonKernel X.degeneracyData := by
    intro ℓ x hx
    rw [mem_ribbonKernel] at hx ⊢
    by_cases hℓ : ℓ = ⟨s, hs⟩
    · subst hℓ
      intro i
      rw [jointDelta_eq]
      exact hkerS x (fun j => by rw [← jointDelta_eq]; exact hx j) i
    · intro i
      have := Leqv ℓ hℓ i x
      rw [Matrix.mulVecLin_apply] at this
      rw [this, hx i, map_zero]
  let π : Equiv.Perm ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) := Function.Involutive.toPerm X.atkinLehnerPerm cb_inv
  have hadj0 := fun x y => hadj 0 x y
  have hadj1 := fun x y => hadj 1 x y
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hadj0 hadj1
  have Lpadjπ : ∀ (x : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) (e : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A))),
      padj 1 x e = padj 0 x (π e) :=
    padj_comp_perm_of_hadj X.degeneracyData.a X.degeneracyData.b X.degeneracyData.w
      (fun v => ((Nat.toPNat' (placeWidth M v.1) : ℕ) : ℤ)) X.atkinLehnerPerm cb_a cb_inv cb_w (padj 0) (padj 1) hadj0 hadj1

  let Q : EngineDatum ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) :=
    { D := X.degeneracyData
      wV := fun v => (Nat.toPNat' (placeWidth M v.1) : ℕ)
      TE := X.edgeHecke
      adjE := adjE
      TV := X.vertexHecke
      adjV := adjV
      s := ⟨s, hs⟩
      π := π
      padj := padj
      S := badPrimes M s q'
      wV_pos := fun v => (Nat.toPNat' (placeWidth M v.1)).pos
      s_mem := hsmem
      commE := hcommE
      commAdjE := hcAE
      commV := hcommV
      commAdjV := hcAV
      degE := fun ℓ x hx => mulVec_mem_characterLattice_of_rowSums _ _ (hn₁ ℓ) x hx
      degAdjE := hdegAE
      degV := fun ℓ x hx => mulVec_mem_characterLattice_of_rowSums _ _ (hn₂ ℓ) x hx
      degAdjV := hdegAV
      kerE := LkerE
      kerAdjE := hkerAE
      adjE_law := hAE
      adjV_law := hAV
      adjE_off := fun ℓ hℓ => hAEoff ℓ (hnot1 ℓ hℓ)
      adjV_off := fun ℓ hℓ => hAVoff ℓ (hnot1 ℓ hℓ)
      symE_off := fun ℓ hℓ i j => (hsymE ℓ (hnot1 ℓ hℓ) i j).symm
      symV_off := fun ℓ hℓ i j => (hsymV ℓ (hnot2 ℓ hℓ) i j).symm
      adjV_s := hAVs
      eqv := Leqv
      eqvAdj := hinterA
      hadj := hadj
      c3_deg := c3_1
      c3_ab := c3_2
      c3_ba := c3_3
      c3_Ua := c3_4
      c3_Ub := c3_5
      c3bis_a := cb_a
      c3bis_b := cb_b
      c3bis_inv := cb_inv
      c3bis_w := cb_w
      adjE_s := hAEs
      padj_π := Lpadjπ
      onto := honto
      rowV := fun ℓ hℓ => hn₂eq ℓ (hnot2 ℓ hℓ) ▸ hn₂ ℓ
      rowE := fun ℓ hℓ => hn₁eq ℓ (hnot1 ℓ hℓ) ▸ hn₁ ℓ
      divV := fun ℓ hℓ => (hdiv ℓ (hnot1 ℓ hℓ)).2
      divE := fun ℓ hℓ => (hdiv ℓ (hnot1 ℓ hℓ)).1 }

  have hH : X.heckeData = Q.H := by
    unfold SSLevelDatum.heckeData
    rw [dif_pos hlaws]
    rfl
  have hT' : ∀ ℓ : Nat.Primes, ℓ ≠ Q.s → ∀ x : Xo,
      ((e (heckeGen ℓ • x)).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (Q.TV ℓ).mulVec ((e x).1 : _ → ℤ) ∧
      ((e (heckeGen ℓ • x)).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (Q.TV ℓ).mulVec ((e x).2 : _ → ℤ) :=
    fun ℓ hℓ x => hT ℓ (hne_of ℓ hℓ) x
  exact Q.finrank_heckeTorsion_le_finrank_quotient e hT' hU X.heckeData hH eΨ hΨ 𝔪 heis

