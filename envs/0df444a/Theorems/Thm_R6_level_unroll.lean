open Real

theorem R6.level_unroll (E : ℝ) (s : ℕ) (D : ℕ → ℝ) (hs : 2 ≤ s) (hE : 0 ≤ E) (hD0 : 0 ≤ D 0)
    (hstep : ∀ k, D (k + 1) ≤ E + s * D k) :
    ∀ k, D k ≤ (E + D 0) * (2 * (s : ℝ) ^ k - 1) := by sorry
