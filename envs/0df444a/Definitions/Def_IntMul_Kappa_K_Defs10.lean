-- Source module: Solutions.ButterflyPacked
/-!
# §5.2 Lemma 13: packed selected-bit addition on one rectangle

1. (20)/(21): eight controlled `±1` updates of `(u, w)` give `(u + c(1 - 2(u mod 2)), w)`.
2. The packed lines (22) on `L = fK`-bit chunks `y, z` (mod `2^L`), with the `f - 1` segments
   at `j_i = ρ + iK` and controls `c_i = x_{j_i}`: outside the guard set `B` (23), their
   composite `S0` equals the ideal map `T0` (flip `y_{j_i}` where `c_i = 1`, fix `x, z`).
3. Bijections agreeing off `B` with `T0(B) = B` satisfy `S0(B) = B` (the repair permutes `B`).
4. (24): the guard count `|B| · 2^K ≤ 80 (f-1) · 2^{3L}`.
-/

namespace Butterfly

open Finset

/-! ## 1. The eight scalar updates (20) -/

/-- One line of (20): `tgtY` = update `u` testing `w` (else update `w` testing `u`),
sign `sgn`, tested parity `b`. -/
structure Line where
  tgtY : Bool
  sgn : ℤ
  b : ℤ

/-- The eight lines of (20) in chronological order. -/
def lines : List Line :=
  [⟨true, -1, 0⟩, ⟨false, -1, 0⟩, ⟨true, 1, 0⟩, ⟨false, 1, 0⟩,
   ⟨false, 1, 1⟩, ⟨true, 1, 1⟩, ⟨false, -1, 1⟩, ⟨true, -1, 1⟩]

/-- A line on one segment pair with Boolean control `c`. -/
def Line.apply (l : Line) (c : Bool) (p : ℤ × ℤ) : ℤ × ℤ :=
  if l.tgtY then (p.1 + l.sgn * (if c ∧ p.2 % 2 = l.b then 1 else 0), p.2)
  else (p.1, p.2 + l.sgn * (if c ∧ p.1 % 2 = l.b then 1 else 0))

/-- The composite of the eight lines. -/
def run8 (c : Bool) (p : ℤ × ℤ) : ℤ × ℤ := lines.foldl (fun p l => l.apply c p) p

/-! ## 2. Segment packing -/

variable (K : ℕ)

/-- Pack `n` segments `u 0, …, u (n-1)` of `K` bits above a high part `h`:
`u 0 + 2^K (u 1 + 2^K (… + 2^K h))`. -/
def pk : ℕ → (ℕ → ℤ) → ℤ → ℤ
  | 0, _, h => h
  | n + 1, u, h => u 0 + 2 ^ K * pk n (fun i => u (i + 1)) h

/-- Bit `j` of an integer. -/
def bitAt (t : ℤ) (j : ℕ) : ℤ := (t / 2 ^ j) % 2

/-- A packed number `lo + 2^ρ · pk(u, h)`. -/
def packed (ρ n : ℕ) (lo : ℤ) (u : ℕ → ℤ) (h : ℤ) : ℤ := lo + 2 ^ ρ * Butterfly.pk K n u h

/-! ## 3. The packed lines (22) -/

variable (ρ f : ℕ)

/-- The offset of a packed line: `∑_{i<f-1} 2^{j_i} [x_{j_i} = 1][t_{j_i} = b]`. -/
def offset (x t b : ℤ) : ℤ :=
  ∑ i ∈ range (f - 1), (2 : ℤ) ^ (ρ + i * K) *
    (if bitAt x (ρ + i * K) = 1 ∧ bitAt t (ρ + i * K) = b then 1 else 0)

/-- A packed line (22) on the chunk pair `(y, z)` of width `L = fK`, modulo `2^L`. -/
def pline (x : ℤ) (l : Line) (p : ℤ × ℤ) : ℤ × ℤ :=
  if l.tgtY then ((p.1 + l.sgn * Butterfly.offset K ρ f x p.2 l.b) % 2 ^ (f * K), p.2)
  else (p.1, (p.2 + l.sgn * Butterfly.offset K ρ f x p.1 l.b) % 2 ^ (f * K))

/-- `S0`: the eight packed lines in order. -/
def S0 (x : ℤ) (p : ℤ × ℤ) : ℤ × ℤ := lines.foldl (fun p l => pline K ρ f x l p) p

/-- The control of segment `i`. -/
def ctl (x : ℤ) (i : ℕ) : Bool := decide (bitAt x (ρ + i * K) = 1)

/-- The ideal map `T0`: flip bit `j_i` of `y` for every `i < f-1` with control `1`. -/
def T0y (x y : ℤ) : ℤ :=
  y + ∑ i ∈ range (f - 1), (2 : ℤ) ^ (ρ + i * K) *
    ((if Butterfly.ctl K ρ x i then 1 else 0) * (1 - 2 * bitAt y (ρ + i * K)))

variable {K ρ f}

/-! ## 4. Address form: guards and the ideal map -/

variable (K ρ f)

/-- The guard value of segment `i` of chunk `t`: `g_i = ⌊t / 2^{j_i+1}⌋ mod 2^{K-1}`. -/
def guard (t : ℤ) (i : ℕ) : ℤ := (t / 2 ^ (ρ + i * K + 1)) % 2 ^ (K - 1)

/-- (23): every used guard value lies in `[10, 2^{K-1} - 11]`. -/
def GuardOK (t : ℤ) : Prop := ∀ i < f - 1, 10 ≤ guard K ρ t i ∧ guard K ρ t i ≤ 2 ^ (K - 1) - 11

variable {K ρ f}

/-! ## 5. The repair permutes `B` -/

/-! ## 6. The guard count (24) -/

/-- Guard `i` of a natural chunk value. -/
def guardN (K ρ : ℕ) (n i : ℕ) : ℕ := (n / 2 ^ (ρ + i * K + 1)) % 2 ^ (K - 1)

end Butterfly

end

