set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-- The coefficient loop. -/
def coefL (neg : Bool) : RS := .rep oCC (.reg oI) (coefB neg)

/-! ## The stage loop -/

/-- The stage list of target `i`. -/
def acL (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) : List (ℕ × ℕ) :=
  ((List.range i).map sF).zip ((List.range i).map (cF neg sF μ Q))

/-- The managed lists after `k` stages (`rv = ac.reverse`). -/
def stF (g : Fin HS → List ℤ) (rv : List (ℕ × ℕ)) (Q k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update g
    14 (tbl Q (rv.take k).reverse))
    NLogN.KIL.sSA ((rv.drop k).map fun p => (p.1 : ℤ)))
    sSC ((rv.drop k).map fun p => (p.2 : ℤ)))
    sSM (stgM (rv.drop k) (rv.take k).reverse))
    sSAM (stgAM (rv.drop k) (rv.take k).reverse)

end NLogN.KFUU

end

