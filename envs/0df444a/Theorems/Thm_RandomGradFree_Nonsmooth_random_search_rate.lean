-- title:
--   Theorem 6 — convergence of random search $\mathcal{RS}_\mu$ for nonsmooth convex problems (Eq. (45))
-- statement:
--   Let $E$ be a real inner product space of dimension $n$. Consider the problem
--
--   $$
--   f^* = \min_{x \in Q} f(x),
--   $$
--
--   where $Q \subseteq E$ is closed and convex, $f : E \to \mathbb R$ is convex and Lipschitz continuous with constant $L_0 \ge 0$, and $x^* \in Q$ is a minimizer of $f$ over $Q$, so $f^* = f(x^*)$. Fix $\mu > 0$, positive steps $h_0, h_1, \dots$, and a starting point $x_0 \in Q$. Let $x_0, x_1, \dots$ be generated by the random search method $\mathcal{RS}_\mu$:
--
--   $$
--   x_{k+1} = \pi_Q\!\left(x_k - h_k \frac{f(x_k+\mu u_k) - f(x_k)}{\mu}\, u_k\right),
--   $$
--
--   with $u_0, u_1, \dots$ independent standard Gaussian vectors in $E$. Write $\phi_k = \mathbb E\, f(x_k)$ (so $\phi_0 = f(x_0)$) and $S_N = \sum_{k=0}^N h_k$. Then for every $N \ge 0$,
--
--   $$
--   \frac{1}{S_N}\sum_{k=0}^{N} h_k(\phi_k - f^*) \le \mu L_0\, n^{1/2} + \frac{1}{S_N}\left[\frac12\|x_0 - x^*\|^2 + \frac{(n+4)^2}{2} L_0^2 \sum_{k=0}^{N} h_k^2\right].
--   $$
--
--   This is the main guarantee for gradient-free minimization of nonsmooth convex functions: using only function values, the weighted average of the expected optimality gaps obeys the classical projected subgradient bound with the squared Lipschitz constant inflated by $(n+4)^2$, plus a smoothing bias $\mu L_0 n^{1/2}$. Appropriate choices of $\mu$, $h_k$ and $N$ give an $\epsilon$-solution in $O(n^2/\epsilon^2)$ iterations.
--
--   **Formalization Note** The paper's space $(E, B)$ is an arbitrary finite-dimensional real inner product space (inner product $\langle B\cdot,\cdot\rangle$). $L_0$ is any constant satisfying the Lipschitz inequality; the paper's Theorem 6 uses $L_0(f)$, which presupposes $f \in C^{0,0}(E)$, so Lipschitz continuity is made explicit. The run is the predicate `IsRandomSearchRun` on an arbitrary probability space; $\phi_k$ is the expectation $\int f(x_k)\,dP$, which equals the paper's $\mathbb E_{\mathcal U_{k-1}} f(x_k)$ because $x_k$ depends only on $u_0,\dots,u_{k-1}$.
-- source:
--   Nesterov, Spokoiny, Random Gradient-Free Minimization of Convex Functions, Found. Comput. Math. 17 (2017), p. 542, Theorem 6, Eq. (45); method (39) and φ_k on p. 541; problem (38) on p. 540

import Mathlib
import Definitions.Def_RandomGradFree_Nonsmooth_IsRandomSearchRun

open MeasureTheory ProbabilityTheory

namespace RandomGradFree.Nonsmooth

theorem random_search_rate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    (Q : Set E) (hQc : IsClosed Q) (hQconv : Convex ℝ Q)
    (f : E → ℝ) (hf : ConvexOn ℝ Set.univ f)
    (L₀ : ℝ) (hL₀ : 0 ≤ L₀) (hLip : ∀ x y, |f x - f y| ≤ L₀ * ‖x - y‖)
    (xstar : E) (hxstar : xstar ∈ Q) (hopt : ∀ y ∈ Q, f xstar ≤ f y)
    (μ : ℝ) (hμ : 0 < μ) (h : ℕ → ℝ) (hh : ∀ k, 0 < h k) (x₀ : E)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (u : ℕ → Ω → E) (x : ℕ → Ω → E) (hrun : IsRandomSearchRun P Q f μ h x₀ u x) (N : ℕ) :
    (1 / ∑ k ∈ Finset.range (N + 1), h k) *
        ∑ k ∈ Finset.range (N + 1), h k * ((∫ ω, f (x k ω) ∂P) - f xstar)
      ≤ μ * L₀ * Real.sqrt (Module.finrank ℝ E)
        + (1 / ∑ k ∈ Finset.range (N + 1), h k) *
          (1 / 2 * ‖x₀ - xstar‖ ^ 2
            + ((Module.finrank ℝ E : ℝ) + 4) ^ 2 / 2 * L₀ ^ 2
              * ∑ k ∈ Finset.range (N + 1), h k ^ 2) := by sorry

end RandomGradFree.Nonsmooth
