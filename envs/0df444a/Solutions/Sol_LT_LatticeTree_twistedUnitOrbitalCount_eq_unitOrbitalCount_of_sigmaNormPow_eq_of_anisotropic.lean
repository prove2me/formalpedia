private theorem quadNorm_neg_one_eq (s : S) :
    quadNorm (⟨-s, 1⟩ : QExt S (Z 0 0 + Z 1 1) (Z 0 0 * Z 1 1 - Z 0 1 * Z 1 0))
      = s * s - (Z 0 0 + Z 1 1) * s + (Z 0 0 * Z 1 1 - Z 0 1 * Z 1 0) := by
  rw [quadNorm_mk]
  ring

private theorem smul_one_add_smul_mul_comm (a b : S) :
    (a • (1 : Matrix (Fin 2) (Fin 2) S) + b • Z) * Z = Z * (a • (1 : Matrix (Fin 2) (Fin 2) S) + b • Z) := by
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]

