theorem popK_states {X C : Fin HS} (hXC : X ≠ C) (n : Ex HS) (s : IState HS) (L : List ℤ)
    (R : List Item) (hX : s.G X = ints L ++ R) (hn : n.eval s = L.length) :
    RepStates C n (pop X) s (fun j => s.upd X (ints (L.drop j) ++ R)) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, hXC.symm]
  h0 := by simp [← hX]
  hG := fun k => by simp [hXC.symm]
  step := by
    intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro x
    simp only [withCtr, RS.run_pop_G, IState.upd_G]
    by_cases h1 : x = X
    · subst h1; simp only [if_true, if_neg hXC]; rw [hd]; rfl
    · by_cases h2 : x = C
      · subst h2; simp [hXC.symm]
      · simp [h1, h2]

theorem popK_spec {X C : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56) (n : Ex HS)
    (hnc : n.Clean) (s : IState HS) (L : List ℤ) (R : List Item) (hX : s.G X = ints L ++ R)
    (hno : n.ok s) (hn : n.eval s = L.length) :
    (popK X C n).ok s ∧ (popK X C n).run s = s.upd X R := by
  have H := popK_states hXC n s L R hX hn
  refine ⟨H.ok hC5 hnc hno ?_, ?_⟩
  · intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    refine ⟨hX5, ?_⟩
    have e : (withCtr C s (n.eval s).toNat k (s.upd X (ints (L.drop k) ++ R))).G X =
        .int L[k] :: (ints (L.drop (k + 1)) ++ R) := by
      simp [withCtr, Ne.symm hXC, hXC]; rw [hd]; rfl
    exact IState.isInt_of e
  · rw [popK, H.run, hn, Int.toNat_natCast]; simp

