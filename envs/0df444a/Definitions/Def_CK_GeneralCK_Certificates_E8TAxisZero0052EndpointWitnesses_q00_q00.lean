/-!
# Endpoint certificates for all eight padded first-cell inverse brackets

Generated by `scripts/e8_taxis_emit_endpoint_witnesses.py`.
All primitive checks, scalar graph identities, and target comparisons
are checked separately. Coverage follows from the intermediate value theorem.
The exact lower cell boundaries are those in `E8TAxisZero0052Geometry`.
-/

namespace GeneralCK.Certificates.E8TAxisZero0052EndpointWitnesses

open Set DyadicInterval E8TAxisStableInterval E8TAxisStableScalar
open E8TAxisFirstCellInverseCoverage E8TAxisZero0052Geometry

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

def precision : ℕ := 160
def endpointLogTwo : DyadicInterval precision := ⟨1013035739299659071135698605846798551586536899314, 1013035739299659071135698605846798551586536901381⟩
def fastLogWitness : FastLogBoxWitness := ⟨0, 1024, 0, 1024⟩

theorem endpointLogTwo_checked :
    logBoxCheck (ofInt precision 2) endpointLogTwo fastLogWitness = true := by decide +kernel

def centerBLowerAlpha : DyadicInterval precision := ⟨2234440797417960962512456499575835485272377238850, 2234440797417960962512456499575835485272377238850⟩
def centerBLowerExp : DyadicInterval precision := ⟨68681977988023915269716644193796991563753218706, 68681977988023915269716644193796991563753349779⟩
def centerBLowerLog : DyadicInterval precision := ⟨67116996175154394811740681640706696029161211402, 67116996175154394811740681640706696029161338647⟩
def centerBLowerYBox : DyadicInterval precision := ⟨9050805608433282228138256978105806437662950769566, 9050805608433282228138256978105806437662961942350⟩
def centerBLowerInput : Inputs precision :=
  ⟨centerBLowerAlpha, centerBLowerExp, centerBLowerLog, endpointLogTwo⟩
def centerBLowerExpWitness : ExpWitness precision :=
  ⟨68681977988023915269716644193796991563753218706, scale precision, 68681977988023915269716644193796991563753349779, scale precision,
    0, 1024, 0, 1024, ⟨-4468881594835921925024912999151670970544755873855, -4468881594835921925024912999151670970544755871682⟩, ⟨-4468881594835921925024912999151670970544753084709, -4468881594835921925024912999151670970544753082546⟩⟩

theorem centerBLower_primitive_checks :
    expBoxCheck ((ofInt precision (-2)).mul centerBLowerAlpha) centerBLowerExp centerBLowerExpWitness = true ∧
    logBoxCheck ((ofInt precision 1).add centerBLowerExp) centerBLowerLog fastLogWitness = true := by decide +kernel

theorem centerBLower_denominators : DenominatorsPositive centerBLowerInput := by
  unfold DenominatorsPositive
  decide +kernel

theorem centerBLower_yBox_eq : (yBox centerBLowerInput).d0 = centerBLowerYBox := by decide +kernel

theorem centerBLower_contains :
    centerBLowerYBox.Contains (Y (lower E8TAxisZero0052PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0052PaddedInputs.centerBInput.alpha = ((2234440797417960962512456499575835485272377238850 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
  have ha : centerBLowerInput.alpha.Contains (lower E8TAxisZero0052PaddedInputs.centerBInput.alpha) := by
    rw [e]; exact point_contains precision 2234440797417960962512456499575835485272377238850
  have h := checked_yBox_d0_contains (i := centerBLowerInput) (we := centerBLowerExpWitness)
    (wl := fastLogWitness) (wL := fastLogWitness)
    centerBLower_primitive_checks.1 centerBLower_primitive_checks.2 endpointLogTwo_checked
    centerBLower_denominators ha
  rw [centerBLower_yBox_eq] at h
  exact h

def centerBUpperAlpha : DyadicInterval precision := ⟨2234440797417960962512456499575835485272410793283, 2234440797417960962512456499575835485272410793283⟩
end GeneralCK.Certificates.E8TAxisZero0052EndpointWitnesses


