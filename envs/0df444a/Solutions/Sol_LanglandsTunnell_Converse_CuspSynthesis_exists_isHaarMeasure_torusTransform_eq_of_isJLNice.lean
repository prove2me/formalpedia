    dF.Wf (centralScalar (𝓞 K) K z * x) = ((ω (z / NumberField.Idele.partAt K S z) : ℂˣ) : ℂ) * dF.Wf x
  have hunit : ∀ u : (AdeleRing (𝓞 K) K)ˣ, s001 S u → P u := by
    intro u hu x
    rw [t0383 hu.arch hu.trivial_on, div_one,
      t0064 ω hωc S hωunr hu, Units.val_one, one_mul, ← t0067,
      t0017 dF x (t0073 hu)]
  refine t0057 S P ?_ ?_ ?_ hunit z x
  ·
    intro z₁ z₂ h₁ h₂ y
    have hdiv : z₁ * z₂ / NumberField.Idele.partAt K S (z₁ * z₂)
        = z₁ / NumberField.Idele.partAt K S z₁ * (z₂ / NumberField.Idele.partAt K S z₂) := by
