    (hnorm : ∀ v : HeightOneSpectrum (𝓞 ℚ),
        NumberField.TateGlobal.ideleNorm ℚ (AutomorphicForm.uniformizerIdele ℚ v) =
          ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹)
    (hsum : Summable fun v : HeightOneSpectrum (𝓞 ℚ) => ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (-(3 : ℝ))) :
    (∀ v ∉ T, IsGL3PsiWhittakerFn (psiLoc ψ v)⁻¹ (dualWhittakerFn3 (Wloc v))) ∧
