    (heZ : e (Ideal.Quotient.mk (TypeDensity.chartExceptional R t x) (TypeDensity.chartSlope R t x)) = Polynomial.X)
    {ι : Type} [Finite ι] (P : ι → Ideal (TypeDensity.BlowupChart R t x)) [∀ s, (P s).IsMaximal]
    (hinjP : Function.Injective P) (htP : ∀ s, TypeDensity.chartBase R t x t ∈ P s)
    (g : ∀ s, TypeDensity.CompletedLocalAt (TypeDensity.BlowupChart R t x) (P s))
    (hfin : ∀ s, ∃ L : ℕ, ((IsLocalRing.maximalIdeal (Localization.AtPrime (P s))).map
      (TypeDensity.localCompletionMap (Localization.AtPrime (P s))))^L ≤
      TypeDensity.finiteLocalCurveIdeal (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) (g s) 1) :
    ∃ (φ : ι → Polynomial (R ⧸ I)) (m : ι → ℕ), (∀ s, (φ s).Monic ∧ Irreducible (φ s)) ∧
