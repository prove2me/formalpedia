  have hlogval : -Real.log (1 - 1 / R) = Real.log R - Real.log (R - 1) := by
    rw [hone, Real.log_div (by linarith) (by linarith)]
    ring
  unfold Lg
  rw [Real.log_div (by linarith) (by linarith)]
  calc Hc (1 / R) = R * ((1 / R) * Hc (1 / R)) := by field_simp
    _ = R * (Real.log R - Real.log (R - 1)) := by rw [hid, hlogval]
