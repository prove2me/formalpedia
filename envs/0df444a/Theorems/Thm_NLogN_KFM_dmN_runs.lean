theorem NLogN.KFM.dmN_runs (X Y Z : Fin HS) (hXY : X ≠ Y) (hXZ : X ≠ Z) (hYZ : Y ≠ Z) (hX : NC X)
    (hY : NC Y) (hZ : NC Z) (L : List ℤ) (B : ℕ)
    (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (RX : List Item) (h0 : s.G X = ints L ++ RX) :
    IRuns I iprog (rpt pA pC pD L.length (dmB X Y Z)) s
      (((s.upd X RX).upd Y (ints L.reverse ++ s.G Y)).upd Z (ints L.reverse ++ s.G Z))
