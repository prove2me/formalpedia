open J6Seg.PJ (cT cE cA cLoop cRd cRdK cRdBlk cPh2 cPh3 cPh3a cPh3b cPar pA1 pA2 pA3 pA4 pA5 pA6 eSq eLg eSz1 eSz2 ePw)

theorem cT_le (e : Ex HS) (W : ℕ) : cT e W ≤ cT e 0 * (W + 1) ^ 2 := by
  unfold cT J6Seg.PJ.cE
  have h : ((W + 1) * (2 * e.size) + 2) ^ 2 ≤ ((0 + 1) * (2 * e.size) + 2) ^ 2 * (W + 1) ^ 2 := by
    rw [← mul_pow]; apply Nat.pow_le_pow_left; nlinarith
  calc (e.size + 1) * 10 ^ 7 * ((W + 1) * (2 * e.size) + 2) ^ 2 ≤
      (e.size + 1) * 10 ^ 7 * (((0 + 1) * (2 * e.size) + 2) ^ 2 * (W + 1) ^ 2) :=
        Nat.mul_le_mul_left _ h
    _ = _ := by ring

theorem cA_le (W : ℕ) : ∀ l, cA W l ≤ cA 0 l * (W + 1) ^ 2
  | [] => by simp only [cA, one_mul]; exact Nat.one_le_pow _ _ (by omega)
  | (i, e) :: l => by
    simp only [cA]
    have h1 := cT_le e.ex W
    have h2 := cA_le W l
    calc cT e.ex W + cA W l ≤ cT e.ex 0 * (W + 1) ^ 2 + cA 0 l * (W + 1) ^ 2 := add_le_add h1 h2
      _ = _ := by ring

theorem cLoop_le (W N cb : ℕ) : J6Seg.PJ.cLoop W N cb ≤ (N + 1) * (cb + 10 ^ 4 * (W + 3) ^ 2) := by
  unfold J6Seg.PJ.cLoop
  have h1 : W + 3 ≤ (W + 3) ^ 2 := by nlinarith
  have h2 : N * (8000 * (W + 3) + 30) ≤ N * (10 ^ 4 * (W + 3) ^ 2) :=
    Nat.mul_le_mul_left _ (by omega)
  have h3 : N * cb ≤ (N + 1) * cb := Nat.mul_le_mul_right _ (by omega)
  nlinarith

theorem cRdK_le {j : ℕ} (hj : j ≤ 7) (W : ℕ) : cRdK j W ≤ 10 ^ 9 * (W + 3) ^ 2 := by
  unfold cRdK cRd
  have h1 := cT_le (.lit (j : ℤ)) W
  have h0 : cT (.lit (j : ℤ) : Ex HS) 0 = 320000000 := by simp only [cT, J6Seg.PJ.cE, Ex.size]; norm_num
  rw [h0] at h1
  have h2 : (W + 1) ^ 2 ≤ (W + 3) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h3 : W + 3 ≤ (W + 3) ^ 2 := by nlinarith
  have h4 : j * (14000 * (W + 2)) ≤ 7 * (14000 * (W + 3)) := Nat.mul_le_mul hj (by omega)
  nlinarith

theorem cPar_le (W d NF Q : ℕ) :
    J6Seg.PJ.cPar 0 0 0 0 W d NF Q (0 * Q + 0) ≤ Kp * (W + 3) ^ 2 * (NF + Q + d + lamF d + 2) := by
  set X := (W + 3) ^ 2 with hX
  set N := NF + Q + d + lamF d + 2 with hN
  have hX1 : (W + 1) ^ 2 ≤ X := Nat.pow_le_pow_left (by omega) 2
  have hN1 : 1 ≤ N := by omega
  have hc : ∀ l, cA W l ≤ cA 0 l * X := fun l => le_trans (cA_le W l) (Nat.mul_le_mul_left _ hX1)
  have hlp : ∀ M l, M + 1 ≤ N → J6Seg.PJ.cLoop W M (cA W l) ≤ (cA 0 l + 10 ^ 4) * (X * N) := by
    intro M l hM
    calc J6Seg.PJ.cLoop W M (cA W l) ≤ (M + 1) * (cA W l + 10 ^ 4 * X) := cLoop_le W M _
      _ ≤ N * (cA 0 l * X + 10 ^ 4 * X) := Nat.mul_le_mul hM (by have := hc l; omega)
      _ = _ := by ring
  have hc' : ∀ l, cA W l ≤ cA 0 l * (X * N) := fun l =>
    le_trans (hc l) (by rw [← mul_assoc]; exact Nat.le_mul_of_pos_right _ (by omega))
  have hr : ∀ j ≤ 7, cRdK j W ≤ 10 ^ 9 * (X * N) := fun j hj =>
    le_trans (cRdK_le hj W) (by rw [← mul_assoc]; exact Nat.le_mul_of_pos_right _ (by omega))
  simp only [J6Seg.PJ.cPar, cRdBlk, cPh2, cPh3, cPh3a, cPh3b]
  have a1 := hr 3 (by omega); have a2 := hr 4 (by omega); have a3 := hr 6 (by omega)
  have a4 := hr 5 (by omega); have a5 := hr 7 (by omega); have a6 := hr 1 (by omega)
  have a7 := hr 2 (by omega)
  have b1 := hc' pA1
  have b2 := hlp (d + 1) [(5, eSq)] (by omega)
  have b3 := hc' pA2
  have b4 := hlp (lamF d) [(24, eLg)] (by omega)
  have b5 := hc' pA3
  have b6 := hlp NF [(8, eSz1), (11, eSz2)] (by omega)
  have b7 := hc' pA4
  have b8 := hlp Q [(9, ePw 9)] (by omega)
  have b9 := hc' (pA5 0 0)
  have b10 := hlp (0 * Q + 0) [(12, ePw 12)] (by omega)
  have b11 := hc' (pA6 0 0)
  have e : Kp * X * N = Kp * (X * N) := by ring
  rw [e]
  simp only [Kp]
  generalize X * N = Y at *
  linarith

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc22
/-!
# B-line IL, source-table producers, part 22: the set-up costs at `A = W = 4p`

With `u = uC (4p) DD`, `e = ePC (4p) p α`, `c = cU (4p + 1)` and the unit `U = u + e + c + 20000`,
every set-up / tear-down cost is `≤ Kb · X · U` with `X = t + NF d s + p + 1` (`costs_le`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (ctlCost)
open NLogN.KFUU (cU)

theorem u_facts {p : ℕ} (hp : 1 ≤ p) :
    (p + 1) ^ 2 ≤ uC (4 * p) DD ∧ parkC (4 * p + 1) ≤ uC (4 * p) DD ∧
    uC 2 DD ≤ uC (4 * p) DD ∧ 200 * (4 * p * DD + 1 + 1) ≤ uC (4 * p) DD ∧
    (4 * p + 3) ^ 2 ≤ 16 * uC (4 * p) DD := by
  simp only [uC, parkC, DD]
  refine ⟨by nlinarith, by nlinarith, ?_, by nlinarith, by nlinarith⟩
  have : 2 * 16 + 3 ≤ 4 * p * 16 + 3 := by omega
  have := Nat.pow_le_pow_left this 2
  omega

theorem ctlPhC_le {p n n' : ℕ} (α : ℕ) :
    ctlPhC (4 * p) n n' ≤ 40 * (n + n' + 1) * Ut p α := by
  simp only [ctlPhC, ctlCost, Ut]
  generalize uC (4 * p) DD = u
  generalize ePC (4 * p) p α = e
  generalize cU (4 * p + 1) = c
  have h1 : n' + 1 ≤ n + n' + 1 := by omega
  have h2 := Nat.mul_le_mul_right (4 * u) h1
  have h3 : 1 ≤ n + n' + 1 := by omega
  have h4 := Nat.mul_le_mul_right (6 * u) h3
  nlinarith

theorem frame_le {p d s : ℕ} (α : ℕ) (hp : 1 ≤ p) (hd : d ≤ p) (hQ : segPF p d s ≤ 3 * p) :
    frameC (4 * p) d s p ≤ Kb * (NF d s + p + 1) * Ut p α := by
  obtain ⟨f1, f2, f3, f4, f5⟩ := u_facts hp
  have hc := cPar_le (4 * p) d (NF d s) (segPF p d s)
  have hl := J6Seg.PJ.lamF_le_NF d s
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  simp only [frameC]
  generalize NF d s = N at *
  set Y := N + p + 1 with hY
  have e1 : Kp * (4 * p + 3) ^ 2 * (N + segPF p d s + d + lamF d + 2) ≤
      Kp * (16 * uC (4 * p) DD) * (4 * Y) :=
    Nat.mul_le_mul (Nat.mul_le_mul_left _ f5) (by omega)
  generalize J6Seg.PJ.cPar 0 0 0 0 (4 * p) d N (segPF p d s) (0 * segPF p d s + 0) = cp at *
  generalize parkC (4 * p + 1) = pk at *
  generalize uC 2 DD = u2 at *
  generalize Ut p α = U at *
  generalize uC (4 * p) DD = u at *
  have q1 : Kp * (16 * u) * (4 * Y) = 64 * (Kp * u * Y) := by ring
  have hY1 : 1 ≤ Y := by omega
  have q2 : u ≤ u * Y := Nat.le_mul_of_pos_right _ hY1
  have q3 : u * Y ≤ U * Y := Nat.mul_le_mul_right _ hu
  have q4 : Kp * u * Y ≤ Kp * U * Y := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hu)
  have q5 : Kb * Y * U = 10 ^ 6 * (U * Y) + 100 * (Kp * U * Y) := by simp only [Kb]; ring
  rw [q5]
  omega

theorem cost1_le {p Q t : ℕ} (α : ℕ) : cost1 (4 * p) Q t ≤ 200 * (Q + t + 2) * Ut p α := by
  have h := ctlPhC_le (p := p) (n := t) (n' := t) α
  simp only [cost1]
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  generalize ctlPhC (4 * p) t t = X at *
  generalize Ut p α = U at *
  generalize uC (4 * p) DD = u at *
  have m1 : (Q + t + 2) * (40 * u) ≤ (Q + t + 2) * (40 * U) := Nat.mul_le_mul_left _ (by omega)
  have e1 : (Q + t + 2) * (40 * U) = 40 * (Q * U) + 40 * (t * U) + 80 * U := by ring
  have e2 : 40 * (t + t + 1) * U = 80 * (t * U) + 40 * U := by ring
  have e3 : 200 * (Q + t + 2) * U = 200 * (Q * U) + 200 * (t * U) + 400 * U := by ring
  omega

theorem dnC_le {p m : ℕ} (α : ℕ) :
    dnC (4 * p) m + (uC (4 * p) DD + uC (4 * p) DD) ≤ 10 * (m + 1) * Ut p α := by
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  simp only [dnC]
  generalize uC (4 * p) DD = u at *
  nlinarith

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc23
/-!
# B-line IL, source-table producers, part 23: the four slab set-ups on plain parameters

With the parking registers `ParkOK dA Z Z1 Cm`, `ZOK Z`, `CmOK Cm`, and the numerical regime of an
axis (`pre · t · post = T`, `2T < 2^p`, `p + 1 ≤ Q ≤ 3p`, …), the procedures
`upF dA Z Z1 Cm body{1,3,5,7}` / `dn0 Cm`, `dn7 Cm` are `SetupS` pairs for the slab register
files at cost `B0 = (Kb + 10^4) (NF d s + p + t + 1) · Ut p α` (`pass1` … `pass7`), with `A = W = 4p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost monoSrc_sel argO)
open J6Seg.PJ (rg RF RF_in RF_out ParV BV parBig cPar dsc lamF_le_NF)
open J6Seg.Ax (ρS sZ slabV SetupS)

theorem wF_le_NF' (d s : ℕ) : wF d ≤ NF d s := by
  unfold NF
  calc wF d ≤ 2 * wF d + 1 := by omega
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) :=
        Nat.le_mul_of_pos_left _ (by positivity)
    _ ≤ _ := Nat.le_mul_of_pos_right _ (by positivity)

theorem NF_lt (p d s : ℕ) : NF d s < 2 ^ segPF p d s :=
  (Nat.lt_size_self _).trans_le (Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega))

theorem parBig_lt' {k pre post s t p α d T W : ℕ}
    (hk : k ≤ T) (hpre : pre ≤ T) (hpost : post ≤ T) (hs : s ≤ T) (ht : t ≤ T) (hα : α ≤ T)
    (hp : p ≤ T) (hd : d ≤ T) (hTQ : T < 2 ^ segPF p d s) (hW : segPF p d s + 1514 ≤ W) :
    parBig 0 0 0 0 k pre post s t p α d < 2 ^ W := by
  have hNF := NF_lt p d s
  have hlF := lamF_le_NF d s
  have hwF := wF_le_NF' d s
  unfold parBig
  simp only [zero_mul, zero_add, pow_zero, pow_one, add_zero]
  generalize segPF p d s = Q at *
  generalize NF d s = N at *
  have a2 : 2 ^ Q * 2 ^ 1514 ≤ 2 ^ W := by rw [← pow_add]; exact Nat.pow_le_pow_right (by norm_num) hW
  have a3 : 2 ^ (Q + 2) = 4 * 2 ^ Q := by rw [pow_add]; ring
  have a4 : (64 : ℕ) ≤ 2 ^ 1514 := by
    calc (64 : ℕ) = 2 ^ 6 := by norm_num
      _ ≤ 2 ^ 1514 := Nat.pow_le_pow_right (by norm_num) (by norm_num)
  have a5 : 64 * 2 ^ Q ≤ 2 ^ Q * 2 ^ 1514 := by rw [mul_comm]; exact Nat.mul_le_mul_left _ a4
  have a6 : 1 ≤ 2 ^ Q := Nat.one_le_two_pow
  omega

theorem rfc {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {Z : Fin HS} (hZ : ZOK Z)
    (hc : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ Z → c j = []) (j : Fin HS) (hj : j ∉ rg) (h0 : j ≠ 0)
    (hs : j ≠ sZ) (hjz : j.val ≤ 48 ∨ j.val = 55) : RF v c j = [] := by
  rw [RF_out hj]
  refine hc j h0 hs fun h => ?_
  subst h
  obtain ⟨z1, -, -, -, z5⟩ := hZ
  rcases hjz with h | h
  · omega
  · exact z5 (Fin.ext h)

/-- Aggregation of a frame and a body cost. -/
theorem agg {F c Y1 Y Z1 U Kx : ℕ} (hF : F ≤ Kb * Y1 * U) (hY1 : Y1 ≤ Y) (hc : c ≤ Kx * Z1 * U)
    (hZ : Kx * Z1 ≤ 10000 * Y) : F + c ≤ (Kb + 10000) * Y * U := by
  have h1 : Kb * Y1 * U ≤ Kb * Y * U := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hY1)
  have h2 : Kx * Z1 * U ≤ 10000 * Y * U := Nat.mul_le_mul_right _ hZ
  have e : (Kb + 10000) * Y * U = Kb * Y * U + 10000 * Y * U := by ring
  omega

theorem Reg.le {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) :
    pre ≤ T ∧ post ≤ T ∧ t ≤ T ∧ 1 ≤ t := by
  have t1 : 1 ≤ t := by have := R.hst; omega
  rw [← R.tot]
  refine ⟨?_, ?_, ?_, t1⟩
  · calc pre ≤ pre * t := Nat.le_mul_of_pos_right _ t1
      _ ≤ pre * t * post := Nat.le_mul_of_pos_right _ R.post1
  · exact Nat.le_mul_of_pos_left _ (Nat.mul_pos R.pre1 t1)
  · calc t ≤ pre * t := Nat.le_mul_of_pos_left _ R.pre1
      _ ≤ pre * t * post := Nat.le_mul_of_pos_right _ R.post1

theorem Reg.big {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) :
    parBig 0 0 0 0 k pre post s t p α d < 2 ^ (4 * p) := by
  obtain ⟨a, b, c, -⟩ := R.le
  have h1 : 2 ^ p ≤ 2 ^ segPF p d s := Nat.pow_le_pow_right (by norm_num) (by have := R.pQ; omega)
  have := R.h2T; have := R.Qp; have := R.p0; have := R.hst
  exact parBig_lt' R.kT a b (by omega) c (by have := R.αp; have := R.pT; omega) R.pT R.dT
    (by omega) (by omega)

/-- `x ≤ T → x ≤ 2^(4p)` and friends. -/
theorem Reg.pw {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) {x : ℕ}
    (hx : x ≤ 8 * T) : x ≤ 2 ^ (4 * p) := by
  have h1 : 2 ^ (p + 3) ≤ 2 ^ (4 * p) := Nat.pow_le_pow_right (by norm_num) (by have := R.p0; omega)
  have h2 : 2 ^ (p + 3) = 8 * 2 ^ p := by rw [pow_add]; ring
  have := R.h2T
  omega

theorem Reg.pw2 {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) {x : ℕ}
    (hx : x ≤ 3 * p) : 2 ^ x ≤ 2 ^ (4 * p) := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem Reg.p_le {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) :
    p ≤ 2 ^ (4 * p) := (Nat.lt_two_pow_self).le.trans (Nat.pow_le_pow_right (by norm_num) (by omega))

theorem Reg.frame {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) :
    frameC (4 * p) d s p ≤ Kb * (NF d s + p + 1) * Ut p α :=
  frame_le α (by have := R.p0; omega) R.dp R.Qp

theorem Reg.cs_le {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) {n n' : ℕ}
    (hn : n + n' ≤ 4 * t) : n + n' ≤ 2 ^ (4 * p) := by
  obtain ⟨-, -, c, -⟩ := R.le; exact R.pw (by omega)

/-- The tear-down bound for a control list of length `≤ 4t`. -/
theorem Reg.dn {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) {m : ℕ}
    (hm : m ≤ 4 * t) : dnC (4 * p) m + (uC (4 * p) DD + uC (4 * p) DD) ≤ B0 p d s t α := by
  have h := dnC_le (p := p) (m := m) α
  have e : B0 p d s t α = (Kb + 10000) * (NF d s + p + t + 1) * Ut p α := rfl
  have h2 : 10 * (m + 1) ≤ (Kb + 10000) * (NF d s + p + t + 1) := by
    have : 10 * (m + 1) ≤ 10000 * (NF d s + p + t + 1) := by omega
    exact this.trans (Nat.mul_le_mul_right _ (by omega))
  rw [e]
  exact h.trans (Nat.mul_le_mul_right _ h2)

theorem Reg.tot_le {k pre post s t p α d T : ℕ} (R : Reg k pre post s t p α d T) {n' : ℕ}
    (h : n' ≤ 3 * t) : pre * (n' * (2 * post)) ≤ 2 ^ (4 * p) := by
  apply R.pw
  rw [← R.tot]
  have : pre * (n' * (2 * post)) ≤ pre * (3 * t * (2 * post)) :=
    Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ h)
  have e : pre * (3 * t * (2 * post)) = 6 * (pre * t * post) := by ring
  omega

/-- The tear-down hypotheses from the register file. -/
theorem dn_regs {F : Fin HS → List ℤ} (hρ : ∀ i, F (ρS i) = []) :
    F 45 = [] ∧ F 39 = [] ∧ F 38 = [] ∧ F 37 = [] ∧ F 40 = [] ∧ F 41 = [] ∧ F 42 = [] :=
  ⟨hρ 0, hρ 1, hρ 2, hρ 3, hρ 4, hρ 5, hρ 6⟩

theorem cm_ok {Cm : Fin HS} (h : CmOK Cm) :
    Cm ≠ 37 ∧ Cm ≠ 38 ∧ Cm ≠ 39 ∧ Cm ≠ 40 ∧ Cm ≠ 41 ∧ Cm ≠ 42 ∧ Cm ≠ 45 := h.2

set_option maxHeartbeats 2000000 in
/-- **Pass 1.** -/
theorem pass1_sol_aux {Pp : ℕ} {I : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA Z Z1 Cm : Fin HS}
    (hP : ParkOK dA Z Z1 Cm) (hZ : ZOK Z) (hCm : CmOK Cm) {k pre post s t p α d T : ℕ}
    (R : Reg k pre post s t p α d T) :
    SetupS I tbl (upF dA Z Z1 Cm body1) (dn0 Cm).code ρS dA (dsc k pre post s t p α d)
      (slabV (ctlOf t t (selSrc s t) (fun _ => ((2 ^ (segPF p d s - p - 1) : ℕ) : ℤ))) pre post t
        [] []) (B0 p d s t α) := by
  obtain ⟨hpT, hpostT, htT, ht1⟩ := R.le
  have hA : 2 ≤ 4 * p := by have := R.p0; omega
  have hQA : 2 ^ (segPF p d s) ≤ 2 ^ (4 * p) := R.pw2 R.Qp
  have hlen := length_ctlOf_le (monoSrc_sel (N := t) R.hst.le le_rfl)
    (fun _ => ((2 ^ (segPF p d s - p - 1) : ℕ) : ℤ))
  refine setup_of hP hZ R.big (by have := R.p0; omega) _ t [] []
    (cB := cost1 (4 * p) (segPF p d s) t) (cD := dnC (4 * p) (ctlOf t t (selSrc s t)
      (fun _ => ((2 ^ (segPF p d s - p - 1) : ℕ) : ℤ))).length)
    (fun s0 v c hv hb hc => ?_) (fun s0 F hρ hFC => ?_) _ ?_ ?_
  · obtain ⟨h1, h2, h3, h4, -, -, -, -, -, -, -, h20, -, h22, h23, -, -, -⟩ := hv
    exact body1_runs s0 (RF v c) (L1 := []) (L3 := []) (L4 := []) (L20 := []) (L22 := [])
      (L23 := []) (by rw [RF_in (by decide), h1]) (by rw [RF_in (by decide), h3])
      (by rw [RF_in (by decide), h4]) (by rw [RF_in (by decide), h20])
      (by rw [RF_in (by decide), h22]) (by rw [RF_in (by decide), h23])
      (rfc hZ hc 43 (by decide) (by decide) (by decide) (by decide))
      (rfc hZ hc 44 (by decide) (by decide) (by decide) (by decide))
      (rfc hZ hc 34 (by decide) (by decide) (by decide) (by decide))
      (rfc hZ hc 35 (by decide) (by decide) (by decide) (by decide))
      (rfc hZ hc 36 (by decide) (by decide) (by decide) (by decide))
      R.pQ R.hs R.hst.le R.p_le hQA (R.pw (by omega)) (R.pw (by omega)) (R.pw (by omega)) hA
  · obtain ⟨f45, f39, f38, f37, f40, -, -⟩ := dn_regs hρ
    exact dn0_sp s0 F hCm.1 (cm_ok hCm) hFC f37 f38 f39 f40 f45 _ pre post t
      (flat_abs (fun l _ => abs_nat_le ((Nat.pow_le_pow_right (by norm_num)
        (by have := R.Qp; omega)).trans hQA)))
      (hlen.trans (R.cs_le (by omega))) (R.pw (by omega)) (R.pw (by omega))
      (R.tot_le (by omega))
  · have hf := R.frame
    have hc := cost1_le (p := p) (Q := segPF p d s) (t := t) α
    have := R.Qp
    exact_mod_cast agg hf (by omega) hc (by omega)
  · have h := R.dn (m := (ctlOf t t (selSrc s t)
      (fun _ => ((2 ^ (segPF p d s - p - 1) : ℕ) : ℤ))).length) (by omega)
    exact_mod_cast le_trans (Nat.le_add_right _ _) h

