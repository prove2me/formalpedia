-- title:
--   Faithful Hecke action on H¹ₚₐᵣ(Γ₀(N),ℂ) via Eichler–Shimura
-- statement:
--   Let $N$ be a non-zero natural number and let $S$ be an arbitrary set of natural numbers. Write $\Gamma =$ [`CohCarrier.GammaH N ⊤`](def/CohCarrier_Level.html#L133), the subgroup of $\mathrm{SL}_2(\mathbb{Z})$ obtained as the image of the full preimage of $\top \le (\mathbb{Z}/N)^\times$ under the determinant-type character `gamma0Units` of $\Gamma_0(N)$, let $H^1 =$ [`CohCarrier.H1 N ⊤ ℂ`](def/CohCarrier_Level.html#L162) be the space of additive homomorphisms $\mathrm{Additive}\,\Gamma \to \mathbb{C}$, and let $H^1_{\mathrm{par}} =$ [`ModularCurve.Period.parabolicHoms ℂ Γ ℂ`](def/ModularCurve_PeriodMap.html#L62) be the $\mathbb{C}$-submodule of those $\varphi$ vanishing on every $\gamma \in \Gamma$ whose matrix has $\mathrm{tr}^2 = 4$. Let $\mathbb{T} =$ [`CuspForm.heckeAlgebra N 2 S`](def/CuspForm_HeckeAlgebra.html#L18) be the $\mathbb{Z}$-subalgebra of $\mathrm{End}_{\mathbb{C}} S_2(\Gamma_0(N))$ generated by the operators `heckeTLin` for primes $\ell \nmid N$, $\ell \notin S$, and `heckeULin` for primes $q \mid N$, $q \notin S$. The assertion is that there exist a ring homomorphism $\rho \colon \mathbb{T} \to \mathrm{End}_{\mathbb{C}} H^1_{\mathrm{par}}$ and a $\mathbb{C}$-linear isomorphism $E \colon S_2(\Gamma_0(N)) \times S_2(\Gamma_0(N)) \xrightarrow{\sim} H^1_{\mathrm{par}}$ such that: $\rho$ is injective; $E(tf, tg) = \rho(t)(E(f,g))$ for all $t \in \mathbb{T}$ and all $f, g$; for every prime $\ell \nmid N$ with $\ell \notin S$ and every $\varphi \in H^1_{\mathrm{par}}$, the element $\rho(T_\ell)\varphi$, viewed in $H^1$, equals [`CohCarrier.heckeT N ⊤ ℓ ℂ`](def/CohCarrier_Level.html#L250) applied to $\varphi$, and likewise $\rho(U_q)\varphi$ equals [`CohCarrier.heckeT N ⊤ q ℂ`](def/CohCarrier_Level.html#L250) applied to $\varphi$ for every prime $q \mid N$ with $q \notin S$; and, finally, for every pair $fg$ and every $\gamma \in \Gamma$, the value of $E(fg)$ at $\gamma$ agrees with the value of [`ModularCurve.periodHomPair N fg`](def/ModularCurve_PeriodHomPair.html#L135) at the image of $\gamma$ in $\Gamma_0(N)$ under [`CohCarrier.GammaH_le_Gamma0`](def/CohCarrier_Level.html#L146).
--
--   This is the Hecke-module form of the Eichler–Shimura isomorphism at level $\Gamma_0(N)$ in weight two: the parabolic cohomology group is identified with two copies of the space of cusp forms, compatibly with the transfer-defined Hecke operators on the cohomological carrier, and the Hecke algebra of $S_2(\Gamma_0(N))$ therefore acts faithfully on it. It is used in the comparison of the cusp-form Hecke algebra with the Hecke algebra of transfer operators on group cohomology, and is cited by [`CohCarrier.nonempty_basis_fin_two_parabolicHoms_and_finrank_eigenspace_eq_two`](thm.html#CohCarrier.nonempty_basis_fin_two_parabolicHoms_and_finrank_eigenspace_eq_two).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CohCarrier_exists_heckeAlgebra_ringHom_parabolicHoms_H1_top.lean

import Definitions.Def_CohCarrier_Level
import Definitions.Def_ModularCurve_PeriodHomPair
import Definitions.Def_CuspForm_HeckeAlgebra

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open scoped MatrixGroups in

theorem CohCarrier.exists_heckeAlgebra_ringHom_parabolicHoms_H1_top (N : ℕ) [NeZero N] (S : Set ℕ) :
    ∃ (ρ : CuspForm.heckeAlgebra N 2 S →+*
        Module.End ℂ ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ))
      (E : (CuspForm (CongruenceSubgroup.Gamma0 N) 2 × CuspForm (CongruenceSubgroup.Gamma0 N) 2)
        ≃ₗ[ℂ] ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ)),
      Function.Injective ρ ∧
      (∀ (t : CuspForm.heckeAlgebra N 2 S) (f g : CuspForm (CongruenceSubgroup.Gamma0 N) 2),
        E ((t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2)) f,
            (t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2)) g) = ρ t (E (f, g))) ∧
      (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S)
          (φ : ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ)),
        haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
        ((ρ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS) φ :
            ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ)) : CohCarrier.H1 N ⊤ ℂ) =
          CohCarrier.heckeT N ⊤ ℓ ℂ (φ : CohCarrier.H1 N ⊤ ℂ)) ∧
      (∀ (q : ℕ) (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S)
          (φ : ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ)),
        haveI : NeZero q := ⟨hq.ne_zero⟩
        ((ρ (CuspForm.heckeAlgebra.U hq hqN hqS) φ :
            ↥(ModularCurve.Period.parabolicHoms ℂ (CohCarrier.GammaH N ⊤) ℂ)) : CohCarrier.H1 N ⊤ ℂ) =
          CohCarrier.heckeT N ⊤ q ℂ (φ : CohCarrier.H1 N ⊤ ℂ)) ∧
      (∀ (fg : CuspForm (CongruenceSubgroup.Gamma0 N) 2 × CuspForm (CongruenceSubgroup.Gamma0 N) 2)
          (γ : ↥(CohCarrier.GammaH N ⊤)),
        (E fg : CohCarrier.H1 N ⊤ ℂ) (Additive.ofMul γ) =
          ModularCurve.periodHomPair N fg
            (Additive.ofMul ⟨(γ : SL(2, ℤ)), CohCarrier.GammaH_le_Gamma0 ⊤ γ.2⟩)) := by sorry
