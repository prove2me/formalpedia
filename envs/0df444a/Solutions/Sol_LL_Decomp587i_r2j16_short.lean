private lemma integral_poly4 (A0 A1 A2 A3 A4 lo hi : ℝ) :
    ∫ t in lo..hi, (A0 + A1 * t + A2 * t ^ 2 + A3 * t ^ 3 + A4 * t ^ 4) =
      (A0 * hi + A1 * hi ^ 2 / 2 + A2 * hi ^ 3 / 3 + A3 * hi ^ 4 / 4 + A4 * hi ^ 5 / 5) -
      (A0 * lo + A1 * lo ^ 2 / 2 + A2 * lo ^ 3 / 3 + A3 * lo ^ 4 / 4 + A4 * lo ^ 5 / 5) := by
  let P : ℝ → ℝ := fun t => A0 * t + A1 * t ^ 2 / 2 + A2 * t ^ 3 / 3 + A3 * t ^ 4 / 4 + A4 * t ^ 5 / 5
  have hc : Continuous (fun t : ℝ => A0 + A1 * t + A2 * t ^ 2 + A3 * t ^ 3 + A4 * t ^ 4) :=
    (((continuous_const.add (continuous_const.mul continuous_id)).add
      (continuous_const.mul (continuous_id.pow 2))).add
      (continuous_const.mul (continuous_id.pow 3))).add
      (continuous_const.mul (continuous_id.pow 4))
  have hd : ∀ x ∈ uIcc lo hi, HasDerivAt P (A0 + A1 * x + A2 * x ^ 2 + A3 * x ^ 3 + A4 * x ^ 4) x := by
    intro x _; dsimp only [P]
    have d1 : HasDerivAt (fun t : ℝ => A0 * t) A0 x := by simpa using (hasDerivAt_id x).const_mul A0
    have d2 : HasDerivAt (fun t : ℝ => A1 * t ^ 2 / 2) (A1 * x) x := by
      rw [show A1 * x = (A1 * ((2 : ℕ) * x ^ (2 - 1))) / 2 by push_cast; ring]
      exact ((hasDerivAt_pow 2 x).const_mul A1).div_const 2
    have d3 : HasDerivAt (fun t : ℝ => A2 * t ^ 3 / 3) (A2 * x ^ 2) x := by
      rw [show A2 * x ^ 2 = (A2 * ((3 : ℕ) * x ^ (3 - 1))) / 3 by push_cast; ring]
      exact ((hasDerivAt_pow 3 x).const_mul A2).div_const 3
    have d4 : HasDerivAt (fun t : ℝ => A3 * t ^ 4 / 4) (A3 * x ^ 3) x := by
      rw [show A3 * x ^ 3 = (A3 * ((4 : ℕ) * x ^ (4 - 1))) / 4 by push_cast; ring]
      exact ((hasDerivAt_pow 4 x).const_mul A3).div_const 4
    have d5 : HasDerivAt (fun t : ℝ => A4 * t ^ 5 / 5) (A4 * x ^ 4) x := by
      rw [show A4 * x ^ 4 = (A4 * ((5 : ℕ) * x ^ (5 - 1))) / 5 by push_cast; ring]
      exact ((hasDerivAt_pow 5 x).const_mul A4).div_const 5
    exact (((d1.add d2).add d3).add d4).add d5
  exact intervalIntegral.integral_eq_sub_of_hasDerivAt hd (hc.intervalIntegrable lo hi)

private def rProd : ℝ :=
  (387 / 1000) * (402 / 1000) * (410 / 1000) * (414 / 1000) * (394 / 1000)

private def tanNum (φ : ℝ) (x : R4) : ℝ :=
  6 - (x.1 / (387 / 1000) + x.2.1 / (402 / 1000) +
    x.2.2.1 / (410 / 1000) + x.2.2.2 / (414 / 1000) +
    (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / (394 / 1000))

private lemma tangent_eq_tanNum (φ : ℝ) (x : R4) :
    BuchstabArithmetic.tangent φ x.1 x.2.1 x.2.2.1 x.2.2.2 = (1 / rProd) * tanNum φ x := by
  unfold BuchstabArithmetic.tangent tanNum rProd; ring

private lemma cont_tanNum (φ : ℝ) : Continuous (tanNum φ) := by
  unfold tanNum
  exact continuous_const.sub
    (((((c_x0.div_const _).add (c_x1.div_const _)).add (c_x2.div_const _)).add (c_x3.div_const _)).add
      ((continuous_const.sub (((c_x0.add c_x1).add c_x2).add c_x3)).div_const _))

private def TG1 (φ : ℝ) (y : R3) : ℝ := (-6 : ℝ) * φ + (195250 / 76239 : ℝ) * φ ^ 2 + (6 : ℝ) * y.2.2 + (-1582000 / 584499 : ℝ) * y.2.2 * φ + (255250 / 1753497 : ℝ) * y.2.2 ^ 2 + (12 : ℝ) * y.2.1 + (-16463600 / 3125799 : ℝ) * y.2.1 * φ + (10450600 / 23964459 : ℝ) * y.2.1 * y.2.2 + (4600 / 15867 : ℝ) * y.2.1 ^ 2 + (12 : ℝ) * y.1 + (-26421500 / 5108013 : ℝ) * y.1 * φ + (40137500 / 117484299 : ℝ) * y.1 * y.2.2 + (81871400 / 209428533 : ℝ) * y.1 * y.2.1 + (4000 / 39597 : ℝ) * y.1 ^ 2
private def TG2 (φ : ℝ) (z : R2) : ℝ := (3 / 2 : ℝ) * φ ^ 2 + (-724375 / 1135114 : ℝ) * φ ^ 3 + (-3 : ℝ) * z.2 * φ + (307947625 / 234968598 : ℝ) * z.2 * φ ^ 2 + (3 / 2 : ℝ) * z.2 ^ 2 + (-166058375 / 234968598 : ℝ) * z.2 ^ 2 * φ + (8056375 / 234968598 : ℝ) * z.2 ^ 3 + (-12 : ℝ) * z.1 * φ + (1077648425 / 209428533 : ℝ) * z.1 * φ ^ 2 + (12 : ℝ) * z.1 * z.2 + (-26301990550 / 4816856259 : ℝ) * z.1 * z.2 * φ + (168452975 / 535206251 : ℝ) * z.1 * z.2 ^ 2 + (24 : ℝ) * z.1 ^ 2 + (-32927200 / 3125799 : ℝ) * z.1 ^ 2 * φ + (20901200 / 23964459 : ℝ) * z.1 ^ 2 * z.2 + (135534800 / 209428533 : ℝ) * z.1 ^ 3
private def TG3 (φ : ℝ) (x3 : ℝ) : ℝ := (-1 / 8 : ℝ) * φ ^ 3 + (2129884075 / 40210278336 : ℝ) * φ ^ 4 + (15 / 8 : ℝ) * x3 * φ ^ 2 + (-61632970075 / 77069700144 : ℝ) * x3 * φ ^ 3 + (-75 / 8 : ℝ) * x3 ^ 2 * φ + (624305759125 / 154139400288 : ℝ) * x3 ^ 2 * φ ^ 2 + (125 / 8 : ℝ) * x3 ^ 3 + (-1620584835625 / 231209100432 : ℝ) * x3 ^ 3 * φ + (66467153125 / 102759600192 : ℝ) * x3 ^ 4

private lemma cont_TG1 (φ : ℝ) : Continuous (TG1 φ) := by unfold TG1; fun_prop
private lemma cont_TG2 (φ : ℝ) : Continuous (TG2 φ) := by unfold TG2; fun_prop

private lemma TG_step0 (φ : ℝ) (y : R3) :
    ∫ x0 in (φ - y.1 - 2 * y.2.1 - y.2.2)..y.1, tanNum φ (x0, y) = TG1 φ y := by
  rcases y with ⟨x1, x2, x3⟩
  have heq : (fun x0 : ℝ => tanNum φ (x0, x1, x2, x3)) =
      (fun x0 : ℝ => ((6 : ℝ) + (-500 / 197 : ℝ) * φ + (5000 / 40779 : ℝ) * x3 + (800 / 8077 : ℝ) * x2 + (2000 / 39597 : ℝ) * x1) + ((-3500 / 76239 : ℝ)) * x0 + ((0 : ℝ)) * x0 ^ 2 + ((0 : ℝ)) * x0 ^ 3 + ((0 : ℝ)) * x0 ^ 4) := by ext x0; unfold tanNum; ring
  rw [heq, integral_poly4]; unfold TG1; ring

private lemma TG_step1 (φ : ℝ) (z : R2) :
    ∫ x1 in ((φ - 2 * z.1 - z.2) / 2)..z.1, TG1 φ (x1, z) = TG2 φ z := by
  rcases z with ⟨x2, x3⟩
  have heq : (fun x1 : ℝ => TG1 φ (x1, x2, x3)) =
      (fun x1 : ℝ => ((-6 : ℝ) * φ + (195250 / 76239 : ℝ) * φ ^ 2 + (6 : ℝ) * x3 + (-1582000 / 584499 : ℝ) * x3 * φ + (255250 / 1753497 : ℝ) * x3 ^ 2 + (12 : ℝ) * x2 + (-16463600 / 3125799 : ℝ) * x2 * φ + (10450600 / 23964459 : ℝ) * x2 * x3 + (4600 / 15867 : ℝ) * x2 ^ 2) + ((12 : ℝ) + (-26421500 / 5108013 : ℝ) * φ + (40137500 / 117484299 : ℝ) * x3 + (81871400 / 209428533 : ℝ) * x2) * x1 + ((4000 / 39597 : ℝ)) * x1 ^ 2 + ((0 : ℝ)) * x1 ^ 3 + ((0 : ℝ)) * x1 ^ 4) := by ext x1; unfold TG1; ring
  rw [heq, integral_poly4]; unfold TG2; ring

private lemma TG_step2 (φ : ℝ) (x3 : ℝ) :
