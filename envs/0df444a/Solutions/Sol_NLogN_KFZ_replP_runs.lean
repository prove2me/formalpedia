theorem replP_runs_sol_aux (H W : Fin HS) (hHU : H ≠ pU) (hWU : W ≠ pU) (hHW : H ≠ W) (hH : NC H)
    (hW : NC W) (hHo : H ≠ oA ∧ H ≠ oC ∧ H ≠ oD) (hWo : W ≠ oA ∧ W ≠ oC ∧ W ≠ oD)
    (hHr : H ≠ rN2) (hWr : W ≠ rN2) (hWr1 : W ≠ KFM.rN) (τ : List GI) (B : ℕ) (hB : GB B τ)
    (N : ℕ) (s : IState HS) (RH L1 L2 : List Item) (h0 : s.G H = ints (gflat τ) ++ RH)
    (hN1 : s.G KFM.rN = .int (N : ℤ) :: L1) (hN2 : s.G rN2 = .int ((2 * τ.length : ℕ) : ℤ) :: L2) :
    IRuns I iprog (replP H W) s
      (s.upd W (ints (gflat (List.replicate N τ).flatten) ++ s.G W))
      (cRepl N (2 * τ.length) B) := by
  set M := 2 * τ.length with hM
  have hlen : (gflat τ).length = M := by rw [length_gflat]
  let T : ℕ → IState HS := fun k => s.upd W (ints (gflat (List.replicate k τ).flatten) ++ s.G W)
  have H := KFT.rptX_runs (I := I) (iprog := iprog) (X := KFM.rN) (A := oA) (C := oC) (D := oD)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) N T (fun k => by simp [T, hWo.1.symm])
    (fun k => by simp [T, hWo.2.1.symm]) (fun k => by simp [T, hWo.2.2.symm]) _
    (M * (110 * (B + 1) + 64) + 60 + cRpt M + cCnt M +
      (M * (410 * (B + 1) + 64) + 60 + cRpt M + cCnt M))
    (by
      intro k hk LA LC LD
      set st := cf3 (T k) oA oC oD LA LC LD with hst
      have hH0 : st.G H = ints (gflat τ) ++ RH := by
        simp [hst, T, cf3, hHo.1, hHo.2.1, hHo.2.2, hHW, h0]
      have hR2 : st.G rN2 = .int (M : ℤ) :: L2 := by
        simp +decide [hst, T, cf3, hN2, hWr, Ne.symm hWr]
      have k1 := NLogN.KFM.mvN_runs (I := I) (iprog := iprog) H pU hHU hH (by decide) (gflat τ) B hB.bnd st
        RH hH0
      rw [hlen] at k1
      have k1 := rptX_of_rpt (by decide) hR2 k1
      set s1 := (st.upd H RH).upd pU (ints (gflat τ).reverse ++ st.G pU) with hs1
      have hB' : ∀ x ∈ (gflat τ).reverse, zsz x ≤ B := bnd_rev hB
      have k2 := NLogN.KFM.dmN_runs (I := I) (iprog := iprog) pU W H (Ne.symm hWU) (Ne.symm hHU) (Ne.symm hHW)
        (by decide) hW hH (gflat τ).reverse B hB' s1 (st.G pU) (by simp [hs1])
      rw [List.length_reverse, hlen, List.reverse_reverse] at k2
      have k2 := rptX_of_rpt (by decide) (show s1.G rN2 = .int (M : ℤ) :: L2 by
        simp +decide [hs1, hR2, Ne.symm hHr, hHr]) k2
      refine (k1.seq k2).mono' ?_ le_rfl
      have e1 : gflat (List.replicate (k + 1) τ).flatten =
          gflat τ ++ gflat (List.replicate k τ).flatten := by
        rw [List.replicate_succ, List.flatten_cons, gflat_append]
