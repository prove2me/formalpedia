-- Source module: Solutions.R6BitNBChunk
/-!
# Round six, bit network: the label generator, soundness of the packed representation

* bit lemmas for `fieldOf` / `setF` and the trees `LT` (`ltGet`, `ltSet`, `mkTree`, `ofLT`);
* `genF`: the generator on code states `ℕ → ℕ` (the specification of `genP`);
  `genP_eq`: on trees of depth 4 with 65536-bit leaves, `genP` computes `genF` of the code
  function `pget t`;
* `segChk_sound`: the kernel segment checks give the chunks of `genF` from `fieldOf S 16`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

open R6Chk R6Chk.Bit

/-! ## Bits -/

theorem testBit_ge_of_lt {x n m : ℕ} (hx : x < 2 ^ n) (hm : n ≤ m) : x.testBit m = false :=
  Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) hm))

theorem fieldOf_fieldOf (S w b k j : ℕ) (hj : j < 2 ^ b) :
    fieldOf (fieldOf S (w * 2 ^ b) k) w j = fieldOf S w (2 ^ b * k + j) := by
  apply Nat.eq_of_testBit_eq
  intro t
  rw [testBit_fieldOf, testBit_fieldOf, testBit_fieldOf]
  by_cases ht : t < w
  · have h1 : w * j + t < w * 2 ^ b := by
      have : w * j + w ≤ w * 2 ^ b := by
        rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ hj
      omega
    simp only [ht, h1, decide_true, Bool.true_and]
    congr 1
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm w (2 ^ b)]
    ring
  · simp [ht]

theorem setF_fieldOf (S i j v : ℕ) (hv : v < 2 ^ 16) :
    fieldOf (setF S i v) 16 j = if i = j then v else fieldOf S 16 j := by
  apply Nat.eq_of_testBit_eq
  intro t
  have hf : fieldOf S 16 i ^^^ v < 2 ^ 16 := Nat.xor_lt_two_pow (fieldOf_lt _ _ _) hv
  rw [testBit_fieldOf, setF, nxor, nshl, nxor, nmul, Nat.testBit_xor, Nat.testBit_shiftLeft]
  by_cases ht : t < 16
  · simp only [ht, decide_true, Bool.true_and]
    split_ifs with hij
    · subst hij
      have : 16 * i ≤ 16 * i + t := by omega
      simp only [this, decide_true, Bool.true_and, Nat.add_sub_cancel_left, Nat.testBit_xor,
        testBit_fieldOf, ht]
      cases S.testBit (16 * i + t) <;> simp
    · simp only [testBit_fieldOf, ht, decide_true, Bool.true_and]
      have : (decide (16 * i ≤ 16 * j + t) && (fieldOf S 16 i ^^^ v).testBit (16 * j + t - 16 * i)) =
          false := by
        by_cases hle : 16 * i ≤ 16 * j + t
        · rw [testBit_ge_of_lt hf]
          · simp
          · rcases Nat.lt_or_gt_of_ne hij with h | h <;> omega
        · simp [hle]
      rw [this, Bool.xor_false]
  · simp only [ht, decide_false, Bool.false_and]
    split_ifs
    · exact (testBit_ge_of_lt hv (by omega)).symm
    · rw [testBit_fieldOf]; simp [ht]

theorem setF_lt {L i v W : ℕ} (hL : L < 2 ^ W) (hv : v < 2 ^ 16) (hi : 16 * i + 16 ≤ W) :
    setF L i v < 2 ^ W := by
  rw [setF, nxor, nshl, nxor, nmul]
  apply Nat.xor_lt_two_pow hL
  rw [Nat.shiftLeft_eq]
  have hf : fieldOf L 16 i ^^^ v < 2 ^ 16 := Nat.xor_lt_two_pow (fieldOf_lt _ _ _) hv
  calc (fieldOf L 16 i ^^^ v) * 2 ^ (16 * i) < 2 ^ 16 * 2 ^ (16 * i) :=
        Nat.mul_lt_mul_of_pos_right hf (Nat.two_pow_pos _)
    _ = 2 ^ (16 * i + 16) := by rw [← Nat.pow_add, Nat.add_comm]
    _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hi

/-! ## Trees -/

theorem ltGet_leaf (x d i : ℕ) : ltGet (.leaf x) d i = x := rfl

theorem ltGet_node (l r : LT) (d i : ℕ) :
    ltGet (.node l r) (d + 1) i = if i.testBit d then ltGet r d i else ltGet l d i := by
  show cond (tb i (Nat.sub (d + 1) 1)) _ _ = _
  rw [show Nat.sub (d + 1) 1 = d from rfl, tb_eq]
  cases i.testBit d <;> rfl

theorem ltSet_leaf (x d i y : ℕ) : ltSet (.leaf x) d i y = .leaf y := rfl

theorem ltSet_node (l r : LT) (d i y : ℕ) :
    ltSet (.node l r) (d + 1) i y =
      if i.testBit d then .node l (ltSet r d i y) else .node (ltSet l d i y) r := by
  show cond (tb i (Nat.sub (d + 1) 1)) _ _ = _
  rw [show Nat.sub (d + 1) 1 = d from rfl, tb_eq]
  cases i.testBit d <;> rfl

theorem ltGet_ltSet {W : ℕ} : ∀ (t : LT) (d : ℕ), Good W t d → ∀ i j y,
    ltGet (ltSet t d i y) d j = if (∀ k < d, i.testBit k = j.testBit k) then y else ltGet t d j
  | .leaf x, 0, _, i, j, y => by simp [ltSet_leaf, ltGet_leaf]
  | .leaf _, _ + 1, h, _, _, _ => h.elim
  | .node _ _, 0, h, _, _, _ => h.elim
  | .node l r, d + 1, h, i, j, y => by
    rw [ltSet_node]
    by_cases hi : i.testBit d <;> by_cases hj : j.testBit d <;> simp only [hi, hj, ltGet_node,
      if_true, if_false, Bool.false_eq_true]
    · rw [ltGet_ltSet r d h.2]
      congr 1
      apply propext
      constructor
      · intro hk k hk'
        rcases Nat.lt_or_ge k d with h' | h'
        · exact hk k h'
        · have : k = d := by omega
          subst this; rw [hi, hj]
      · intro hk k hk'; exact hk k (by omega)
    · rw [if_neg]; intro hk; have := hk d (by omega); simp_all
    · rw [if_neg]; intro hk; have := hk d (by omega); simp_all
    · rw [ltGet_ltSet l d h.1]
      congr 1
      apply propext
      constructor
      · intro hk k hk'
        rcases Nat.lt_or_ge k d with h' | h'
        · exact hk k h'
        · have : k = d := by omega
          subst this; simp_all
      · intro hk k hk'; exact hk k (by omega)

theorem good_ltSet {W : ℕ} : ∀ (t : LT) (d : ℕ), Good W t d → ∀ i y, y < 2 ^ W → Good W (ltSet t d i y) d
  | .leaf _, 0, _, _, _, hy => hy
  | .leaf _, _ + 1, h, _, _, _ => h.elim
  | .node _ _, 0, h, _, _, _ => h.elim
  | .node l r, d + 1, h, i, y, hy => by
    rw [ltSet_node]
    split_ifs
    · exact ⟨h.1, good_ltSet r d h.2 i y hy⟩
    · exact ⟨good_ltSet l d h.1 i y hy, h.2⟩

theorem ltGet_lt {W : ℕ} : ∀ (t : LT) (d : ℕ), Good W t d → ∀ i, ltGet t d i < 2 ^ W
  | .leaf _, 0, h, _ => h
  | .leaf _, _ + 1, h, _ => h.elim
  | .node _ _, 0, h, _ => h.elim
  | .node l r, d + 1, h, i => by
    rw [ltGet_node]; split_ifs
    · exact ltGet_lt r d h.2 i
    · exact ltGet_lt l d h.1 i

theorem eq_of_lowBits {i j d : ℕ} (hi : i < 2 ^ d) (hj : j < 2 ^ d) :
    (∀ k < d, i.testBit k = j.testBit k) ↔ i = j := by
  constructor
  · intro h
    apply Nat.eq_of_testBit_eq
    intro k
    by_cases hk : k < d
    · exact h k hk
    · rw [testBit_ge_of_lt hi (by omega), testBit_ge_of_lt hj (by omega)]
  · rintro rfl _ _; rfl

theorem mkTree_succ (S lw d k : ℕ) :
    mkTree S lw (d + 1) k = .node (mkTree S lw d (2 * k)) (mkTree S lw d (2 * k + 1)) := rfl

theorem good_mkTree (S lw : ℕ) : ∀ d k, Good lw (mkTree S lw d k) d
  | 0, k => fieldOf_lt S lw k
  | d + 1, k => by rw [mkTree_succ]; exact ⟨good_mkTree S lw d _, good_mkTree S lw d _⟩

theorem mod_two_pow_succ' (i d : ℕ) :
    i % 2 ^ (d + 1) = i % 2 ^ d + (if i.testBit d then 2 ^ d else 0) := by
  rw [pow_succ, Nat.mod_mul, Nat.testBit_eq_decide_div_mod_eq]
  rcases Nat.mod_two_eq_zero_or_one (i / 2 ^ d) with h | h <;> simp [h]

theorem ltGet_mkTree (S lw : ℕ) : ∀ d k i,
    ltGet (mkTree S lw d k) d i = fieldOf S lw (2 ^ d * k + i % 2 ^ d)
  | 0, k, i => by simp [mkTree, ltGet_leaf, Nat.mod_one]
  | d + 1, k, i => by
    rw [mkTree_succ, ltGet_node, mod_two_pow_succ']
    split_ifs with hb
    · rw [ltGet_mkTree S lw d]; congr 1; rw [pow_succ]; ring
    · rw [ltGet_mkTree S lw d]; congr 1; rw [pow_succ]; ring

/-! ## Packed code states -/

theorem shr12 (w : ℕ) : Nat.shiftRight w 12 = w / 4096 := by
  rw [nshr, Nat.shiftRight_eq_div_pow]

theorem land4095 (w : ℕ) : Nat.land w 4095 = w % 4096 := by
  rw [nland, show (4095 : ℕ) = 2 ^ 12 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]

theorem pget_eq (t : LT) (w : ℕ) : pget t w = fieldOf (ltGet t 4 (w / 4096)) 16 (w % 4096) := by
  rw [pget, shr12, land4095]

theorem pget_pset {t : LT} (ht : Good 65536 t 4) {w w' v : ℕ} (hw : w < 65536) (hw' : w' < 65536)
    (hv : v < 2 ^ 16) : pget (pset t w v) w' = if w = w' then v else pget t w' := by
  have h16 : w / 4096 < 2 ^ 4 := by norm_num; omega
  have h16' : w' / 4096 < 2 ^ 4 := by norm_num; omega
  rw [pset, shr12, land4095, pget_eq, pget_eq, ltGet_ltSet t 4 ht]
  by_cases hk : w / 4096 = w' / 4096
  · rw [if_pos ((eq_of_lowBits h16 h16').2 hk), setF_fieldOf _ _ _ _ hv, hk]
    by_cases hl : w % 4096 = w' % 4096
    · rw [if_pos hl, if_pos (by omega)]
    · rw [if_neg hl, if_neg (by omega)]
  · rw [if_neg (fun h => hk ((eq_of_lowBits h16 h16').1 h)), if_neg (by omega)]

theorem good_pset {t : LT} (ht : Good 65536 t 4) (w : ℕ) {v : ℕ} (hv : v < 2 ^ 16) :
    Good 65536 (pset t w v) 4 := by
  rw [pset, shr12, land4095]
  exact good_ltSet t 4 ht _ _ (setF_lt (ltGet_lt t 4 ht _) hv (by omega))

theorem pget_toLT (S : ℕ) {w : ℕ} (hw : w < 65536) : pget (toLT S) w = fieldOf S 16 w := by
  rw [pget_eq, toLT, ltGet_mkTree, show (65536 : ℕ) = 16 * 2 ^ 12 from rfl,
    fieldOf_fieldOf S 16 12 _ _ (show w % 4096 < 2 ^ 12 by norm_num; omega)]
  congr 1
  rw [Nat.mod_eq_of_lt (show w / 4096 < 2 ^ 4 by norm_num; omega)]
  norm_num; omega

theorem good_toLT (S : ℕ) : Good 65536 (toLT S) 4 := good_mkTree S 65536 4 0

theorem fieldOf_catB (B : ℕ) : ∀ (l : List ℕ), (∀ x ∈ l, x < 2 ^ B) → ∀ k,
    fieldOf (catB B l) B k = l.getD k 0
  | [], _, k => by
    simp only [catB, List.foldr_nil, List.getD_nil]
    apply Nat.eq_of_testBit_eq; intro t; simp [testBit_fieldOf]
  | x :: l, hl, k => by
    have hx : x < 2 ^ B := hl x (by simp)
    have ih := fieldOf_catB B l (fun y hy => hl y (by simp [hy]))
    apply Nat.eq_of_testBit_eq
    intro t
    rw [testBit_fieldOf]
    show (decide (t < B) && (x ||| (catB B l <<< B)).testBit (B * k + t)) = _
    rw [Nat.testBit_or, Nat.testBit_shiftLeft]
    cases k with
    | zero =>
      simp only [Nat.mul_zero, Nat.zero_add, List.getD_cons_zero]
      by_cases ht : t < B
      · simp [ht]
      · simp only [ht, decide_false, Bool.false_and]
        exact (testBit_ge_of_lt hx (by omega)).symm
    | succ k =>
      simp only [List.getD_cons_succ]
      rw [← ih k, testBit_fieldOf, testBit_ge_of_lt hx (by nlinarith)]
      by_cases ht : t < B
      · have h1 : B ≤ B * (k + 1) + t := by nlinarith
        simp only [ht, h1, decide_true, Bool.true_and, Bool.false_or]
        congr 1
        rw [Nat.mul_add, Nat.mul_one]; omega
      · simp [ht]

theorem ofLT_eq (t : LT) : ofLT t = catB 65536 ((List.range 16).map (ltGet t 4)) := by
  rw [ofLT, catB, List.foldr_map]; rfl

theorem fieldOf_ofLT {t : LT} (ht : Good 65536 t 4) {w : ℕ} (hw : w < 65536) :
    fieldOf (ofLT t) 16 w = pget t w := by
  have hq : w / 4096 < 16 := by omega
  have h1 := fieldOf_fieldOf (ofLT t) 16 12 (w / 4096) (w % 4096) (by norm_num; omega)
  rw [show 2 ^ 12 * (w / 4096) + w % 4096 = w by omega, show (16 * 2 ^ 12 : ℕ) = 65536 by norm_num] at h1
  rw [← h1, pget_eq, ofLT_eq, fieldOf_catB]
  · have hl : w / 4096 < ((List.range 16).map (ltGet t 4)).length := by simpa using hq
    rw [List.getD_eq_getElem _ _ hl, List.getElem_map, List.getElem_range]
  · intro x hx
    simp only [List.mem_map] at hx
    obtain ⟨k, -, rfl⟩ := hx
    exact ltGet_lt t 4 ht k

/-! ## The generator on code functions -/

theorem foldl_mvP_eq {c : ℕ} (hc : c < 65536) : ∀ (ts : List ℕ), (∀ w ∈ ts, w < 65536) →
    ∀ (t : LT) (f : ℕ → ℕ) (acc : List (ℕ × ℕ)), Good 65536 t 4 → (∀ w < 65536, pget t w = f w) →
      (ts.foldl (mvP c) (t, acc)).2 = (ts.foldl (mvF c) (f, acc)).2 ∧
        Good 65536 (ts.foldl (mvP c) (t, acc)).1 4 ∧
        ∀ w < 65536, pget (ts.foldl (mvP c) (t, acc)).1 w = (ts.foldl (mvF c) (f, acc)).1 w
  | [], _, t, f, acc, ht, hf => ⟨rfl, ht, hf⟩
  | w :: ts, hts, t, f, acc, ht, hf => by
    have hw : w < 65536 := hts w (by simp)
    have hts' : ∀ w ∈ ts, w < 65536 := fun x hx => hts x (by simp [hx])
    simp only [List.foldl_cons]
    have hstep : mvP c (t, acc) w = if f w = c then (t, acc) else (pset t w c, (w, f w) :: acc) := by
      rw [mvP, ← hf w hw, show Nat.beq (pget t w) c = decide (pget t w = c) by
        rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]]
      by_cases h : pget t w = c
      · simp [h]
      · simp [h]
    rw [hstep]
    by_cases h : f w = c
    · rw [if_pos h, show mvF c (f, acc) w = (f, acc) by simp [mvF, h]]
      exact foldl_mvP_eq hc ts hts' t f acc ht hf
    · rw [if_neg h, show mvF c (f, acc) w = (Function.update f w c, (w, f w) :: acc) by simp [mvF, h]]
      apply foldl_mvP_eq hc ts hts' _ _ _ (good_pset ht w (by omega))
      intro x hx
      rw [pget_pset ht hw hx (by omega)]
      by_cases hxw : w = x
      · subst hxw; simp
      · rw [if_neg hxw, Function.update_of_ne (Ne.symm hxw), hf x hx]

theorem foldl_genStepP_eq : ∀ (W : List LInstr), Fits W →
    ∀ (t : LT) (f : ℕ → ℕ) (acc : List LChunk), Good 65536 t 4 → (∀ w < 65536, pget t w = f w) →
      (W.foldl genStepP (t, acc)).2 = (W.foldl genStepF (f, acc)).2 ∧
        Good 65536 (W.foldl genStepP (t, acc)).1 4 ∧
        ∀ w < 65536, pget (W.foldl genStepP (t, acc)).1 w = (W.foldl genStepF (f, acc)).1 w
  | [], _, t, f, acc, ht, hf => ⟨rfl, ht, hf⟩
  | i :: W, hW, t, f, acc, ht, hf => by
    have hi := hW i (by simp)
    have hW' : Fits W := fun j hj => hW j (by simp [hj])
    obtain ⟨e1, e2, e3⟩ := foldl_mvP_eq hi.1 i.2.1 hi.2 t f [] ht hf
    simp only [List.foldl_cons, genStepP, genStepF]
    rw [e1]
    exact foldl_genStepP_eq W hW' _ _ _ e2 e3

/-- **`genP` computes `genF`.** -/
theorem genP_eq {W : List LInstr} (hW : Fits W) {t : LT} (ht : Good 65536 t 4) {f : ℕ → ℕ}
    (hf : ∀ w < 65536, pget t w = f w) :
    (genP t W).2 = (genF f W).2 ∧ Good 65536 (genP t W).1 4 ∧
      ∀ w < 65536, pget (genP t W).1 w = (genF f W).1 w := by
  obtain ⟨e1, e2, e3⟩ := foldl_genStepP_eq W hW t f [] ht hf
  exact ⟨by simp only [genP, genF, e1], e2, e3⟩

/-- **Soundness of a segment check.** -/
theorem segChk_sound {S S' cnt : ℕ} {W : List LInstr} (hW : Fits W) (h : segChk S S' cnt W = true) :
    (∀ w < 65536, (genF (codeOf S) W).1 w = codeOf S' w) ∧ movesOK (genF (codeOf S) W).2 = true ∧
      cntF (genF (codeOf S) W).2 = cnt := by
  obtain ⟨e1, e2, e3⟩ := genP_eq hW (good_toLT S) (f := codeOf S) (fun w hw => pget_toLT S hw)
  simp only [segChk, segRes, Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨fun w hw => ?_, by rw [← e1]; exact h2, by rw [← e1]; exact h3⟩
  rw [← e3 w hw, codeOf, ← h1, fieldOf_ofLT e2 hw]

theorem foldl_mvF_congr {c : ℕ} : ∀ (ts : List ℕ) (P : ℕ → Prop), (∀ w ∈ ts, P w) →
    ∀ (f g : ℕ → ℕ) (acc : List (ℕ × ℕ)), (∀ w, P w → f w = g w) →
      (ts.foldl (mvF c) (f, acc)).2 = (ts.foldl (mvF c) (g, acc)).2 ∧
        ∀ w, P w → (ts.foldl (mvF c) (f, acc)).1 w = (ts.foldl (mvF c) (g, acc)).1 w
  | [], _, _, f, g, acc, hfg => ⟨rfl, hfg⟩
  | w :: ts, P, hts, f, g, acc, hfg => by
    simp only [List.foldl_cons]
    have hw := hts w (by simp)
    have hts' : ∀ x ∈ ts, P x := fun x hx => hts x (by simp [hx])
    simp only [mvF, hfg w hw]
    split_ifs
    · exact foldl_mvF_congr ts P hts' f g acc hfg
    · apply foldl_mvF_congr ts P hts'
      intro x hx
      by_cases hxw : x = w
      · subst hxw; simp
      · rw [Function.update_of_ne hxw, Function.update_of_ne hxw, hfg x hx]

/-- `genF` only reads the codes of touched wires. -/
theorem genF_congr_aux : ∀ (W : List LInstr) (P : ℕ → Prop), (∀ i ∈ W, ∀ w ∈ i.2.1, P w) →
    ∀ (f g : ℕ → ℕ) (acc : List LChunk), (∀ w, P w → f w = g w) →
      (W.foldl genStepF (f, acc)).2 = (W.foldl genStepF (g, acc)).2 ∧
        ∀ w, P w → (W.foldl genStepF (f, acc)).1 w = (W.foldl genStepF (g, acc)).1 w
  | [], _, _, f, g, acc, hfg => ⟨rfl, hfg⟩
  | i :: W, P, hW, f, g, acc, hfg => by
    simp only [List.foldl_cons, genStepF]
    obtain ⟨e1, e2⟩ := foldl_mvF_congr (c := i.1) i.2.1 P (hW i (by simp)) f g [] hfg
    rw [e1]
    exact genF_congr_aux W P (fun j hj => hW j (by simp [hj])) _ _ _ e2

theorem genF_congr {W : List LInstr} {P : ℕ → Prop} (hW : ∀ i ∈ W, ∀ w ∈ i.2.1, P w) {f g : ℕ → ℕ}
    (hfg : ∀ w, P w → f w = g w) :
    (genF f W).2 = (genF g W).2 ∧ ∀ w, P w → (genF f W).1 w = (genF g W).1 w := by
  obtain ⟨e1, e2⟩ := genF_congr_aux W P hW f g [] hfg
  exact ⟨by simp only [genF, e1], e2⟩

theorem foldl_genStepF_acc : ∀ (W : List LInstr) (f : ℕ → ℕ) (acc : List LChunk),
    W.foldl genStepF (f, acc) = ((W.foldl genStepF (f, [])).1, (W.foldl genStepF (f, [])).2 ++ acc)
  | [], f, acc => rfl
  | i :: W, f, acc => by
    simp only [List.foldl_cons, genStepF]
    rw [foldl_genStepF_acc W _ ((i.1, _, i.2.2) :: acc), foldl_genStepF_acc W _ [(i.1, _, i.2.2)]]
    simp

theorem genF_append (f : ℕ → ℕ) (W W' : List LInstr) :
    genF f (W ++ W') = ((genF (genF f W).1 W').1, (genF f W).2 ++ (genF (genF f W).1 W').2) := by
  simp only [genF, List.foldl_append]
  rw [foldl_genStepF_acc W' _ (W.foldl genStepF (f, [])).2]
  simp

theorem genF_cons (f : ℕ → ℕ) (i : LInstr) (W : List LInstr) :
    genF f (i :: W) = ((genF (i.2.1.foldl (mvF i.1) (f, [])).1 W).1,
      (i.1, (i.2.1.foldl (mvF i.1) (f, [])).2.reverse, i.2.2) ::
        (genF (i.2.1.foldl (mvF i.1) (f, [])).1 W).2) := by
  have := genF_append f [i] W
  simp only [List.singleton_append] at this
  rw [this]
  simp [genF, genStepF]

theorem genF_nil (f : ℕ → ℕ) : genF f [] = (f, []) := rfl

/-- Gates are kept. -/
theorem genF_gates : ∀ (W : List LInstr) (f : ℕ → ℕ),
    (genF f W).2.flatMap (fun ch => ch.2.2) = W.flatMap (fun i => i.2.2)
  | [], _ => rfl
  | i :: W, f => by
    rw [genF_cons, List.flatMap_cons, List.flatMap_cons, genF_gates W]

/-- A segment whose touched wires are all at the instruction codes emits no moves. -/
theorem genF_static : ∀ (W : List LInstr) (f : ℕ → ℕ), (∀ i ∈ W, ∀ w ∈ i.2.1, f w = i.1) →
    genF f W = (f, W.map fun i => (i.1, [], i.2.2))
  | [], _, _ => rfl
  | i :: W, f, h => by
    have hfold : ∀ (ts : List ℕ), (∀ w ∈ ts, f w = i.1) → ts.foldl (mvF i.1) (f, []) = (f, []) := by
      intro ts hts
      induction ts with
      | nil => rfl
      | cons w ts ih =>
        simp only [List.foldl_cons, mvF, hts w (by simp), if_true]
        exact ih (fun x hx => hts x (by simp [hx]))
    rw [genF_cons, hfold _ (h i (by simp)), genF_static W f (fun j hj => h j (by simp [hj]))]
    simp

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBLabGen
/-!
# Round six, bit network: programs from generated chunks

A local program is a list of chunks `(code, moves, gates)` over local wires `ℕ`. Mapped to global
wires by `ι`, a chunk becomes: one frame-change edge per move (`E old code`), then one XOR gate
`x_d ← x_d + x_s` per gate.

* `genF_labGates`: for chunks produced by `genF` (the label generator), all gates are label
  consistent (`LabGates`) as soon as every move edge maps the frame of its old code to the
  frame of its new code; the final labels are the frames of the final codes.
* `chunkProg_scalar`: the (module-valued) scalar circuit of a mapped chunk program is the local
  XOR run `xrL` of its gates.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open R6Chk.Bit.Loc Matrix

section LabGen

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {R : Type*} [CommRing R] {m N : ℕ}

theorem foldl_mvF_acc (c : ℕ) : ∀ (ts : List ℕ) (g : ℕ → ℕ) (acc : List (ℕ × ℕ)),
    ts.foldl (mvF c) (g, acc) = ((ts.foldl (mvF c) (g, [])).1, (ts.foldl (mvF c) (g, [])).2 ++ acc)
  | [], g, acc => rfl
  | w :: ts, g, acc => by
    simp only [List.foldl_cons, mvF]
    split_ifs
    · exact foldl_mvF_acc c ts g acc
    · rw [foldl_mvF_acc c ts _ ((w, g w) :: acc), foldl_mvF_acc c ts _ [(w, g w)]]; simp

theorem foldl_mvF_cons (c : ℕ) (w : ℕ) (ts : List ℕ) (g : ℕ → ℕ) :
    (w :: ts).foldl (mvF c) (g, []) =
      if g w = c then ts.foldl (mvF c) (g, [])
      else ((ts.foldl (mvF c) (Function.update g w c, [])).1,
        (ts.foldl (mvF c) (Function.update g w c, [])).2 ++ [(w, g w)]) := by
  simp only [List.foldl_cons, mvF]
  split_ifs
  · rfl
  · exact foldl_mvF_acc c ts _ _

/-- The moved state: touched wires end at `c`, others keep their code. -/
theorem foldl_mvF_state (c : ℕ) : ∀ (ts : List ℕ) (g : ℕ → ℕ),
    (∀ w ∈ ts, (ts.foldl (mvF c) (g, [])).1 w = c) ∧
      ∀ w, w ∉ ts → (ts.foldl (mvF c) (g, [])).1 w = g w
  | [], g => ⟨by simp, fun _ _ => rfl⟩
  | w :: ts, g => by
    rw [foldl_mvF_cons]
    split_ifs with h
    · obtain ⟨h1, h2⟩ := foldl_mvF_state c ts g
      refine ⟨fun x hx => ?_, fun x hx => h2 x (fun h' => hx (by simp [h']))⟩
      rcases List.mem_cons.1 hx with rfl | hx
      · by_cases hxt : x ∈ ts
        · exact h1 x hxt
        · rw [h2 x hxt, h]
      · exact h1 x hx
    · obtain ⟨h1, h2⟩ := foldl_mvF_state c ts (Function.update g w c)
      refine ⟨fun x hx => ?_, fun x hx => ?_⟩
      · rcases List.mem_cons.1 hx with rfl | hx
        · by_cases hxt : x ∈ ts
          · exact h1 x hxt
          · rw [h2 x hxt]; simp
        · exact h1 x hx
      · have hx' : x ∉ ts := fun h' => hx (by simp [h'])
        have hxw : x ≠ w := fun h' => hx (by simp [h'])
        rw [h2 x hx', Function.update_of_ne hxw]

variable (ι : ℕ → Wr) (D : ℕ → Prop) (lab : ℕ → FMat m N) (E : ℕ → ℕ → Edge m)

end LabGen

/-! ## The scalar circuit of a chunk program -/

section Scalar

variable {Wr : Type*} [DecidableEq Wr] {R : Type*} [CommRing R] {m : ℕ}
  {M : Type*} [AddCommGroup M] [Module R M]

theorem xrL_cons (p : ℕ × ℕ) (l : List (ℕ × ℕ)) (u : ℕ → M) :
    xrL l (Function.update u p.1 (u p.1 + u p.2)) = xrL (p :: l) u := rfl

theorem xrL_append (l l' : List (ℕ × ℕ)) (u : ℕ → M) : xrL (l ++ l') u = xrL l' (xrL l u) := by
  simp [xrL, List.foldl_append]

theorem gateVecM_xorG {d s : Wr} (hds : d ≠ s) (v : Wr → M) :
    gateVecM (fun x y => if x = y then (1 : R) else if x = d ∧ y = s then 1 else 0) {d, s} v =
      Function.update v d (v d + v s) := by
  funext w
  simp only [gateVecM, Finset.mem_insert, Finset.mem_singleton]
  by_cases hwd : w = d
  · subst hwd
    rw [Finset.sum_pair hds]
    simp
  · by_cases hws : w = s
    · subst hws
      rw [Finset.sum_pair hds]
      simp [hwd]
    · simp [hwd, hws]

variable (ι : ℕ → Wr) (D : ℕ → Prop) (E : ℕ → ℕ → Edge m)

theorem xorGs_scalar (hι : ∀ w w', D w → D w' → ι w = ι w' → w = w') :
    ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, D p.1 ∧ D p.2 ∧ p.1 ≠ p.2) → ∀ (v : Wr → M) (u : ℕ → M),
      (∀ w, D w → v (ι w) = u w) →
      (∀ w, D w → (l.map fun p => (xorG (ι p.1) (ι p.2) : Instr Wr R m)).foldl scalarStepM v (ι w) =
        xrL l u w) ∧
      ∀ x, (∀ w, D w → ι w ≠ x) →
        (l.map fun p => (xorG (ι p.1) (ι p.2) : Instr Wr R m)).foldl scalarStepM v x = v x
  | [], v, u, _, h => ⟨h, fun _ _ => rfl⟩
  | p :: l, hl, v, u, h => by
    obtain ⟨hd, hs, hds⟩ := hl p (by simp)
    have hds' : ι p.1 ≠ ι p.2 := fun e => hds (hι _ _ hd hs e)
    simp only [List.map_cons, List.foldl_cons]
    have hstep : scalarStepM v (xorG (ι p.1) (ι p.2) : Instr Wr R m) =
        Function.update v (ι p.1) (v (ι p.1) + v (ι p.2)) := gateVecM_xorG hds' v
    rw [hstep, ← xrL_cons]
    obtain ⟨h1, h2⟩ := xorGs_scalar hι l (fun q hq => hl q (by simp [hq]))
      (Function.update v (ι p.1) (v (ι p.1) + v (ι p.2))) (Function.update u p.1 (u p.1 + u p.2)) (by
        intro w hw
        by_cases hwp : w = p.1
        · subst hwp; simp [h _ hd, h _ hs]
        · rw [Function.update_of_ne (fun e => hwp (hι _ _ hw hd e)), Function.update_of_ne hwp, h w hw])
    refine ⟨h1, fun x hx => ?_⟩
    rw [h2 x hx, Function.update_of_ne (fun e => hx _ hd e.symm)]

/-- **Scalar run of a chunk program**: the local XOR run of its gates. -/
theorem chunkProg_scalar (hι : ∀ w w', D w → D w' → ι w = ι w' → w = w') :
    ∀ (cs : List LChunk), (∀ ch ∈ cs, ∀ p ∈ ch.2.2, D p.1 ∧ D p.2 ∧ p.1 ≠ p.2) →
      ∀ (v : Wr → M) (u : ℕ → M), (∀ w, D w → v (ι w) = u w) →
        (∀ w, D w → (chunkProg (R := R) ι E cs).foldl scalarStepM v (ι w) =
          xrL (cs.flatMap fun ch => ch.2.2) u w) ∧
        ∀ x, (∀ w, D w → ι w ≠ x) → (chunkProg (R := R) ι E cs).foldl scalarStepM v x = v x
  | [], _, v, u, h => ⟨h, fun _ _ => rfl⟩
  | ch :: cs, hcs, v, u, h => by
    have hedges : ∀ (l : List (Wr × Edge m)),
        (l.map fun p => (Instr.edge p.1 p.2 : Instr Wr R m)).foldl scalarStepM v = v := by
      intro l; induction l with
      | nil => rfl
      | cons p l ih => simpa [scalarStepM] using ih
    have hprog : chunkProg (R := R) ι E (ch :: cs) =
        (ch.2.1.map fun mv => (ι mv.1, E mv.2 ch.1)).map (fun p => (Instr.edge p.1 p.2 : Instr Wr R m)) ++
          ((ch.2.2.map fun p => (xorG (ι p.1) (ι p.2) : Instr Wr R m)) ++ chunkProg (R := R) ι E cs) := by
      simp [chunkProg, chunkInstrs, List.flatMap_cons, List.append_assoc, Function.comp_def]
    rw [hprog, List.foldl_append, hedges, List.foldl_append]
    obtain ⟨g1, g2⟩ := xorGs_scalar (R := R) (m := m) ι D hι ch.2.2 (hcs ch (by simp)) v u h
    obtain ⟨r1, r2⟩ := chunkProg_scalar hι cs (fun c hc => hcs c (by simp [hc])) _ (xrL ch.2.2 u) g1
    refine ⟨fun w hw => ?_, fun x hx => ?_⟩
    · rw [r1 w hw, List.flatMap_cons, xrL_append]
    · rw [r2 x hx, g2 x hx]

end Scalar

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBScalA
/-!
# Round six, bit network: the producer computes the node values (`B A C = I`)

Over a module `M` of characteristic two, for inputs `x : ℕ → M`:

* XOR-run algebra: `xrL` is additive, is inverted by the reversed run, and acts on read/write
  separated gate lists by adding the sources;
* `msum x mask = Σ_{i ∈ mask} x_i`;
* `prod_vals`: after copying `x_t` into the source slots (`Cg`) and running the producer
  (`Ag`), slot `q` holds `msum x (supG (idF IDS3 q))` (the node-id simulation, checked by the
  kernel in `R6BitNBIdB0..2`);
* `reads_eq`: the six slots read for target `T` sum to `x_T` (`R6BitNBIdRd`).
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

section XorRun

variable {M : Type*} [AddCommGroup M]

theorem xrL_nil (u : ℕ → M) : xrL [] u = u := rfl

theorem xrL_add : ∀ (l : List (ℕ × ℕ)) (u u' : ℕ → M), xrL l (u + u') = xrL l u + xrL l u'
  | [], _, _ => rfl
  | p :: l, u, u' => by
    rw [← xrL_cons, ← xrL_cons, ← xrL_cons, ← xrL_add l]
    congr 1
    funext w
    by_cases hw : w = p.1
    · subst hw; simp; abel
    · simp [Function.update_of_ne hw]

theorem xrL_zero : ∀ (l : List (ℕ × ℕ)), xrL l (0 : ℕ → M) = 0
  | [] => rfl
  | p :: l => by
    rw [← xrL_cons]
    have : Function.update (0 : ℕ → M) p.1 ((0 : ℕ → M) p.1 + (0 : ℕ → M) p.2) = 0 := by
      funext w; by_cases hw : w = p.1 <;> simp [hw]
    rw [this, xrL_zero l]

/-- Gates whose sources hold `0` change nothing. -/
theorem xrL_zero_src : ∀ (l : List (ℕ × ℕ)) (u : ℕ → M), (∀ p ∈ l, u p.2 = 0) → xrL l u = u
  | [], _, _ => rfl
  | p :: l, u, h => by
    rw [← xrL_cons, h p (by simp), add_zero, Function.update_eq_self]
    exact xrL_zero_src l u (fun q hq => h q (by simp [hq]))

/-- Wires that are never written keep their values. -/
theorem xrL_notdst : ∀ (l : List (ℕ × ℕ)) (u : ℕ → M) (w : ℕ), (∀ p ∈ l, p.1 ≠ w) → xrL l u w = u w
  | [], _, _, _ => rfl
  | p :: l, u, w, h => by
    rw [← xrL_cons, xrL_notdst l _ w (fun q hq => h q (by simp [hq])),
      Function.update_of_ne (h p (by simp)).symm]

/-- Read/write separated gate lists add their sources. -/
theorem xrL_sep : ∀ (l : List (ℕ × ℕ)) (u : ℕ → M), (∀ p ∈ l, ∀ q ∈ l, p.1 ≠ q.2) → ∀ w,
    xrL l u w = u w + (l.map fun p => if p.1 = w then u p.2 else 0).sum
  | [], u, _, w => by simp [xrL_nil]
  | p :: l, u, h, w => by
    rw [← xrL_cons, xrL_sep l _ (fun a ha b hb => h a (by simp [ha]) b (by simp [hb])) w]
    have hsrc : ∀ q ∈ l, Function.update u p.1 (u p.1 + u p.2) q.2 = u q.2 := fun q hq =>
      Function.update_of_ne (fun e => h p (by simp) q (by simp [hq]) e.symm) _ _
    rw [List.map_congr_left (fun q hq => by rw [hsrc q hq])]
    simp only [List.map_cons, List.sum_cons]
    by_cases hw : p.1 = w
    · subst hw; simp only [Function.update_self, if_true]; abel
    · rw [Function.update_of_ne (Ne.symm hw), if_neg hw, zero_add]

variable (h2 : ∀ a : M, a + a = 0)
include h2

/-- **The reversed run inverts** (characteristic two, no gate `x_d ← x_d + x_d`). -/
theorem xrL_rev : ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, p.1 ≠ p.2) → ∀ u : ℕ → M,
    xrL l.reverse (xrL l u) = u
  | [], _, _ => rfl
  | p :: l, h, u => by
    rw [← xrL_cons, List.reverse_cons, xrL_append, xrL_rev l (fun q hq => h q (by simp [hq]))]
    show Function.update (Function.update u p.1 (u p.1 + u p.2)) p.1
      (Function.update u p.1 (u p.1 + u p.2) p.1 + Function.update u p.1 (u p.1 + u p.2) p.2) = u
    rw [Function.update_of_ne (h p (by simp)).symm, Function.update_self, Function.update_idem,
      add_assoc, h2, add_zero, Function.update_eq_self]

end XorRun

/-! ## Masks -/

section Msum

variable {M : Type*} [AddCommGroup M]

theorem msum_zero (x : ℕ → M) : msum x 0 = 0 := by simp [msum]

theorem msum_xor (h2 : ∀ a : M, a + a = 0) (x : ℕ → M) (a b : ℕ) :
    msum x (a ^^^ b) = msum x a + msum x b := by
  rw [msum, msum, msum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> simp [h2]

theorem msum_two_pow (x : ℕ → M) {T : ℕ} (hT : T < 1792) : msum x (2 ^ T) = x T := by
  rw [msum, Finset.sum_eq_single T]
  · simp
  · intro i _ hi; simp [Nat.testBit_two_pow, Ne.symm hi]
  · intro h; exact absurd (Finset.mem_range.2 hT) h

end Msum

/-! ## The node-id simulation -/

section IdSim

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0) (x : ℕ → M)

theorem supG_zero : supG 0 = 0 := DagC.leaves_ok.1

theorem gateOK_of_mem_dagGL {g : ℕ × ℕ × ℕ} (hg : g ∈ dagGL) : GateOK supG g := by
  simp only [dagGL, List.mem_flatMap] at hg
  obtain ⟨c, hc, y, hy, hg⟩ := hg
  exact DagC.gates_ok c hc y hy g hg

theorem gateOK_zero : GateOK supG (0, 0, 0) := by
  simp [GateOK, supG_zero]

theorem ne_of_beq_false {a b : ℕ} (h : Nat.beq a b = false) : a ≠ b := by
  rintro rfl; rw [Nat.beq_refl] at h; cases h

theorem wS_inj {q q' : ℕ} (h : wS q = wS q') : q = q' := by
  simp only [wS, Nat.add_eq] at h; omega

theorem idF_setF (S q q' v : ℕ) (hv : v < 2 ^ 16) :
    idF (setF S q v) q' = if q = q' then v else idF S q' := setF_fieldOf S q q' v hv

theorem exStep_fst (n p : ℕ) (a : Bool × ℕ) (o : ℕ) :
    (exStep n p a o).1 = (a.1 && Nat.blt o NR && Nat.beq (idF a.2 o) 0 && !(Nat.beq o p)) := rfl

theorem foldl_exStep_flag (n p : ℕ) : ∀ (os : List ℕ) (a : Bool × ℕ),
    (os.foldl (exStep n p) a).1 = true → a.1 = true
  | [], _, h => h
  | o :: os, a, h => by
    have := foldl_exStep_flag n p os _ h
    rw [exStep_fst] at this
    simp only [Bool.and_eq_true] at this
    exact this.1.1.1

/-- Fields of decoded records fit 16 bits. -/
theorem recsDec_fields : ∀ (cnt s : ℕ), ∀ r ∈ R6Chk.Bit.Loc.recsDec cnt s, r.1 < 2 ^ 16
  | 0, _, r, hr => by simp [R6Chk.Bit.Loc.recsDec] at hr
  | cnt + 1, s, r, hr => by
    simp only [R6Chk.Bit.Loc.recsDec, List.mem_cons] at hr
    rcases hr with rfl | hr
    · exact fieldOf_lt _ _ _
    · exact recsDec_fields cnt _ r hr

theorem recStep_flag (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)) (r : Rec) :
    (recStep acc r).1.1 = true → acc.1.1 = true ∧ pivOK acc.1.2 r (acc.2.headD (0, 0, 0)) = true := by
  intro h
  have : (acc.1.1 && pivOK acc.1.2 r (acc.2.headD (0, 0, 0))) = true := foldl_exStep_flag r.1 r.2.1 r.2.2.2 _ h
  exact Bool.and_eq_true_iff.mp this

include h2 in
theorem recsFold_sound : ∀ (rs : List Rec), (∀ r ∈ rs, r.1 < 2 ^ 16) →
    ∀ (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)), (∀ g ∈ acc.2, GateOK supG g) →
      (rs.foldl recStep acc).1.1 = true → ∀ z : ℕ → M, IdInv x acc.1.2 z →
        IdInv x (rs.foldl recStep acc).1.2 (xrL (rs.flatMap recEl) z)
  | [], _, _, _, _, _, hz => hz
  | r :: rs, hrs, acc, hgl, h, z, hz => by
    simp only [List.foldl_cons, List.flatMap_cons, xrL_append] at h ⊢
    have hhead : GateOK supG (acc.2.headD (0, 0, 0)) := by
      cases hl : acc.2 with
      | nil => exact gateOK_zero
      | cons g l => exact hgl g (by simp [hl])
    -- the flag of the step is true (the fold only conjoins)
    have hflag : ∀ (l : List Rec) (a : (Bool × ℕ) × List (ℕ × ℕ × ℕ)),
        (l.foldl recStep a).1.1 = true → a.1.1 = true := by
      intro l
      induction l with
      | nil => intro a h; exact h
      | cons r' l ih => intro a h; exact (recStep_flag a r' (ih _ h)).1
    have hstep := hflag rs _ h
    apply recsFold_sound rs (fun r' hr' => hrs r' (by simp [hr'])) _ ?_ h _
      (recStep_sound h2 x r (hrs r (by simp)) acc hhead hstep z hz)
    intro g hg
    simp only [recStep, glNext] at hg
    cases hb : Nat.beq r.2.2.1 0
    · rw [hb, cond_false] at hg; exact hgl g (List.mem_of_mem_tail hg)
    · rw [hb, cond_true] at hg; exact hgl g hg

theorem blkRecs_fields (a b : ℕ) : ∀ r ∈ blkRecs a b, r.1 < 2 ^ 16 := by
  intro r hr
  simp only [blkRecs, List.mem_flatMap] at hr
  obtain ⟨c, -, hr⟩ := hr
  exact recsDec_fields _ _ r hr

include h2 in
theorem blk_sound {a b g S S' : ℕ} (h : blkChk a b g S S' = true) (z : ℕ → M) (hz : IdInv x S z) :
    IdInv x S' (xrL ((blkRecs a b).flatMap recEl) z) := by
  simp only [blkChk, Bool.and_eq_true, Nat.beq_eq] at h
  have := recsFold_sound h2 x (blkRecs a b) (blkRecs_fields a b) ((true, S), dagGL.drop g)
    (fun g' hg' => gateOK_of_mem_dagGL (List.mem_of_mem_drop hg')) h.1 z hz
  rwa [h.2] at this

theorem recs_split : recs = blkRecs 0 48 ++ (blkRecs 48 96 ++ blkRecs 96 143) := by
  rw [recs, GREC_split]
  simp [blkRecs, List.flatMap_append]

theorem initStep_fst (a : Bool × ℕ) (t : ℕ) :
    (initStep a t).1 = (a.1 && Nat.blt (srcS t) NR && Nat.beq (idF a.2 (srcS t)) 0) := rfl

include h2 in
/-- The copies set the source slots to the leaves. -/
theorem init_sound : ∀ (ts : List ℕ), (∀ t ∈ ts, t < NV) → ∀ (a : Bool × ℕ) (z : ℕ → M),
    (ts.foldl initStep a).1 = true → IdInv x a.2 z → (∀ t < NV, z (wX t) = x t) →
      IdInv x (ts.foldl initStep a).2 (xrL (ts.map fun t => (wS (srcS t), wX t)) z) ∧
        ∀ t < NV, xrL (ts.map fun t => (wS (srcS t), wX t)) z (wX t) = x t
  | [], _, _, _, _, hz, hx => ⟨hz, hx⟩
  | t :: ts, hts, a, z, h, hz, hx => by
    have hflag : ∀ (l : List ℕ) (b : Bool × ℕ), (l.foldl initStep b).1 = true → b.1 = true := by
      intro l; induction l with
      | nil => intro b h; exact h
      | cons t' l ih => intro b h; have := ih _ h; rw [initStep_fst] at this; simp_all
    have h1 := hflag ts _ h
    rw [initStep_fst] at h1
    simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at h1
    obtain ⟨⟨-, hs⟩, hid⟩ := h1
    have ht : t < NV := hts t (by simp)
    simp only [List.foldl_cons, List.map_cons]
    rw [← xrL_cons]
    have hne : ∀ t', t' < NV → wS (srcS t) ≠ wX t' := by
      intro t' ht'; simp only [wS, wX, NV, Nat.add_eq] at *; omega
    have hxt : t + 1 < 2 ^ 16 := by simp only [NV] at ht; omega
    apply init_sound ts (fun t' h' => hts t' (by simp [h'])) _ _ h
    · intro q hq
      show Function.update z (wS (srcS t)) (z (wS (srcS t)) + z (wX t)) (wS q) =
        msum x (supG (idF (setF a.2 (srcS t) (Nat.add t 1)) q))
      rw [idF_setF _ _ _ _ hxt]
      by_cases hq' : srcS t = q
      · subst hq'
        rw [if_pos rfl, Function.update_self, hz _ hs, hid, supG_zero, msum_zero, zero_add, hx t ht]
        rw [DagC.leaves_ok.2 t ht, msum_two_pow x (by simp only [NV] at ht; omega)]
      · rw [if_neg hq', Function.update_of_ne (fun e => hq' (wS_inj e).symm), hz q hq]
    · intro t' ht'
      rw [Function.update_of_ne (hne t' ht').symm, hx t' ht']

include h2 in
/-- **Producer values.** From slots holding `0` and `x` on the x-wires, the copies and the
producer leave node `idF IDS3 q` in slot `q`. -/
theorem prod_vals (z : ℕ → M) (hz0 : ∀ q < NR, z (wS q) = 0) (hx : ∀ t < NV, z (wX t) = x t) :
    IdInv x IDS3 (xrL Ag (xrL Cg z)) := by
  obtain ⟨hb0, hi⟩ := idBlk0
  have h0 : IdInv x (0 : ℕ) z := fun q hq => by
    rw [hz0 q hq, show idF 0 q = 0 by simp [idF, fieldOf, nshr], supG_zero, msum_zero]
  have hinit := (init_sound h2 x (List.range NV) (fun t ht => List.mem_range.1 ht) (true, 0) z hi h0 hx).1
  rw [Ag, recs_split, List.flatMap_append, List.flatMap_append, xrL_append, xrL_append]
  exact blk_sound h2 x idBlk2 _ (blk_sound h2 x idBlk1 _ (blk_sound h2 x hb0 _ hinit))

theorem readOK_spec {S T : ℕ} (h : readOK S T = true) :
    (∀ k ∈ tri3, retS (pts T k) < NR ∧ injS T k < NR ∧ pts T k < 23) ∧
      tri3.foldl (fun a k => Nat.xor a (Nat.xor (supG (idF S (retS (pts T k)))) (supG (idF S (injS T k))))) 0 =
        2 ^ T := by
  simp only [readOK, Bool.and_eq_true, List.all_eq_true, Nat.beq_eq, Nat.blt_eq] at h
  refine ⟨fun k hk => ⟨(h.1 k hk).1.1, (h.1 k hk).1.2, (h.1 k hk).2⟩, ?_⟩
  rw [h.2, nshl, Nat.one_shiftLeft]

include h2 in
/-- **`B A C = I`**: the reads of the producer values give back the inputs. -/
theorem reads_eq (z : ℕ → M) (hz : IdInv x IDS3 z) {T : ℕ} (hT : T < NV) : readSum z T = x T := by
  have hr := readOK_spec (List.all_eq_true.1 idReads T (List.mem_range.2 hT))
  obtain ⟨hb, hx⟩ := hr
  have hk := fun k (hk : k ∈ tri3) => hb k hk
  simp only [tri3, List.mem_cons, List.not_mem_nil, or_false] at hk
  simp only [readSum, tri3, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
  simp only [tri3, List.foldl_cons, List.foldl_nil, nxor, Nat.zero_xor] at hx
  rw [hz _ (hk 0 (Or.inl rfl)).1, hz _ (hk 1 (Or.inr (Or.inl rfl))).1, hz _ (hk 2 (Or.inr (Or.inr rfl))).1,
    hz _ (hk 0 (Or.inl rfl)).2.1, hz _ (hk 1 (Or.inr (Or.inl rfl))).2.1, hz _ (hk 2 (Or.inr (Or.inr rfl))).2.1]
  rw [← msum_two_pow x (show T < 1792 by simp only [NV] at hT; omega), ← hx]
  simp only [msum_xor h2]
  abel

end IdSim

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBScalB
/-!
# Round six, bit network: the scalar effect of one invocation

The gate lists of the two stage words (`G1`, `G2`) act on local wires (inputs `x`, targets `y`,
slots, temporaries) of any module of characteristic two. With the temporaries starting at `0`:
the inputs and slots are unchanged and the targets receive the inputs, `y_T ← y_T + x_T`.

The proof splits the start values into the input part and the rest. On the rest, both read blocks
add the same reads of the producer values, which cancel. On the inputs, the producer computes the
node values (`prod_vals`) and the reads give back `x_T` (`reads_eq`).
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-! ## Small table facts -/

theorem retS_lt {c : ℕ} (hc : c < 23) : retS c < NR := by
  have := List.all_eq_true.1 retChk_ok c (List.mem_range.2 hc)
  simp only [Bool.and_eq_true, Nat.blt_eq] at this
  exact this.1

theorem retN_lt {c : ℕ} (hc : c < 23) : retN c < 36513 := by
  have := List.all_eq_true.1 retChk_ok c (List.mem_range.2 hc)
  simp only [Bool.and_eq_true, Nat.blt_eq] at this
  exact this.2

theorem srcS_lt {t : ℕ} (ht : t < NV) : srcS t < NR := by
  have hflag : ∀ (l : List ℕ) (b : Bool × ℕ), (l.foldl initStep b).1 = true →
      b.1 = true ∧ ∀ t ∈ l, srcS t < NR := by
    intro l
    induction l with
    | nil => intro b h; exact ⟨h, fun _ h => by simp at h⟩
    | cons t' l ih =>
      intro b h
      obtain ⟨h1, h2⟩ := ih _ h
      rw [initStep_fst] at h1
      simp only [Bool.and_eq_true, Nat.blt_eq] at h1
      refine ⟨h1.1.1, fun t ht => ?_⟩
      simp only [List.mem_cons] at ht
      rcases ht with rfl | ht
      · exact h1.1.2
      · exact h2 t ht
  exact (hflag _ _ idBlk0.2).2 t (List.mem_range.2 ht)

/-! ## Well-formedness of the producer gates -/

theorem foldl_exStep_all (n p : ℕ) : ∀ (os : List ℕ) (a : Bool × ℕ),
    (os.foldl (exStep n p) a).1 = true → ∀ o ∈ os, o < NR ∧ o ≠ p
  | [], _, _, o, ho => by simp at ho
  | o' :: os, a, h, o, ho => by
    have h1 := foldl_exStep_flag n p os _ h
    rw [exStep_fst] at h1
    simp only [Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at h1
    simp only [List.mem_cons] at ho
    rcases ho with rfl | ho
    · exact ⟨h1.1.1.2, ne_of_beq_false h1.2⟩
    · exact foldl_exStep_all n p os _ h o ho

theorem recStep_wf (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)) (r : Rec) (h : (recStep acc r).1.1 = true) :
    ∀ p ∈ recEl r, SlotG p := by
  obtain ⟨-, hpiv⟩ := recStep_flag acc r h
  simp only [pivOK, Bool.and_eq_true, Nat.blt_eq] at hpiv
  obtain ⟨hp, hcase⟩ := hpiv
  have hex := foldl_exStep_all r.1 r.2.1 r.2.2.2 _ h
  intro p hpm
  simp only [recEl, List.mem_append, List.mem_map] at hpm
  rcases hpm with hpm | ⟨o, ho, rfl⟩
  · by_cases hb : r.2.2.1 = 0
    · rw [if_pos hb] at hpm; simp at hpm
    · rw [if_neg hb, List.mem_singleton] at hpm
      subst hpm
      rw [show Nat.beq r.2.2.1 0 = false by
        cases h' : Nat.beq r.2.2.1 0
        · rfl
        · exact absurd (Nat.eq_of_beq_eq_true h') hb, cond_false] at hcase
      simp only [Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hcase
      obtain ⟨⟨⟨⟨hb', hne⟩, -⟩, -⟩, -⟩ := hcase
      exact ⟨_, _, rfl, hp, hb', ne_of_beq_false hne⟩
  · obtain ⟨ho1, ho2⟩ := hex o ho
    exact ⟨_, _, rfl, ho1, hp, ho2⟩

theorem recsFold_wf : ∀ (rs : List Rec) (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)),
    (rs.foldl recStep acc).1.1 = true → ∀ r ∈ rs, ∀ p ∈ recEl r, SlotG p
  | [], _, _, r, hr => by simp at hr
  | r' :: rs, acc, h, r, hr => by
    have hflag : ∀ (l : List Rec) (a : (Bool × ℕ) × List (ℕ × ℕ × ℕ)),
        (l.foldl recStep a).1.1 = true → a.1.1 = true := by
      intro l
      induction l with
      | nil => intro a h; exact h
      | cons r'' l ih => intro a h; exact (recStep_flag a r'' (ih _ h)).1
    simp only [List.foldl_cons] at h
    simp only [List.mem_cons] at hr
    rcases hr with rfl | hr
    · exact recStep_wf acc r (hflag rs _ h)
    · exact recsFold_wf rs _ h r hr

theorem blk_wf {a b g S S' : ℕ} (h : blkChk a b g S S' = true) : ∀ r ∈ blkRecs a b, ∀ p ∈ recEl r, SlotG p := by
  simp only [blkChk, Bool.and_eq_true] at h
  exact recsFold_wf _ _ h.1

theorem Ag_wf : ∀ p ∈ Ag, SlotG p := by
  intro p hp
  rw [Ag, recs_split] at hp
  simp only [List.flatMap_append, List.mem_append, List.mem_flatMap] at hp
  rcases hp with ⟨r, hr, hp⟩ | ⟨r, hr, hp⟩ | ⟨r, hr, hp⟩
  · exact blk_wf idBlk0.1 r hr p hp
  · exact blk_wf idBlk1 r hr p hp
  · exact blk_wf idBlk2 r hr p hp

/-! ## Wire ranges -/

theorem isSlot_wS {q : ℕ} (hq : q < NR) : IsSlot (wS q) := by
  simp only [IsSlot, wS, Nat.add_eq, NR] at *; omega

theorem slotG_slot {p : ℕ × ℕ} (h : SlotG p) : IsSlot p.1 ∧ IsSlot p.2 ∧ p.1 ≠ p.2 := by
  obtain ⟨q, q', rfl, hq, hq', hne⟩ := h
  exact ⟨isSlot_wS hq, isSlot_wS hq', fun e => hne (wS_inj e)⟩

/-! ## XOR-run helpers -/

section Helpers

variable {M : Type*} [AddCommGroup M]

/-- Runs whose gates stay inside `P` only see values on `P`. -/
theorem xrL_congr (P : ℕ → Prop) : ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, P p.1 ∧ P p.2) →
    ∀ (u u' : ℕ → M), (∀ w, P w → u w = u' w) → ∀ w, P w → xrL l u w = xrL l u' w
  | [], _, _, _, h, w, hw => h w hw
  | p :: l, hl, u, u', h, w, hw => by
    rw [← xrL_cons, ← xrL_cons]
    apply xrL_congr P l (fun q hq => hl q (by simp [hq]))
    intro x hx
    obtain ⟨h1, h2⟩ := hl p (by simp)
    by_cases hxp : x = p.1
    · subst hxp; simp [h _ h1, h _ h2]
    · rw [Function.update_of_ne hxp, Function.update_of_ne hxp, h x hx]
    exact hw

theorem sum_range_ite (g : ℕ → M) : ∀ (n T : ℕ), T < n →
    ((List.range n).map fun T' => if T' = T then g T' else 0).sum = g T
  | 0, _, h => absurd h (Nat.not_lt_zero _)
  | n + 1, T, h => by
    rw [List.range_succ, List.map_append, List.sum_append]
    by_cases hT : T = n
    · subst hT
      have : ((List.range T).map fun T' => if T' = T then g T' else 0).sum = 0 := by
        apply List.sum_eq_zero
        intro a ha
        simp only [List.mem_map, List.mem_range] at ha
        obtain ⟨T', hT', rfl⟩ := ha
        rw [if_neg (by omega)]
      simp [this]
    · rw [sum_range_ite g n T (by omega)]
      simp [Ne.symm hT, hT]

theorem sum_flatMap' (f : ℕ → List M) : ∀ (l : List ℕ), (l.flatMap f).sum = (l.map fun a => (f a).sum).sum
  | [] => rfl
  | a :: l => by rw [List.flatMap_cons, List.sum_append, sum_flatMap' f l, List.map_cons, List.sum_cons]

/-- The sum at target `T` of a per-target gate list. -/
theorem sumAt_flatMap (f : ℕ → List (ℕ × ℕ)) (hf : ∀ T, ∀ p ∈ f T, p.1 = wY T) (z : ℕ → M) {T : ℕ}
    (hT : T < NV) :
    (((List.range NV).flatMap f).map fun p => if p.1 = wY T then z p.2 else 0).sum =
      ((f T).map fun p => z p.2).sum := by
  rw [List.map_flatMap, sum_flatMap']
  have : ∀ T', ((f T').map fun p => if p.1 = wY T then z p.2 else 0).sum =
      if T' = T then ((f T').map fun p => z p.2).sum else 0 := by
    intro T'
    by_cases h : T' = T
    · subst h
      rw [if_pos rfl]
      congr 1
      exact List.map_congr_left fun p hp => by rw [if_pos (hf _ p hp)]
    · rw [if_neg h]
      apply List.sum_eq_zero
      intro a ha
      simp only [List.mem_map] at ha
      obtain ⟨p, hp, rfl⟩ := ha
      rw [if_neg]
      rw [hf T' p hp]
      simp only [wY, Nat.add_eq]
      omega
  rw [List.map_congr_left (fun T' _ => this T')]
  exact sum_range_ite (fun T' => ((f T').map fun p => z p.2).sum) NV T hT

/-- The sum at a wire that is no destination. -/
theorem sumAt_none (l : List (ℕ × ℕ)) (z : ℕ → M) (w : ℕ) (h : ∀ p ∈ l, p.1 ≠ w) :
    (l.map fun p => if p.1 = w then z p.2 else 0).sum = 0 :=
  List.sum_eq_zero fun a ha => by
    simp only [List.mem_map] at ha
    obtain ⟨p, hp, rfl⟩ := ha
    rw [if_neg (h p hp)]

theorem sumAt_rev (l : List (ℕ × ℕ)) (z : ℕ → M) (w : ℕ) :
    (l.reverse.map fun p => if p.1 = w then z p.2 else 0).sum =
      (l.map fun p => if p.1 = w then z p.2 else 0).sum := by
  rw [List.map_reverse, List.sum_reverse]

/-- Separated runs: reversal does not matter. -/
theorem xrL_rev_sep (l : List (ℕ × ℕ)) (h : ∀ p ∈ l, ∀ q ∈ l, p.1 ≠ q.2) (u : ℕ → M) :
    xrL l.reverse u = xrL l u := by
  funext w
  rw [xrL_sep l u h, xrL_sep l.reverse u (fun p hp q hq => h p (List.mem_reverse.1 hp) q
    (List.mem_reverse.1 hq)), sumAt_rev]

/-- Separated runs applied twice cancel (characteristic two). -/
theorem xrL_sep_twice (h2 : ∀ a : M, a + a = 0) (l : List (ℕ × ℕ)) (h : ∀ p ∈ l, ∀ q ∈ l, p.1 ≠ q.2)
    (u : ℕ → M) : xrL l (xrL l u) = u := by
  funext w
  rw [xrL_sep l _ h, xrL_sep l u h]
  have : ∀ p ∈ l, xrL l u p.2 = u p.2 := fun p hp => by
    rw [xrL_sep l u h, sumAt_none l u p.2 (fun q hq => h q hq p hp), add_zero]
  have e : (l.map fun p => if p.1 = w then xrL l u p.2 else 0) =
      (l.map fun p => if p.1 = w then u p.2 else 0) :=
    List.map_congr_left (fun p hp => by rw [this p hp])
  rw [e, add_assoc, h2, add_zero]

end Helpers

/-! ## The gate lists -/

theorem scatEl_fst (rd : ℕ → ℕ) (T : ℕ) : ∀ p ∈ scatEl rd T, p.1 = wY T := by
  intro p hp
  simp only [scatEl, List.mem_map] at hp
  obtain ⟨k, -, rfl⟩ := hp
  rfl

theorem injEl_fst (T : ℕ) : ∀ p ∈ injEl T, p.1 = wY T := by
  intro p hp
  simp only [injEl, List.mem_map] at hp
  obtain ⟨k, -, rfl⟩ := hp
  rfl

theorem mem_Sg {p : ℕ × ℕ} (hp : p ∈ Sg) : IsTgt p.1 ∧ 3542 ≤ p.2 := by
  simp only [Sg, List.mem_flatMap, List.mem_range, scatEl, List.mem_map] at hp
  obtain ⟨T, hT, k, -, rfl⟩ := hp
  simp only [IsTgt, wY, rdS, wS, Nat.add_eq, NV] at *; omega

theorem mem_Ig {p : ℕ × ℕ} (hp : p ∈ Ig) : IsTgt p.1 ∧ 3542 ≤ p.2 := by
  simp only [Ig, injEl, List.mem_flatMap, List.mem_range, List.mem_map] at hp
  obtain ⟨T, hT, k, -, rfl⟩ := hp
  simp only [IsTgt, wY, wS, Nat.add_eq, NV] at *; omega

theorem mem_STg {p : ℕ × ℕ} (hp : p ∈ STg) : IsTgt p.1 ∧ 43619 ≤ p.2 := by
  simp only [STg, List.mem_flatMap, List.mem_range, scatEl, List.mem_map] at hp
  obtain ⟨T, hT, k, -, rfl⟩ := hp
  simp only [IsTgt, wY, wT, Nat.add_eq, NV] at *; omega

theorem mem_Tg {p : ℕ × ℕ} (hp : p ∈ Tg) : 43619 ≤ p.1 ∧ p.1 < 43642 ∧ IsSlot p.2 := by
  simp only [Tg, List.mem_map, List.mem_range] at hp
  obtain ⟨c, hc, rfl⟩ := hp
  refine ⟨?_, ?_, isSlot_wS (retS_lt hc)⟩ <;> simp only [wT, Nat.add_eq] <;> omega

theorem mem_Cg {p : ℕ × ℕ} (hp : p ∈ Cg) : IsSlot p.1 ∧ p.2 < 1771 := by
  simp only [Cg, List.mem_map, List.mem_range] at hp
  obtain ⟨t, ht, rfl⟩ := hp
  exact ⟨isSlot_wS (srcS_lt ht), by simp only [wX, NV] at *; omega⟩

theorem SgIg_tgt : ∀ p ∈ Sg ++ Ig, IsTgt p.1 ∧ 3542 ≤ p.2 := by
  intro p hp
  rcases List.mem_append.1 hp with h | h
  · exact mem_Sg h
  · exact mem_Ig h

theorem Cg_sep : ∀ p ∈ Cg, ∀ q ∈ Cg, p.1 ≠ q.2 := by
  intro p hp q hq
  have := (mem_Cg hp).1; have := (mem_Cg hq).2
  simp only [IsSlot] at *; omega

/-! ## Read blocks -/

section Reads

variable {M : Type*} [AddCommGroup M]

/-- Separated blocks writing targets only. -/
theorem reads_of_sep (R : List (ℕ × ℕ)) (hR : ∀ p ∈ R, IsTgt p.1 ∧ 3542 ≤ p.2) (z : ℕ → M) :
    ∀ w, w < 1771 ∨ IsSlot w ∨ 43619 ≤ w → xrL R z w = z w := by
  intro w hw
  apply xrL_notdst
  intro p hp e
  have := (hR p hp).1
  simp only [IsTgt, IsSlot] at *; omega

theorem sep_of_tgt (R : List (ℕ × ℕ)) (hR : ∀ p ∈ R, IsTgt p.1 ∧ 3542 ≤ p.2) :
    ∀ p ∈ R, ∀ q ∈ R, p.1 ≠ q.2 := by
  intro p hp q hq
  have := (hR p hp).1; have := (hR q hq).2
  simp only [IsTgt] at *; omega

theorem readsP_SgIg (z : ℕ → M) : ReadsP (Sg ++ Ig) z (xrL (Sg ++ Ig) z) := by
  have hR := SgIg_tgt
  refine ⟨fun w hw => reads_of_sep _ hR z w (by tauto), fun T hT => ?_⟩
  rw [xrL_sep _ z (sep_of_tgt _ hR), List.map_append, List.sum_append, Sg, Ig,
    sumAt_flatMap _ (scatEl_fst rdS) z hT, sumAt_flatMap _ injEl_fst z hT]
  simp only [readSum, scatEl, injEl, rdS, List.map_map]
  rfl

theorem readsP_IgSg (z : ℕ → M) : ReadsP (Ig.reverse ++ Sg.reverse) z (xrL (Ig.reverse ++ Sg.reverse) z) := by
  rw [← List.reverse_append, xrL_rev_sep _ (sep_of_tgt _ SgIg_tgt)]
  exact readsP_SgIg z

theorem Tg_eff (z : ℕ → M) (hz : TmpZ z) :
    (∀ w, w < 43619 → xrL Tg z w = z w) ∧ ∀ c < 23, xrL Tg z (wT c) = z (wS (retS c)) := by
  have hsep : ∀ p ∈ Tg, ∀ q ∈ Tg, p.1 ≠ q.2 := by
    intro p hp q hq
    have := (mem_Tg hp).1; have := (mem_Tg hq).2.2
    simp only [IsSlot] at *; omega
  refine ⟨fun w hw => xrL_notdst _ _ _ fun p hp e => by have := (mem_Tg hp).1; omega, fun c hc => ?_⟩
  rw [xrL_sep _ z hsep, hz c hc, zero_add, Tg, List.map_map]
  have : ∀ c' ∈ List.range 23, ((fun p : ℕ × ℕ => if p.1 = wT c then z p.2 else 0) ∘
      fun c => (wT c, wS (retS c))) c' = if c' = c then z (wS (retS c')) else 0 := by
    intro c' _
    by_cases h : c' = c
    · subst h; simp
    · simp only [Function.comp_apply]
      rw [if_neg h, if_neg]; simp only [wT, Nat.add_eq]; omega
  rw [List.map_congr_left this]
  exact sum_range_ite (fun c' => z (wS (retS c'))) 23 c hc

theorem readsP_T1 (z : ℕ → M) (hz : TmpZ z) : ReadsP (Tg ++ STg ++ Ig) z (xrL (Tg ++ STg ++ Ig) z) := by
  obtain ⟨h1, h2⟩ := Tg_eff z hz
  have hR : ∀ p ∈ STg ++ Ig, IsTgt p.1 ∧ 3542 ≤ p.2 := by
    intro p hp
    rcases List.mem_append.1 hp with h | h
    · exact ⟨(mem_STg h).1, by have := (mem_STg h).2; omega⟩
    · exact mem_Ig h
  rw [List.append_assoc, xrL_append]
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [reads_of_sep _ hR _ w (by tauto), h1 w (by simp only [IsSlot] at hw; omega)]
  · rw [xrL_sep _ _ (sep_of_tgt _ hR), List.map_append, List.sum_append, STg, Ig,
      sumAt_flatMap _ (scatEl_fst wT) _ hT, sumAt_flatMap _ injEl_fst _ hT,
      h1 _ (by simp only [wY, Nat.add_eq, NV] at *; omega)]
    have hb := (readOK_spec (List.all_eq_true.1 idReads T (List.mem_range.2 hT))).1
    simp only [readSum, scatEl, injEl, List.map_map, Function.comp_def]
    rw [List.map_congr_left (l := tri3) (fun k hk => h2 _ (hb k hk).2.2),
      List.map_congr_left (l := tri3) (fun k hk => h1 _ (by
        have := isSlot_wS (hb k hk).2.1; simp only [IsSlot] at this; omega))]

theorem readsP_T2 (z : ℕ → M) (hz : TmpZ z) :
    ReadsP (Ig.reverse ++ (Tg ++ STg.reverse)) z (xrL (Ig.reverse ++ (Tg ++ STg.reverse)) z) := by
  have hI : ∀ p ∈ Ig, IsTgt p.1 ∧ 3542 ≤ p.2 := fun p hp => mem_Ig hp
  have hS : ∀ p ∈ STg, IsTgt p.1 ∧ 3542 ≤ p.2 := fun p hp => ⟨(mem_STg hp).1, by have := (mem_STg hp).2; omega⟩
  rw [xrL_append, xrL_append, xrL_rev_sep _ (sep_of_tgt _ hI), xrL_rev_sep _ (sep_of_tgt _ hS)]
  set z1 := xrL Ig z
  have hz1 : ∀ w, w < 1771 ∨ IsSlot w ∨ 43619 ≤ w → z1 w = z w := reads_of_sep _ hI z
  have hz1T : TmpZ z1 := fun c hc => by rw [hz1 _ (Or.inr (Or.inr (by simp only [wT, Nat.add_eq]; omega))), hz c hc]
  obtain ⟨h1, h2⟩ := Tg_eff z1 hz1T
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [reads_of_sep _ hS _ w (by tauto), h1 w (by simp only [IsSlot] at hw; omega), hz1 w (by tauto)]
  · rw [xrL_sep _ _ (sep_of_tgt _ hS), STg, sumAt_flatMap _ (scatEl_fst wT) _ hT,
      h1 _ (by simp only [wY, Nat.add_eq, NV] at *; omega)]
    have hy : z1 (wY T) = z (wY T) + ((injEl T).map fun p => z p.2).sum := by
      rw [show z1 = xrL Ig z from rfl, xrL_sep _ z (sep_of_tgt _ hI), Ig, sumAt_flatMap _ injEl_fst z hT]
    rw [hy]
    have hb := (readOK_spec (List.all_eq_true.1 idReads T (List.mem_range.2 hT))).1
    simp only [readSum, scatEl, injEl, List.map_map, Function.comp_def]
    rw [List.map_congr_left (l := tri3) (fun k hk => h2 _ (hb k hk).2.2),
      List.map_congr_left (l := tri3) (fun k hk => hz1 _ (Or.inr (Or.inl (isSlot_wS (hb k hk).1))))]
    abel

end Reads

/-! ## The sandwich `A · R · A⁻¹` -/

section Sandwich

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0)

theorem Ag_notslot (z : ℕ → M) (w : ℕ) (hw : ¬ IsSlot w) : xrL Ag z w = z w :=
  xrL_notdst _ _ _ fun p hp e => hw (e ▸ (slotG_slot (Ag_wf p hp)).1)

theorem Agr_notslot (z : ℕ → M) (w : ℕ) (hw : ¬ IsSlot w) : xrL Ag.reverse z w = z w :=
  xrL_notdst _ _ _ fun p hp e => hw (e ▸ (slotG_slot (Ag_wf p (List.mem_reverse.1 hp))).1)

theorem Ag_inSlot : ∀ p ∈ Ag, IsSlot p.1 ∧ IsSlot p.2 := fun p hp =>
  ⟨(slotG_slot (Ag_wf p hp)).1, (slotG_slot (Ag_wf p hp)).2.1⟩

include h2 in
/-- **The sandwich.** If `R` keeps inputs and slots and adds the reads to the targets, then
`A R A⁻¹` keeps inputs and slots and adds the reads of the producer values. -/
theorem sandwich (R : List (ℕ × ℕ)) (z : ℕ → M) (hR : ReadsP R (xrL Ag z) (xrL R (xrL Ag z))) :
    (∀ w, w < 1771 ∨ IsSlot w → xrL (Ag ++ R ++ Ag.reverse) z w = z w) ∧
      ∀ T < NV, xrL (Ag ++ R ++ Ag.reverse) z (wY T) = z (wY T) + readSum (xrL Ag z) T := by
  rw [xrL_append, xrL_append]
  obtain ⟨hR1, hR2⟩ := hR
  have hslots : ∀ w, IsSlot w → xrL Ag.reverse (xrL R (xrL Ag z)) w = z w := by
    intro w hw
    rw [xrL_congr IsSlot Ag.reverse (fun p hp => Ag_inSlot p (List.mem_reverse.1 hp)) _ (xrL Ag z)
      (fun w' hw' => hR1 w' (Or.inr hw')) w hw]
    rw [xrL_rev h2 Ag (fun p hp => (slotG_slot (Ag_wf p hp)).2.2)]
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · by_cases hs : IsSlot w
    · exact hslots w hs
    · rw [Agr_notslot _ w hs, hR1 w hw, Ag_notslot _ w hs]
  · have hns : ¬ IsSlot (wY T) := by simp only [IsSlot, wY, Nat.add_eq, NV] at *; omega
    rw [Agr_notslot _ _ hns, hR2 T hT, Ag_notslot _ _ hns]

end Sandwich

/-! ## The two stages -/

section Stages

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0)

theorem readSum_congr (z z' : ℕ → M) {T : ℕ} (hT : T < NV) (h : ∀ w, IsSlot w → z w = z' w) :
    readSum z T = readSum z' T := by
  have hb := (readOK_spec (List.all_eq_true.1 idReads T (List.mem_range.2 hT))).1
  simp only [readSum]
  rw [List.map_congr_left (l := tri3) (fun k hk => h _ (isSlot_wS (hb k hk).1)),
    List.map_congr_left (l := tri3) (fun k hk => h _ (isSlot_wS (hb k hk).2.1))]

theorem readSum_zero (z : ℕ → M) {T : ℕ} (hT : T < NV) (h : ∀ w, IsSlot w → z w = 0) :
    readSum (xrL Ag z) T = 0 := by
  rw [readSum_congr (xrL Ag z) (0 : ℕ → M) hT (fun w hw => by
    rw [xrL_congr IsSlot Ag Ag_inSlot z 0 (fun w' hw' => h w' hw') w hw, xrL_zero])]
  simp [readSum]

theorem xPart_slot (u : ℕ → M) (w : ℕ) (hw : IsSlot w) : xPart u w = 0 := by
  simp only [xPart, IsSlot] at *; rw [if_neg (by omega)]

theorem Cg_x (z : ℕ → M) (w : ℕ) (hw : ¬ IsSlot w) : xrL Cg z w = z w :=
  xrL_notdst _ _ _ fun p hp e => hw (e ▸ (mem_Cg hp).1)

/-- With zero inputs the copies change nothing. -/
theorem Cg_zero (z : ℕ → M) (hz : ∀ w, w < 1771 → z w = 0) : xrL Cg z = z :=
  xrL_zero_src _ _ fun p hp => hz _ (mem_Cg hp).2

theorem TmpZ_of (z : ℕ → M) (hz : TmpZ z) (z' : ℕ → M) (h : ∀ w, 43619 ≤ w → z' w = z w) : TmpZ z' :=
  fun c hc => by rw [h _ (by simp only [wT, Nat.add_eq]; omega), hz c hc]

include h2 in
/-- Values of the producer from the input part (`x` on the inputs, slots `0`). -/
theorem prod_reads (u : ℕ → M) {T : ℕ} (hT : T < NV) :
    readSum (xrL Ag (xrL Cg (xPart u))) T = u (wX T) :=
  reads_eq h2 (fun t => u (wX t)) _ (prod_vals h2 (fun t => u (wX t)) (xPart u)
    (fun q hq => xPart_slot u _ (isSlot_wS hq)) (fun t ht => by
      simp only [xPart]; rw [if_pos]; simpa [wX, NV] using ht)) hT

theorem xPart_tmp (u : ℕ → M) : TmpZ (xPart u) := fun c hc => by
  simp only [xPart]; rw [if_neg]; simp only [wT, Nat.add_eq]; omega

theorem Cg_congr (z z' : ℕ → M) (h : ∀ w, w < 1771 ∨ IsSlot w → z w = z' w) :
    ∀ w, w < 1771 ∨ IsSlot w → xrL Cg z w = xrL Cg z' w :=
  xrL_congr (fun w => w < 1771 ∨ IsSlot w) Cg
    (fun p hp => ⟨Or.inr (mem_Cg hp).1, Or.inl (mem_Cg hp).2⟩) z z' h

theorem SgIg_tmp (z : ℕ → M) (w : ℕ) (hw : 43619 ≤ w) :
    xrL (Ag ++ (Sg ++ Ig) ++ Ag.reverse) z w = z w := by
  rw [xrL_append, xrL_append, Agr_notslot _ _ (by simp only [IsSlot]; omega),
    reads_of_sep _ SgIg_tgt _ w (Or.inr (Or.inr hw)), Ag_notslot _ _ (by simp only [IsSlot]; omega)]

include h2 in
/-- Stage one on any start with zero temporaries. -/
theorem stage1_key (z : ℕ → M) (hz : TmpZ z) :
    (∀ w, w < 1771 ∨ IsSlot w → xrL G1 z w = xrL Cg (xrL Cg z) w) ∧
      ∀ T < NV, xrL G1 z (wY T) =
        z (wY T) + readSum (xrL Ag z) T + readSum (xrL Ag (xrL Cg z)) T := by
  obtain ⟨a1, a2⟩ := sandwich h2 (Sg ++ Ig) z (readsP_SgIg _)
  obtain ⟨z1, hz1⟩ : ∃ z1, z1 = xrL (Ag ++ (Sg ++ Ig) ++ Ag.reverse) z := ⟨_, rfl⟩
  rw [← hz1] at a1 a2
  have hz1T : TmpZ z1 := TmpZ_of z hz z1 fun w hw => by rw [hz1]; exact SgIg_tmp z w hw
  obtain ⟨z2, hz2⟩ : ∃ z2, z2 = xrL Cg z1 := ⟨_, rfl⟩
  have hz2T : TmpZ z2 := TmpZ_of z1 hz1T z2 fun w hw => by
    rw [hz2]; exact Cg_x z1 w (by simp only [IsSlot]; omega)
  obtain ⟨b1, b2⟩ := sandwich h2 (Tg ++ STg ++ Ig) z2 (readsP_T1 _ (TmpZ_of z2 hz2T _
    fun w hw => Ag_notslot z2 w (by simp only [IsSlot]; omega)))
  have hG : xrL G1 z = xrL Cg (xrL (Ag ++ (Tg ++ STg ++ Ig) ++ Ag.reverse) z2) := by
    rw [hz2, hz1, G1, xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse ++ Cg ++
      (Ag ++ (Tg ++ STg ++ Ig) ++ Ag.reverse)), xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse ++ Cg),
      xrL_append (Ag ++ (Sg ++ Ig) ++ Ag.reverse)]
  have hz2' : ∀ w, w < 1771 ∨ IsSlot w → z2 w = xrL Cg z w := by
    intro w hw; rw [hz2]; exact Cg_congr z1 z a1 w hw
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [hG]
    exact Cg_congr _ _ (fun w' hw' => by rw [b1 w' hw', hz2' w' hw']) w hw
  · have hns : ¬ IsSlot (wY T) := by simp only [IsSlot, wY, Nat.add_eq, NV] at *; omega
    rw [hG, Cg_x _ _ hns, b2 T hT, show z2 (wY T) = z1 (wY T) by rw [hz2]; exact Cg_x z1 _ hns, a2 T hT]
    rw [readSum_congr (xrL Ag z2) (xrL Ag (xrL Cg z)) hT (fun w hw =>
      xrL_congr IsSlot Ag Ag_inSlot z2 (xrL Cg z) (fun w' hw' => hz2' w' (Or.inr hw')) w hw)]

include h2 in
/-- Stage two on any start with zero temporaries. -/
theorem stage2_key (z : ℕ → M) (hz : TmpZ z) :
    (∀ w, w < 1771 ∨ IsSlot w → xrL G2 z w = xrL Cg (xrL Cg z) w) ∧
      ∀ T < NV, xrL G2 z (wY T) =
        z (wY T) + readSum (xrL Ag (xrL Cg z)) T + readSum (xrL Ag z) T := by
  obtain ⟨z0, hz0⟩ : ∃ z0, z0 = xrL Cg z := ⟨_, rfl⟩
  have hz0T : TmpZ z0 := TmpZ_of z hz z0 fun w hw => by
    rw [hz0]; exact Cg_x z w (by simp only [IsSlot]; omega)
  obtain ⟨a1, a2⟩ := sandwich h2 (Ig.reverse ++ (Tg ++ STg.reverse)) z0 (readsP_T2 _ (TmpZ_of z0 hz0T _
    fun w hw => Ag_notslot z0 w (by simp only [IsSlot]; omega)))
  obtain ⟨z1, hz1⟩ : ∃ z1, z1 = xrL (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++ Ag.reverse) z0 :=
    ⟨_, rfl⟩
  rw [← hz1] at a1 a2
  obtain ⟨z2, hz2⟩ : ∃ z2, z2 = xrL Cg z1 := ⟨_, rfl⟩
  obtain ⟨b1, b2⟩ := sandwich h2 (Ig.reverse ++ Sg.reverse) z2 (readsP_IgSg _)
  have hCr : ∀ z : ℕ → M, xrL Cg.reverse z = xrL Cg z := xrL_rev_sep Cg Cg_sep
  have hG : xrL G2 z = xrL (Ag ++ (Ig.reverse ++ Sg.reverse) ++ Ag.reverse) z2 := by
    rw [hz2, hz1, hz0, G2, xrL_append (Cg.reverse ++ (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++
      Ag.reverse) ++ Cg.reverse), xrL_append (Cg.reverse ++ (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++
      Ag.reverse)), xrL_append Cg.reverse, hCr, hCr]
  have hz2' : ∀ w, w < 1771 ∨ IsSlot w → z2 w = xrL Cg (xrL Cg z) w := by
    intro w hw; rw [hz2, ← hz0]; exact Cg_congr z1 z0 a1 w hw
  refine ⟨fun w hw => ?_, fun T hT => ?_⟩
  · rw [hG, b1 w hw, hz2' w hw]
  · have hns : ¬ IsSlot (wY T) := by simp only [IsSlot, wY, Nat.add_eq, NV] at *; omega
    rw [hG, b2 T hT, show z2 (wY T) = z1 (wY T) by rw [hz2]; exact Cg_x z1 _ hns, a2 T hT,
      show z0 (wY T) = z (wY T) by rw [hz0]; exact Cg_x z _ hns, ← hz0]
    rw [readSum_congr (xrL Ag z2) (xrL Ag z) hT (fun w hw =>
      xrL_congr IsSlot Ag Ag_inSlot z2 z (fun w' hw' => by
        rw [hz2' w' (Or.inr hw'), xrL_sep_twice h2 Cg Cg_sep]) w hw)]

include h2 in
theorem stage_of_key (G : List (ℕ × ℕ)) (u : ℕ → M) (hu : TmpZ u)
    (key : ∀ z : ℕ → M, TmpZ z →
      (∀ w, w < 1771 ∨ IsSlot w → xrL G z w = xrL Cg (xrL Cg z) w) ∧
        ∀ T < NV, xrL G z (wY T) =
          z (wY T) + readSum (xrL Ag z) T + readSum (xrL Ag (xrL Cg z)) T) :
    (∀ t < NV, xrL G u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G u (wY T) = u (wY T) + u (wX T) := by
  obtain ⟨ur, hur⟩ : ∃ ur, ur = u - xPart u := ⟨_, rfl⟩
  have hur0 : ∀ w, w < 1771 → ur w = 0 := fun w hw => by simp [hur, xPart, hw]
  have hurS : ∀ w, ¬ w < 1771 → ur w = u w := fun w hw => by simp [hur, xPart, hw]
  have hurT : TmpZ ur := fun c hc => by rw [hurS _ (by simp only [wT, Nat.add_eq]; omega), hu c hc]
  have hsplit : u = ur + xPart u := by simp [hur]
  have hu_eq : ∀ w, u w = ur w + xPart u w := fun w => by simp [hur]
  have hlin : xrL G u = xrL G ur + xrL G (xPart u) := by
    conv_lhs => rw [hsplit]
    exact xrL_add G ur (xPart u)
  obtain ⟨r1, r2⟩ := key ur hurT
  obtain ⟨x1, x2⟩ := key (xPart u) (xPart_tmp u)
  have hc : xrL Cg ur = ur := Cg_zero ur hur0
  rw [hc, hc] at r1
  rw [hc] at r2
  have hxx : ∀ w, xrL Cg (xrL Cg (xPart u)) w = xPart u w := by
    intro w; rw [xrL_sep_twice h2 Cg Cg_sep]
  refine ⟨fun t ht => ?_, fun q hq => ?_, fun T hT => ?_⟩
  · have hw : wX t < 1771 ∨ IsSlot (wX t) := Or.inl (by simp only [wX, NV] at *; omega)
    rw [hlin, Pi.add_apply, r1 _ hw, x1 _ hw, hxx, hu_eq (wX t)]
  · have hw : wS q < 1771 ∨ IsSlot (wS q) := Or.inr (isSlot_wS hq)
    rw [hlin, Pi.add_apply, r1 _ hw, x1 _ hw, hxx, hu_eq (wS q)]
  · rw [hlin, Pi.add_apply, r2 T hT, x2 T hT, prod_reads h2 u hT,
      readSum_zero (xPart u) hT (fun w hw => xPart_slot u w hw), add_zero, add_assoc (ur (wY T)), h2,
      add_zero]
    have hy : ¬ wY T < 1771 := by simp only [wY, Nat.add_eq]; omega
    rw [show xPart u (wY T) = 0 by simp [xPart, hy], hurS _ hy, zero_add]

include h2 in
/-- **Stage one.** -/
theorem stage1_scalar (u : ℕ → M) (hu : TmpZ u) :
    (∀ t < NV, xrL G1 u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G1 u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G1 u (wY T) = u (wY T) + u (wX T) :=
  stage_of_key h2 G1 u hu (stage1_key h2)

include h2 in
/-- **Stage two.** -/
theorem stage2_scalar (u : ℕ → M) (hu : TmpZ u) :
    (∀ t < NV, xrL G2 u (wX t) = u (wX t)) ∧ (∀ q < NR, xrL G2 u (wS q) = u (wS q)) ∧
      ∀ T < NV, xrL G2 u (wY T) = u (wY T) + u (wX T) :=
  stage_of_key h2 G2 u hu fun z hz => by
    obtain ⟨k1, k2⟩ := stage2_key h2 z hz
    exact ⟨k1, fun T hT => by rw [k2 T hT, add_assoc, add_assoc, add_comm (readSum (xrL Ag (xrL Cg z)) T)]⟩

end Stages

end IntMul.Kappa.R6.Bit

