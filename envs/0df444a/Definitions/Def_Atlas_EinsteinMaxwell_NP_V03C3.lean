local notation "giK" => giKN M a Q
local notation "EK" => knE M a Q
local notation "ΘK" => knTh M a Q
local notation "FK" => faradayKN a Q

variable (hτ : KNCTan M a Q U τ)
include hτ

/-! #### Frame derivatives commute with the complex combination -/

/-! #### Step 2: complexified identities with the sources kept -/

/-! #### Step 3–4: the sources vanish on `U` -/

variable (hL : CLinEM M a Q U τ)
include hL

/-! #### The eight source-free complex identities -/

