-- title:
--   §5.2–5.3, pp. 27–30 — simplicial complexes, good complexes (Def. 41), B(C, r), C(B), squares, coset complexes
-- statement:
--   Let $V$ be a set. A family $C$ of finite subsets of $V$ is a **simplicial complex** if it is downward closed: $f \in C$ and $g \subseteq f$ imply $g \in C$. Members of $C$ are *faces*; a face $f$ has dimension $|f| - 1$, and $\dim(C) = \max_{f \in C} \dim(f)$.
--
--   1. **Pure.** $C$ is pure if all of its maximal faces have the same dimension.
--   2. **Proper coloring.** A proper coloring of a $d$-dimensional complex is a map $r : V \to [d+1]$ with $r(u) \neq r(v)$ whenever $u \neq v$ and $\{u, v\} \in C$.
--   3. **Replacement.** $C$ satisfies replacement if for every face $f \in C$ and every vertex $v \in f$ there is a vertex $u \notin f$ with $(f \setminus \{v\}) \cup \{u\} \in C$.
--   4. **Good complex (Definition 41).** A simplicial complex is *good* if it is finite, pure, has a proper coloring, and satisfies replacement.
--   5. **The class $B(C, r)$.** For a $d$-dimensional complex $C$ and a coloring $r$, $B(C,r) \subseteq V^{d+1}$ consists of the words $(v_1, \dots, v_{d+1})$ such that $\{v_1, \dots, v_{d+1}\}$ is a face of $C$ and $r(v_i) = i$ for every $i$; each face of maximum size $d+1$ thus defines one word, listing its vertices by color.
--   6. **The complex $C(B)$.** For a class $B \subseteq \mathcal Y^{d+1}$, $C(B)$ has vertices $(y, i) \in \mathcal Y \times [d+1]$, and its faces are the subsets of the sets $\{(y_i, i) : i \in [d+1]\}$ for $(y_1,\dots,y_{d+1}) \in B$.
--   7. **Squares.** A square $v_0 \to v_1 \to v_2 \to v_3 \to v_0$ in $C$ is a sequence of four distinct vertices with $\{v_0,v_1\}, \{v_1,v_2\}, \{v_2,v_3\}, \{v_3,v_0\} \in C$. It is *empty* if neither diagonal $\{v_0, v_2\}$ nor $\{v_1, v_3\}$ is in $C$.
--   8. **Coset complex.** For a group $F$ and subgroups $H_1, \dots, H_d \le F$, the coset complex $C_F(H_1,\dots,H_d)$ has as vertices the left cosets $gH_i$ (as subsets of $F$), and a finite set $\sigma$ of cosets is a face iff
--   $$\bigcap_{L \in \sigma} L \neq \emptyset .$$
--
--   These objects translate pseudo-cubes and their Natarajan dimension into the language of simplicial complexes: good complexes correspond to pseudo-cubes, and squares with matching colors on opposite corners correspond to N-shattered pairs of coordinates.
--
--   **Formalization Note** The dimension is not a function: `HasDim C d` says every face has at most $d+1$ vertices and some face has exactly $d+1$, which avoids natural-number subtraction. `IsPure C d` asks every maximal face to have $d+1$ vertices; with `HasDim C d` this is "all maximal faces have the same dimension". Colors are `Fin (d + 1)`, 0-based, and the word of $B(C,r)$ puts the color-$i$ vertex at coordinate $i$. **Replacement is stated with $u \notin f$**, while the page (p. 28) writes only $u \neq v$: read literally, $u$ could be another vertex of $f$, and then $(f\setminus\{v\})\cup\{u\} = f \setminus\{v\}$ lies in $C$ by downward closure, so the condition would be vacuous for faces with two or more vertices and Proposition 42 would fail (the complex generated by a single edge would be "good"). The proofs of Propositions 42 and 46 use a new vertex. Coset-complex vertices are sets, not pairs (index, coset), as on the page. Decidable equality is classical.
-- source:
--   Brukhim, Carmon, Dinur, Moran, Yehudayoff, A Characterization of Multiclass Learnability, arXiv:2203.01550v1, pp. 27–30, §5.2 (simplicial complexes, proper coloring, replacement, Definition 41, proof of Proposition 42, squares, empty squares) and §5.3 (coset complex)

import Mathlib
import Definitions.Def_MulticlassDS_NatGap_Dimensions

namespace MulticlassDS.NatGap

open Classical Pointwise

/-- §5.2, p. 27: a family `C` of finite subsets of `V` is a simplicial complex if it is downward
closed: `f ∈ C` and `g ⊆ f` imply `g ∈ C`. -/
def IsComplex {V : Type*} (C : Set (Finset V)) : Prop :=
  ∀ f ∈ C, ∀ g : Finset V, g ⊆ f → g ∈ C

/-- §5.2, p. 27: `C` has dimension `d`, i.e. `dim(C) = max_{f ∈ C} (|f| − 1) = d`: every face has at
most `d + 1` vertices and some face has exactly `d + 1`. (Stated without natural subtraction.) -/
def HasDim {V : Type*} (C : Set (Finset V)) (d : ℕ) : Prop :=
  (∀ f ∈ C, f.card ≤ d + 1) ∧ ∃ f ∈ C, f.card = d + 1

/-- §5.2, p. 27: purity of a `d`-dimensional complex: every maximal face (a face contained in no
strictly larger face) has dimension `d`, i.e. `d + 1` vertices. Together with `HasDim C d` this says
that all maximal faces have the same dimension. -/
def IsPure {V : Type*} (C : Set (Finset V)) (d : ℕ) : Prop :=
  ∀ f ∈ C, (∀ g ∈ C, f ⊆ g → g = f) → f.card = d + 1

/-- §5.2, pp. 27–28: a proper coloring of a `d`-dimensional complex `C` with `d + 1` colors (the
colors `[d + 1]` are `Fin (d + 1)`, 0-based): `r u ≠ r v` for all distinct `u, v` with `{u, v} ∈ C`. -/
def IsProperColoring {V : Type*} (C : Set (Finset V)) (d : ℕ) (r : V → Fin (d + 1)) : Prop :=
  ∀ u v : V, u ≠ v → ({u, v} : Finset V) ∈ C → r u ≠ r v

/-- §5.2, p. 28: the replacement property: for every face `f ∈ C` and every vertex `v ∈ f` there is a
vertex `u` with `(f \ {v}) ∪ {u} ∈ C`. The page says `u ≠ v`; here `u ∉ f` (a *new* vertex), which is
the reading the proofs of Propositions 42 and 46 use. With `u ∈ f \ {v}` allowed, the condition holds
by downward closure for every face with at least two vertices. -/
def Replacement {V : Type*} (C : Set (Finset V)) : Prop :=
  ∀ f ∈ C, ∀ v ∈ f, ∃ u, u ∉ f ∧ insert u (f.erase v) ∈ C

/-- Definition 41, p. 28: a `d`-dimensional simplicial complex `C` is good if it is finite, pure, has
a proper coloring (with `d + 1` colors), and satisfies replacement. -/
def IsGood {V : Type*} (C : Set (Finset V)) (d : ℕ) : Prop :=
  IsComplex C ∧ C.Finite ∧ HasDim C d ∧ IsPure C d ∧
    (∃ r : V → Fin (d + 1), IsProperColoring C d r) ∧ Replacement C

/-- Proof of Proposition 42, p. 28: the class `B(C, r) ⊆ V^{d+1}` defined by a `d`-dimensional
complex `C` and a coloring `r`: a face `f` with `d + 1` vertices defines the word `(v₀, …, v_d)` in
which `vᵢ` is the vertex of `f` of color `i`. A word `w` is in `B(C, r)` iff its set of letters is a
face of `C` and `w i` has color `i` for every `i`; the coloring condition forces `w` to be injective,
so its set of letters has exactly `d + 1` elements. -/
noncomputable def pseudoCubeOf {V : Type*} (C : Set (Finset V)) (d : ℕ) (r : V → Fin (d + 1)) :
    Set (Fin (d + 1) → V) :=
  {w | Finset.univ.image w ∈ C ∧ ∀ i, r (w i) = i}

/-- Proof of Proposition 42, p. 28 (converse): the complex `C(B)` of a class `B ⊆ Y^{d+1}`: its
vertices are pairs `(y, i)`, and its faces are the subsets of the sets `{(w i, i) : i}` for `w ∈ B`
(the downward closure of these maximal faces). -/
noncomputable def complexOf {Y : Type*} {d : ℕ} (B : Set (Fin (d + 1) → Y)) :
    Set (Finset (Y × Fin (d + 1))) :=
  {σ | ∃ w ∈ B, σ ⊆ Finset.univ.image (fun i => (w i, i))}

/-- p. 28: a square `v₀ → v₁ → v₂ → v₃ → v₀` in `C`: four distinct vertices forming a cycle of length
four in the 1-skeleton of `C`. -/
def IsSquare {V : Type*} (C : Set (Finset V)) (v₀ v₁ v₂ v₃ : V) : Prop :=
  [v₀, v₁, v₂, v₃].Nodup ∧ ({v₀, v₁} : Finset V) ∈ C ∧ ({v₁, v₂} : Finset V) ∈ C ∧
    ({v₂, v₃} : Finset V) ∈ C ∧ ({v₃, v₀} : Finset V) ∈ C

/-- p. 29: an empty square: a square whose diagonals `{v₀, v₂}` and `{v₁, v₃}` are not edges. -/
def IsEmptySquare {V : Type*} (C : Set (Finset V)) (v₀ v₁ v₂ v₃ : V) : Prop :=
  IsSquare C v₀ v₁ v₂ v₃ ∧ ({v₀, v₂} : Finset V) ∉ C ∧ ({v₁, v₃} : Finset V) ∉ C

/-- p. 29: `C` contains no empty square. -/
def NoEmptySquares {V : Type*} (C : Set (Finset V)) : Prop :=
  ∀ v₀ v₁ v₂ v₃ : V, ¬ IsEmptySquare C v₀ v₁ v₂ v₃

/-- §5.3, p. 30: `L ⊆ F` is a (left) coset `g H_i = {g h : h ∈ H_i}` of one of the subgroups
`H_0, …, H_{d-1}`. -/
def IsCosetVertex {F : Type*} [Group F] {d : ℕ} (Hs : Fin d → Subgroup F) (L : Set F) : Prop :=
  ∃ (i : Fin d) (g : F), L = g • (Hs i : Set F)

/-- §5.3, p. 30: the coset complex `C_F(H_1, …, H_d)`: its vertices are the cosets of the subgroups
(as subsets of `F`), and a finite set `σ` of cosets is a face iff `⋂_{L ∈ σ} L ≠ ∅`. -/
def cosetComplex {F : Type*} [Group F] {d : ℕ} (Hs : Fin d → Subgroup F) : Set (Finset (Set F)) :=
  {σ | (∀ L ∈ σ, IsCosetVertex Hs L) ∧ (⋂ L ∈ σ, L).Nonempty}

end MulticlassDS.NatGap


