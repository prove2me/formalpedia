theorem OAI.CubicEisenstein.kernelSourceProjection_residue_fourier (h:Eis) :
    kernelCuspFourier h (kernelSourceProjection cubicEisensteinResidue)=
      (4:ℂ)⁻¹*(kernelCuspFourier h cubicEisensteinResidue+
        sourceRayPhaseSum h*translatedCuspFourier h oppositeSource cubicEisensteinResidue) := by sorry
