        (Scheme.nilpPoints.mapHom f f arbar harbarf).app B ((Scheme.nilpPoints.mapHom fM f p hp).app B (Θf B hB (x, (1 : G)))) = (Scheme.nilpPoints.mapHom fM f p hp).app B (Θf B hB (x', (1 : G)))) := by sorry
