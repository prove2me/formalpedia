  simp only [Light.Filter2.filterNeed] at hw hc hd
  have ha := aTOP_eq x.n fr
  refine ⟨hpre, hs, by omega, le_trans (by push_cast; omega) hw, fun p hp => ?_, by omega⟩
  have hmem : p ∈ Finset.range (Light.Filter2.PmaxOf x.n + 1) := Finset.mem_range.2 (by omega)
  have h1 : (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).word ≤ Light.Filter2.supW needo x.n x.U :=
