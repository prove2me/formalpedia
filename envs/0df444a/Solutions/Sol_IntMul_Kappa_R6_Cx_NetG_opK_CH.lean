-- Source module: R6Pk.R6CxNetG
/-!
# The round-six complex network in the item-language gate class (`GClassH`)

`R6CxNetFinal.net` uses `mergedChunk` (an opaque `Classical.choose` of `merge_chunk`) for its frame
changes; its steps cannot be inspected. `netG` is the same network with every merged chunk replaced by
the explicit `chunkH` (row additions, one child, row additions) chosen from `merge_identity`: same
denotation, same child widths. Its only gates are the chunk gates `GOp.mat`:

* `z_d += (k/2) z_s` with `d ≠ s` (all local ops, `C1`, `C2`): `|k|` KFG atoms `(d, s, sign k, h = 1)`;
* `z_X += -2 z_X` (`C3`): the `±1` diagonal `-1` at `X`.

**`cxNetR6G : ∃ T (J : Prop8IfaceH 207387136 T 576 Jain.cxR6) A, GClassH J A`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw Complex Butterfly P8Lift

/-! ## Local ops act on two distinct wires -/

section LocalDist

variable (d : Dat)

lemma LD_append {a b : List (ℕ × ℕ × ℤ)} (ha : LD a) (hb : LD b) : LD (a ++ b) := fun o ho =>
  (List.mem_append.1 ho).elim (ha o) (hb o)

lemma LD_neg {l : List (ℕ × ℕ × ℤ)} (h : LD l) : LD (negOps l) := fun o ho => by
  obtain ⟨o', ho', rfl⟩ := negOps_mem ho
  exact h o' ho'

lemma LD_Lops (hD : DataOK d) : LD (Lops d.gates) := fun o ho => by
  rw [Lops_eq] at ho
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho
  have := (hD.gok p hp).2.2
  show aw p.1 ≠ aw p.2
  rw [aw_eq, aw_eq]; omega

lemma LD_gops (hD : DataOK d) {g : Gate} (hg : g ∈ d.gates) : LD (gops g) := fun o ho => by
  rw [gops_eq] at ho
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 ho
  have := (hD.gok p (List.mem_flatMap.2 ⟨g, hg, hp⟩)).2.2
  show aw p.1 ≠ aw p.2
  rw [aw_eq, aw_eq]; omega

lemma LD_centre (sg : ℤ) (srcw : ℕ → ℕ) (hw : ∀ j, 2 * NV ≤ srcw j) : LD (centreOps d sg srcw) :=
  fun o ho => by
    obtain ⟨S, hS, c, _, rfl⟩ := centreOps_mem d ho
    show yw S ≠ srcw c.1
    have := hw c.1
    rw [yw_eq]; omega

lemma LD_inj (hD : DataOK d) (sg : ℤ) : LD (injOps d sg) := fun o ho => by
  obtain ⟨S, hS, p, _, rfl⟩ := injOps_mem d hD.len ho
  show yw S ≠ aw p.1
  rw [yw_eq, aw_eq]; omega

lemma aw_ge (x : ℕ) : 2 * NV ≤ aw x := by rw [aw_eq]; omega
lemma mw_ge (x : ℕ) : 2 * NV ≤ mw x := by rw [mw_eq]; omega

lemma LDs_append {a b : List Spec} (ha : LDs a) (hb : LDs b) : LDs (a ++ b) := fun s hs =>
  (List.mem_append.1 hs).elim (ha s) (hb s)

lemma LDs_single {s : Spec} (h : LD s.ops) : LDs [s] := fun s' hs => by
  rw [List.mem_singleton] at hs; subst hs; exact h

lemma LD_flatMap {ss : List Spec} (h : LDs ss) : LD (ss.flatMap Spec.ops) := fun o ho => by
  obtain ⟨s, hs, ho⟩ := List.mem_flatMap.1 ho
  exact h s hs o ho

lemma LDs_xSpecs (lab : ℕ → ℕ) (k : ℤ) : LDs ((List.range NV).map (xSpec d lab k)) := by
  intro s hs
  obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hs
  intro o ho
  simp only [xSpec, List.mem_singleton] at ho
  subst ho
  show aw (d.src t) ≠ xw t
  have := List.mem_range.1 ht
  have := aw_ge (d.src t)
  rw [xw]; omega

lemma LDs_copy (hD : DataOK d) : LDs (copySpecs d) := by
  intro s hs
  obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hs
  intro o ho
  simp only [List.mem_singleton] at ho
  subst ho
  show mw j ≠ aw (d.rs j)
  have h1 := hD.rd.1 j (List.mem_range.1 hj)
  have h2 := List.mem_range.1 hj
  rw [mw_eq, aw_eq]; omega

lemma LDs_pieces (hD : DataOK d) (sg : ℤ) : LDs (pieceSpecs d sg) := by
  intro s hs
  unfold pieceSpecs at hs
  rw [zip_range_eq _ _ hD.len []] at hs
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hs
  obtain ⟨S, hS, rfl⟩ := List.mem_map.1 hx
  intro o ho
  obtain ⟨p, _, rfl⟩ := List.mem_map.1 ho
  show yw S ≠ aw p.1
  have := List.mem_range.1 hS
  rw [yw_eq, aw_eq]; omega

lemma LDs_gates1 (hD : DataOK d) : LDs (gates1 d.gD) := by
  intro s hs
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hs
  exact LD_gops d hD hg

lemma LDs_gates2 (hD : DataOK d) : LDs (gates2 d.gD) := by
  intro s hs
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hs
  exact LD_neg (LD_gops d hD (List.mem_reverse.1 hg))

theorem LD_specs1 (hD : DataOK d) : LD ((specs1 d).flatMap Spec.ops) := by
  apply LD_flatMap
  unfold specs1 pre1 post1 post1a post1b
  refine LDs_append (LDs_append (LDs_append (LDs_single ?_) (LDs_xSpecs d _ _)) (LDs_gates1 d hD))
    (LDs_append (LDs_append (LDs_append (LDs_copy d hD) (LDs_single ?_)) (LDs_pieces d hD _))
      (fun s hs => ?_))
  · exact LD_append (LD_append (LD_append (LD_Lops d hD) (LD_centre d _ _ fun j => aw_ge _))
      (LD_inj d hD _)) (LD_neg (LD_Lops d hD))
  · exact LD_centre d _ _ fun j => mw_ge _
  · rcases List.mem_cons.1 hs with h | h
    · subst h; exact LD_neg (LD_Lops d hD)
    · rw [List.mem_singleton] at h
      subst h
      intro o ho
      obtain ⟨t, ht, rfl⟩ := List.mem_map.1 ho
      show aw (d.src t) ≠ xw t
      have := List.mem_range.1 ht
      have := aw_ge (d.src t)
      rw [xw]; omega

theorem LD_specs2 (hD : DataOK d) : LD ((specs2 d).flatMap Spec.ops) := by
  apply LD_flatMap
  unfold specs2 pre2 pre2a pre2b post2
  refine LDs_append (LDs_append (LDs_append (LDs_append (LDs_xSpecs d _ _) (LDs_single (LD_Lops d hD)))
    (LDs_append (LDs_append (LDs_pieces d hD _) (LDs_copy d hD))
      (LDs_single (LD_centre d _ _ fun j => mw_ge _)))) (LDs_gates2 d hD))
    (LDs_append (LDs_xSpecs d _ _) (LDs_single ?_))
  exact LD_append (LD_append (LD_append (LD_Lops d hD) (LD_inj d hD _))
    (LD_centre d _ _ fun j => aw_ge _)) (LD_neg (LD_Lops d hD))

end LocalDist

