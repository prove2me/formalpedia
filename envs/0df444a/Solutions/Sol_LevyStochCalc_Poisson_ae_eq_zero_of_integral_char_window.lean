/-!
# The natural filtration is generated by the counts on finite-intensity windows

The reference intensity is a product with a σ-finite mark measure, so a set of times at most `T`
splits into the null part at nonpositive times and a countable increasing union of sets inside
windows `(0, T] × A` with `ν A` finite. The counts on those windows are almost surely finite, so
their real parts generate the natural filtration modulo null sets, and the characters of those
real counts separate.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology

namespace LevyStochCalc.Poisson

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]

section Window

theorem AuxNLA_natural_le (N : PoissonRandomMeasure P ν) (T : ℝ) :
    naturalFiltration N T ≤ Probability.aug (windowSigma N T) ‹MeasurableSpace Ω› P := by
  rw [naturalFiltration_seq_eq]
  refine iSup₂_le fun B hB => ?_
  obtain ⟨hBT, hBm⟩ := hB
  let W : ℕ → Set (ℝ × E) := fun n => (windowTrace ν T B hBm n : Set (ℝ × E))
  let Y : Ω → ℝ≥0∞ := fun ω => ⨆ n, ENNReal.ofReal ((N.N ω (W n)).toReal)
  have hY : Measurable[windowSigma N T] Y :=
    Measurable.iSup fun n => ENNReal.measurable_ofReal.comp
      (measurable_windowSigma_count N (windowTrace ν T B hBm n))
  refine comap_le_aug_of_ae_eq (N.measurable_eval hBm) hY ?_
  have h0 := ae_count_Iic_zero_eq_zero N hBm
  have hfin : ∀ᵐ ω ∂P, ∀ n, N.N ω (W n) ≠ ⊤ := ae_all_iff.mpr fun n =>
    ae_count_ne_top N (windowTrace ν T B hBm n).measurableSet
      (windowTrace ν T B hBm n).intensity_ne_top
  filter_upwards [h0, hfin] with ω hω0 hωf
  have hsplit : N.N ω B = N.N ω (B ∩ Set.Ioi (0 : ℝ) ×ˢ Set.univ) +
      N.N ω (B ∩ Set.Iic (0 : ℝ) ×ˢ Set.univ) := by
    have hc : (Set.Iic (0 : ℝ) ×ˢ (Set.univ : Set E)) = (Set.Ioi (0 : ℝ) ×ˢ Set.univ)ᶜ := by
      ext p; simp [not_lt]
    rw [hc, ← Set.diff_eq]
    exact (measure_inter_add_diff B (measurableSet_Ioi.prod MeasurableSet.univ)).symm
  rw [hsplit, hω0, add_zero, ← iUnion_windowTrace (ν := ν) hBm hBT]
  rw [(monotone_windowTrace (ν := ν) T B hBm).measure_iUnion]
  simp only [Y, W]
  congr 1
  ext n
  rw [ENNReal.ofReal_toReal (hωf n)]



theorem _root_.solution (N : PoissonRandomMeasure P ν) (T : ℝ)
    {Z : Ω → ℂ} (hZ : Integrable Z P)
    (hZm : AEStronglyMeasurable[Probability.aug (naturalFiltration N T) ‹MeasurableSpace Ω› P]
      Z P)
    (h : ∀ (F : Finset (WindowSet E ν T)) (w : F → ℝ),
      ∫ ω, Complex.exp
          ((∑ D : F, (N.N ω ((D : WindowSet E ν T) : Set (ℝ × E))).toReal * w D : ℝ)
            * Complex.I) * Z ω ∂P = 0) :
    Z =ᵐ[P] 0 := by
  have hle := Probability.aug_le_of_le_aug (AuxNLA_natural_le N T)
  have hZm' := hZm.mono hle
  have hZ1 : StronglyMeasurable[Probability.aug (windowSigma N T) ‹MeasurableSpace Ω› P]
      (hZm'.mk Z) := hZm'.stronglyMeasurable_mk
  have hZ2 := Probability.aestronglyMeasurable_of_stronglyMeasurable_aug hZ1
  have he : Z =ᵐ[P] hZ2.mk (hZm'.mk Z) := hZm'.ae_eq_mk.trans hZ2.ae_eq_mk
  have key := ae_eq_zero_of_integral_char_windowSigma N T (hZ.congr he) hZ2.stronglyMeasurable_mk
    (fun F w => by
      rw [← h F w]
      refine integral_congr_ae ?_
      filter_upwards [he] with ω hω
      rw [hω])
  exact he.trans key

end Window

end LevyStochCalc.Poisson
