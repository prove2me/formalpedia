-- title:
--   The model étale local algebra R[X]/(f) over a complete local ring
-- statement:
--   Let $R$ be a commutative local ring that is complete and separated for the adic topology of its maximal ideal $\mathfrak m_R$, with residue field $\kappa =$ `ResidueField R`, and let $f \in R[X]$ be monic. Assume the reduction $\bar f = f$ mapped along the residue map $R \to \kappa$ is irreducible, and that the $\kappa$-algebra `AdjoinRoot` $\bar f = \kappa[X]/(\bar f)$ is separable over $\kappa$. The conclusion asserts the existence of a local-ring structure on $W :=$ `AdjoinRoot f` $= R[X]/(f)$ and of a witness that $\mathrm{algebraMap}\,R\,W$ is a local homomorphism, together with the following: $W$ is a finite and free $R$-module; $W$ is étale over $R$; $W$ is complete and separated for the adic topology of its own maximal ideal; the ideal generated by the image of $\mathfrak m_R$ in $W$ equals the maximal ideal of $W$; and the residue field of $W$ is nonempty-ly isomorphic, as a $\kappa$-algebra, to $\kappa[X]/(\bar f)$. No Noetherian or domain hypothesis is imposed on $R$.
--
--   This is the standard construction of the unramified (finite étale) local extension of a complete local ring attached to an irreducible separable residual polynomial, packaged so that the algebra is literally $R[X]/(f)$ and hence retains its universal property. It is used in the construction of étale extensions of complete discrete valuation rings with prescribed residue field, in the recognition of étaleness from equality of ranks with the residue-field degree, and in producing ring homomorphisms out of adic completions.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AdjoinRoot_exists_isLocalRing_etale_residueField_algEquiv_of_isAdicComplete.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open Polynomial IsLocalRing in

theorem AdjoinRoot.exists_isLocalRing_etale_residueField_algEquiv_of_isAdicComplete
    (R : Type u) [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
    (f : R[X]) (hfm : f.Monic) [Fact (Irreducible (f.map (residue R)))]
    [Algebra.IsSeparable (ResidueField R) (AdjoinRoot (f.map (residue R)))] :
    ∃ (_ : IsLocalRing (AdjoinRoot f)) (_ : IsLocalHom (algebraMap R (AdjoinRoot f))),
      Module.Finite R (AdjoinRoot f) ∧ Module.Free R (AdjoinRoot f) ∧ Algebra.Etale R (AdjoinRoot f) ∧
      IsAdicComplete (maximalIdeal (AdjoinRoot f)) (AdjoinRoot f) ∧
      Ideal.map (algebraMap R (AdjoinRoot f)) (maximalIdeal R) = maximalIdeal (AdjoinRoot f) ∧
      Nonempty (ResidueField (AdjoinRoot f) ≃ₐ[ResidueField R] AdjoinRoot (f.map (residue R))) := by sorry
