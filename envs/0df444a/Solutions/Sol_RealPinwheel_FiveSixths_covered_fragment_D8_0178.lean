    ∃ j : Fin 3725, codeBox (codeFunctionD8 j.val) d := by
  have hc : fragmentObligations 3725 codeFunctionD8 fragmentContextD8_0178 fragmentTreeD8_0178 := by
    unfold fragmentTreeD8_0178
    apply fragmentComputed_sound
    decide +kernel
  exact fragment_sound 3725 codeFunctionD8 fragmentContextD8_0178 fragmentTreeD8_0178 hc d hΓ
