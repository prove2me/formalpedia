variable {s t lam : ℕ}

theorem J6Seg.Side.win_le (hs : 0 < s) (hst : s ≤ t) (hl : 1 ≤ lam) (w x X : ℕ) :
    s * ((LJ s t lam w).toFinset.filter (fun j => x ≤ j ∧ j ≤ x + X)).card ≤
      2 * w * (s * ((X + 2 * w) / lam + 3) + (t - s) * (X + 2 * w + 1) + s) := by sorry
