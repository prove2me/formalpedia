section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel
theorem solution {Q b : ℕ} (hQ0 : 0 < Q) (hQ : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ b)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (t : NLogN.IState NLogN.HS) (LA LC LM LAM LN : List NLogN.Item)
    (hA : t.G NLogN.KIL.sSA = NLogN.ints (ac.reverse.map fun p => (p.1 : ℤ)) ++ LA)
    (hC : t.G NLogN.KIL.sSC = NLogN.ints (ac.reverse.map fun p => (p.2 : ℤ)) ++ LC)
    (hM : t.G NLogN.KIL.sSM = NLogN.ints (NLogN.KIL.stgM ac.reverse []) ++ LM)
    (hAM : t.G NLogN.KIL.sSAM = NLogN.ints (NLogN.KIL.stgAM ac.reverse []) ++ LAM)
    (hN : t.G NLogN.KIL.sNQ = .int (-(Q : ℤ)) :: LN) :
    NLogN.KFD.FSp (NLogN.KIL.genPU ac.length) t
      (((((t.upd 14 (NLogN.ints (NLogN.KIL.tbl Q ac) ++ t.G 14)).upd NLogN.KIL.sSA LA).upd NLogN.KIL.sSC LC).upd NLogN.KIL.sSM LM).upd NLogN.KIL.sSAM LAM)
      ((1 + 1) * 2000 * (b + 2) + NLogN.KFD.stCostF b ac.reverse []) := by
  have S1 := NLogN.KIL.Sp.pushLit t (i := 14) (by decide) 0 (Bb := b) (by simp [NLogN.zsz_zero])
  set t1 := t.upd 14 (.int 0 :: t.G 14)
  have H := NLogN.KFD.stagesU_fsp hQ0 hQ (t.G 14) LA LC LM LAM LN ac.reverse [] t1
    (fun p hp => hac p (List.mem_reverse.1 hp)) (by simp)
    (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, NLogN.KIL.tbl, NLogN.ints])
    (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, hA]) (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, hC])
    (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, hM]) (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, hAM])
    (by simp (config := {decide := true}) [t1, NLogN.IState.upd_G, hN])
  rw [List.length_reverse, List.reverse_reverse, List.append_nil] at H
  refine ((NLogN.KFD.FSp.of_norep rfl S1).seq H).congr ?_
  simp only [t1, NLogN.IState.upd_upd_same]
end
