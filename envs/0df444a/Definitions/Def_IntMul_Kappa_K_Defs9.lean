/-!
# Glue 2b: Lemma 16 error bound, with the approximation hypotheses discharged by Proposition 14

Records live in a commutative `ℂ`-algebra `R` with a coefficient model `C` (`R_r` is one,
`rrModel`); the size of a record is the sup of its coefficient moduli.

* `CArr C N`: arrays of `N` records with the sup-of-coefficients metric (pulled back by `C.co`).
* A *round* (§6.1) on any selected-bit structure `Sb` with twiddle exponents `Ex`: the exact round
  `exactR = J_E ∘ H0^{⊗}` (`= roundL`, `roundL_eq`) and the computed round
  `compR = J_E ∘ Q_p ∘ H0^{⊗}`.
* **`layerQ_eq_prop14`**: the computed (truncated) layer *is* the output of Proposition 14's
  procedure with the recursive complex-network `C`-layer (`prop14ProcG … cRecι`), read
  coefficientwise; **`paper_layerQ_eq_prop14`**: on the chunk rounds of the paper layout it is
  `prop14Proc` on `layerSel (2^A) K D (2^B) ρ` with `cRecC D` (via `paper_round_layerH`).
* The three hypotheses of `Synth.error_chain` hold for the rounds (`round_contract`,
  `round_disk`, `comp_disk`, `comp_err`; `η = √2·2^{-p}`), so
* **`lemma16_error`**: the computed procedure (rounds `h = ℓ-1, …, 0`) differs from the exact one
  by less than `ℓ √2 2^{-p}` in every coefficient of every record, and stays in the unit disk;
* **`lemma16_error_Fm`**: at every valid address `v`, the computed record is within
  `ℓ √2 2^{-p}` of `(F^- z)(rev (coord v))` (combining with `synth_forward_list`), and
  **`lemma16_error_paper`** the same on the paper's layout `L`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace GlueError

open Finset Butterfly AModel Synth GlueLayout GlueP14

variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ}

/-! ## 1. Arrays of records with the coefficient metric -/

/-- Arrays of `N` records. -/
def CArr (_C : CoeffModel y r) (N : ℕ) : Type _ := Fin N → R

variable (C : CoeffModel y r)

instance instACGCArr (N : ℕ) : AddCommGroup (CArr C N) := Pi.addCommGroup

/-- The coefficient map of an array. -/
def coHom (N : ℕ) : CArr C N →+ (Fin N → Fin r → ℂ) where
  toFun u j := C.co ((u : Fin N → R) j)
  map_zero' := by funext j; exact map_zero C.co
  map_add' u v := by funext j; exact map_add C.co _ _

/-- The sup-of-coefficients seminorm on arrays. -/
noncomputable instance instSNCArr (N : ℕ) : SeminormedAddCommGroup (CArr C N) :=
  SeminormedAddCommGroup.induced _ _ (coHom C N)

variable {C}

/-- Read a list as an array. -/
def toA (C : CoeffModel y r) (N : ℕ) (xs : List R) : CArr C N := fun j => xs.getD j 0

/-- Write an array as a list. -/
def ofA {N : ℕ} (u : CArr C N) : List R := List.ofFn (n := N) fun j => (u : Fin N → R) j

/-- The unit disk of arrays. -/
def disk (C : CoeffModel y r) (N : ℕ) : Set (CArr C N) :=
  {u | ∀ j, ‖C.co ((u : Fin N → R) j)‖ ≤ 1}

/-! ## 2. Rounds -/

variable {D : ℕ} {sh : Shape} {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The recordwise monomial `J_E`, `E = Ex j` at index `j`. -/
noncomputable def twL (y : Rˣ) (sh : Shape) (Ex : ℕ → ℤ) (zs : List R) : List R :=
  (List.range (vol sh)).map fun j => yp y (Ex j) * zs.getD j 0

/-- The exact round `J_E ∘ H0^{⊗}`. -/
noncomputable def exactR (y : Rˣ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List R) : List R :=
  twL y sh Ex (selOp Sb (Butterfly.tens H0) xs)

/-- The computed layer: `H0^{⊗}` then `Q_p` on every record. -/
noncomputable def layerQ (C : CoeffModel y r) (p : ℕ) (Sb : SelBits sh ι) (xs : List R) :
    List R :=
  (selOp Sb (Butterfly.tens H0) xs).map (QpR C p)

/-- The computed round `J_E ∘ Q_p ∘ H0^{⊗}`. -/
noncomputable def compR (C : CoeffModel y r) (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ)
    (xs : List R) : List R :=
  twL y sh Ex (layerQ C p Sb xs)

/-- The twiddle exponents of round `h` of `roundL`. -/
noncomputable def roundEx {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ h : ℕ)
    (P : Finset (Fin D)) : ℕ → ℤ :=
  fun j => ((roundAxes P).map fun i => twE ℓ h (L.coord (decode sh j) i)).sum

/-! ### The computed layer is Proposition 14's procedure -/

/-! ### Contraction, disk, truncation error -/

section Maps

variable (C) (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ)

/-- The exact round on arrays. -/
noncomputable def Emap (u : CArr C (vol sh)) : CArr C (vol sh) := toA C (vol sh) (exactR y Sb Ex (ofA u))

/-- The computed round on arrays. -/
noncomputable def Amap (u : CArr C (vol sh)) : CArr C (vol sh) :=
  toA C (vol sh) (compR C p Sb Ex (ofA u))

variable {C}

end Maps

/-! ## 3. Procedures and Lemma 16 -/

/-- Rounds `n-1, …, 0` of a family of list maps. -/
def runDown {α : Type*} (F : ℕ → α → α) : ℕ → α → α
  | 0, x => x
  | n + 1, x => runDown F n (F n x)

/-- **The computed procedure of Lemma 16**: rounds `h = n-1, …, 0`, each `J_E ∘ Q_p ∘ H0^{⊗}`
(the layer computed by Proposition 14's procedure, `layerQ_eq_prop14`). -/
noncomputable def procQ (C : CoeffModel y r) (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a)
    (ℓ : ℕ) (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ℕ → List R → List R :=
  runDown fun h => compR C p (Sb h) (roundEx L ℓ h (P h))

/-! ## 4. The paper's layout -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

end Paper

end GlueError

