-- url     : https://prove2.me/theorems/b049d5b7-18fc-450d-8b2b-aa87eb392c26
-- title:
--   RH height 14–100 — Mellin moments and proposed rounded values
-- statement:
--   The actual scaled even Mellin moments of the Riemann-zeta theta kernel, and the 256 proposed rounded rational values in the existing height-14–100 certificate. For j = 0 through 255, the actual moment is the integral over t > 1 of t^(-3/4) (64 log t)^(2j)/(2j)! times (the even Hurwitz theta kernel at parameter zero minus one). The proposed value is the stored integer numerator divided by 10^64. This module defines both functions; their error bound of 10^(-46) is a separate theorem. The proposed integer list is unchanged from sometik179’s original public certificate, with its theta/Mellin attribution to Gabewhigham retained.
-- source:
--   sometik179, Prove2Me submission c9908072-d99a-4431-aad8-a72c6352619a (2026-10-03), https://prove2.me/submissions/c9908072-d99a-4431-aad8-a72c6352619a. Theta/Mellin foundations attributed to Gabewhigham. Ordinary definitions extracted from the locally kernel-verified pilot.

/- Moment functions and proposed rounded values from sometik179's
height-14–100 certificate, c9908072-d99a-4431-aad8-a72c6352619a.
Original theta/Mellin attribution: Gabewhigham. No enclosure is asserted here.
-/
import Mathlib.NumberTheory.LSeries.HurwitzZetaEven
import Mathlib.MeasureTheory.Integral.Bochner.Set
import Mathlib.Data.List.GetD
import Mathlib.Algebra.Order.Ring.Abs
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option exponentiation.threshold 20000
open Real MeasureTheory Set
namespace CertifiedZetaQuadrature
noncomputable def momentWeight (a k : ℕ) (t : ℝ) : ℝ :=
  t^(-3/4:ℝ)*(a*log t)^k/(k.factorial:ℝ)

end CertifiedZetaQuadrature
namespace CertifiedGlobalMoments
open CertifiedZetaQuadrature
noncomputable def moment (j : ℕ) : ℝ :=
  ∫ t in Ioi (1:ℝ), momentWeight 64 (2*j) t*(HurwitzZeta.evenKernel 0 t-1)

end CertifiedGlobalMoments
