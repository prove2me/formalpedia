-- module Solutions.OAIW2_GammaFPP.GammaPassage_UniformShape
attribute [-instance] _root_.OAI.PlanarFPP.instDecidableIsBoundarySide _root_.OAI.PlanarFPP.instDecidableLatticeNear
set_option linter.all false
