  obtain ⟨k, -, rfl⟩ := ha
  exact h.getD _

theorem kunpack_digit (P : ℕ) (W : ℤ) :
    ((W + 2 ^ P / 2) % 2 ^ P - 2 ^ P / 2).natAbs ≤ 2 ^ P / 2 := by
  rcases P with _ | k
  · simp
  · have e1 : (2 : ℤ) ^ (k + 1) / 2 = 2 ^ k := by rw [pow_succ]; simp
    have e2 : (2 : ℕ) ^ (k + 1) / 2 = 2 ^ k := by rw [pow_succ]; simp
    have e3 : (2 : ℤ) ^ (k + 1) = 2 * 2 ^ k := by rw [pow_succ]; ring
    rw [e1, e2]
    have hH : (0 : ℤ) < 2 ^ k := by positivity
    have h0 := Int.emod_nonneg (W + 2 ^ k) (show (2 : ℤ) ^ (k + 1) ≠ 0 by positivity)
    have h1 := Int.emod_lt_of_pos (W + 2 ^ k) (show (0 : ℤ) < 2 ^ (k + 1) by positivity)
    generalize (W + 2 ^ k) % 2 ^ (k + 1) = r at *
    have hc : ((2 ^ k : ℕ) : ℤ) = (2 : ℤ) ^ k := by push_cast; rfl
    rw [e3] at h1
    have : |r - 2 ^ k| ≤ ((2 ^ k : ℕ) : ℤ) := by
      rw [hc, abs_le]; constructor <;> linarith
    rw [Int.abs_eq_natAbs] at this
    exact_mod_cast this

theorem kunpack_LBz (P : ℕ) : ∀ (n : ℕ) (W : ℤ), LBz (kunpack (2 ^ P) n W) (2 ^ P / 2) := by
  intro n
  induction n with
  | zero => intro W; simp [kunpack, LBz]
  | succ n ih =>
    intro W a ha
    simp only [kunpack, List.mem_cons] at ha
    rcases ha with rfl | ha
    · exact kunpack_digit P W
    · exact ih _ a ha

theorem decBlk_LB (F : ℤ) (P r : ℕ) (z : ℤ) : LB (decBlk F P r z) (2 ^ P) := by
  intro w hw
  simp only [decBlk, List.mem_map] at hw
  obtain ⟨c, -, rfl⟩ := hw
  have hd := kunpack_LBz P (4 * r) (balMod F z)
  have h2 : 2 * (2 ^ P / 2) ≤ 2 ^ P := Nat.mul_div_le _ _
  constructor
  · refine (Int.natAbs_add_le _ _).trans ?_
    have := hd.getD c; have := hd.getD (c + r); omega
  · refine (Int.natAbs_add_le _ _).trans ?_
    have := hd.getD (2 * r + c); have := hd.getD (3 * r + c); omega

/-- The exact convolution in the Fermat ring returns entries with components `≤ 2^P`, whatever
its inputs. -/
theorem fermatW_LB (q : Params) (U V : List (ℤ × ℤ)) : LB (fermatW q U V) (2 ^ q.P) := by
  unfold fermatW
  exact flatMap_LB fun z _ => decBlk_LB _ _ _ z

/-- `convL` divides the `fermatW` entries by `2^(p+logT)`. -/
theorem convL_LB (q : Params) (U V : List (ℤ × ℤ)) :
    LB (convL q U V) (2 ^ q.P / 2 ^ (q.p + q.logT)) := by
  intro z hz
  simp only [convL, List.mem_map] at hz
  obtain ⟨w, hw, rfl⟩ := hz
  have h := fermatW_LB q U V w hw
  simp only [Int.natAbs_tdiv, Int.natAbs_natCast]
  exact ⟨Nat.div_le_div_right h.1, Nat.div_le_div_right h.2⟩

/-- The `FtL` input (the argument of `convL`): at most twice the bound of `U`. -/
theorem FtL_in_LB (q : Params) {U : List (ℤ × ℤ)} {B : ℕ} (hU : LB U B) :
    LB (List.zipWith (fun a u => mulZ q.p (conjZ a) u) (chirpL q) U) (2 * B) := by
  intro z hz
  obtain ⟨a, ha, u, hu, rfl⟩ := mem_zipWith' hz
  exact mulZ_disc_ZB q.p (conjZ_ZB (chirpL_LB q a ha)) (hU u hu)

theorem FtL_LB (q : Params) (U : List (ℤ × ℤ)) : LB (FtL q U) (NLogN.BD.BC q) := by
  intro z hz
  simp only [FtL] at hz
  obtain ⟨a, ha, w, hw, rfl⟩ := mem_zipWith' hz
  exact mulZ_disc_ZB q.p (conjZ_ZB (chirpL_LB q a ha)) (convL_LB q _ _ w hw)

theorem fwdL_eq (q : Params) (U : List (ℤ × ℤ)) :
    fwdL q U = tensorGo (axB q) q.tdims (FtL q (tensorGo (axS q) q.sdims U)) := rfl

theorem cSq_pos (q : Params) : 1 ≤ cSq q := by
  unfold cSq cS1; nlinarith

theorem cBq_pos (q : Params) : 1 ≤ cBq q := by
  unfold cBq cB1 Jm
  have := Nat.one_le_pow (4 * q.K * q.p / q.α ^ 2 + 1) _ (cE1_pos q.p q.α)
  exact Nat.mul_pos (by omega) (Nat.mul_pos (Nat.succ_pos _) (by omega))

theorem axS_length (q : Params) : (axS q).length = q.K := by simp [axS]
theorem axB_length (q : Params) : (axB q).length = q.K := by simp [axB]

theorem axS_spec (q : Params) : ∀ a ∈ axS q, ∀ X B, LB X B → LB (a.2 X) (cSq q * B) := by
  intro a ha X B hX
  simp only [axS, List.mem_map] at ha
  obtain ⟨i, -, rfl⟩ := ha
  exact sapL_LB _ _ _ _ hX

theorem axB_spec (q : Params) (hJ : HJ q) :
    ∀ a ∈ axB q, ∀ X B, LB X B → LB (a.2 X) (cBq q * B) := by
  intro a ha X B hX
  simp only [axB, List.mem_map, List.mem_range] at ha
  obtain ⟨i, hi, rfl⟩ := ha
  exact bapL_LB' _ _ _ _ _ (hJ i hi) hX

/-- All the stages of one `fwdL` call on an input bounded by `B`. -/
theorem fwdL_stages (q : Params) (hJ : HJ q) {U : List (ℤ × ℤ)} {B : ℕ} (hU : LB U B) :
    -- the `S̃` stages after `k` axes
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims U) (cSq q ^ k * B)) ∧
    -- the slices fed to the `S̃` maps (any step `k`)
    (∀ k n m, ∀ X ∈ chunkL n (transposeL n m (tensorGo ((axS q).take k) q.sdims U)),
      LB X (cSq q ^ k * B)) ∧
    -- the output of all `S̃` axes
    LB (tensorGo (axS q) q.sdims U) (cSq q ^ q.K * B) ∧
    -- the input of `convL`, i.e. the first argument of `fermatW`
    LB (ftIn q U) (2 * (cSq q ^ q.K * B)) ∧
    -- the second argument of `fermatW`
    LB (chirpL q) (2 ^ q.p) ∧
    -- the `fermatW` output
    LB (fermatW q (ftIn q U) (chirpL q)) (2 ^ q.P) ∧
    -- the `convL` output
    LB (convL q (ftIn q U) (chirpL q)) (2 ^ q.P / 2 ^ (q.p + q.logT)) ∧
    -- the `FtL` output
    LB (FtL q (tensorGo (axS q) q.sdims U)) (NLogN.BD.BC q) ∧
    -- the `B̃` stages after `k` axes
    (∀ k, LB (tensorGo ((axB q).take k) q.tdims (FtL q (tensorGo (axS q) q.sdims U)))
      (cBq q ^ k * NLogN.BD.BC q)) ∧
    (∀ k n m, ∀ X ∈ chunkL n (transposeL n m
      (tensorGo ((axB q).take k) q.tdims (FtL q (tensorGo (axS q) q.sdims U)))),
      LB X (cBq q ^ k * NLogN.BD.BC q)) ∧
    -- the output
    LB (fwdL q U) (BF q) := by
  have hS := fun k => tensorGo_take_LB _ (cSq_pos q) _ (axS_spec q) q.sdims hU k
  have hSo : LB (tensorGo (axS q) q.sdims U) (cSq q ^ q.K * B) := by
    have := tensorGo_LB_mul _ (cSq_pos q) _ (axS_spec q) q.sdims hU
    rwa [axS_length] at this
  have hF := FtL_LB q (tensorGo (axS q) q.sdims U)
  have hB := fun k => tensorGo_take_LB _ (cBq_pos q) _ (axB_spec q hJ) q.tdims hF k
  refine ⟨hS, fun k n m => tensorGo_slices_LB (hS k) n m, hSo, FtL_in_LB q hSo, chirpL_LB q,
    fermatW_LB q _ _, convL_LB q _ _, hF, hB, fun k n m => tensorGo_slices_LB (hB k) n m, ?_⟩
  rw [fwdL_eq]
  have := tensorGo_LB_mul _ (cBq_pos q) _ (axB_spec q hJ) q.tdims hF
  rwa [axB_length] at this

theorem fwdL_LB (q : Params) (hJ : HJ q) (U : List (ℤ × ℤ)) : LB (fwdL q U) (BF q) := by
  have hU : LB U (U.foldr (fun z m => max (gB z) m) 0) := by
    intro z hz
    induction U with
    | nil => simp at hz
    | cons a U ih =>
      simp only [List.mem_cons] at hz
      simp only [List.foldr_cons]
      rcases hz with rfl | hz
      · exact ⟨(le_max_left _ _).trans (le_max_left _ _),
          (le_max_right _ _).trans (le_max_left _ _)⟩
      · obtain ⟨h1, h2⟩ := ih hz
        exact ⟨h1.trans (le_max_right _ _), h2.trans (le_max_right _ _)⟩
  exact (fwdL_stages q hJ hU).2.2.2.2.2.2.2.2.2.2

theorem exactConvL_eq (q : Params) (u v : List ℤ) :
    exactConvL q u v = (ecY q u v).map fun z =>
      roundDiv (z.1 * (q.S : ℤ) ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2)) (2 ^ q.p) := rfl

theorem ecU_LB (q : Params) {u : List ℤ} {B : ℕ} (hu : LBz u B) :
    LB (ecU q u) (B * 2 ^ (q.p - q.b)) := by
  intro z hz
  simp only [ecU, List.mem_map] at hz
  obtain ⟨a, ha, rfl⟩ := hz
  refine ⟨?_, by simp⟩
  rw [Int.natAbs_mul, Int.natAbs_pow]
  exact Nat.mul_le_mul (hu a ha) le_rfl

theorem ecW_LB (q : Params) (hJ : HJ q) (u v : List ℤ) : LB (ecW q u v) (BW q) := by
  intro z hz
  obtain ⟨a, ha, b, hb, rfl⟩ := mem_zipWith' hz
  exact conjZ_ZB (mulZ_ZB q.p (fwdL_LB q hJ _ a ha) (fwdL_LB q hJ _ b hb))

theorem ecY_LB (q : Params) (hJ : HJ q) (u v : List ℤ) : LB (ecY q u v) (BF q) :=
  fwdL_LB q hJ _

theorem roundDiv_natAbs_le (a : ℤ) (m : ℕ) (hm : 1 ≤ m) :
    (roundDiv a m).natAbs ≤ a.natAbs / m + 2 := by
  unfold roundDiv
  have hlt := Nat.lt_mul_div_succ a.natAbs (show 0 < m by omega)
  have h := NLogN.abs_ediv_le_of (2 * a + m) (2 * m) ((a.natAbs / m + 2 : ℕ) : ℤ)
    (by positivity) (by
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul, abs_of_pos (by norm_num : (0 : ℤ) < 2), Int.abs_eq_natAbs,
        abs_of_nonneg (by positivity : (0 : ℤ) ≤ m)]
      have : (a.natAbs : ℤ) < m * ((a.natAbs / m : ℕ) + 1) := by exact_mod_cast hlt
      push_cast
      nlinarith)
  rw [Int.abs_eq_natAbs] at h
  exact_mod_cast h

theorem exactConvL_LBz (q : Params) (hJ : HJ q) (u v : List ℤ) :
    LBz (exactConvL q u v) (NLogN.BD.BX q) := by
  intro a ha
  rw [exactConvL_eq] at ha
  simp only [List.mem_map] at ha
  obtain ⟨z, hz, rfl⟩ := ha
  have h1 := (ecY_LB q hJ u v z hz).1
  refine (roundDiv_natAbs_le _ _ Nat.one_le_two_pow).trans ?_
  unfold NLogN.BD.BX
  apply Nat.add_le_add_right
  apply Nat.div_le_div_right
  rw [Int.natAbs_mul, Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_pow, Int.natAbs_natCast]
  exact Nat.mul_le_mul (Nat.mul_le_mul_right _ h1) le_rfl

theorem rU_LBz (q : Params) (x : ℕ) : LBz (rU q x) (2 ^ q.b) :=
  (crtIn_LBz _ (chunksL_LBz _ _ _)).mono (Nat.sub_le _ _)

theorem ecU_rU_LB (q : Params) (hbp : q.b ≤ q.p) (x : ℕ) : LB (ecU q (rU q x)) (2 ^ q.p) := by
  have := ecU_LB q (rU_LBz q x)
  rwa [← pow_add, Nat.add_sub_cancel' hbp] at this

/-- All intermediate lists of `refStep q x y`, for a general `q` with `HJ q` and `b ≤ p`.
(a) the scaled inputs; (b)–(d) every stage of the three `fwdL` calls (inputs bounded by
`2^p`, `2^p` and `BW q`); (e) `W` and `Y`; (f) the `exactConvL` output and the `crtOut`
digits. -/
theorem refStep_bounds (q : Params) (hJ : HJ q) (hbp : q.b ≤ q.p) (x y : ℕ) :
    LBz (rU q x) (2 ^ q.b) ∧ LBz (rU q y) (2 ^ q.b) ∧
    LB (ecU q (rU q x)) (2 ^ q.p) ∧ LB (ecU q (rU q y)) (2 ^ q.p) ∧
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecU q (rU q x))) (cSq q ^ k * 2 ^ q.p)) ∧
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecU q (rU q y))) (cSq q ^ k * 2 ^ q.p)) ∧
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecW q (rU q x) (rU q y)))
      (cSq q ^ k * BW q)) ∧
    LB (ftIn q (ecU q (rU q x))) (2 * (cSq q ^ q.K * 2 ^ q.p)) ∧
    LB (ftIn q (ecU q (rU q y))) (2 * (cSq q ^ q.K * 2 ^ q.p)) ∧
    LB (ftIn q (ecW q (rU q x) (rU q y))) (2 * (cSq q ^ q.K * BW q)) ∧
    LB (chirpL q) (2 ^ q.p) ∧
    (∀ X Y, LB (fermatW q X Y) (2 ^ q.P)) ∧
    (∀ X Y, LB (convL q X Y) (2 ^ q.P / 2 ^ (q.p + q.logT))) ∧
    (∀ X, LB (FtL q X) (NLogN.BD.BC q)) ∧
    (∀ X k, LB (tensorGo ((axB q).take k) q.tdims (FtL q X)) (cBq q ^ k * NLogN.BD.BC q)) ∧
    (∀ X, LB (fwdL q X) (BF q)) ∧
    LB (ecW q (rU q x) (rU q y)) (BW q) ∧
    LB (ecY q (rU q x) (rU q y)) (BF q) ∧
    LBz (exactConvL q (rU q x) (rU q y)) (NLogN.BD.BX q) ∧
    LBz (crtOut q.s (2 * q.L - 1) (exactConvL q (rU q x) (rU q y))) (NLogN.BD.BX q) := by
  have hUx := ecU_rU_LB q hbp x
  have hUy := ecU_rU_LB q hbp y
  have hW := ecW_LB q hJ (rU q x) (rU q y)
  have sx := fwdL_stages q hJ hUx
  have sy := fwdL_stages q hJ hUy
  have sw := fwdL_stages q hJ hW
  have hX := exactConvL_LBz q hJ (rU q x) (rU q y)
  refine ⟨rU_LBz q x, rU_LBz q y, hUx, hUy, sx.1, sy.1, sw.1, sx.2.2.2.1, sy.2.2.2.1,
    sw.2.2.2.1, chirpL_LB q, fermatW_LB q, convL_LB q, FtL_LB q,
    fun X k => tensorGo_take_LB _ (cBq_pos q) _ (axB_spec q hJ) q.tdims (FtL_LB q X) k,
    fwdL_LB q hJ, hW, ecY_LB q hJ _ _, hX, crtOut_LBz _ _ hX⟩

end NLogN.BD

