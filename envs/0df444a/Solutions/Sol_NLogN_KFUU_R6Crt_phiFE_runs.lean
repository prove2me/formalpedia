-- Source module: Solutions.KFUPhi
/-!
# KFU §8: the programs `Φ` and `Φ⁻¹`

Parameters: `d` axes, sources `s_j = sF j` (`1 ≤ s_j ≤ t_j`), padded sizes
`t_j = tP d h bL j = 2^h · (2 if bL j)`, multipliers `μ j`.  Arrays are integer lists with a
trailing component axis of size `2` (Gaussian records in `gflat` form); the component axis has
index `d`.

* `shK f = ((range d).reverse ++ [d]).map f` (k-order, `x_0` innermost: flat index `2k + c`),
* `shR f = (range d ++ [d]).map f` (reversed order, `x_0` outermost).

`phiC`: pad `S_k → T_k` (one scan per axis), reverse the axes (`revC`: Lemma 12 swaps of the
`2^h`-atoms + single-bit moves), delete the padding `T_r → S_r`, run the `d` prefix-controlled
shifts `i = d-1, …, 0` (`rotStep`: offset table `Σ_{j<i} (μ_i P_j mod s_i) x_j mod s_i`), pad
`S_r → T_r`.  `phi_spec`: the result is `PhiD xs`.

`phiInvC`: the inverse (delete padding, inverse shifts `i = 0, …, d-1`, pad, reverse back,
delete padding).  `phiInv_spec`: the result is `PhiInvD ys`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Generic shape lemmas -/

theorem extract_pull_embed' {α : Type*} {S T S' T' : Shape} (hST : ShapeLE S T)
    (hST' : ShapeLE S' T') (g : List ℕ → List ℕ) (hg : ∀ a, Valid S' a → Valid S (g a)) (d : α)
    (xs : List α) :
    extract S' T' d (pull T T' g d (embed S T d xs)) = pull S S' g d xs := by
  classical
  apply List.ext_getElem (by simp)
  intro j h1 h2
  simp only [length_extract] at h1
  have ha := valid_decode h1
  have haT := hST'.valid ha
  have hgS := hg _ ha
  have hgT := hST.valid hgS
  simp only [extract, getElem_pull, id]
  rw [List.getD_eq_getElem _ _ (by simpa using encode_lt haT), getElem_pull, decode_encode haT,
    List.getD_eq_getElem _ _ (by simpa using encode_lt hgT)]
  simp only [embed, List.getElem_map, List.getElem_range, decode_encode hgT, if_pos hgS]

theorem valid_revH {P Q : Shape} {a : List ℕ} (h : Valid (P ++ Q) a) :
    Valid (P.reverse ++ Q) (revH P.length a) := by
  have hl : (a.take P.length).length = P.length := by
    have := h.length_eq; simp at this ⊢; omega
  rw [← List.take_append_drop P.length a] at h
  obtain ⟨h1, h2⟩ := (KIL.valid_append_iff hl).1 h
  exact valid_append (List.forall₂_reverse_iff.2 h1) h2

