theorem stab_generic {R : Type*} [CommRing R] {J : Type*} [AddCommGroup J] [Module R J]
    (𝔓 : Ideal R) (ξ : R) (hVfin : Finite ↥(Submodule.torsionBySet R J (Ideal.span {ξ} : Set R)))
    {S : Type*} [CommRing S] (𝔓' : Ideal S) (ξ' : S) (hRfin : Finite (S ⧸ Ideal.span {ξ'}))
    (start : ℕ) :
    ∃ M, start ≤ M ∧
      Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + 1)) : Set R) =
        Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R) ∧
      (Ideal.span {ξ'} ⊔ 𝔓' ^ (M + 1) : Ideal S) = Ideal.span {ξ'} ⊔ 𝔓' ^ M := by

  have hanti : ∀ {a b : ℕ}, a ≤ b →
      (Ideal.span {ξ} ⊔ 𝔓 ^ b : Ideal R) ≤ Ideal.span {ξ} ⊔ 𝔓 ^ a :=
    fun hab => sup_le_sup_left (Ideal.pow_le_pow_right hab) _
  have hanti' : ∀ {a b : ℕ}, a ≤ b →
      (Ideal.span {ξ'} ⊔ 𝔓' ^ b : Ideal S) ≤ Ideal.span {ξ'} ⊔ 𝔓' ^ a :=
    fun hab => sup_le_sup_left (Ideal.pow_le_pow_right hab) _
  have hsubV : ∀ M, Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R) ≤
      Submodule.torsionBySet R J (Ideal.span {ξ} : Set R) := fun M =>
    Submodule.torsionBySet_le_torsionBySet_of_subset (le_sup_left : Ideal.span {ξ} ≤ _)
  have hfinV : ∀ M, Finite ↥(Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R)) :=
    fun M => Finite.Set.subset _ (hsubV M)
  have hfinR : ∀ M, Finite (S ⧸ (Ideal.span {ξ'} ⊔ 𝔓' ^ M)) := fun M => by
    exact Finite.of_surjective (Ideal.Quotient.factor (le_sup_left))
      (Ideal.Quotient.factor_surjective _)
  let fV : ℕ → ℕ := fun M => Nat.card ↥(Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R))
  let fR : ℕ → ℕ := fun M => Nat.card (S ⧸ (Ideal.span {ξ'} ⊔ 𝔓' ^ M))
  have hfVmono : Monotone fV := fun a b hab =>
    Nat.card_le_card_of_injective
      (Submodule.inclusion (Submodule.torsionBySet_le_torsionBySet_of_subset (hanti hab)))
      (Submodule.inclusion_injective _)
  have hfRmono : Monotone fR := fun a b hab => by
    haveI := hfinR a
    exact Nat.card_le_card_of_surjective (Ideal.Quotient.factor (hanti' hab))
      (Ideal.Quotient.factor_surjective _)
  have hfVb : ∀ M, fV M ≤ Nat.card ↥(Submodule.torsionBySet R J (Ideal.span {ξ} : Set R)) :=
    fun M => Nat.card_le_card_of_injective (Submodule.inclusion (hsubV M))
      (Submodule.inclusion_injective _)
  have hfRb : ∀ M, fR M ≤ Nat.card (S ⧸ Ideal.span {ξ'}) := fun M => by
    exact Nat.card_le_card_of_surjective (Ideal.Quotient.factor (le_sup_left))
      (Ideal.Quotient.factor_surjective _)
  obtain ⟨M, hMs, hfVeq, hfReq⟩ :=
    exists_step_eq_two_mono fV fR hfVmono hfRmono _ _ hfVb hfRb start
  haveI := hfinV (M + 1)
  haveI := hfinR (M + 1)
  refine ⟨M, hMs, ?_, ?_⟩
  · have hVle : Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R) ≤
        Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + 1)) : Set R) :=
      Submodule.torsionBySet_le_torsionBySet_of_subset (hanti (Nat.le_succ M))
    have hc : Nat.card ↥(Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + 1)) : Set R))
        ≤ Nat.card ↥(Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R)) := hfVeq.le
    exact (submodule_eq_of_le_of_card_eq hVle hc).symm
  · have hc : Nat.card (S ⧸ (Ideal.span {ξ'} ⊔ 𝔓' ^ (M + 1)))
        ≤ Nat.card (S ⧸ (Ideal.span {ξ'} ⊔ 𝔓' ^ M)) := hfReq.le
    exact ideal_eq_of_le_of_card_quotient_eq (hanti' (Nat.le_succ M)) hc

theorem exists_inertia_n_ne_one (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (hAq : Aq.LiesOverPrime q)
    (m : ℕ) (hm : 1 ≤ m) (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ)
    (hn : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ) :
    ∃ σ₀ ∈ Aq.inertiaSubgroupIn ℚ, ¬ ((n σ₀ : ZMod q) = 1) := by
  have hq : q.Prime := Fact.out
  haveI : NeZero q := ⟨hq.ne_zero⟩
  obtain ⟨σ₀, hσ₀, hpow⟩ :=
    ValuationSubring.exists_mem_inertiaSubgroupIn_apply_eq_pow Aq hq hAq (-1)

  haveI : NeZero ((q : ℕ) : AlgebraicClosure ℚ) := ⟨Nat.cast_ne_zero.mpr hq.ne_zero⟩
  have hdeg : (Polynomial.cyclotomic q (AlgebraicClosure ℚ)).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    exact_mod_cast (Nat.totient_pos.mpr hq.pos).ne'
  obtain ⟨ζ, hζroot⟩ := IsAlgClosed.exists_root _ hdeg
  have hζ : IsPrimitiveRoot ζ q := Polynomial.isRoot_cyclotomic_iff.mp hζroot
  refine ⟨σ₀, hσ₀, ?_⟩
  have hζq : ζ ^ q = 1 := hζ.pow_eq_one
  have hζqm : ζ ^ (q ^ m) = 1 := by
    obtain ⟨d, hd⟩ : q ∣ q ^ m := dvd_pow_self q (Nat.one_le_iff_ne_zero.mp hm)
    rw [hd, pow_mul, hζq, one_pow]
  set a : ℕ := ((-1 : (ZMod q)ˣ) : ZMod q).val with ha
  have e1 : σ₀ ζ = ζ ^ n σ₀ := hn σ₀ ζ hζqm
  have e2 : σ₀ ζ = ζ ^ a := hpow ζ hζq

  have hr : ζ ^ (n σ₀ % q) = ζ ^ a := by
    conv_rhs => rw [← e2, e1]
    conv_rhs => rw [← Nat.div_add_mod (n σ₀) q, pow_add, pow_mul, hζq, one_pow, one_mul]
  have hra : n σ₀ % q = a :=
    hζ.pow_inj (Nat.mod_lt _ hq.pos) (ZMod.val_lt _) hr
  intro hcon

  have hcast : ((n σ₀ : ℕ) : ZMod q) = ((a : ℕ) : ZMod q) := by
    conv_lhs => rw [← Nat.div_add_mod (n σ₀) q]
    push_cast [ZMod.natCast_self]
    rw [hra]; ring
  have hval : ((a : ℕ) : ZMod q) = ((-1 : (ZMod q)ˣ) : ZMod q) := by
    rw [ha, ZMod.natCast_val, ZMod.cast_id]
  have hneg : ((-1 : (ZMod q)ˣ) : ZMod q) = (-1 : ZMod q) := by
    rw [Units.val_neg, Units.val_one]
  have h11 : (-1 : ZMod q) = 1 := by
    rw [← hneg, ← hval, ← hcast]; exact hcon
  have h20 : ((2 : ℕ) : ZMod q) = 0 := by
    push_cast
    linear_combination -h11
  have hdvd : q ∣ 2 := (CharP.cast_eq_zero_iff (ZMod q) q 2).mp h20
  rcases (Nat.prime_two.eq_one_or_self_of_dvd q hdvd) with h | h
  · exact hq.one_lt.ne' h
  · exact hq2 h

lemma mem_of_pin_of_displacement {G₀ : Type*} [Group G₀] {X : Type*} [AddCommGroup X]
    [DistribMulAction G₀ X] (I : Subgroup G₀) (n : G₀ → ℕ) (W WMD : AddSubgroup X)
    (q m : ℕ) (hq : q.Prime)
    (hW1 : MultiplicativeTypeNat I n W)
    (hWtors : ∀ x ∈ W, ((q : ℤ) ^ m) • x = 0)
    (hdisp : ∀ σ ∈ I, ∀ x ∈ W, σ • x - x ∈ WMD)
    (σ₀ : G₀) (hσ₀ : σ₀ ∈ I) (hne : ¬ ((n σ₀ : ZMod q) = 1)) :
    ∀ x ∈ W, x ∈ WMD := by
  intro x hx
  have hndvd : ¬ ((q : ℤ) ∣ ((n σ₀ : ℤ) - 1)) := by
    intro hdvd
    apply hne
    have h0 : (((n σ₀ : ℤ) - 1 : ℤ) : ZMod q) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mpr hdvd
    push_cast at h0
    linear_combination h0
  have hcop : IsCoprime ((n σ₀ : ℤ) - 1) ((q : ℤ) ^ m) :=
    (((Nat.prime_iff_prime_int.mp hq).coprime_iff_not_dvd.mpr hndvd).symm).pow_right
  obtain ⟨u, v, huv⟩ := hcop
  have hdx : ((n σ₀ : ℤ) - 1) • x = σ₀ • x - x := by
    rw [sub_zsmul, one_zsmul, natCast_zsmul, ← hW1 σ₀ hσ₀ x hx, sub_eq_add_neg]
  have hx1 : x = (u * ((n σ₀ : ℤ) - 1) + v * ((q : ℤ) ^ m)) • x := by
    rw [huv, one_zsmul]
  rw [add_zsmul, mul_zsmul, mul_zsmul, hdx, hWtors x hx, smul_zero, add_zero] at hx1
  rw [hx1]
  exact AddSubgroup.zsmul_mem _ (hdisp σ₀ hσ₀ x hx) u

theorem torsionBySet_sup_pow_add_eq {R : Type*} [CommRing R] {J : Type*} [AddCommGroup J] [Module R J]
    (𝔓 : Ideal R) (ξ : R) (M : ℕ)
    (h : Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + 1)) : Set R) =
      Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R)) (j : ℕ) :
    Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + j)) : Set R) =
      Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R) := by
  induction j with
  | zero => simp
  | succ j ih =>
    apply le_antisymm
    ·

      intro x hx
      rw [Submodule.mem_torsionBySet_iff] at hx
      have hξx : ξ • x = 0 := hx ⟨ξ, Ideal.mem_sup_left (Ideal.mem_span_singleton_self ξ)⟩
      have hπ : ∀ π ∈ 𝔓, π • x ∈ Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ M) : Set R) := by
        intro π hπ
        rw [← ih, Submodule.mem_torsionBySet_iff]
        rintro ⟨a, ha⟩
        obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp ha
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
        change (r * ξ + z) • (π • x) = 0
        have hξπ : ξ • (π • x) = 0 := by
          rw [← mul_smul, mul_comm, mul_smul, hξx, smul_zero]
        rw [add_smul, mul_smul, hξπ, smul_zero, zero_add, ← mul_smul]
        have hzπ : z * π ∈ Ideal.span {ξ} ⊔ 𝔓 ^ (M + (j + 1)) :=
          Ideal.mem_sup_right (by rw [← add_assoc, pow_succ]; exact Ideal.mul_mem_mul hz hπ)
        exact hx ⟨_, hzπ⟩
      have hx1 : x ∈ Submodule.torsionBySet R J (↑(Ideal.span {ξ} ⊔ 𝔓 ^ (M + 1)) : Set R) := by
        rw [Submodule.mem_torsionBySet_iff]
        rintro ⟨a, ha⟩
        obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp ha
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
        change (r * ξ + z) • x = 0
        rw [add_smul, mul_smul, hξx, smul_zero, zero_add]
        rw [pow_succ] at hz
        refine Submodule.mul_induction_on hz ?_ ?_
        · intro b hb π hπ'
          have := hπ π hπ'
          rw [Submodule.mem_torsionBySet_iff] at this
          rw [mul_smul]
          exact this ⟨b, Ideal.mem_sup_right hb⟩
        · intro a₁ a₂ h₁ h₂
          rw [add_smul, h₁, h₂, add_zero]
      rw [h] at hx1
      exact hx1
    · have hle : Ideal.span {ξ} ⊔ 𝔓 ^ (M + (j + 1)) ≤ Ideal.span {ξ} ⊔ 𝔓 ^ M :=
        sup_le_sup_left (Ideal.pow_le_pow_right (Nat.le_add_right M _)) _
      exact Submodule.torsionBySet_le_torsionBySet_of_subset hle

theorem card_le_card_quotient_of_pairing {V : Type*} [AddCommGroup V] [Finite V] (Wv : AddSubgroup V)
    {Lq : Type*} [AddCommGroup Lq]
    (e : V → Lq → (AlgebraicClosure ℚ)ˣ)
    (hadd_v : ∀ v₁ v₂ r, e (v₁ + v₂) r = e v₁ r * e v₂ r)
    (hadd_r : ∀ v r₁ r₂, e v (r₁ + r₂) = e v r₁ * e v r₂)
    (hRK : ∀ r, (∀ v, e v r = 1) → r = 0)
    (hW : ∀ v ∈ Wv, ∀ r, e v r = 1) :
    Nat.card Lq ≤ Nat.card (V ⧸ Wv) := by
  classical
  have he0 : ∀ r, e 0 r = 1 := fun r => by
    have h := hadd_v 0 0 r
    rw [add_zero] at h
    exact (mul_left_cancel (h.symm.trans (mul_one _).symm))
  have he0' : ∀ v, e v 0 = 1 := fun v => by
    have h := hadd_r v 0 0
    rw [add_zero] at h
    exact (mul_left_cancel (h.symm.trans (mul_one _).symm))

  let χ : Lq → (V →+ Additive (AlgebraicClosure ℚ)ˣ) := fun r =>
    { toFun := fun v => Additive.ofMul (e v r)
      map_zero' := by show Additive.ofMul (e 0 r) = 0; rw [he0]; rfl
      map_add' := fun x y => by
        show Additive.ofMul (e (x + y) r) = Additive.ofMul (e x r) + Additive.ofMul (e y r)
        rw [hadd_v, ofMul_mul] }
  have hχW : ∀ r, ∀ v ∈ Wv, χ r v = 0 := fun r v hv => by
    show Additive.ofMul (e v r) = 0
    rw [hW v hv r]; rfl
  let φ : Lq →+ (V ⧸ Wv →+ Additive (AlgebraicClosure ℚ)ˣ) :=
    { toFun := fun r => QuotientAddGroup.lift Wv (χ r) (hχW r)
      map_zero' := by
        refine AddMonoidHom.ext fun t => ?_
        induction t using QuotientAddGroup.induction_on with
        | H v =>
          show χ 0 v = 0
          show Additive.ofMul (e v 0) = 0
          rw [he0']; rfl
      map_add' := fun r₁ r₂ => by
        refine AddMonoidHom.ext fun t => ?_
        induction t using QuotientAddGroup.induction_on with
        | H v =>
          show χ (r₁ + r₂) v = χ r₁ v + χ r₂ v
          show Additive.ofMul (e v (r₁ + r₂)) = Additive.ofMul (e v r₁) + Additive.ofMul (e v r₂)
          rw [hadd_r, ofMul_mul] }
  have hφinj : Function.Injective φ := by
    intro r₁ r₂ h12
    have hsub : φ (r₁ - r₂) = 0 := by rw [map_sub, h12, sub_self]
    have hall : ∀ v : V, e v (r₁ - r₂) = 1 := fun v => by
      have := congrArg (fun f : V ⧸ Wv →+ Additive (AlgebraicClosure ℚ)ˣ => f (QuotientAddGroup.mk v)) hsub
      change χ (r₁ - r₂) v = 0 at this
      exact Additive.ofMul.injective this
    exact sub_eq_zero.mp (hRK _ hall)
  haveI : Finite (V ⧸ Wv) := Quotient.finite _
  obtain ⟨ι, hι⟩ := dual_of_injective_toAdditive φ hφinj
  exact Nat.card_le_card_of_injective ι hι

