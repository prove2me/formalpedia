private theorem coe_centralGen (v : HeightOneSpectrum (𝓞 ℚ)) :
    ((centralGen v : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![varpi v, varpi v, varpi v] :=
  rfl

private theorem coe_iotaTorusLocal (v : HeightOneSpectrum (𝓞 ℚ)) (n : ℕ) :
    ((iotaTorusLocal v n : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![((ratPrimeUnit v ^ n : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ), 1, 1] := by
  show ((iotaGL (diagHom (ratPrimeUnit v ^ n)) : GL (Fin 3) (v.adicCompletion ℚ)) :
    Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) = _
  rw [coe_iotaGL, diagHom_apply, coe_diagUnitGL2]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedMat2, Matrix.diagonal]

private theorem coe_twoRowPointLocal (v : HeightOneSpectrum (𝓞 ℚ)) (k₁ k₂ : ℕ) :
    ((twoRowPointLocal v k₁ k₂ : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![((ratPrimeUnit v ^ k₁ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ),
        ((ratPrimeUnit v ^ k₂ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ), 1] := by
  show ((iotaGL (diagUnits2 (ratPrimeUnit v ^ k₁) (ratPrimeUnit v ^ k₂)) : GL (Fin 3) (v.adicCompletion ℚ)) :
    Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) = _
  rw [coe_iotaGL, coe_diagUnits2]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedMat2, Matrix.diagonal]

private theorem isInducedSphericalAt_comp_mul {c : HeightOneSpectrum (𝓞 K) → ℂ} {v : HeightOneSpectrum (𝓞 ℚ)}
    {U : Subgroup (LocalGL3 v)} {W : LocalGL3 v → ℂ} (τ : LocalGL3 v) (hz : Commute (centralGen v) τ)
    (h : IsInducedSphericalAt c v U W) : IsInducedSphericalAt c v U fun g => W (τ * g) := by
  refine ⟨fun g u hu => ?_, fun ι _ reps hreps g => ?_, fun ι _ reps hreps g => ?_, fun g => ?_⟩
  · exact (congrArg W (mul_assoc τ g u).symm).trans (h.1 (τ * g) u hu)
  · have e := h.2.1 ι reps hreps (τ * g)
    simpa only [cosetSum, mul_assoc] using e
  · have e := h.2.2.1 ι reps hreps (τ * g)
    simpa only [cosetSum, mul_assoc] using e
  · have e : τ * (centralGen v * g) = centralGen v * (τ * g) :=
      (mul_assoc _ _ _).symm.trans ((congrArg (· * g) hz.eq.symm).trans (mul_assoc _ _ _))
    calc W (τ * (centralGen v * g)) = W (centralGen v * (τ * g)) := congrArg W e
      _ = RankinSelberg.inducedE3 ℚ c v * W (τ * g) := h.2.2.2 (τ * g)

private theorem hasSphericalTorusValuesAt_comp_mul {c : HeightOneSpectrum (𝓞 K) → ℂ} {v : HeightOneSpectrum (𝓞 ℚ)}
    {W : LocalGL3 v → ℂ} (τ : LocalGL3 v) {e : Fin 3 → v.adicCompletion ℚ}
    (hτ : (τ : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) = Matrix.diagonal e) (hinv : ∀ g, W (g * τ) = W g)
    (h : HasSphericalTorusValuesAt c v W) : HasSphericalTorusValuesAt c v fun g => W (τ * g) := by
  refine ⟨fun n => ?_, fun k₁ k₂ hk => ?_⟩
  · calc W (τ * iotaTorusLocal v n) = W (iotaTorusLocal v n * τ) :=
          congrArg W (commute_of_coe_eq_diagonal hτ (coe_iotaTorusLocal v n)).eq
      _ = W (iotaTorusLocal v n) := hinv _
      _ = _ := h.1 n
  · calc W (τ * twoRowPointLocal v k₁ (k₂ + 1)) = W (twoRowPointLocal v k₁ (k₂ + 1) * τ) :=
          congrArg W (commute_of_coe_eq_diagonal hτ (coe_twoRowPointLocal v k₁ (k₂ + 1))).eq
      _ = W (twoRowPointLocal v k₁ (k₂ + 1)) := hinv _
      _ = _ := h.2 k₁ k₂ hk

end
