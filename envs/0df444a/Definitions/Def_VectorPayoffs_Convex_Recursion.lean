-- title:
--   Conditions (5), (6), (7) on a sequence δ₁, δ₂, … and the σ-algebra σ(δ₁, …, δₙ) (§2, p. 4)
-- statement:
--   For a sequence of real random variables $\delta_1,\delta_2,\dots$ on a probability space and constants $a,b,c\in\mathbb R$, this file defines $\sigma(\delta_1,\dots,\delta_n)$, the $\sigma$-algebra generated by the first $n$ terms (trivial for $n=0$), and the three conditions of Blackwell's §2:
--
--   1. (5) for every $n\ge2$, almost surely, if $\delta_{n-1}>0$ then
--   $$E(\delta_n\mid\delta_1,\dots,\delta_{n-1})\le\Big(1-\frac2n\Big)\delta_{n-1}+\frac{c}{n^2};$$
--   2. (6) for every $n\ge1$, $0\le\delta_n\le a$ almost surely;
--   3. (7) for every $n\ge2$, $|\delta_n-\delta_{n-1}|\le b/n$ almost surely.
--
--   These are the hypotheses of the LEMMA and the conclusion of the proof step of THEOREM 1 that establishes them for the squared distance of the average payoff from $S$.
--
--   **Formalization Note** The sequence is indexed from $1$ (`δ 0` is unused). (6) and (7) are stated almost surely, which is weaker than pointwise and is what a play delivers (outcomes lie in $X$ only almost surely). The conditional expectation is Mathlib's `condExp` with respect to the comap $\sigma$-algebra of $(\delta_1,\dots,\delta_{n-1})$.
-- source:
--   Blackwell, An analog of the minimax theorem for vector payoffs, Pacific J. Math. 6(1), 1956, p. 4, displays (5), (6), (7)

import Mathlib

open MeasureTheory

namespace VectorPayoffs.Convex

/-- `σ(δ₁, …, δₙ)`: the σ-algebra generated by the first `n` terms of a real sequence of random
variables indexed from `1` (`δ 0` is unused). For `n = 0` it is the trivial σ-algebra. -/
def pastSigma {Ω : Type} (δ : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (i : Fin n) => δ (i.val + 1) ω) inferInstance

/-- Blackwell (1956), §2, p. 4, conditions (5), (6), (7) on a sequence `δ₁, δ₂, …`:
(5) `E(δₙ | δ₁, …, δₙ₋₁) ≤ (1 - 2/n) δₙ₋₁ + c/n²` if `δₙ₋₁ > 0` (for `n ≥ 2`);
(6) `0 ≤ δₙ ≤ a` (for `n ≥ 1`);
(7) `|δₙ - δₙ₋₁| ≤ b/n` (for `n ≥ 2`);
(6) and (7) almost surely. -/
def SatisfiesRecursion {Ω : Type} [MeasurableSpace Ω] (a b c : ℝ) (μ : Measure Ω)
    (δ : ℕ → Ω → ℝ) : Prop :=
  (∀ n : ℕ, 2 ≤ n → ∀ᵐ ω ∂μ, 0 < δ (n - 1) ω →
      μ[δ n | pastSigma δ (n - 1)] ω ≤ (1 - 2 / (n : ℝ)) * δ (n - 1) ω + c / (n : ℝ) ^ 2) ∧
  (∀ n : ℕ, 1 ≤ n → ∀ᵐ ω ∂μ, 0 ≤ δ n ω ∧ δ n ω ≤ a) ∧
  (∀ n : ℕ, 2 ≤ n → ∀ᵐ ω ∂μ, |δ n ω - δ (n - 1) ω| ≤ b / (n : ℝ))

end VectorPayoffs.Convex


