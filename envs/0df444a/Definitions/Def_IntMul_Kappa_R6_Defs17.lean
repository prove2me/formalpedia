-- Source module: Solutions.R6ZMain
/-!
# Round six, chirp: `P18Body6 → chirpG6`

The frozen `KFZMain.chirpNeedR_of_P18` at the round-six sizes: the chirp procedure `body`
(`KFZFull`) is the own procedure of the merged table `mExt4 ext₁₈ ∅ ∅ ∅ [body]` in `kTableP tab`;
the Prop 18 procedure (from `P18Body6`) is reached through `g4₁`. The descriptor stack is
`cS = 36`. Per call `M̃r = mrtCall t F G H` with `H` the Prop 18 result, within `errW6 · 2^{-p}`.

* **`chirp_of_P18`**: one table, entry, constants for all sizes `Q` of the parameters `P` with
  `QOk Q`: the grid tables `θ̃, θ̃⁻, ã, b̃` with their `Phases` facts and `chirpG6`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFZ
  IntMul.OpenAI.RC IntMul.OpenAI.RT

noncomputable section

/-- The merged extension list of the chirp table: Prop 18, three empty slots, the chirp body. -/
def extZ6 {E18 : ℕ} (ext18 : Fin E18 → IStmt HS (7 + E18)) (entry18 : Fin (7 + E18))
    (d18 : Fin HS) : Fin (E18 + 0 + 0 + 0 + 1) → IStmt HS (7 + (E18 + 0 + 0 + 0 + 1)) :=
  mExt4 ext18 (Fin.elim0 : Fin 0 → IStmt HS (7 + 0)) (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
    (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
    (fun _ => body (g4₁ E18 0 0 0 1 entry18) d18)

end

end IntMul.Kappa.R6

end

