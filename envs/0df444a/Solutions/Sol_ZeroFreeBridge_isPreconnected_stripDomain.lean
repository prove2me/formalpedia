  have preC : IsPreconnected ({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.im < 0}) :=
    ((convex_halfSpace_re_gt 0).inter (convex_halfSpace_im_lt 0)).isPreconnected
  have preD : IsPreconnected {s : ℂ | 1 < s.re} := (convex_halfSpace_re_gt 1).isPreconnected
  have g1 : (⟨(1 / 2), 1⟩ : ℂ) ∈ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.re < 1}) := by
    norm_num [Set.mem_inter_iff, Set.mem_setOf_eq]
  have g1' : (⟨(1 / 2), 1⟩ : ℂ) ∈ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | 0 < s.im}) := by
    norm_num [Set.mem_inter_iff, Set.mem_setOf_eq]
  have preAB := IsPreconnected.union (⟨(1 / 2), 1⟩ : ℂ) g1 g1' preA preB
  have g2 : (⟨(1 / 2), (-1)⟩ : ℂ) ∈
      (({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.re < 1}) ∪ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | 0 < s.im})) :=
    Or.inl (by norm_num [Set.mem_inter_iff, Set.mem_setOf_eq])
  have g2' : (⟨(1 / 2), (-1)⟩ : ℂ) ∈ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.im < 0}) := by
    norm_num [Set.mem_inter_iff, Set.mem_setOf_eq]
  have preABC := IsPreconnected.union (⟨(1 / 2), (-1)⟩ : ℂ) g2 g2' preAB preC
  have g3 : (⟨2, 1⟩ : ℂ) ∈
      ((({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.re < 1}) ∪ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | 0 < s.im})) ∪ ({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.im < 0})) :=
    Or.inl (Or.inr (by norm_num [Set.mem_inter_iff, Set.mem_setOf_eq]))
  have g3' : (⟨2, 1⟩ : ℂ) ∈ {s : ℂ | 1 < s.re} := by
    norm_num [Set.mem_setOf_eq]
  have preABCD := IsPreconnected.union (⟨2, 1⟩ : ℂ) g3 g3' preABC preD
  have heq : stripDomain =
