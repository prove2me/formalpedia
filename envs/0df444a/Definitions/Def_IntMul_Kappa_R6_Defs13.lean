        (B * 2 ^ t * S0) (Pm i j : Butterfly.Op (Fin m × Fin (m ^ k))) rowC 0 0 cost ∧
      ∀ w, w ≤ H → (cost w : ℝ) ≤ (Kc * (K + 2) + 1) * ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        ((r : ℝ) * (H + 1) * ((m : ℝ) ^ k + 1) ^ τ + (KFR.PsiR r Z H : ℝ))

