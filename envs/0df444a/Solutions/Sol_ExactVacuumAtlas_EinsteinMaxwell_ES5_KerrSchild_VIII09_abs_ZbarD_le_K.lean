/-! ## The uniform denominator bound on `K` -/

theorem one_sub_mul_ge_KG {x t : ℝ} (hx : x ∈ KG) (ht : t ∈ Icc (0:ℝ) 1) :
    (2 / 3 : ℝ) ≤ 1 - t * x := by
  obtain ⟨hx0, hx1⟩ := hx
  obtain ⟨ht0, ht1⟩ := ht
  have htx : t * x ≤ 1 / 3 := by
    calc t * x ≤ 1 * (1 / 3) := mul_le_mul ht1 hx1 hx0 (by norm_num)
      _ = 1 / 3 := by ring
  linarith

theorem inv_KG {x t : ℝ} (hx : x ∈ KG) (ht : t ∈ Icc (0:ℝ) 1) :
    (1 - t * x)⁻¹ ≤ (3 / 2 : ℝ) ∧ 0 < 1 - t * x := by
  have hge := one_sub_mul_ge_KG hx ht
  have hpos : 0 < 1 - t * x := by linarith
  refine ⟨?_, hpos⟩
  rw [← one_div]
  exact (div_le_iff₀ hpos).mpr (by linarith)

/-! ## Integrating a pointwise bound -/

theorem abs_integral_le_of_le {f g : ℝ → ℝ} {C : ℝ}
    (hf : IntervalIntegrable f volume 0 1)
    (h : ∀ t ∈ Icc (0:ℝ) 1, |f t| ≤ g t)
    (hg : IntervalIntegrable g volume 0 1) (hC : (∫ t in (0:ℝ)..1, g t) ≤ C) :
    |∫ t in (0:ℝ)..1, f t| ≤ C := by
  have h1 : IntervalIntegrable (fun t : ℝ => |f t|) volume 0 1 := hf.abs
  have hmono : (∫ t in (0:ℝ)..1, |f t|) ≤ ∫ t in (0:ℝ)..1, g t :=
    intervalIntegral.integral_mono_on (μ := volume) (a := (0:ℝ)) (b := 1) (by norm_num)
      h1 hg h
  have hsplit : |∫ t in (0:ℝ)..1, f t| ≤ ∫ t in (0:ℝ)..1, |f t| := by
    have := intervalIntegral.abs_integral_le_integral_abs (μ := volume) (a := (0:ℝ)) (b := 1)
      (f := f) (by norm_num)
    simpa only [Real.norm_eq_abs] using this
  linarith

/-- `∫₀¹ (3/2) ≤ 3/2`. -/
theorem integral_const_le (C : ℝ) : (∫ _t in (0:ℝ)..1, C) ≤ C := by simp

/-- `∫₀¹ (9/4) t² dt ≤ 3/4`. -/
theorem integral_const_mul_sq_le : (∫ t in (0:ℝ)..1, (9 / 4 : ℝ) * t ^ 2) ≤ 3 / 4 := by
  rw [intervalIntegral.integral_const_mul, integral_pow]
  norm_num

/-! ## Integrability of the `J` integrands at a point of `UG` -/

theorem intervalIntegrable_J {k m : ℕ} {x : ℝ} (hx : x ∈ UG) :
    IntervalIntegrable (fun t : ℝ => t ^ k * (1 - t * x)⁻¹ ^ (m + 1)) volume 0 1 := by
  refine ContinuousOn.intervalIntegrable ?_
  rw [uIcc_of_le (by norm_num : (0:ℝ) ≤ 1)]
  refine (continuousOn_id.pow k).mul ?_
  refine ((continuousOn_const.sub (continuousOn_id.mul continuousOn_const)).inv₀ ?_).pow (m + 1)
  intro t ht
  show (1 : ℝ) - t * x ≠ 0
  have h := one_sub_mul_ge hx ht
  linarith

/-! ## The four profile bounds on `K` -/

theorem abs_Hc_le_K {x : ℝ} (hx : x ∈ KG) : |Hc x| ≤ 3 / 2 := by
  have hxU : x ∈ UG := KG_subset_UG hx
  have hint : IntervalIntegrable (fun t : ℝ => (1 - t * x)⁻¹) volume 0 1 := by
    simpa only [pow_zero, one_mul, zero_add, pow_one] using
      intervalIntegrable_J (k := 0) (m := 0) hxU
  rw [Hc_eq]
  refine abs_integral_le_of_le hint ?_ intervalIntegrable_const (integral_const_le _)
  intro t ht
  obtain ⟨hle, hpos⟩ := inv_KG hx ht
  rw [abs_of_pos (inv_pos.2 hpos)]
  exact hle

theorem abs_GcD_le_K {x : ℝ} (hx : x ∈ KG) : |GcD x| ≤ 3 / 4 := by
  have hxU : x ∈ UG := KG_subset_UG hx
  have hint : IntervalIntegrable (fun t : ℝ => t ^ 2 * (1 - t * x)⁻¹ ^ 2) volume 0 1 := by
    simpa only [] using intervalIntegrable_J (k := 2) (m := 1) hxU
  have hbound : IntervalIntegrable (fun t : ℝ => (9 / 4 : ℝ) * t ^ 2) volume 0 1 :=
    Continuous.intervalIntegrable (continuous_const.mul (continuous_id.pow 2)) 0 1
  rw [GcD_eq]
  refine abs_integral_le_of_le hint ?_ hbound integral_const_mul_sq_le
  intro t ht
  obtain ⟨ht0, ht1⟩ := ht
  obtain ⟨hle, hpos⟩ := inv_KG hx ⟨ht0, ht1⟩
  have hinv0 : 0 < (1 - t * x)⁻¹ := inv_pos.2 hpos
  rw [abs_mul, abs_of_nonneg (pow_nonneg ht0 2), abs_of_pos (pow_pos hinv0 2)]
  calc t ^ 2 * (1 - t * x)⁻¹ ^ 2 ≤ t ^ 2 * (3 / 2 : ℝ) ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (le_of_lt hinv0) hle 2) (pow_nonneg ht0 2)
    _ = (9 / 4) * t ^ 2 := by ring

/-! ## Elementary interval facts on `K` -/

theorem abs_four_add_three_le {x : ℝ} (hx : x ∈ KG) : |4 + 3 * x| ≤ 5 := by
