    HasDerivAt (fun ε => psi2 (g ε) (gi ε) (E ε) x) (weylFVar (g 0) (gi 0) h (E 0) B 0 2 3 1 x) 0 := by
  simp only [psi2_eq]; exact NPFamily.hasDerivAt_weylF hF ht hx 0 2 3 1

