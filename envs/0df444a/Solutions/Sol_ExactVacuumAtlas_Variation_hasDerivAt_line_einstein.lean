namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

section line

variable {U : Set (Pt n)} {g gi h : Metric n} {F f : TwoForm n}

theorem zero_mem_lineDom (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) {x : Pt n}
    (hx : x ∈ U) : ((0 : ℝ), x) ∈ lineDom U g h := by
  refine ⟨hx, ?_⟩
  have e : metricMatrix (lineMetric g h 0) x = metricMatrix g x := by
    ext i j; simp [lineMetric, metricMatrix]
  rw [e]
  exact Matrix.det_ne_zero_of_left_inverse (hinv x hx)

theorem isTangent_line : IsTangent (lineMetric g h) (lineMetric F f) (lineDom U g h) h f where
  metric y _ i j := by
    simpa [lineMetric] using ((hasDerivAt_id (0 : ℝ)).mul_const (h i j y)).const_add (g i j y)
  field y _ i j := by
    simpa [lineMetric] using ((hasDerivAt_id (0 : ℝ)).mul_const (f i j y)).const_add (F i j y)

theorem lineMetric_zero (g h : Metric n) : lineMetric g h 0 = g := by
  funext i j y; simp [lineMetric]

theorem lineInv_zero_eqOn (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) (i j : Fin n) :
    Set.EqOn (lineInv g h 0 i j) (gi i j) U := by
  intro y hy
  simp only [lineInv, lineMetric_zero]
  rw [Matrix.inv_eq_left_inv (hinv y hy)]
  rfl

end line

