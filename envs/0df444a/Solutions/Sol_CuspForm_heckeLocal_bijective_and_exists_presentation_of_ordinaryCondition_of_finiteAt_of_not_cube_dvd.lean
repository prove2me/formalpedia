    · exact WeierstrassCurve.ofResidualGaloisRep_residualGaloisRepOf_flatCondition_of_ne_two 𝒪' W p hp2 ι hgood hcard₁ hker hpS hSgood
    · by_cases hgood : W.IsGoodPrimeFor p
      · exact WeierstrassCurve.ofResidualGaloisRep_residualGaloisRepOf_flatCondition_of_ne_two 𝒪' W p hp2 ι hgood hcard₁ hker hpS hSgood
      · have h710o := WeierstrassCurve.ofResidualGaloisRep_residualGaloisRepOf_ordinaryCondition 𝒪' W p hp2 ι hΔ hW
