theorem qp_layer_top (hK : 0 < K) (hℓ : 1 ≤ ℓ) (hm : nLong D long = 0) (p : ℕ)
    (xs : List (Fin (2 ^ ℓ) → ℂ)) (hl : xs.length = 2 ^ NLogN.KFV.nB D ℓ K long) :
    QpArr p xs = layerQc p (paperSel D ℓ K long hK hℓ (ℓ - 1)) xs := by
  have hm' : (partAxes (al D ℓ long) (ℓ - 1)).card = 0 := by rw [card_part_top D ℓ long hℓ, hm]
  unfold layerQc
  congr 1
  have e : (tens H0 : Matrix ({i // i ∈ partAxes (al D ℓ long) (ℓ - 1)} → Fin 2)
      ({i // i ∈ partAxes (al D ℓ long) (ℓ - 1)} → Fin 2) ℂ) = 1 := by
    have : IsEmpty {i // i ∈ partAxes (al D ℓ long) (ℓ - 1)} := by
      rw [Finset.card_eq_zero] at hm'
      exact ⟨fun x => by have := x.2; simp [hm'] at this⟩
    ext x y
    have hxy : x = y := Subsingleton.elim _ _
    subst hxy
    simp [tens, tensF]
  rw [e]; exact (selOp_one _ (by rw [hl, GlueLayout.vol_binSh])).symm

