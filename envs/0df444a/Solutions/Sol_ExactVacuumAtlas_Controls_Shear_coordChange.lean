set_option maxHeartbeats 4000000
variable (lam : ℝ)
theorem solution : CoordChange domEF domEF (shear lam) (jacShear lam) (jacShearInv lam) where
  isOpen := isOpen_domEF
  isOpen_target := isOpen_domEF
  smooth := contDiffOn_shear lam
  mapsTo _ hx := shear_mem lam hx
  jacobian _ hx k i := hasDerivAt_pd_shear lam hx k i
  mul_inv x _ := jac_mul_jacInv lam x
