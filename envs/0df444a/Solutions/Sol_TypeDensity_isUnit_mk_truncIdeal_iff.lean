open TypeDensity

theorem solution (k : Type) [Field k] (a b L : ℕ) (ha : 0 < a) (hL : 0 < L)
    (F : TypeDensity.TwoSeries k) :
    IsUnit (Ideal.Quotient.mk (TypeDensity.truncIdeal k a b L) F) ↔ MvPowerSeries.constantCoeff F ≠ 0 := by
  constructor
  · intro h hF
    obtain ⟨y, hy⟩ := h.exists_right_inv
    obtain ⟨Y, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (TypeDensity.truncIdeal k a b L)), Ideal.Quotient.eq] at hy
    have := (TypeDensity.mem_axisIdeal_iff k _).mp (TypeDensity.truncIdeal_le_axisIdeal k a b L ha hL hy)
    simp [hF] at this
  · intro h
    exact (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h)).map _
