theorem mem_iff_apply_mem_of_mem_inertiaSubgroupIn (A : ValuationSubring Ω') {σ : Ω' ≃ₐ[K] Ω'}
    (hσ : σ ∈ A.inertiaSubgroupIn K) (x : Ω') : σ x ∈ A ↔ x ∈ A := by
  have h := smul_eq_of_mem_inertiaSubgroupIn A hσ
  constructor
  · intro hx
    have : σ x ∈ σ • A := by rw [h]; exact hx
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def] at this
    simpa using this
  · intro hx
    have : σ • x ∈ σ • A := ValuationSubring.smul_mem_pointwise_smul σ x A hx
    rw [h, AlgEquiv.smul_def] at this
    exact this

theorem mem_inertiaSubgroupIn_conj (θ : Ω' ≃ₐ[K] Ω)
    (A' : ValuationSubring Ω') {σ' : Ω' ≃ₐ[K] Ω'} (hσ' : σ' ∈ A'.inertiaSubgroupIn K) :
    θ.symm.trans (σ'.trans θ) ∈ (A'.comap (θ.symm : Ω →ₐ[K] Ω').toRingHom).inertiaSubgroupIn K := by
  set A : ValuationSubring Ω := A'.comap (θ.symm : Ω →ₐ[K] Ω').toRingHom with hA_def
  set σ : Ω ≃ₐ[K] Ω := θ.symm.trans (σ'.trans θ) with hσ_def
  have hσ : ∀ x, σ x = θ (σ' (θ.symm x)) := fun x => rfl
  have hA : ∀ x : Ω, x ∈ A ↔ θ.symm x ∈ A' := fun x => ValuationSubring.mem_comap
  have hσinv' : σ'⁻¹ ∈ A'.inertiaSubgroupIn K := inv_mem hσ'

  have hσinv : ∀ x, σ⁻¹ x = θ (σ'⁻¹ (θ.symm x)) := by
    intro x
    have h1 : σ (θ (σ'⁻¹ (θ.symm x))) = x := by
      rw [hσ]; simp [AlgEquiv.aut_inv]
    calc σ⁻¹ x = σ⁻¹ (σ (θ (σ'⁻¹ (θ.symm x)))) := by rw [h1]
      _ = θ (σ'⁻¹ (θ.symm x)) := by simp [AlgEquiv.aut_inv]

  have hstab : σ • A = A := by
    ext x
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def, hA, hA, hσinv,
      AlgEquiv.symm_apply_apply]
    exact mem_iff_apply_mem_of_mem_inertiaSubgroupIn A' hσinv' (θ.symm x)
  refine ValuationSubring.mem_inertiaSubgroupIn_of_valuation_sub_lt_one A hstab fun x hx => ?_

  rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]
  have hx' : θ.symm x ∈ A' := (hA x).mp hx
  obtain ⟨-, hlt⟩ := ValuationSubring.valuation_sub_lt_one_of_mem_inertiaSubgroupIn A' hσ' hx'
  rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or] at hlt
  have hdiff : θ.symm (σ x - x) = σ' (θ.symm x) - θ.symm x := by
    rw [map_sub, hσ, AlgEquiv.symm_apply_apply]
  rcases hlt with h0 | hninv
  · left
    have : θ.symm (σ x - x) = 0 := by rw [hdiff, h0]
    simpa using congrArg θ this
  · right
    rw [hA, map_inv₀, hdiff]
    exact hninv

end InertiaTransport

theorem mul_val_congr {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

end GoodReductionJacobian.RelativeGroupLaw.NOSExistenceFormH

