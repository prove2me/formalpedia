  obtain ⟨ψL, hψL⟩ := hψLex
  have hψLval : ∀ r : R, ((ψL r : ↥L') : AlgebraicClosure (FractionRing O')) = ψ r := by
    intro r
    rw [hψL, hψ']
    rfl
  have hT'L : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime), ¬ ℓ ∣ M₀ * q → ℓ ∉ S' →
