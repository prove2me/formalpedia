-- title:
--   Theorem 5.2.1 - the greedy algorithm and the Shapley value land in the core of a convex game
-- statement:
--   Suppose $(N,f)$ is a convex game. Then:
--   (a) for each permutation $\pi$ of the players $N$, the payoff vector $y^\pi$ generated by the
--   greedy algorithm is in the core;
--   (b) the core is nonempty;
--   (c) the Shapley value is in the core.
--
--   This is Theorem 5.2.1 (p. 211-212), from Shapley [1971], the goal of this mission: it shows that
--   the two constructions of Section 5.1 — the greedy algorithm and the Shapley value — always produce
--   a stable payoff vector for a convex game, and in particular that a convex game's core (a set cut
--   out by $2^n$ linear inequalities and one linear equality) is always nonempty.
--
--   **Formalization note.** Part (a)'s conclusion is stated with the full acceptability condition
--   (every subset $S \subseteq N$, not merely singletons or a sample of subsets); part (c) states the
--   Shapley value exactly as `ShapleyValue f`, with no intermediate averaging convention.
-- source:
--   Topkis, Supermodularity and Complementarity, Princeton University Press, 2011, p. 211-212, Theorem 5.2.1

import Mathlib
import Definitions.Def_Supermodularity_Cooperative_IsConvexGame
import Definitions.Def_Supermodularity_Cooperative_Core
import Definitions.Def_Supermodularity_Cooperative_GreedyPayoff
import Definitions.Def_Supermodularity_Cooperative_ShapleyValue

namespace Supermodularity.Cooperative

theorem convex_game_core_and_shapley {n : ℕ} (f : Finset (Fin n) → ℝ)
    (hf : IsConvexGame f) :
    (∀ σ : Equiv.Perm (Fin n), GreedyPayoff σ f ∈ Core Finset.univ f) ∧
    (Core Finset.univ f).Nonempty ∧
    ShapleyValue f ∈ Core Finset.univ f := by sorry

end Supermodularity.Cooperative
