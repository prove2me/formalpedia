import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.Finite.Prod
import Mathlib.Data.Real.Basic
import Definitions.Def_agt_games
import Definitions.Def_Aumann1987_BayesRational_CorrelatedEquilibrium
import Definitions.Def_Aumann1987_BayesRational_InformationSystem
import Theorems.Thm_Aumann1987_BayesRational_sum_over_partition

open Finset

open Aumann1987.BayesRational in
theorem solution {ι : Type*} [Fintype ι] [DecidableEq ι] {S : ι → Type*}
    {Γ : Type*} [Fintype Γ] (h : ι → (∀ i, S i) → ℝ) (q : Γ → ℝ) (hq : AGT.IsLottery q)
    (f : Γ → ∀ i, S i) :
    (∀ (i : ι) (γ : Γ),
        IsBayesRationalAt h q (fun j => Setoid.ker (fun γ' => f γ' j)) f i γ) ↔
      IsCorrelatedEquilibrium h q f := by
  classical
  constructor
  · -- (2.2) restated as Bayes rationality in the kernel partition
    intro hrat i φ
    -- the information system carried by `(Γ, q)` with the partitions generated by the `fⁱ`
    have hmeas : ∀ (j : ι) (γ γ' : Γ), (Setoid.ker (fun x => f x j)).r γ γ' → f γ j = f γ' j :=
      fun _ _ _ hr => hr
    let I : InformationSystem Γ S :=
      { p := q, isProb := hq, P := fun j => Setoid.ker (fun γ' => f γ' j),
        s := f, measurable := fun j γ γ' hr => hr }
    have hdev : deviate I.s i (fun ω => φ (f ω i))
        = deviate f i (fun ω => φ (f ω i)) := rfl
    have hkey := sum_over_partition h I i (hrat i) (fun ω => φ (f ω i))
      (fun ω ω' hr => congrArg φ hr)
    exact hkey
  · -- Bayes rationality follows from (2.2) restricted to single information sets
    intro hce i γ a
    simp only [condExp, Setoid.ker_def]
    by_cases hm : ∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i), q γ' = 0
    · -- null cell: both conditional expectations vanish
      have hvanish : ∀ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i), q γ' = 0 :=
        fun γ' hγ' =>
          (Finset.sum_eq_zero_iff_of_nonneg (fun γ'' _ => hq.1 γ'')).mp hm γ' hγ'
      have n1 : (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
          q γ' * h i (Function.update (f γ') i a)) = 0 :=
        Finset.sum_eq_zero fun γ' hγ' => by rw [hvanish γ' hγ']; ring
      have n2 : (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
          q γ' * h i (f γ')) = 0 :=
        Finset.sum_eq_zero fun γ' hγ' => by rw [hvanish γ' hγ']; ring
      rw [n1, n2]
    · have hpos : 0 < ∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i), q γ' :=
        lt_of_le_of_ne (Finset.sum_nonneg fun γ' _ => hq.1 γ') (fun hcon => hm hcon.symm)
      -- test (2.2) on the recoding that changes only the action `fⁱ(γ)` to `a`
      have key := hce i (fun x => if x = f γ i then a else x)
      simp only [expPayoff, deviate] at key
      -- on the cell the recoding plays `a`; off the cell it is the identity
      have hsplitL : ∑ γ', q γ' * h i (Function.update (f γ') i
            (if f γ' i = f γ i then a else f γ' i))
          = (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
                q γ' * h i (Function.update (f γ') i a))
            + ∑ γ' ∈ Finset.univ.filter (fun x => ¬ f γ i = f x i),
                q γ' * h i (f γ') := by
        rw [← Finset.sum_filter_add_sum_filter_not (s := (Finset.univ : Finset Γ))
          (p := fun x => f γ i = f x i)
          (f := fun γ' => q γ' * h i (Function.update (f γ') i
            (if f γ' i = f γ i then a else f γ' i)))]
        refine congrArg₂ (· + ·) ?_ ?_
        · refine Finset.sum_congr rfl fun γ' hγ' => ?_
          simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hγ'
          rw [if_pos hγ'.symm]
        · refine Finset.sum_congr rfl fun γ' hγ' => ?_
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_true_eq_false,
            not_and] at hγ'
          rw [if_neg (fun hh => hγ' hh.symm)]
          simp
      have hsplitR : ∑ γ', q γ' * h i (f γ')
          = (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
                q γ' * h i (f γ'))
            + ∑ γ' ∈ Finset.univ.filter (fun x => ¬ f γ i = f x i),
                q γ' * h i (f γ') :=
        (Finset.sum_filter_add_sum_filter_not (s := (Finset.univ : Finset Γ))
          (p := fun x => f γ i = f x i)
          (f := fun γ' => q γ' * h i (f γ'))).symm
      rw [hsplitL, hsplitR] at key
      -- cancel the common complement and divide by the cell mass
      have hnum : (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
              q γ' * h i (Function.update (f γ') i a))
          ≤ (∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i),
                q γ' * h i (f γ')) := by linarith
      exact (div_le_div_iff_of_pos_right
        (c := ∑ γ' ∈ Finset.univ.filter (fun x => f γ i = f x i), q γ') hpos).mpr hnum
