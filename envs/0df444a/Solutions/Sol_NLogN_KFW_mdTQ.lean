      obtain ⟨oa, ba, ea⟩ := good hM a (fun i hi => hh i (by simp [NLogN.KIL.NE.regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good hM b (fun i hi => hh i (by simp [NLogN.KIL.NE.regs, hi])) hok.2.1
