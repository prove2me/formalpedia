-- title:
--   Theorem 3.1, p. 10 — with ∇f (resp. ∇g) (1/β)-Lipschitz, min_{i≤k} of the objective error at x_g^i (resp. x_f^i) is o(1/(k+1))
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, $f, g : \mathcal H \to (-\infty,\infty]$ closed, proper and convex, $\gamma > 0$, and let $(z^k)_{k\ge0}$ be generated by relaxed PRS (Algorithm 1) with relaxation parameters $(\lambda_j)_{j\ge0} \subset (0,1]$. Let $z^*$ be a fixed point of $T_{\mathrm{PRS}}$ and $x^* = \mathbf{prox}_{\gamma g}(z^*)$. Suppose that
--   $$\underline\tau = \inf_{j\ge0}\lambda_j(1 - \lambda_j) > 0.$$
--   Let $\beta > 0$.
--   1. If $\nabla f$ is $(1/\beta)$-Lipschitz and $x^k = x_g^k = \mathbf{prox}_{\gamma g}(z^k)$, then
--   $$\min_{i = 0, \dots, k}\big\{f(x^i) + g(x^i) - f(x^*) - g(x^*)\big\} = o\Big(\frac{1}{k+1}\Big).$$
--   2. If $\nabla g$ is $(1/\beta)$-Lipschitz and $x^k = x_f^k = \mathbf{prox}_{\gamma f}(\mathbf{refl}_{\gamma g}(z^k))$, the same conclusion holds.
--
--   The theorem says that relaxed PRS, with any stepsize $\gamma > 0$, achieves a best-iterate objective error of order $o(1/(k+1))$ as soon as one of the two functions is smooth, in contrast to forward–backward splitting, which needs $\gamma < 2\beta$.
--
--   **Formalization Note** "$\underline\tau > 0$" is encoded by a positive lower bound $\tau$ with $\tau \le \lambda_j(1-\lambda_j)$ for all $j$, which is equivalent. It forces $\lambda_j < 1$ and $\lambda_j \ge \underline\tau > 0$, so the page's $\underline\lambda = \inf_j \lambda_j$ is automatically positive and needs no binder. The page's opening "Let $z \in \mathcal H$" is a stray phrase and is dropped. "Respectively" is two conjuncts, each under its own Lipschitz hypothesis. The objective error is a real number; every value involved is finite (prox outputs, or the real-valued smooth function), see the Setting.
-- source:
--   Davis & Yin, Faster convergence rates of relaxed Peaceman-Rachford and ADMM under regularity assumptions, arXiv:1407.5210v3, p. 10, Theorem 3.1 (proof pp. 10–11)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_MoreauProx_Characterization_GammaZero
import Definitions.Def_RelaxedPRS_BestIter_Setting
open ThreeOpSplitting.ConvexRates MoreauProx.Characterization Filter

namespace RelaxedPRS.BestIter

theorem theorem_3_1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f g : H → EReal) (hf : IsProperClosedConvex f) (hg : IsProperClosedConvex g)
    (γ : ℝ) (hγ : 0 < γ) (Pf Pg : H → H) (hPf : IsProx γ f Pf) (hPg : IsProx γ g Pg)
    (lam : ℕ → ℝ) (hlam : ∀ k, 0 < lam k ∧ lam k ≤ 1)
    (z : ℕ → H) (hz : RelaxedPRS.StrongCvx.IsPRSRun Pf Pg lam z) (zs : H) (hzs : RelaxedPRS.StrongCvx.TPRS Pf Pg zs = zs)
    (τ : ℝ) (hτ : 0 < τ) (hτle : ∀ j, τ ≤ lam j * (1 - lam j))
    (β : ℝ) (hβ : 0 < β) :
    (RelaxedPRS.StrongCvx.HasLipGrad β f →
      (fun k : ℕ => (Finset.range (k + 1)).inf' Finset.nonempty_range_add_one
          (fun i => objErr f g (xg Pg zs) (xg Pg (z i))))
        =o[atTop] (fun k : ℕ => 1 / ((k : ℝ) + 1))) ∧
    (RelaxedPRS.StrongCvx.HasLipGrad β g →
      (fun k : ℕ => (Finset.range (k + 1)).inf' Finset.nonempty_range_add_one
          (fun i => objErr f g (xg Pg zs) (RelaxedPRS.StrongCvx.xf Pf Pg (z i))))
        =o[atTop] (fun k : ℕ => 1 / ((k : ℝ) + 1))) := by sorry

end RelaxedPRS.BestIter
