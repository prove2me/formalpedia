open Finset

theorem sum_shift (f : ℕ → ℕ) (m : ℕ) :
    ∑ e ∈ range (m + 1), f e * 8192 ^ e = f 0 + 8192 * ∑ e ∈ range m, f (e + 1) * 8192 ^ e := by
  rw [Finset.sum_range_succ', Finset.mul_sum, add_comm]
  congr 1
  · simp
  · refine Finset.sum_congr rfl fun k _ => ?_
    ring

theorem digit_sum (s : ℕ) : ∀ (f : ℕ → ℕ) (m : ℕ), (∀ e, f e < 8192) → s < m →
    (∑ e ∈ range m, f e * 8192 ^ e) / 8192 ^ s % 8192 = f s := by
  induction s with
  | zero =>
    intro f m hf hs
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    rw [sum_shift, pow_zero, Nat.div_one, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hf 0)]
  | succ s ih =>
    intro f m hf hs
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    rw [sum_shift, pow_succ', ← Nat.div_div_eq_div_mul, Nat.add_mul_div_left _ _ (by norm_num),
      Nat.div_eq_of_lt (hf 0), zero_add]
    exact ih (fun e => f (e + 1)) m (fun e => hf _) (by omega)

theorem base_expand (m : ℕ) : ∀ n : ℕ, n < 8192 ^ m →
    n = ∑ e ∈ range m, (n / 8192 ^ e % 8192) * 8192 ^ e := by
  induction m with
  | zero => intro n h; simpa using h
  | succ m ih =>
    intro n h
    rw [sum_shift]
    have h2 : n / 8192 < 8192 ^ m := by
      apply Nat.div_lt_of_lt_mul; rwa [pow_succ'] at h
    have h3 := ih (n / 8192) h2
    have h4 : ∑ e ∈ range m, (n / 8192 ^ (e + 1) % 8192) * 8192 ^ e = n / 8192 := by
      conv_rhs => rw [h3]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [pow_succ', Nat.div_div_eq_div_mul]
    rw [h4, pow_zero, Nat.div_one]
    omega

theorem COMB_eq : COMB = ∑ e ∈ range 6806, 1 * 8192 ^ e := by
