set_option autoImplicit false

namespace Grunbaum2003


private theorem face_vertex_cut_crossing {d : ℕ}
    (G : Set (Fin d → ℝ)) (hG : Convex ℝ G)
    (v w : Fin d → ℝ) (hv : v ∈ G) (hw : w ∈ G)
    (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ)
    (hα : α < l v) (hwBelow : l w < α) :
    ∃ t : ℝ, t ≠ 0 ∧
      AffineMap.lineMap v w t ∈ G ∩ l ⁻¹' {α} ∧
      AffineMap.lineMap v (AffineMap.lineMap v w t) t⁻¹ = w := by
  let t : ℝ := (l v - α) / (l v - l w)
  have hDen : 0 < l v - l w := sub_pos.mpr (hwBelow.trans hα)
  have ht₀ : 0 < t := div_pos (sub_pos.mpr hα) hDen
  have ht₁ : t < 1 := (div_lt_one hDen).mpr (by linarith only [hwBelow])
  have htMul : t * (l v - l w) = l v - α := div_mul_cancel₀ _ hDen.ne'
  have hLevel : l (AffineMap.lineMap v w t) = α := by
    rw [AffineMap.lineMap_apply_module', map_add, map_smul, map_sub, smul_eq_mul]
    nlinarith only [htMul]
  refine ⟨t, ht₀.ne', ⟨hG.lineMap_mem hv hw ⟨ht₀.le, ht₁.le⟩, hLevel⟩, ?_⟩
  rw [AffineMap.lineMap_lineMap_right, inv_mul_cancel₀ ht₀.ne',
    AffineMap.lineMap_apply_one]

/-- The affine span of an actual face through the cut apex is generated by
that apex and the actual cutting section of the face. This follows from the
accepted face-hull theorem and the explicit nonzero crossing parameters;
there is no face-dimension premise. -/
theorem affineSpan_vertex_figure_face_insert {d : ℕ}
    (P : Set (Fin d → ℝ)) (hP : IsDPolytope P)
    (v : Fin d → ℝ) (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ)
    (hα : α < l v)
    (hBelow : ∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v → l w < α)
    (G : Set (Fin d → ℝ)) (hG : IsExposed ℝ P G) (hv : v ∈ G) :
    affineSpan ℝ (insert v (G ∩ l ⁻¹' {α})) = affineSpan ℝ G := by
  classical
  let R := G ∩ l ⁻¹' {α}
  let S := affineSpan ℝ (insert v R)
  have hvS : v ∈ S := subset_affineSpan ℝ _ (Set.mem_insert _ _)
  have hPconv : Convex ℝ P := by
    obtain ⟨V, _, _, hPV⟩ := hP.1
    rw [hPV]
    exact convex_convexHull ℝ V
  have hGconv : Convex ℝ G := hG.convex hPconv
  have hHull := (polytope_face_eq_convexHull_exposed_vertices d P hP).2 ⟨G, hG⟩
  change G = convexHull ℝ (G ∩ {x : Fin d → ℝ | IsExposed ℝ P {x}}) at hHull
  apply le_antisymm
  · exact affineSpan_mono ℝ (Set.insert_subset_iff.mpr ⟨hv, Set.inter_subset_left⟩)
  · apply affineSpan_le_of_subset_coe
    change G ⊆ S
    rw [hHull]
    apply convexHull_min ?_ S.convex
    rintro w ⟨hwG, hwVertex⟩
    change w ∈ S
    by_cases hwv : w = v
    · subst w
      exact hvS
    · obtain ⟨t, _, hq, hRecover⟩ := face_vertex_cut_crossing G hGconv v w hv hwG
        l α hα (hBelow w hwVertex hwv)
      have hqS : AffineMap.lineMap v w t ∈ S :=
        subset_affineSpan ℝ _ (Set.mem_insert_of_mem _ hq)
      have hwS := AffineMap.lineMap_mem t⁻¹ hvS hqS
      rw [hRecover] at hwS
      exact hwS

/-- In the actual cut, precisely the apex singleton has empty section among
the original exposed faces containing the apex. -/
theorem vertex_figure_face_section_nonempty_iff {d : ℕ}
    (P : Set (Fin d → ℝ)) (hP : IsDPolytope P)
    (v : Fin d → ℝ) (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ)
    (hα : α < l v)
    (hBelow : ∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v → l w < α)
    (G : Set (Fin d → ℝ)) (hG : IsExposed ℝ P G) (hv : v ∈ G) :
    (G ∩ l ⁻¹' {α}).Nonempty ↔ G ≠ {v} := by
  constructor
  · rintro ⟨x, hxG, hxLevel⟩ hEq
    have hxv : x = v := by simpa only [hEq, Set.mem_singleton_iff] using hxG
    subst x
    exact hα.ne hxLevel.symm
  · intro hNot
    by_contra hEmpty
    have hR : G ∩ l ⁻¹' {α} = ∅ := Set.not_nonempty_iff_eq_empty.mp hEmpty
    have hSpan := affineSpan_vertex_figure_face_insert P hP v l α hα hBelow G hG hv
    have hSub : G ⊆ {v} := by
      intro x hx
      have hxSpan := subset_affineSpan ℝ G hx
      rw [← hSpan, hR, insert_empty_eq] at hxSpan
      exact (AffineSubspace.mem_affineSpan_singleton ℝ (Fin d → ℝ)).mp hxSpan
    exact hNot (Set.Subset.antisymm hSub (Set.singleton_subset_iff.mpr hv))

/-- Every actual nonempty vertex-figure face has affine dimension one less
than the original exposed face through the apex. Both dimensions are
computed from the original native carriers. -/
theorem vertex_figure_face_finrank_add_one {d : ℕ}
    (P : Set (Fin d → ℝ)) (hP : IsDPolytope P)
    (v : Fin d → ℝ) (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ)
    (hα : α < l v)
    (hBelow : ∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v → l w < α)
    (G : Set (Fin d → ℝ)) (hG : IsExposed ℝ P G) (hv : v ∈ G)
    (hNonapex : G ≠ {v}) :
    (G ∩ l ⁻¹' {α}).Nonempty ∧
      Module.finrank ℝ (affineSpan ℝ G).direction =
        Module.finrank ℝ (affineSpan ℝ (G ∩ l ⁻¹' {α})).direction + 1 := by
  have hR := (vertex_figure_face_section_nonempty_iff P hP v l α hα hBelow G hG hv).mpr
    hNonapex
  refine ⟨hR, ?_⟩
  let R := G ∩ l ⁻¹' {α}
  let A := affineSpan ℝ R
  obtain ⟨r₀, hr₀⟩ := hR
  have hr₀A : r₀ ∈ A := subset_affineSpan ℝ R hr₀
  have hDir : A.direction ≤ LinearMap.ker l.toLinearMap := by
    change (affineSpan ℝ R).direction ≤ LinearMap.ker l.toLinearMap
    rw [direction_affineSpan, vectorSpan_def, Submodule.span_le]
    rintro z ⟨x, hx, y, hy, rfl⟩
    change l (x - y) = 0
    rw [map_sub, hx.2, hy.2, sub_self]
  have hTransverse : v -ᵥ r₀ ∉ A.direction := by
    intro hMem
    have hz := hDir hMem
    change l (v - r₀) = 0 at hz
    rw [map_sub, hr₀.2] at hz
    exact (sub_pos.mpr hα).ne' hz
  have hSpan := affineSpan_vertex_figure_face_insert P hP v l α hα hBelow G hG hv
  calc
    Module.finrank ℝ (affineSpan ℝ G).direction =
        Module.finrank ℝ (affineSpan ℝ (insert v R)).direction := by rw [hSpan]
    _ = Module.finrank ℝ
        (Submodule.span ℝ {v -ᵥ r₀} ⊔ A.direction : Submodule ℝ (Fin d → ℝ)) := by
      rw [← affineSpan_insert_affineSpan, AffineSubspace.direction_affineSpan_insert hr₀A]
    _ = Module.finrank ℝ A.direction + 1 := by
      rw [sup_comm]
      exact Submodule.finrank_sup_span_singleton hTransverse

/-- Cutoff data at any PRESCRIBED exposed vertex. The finite-maximum and
crossing construction is extracted from the accepted boundary proof, with
the initial existential choice replaced by the supplied original vertex. -/
theorem exists_vertex_cut_level_at_exposed_vertex (d : ℕ)
    (P : Set (Fin d → ℝ)) (hP : IsDPolytope P)
    (v : Fin d → ℝ) (hv : IsExposed ℝ P {v}) :
    ∃ (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ),
      α < l v ∧ (∀ x ∈ P, l x ≤ l v) ∧
      ∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v →
        l w < α ∧ ∃ t : ℝ, 0 < t ∧ t < 1 ∧ l (AffineMap.lineMap v w t) = α := by
  classical
  obtain ⟨hVfin, _⟩ := polytope_face_eq_convexHull_exposed_vertices d P hP
  obtain ⟨_, l, hl⟩ := mem_exposedPoints_iff_exposed_singleton.mpr hv
  let V' := {x : Fin d → ℝ | IsExposed ℝ P {x}} \ {v}
  have hV'fin : V'.Finite := hVfin.sdiff
  have hStrict (w : Fin d → ℝ) (hw : w ∈ V') : l w < l v := by
    have hwP : w ∈ P := (mem_exposedPoints_iff_exposed_singleton.mpr hw.1).1
    apply lt_of_le_of_ne (hl w hwP).1
    intro heq
    exact hw.2 ((hl w hwP).2 heq.ge)
  obtain ⟨α, hα, hBelow⟩ : ∃ α : ℝ, α < l v ∧ ∀ w ∈ V', l w < α := by
    by_cases hV'ne : V'.Nonempty
    · obtain ⟨w, hw, hMax⟩ := Set.exists_max_image V' l hV'fin hV'ne
      refine ⟨(l w + l v) / 2, ?_, ?_⟩
      · linarith [hStrict w hw]
      · intro u hu
        linarith [hMax u hu, hStrict w hw]
    · refine ⟨l v - 1, by linarith, ?_⟩
      intro w hw
      exact (hV'ne ⟨w, hw⟩).elim
  refine ⟨l, α, hα, fun x hx => (hl x hx).1, ?_⟩
  intro w hw hwv
  have hwα : l w < α := hBelow w ⟨hw, hwv⟩
  refine ⟨hwα, ?_⟩
  let t : ℝ := (l v - α) / (l v - l w)
  have hDen : 0 < l v - l w := sub_pos.mpr (hwα.trans hα)
  have htPos : 0 < t := div_pos (sub_pos.mpr hα) hDen
  have htOne : t < 1 := (div_lt_one hDen).mpr (by linarith)
  refine ⟨t, htPos, htOne, ?_⟩
  have htMul : t * (l v - l w) = l v - α := div_mul_cancel₀ _ hDen.ne'
  rw [AffineMap.lineMap_apply_module', map_add, map_smul, map_sub, smul_eq_mul]
  nlinarith [htMul]


theorem vertex_figure_face_finrank_and_prescribed_cut (d : ℕ)
    (P : Set (Fin d → ℝ)) (hP : IsDPolytope P) :
    (∀ v : Fin d → ℝ, IsExposed ℝ P {v} →
      ∃ (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ),
        α < l v ∧ (∀ x ∈ P, l x ≤ l v) ∧
        ∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v →
          l w < α ∧ ∃ t : ℝ, 0 < t ∧ t < 1 ∧ l (AffineMap.lineMap v w t) = α) ∧
    (∀ (v : Fin d → ℝ) (l : StrongDual ℝ (Fin d → ℝ)) (α : ℝ),
      α < l v →
      (∀ w : Fin d → ℝ, IsExposed ℝ P {w} → w ≠ v → l w < α) →
      ∀ (G : Set (Fin d → ℝ)), IsExposed ℝ P G → v ∈ G →
        affineSpan ℝ (insert v (G ∩ l ⁻¹' {α})) = affineSpan ℝ G ∧
        ((G ∩ l ⁻¹' {α}).Nonempty ↔ G ≠ {v}) ∧
        (G ≠ {v} →
          (G ∩ l ⁻¹' {α}).Nonempty ∧
            Module.finrank ℝ (affineSpan ℝ G).direction =
              Module.finrank ℝ (affineSpan ℝ (G ∩ l ⁻¹' {α})).direction + 1)) := by
  refine ⟨fun v hv => exists_vertex_cut_level_at_exposed_vertex d P hP v hv, ?_⟩
  intro v l α hα hBelow G hG hv
  exact ⟨affineSpan_vertex_figure_face_insert P hP v l α hα hBelow G hG hv,
    vertex_figure_face_section_nonempty_iff P hP v l α hα hBelow G hG hv,
    vertex_figure_face_finrank_add_one P hP v l α hα hBelow G hG hv⟩

end Grunbaum2003

