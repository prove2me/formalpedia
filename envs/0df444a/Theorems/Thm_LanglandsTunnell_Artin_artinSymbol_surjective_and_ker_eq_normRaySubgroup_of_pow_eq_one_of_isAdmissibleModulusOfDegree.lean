theorem LanglandsTunnell.Artin.artinSymbol_surjective_and_ker_eq_normRaySubgroup_of_pow_eq_one_of_isAdmissibleModulusOfDegree
    (K : Type u) (L : Type v) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [IsGalois K L] [IsMulCommutative (L ≃ₐ[K] L)]
    (n : ℕ) (hn : n ≠ 0) (hexp : ∀ x : L ≃ₐ[K] L, x ^ n = 1)
    (𝔣 : Ideal (𝓞 K)) (hadm : IsAdmissibleModulusOfDegree K L n 𝔣) :
    Function.Surjective (artinSymbol K L 𝔣) ∧ (artinSymbol K L 𝔣).ker = normRaySubgroup K L 𝔣 := by sorry
