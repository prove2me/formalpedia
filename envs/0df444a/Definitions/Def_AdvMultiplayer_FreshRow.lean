-- title:
--   The fresh-row model and its histories
-- statement:
--   In the fresh-row model the rounded rewards and the identification array are fixed first, the rows are sampled independently, and $J$ is uniform. The sample space is the rows with the private tapes. The module defines the reference execution on this space, the filtration of pre-round histories, the histories $\mathcal G_t^\pm$ of p.36, the launch round $\tau_L$, the agreement of bootstrap registers, a forward failure (some $v\ne J$ passing the prefix test (66) on the reference observations), and the memory counts of Prop. 23.
--
--   **Formalization Note.** $\mathcal G_t^-$ is generated by the row coordinates inspected before the sampler, the private draws and the raw arrivals; the registers, actions and observations are functions of these because the rewards are fixed.
-- source:
--   Gan, Square-Root Regret for Adversarial Multiplayer Bandits without Collision Information or Shared Randomness, arXiv:2610.05688, Sections 2.5, 4 (p.20); p.36; Section 6.2; Prop. 23

import Mathlib
import Definitions.Def_AdvMultiplayer_DecoderFailure

open MeasureTheory

namespace AdvMultiplayer

variable (p : Size)

/-- The sample space of the fresh-row model: the complete rows and the private tapes. -/
abbrev FreshΩ := Rows p × Tapes p

/-- **The fresh-row law** (Sections 2.5, 4; p.20). Gan, arXiv:2610.05688: the rounded rewards and the ID
array are fixed first, the rows are sampled independently, and the private tapes are independent of
them. `J` is read from the coordinator's tape, so it is uniform on `[M]`. -/
noncomputable def freshLaw : Measure (FreshΩ p) := (rowsLaw p).prod (tapeLaw p)

/-- The index of the first round in `Fin T`. -/
def firstRound : Fin p.T := ⟨0, by have := p.one_le_T; omega⟩

/-- The row index `J = 1 + ⌊MV⌋` drawn by the coordinator. -/
noncomputable def jOf (ω : Tapes p) : ℕ :=
  1 + ⌊(p.M : ℝ) * ω (coordinator p) (firstRound p) 2⌋₊

/-- The fresh-row reference execution with `J = j`, on the data `(ID array, rows)`. -/
noncomputable def refTrace (idA : IdArray p) (r : Rewards p) (j : ℕ) (x : FreshΩ p) : Trace p :=
  roundAt p (idA, x.1) ⟨some j, true⟩ r x.2

/-- The fresh-row reference execution with `J` drawn from the tape. -/
noncomputable def freshTrace (idA : IdArray p) (r : Rewards p) (x : FreshΩ p) : Trace p :=
  refTrace p idA r (jOf p x.2) x

/-- The execution of Algorithm 7 with the same rows and private randomness and `J = j` (Prop. 22(i)). -/
noncomputable def actualTrace (idA : IdArray p) (r : Rewards p) (j : ℕ) (x : FreshΩ p) : Trace p :=
  roundAt p (idA, x.1) ⟨some j, false⟩ r x.2

/-- The execution of the strategy on the table `d`, with `J` drawn from the tape. -/
noncomputable abbrev playRun (d : TableData p) (r : Rewards p) (ω : Tapes p) : Trace p :=
  roundAt p d ⟨some (jOf p ω), false⟩ r ω

/-- The reference execution on the table `d`, with `J` drawn from the tape. -/
noncomputable abbrev refRun (d : TableData p) (r : Rewards p) (ω : Tapes p) : Trace p :=
  roundAt p d ⟨some (jOf p ω), true⟩ r ω

/-- A scalar label of an assignment coordinate. -/
def isAssign (c : Coord p) : Bool :=
  match c with
  | .inr (.inr (.inr _)) => true
  | _ => false

/-- Keep the coordinates of `x` selected by the masks (time index `s` is round `s+1`), and overwrite
the rest with defaults. -/
def maskRows (mf : Fin p.M → Fin p.A → Fin p.T → Bool) (ms : Fin p.M → Fin p.T → Coord p → Bool)
    (ma : Fin p.M → Fin p.T → Bool → Fin p.d → Bool) (x : Rows p) : Rows p :=
  (fun q u s => if mf q u s then x.1 q u s else false,
   fun q s c => if ms q s c then x.2.1 q s c else 0,
   fun q s e i => if ma q s e i then x.2.2 q s e i else (fun _ => false, false))

open Classical in
/-- Keep the tape coordinates of rounds before `t`, and the coordinator's draw of `J`. -/
noncomputable def maskTapes (t : ℕ) (ω : Tapes p) : Tapes p := by
  classical exact fun i s k =>
    if s.val + 1 < t ∨ (i = coordinator p ∧ s = firstRound p ∧ k = 2) then ω i s k else 0

/-- The information in the pre-round history `ℱ_t`: `J`, every row coordinate with calendar index
below `t`, the assignment coordinates of round `t`, and the private draws of the earlier rounds. -/
noncomputable def cutPre (t : ℕ) (x : FreshΩ p) : FreshΩ p :=
  (maskRows p (fun _ _ s => decide (s.val + 1 < t))
      (fun _ s c => decide (s.val + 1 < t) || (decide (s.val + 1 = t) && isAssign p c))
      (fun _ s _ _ => decide (s.val + 1 < t)) x.1,
    maskTapes p t x.2)

/-- The filtration generated by an increasing family of pieces of information. The meet with the
ambient σ-algebra does nothing on measurable maps. -/
noncomputable def filtrationOf {Ω E : Type*} [m0 : MeasurableSpace Ω] [mE : MeasurableSpace E]
    (cut : ℕ → Ω → E) : Filtration ℕ m0 where
  seq t := (⨆ s ∈ Set.Iic t, MeasurableSpace.comap (cut s) mE) ⊓ m0
  mono' := fun _ _ h => inf_le_inf_right _ (biSup_mono fun _ hs => le_trans hs h)
  le' := fun _ => inf_le_right

/-- **The filtration `(ℱ_t)` of pre-round histories** in the fresh-row model (pp.14, 37): at round `t`
it contains all coordinates exposed before step (b) of Lemma 19's construction, including the
assignment coordinates of round `t`, on which an assignment start's slow set depends. -/
noncomputable def preRound : Filtration ℕ (inferInstance : MeasurableSpace (FreshΩ p)) :=
  filtrationOf (cutPre p)

/-- The history of the selected row and the private draws exposed before round `t` (Prop. 22(iii)). -/
noncomputable def cutSel (j t : ℕ) (x : FreshΩ p) : FreshΩ p :=
  (maskRows p (fun q _ s => decide (q.val + 1 = j) && decide (s.val + 1 < t))
      (fun q s _ => decide (q.val + 1 = j) && decide (s.val + 1 < t))
      (fun q s _ _ => decide (q.val + 1 = j) && decide (s.val + 1 < t)) x.1,
    maskTapes p t x.2)

/-- The filtration of the selected-row and private history (Prop. 22(iii)). -/
noncomputable def selHistory (j : ℕ) : Filtration ℕ (inferInstance : MeasurableSpace (FreshΩ p)) :=
  filtrationOf (cutSel p j)

/-- The unexposed coordinates of the selected row from round `t` on (Prop. 22(iii)). -/
noncomputable def futureSel (j t : ℕ) (x : FreshΩ p) : Rows p :=
  maskRows p (fun q _ s => decide (q.val + 1 = j) && decide (t ≤ s.val + 1))
    (fun q s _ => decide (q.val + 1 = j) && decide (t ≤ s.val + 1))
    (fun q s _ _ => decide (q.val + 1 = j) && decide (t ≤ s.val + 1)) x.1

/-- The history `G_t^+` of p.36 as a σ-algebra: every row coordinate with calendar index below `t`,
all private draws before `t`, and hence everything in `G_t^-`. -/
@[reducible] noncomputable def Gplus (t : ℕ) : MeasurableSpace (FreshΩ p) :=
  MeasurableSpace.comap
    (fun x : FreshΩ p => (maskRows p (fun _ _ s => decide (s.val + 1 < t))
      (fun _ s _ => decide (s.val + 1 < t)) (fun _ s _ _ => decide (s.val + 1 < t)) x.1,
      maskTapes p t x.2)) inferInstance

open Classical in
/-- The row coordinates inspected at round `s+1` of the reference execution `X`, with `q` the selected
row: the slot always; the recorder source, pilots and thinning coordinate on DATA; the selected
follower, tuple and selected affine map on DOWN and UP; the fast coordinate on a fast draw; the
proposal coordinate on live rounds; the assignment coordinates at an assignment start. -/
noncomputable def inspectedScalar (d : TableData p) (X : Trace p) (q : Fin p.M) (s : Fin p.T)
    (c : Coord p) : Bool :=
    let t := s.val + 1
    decide (q.val + 1 = rowAt p X t) &&
      (match c with
        | .inl l =>
          if l = 0 then true
          else if l = 1 then decide (slotAt p d X t ≠ Slot.data)
          else if l = 2 then decide (slotAt p d X t = Slot.data)
          else if l = 3 then (coAt p X t).co.fastNow
          else if l = 4 then decide (slotAt p d X t = Slot.data)
          else decide (liveAt p X t)
        | .inr (.inl _) => decide (slotAt p d X t ≠ Slot.data)
        | .inr (.inr (.inl _)) => decide (slotAt p d X t = Slot.data)
        | .inr (.inr (.inr _)) => decide (assignStartAt p X t))

open Classical in
/-- The forward bits inspected at round `s+1`: those of the list `Λ` in MULTICAST on DATA, and that of
an active follower's index `ι`. -/
noncomputable def inspectedFwd (X : Trace p) (q : Fin p.M) (u : Fin p.A) (s : Fin p.T) : Bool :=
    let t := s.val + 1
    decide (q.val + 1 = rowAt p X t) &&
      (decide ((coAt p X t).bc.multicast = true ∧ (u.val + 1) ∈ (coAt p X t).bc.lam) ||
        decide (∃ i, ((X t).mid i).bf.active = true ∧ ((X t).mid i).bf.iota = u.val + 1))

open Classical in
/-- The history `G_t^-` of p.36 as a σ-algebra on the fresh-row space: the row coordinates inspected
before the sampler of round `t`, the private draws, and all raw arrivals `(Δ_s)_{s<t}`. The local
registers, actions and observations of the fresh-row execution, whose rewards are fixed, are functions
of these. -/
@[reducible] noncomputable def Gminus (idA : IdArray p) (r : Rewards p) (t : ℕ) :
    MeasurableSpace (FreshΩ p) :=
  MeasurableSpace.comap
    (fun x : FreshΩ p =>
      let X := freshTrace p idA r x
      let d : TableData p := (idA, x.1)
      ((maskRows p (fun q u s => decide (s.val + 1 < t) && inspectedFwd p X q u s)
          (fun q s c => decide (s.val + 1 < t) && inspectedScalar p d X q s c)
          (fun q s e i =>
            decide (s.val + 1 < t) && decide (q.val + 1 = rowAt p X (s.val + 1)) &&
              decide (slotAt p d X (s.val + 1) = (if e then Slot.up else Slot.down)) &&
              decide (selAt p d X (s.val + 1) = i.val + 1)) x.1,
        maskTapes p t x.2) : FreshΩ p)) inferInstance ⊔
  MeasurableSpace.comap
    (fun x : FreshΩ p =>
      let X := freshTrace p idA r x
      let d : TableData p := (idA, x.1)
      fun (s : Fin p.T) (j : Fin p.K) =>
        if s.val + 1 < t then calArrival p d X (s.val + 1) j else 0) MeasurableSpace.pi

/-- The launch round `τ_L ∈ [T+1]` of an execution (p.44), equal to `T+1` if no launch occurs. -/
noncomputable def launchRound (X : Trace p) : ℕ :=
  sInf {t | t = p.T + 1 ∨ (t ∈ Finset.Icc 1 p.T ∧ ((X t).pre (coordinator p)).activated = true)}

/-- The bootstrap registers that matter on which two executions must agree (Prop. 22(i), Lemma 24):
gain weights, the block's draws, the coordinator's list and counters, activation and the effective
declaration. Candidate counts are excluded because the reference tests only the true row. -/
def bootAgree (a b : Local p) : Prop :=
  a.activated = b.activated ∧ a.row = b.row ∧ a.bf.bw = b.bf.bw ∧ a.bf.active = b.bf.active ∧
    a.bf.held = b.bf.held ∧ a.bf.iota = b.bf.iota ∧ a.bc.target = b.bc.target ∧
    a.bc.lam = b.bc.lam ∧ a.bc.multicast = b.bc.multicast ∧ a.bc.cnt = b.bc.cnt

open Classical in
/-- A row `v` passes the bootstrap prefix test (66), p.58, at follower `i` in round `t`, on the
observations of `X`: `|P_i(v;t)| ≥ q_dec` and `φ_v(ι, l) = 1` on `P_i(v;t)`, with `P_i(v;t)` of (65) the
eligible positives of the current block through `t`. -/
noncomputable def passesPrefix (d : TableData p) (X : Trace p) (i : Fin p.m) (v t : ℕ) : Prop :=
    let b := ((X t).mid i).bf
    let blk := (Finset.Icc 1 t).filter (fun l => (l - 1) / p.Bboot = (t - 1) / p.Bboot)
    let elig := blk.filter (fun l =>
      (idBit p d b.iota l).run' 0 = false ∧ (readSlot p d v l).run' 0 = Slot.data ∧
        0 < quant p ((X l).obs i))
    p.qdec ≤ elig.card ∧ ∀ l ∈ elig, (fwdBit p d v b.iota l).run' 0 = true

/-- **A forward failure** (p.61): some `v ≠ J` passes a bootstrap prefix test on the reference
observations of Algorithm 8, at a follower that is uninformed and active. -/
def forwardFailure (d : TableData p) (X : Trace p) (j : ℕ) : Prop :=
  ∃ t ∈ Finset.Icc 1 p.T, ∃ i, i ≠ coordinator p ∧ ((X t).mid i).activated = false ∧
    ((X t).mid i).bf.active = true ∧ ∃ v ∈ Finset.Icc 1 p.M, v ≠ j ∧ passesPrefix p d X i v t

/-- A word accepted on a channel at round `t` in the coordinator's or a follower's report. -/
def acceptedOn (X : Trace p) (t : ℕ) (dir : Bool) (k : ℕ) (w : Word p) : Prop :=
  ∃ i W sol, ((X t).logs i).decided = some (dir, k, W, sol) ∧ ((X t).logs i).accepted = some w

/-- The true-`j` unoccupied state (Prop. 22(ii)): activated in row `j`, with zero accepted start,
score, last increment, queue and state. -/
def trueUnoccupied (j : ℕ) (s : Local p) : Prop :=
  s.activated = true ∧ s.row = j ∧ s.fol.rc.σ = 0 ∧ s.fol.S = 0 ∧ s.fol.δ = 0 ∧ s.fol.b = 0 ∧
    s.fol.state = 0

/-- The memory of one player, in cells (Prop. 23, p.50): an uninformed follower's `M` counts and flags
and `K` weights; four cells per saved observation; `B+1` per equation; for the coordinator a constant
number of `K`-vectors, `O(Km)` temporary cells, the list `Λ`, the raw buffer and the UP batches. -/
noncomputable def privateCells (i : Fin p.m) (s : Local p) : ℕ :=
  if i = coordinator p then
    s.bc.lam.length + 16 * p.K + p.K * p.m + 3 * s.co.bufCount + 16 * p.m +
      ∑ k ∈ Finset.Icc 1 p.d, (p.Bmsg + 1) * (s.co.upBatch k).length
  else
    (if s.activated then 0 else 2 * p.M + p.K + 8) + 4 * s.fol.cand.length +
      (p.Bmsg + 1) * s.fol.batch.length + 16 + p.K

/-- The cells of the table (Prop. 23(i), p.49): the ID and forward arrays, the scalars and the affine
maps. -/
noncomputable def tableCells : ℕ :=
  p.A * p.T + p.M * p.A * p.T + p.M * p.T * (2 * p.m + p.K + 7) + p.M * p.T * 2 * p.d * (p.Bmsg + 1)

end AdvMultiplayer


