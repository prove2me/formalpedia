theorem solution {Rh Ri Q j : ℝ} (hRi : 0 ≤ Ri) (hlt : Ri < Rh) {b1 b2 : ℝ → ℝ}
    (h1 : MagClass Rh b1) (h2 : MagClass Rh b2)
    (e1 : ∀ R ∈ Ioi Rh, Lop Rh Ri Q b1 R = 2 * Q * j / R ^ 3)
    (e2 : ∀ R ∈ Ioi Rh, Lop Rh Ri Q b2 R = 2 * Q * j / R ^ 3) : EqOn b1 b2 (Ioi Rh) := by
  have hRh : 0 < Rh := lt_of_le_of_lt hRi hlt
  set h : ℝ → ℝ := fun s => b1 s - b2 s with hdef
  have hC2 : ContDiffOn ℝ 2 h (Ioi Rh) := h1.1.sub h2.1
  have hL : ∀ R ∈ Ioi Rh, Lop Rh Ri Q h R = 0 := fun R hR => by
    rw [hdef, Lop_sub Rh Ri Q h1.1 h2.1 hRh.le hR, e1 R hR, e2 R hR, sub_self]
  have hE : ∀ R ∈ Ioi Rh, HasDerivAt (energy Rh Ri h)
      (Pc Rh Ri R * deriv h R ^ 2 + Vc Q R * h R ^ 2) R := fun R hR =>
    energy_hasDerivAt Rh Ri Q hC2 hRh.le hR (hL R hR)
  have hpos : ∀ R ∈ Ioi Rh, 0 < Pc Rh Ri R ∧ 0 < Vc Q R := fun R hR =>
    ⟨(bg_pos hRi hlt hR).2.2.2.2.2.2.1, Vc_pos Q (bg_pos hRi hlt hR).2.2.1⟩
  -- monotonicity of `E` on the exterior
  have hmono : MonotoneOn (energy Rh Ri h) (Ioi Rh) := by
    refine monotoneOn_of_deriv_nonneg (convex_Ioi Rh)
      (fun R hR => (hE R hR).continuousAt.continuousWithinAt) ?_ ?_
    · rw [interior_Ioi]; exact fun R hR => (hE R hR).differentiableAt.differentiableWithinAt
    · rw [interior_Ioi]; intro R hR
      rw [(hE R hR).deriv]
      obtain ⟨hp, hv⟩ := hpos R hR
      exact add_nonneg (mul_nonneg hp.le (sq_nonneg _)) (mul_nonneg hv.le (sq_nonneg _))
  -- the two endpoint limits (derived from the classes)
  have hHor : Tendsto (energy Rh Ri h) (𝓝[>] Rh) (𝓝 0) := energy_horizon hRh (h1.2.1.sub h2.2.1)
  obtain ⟨C1, hC1, Rs1, hRs1, hb1⟩ := h1.2.2
  obtain ⟨C2, hC2', Rs2, hRs2, hb2⟩ := h2.2.2
  have hInf : Tendsto (energy Rh Ri h) atTop (𝓝 0) := by
    refine energy_infinity hRi hlt (add_nonneg hC1 hC2') (lt_max_of_lt_left hRs1) (Rs := max Rs1 Rs2)
      (fun R hR => ?_)
    have hR1 : R ≥ Rs1 := le_trans (le_max_left _ _) hR
    have hR2 : R ≥ Rs2 := le_trans (le_max_right _ _) hR
    have hRI : R ∈ Ioi Rh := lt_of_lt_of_le hRs1 hR1
    obtain ⟨a1, d1⟩ := hb1 R hR1
    obtain ⟨a2, d2⟩ := hb2 R hR2
    have hdR : deriv h R = deriv b1 R - deriv b2 R :=
      deriv_sub (diff_of_C2 isOpen_Ioi h1.1 hRI).1 (diff_of_C2 isOpen_Ioi h2.1 hRI).1
    constructor
    · calc |h R| = |b1 R - b2 R| := rfl
        _ ≤ |b1 R| + |b2 R| := abs_sub _ _
        _ ≤ C1 / R + C2 / R := add_le_add a1 a2
        _ = (C1 + C2) / R := by ring
    · calc |deriv h R| = |deriv b1 R - deriv b2 R| := by rw [hdR]
        _ ≤ |deriv b1 R| + |deriv b2 R| := abs_sub _ _
        _ ≤ C1 / R ^ 2 + C2 / R ^ 2 := add_le_add d1 d2
        _ = (C1 + C2) / R ^ 2 := by ring
  -- `E ≡ 0` on the exterior
  have hzero : ∀ R ∈ Ioi Rh, energy Rh Ri h R = 0 := by
    intro R hR
    have lo : 0 ≤ energy Rh Ri h R := by
      refine le_of_tendsto hHor ?_
      filter_upwards [Ioo_mem_nhdsGT hR] with s hs
      exact hmono (mem_Ioi.mpr hs.1) hR hs.2.le
    have hi : energy Rh Ri h R ≤ 0 := by
      refine ge_of_tendsto hInf ?_
      filter_upwards [eventually_ge_atTop R] with s hs
      exact hmono hR (mem_Ioi.mpr (lt_of_lt_of_le hR hs)) hs
    linarith
  -- `E' = 0`, so `V h² = 0`, so `h = 0`
  intro R hR
  have hev : energy Rh Ri h =ᶠ[𝓝 R] fun _ => 0 :=
    Filter.eventuallyEq_of_mem (isOpen_Ioi.mem_nhds hR) (fun s hs => hzero s hs)
  have hd0 : Pc Rh Ri R * deriv h R ^ 2 + Vc Q R * h R ^ 2 = 0 := by
    rw [← (hE R hR).deriv, hev.deriv_eq]; simp
  obtain ⟨hP, hV⟩ := hpos R hR
  have hsq : h R ^ 2 = 0 := by
    have : Vc Q R * h R ^ 2 = 0 := by
      nlinarith [mul_nonneg hP.le (sq_nonneg (deriv h R)), mul_nonneg hV.le (sq_nonneg (h R))]
    exact (mul_eq_zero.mp this).resolve_left hV.ne'
  have : b1 R - b2 R = 0 := pow_eq_zero_iff (two_ne_zero) |>.mp hsq
  linarith
