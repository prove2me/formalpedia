lemma loop_wellFounded_credit {σ : Type} (test : Test) (body : Cmd) (repr : σ → Data → Prop)
    (rel : σ → σ → Prop) (wf : WellFounded rel) (credit : σ → ℕ)
    (step : ∀ q s, repr q s → test.holds s →
      ∃ q' t cost, Eval body s cost t ∧ repr q' t ∧ rel q' q ∧ cost+2+credit q ≤ credit q') :
    ∀ q s, repr q s → ∃ q' t cost, Eval (.loop test body) s cost t ∧ repr q' t ∧
      ¬test.holds t ∧ cost+credit q ≤ credit q'+2 := by
