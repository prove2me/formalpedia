theorem charZero_of_maximalIdeal_eq_span
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] (q : ℕ) [Fact q.Prime]
    (h : IsLocalRing.maximalIdeal A₀ = Ideal.span {(q : A₀)}) : CharZero A₀ := by
  have hqp : q.Prime := Fact.out
  obtain ⟨p, hp⟩ := CharP.exists A₀
  rcases CharP.char_is_prime_or_zero A₀ p with hpp | hp0
  · exfalso
    by_cases hpq : p = q
    ·
      subst hpq
      have hq0 : (p : A₀) = 0 := CharP.cast_eq_zero A₀ p
      apply IsDiscreteValuationRing.not_a_field A₀
      rw [h, hq0, Ideal.span_singleton_eq_bot]
    ·
      haveI : Fact p.Prime := ⟨hpp⟩
      have hqZ : ((q : ℕ) : ZMod p) ≠ 0 := by
        rw [Ne, ZMod.natCast_eq_zero_iff]
        intro hdvd
        exact hpq ((Nat.prime_dvd_prime_iff_eq hpp hqp).mp hdvd)
      have hu : IsUnit ((q : ℕ) : A₀) := by
        have := (isUnit_iff_ne_zero.mpr hqZ).map (ZMod.castHom (dvd_refl p) A₀)
        rwa [map_natCast] at this
      apply (IsLocalRing.maximalIdeal.isMaximal A₀).ne_top
      rw [h, Ideal.span_singleton_eq_top]
      exact hu
  · subst hp0
    exact CharP.charP_to_charZero A₀

theorem injective_algebraMap_fractionRing_quotient_of_mem_minimalPrimes
    (A₀ B : Type) [CommRing A₀] [IsDomain A₀] [CommRing B] [Algebra A₀ B] [Module.Flat A₀ B]
    (𝔭 : Ideal B) (h𝔭 : 𝔭 ∈ minimalPrimes B) :
    Function.Injective (algebraMap A₀ (FractionRing (B ⧸ 𝔭))) := by
  haveI : 𝔭.IsPrime := h𝔭.1.1
  rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
  intro a ha
  rw [IsScalarTower.algebraMap_apply A₀ (B ⧸ 𝔭) (FractionRing (B ⧸ 𝔭)),
    map_eq_zero_iff _ (IsFractionRing.injective (B ⧸ 𝔭) (FractionRing (B ⧸ 𝔭))),
    IsScalarTower.algebraMap_apply A₀ B (B ⧸ 𝔭), Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at ha
  by_contra ha0

  have hreg : algebraMap A₀ B a ∈ nonZeroDivisors B := by
    have hsm : IsSMulRegular B a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha0)
    rw [mem_nonZeroDivisors_iff]
    refine ⟨fun x hx => hsm ?_, fun x hx => hsm ?_⟩
    · simp only [smul_zero]; rw [Algebra.smul_def]; exact hx
    · simp only [smul_zero]; rw [Algebra.smul_def, mul_comm]; exact hx
  exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes h𝔭) ha hreg

theorem exists_finset_card_roots_cyclotomic
    (F : Type) [Field F] (q : ℕ) [Fact q.Prime] (hz : ∃ z : F, IsPrimitiveRoot z q) :
    ∃ s : Finset F, q - 1 ≤ s.card ∧ ∀ z ∈ s, (Polynomial.cyclotomic q F).IsRoot z := by
  classical
  have hqp : q.Prime := Fact.out
  obtain ⟨ζ, hζ⟩ := hz
  haveI : NeZero q := ⟨hqp.ne_zero⟩
  haveI : NeZero ((q : ℕ) : F) := hζ.neZero'
  refine ⟨primitiveRoots q F, ?_, fun z hz => ?_⟩
  · rw [hζ.card_primitiveRoots, Nat.totient_prime hqp]
  · rw [mem_primitiveRoots hqp.pos] at hz
    exact (Polynomial.isRoot_cyclotomic_iff).mpr hz

