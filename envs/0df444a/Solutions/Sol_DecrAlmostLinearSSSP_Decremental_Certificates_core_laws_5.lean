  simp [code,addressCode,addressAtoms,loadCode,loadAtoms,Structured.sequence,NatFrame,writesNat]
  omega
lemma real_frame (k : ℕ) (h600 : k ≠ 600) (h602 : k ≠ 602) (h604 : k ≠ 604) (h606 : k ≠ 606) : RealFrame code k := by
  simp [code,addressCode,addressAtoms,loadCode,loadAtoms,Structured.sequence,RealFrame,writesReal,
