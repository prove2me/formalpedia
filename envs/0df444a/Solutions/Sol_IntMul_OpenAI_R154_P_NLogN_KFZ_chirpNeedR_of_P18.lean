theorem digL_append (r : ℕ) (hr : 0 < r) : ∀ (ts : List ℕ) (x i : ℕ), i < ts.length →
    digL (ts ++ [r]) x i = digL ts (x / r) i
  | [], _, _, hi => by simp at hi
  | t :: ts, x, 0, _ => by
