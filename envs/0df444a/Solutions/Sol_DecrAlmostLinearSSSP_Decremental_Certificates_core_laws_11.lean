set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreRepairControl
open Structured
lemma eval_code (s : Data) : Eval code s 5 (result s) := eval_sequence_atoms atoms s
lemma values (K : ℝ) (s : Data) (hK : s.realReg 512 = K) :
    (result s).natReg 650 = 1 ∧ (result s).realReg 520 = -1/(4*K) := by
  simp [result,atoms,Atom.effect,instructionEffect,data,Data.machine,hK]
lemma nat_frame (k : ℕ) (hk : k ≠ 650) : NatFrame code k := by
  simp [code,atoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma real_frame (k : ℕ) (h520 : k ≠ 520) (h656 : k ≠ 656) (h658 : k ≠ 658) : RealFrame code k := by
  simp [code,atoms,Structured.sequence,RealFrame,writesReal,Ne.symm h520,Ne.symm h656,Ne.symm h658]
lemma no_memory : NoMemory code := by simp [code,atoms,Structured.sequence,NoMemory,NoStore]
lemma even_registers : evenRegisters code = true := by decide
lemma host_image (b : Core) (B : ℕ) (K : ℝ) (state : State b) (s : Data)
    (h : CoreHost.Image b B K state s) (hB : b.input.n ≤ B) : CoreHost.Image b B K state (result s) :=
  h.command_frame b B K state hB (eval_code s) no_memory
    (fun k hk => nat_frame k (by simp only [CoreHost.NatRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
    (fun k hk => real_frame k
      (by simp only [CoreHost.RealRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega)
      (by simp only [CoreHost.RealRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega)
      (by simp only [CoreHost.RealRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
lemma source_image (b : Core) (B N : ℕ) (g : Machine) (s : Data)
    (h : CoreSource.Image B (CoreMemory.sourceRecord b B) N g s) :
    CoreSource.Image B (CoreMemory.sourceRecord b B) N g (result s) :=
  h.command_frame B _ N g (eval_code s) no_memory even_registers
    (fun k hk => nat_frame k (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
end DecrAlmostLinearSSSP.Decremental.CoreRepairControl
end s366
section s367
set_option autoImplicit false
set_option maxRecDepth 10000
namespace DecrAlmostLinearSSSP.Decremental.CoreNativeCut
open Structured
lemma Context.repair {b : Core} {B N : ℕ} {K K0 h Γ init : ℝ}
    {impl : CutImplementation} {state : State b} {s : Data}
    (ctx : Context b B N (2*b.input.size) (4*b.weightExponent+68) impl K0 (K^(-2 : ℤ)) h Γ init s)
    (host : CoreHost.Image b B K state s) (hB : b.input.n ≤ B) (hN : 10 ≤ N)
    (hBound : registerBound impl.program.code ≤ N) (hK : 32 ≤ K) (hK0 : 0 < K0) (hKK : K0 ≤ K)
    (bounds : RuntimeBounds b K state)
    (model : CutModel b (logicalIndexEquiv b) state (impl.view b.input.n (logicalCount b) ctx.current))
    (hrunning : state.stopped = false) (offset : ℕ)
    (hdebt : CoreRepair.OperationDebt b state ctx.ops.length (reportVolume ctx.machines) offset)
    (hToggle : toggleVolume ctx.ops = state.toggles) :
    ∃ cost t, ∃ after : State b,
    ∃ next : Context b B N (2*b.input.size) (4*b.weightExponent+68) impl K0 (K^(-2 : ℤ)) h Γ init t,
      Eval (repairCode N impl.program) s cost t ∧
      CoreHost.Image b B K after t ∧ RuntimeBounds b K after ∧
      CutModel b (logicalIndexEquiv b) after (impl.view b.input.n (logicalCount b) next.current) ∧
      after.stopped = true ∧ ReadoutCertificate b after ∧
      next.first = ctx.first ∧ CoreRepair.OperationDebt b after next.ops.length (reportVolume next.machines) offset ∧
      toggleVolume next.ops = after.toggles ∧ after.active = state.active ∧ after.pending = [] ∧
      cost+credit b N impl.program state ctx.current ctx.ops ctx.machines ≤
        credit b N impl.program after next.current next.ops next.machines+7 := by
  let u := CoreRepairControl.result s
  have hu : Eval CoreRepairControl.code s 5 u := CoreRepairControl.eval_code s
  have hum := CoreRepairControl.host_image b B K state s host hB
  have hus := CoreRepairControl.source_image b B N ctx.current s ctx.image
  have huv := CoreRepairControl.values K s host.parameters.quality
  let q : Repair.Snapshot b := ⟨state,ctx.current,ctx.ops,ctx.machines⟩
  have hq : Repair.Repr b B N offset K K0 h Γ init impl ctx.first state.active q u := by
    refine ⟨bounds,hum,model,ctx.run,ctx.last,ctx.zeroTail,hus,?_,huv.2,hdebt,hToggle,?_,rfl,?_⟩
    · simpa only [q,hrunning,Bool.false_eq_true,if_false] using huv.1
    · intro ht
      change state.stopped = true at ht
      rw [hrunning] at ht
      cases ht
    · intro ht
      change state.stopped = true at ht
      rw [hrunning] at ht
      cases ht
  obtain ⟨q',t,cl,he,hr,hstop,hcert,hcredit⟩ := Repair.loop_eval hB hN hBound hK hK0 hKK ctx.session q u hq
  let next := hr.context ctx.session
  refine ⟨5+cl,t,q'.state,next,Eval.seq hu he,hr.host,hr.bounds,hr.model,hstop,hcert,rfl,hr.debt,hr.toggleCount,hr.active_eq,hr.drained hstop,?_⟩
  change cl+credit b N impl.program state ctx.current ctx.ops ctx.machines ≤
    credit b N impl.program q'.state q'.current q'.ops q'.machines+2 at hcredit
  change 5+cl+credit b N impl.program state ctx.current ctx.ops ctx.machines ≤
    credit b N impl.program q'.state q'.current q'.ops q'.machines+7
  omega
end DecrAlmostLinearSSSP.Decremental.CoreNativeCut
end s367
section s368
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreDeletion
open Structured
lemma encode_eval (s : Data) : Eval encodeCode s 1 (encoded s) := eval_nadd s 560 5 5
lemma encode_nat_frame (k : ℕ) (hk : k ≠ 560) : NatFrame encodeCode k := by simp [encodeCode,NatFrame,nadd,writesNat,Ne.symm hk]
lemma encode_real_frame (k : ℕ) : RealFrame encodeCode k := by simp [encodeCode,RealFrame,nadd,writesReal]
lemma encode_no_memory : NoMemory encodeCode := by simp [encodeCode,NoMemory,nadd,NoStore]
lemma encode_even : evenRegisters encodeCode = true := by decide
lemma encode_host (b : Core) (B : ℕ) (K : ℝ) (state : State b) (s : Data)
    (h : CoreHost.Image b B K state s) (hB : b.input.n ≤ B) : CoreHost.Image b B K state (encoded s) :=
  h.command_frame b B K state hB (encode_eval s) encode_no_memory
