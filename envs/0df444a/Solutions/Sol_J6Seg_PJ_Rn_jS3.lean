    · nlinarith
  have hc0 : update c 14 (matL (Mseq Q (bandS mw cB) L A 0) m) = c := by
    rw [show matL (Mseq Q (bandS mw cB) L A 0) m = c 14 from hM.symm]; exact update_eq_self _ _
  have h := Rn.forL (C := 50) (rN := 28) (ix := 1) (b := J6Seg.PJ.elQ) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m) (W := W)
