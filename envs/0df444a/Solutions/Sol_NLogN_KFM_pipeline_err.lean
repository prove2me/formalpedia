open NLogN
open NLogN.KFM
open Complex
variable {κ : Type*} [Fintype κ]
theorem solution (p : ℕ) {F Ft : (κ → ℂ) → (κ → ℂ)} (hF : NLogN.KFM.LinC F) (Es : ℝ)
    (hFt : ∀ u, NLogN.KFM.Grid p u → ‖u‖ ≤ 1 / 2 → ‖Ft u - F u‖ ≤ Es * NLogN.KFM.hp p)
    (hEs : Es * NLogN.KFM.hp p ≤ 1 / 100)
    {u v : κ → ℂ} (hu : NLogN.KFM.Grid p u) (hv : NLogN.KFM.Grid p v) (hu1 : ‖u‖ ≤ 1 / 4) (hv1 : ‖v‖ ≤ 1 / 4) :
    NLogN.KFM.Grid p (NLogN.KFM.QA p (Ft u * Ft v)) ∧ ‖NLogN.KFM.QA p (Ft u * Ft v)‖ ≤ 1 / 2 ∧
    ‖NLogN.KFM.plusT Ft (NLogN.KFM.QA p (Ft u * Ft v)) - NLogN.KFM.cnj (F (NLogN.KFM.cnj (F u * F v)))‖ ≤ (3 * Es + 2) * NLogN.KFM.hp p := by
  have h0 := NLogN.KFM.hp_pos p
  have eu := hFt u hu (hu1.trans (by norm_num))
  have ev := hFt v hv (hv1.trans (by norm_num))
  have nU : ‖F u‖ ≤ 1 / 4 := (hF.le u).trans hu1
  have nV : ‖F v‖ ≤ 1 / 4 := (hF.le v).trans hv1
  have nUt : ‖Ft u‖ ≤ 1 / 4 + 1 / 100 := by
    have := norm_sub_norm_le (Ft u) (F u); linarith
  have nVt : ‖Ft v‖ ≤ 1 / 4 + 1 / 100 := by
    have := norm_sub_norm_le (Ft v) (F v); linarith
  set z := NLogN.KFM.QA p (Ft u * Ft v)
  have nz : ‖z‖ ≤ 1 / 2 := (NLogN.KFM.norm_QA_le _ _).trans ((NLogN.KFM.norm_mul_le' _ _).trans (by
    nlinarith [norm_nonneg (Ft u), norm_nonneg (Ft v)]))
  refine ⟨NLogN.KFM.QA_grid _ _, nz, ?_⟩
  -- error of z
  have ez : ‖z - F u * F v‖ ≤ (2 * Es + 2) * NLogN.KFM.hp p := by
    have e1 : z - F u * F v = (z - Ft u * Ft v) + ((Ft u - F u) * Ft v + F u * (Ft v - F v)) := by
      ring
    rw [e1]
    have q := NLogN.KFM.norm_QA_sub_le2 p (Ft u * Ft v)
    have b1 : ‖(Ft u - F u) * Ft v‖ ≤ Es * NLogN.KFM.hp p :=
      (NLogN.KFM.norm_mul_le' _ _).trans (by nlinarith [norm_nonneg (Ft u - F u), norm_nonneg (Ft v)])
    have b2 : ‖F u * (Ft v - F v)‖ ≤ Es * NLogN.KFM.hp p :=
      (NLogN.KFM.norm_mul_le' _ _).trans (by nlinarith [norm_nonneg (Ft v - F v), norm_nonneg (F u)])
    calc _ ≤ ‖z - Ft u * Ft v‖ + ‖(Ft u - F u) * Ft v + F u * (Ft v - F v)‖ := norm_add_le _ _
      _ ≤ 2 * NLogN.KFM.hp p + (Es * NLogN.KFM.hp p + Es * NLogN.KFM.hp p) := add_le_add q ((norm_add_le _ _).trans (add_le_add b1 b2))
      _ = _ := by ring
  -- the opposite transform
  have ep := hFt (NLogN.KFM.cnj z) (NLogN.KFM.QA_grid p _).cnj (by rw [NLogN.KFM.norm_cnj]; exact nz)
  have e2 : NLogN.KFM.plusT Ft z - NLogN.KFM.cnj (F (NLogN.KFM.cnj (F u * F v))) =
      NLogN.KFM.cnj (Ft (NLogN.KFM.cnj z) - F (NLogN.KFM.cnj z)) + NLogN.KFM.cnj (F (NLogN.KFM.cnj z) - F (NLogN.KFM.cnj (F u * F v))) := by
    simp only [NLogN.KFM.plusT, NLogN.KFM.cnj_sub]; abel
  rw [e2]
  have t1 : ‖NLogN.KFM.cnj (Ft (NLogN.KFM.cnj z) - F (NLogN.KFM.cnj z))‖ ≤ Es * NLogN.KFM.hp p := by rw [NLogN.KFM.norm_cnj]; exact ep
  have t2 : ‖NLogN.KFM.cnj (F (NLogN.KFM.cnj z) - F (NLogN.KFM.cnj (F u * F v)))‖ ≤ (2 * Es + 2) * NLogN.KFM.hp p := by
    rw [NLogN.KFM.norm_cnj]
    refine (hF.err _ _).trans ?_
    rw [← NLogN.KFM.cnj_sub, NLogN.KFM.norm_cnj]; exact ez
  calc _ ≤ _ := norm_add_le _ _
    _ ≤ Es * NLogN.KFM.hp p + (2 * Es + 2) * NLogN.KFM.hp p := add_le_add t1 t2
    _ = (3 * Es + 2) * NLogN.KFM.hp p := by ring
end
