/-- Rewriting both the function and the derivative of a `HasDerivAt` statement. -/
theorem hasDerivAt_of_congr {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] {f₁ f : ℝ → G} {d d₁ : G}
    (hf : HasDerivAt f d 0) (h1 : ∀ ε, f₁ ε = f ε) (h2 : d = d₁) : HasDerivAt f₁ d₁ 0 := by
  rw [show f₁ = f from funext h1, ← h2]; exact hf

namespace NPFamily

variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}
  {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

variable (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
include hF ht hx

theorem hasDerivAt_weylF (I J A K : Fin 4) :
    HasDerivAt (fun ε => weylF (g ε) (gi ε) (E ε) I J A K x) (weylFVar (g 0) (gi 0) h (E 0) B I J A K x) 0 :=
  hasDerivAt_ccontr4_fam (T := fun ε => weyl (g ε) (gi ε)) (u := fun ε => fvec (E ε) I x)
    (v := fun ε => fvec (E ε) J x) (w := fun ε => fvec (E ε) A x) (z := fun ε => fvec (E ε) K x)
    (fun a b c d => hasDerivAt_weyl hF ht hx a b c d) (fun μ => ht.frame x hx I μ) (fun μ => ht.frame x hx J μ)
    (fun μ => ht.frame x hx A μ) (fun μ => ht.frame x hx K μ)

theorem hasDerivAt_psi0 :
    HasDerivAt (fun ε => psi0 (g ε) (gi ε) (E ε) x) (psi0Var (g 0) (gi 0) h (E 0) B x) 0 := by
  simp only [psi0_eq]; exact hasDerivAt_weylF hF ht hx 0 2 0 2
theorem hasDerivAt_psi1 :
    HasDerivAt (fun ε => psi1 (g ε) (gi ε) (E ε) x) (psi1Var (g 0) (gi 0) h (E 0) B x) 0 := by
  simp only [psi1_eq]; exact hasDerivAt_weylF hF ht hx 0 1 0 2
theorem hasDerivAt_psi3 :
    HasDerivAt (fun ε => psi3 (g ε) (gi ε) (E ε) x) (psi3Var (g 0) (gi 0) h (E 0) B x) 0 := by
  simp only [psi3_eq]; exact hasDerivAt_weylF hF ht hx 0 1 3 1
theorem hasDerivAt_psi4 :
    HasDerivAt (fun ε => psi4 (g ε) (gi ε) (E ε) x) (psi4Var (g 0) (gi 0) h (E 0) B x) 0 := by
  simp only [psi4_eq]; exact hasDerivAt_weylF hF ht hx 1 3 1 3

theorem hasDerivAt_ricF (A K : Fin 4) :
    HasDerivAt (fun ε => ricF (g ε) (gi ε) (E ε) A K x) (ricFVar (g 0) (gi 0) h (E 0) B A K x) 0 :=
  hasDerivAt_ccontr_fam (T := fun ε => ricciOf (g ε) (gi ε)) (u := fun ε => fvec (E ε) A x)
    (v := fun ε => fvec (E ε) K x) (fun i j => hF.fam.hasDerivAt_ricciOf ht.tangent hx i j)
    (fun μ => ht.frame x hx A μ) (fun μ => ht.frame x hx K μ)

theorem hasDerivAt_FfrF (A K : Fin 4) :
    HasDerivAt (fun ε => FfrF (F ε) (E ε) A K x) (FfrFVar (F 0) f (E 0) B A K x) 0 :=
  hasDerivAt_ccontr_fam (T := F) (u := fun ε => fvec (E ε) A x) (v := fun ε => fvec (E ε) K x)
    (fun i j => ht.tangent.field x hx i j) (fun μ => ht.frame x hx A μ) (fun μ => ht.frame x hx K μ)

theorem hasDerivAt_omL (C A K : Fin 4) :
    HasDerivAt (fun ε => omL (g ε) (gi ε) (E ε) (Θ ε) C A K x) (omLVar (g 0) h (E 0) B C A K x) 0 := by
  have hd := (((hasDerivAt_cL hF ht hx C A K).sub (hasDerivAt_cL hF ht hx A K C)).add
    (hasDerivAt_cL hF ht hx K C A)).div_const 2
  refine hd.congr_of_eventuallyEq ?_
  filter_upwards [hF.mem_slice hx] with ε hε
  exact (hF.null ε).omL_koszul hε C A K

theorem hasDerivAt_Hfr (A K C : Fin 4) :
    HasDerivAt (fun ε => Hfr (F ε) (E ε) A K C x) (HfrVar (F 0) f (E 0) B A K C x) 0 := by
  have hH := fun μ ν l => hF.fam.bridge_faraday ht.tangent hx μ ν l
  have hE := fun A μ => ht.frame x hx A μ
  have := HasDerivAt.fun_sum (u := Finset.univ) fun μ _ => HasDerivAt.fun_sum (u := Finset.univ) fun ν _ =>
    HasDerivAt.fun_sum (u := Finset.univ) fun l _ =>
    ((((hH μ ν l).ofReal_comp).mul (hE A μ)).mul (hE K ν)).mul (hE C l)
  refine hasDerivAt_of_congr this (fun ε => rfl) ?_
  simp only [HfrVar, Pi.mul_apply]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

theorem hasDerivAt_Jfr (K : Fin 4) :
    HasDerivAt (fun ε => Jfr (g ε) (gi ε) (F ε) (Θ ε) K x) (JfrVar (g 0) (gi 0) (F 0) h f (Θ 0) B K x) 0 := by
  have := HasDerivAt.fun_sum (u := Finset.univ) fun b _ =>
    (hF.tangent_coframe ht hx K b).mul (hF.fam.bridge_maxwell ht.tangent hx b).ofReal_comp
  exact hasDerivAt_of_congr this (fun ε => rfl) rfl

end NPFamily

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg19

