theorem solution (R : Type) [CommRing R] (t x : R) (I : Ideal R) [I.IsMaximal]
    (hI : Ideal.span ({t,x} : Set R) = I) [IsNoetherianRing (TypeDensity.BlowupChart R t x)]
    (e : (TypeDensity.BlowupChart R t x ⧸ TypeDensity.chartExceptional R t x) ≃+* Polynomial (R ⧸ I))
    (he : ∀ r : R, e (Ideal.Quotient.mk (TypeDensity.chartExceptional R t x) (TypeDensity.chartBase R t x r)) =
