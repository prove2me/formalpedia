    have l1F : σ1 NLogN.KFW.wF = σ wF := by
      simp only [σ1]; rw [Function.update_of_ne (by decide)]
    have hES : NLogN.KFW.ES (k + 1) = NLogN.KFW.cL + P8Lift.sc * NLogN.KFW.ES k := rfl
    have hsc : 0 < P8Lift.sc := by unfold P8Lift.sc; norm_num
    have v5 : NLogN.KFW.ExV σ4 NLogN.KFW.esDown ((NLogN.KFW.ES k : ℕ) : ℤ) Bz := by
      have hv : (((NLogN.KFW.ES (k + 1) : ℕ) : ℤ) + -(NLogN.KFW.cL : ℤ)) = ((P8Lift.sc * NLogN.KFW.ES k : ℕ) : ℤ) := by
        rw [hES]; push_cast; ring
      refine (NLogN.KFW.ExV.ndiv (NLogN.KFW.ExV.add (NLogN.KFW.ExV.reg (l4X ▸ hN.hX) (hbz _ (by omega)))
