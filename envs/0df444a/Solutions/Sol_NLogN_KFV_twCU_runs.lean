theorem π3_X (X B Z : ℕ) : π3 X B Z NLogN.KFUU.qX = some (X : ℤ) := by simp +decide [π3, pmOf]
theorem π3_B (X B Z : ℕ) : π3 X B Z NLogN.KFUU.qB = some (B : ℤ) := by simp +decide [π3, pmOf]
theorem π3_Z (X B Z : ℕ) : π3 X B Z NLogN.KFUU.qZ = some (Z : ℤ) := by simp +decide [π3, pmOf]

