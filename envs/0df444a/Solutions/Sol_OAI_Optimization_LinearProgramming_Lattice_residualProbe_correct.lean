  | succ k ih => simp [dyadicSearchQ, SignQueries.run, dyadicSearch, ih]

theorem probeRowsQ_run {n p : ℕ} (oracle : (Fin p → ℤ) → Bool) (P : Fin n → Fin p → ℚ) (k : ℕ) :
    SignQueries.run oracle (probeRowsQ P k) =
