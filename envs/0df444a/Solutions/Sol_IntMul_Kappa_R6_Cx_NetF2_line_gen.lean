/-! ## Soundness -/

/-- The single generator of a line `psp a b C` (`C` one bit `c`) is the vector of `2^a ||| 2^b ||| C`. -/
lemma line_gen_sol_aux {a b C : ℕ} (hp : PspOK a b C) (h1 : pc24 C = 1) (c : Fin 24) (hc : C.testBit c = true) :
    ev a + ev b + ev c = bitv (2 ^ a ||| 2 ^ b ||| C) := by
  obtain ⟨ha, hb, hab, hCa, hCb⟩ := hp
  rw [pc24_eq, ← card_filter_testBit] at h1
  obtain ⟨c0, hc0⟩ := Finset.card_eq_one.1 h1
  have hCj : ∀ j : Fin 24, C.testBit j = true ↔ j = c := by
    intro j
    have hcj : c ∈ univ.filter (fun i : Fin 24 => C.testBit i) := by simp [hc]
    rw [hc0, Finset.mem_singleton] at hcj
    constructor
    · intro hj
      have : j ∈ univ.filter (fun i : Fin 24 => C.testBit i) := by simp [hj]
      rw [hc0, Finset.mem_singleton] at this
      rw [this, hcj]
    · rintro rfl; exact hc
  have hca := ne_of_testBit hc hCa
  have hcb := ne_of_testBit hc hCb
  funext j
  simp only [Pi.add_apply, ev_apply, bitv_apply, Nat.testBit_or, Nat.testBit_two_pow]
  have hj := hCj j
  by_cases hja : (j : ℕ) = a
  · have hjb : (j : ℕ) ≠ b := fun e => hab (hja.symm.trans e)
    have hjc : (j : ℕ) ≠ c := fun e => hca (e.symm.trans hja)
    have : C.testBit j = false := by
      cases hh : C.testBit j
      · rfl
      · exact absurd (Fin.val_eq_of_eq (hj.1 hh)) hjc
    simp [hja, hab, this, eq_comm, Ne.symm hca]
  · by_cases hjb : (j : ℕ) = b
    · have hjc : (j : ℕ) ≠ c := fun e => hcb (e.symm.trans hjb)
      have : C.testBit j = false := by
        cases hh : C.testBit j
        · rfl
        · exact absurd (Fin.val_eq_of_eq (hj.1 hh)) hjc
      simp [hjb, Ne.symm hab, this, eq_comm, Ne.symm hcb]
    · by_cases hjc : j = c
      · subst hjc; simp [hja, hjb, hc, Ne.symm hja, Ne.symm hjb]
      · have hjc' : (j : ℕ) ≠ c := fun e => hjc (Fin.ext e)
        have : C.testBit j = false := by
          cases hh : C.testBit j
          · rfl
          · exact absurd (hj.1 hh) hjc
        simp [hja, hjb, hjc', this, Ne.symm hja, Ne.symm hjb]

