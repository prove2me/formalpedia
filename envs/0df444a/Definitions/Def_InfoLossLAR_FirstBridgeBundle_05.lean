/-! Real TM2 subroutine calls preserve arbitrary caller stacks. The embedded
program is syntactically the callee's translated program, not an oracle step. -/
namespace Integration9_9.TM2Subroutine
open Turing StateTransition Function TM2Simulation

variable {K J Λ L σ τ : Type} {Γ : K → Type} {Δ : J → Type}
variable [DecidableEq K] [DecidableEq J]

/-- The caller's stacks outside the callee's image retain their initial values. -/
def FrameRel (i : K → J) (e : ∀ k, Γ k ≃ Δ (i k)) (v : _root_.Integration9_9.TM2Simulation.ControlLens σ τ)
    (label : Λ → L) (finish : Option L) (anchor : τ) (frame : ∀ j, List (Δ j))
    (a : TM2.Cfg Γ Λ σ) (b : TM2.Cfg Δ L τ) : Prop :=
  b.l = a.l.elim finish (fun l => some (label l)) ∧
  b.var = v.write anchor a.var ∧ _root_.Integration9_9.TM2Simulation.StacksRel i e a.stk b.stk ∧
  ∀ j, (∀ k, i k ≠ j) → b.stk j = frame j

theorem step (i : K → J) (hi : Injective i)
    (e : ∀ k, Γ k ≃ Δ (i k)) (v : _root_.Integration9_9.TM2Simulation.ControlLens σ τ) (label : Λ → L) (finish : Option L)
    (M : Λ → TM2.Stmt Γ Λ σ) (N : L → TM2.Stmt Δ L τ)
    (hN : ∀ l, N (label l) = _root_.Integration9_9.TM2Simulation.statement i e v label finish (M l))
    (anchor : τ) (frame : ∀ j, List (Δ j))
    (a a' : TM2.Cfg Γ Λ σ) (b : TM2.Cfg Δ L τ)
    (ha : TM2.step M a = some a') (hr : _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a b) :
    ∃ b', TM2.step N b = some b' ∧ _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a' b' := by
  rcases a with ⟨al,av,as⟩
  cases al with
  | none => simp [TM2.step] at ha
  | some l =>
    simp only [TM2.step,Option.some.injEq] at ha
    subst a'
    obtain ⟨hl,hv,hs,hfr⟩ := hr
    have hb : b.l = some (label l) := hl
    have hvread : v.read b.var = av := by rw [hv,v.read_write]
    obtain ⟨hl',hv',hs',hfr'⟩ := _root_.Integration9_9.TM2Simulation.stepAux_simulation i hi e v label finish
      (M l) av b.var as b.stk hvread hs
    refine ⟨TM2.stepAux (_root_.Integration9_9.TM2Simulation.statement i e v label finish (M l)) b.var b.stk,?_,
      hl',?_,hs',?_⟩
    · cases b with
      | mk bl bv bs =>
        change bl = some (label l) at hb
        subst bl
        simp only [TM2.step,hN]
    · rw [hv',hv,v.write_write]
    · intro j hj
      exact (hfr' j hj).trans (hfr j hj)

/-- A bounded native execution runs in the caller in exactly the same steps,
with all of the caller's additional stacks and finite state preserved. -/
theorem run (i : K → J) (hi : Injective i)
    (e : ∀ k, Γ k ≃ Δ (i k)) (v : _root_.Integration9_9.TM2Simulation.ControlLens σ τ) (label : Λ → L) (finish : Option L)
    (M : Λ → TM2.Stmt Γ Λ σ) (N : L → TM2.Stmt Δ L τ)
    (hN : ∀ l, N (label l) = _root_.Integration9_9.TM2Simulation.statement i e v label finish (M l))
    (anchor : τ) (frame : ∀ j, List (Δ j))
    (a a' : TM2.Cfg Γ Λ σ) (b : TM2.Cfg Δ L τ) (m : ℕ)
    (h : EvalsToInTime (TM2.step M) a (some a') m)
    (hr : _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a b) :
    ∃ b', Nonempty (EvalsToInTime (TM2.step N) b (some b') m) ∧
      _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a' b' :=
  _root_.Integration9_9.TM2Simulation.evalsToInTime_simulation (TM2.step M) (TM2.step N)
    (_root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame)
    (_root_.Integration9_9.TM2Subroutine.step i hi e v label finish M N hN anchor frame) a a' b m h hr

omit [DecidableEq K] [DecidableEq J] in
/-- The image and frame facts identify the entire caller configuration. -/
theorem unique (i : K → J) (e : ∀ k, Γ k ≃ Δ (i k)) (v : _root_.Integration9_9.TM2Simulation.ControlLens σ τ)
    (label : Λ → L) (finish : Option L) (anchor : τ) (frame : ∀ j, List (Δ j))
    (a : TM2.Cfg Γ Λ σ) (b c : TM2.Cfg Δ L τ)
    (hb : _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a b)
    (hc : _root_.Integration9_9.TM2Subroutine.FrameRel i e v label finish anchor frame a c) : b = c := by
  classical
  obtain ⟨hbl,hbv,hbs,hbf⟩ := hb
  obtain ⟨hcl,hcv,hcs,hcf⟩ := hc
  have hl := hbl.trans hcl.symm
  have hv := hbv.trans hcv.symm
  have hs : b.stk = c.stk := by
    funext j
    by_cases h : ∃ k, i k = j
    · obtain ⟨k,rfl⟩ := h
      exact (hbs k).trans (hcs k).symm
    · have hn : ∀ k, i k ≠ j := by simpa only [not_exists] using h
      exact (hbf j hn).trans (hcf j hn).symm
  cases b; cases c
  simp only [TM2.Cfg.mk.injEq] at *
  exact ⟨hl,hv,hs⟩

end Integration9_9.TM2Subroutine

end

