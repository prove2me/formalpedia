-- title:
--   Proposition 4 — constant stepsize: $\liminf F(x_k)\le F^*+\alpha\beta m^2c^2/2$
-- statement:
--   Consider problem (5)–(6) under the standing assumptions, and let $\{x_k\}$ be a sequence generated by iteration (19), (20) or (21) with the cyclic order and the stepsize fixed at a positive constant, $\alpha_k\equiv\alpha>0$, under Assumption 1 (for (19), (20)) or Assumption 2 (for (21)) with constant $c$. Let $\beta$ be the constant of Proposition 3.
--
--   1. **(a)** If $F^*=-\infty$, then $\displaystyle\liminf_{k\to\infty}F(x_k)=F^*$.
--   2. **(b)** If $F^*>-\infty$, then
--   $$\liminf_{k\to\infty}F(x_k)\le F^*+\frac{\alpha\beta m^2c^2}{2}.$$
--
--   With a constant stepsize the method reaches a neighbourhood of the optimal value whose size shrinks to $0$ with $\alpha$.
--
--   **Formalization Note** $\liminf$ and $F^*$ are taken in the extended reals `EReal`, so both parts are meaningful when $F^*=-\infty$ or $F(x_k)$ is unbounded. $F^*<+\infty$ because $X$ is nonempty, so the extended-real sum in (b) is the ordinary one. Assumptions 1–2 hold "throughout this section" (p. 8) and are explicit hypotheses, as are the standing assumptions of p. 4 and $m\ge1$.
-- source:
--   Bertsekas, Incremental Proximal Methods for Large Scale Convex Optimization, LIDS-P-2847 (rev. March 2011), §3.1, p. 12, Proposition 4

import Mathlib
import Definitions.Def_IncProx_Cyclic_Basic

namespace IncProx.Cyclic

open Filter Topology

/-- Proposition 4 (p. 12). For a sequence generated by iteration (19), (20) or (21) with the cyclic
order and constant stepsize α_k = a > 0, under Assumption 1 or 2 with constant `c`:
(a) if F* = −∞ then liminf F(x_k) = F*; (b) if F* > −∞ then liminf F(x_k) ≤ F* + a β m² c² / 2,
with β the constant of Proposition 3. -/
theorem proposition4 {n m : ℕ} [NeZero m] (P : Problem n m) (hP : P.Standing) (A : Alg)
    (α : ℕ → ℝ) (a : ℝ) (ha : 0 < a) (hconst : ∀ k, α k = a) (x z gF gH : ℕ → Vec n)
    (hrun : IsRun P A cyc α x z gF gH) (c : ℝ) (hA : AssumptionFor P A x z gF gH c) :
    (P.Fstar = ⊥ → liminf (fun k => ((P.F (x k) : ℝ) : EReal)) atTop = P.Fstar) ∧
    (P.Fstar ≠ ⊥ → liminf (fun k => ((P.F (x k) : ℝ) : EReal)) atTop ≤
      P.Fstar + ((a * beta m A * (m : ℝ) ^ 2 * c ^ 2 / 2 : ℝ) : EReal)) := by sorry

end IncProx.Cyclic
