    rfl
  have hx' := gfp_chart_iso e hx₁
  refine ⟨fun m => x₁ m ≫ e.hom, hx', hv, fun a cc => gfp_inj hx' ?_⟩
  rw [gfpVec_tmap hx', hv, hv, gfpVec_tmap hx, Category.assoc]
