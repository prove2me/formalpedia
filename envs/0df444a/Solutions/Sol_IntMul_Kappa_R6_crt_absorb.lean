theorem Ncost6_ge (P : Prm) (n : ℕ) (hp : 1 ≤ pP6 P n) :
    ((dP6 P n : ℝ) + 1 ≤ Ncost6 P n) ∧
      ((ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ ≤ Ncost6 P n) := by
  have hp1 : (1 : ℝ) ≤ pP6 P n := by exact_mod_cast hp
  have hl0 : 0 ≤ Real.log (pP6 P n) := Real.log_nonneg hp1
  have a1 : 0 ≤ (ℓP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp := by positivity
  have a2 : 0 ≤ (dP6 P n : ℝ) * (pP6 P n : ℝ) ^ P.δ := by positivity
  have a3 : 0 ≤ (ℓP6 P n : ℝ) + Real.logb 2 (pP6 P n) := by
    have := Real.logb_nonneg (b := 2) (by norm_num) hp1; positivity
  have a4 : 0 ≤ (pP6 P n : ℝ) ^ P.δ := by positivity
  have a5 : 0 ≤ (ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ := by positivity
  unfold Ncost6 Ncost6R
  constructor <;> linarith

theorem crt_absorb_sol_aux (P : Prm) (n : ℕ) (hp : 6 ≤ pP6 P n) (K : ℝ) (hK : 0 ≤ K) (c1 : ℕ)
    (c T0 R : ℕ) (x : ℝ) (hx0 : 0 ≤ x)
    (hc : c ≤ c1 * T0 + R + 3 * ⌈x⌉₊)
    (hT0 : T0 ≤ 10 ^ 6 * ((dP6 P n + 1) * TP6 P n * pP6 P n))
    (hR : R ≤ 10 ^ 13 * ((dP6 P n + 1) * TP6 P n * pP6 P n))
    (hx : x ≤ K * (4 * (TP6 P n : ℝ) * pP6 P n *
      ((ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ) + 96 * (TP6 P n : ℝ) * pP6 P n)) :
    (c : ℝ) ≤ ((c1 : ℝ) * 10 ^ 6 + 10 ^ 13 + 300 * K + 3) * cU6 P n 0 := by
  obtain ⟨N1, N2⟩ := Ncost6_ge P n (by omega)
  have hU : cU6 P n 0 = (TP6 P n : ℝ) * pP6 P n * Ncost6 P n := by
    unfold cU6 VP6; rw [pow_zero, mul_one]
  rw [hU]
  have hT1 : 1 ≤ TP6 P n := Nat.one_le_two_pow
  generalize Ncost6 P n = N at *
  generalize hTd : TP6 P n = T at *
  generalize pP6 P n = p at *
  generalize dP6 P n = d at *
  generalize (ℓP6 P n : ℝ) * ((d : ℝ) * Real.log p) ^ P.τ = Lt at *
  have hTp : (1 : ℝ) ≤ (T : ℝ) * p := by
    have : 1 ≤ T * p := Nat.mul_pos (by omega) (by omega)
    exact_mod_cast this
  have hN1 : (1 : ℝ) ≤ N := by have : (0 : ℝ) ≤ d := Nat.cast_nonneg _; linarith
  have hceil : (⌈x⌉₊ : ℝ) ≤ x + 1 := (Nat.ceil_lt_add_one hx0).le
  have hcR : (c : ℝ) ≤ (c1 : ℝ) * T0 + R + 3 * ⌈x⌉₊ := by exact_mod_cast hc
  have hTp0 : (0 : ℝ) ≤ (T : ℝ) * p := by positivity
  have hX : (((d + 1) * T * p : ℕ) : ℝ) ≤ (T : ℝ) * p * N := by
    push_cast
    have : ((d : ℝ) + 1) * ((T : ℝ) * p) ≤ N * ((T : ℝ) * p) := mul_le_mul_of_nonneg_right N1 hTp0
    linarith
  have hT0' : (T0 : ℝ) ≤ 10 ^ 6 * ((T : ℝ) * p * N) := by
    have : (T0 : ℝ) ≤ 10 ^ 6 * (((d + 1) * T * p : ℕ) : ℝ) := by exact_mod_cast hT0
    linarith
  have hR' : (R : ℝ) ≤ 10 ^ 13 * ((T : ℝ) * p * N) := by
    have : (R : ℝ) ≤ 10 ^ 13 * (((d + 1) * T * p : ℕ) : ℝ) := by exact_mod_cast hR
    linarith
  have hx' : x ≤ 100 * K * ((T : ℝ) * p * N) := by
    have e1 : 4 * (T : ℝ) * p * Lt ≤ 4 * ((T : ℝ) * p * N) := by
      have := mul_le_mul_of_nonneg_left N2 hTp0
      linarith
    have e2 : 96 * (T : ℝ) * p ≤ 96 * ((T : ℝ) * p * N) := by
      have := mul_le_mul_of_nonneg_left hN1 hTp0
      linarith
    have := mul_le_mul_of_nonneg_left (add_le_add e1 e2) hK
    linarith
  have hC1 : (0 : ℝ) ≤ c1 := Nat.cast_nonneg _
  have hTpN : (1 : ℝ) ≤ (T : ℝ) * p * N := by nlinarith
  generalize (T : ℝ) * p * N = M at *
  have h1 := mul_le_mul_of_nonneg_left hT0' hC1
  have h2 : 3 * x ≤ 300 * (K * M) := by linarith
  have h3 : (3 : ℝ) ≤ 3 * M := by linarith
  have h4 : 0 ≤ K * M := by positivity
  linarith

