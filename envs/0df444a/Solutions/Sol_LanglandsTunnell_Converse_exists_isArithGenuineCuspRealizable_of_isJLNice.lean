  · rw [norm_mul, Complex.norm_real]
    exact mul_le_mul_of_nonneg_left (hbound T) (norm_nonneg _)
  · simpa using (tendsto_inv_atTop_zero (𝕜 := ℝ)).norm.mul_const (2 / (2 * Real.pi * |c|))

