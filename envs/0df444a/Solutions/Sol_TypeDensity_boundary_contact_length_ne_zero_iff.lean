    have hφW : φ W = 0 := by
      change Ideal.Quotient.factor htm (ρ (Ideal.Quotient.mk (Ideal.span {W}) W)) = 0
      rw [hρ2]; simp
    have hφa : φ (algebraMap R B (c (Fin.last d))) = 0 := by
