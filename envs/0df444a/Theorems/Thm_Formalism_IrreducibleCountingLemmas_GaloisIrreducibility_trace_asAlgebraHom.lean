theorem Formalism.IrreducibleCountingLemmas.GaloisIrreducibility.trace_asAlgebraHom {G V : Type} [Group G] [Fintype G] [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ G V) (e : MonoidAlgebra ℂ G) :
    LinearMap.trace ℂ V (ρ.asAlgebraHom e) = ∑ h, e.coeff h * ρ.character h := by sorry
