theorem existsUnique_of_injective_card {ι α : Type*} [Finite ι] (x : ι → α) (hx : Function.Injective x)
    (s : Finset α) (hmem : ∀ i, x i ∈ s) (hcard : s.card = Nat.card ι) :
    ∀ y ∈ s, ∃! i, x i = y := by
  classical
  intro y hy
  haveI := Fintype.ofFinite ι
  have himage : Finset.univ.image x = s := by
    apply Finset.eq_of_subset_of_card_le
    · intro a ha
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ha
      exact hmem i
    · rw [Finset.card_image_of_injective _ hx, Finset.card_univ, hcard, Nat.card_eq_fintype_card]
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp (himage ▸ hy)
  exact ⟨i, rfl, fun j hj => hx hj⟩

theorem card_image_univ_eq_natCard {ι α : Type*} [Fintype ι] [DecidableEq α] (x : ι → α) (hx : Function.Injective x) :
    (Finset.univ.image x).card = Nat.card ι := by
  rw [Finset.card_image_of_injective _ hx, Finset.card_univ, Nat.card_eq_fintype_card]

theorem mem_image_univ_iff_range {ι α : Type*} [Fintype ι] [DecidableEq α] (x : ι → α) (a : α) :
    a ∈ Finset.univ.image x ↔ a ∈ Set.range x := by
  simp [Finset.mem_image, Set.mem_range]

