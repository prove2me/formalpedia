-- title:
--   Lemma 2 (Dimension of Sn-equivariant unitaries)
-- statement:
--   Let $V_n$ be the full set of unitaries commuting with the qubit-permutation representation of $S_n$. For $0\le m\le\lfloor n/2\rfloor$ write $d_m=n-2m+1$. The commuting unitary family has the product-unitary description $V_n\simeq\prod_m U(d_m)$, and its real tangent space at the identity consists of skew-Hermitian commuting matrices. Its real dimension is
--
--   $$\dim_{\mathbb R}V_n=\sum_{m=0}^{\lfloor n/2\rfloor}(n-2m+1)^2=\binom{n+3}{3}=\Theta(n^3).$$
--
--   The asymptotic comparison uses positive constants and an eventual threshold independent of $n$. This describes all commuting unitaries, including their block phases, rather than identifying the Lie group generated by Eq. (9). The formula includes $n=0$.
-- source:
--   Theoretical Guarantees for Permutation-Equivariant Quantum Neural Networks, arXiv:2210.09974v3, PDF p. 5, Lemma 2 (Dimension of Sn-equivariant unitaries)

import Definitions.Def_QAlgorithms_Papers_Independent_Support50_P30

noncomputable section

open MeasureTheory

open scoped BigOperators ComplexConjugate Matrix.Norms.L2Operator NNReal ENNReal

namespace QAlgorithms.Papers.Independent.Support50.P30

/-- PDF pp.5,22, Lemma 2: full product-unitary family and real dimension;
this does not identify the Lie algebra generated by Eq.(9) with this tangent. -/
theorem equivariantUnitary_dimension :
    (∀ n : ℕ,
      Nonempty ((unitaryFamily n) ≃ₜ
        ((m : Sector n) → Matrix.unitaryGroup (Fin (blockDim n m)) ℂ)) ∧
      Module.finrank ℝ (tangentCommutant n) = (n + 3).choose 3 ∧
      (∑ m : Sector n, blockDim n m ^ 2) = (n + 3).choose 3) ∧
    ∃ a b : ℝ, 0 < a ∧ 0 < b ∧ ∃ N : ℕ, ∀ n ≥ N,
      a * (n : ℝ) ^ 3 ≤ (Module.finrank ℝ (tangentCommutant n) : ℝ) ∧
      (Module.finrank ℝ (tangentCommutant n) : ℝ) ≤ b * (n : ℝ) ^ 3 := by sorry

end QAlgorithms.Papers.Independent.Support50.P30

end
