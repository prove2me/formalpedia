-- Prove2me | Definitions.Def_SeasonalPricing_Announced_availability
-- name    : SeasonalPricing_Announced_availability
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-09-27T11:12:03.608792+00:00
-- url     : https://prove2.me/theorems/be2964ee-312c-4edb-a266-a37b5af2c31c
-- title:
--   Segment rates Λ_I, Λ_S, Λ_W, the allocation probability A(q | Λ), and the right-hand side of Eq. (8)
-- statement:
--   Customers arrive by a Poisson process with rate $\lambda$; base valuations have distribution function $F$ with tail $\bar F = 1 - F$. For a threshold function $\psi$ on $[0, T)$ and prices $p_1, p_2$, the expected numbers of customers in three segments are
--
--   $$
--   \Lambda_I(\psi) = \lambda\int_0^T \bar F\big(\psi(t)e^{\alpha t}\big)\,dt,
--   $$
--
--   $$
--   \Lambda_S(\psi, p_1, p_2) = \lambda\int_0^T \Big[\bar F\big(\min\{\max\{p_1e^{\alpha t}, p_2e^{\alpha T}\}, \psi(t)e^{\alpha t}\}\big) - \bar F\big(\psi(t)e^{\alpha t}\big)\Big]\,dt,
--   $$
--
--   $$
--   \Lambda_W(p_1, p_2) = \lambda\int_0^T \Big[\bar F\big(\min\{p_1e^{\alpha t}, p_2e^{\alpha T}\}\big) - \bar F\big(p_1e^{\alpha t}\big)\Big]\,dt:
--   $$
--
--   customers who buy immediately at $p_1$ (I), who could buy at $p_1$ but wait strategically and want to buy at $p_2$ (S), and who wait because their valuation was below $p_1$ and want to buy at $p_2$ (W).
--
--   With $P(x \mid \Lambda) = e^{-\Lambda}\Lambda^x / x!$ the Poisson probabilities, the **allocation probability** of $q$ units is
--
--   $$
--   A(q \mid \Lambda) = \sum_{y=0}^{\infty} \frac{q}{\max\{1+y,\ q\}}\, P(y \mid \Lambda),
--   $$
--
--   the probability that a given requester obtains one of $q$ units when a Poisson($\Lambda$) number $y$ of other customers also request one and units are rationed at random.
--
--   Finally, for a number $w$ let $\psi_A$ be the threshold of Eq. (7) built from $w$. The **availability** generated by $w$ is the right-hand side of Eq. (8),
--
--   $$
--   \mathrm{avail}(w) = \sum_{x=0}^{Q-1} P\big(x \mid \Lambda_I(\psi_A)\big)\cdot A\big(Q - x \mid \Lambda_S(\psi_A, p_1, p_2) + \Lambda_W(p_1, p_2)\big).
--   $$
--
--   By the proof of Theorem 2 this is the probability that a unit is allocated at time $T$ to a given customer who waits, when all other customers follow the threshold $\psi_A$: $x$ units are sold at the premium price, and the $Q - x$ remaining ones are shared among the waiting customers.
--
--   **Formalization Note** $F$ is `ProbabilityTheory.cdf μ` for a measure `μ` on `ℝ`; the integrals are interval integrals over $[0, T]$ (the integrands are bounded and measurable in $t$ for the thresholds used here). $P(x\mid\Lambda)$ is written out explicitly rather than via `poissonPMFReal`, so that $\Lambda$ stays a real number. $A$ is the infinite series as printed (a `tsum`); the finite closed form printed next to it on p. 346 is not used.
-- source:
--   Aviv and Pazgal, Optimal Pricing of Seasonal Products in the Presence of Forward-Looking Consumers, Manufacturing & Service Operations Management 10(3), 2008, p. 345, §4.2, displays defining Λ_I(ψ), Λ_S(ψ, p1, p2), Λ_W(p1, p2); p. 346, §4.3, display defining A(q | Λ); p. 348, Theorem 2, Eq. (8)

import Mathlib
import Definitions.Def_SeasonalPricing_Announced_purchaseRule

namespace SeasonalPricing.Announced

open MeasureTheory

/-- The tail `F̄(x) = 1 - F(x)` of the base-valuation distribution, `F = cdf μ`. -/
noncomputable def tail (μ : Measure ℝ) (x : ℝ) : ℝ := 1 - ProbabilityTheory.cdf μ x

/-- `Λ_I(ψ) = λ ∫_0^T F̄(ψ(t) e^{α t}) dt` (p. 345). -/
noncomputable def rateI (μ : Measure ℝ) (lam α T : ℝ) (ψ : ℝ → ℝ) : ℝ :=
  lam * ∫ t in (0 : ℝ)..T, tail μ (ψ t * Real.exp (α * t))

/-- `Λ_S(ψ, p1, p2) = λ ∫_0^T [F̄(min{max{p1 e^{α t}, p2 e^{α T}}, ψ(t) e^{α t}}) - F̄(ψ(t) e^{α t})] dt`
(p. 345). -/
noncomputable def rateS (μ : Measure ℝ) (lam α T : ℝ) (ψ : ℝ → ℝ) (p1 p2 : ℝ) : ℝ :=
  lam * ∫ t in (0 : ℝ)..T,
    (tail μ (min (max (p1 * Real.exp (α * t)) (p2 * Real.exp (α * T))) (ψ t * Real.exp (α * t)))
      - tail μ (ψ t * Real.exp (α * t)))

/-- `Λ_W(p1, p2) = λ ∫_0^T [F̄(min{p1 e^{α t}, p2 e^{α T}}) - F̄(p1 e^{α t})] dt` (p. 345). -/
noncomputable def rateW (μ : Measure ℝ) (lam α T : ℝ) (p1 p2 : ℝ) : ℝ :=
  lam * ∫ t in (0 : ℝ)..T,
    (tail μ (min (p1 * Real.exp (α * t)) (p2 * Real.exp (α * T))) - tail μ (p1 * Real.exp (α * t)))

/-- The Poisson probability `P(x | Λ) = e^{-Λ} Λ^x / x!` (p. 346). -/
noncomputable def poissonProb (Λ : ℝ) (x : ℕ) : ℝ := Real.exp (-Λ) * Λ ^ x / (x.factorial : ℝ)

/-- The allocation probability `A(q | Λ) = ∑_{y=0}^∞ (q / max{1 + y, q}) P(y | Λ)` (p. 346). -/
noncomputable def allocProb (q : ℕ) (Λ : ℝ) : ℝ :=
  ∑' y : ℕ, ((q : ℝ) / max (1 + (y : ℝ)) (q : ℝ)) * poissonProb Λ y

/-- The right-hand side of Eq. (8), p. 348, with `ψ_A` built from `w` by Eq. (7):
`∑_{x=0}^{Q-1} P(x | Λ_I(ψ_A)) · A(Q - x | Λ_S(ψ_A, p1, p2) + Λ_W(p1, p2))`. -/
noncomputable def availability (μ : Measure ℝ) (lam α T : ℝ) (Q : ℕ) (p1 p2 w : ℝ) : ℝ :=
  ∑ x ∈ Finset.range Q,
    poissonProb (rateI μ lam α T (psiA α T p1 p2 w)) x *
      allocProb (Q - x) (rateS μ lam α T (psiA α T p1 p2 w) p1 p2 + rateW μ lam α T p1 p2)

end SeasonalPricing.Announced


