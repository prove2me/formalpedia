-- Source module: Solutions.R6MCost
/-!
# Round-six machine: the cost of `bigE` in the unit `ZU6`

The frozen `KFMCost` at the round-six parameters. `ZU6 Q = T (p + 1 + fmB (8p)) + (b + 1)^6 + n`.
Every cost of `bigE` other than the interface calls is `O(ZU6 Q)`, and the descriptor parts of a
call are `O((b+1)^2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open Finset IntMul NLogN NLogN.KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

theorem M_le6 (Q : Q6) (hb : 2 ≤ Q.b) (hn : 2 ≤ Q.n) : Q.M ≤ Q.n := by
  show (Q.n + Q.b - 1) / Q.b ≤ Q.n
  apply Nat.div_le_of_le_mul
  have : Q.n + Q.b ≤ Q.b * Q.n := by nlinarith
  omega

section Passes

variable {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)
include hQ hD

theorem γ_eq6 : 2 * (D + 1) * Q.α ^ 2 = Q.γ := by rw [← hD]

theorem wU_le6 : wU6 Q D ≤ 2 * Q.p := by
  have h := hQ.hγ
  rw [← γ_eq6 hQ hD] at h
  have hb := hQ.hb
  have hp : Q.p = 6 * Q.b := Q.p_eq
  unfold wU6; omega

theorem eT2_6 : 2 ^ (Q.L + 1) = 2 * Q.T := by rw [pow_succ]; show _ = 2 * 2 ^ Q.L; ring

theorem fmB_le8_6 {m : ℕ} (hm : m ≤ 8 * Q.p) : KFM.fmB m ≤ KFM.fmB (8 * Q.p) := fmB_mono hm

theorem kShl_le6 : kShl6 Q D ≤ 10 ^ 6 * (Q.T * (Q.p + 1) + Q.p + 1) := by
  have hW := wU_le6 hQ hD
  have hb := hQ.hb
  unfold kShl6
  have c1 := cItem_le (2 ^ (Q.L + 1)) (1000 * (Q.p + 2 + 2 * (D + 1) * Q.α ^ 2 + 2))
    (Q.p + 2 + 2 * (D + 1) * Q.α ^ 2 + 1)
  have c2 := cCnt_le (2 ^ (Q.L + 1))
  have c3 := cW_pow (2 * (D + 1) * Q.α ^ 2)
  have c4 := cW_nat (2 ^ (Q.L + 1))
  rw [eT2_6 hQ hD] at c1 c2 c4 ⊢
  unfold wU6 at hW
  set X := 2 * (D + 1) * Q.α ^ 2 with hX
  set T := Q.T
  have hX' : X ≤ Q.p := by omega
  have m1 := Nat.mul_le_mul_left (2 * T) hX'
  have m2 := Nat.mul_le_mul_left (2 * T + 1) hX'
  nlinarith

theorem kGm_le6 : kGm6 Q D ≤ 10 ^ 8 * (Q.T * (Q.p + 1 + KFM.fmB (8 * Q.p)) + Q.p + 1) := by
  have hW := wU_le6 hQ hD
  have hF := fmB_le8_6 hQ hD (m := 2 * wU6 Q D) (by omega)
  unfold kGm6
  have c2 := cCnt_le (2 * 2 ^ Q.L)
  have c3 := cW_pow Q.p
  have c4 := cW_nat (2 * 2 ^ Q.L)
  have c5 := cW_nat (2 ^ Q.L)
  have eT : 2 ^ Q.L = Q.T := rfl
  rw [eT] at c2 c4 c5 ⊢
  set T := Q.T
  have m1 := Nat.mul_le_mul_left (4 * T) hF
  have m2 := Nat.mul_le_mul_left (T + 1) hW
  nlinarith

theorem kCj_le6 {B : ℕ} (hB : B ≤ 3 * Q.p) :
    kCj6 Q B ≤ 10 ^ 6 * (Q.T * (Q.p + 1) + Q.p + 1) := by
  unfold kCj6
  have c1 := cConj_le (2 ^ Q.L) B
  have c4 := cW_nat (2 * 2 ^ Q.L)
  have c5 := cW_nat (2 ^ Q.L)
  have eT : 2 ^ Q.L = Q.T := rfl
  rw [eT] at c1 c4 c5 ⊢
  set T := Q.T
  set p := Q.p
  have m2 := Nat.mul_le_mul_left (T + 1) hB
  have e1 : (T + 1) * (3 * p) = 3 * (T * p) + 3 * p := by ring
  have e2 : T * (p + 1) = T * p + T := by ring
  have e3 : 10000 * (T + 1) * (B + 2) = 10000 * ((T + 1) * B) + 20000 * T + 20000 := by ring
  rw [e3] at c1; rw [e1] at m2; rw [e2]
  omega

theorem cCarU_le6 : cCarU Q.b (Q.p + 2) Q.S ≤ 10 ^ 7 * (Q.T * (Q.p + 1) + Q.p + 1) := by
  have hS : Q.S ≤ Q.T := hQ.S_le_T hD
  have hb := hQ.hb
  unfold cCarU
  have c1 := cCar_le Q.b (Q.p + 2) Q.S
  have c2 := cCnt_le Q.S
  have d1 : dupCost (Q.b + 1) + 17 ≤ 135 * (Q.b + 3) := by
    simp only [dupCost, zipCost, moveCost]; omega
  have hbp : Q.b ≤ Q.p := by rw [Q.p_eq]; omega
  set T := Q.T
  have m1 := Nat.mul_le_mul_right (Q.p + 2 + Q.b + 1) (Nat.succ_le_succ hS)
  have m2 := Nat.mul_le_mul_left (T + 1) hbp
  nlinarith

theorem kDig_le6 : kDig6 Q ≤ 10 ^ 7 * (Q.T * (Q.p + 1) + Q.n + Q.p + 1) := by
  have hS : Q.S ≤ Q.T := hQ.S_le_T hD
  have hb := hQ.hb
  have hM := M_le6 Q (by omega) (by have := hQ.hn3; omega)
  have hMb : Q.M * Q.b ≤ Q.n + Q.b := by
    show (Q.n + Q.b - 1) / Q.b * Q.b ≤ _
    have := Nat.div_mul_le_self (Q.n + Q.b - 1) Q.b; omega
  unfold kDig6
  have c1 := cDigU_le Q.b Q.e Q.M Q.S
  have w1 := cW_pow Q.e
  have w2 := cW_nat (2 * (Q.S - Q.M))
  have w3 := cW_nat Q.M
  have w4 := cW_pow Q.b
  have hp : Q.p = 6 * Q.b := Q.p_eq
  have he : Q.e ≤ 5 * Q.b := by show Q.p - Q.b - 2 ≤ _; omega
  set T := Q.T
  have m1 : (Q.M + 1) * (Q.b + Q.e + 1) ≤ 7 * (Q.n + Q.b) + 6 * Q.b + 1 + 7 * Q.M := by
    have : (Q.M + 1) * (Q.b + Q.e + 1) ≤ (Q.M + 1) * (6 * Q.b + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    nlinarith
  have hpT : 1 ≤ T := Nat.one_le_two_pow
  have hsub := Nat.sub_le Q.S Q.M
  nlinarith

end Passes

/-! ## Descriptors -/

theorem bits_mem6 {d : ℕ} {bL : ℕ → Bool} {x : ℤ} (hx : x ∈ bitsZ d bL) : 0 ≤ x ∧ x ≤ 1 := by
  simp only [bitsZ, List.mem_map, List.mem_range] at hx
  obtain ⟨j, -, rfl⟩ := hx
  split_ifs <;> norm_num

theorem muInv_lt (P s : ℕ) (hs : 1 ≤ s) : muInv P s < s := by
  unfold muInv
  have hs0 : (0 : ℤ) < s := by exact_mod_cast hs
  have h1 := Int.emod_lt_of_pos (Nat.gcdA P s) hs0
  have h2 := Int.emod_nonneg (Nat.gcdA P s) hs0.ne'
  omega

section Desc

variable {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)
include hQ hD

theorem small_facts6 : Q.p + 2 ≤ 2 ^ Q.b ∧ Q.h ≤ 2 ^ Q.b ∧ Q.d ≤ 2 ^ Q.b ∧
    Q.α ≤ 2 ^ Q.b ∧ Q.K ≤ 2 ^ Q.b ∧ Q.p ≤ 2 ^ Q.b ∧
    (∀ j < Q.d, Q.src j ≤ 2 ^ Q.b ∧ Q.mu j ≤ 2 ^ Q.b) := by
  have hb := hQ.hb
  have hdb := hQ.hdb
  have hbp : 8 * (Q.b - 2) ≤ 2 ^ Q.b := by
    have := Nat.lt_two_pow_self (n := Q.b - 3)
    have e : 2 ^ Q.b = 2 ^ (Q.b - 3) * 8 := by
      rw [show (8 : ℕ) = 2 ^ 3 by norm_num, ← pow_add]; congr 1; omega
    omega
  have hα := α_le6 hQ hD
  have hK := K_le6 hQ hD
  have hl := ell_le_L6 hQ hD
  have hL := L_le_b6 hQ hD
  have hs := hQ.h_succ
  have hp : Q.p = 6 * Q.b := Q.p_eq
  refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, fun j hj => ?_⟩
  have h1 : Q.src j < tF6 Q.P Q.n j := hQ.hlt j hj
  have h2 : tF6 Q.P Q.n j ≤ 2 ^ Q.b := by
    have := t_le6 hQ hD ⟨j, by omega⟩
    exact this.trans (Nat.pow_le_pow_right (by norm_num) (by omega))
