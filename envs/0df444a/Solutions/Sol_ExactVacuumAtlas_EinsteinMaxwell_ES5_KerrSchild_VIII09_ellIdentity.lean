theorem solution (j ε : ℝ) {R : ℝ} (hR : 3 < R)
    (h1 : 1 + ε ^ 2 * uA j R ≠ 0) (h2 : 1 + ε ^ 2 * zA j R ≠ 0) :
    (1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R)
        * (ellFun (fE j ε) (mE j ε) (N0 3 1) (wE j ε) (pE j ε) (aE j ε) R + 2 * ε * j)
      = ellP j ε R := by
  have hN := N0_ne hR
  have hR0 : (R:ℝ) ≠ 0 := by linarith
  have hp := deriv_pE j ε hR
  have hw := deriv_wE j ε hR
  have ha := deriv_aE j ε hR
  unfold ellFun Radial.Kfun Radial.qFun Radial.eFun ellP
    ellE1 ellE3 ellE5 ellE7 ellE9 ellE11
  rw [hp, hw, ha]
  unfold fE mE wE aE v1f d3f c3f b1f e2A e4A e6A f0 m0
  simp only [b1f, v1f, c3f, d3f]
  field_simp
  ring
