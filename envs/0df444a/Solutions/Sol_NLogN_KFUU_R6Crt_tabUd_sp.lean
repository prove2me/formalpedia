-- Source module: Solutions.KFUURot1
/-!
# KFUU §7a: register programs for the uniform shifts — helpers and the stage lists

The uniform prefix-controlled shift of target `i` (sizes `s_j = sF j`, coefficient list
`cs = cF neg sF μ Q`) computes the stage data of KIL4's uniform table generator at run time:

* `Pv sF j = ∏_{k<j} s_k`;
* `stgM_rev` / `stgAM_rev`: closed forms of the stage stacks `stgM`, `stgAM` of the
  stage list `(A.zip cs).reverse` (`A = [s_0, …, s_{i-1}]`): `P_i / P_{j+1}` and `P_i / P_j`;
* `encK_lift`: a stack prefix of the unmanaged part becomes managed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-! ## Managed-state helpers -/

theorem ok_regS {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {L : List Item}
    (hf : f i = []) (h : s.G i = .int a :: L) : (Ex.reg i).ok (encK s f) :=
  IState.isInt_of (s := encK s f) (L := L) (a := a) (by rw [encK_G, hf, h]; rfl)

theorem top_regS {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {L : List Item}
    (hf : f i = []) (h : s.G i = .int a :: L) : (encK s f).top i = a :=
  IState.top_eq (L := L) (by rw [encK_G, hf, h]; rfl)

theorem eval_regS {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {L : List Item}
    (hf : f i = []) (h : s.G i = .int a :: L) : (Ex.reg i).eval (encK s f) = a :=
  top_regS hf h

/-! ## Prefix products and the stage lists -/

theorem Pv_succ (sF : ℕ → ℕ) (j : ℕ) : Pv sF (j + 1) = Pv sF j * sF j := by
  simp [Pv, List.range_succ, vol_append, vol]

theorem Pv_pos (sF : ℕ → ℕ) {i : ℕ} (hs : ∀ j < i, 1 ≤ sF j) : ∀ j ≤ i, 1 ≤ Pv sF j
  | 0, _ => by simp [Pv, vol]
  | j + 1, hj => by
    rw [Pv_succ]; exact Nat.mul_pos (Pv_pos sF hs j (by omega)) (hs j (by omega))

/-- `vol` of the fields `j+1, …, i-1`: `P_i / P_{j+1}`. -/
theorem vol_drop_range (sF : ℕ → ℕ) {i : ℕ} (hs : ∀ j < i, 1 ≤ sF j) (j : ℕ) (hj : j ≤ i) :
    vol (((List.range i).map sF).drop j) = Pv sF i / Pv sF j := by
  have h1 : vol ((List.range i).map sF) =
      vol (((List.range i).map sF).take j) * vol (((List.range i).map sF).drop j) := by
    rw [← vol_append, List.take_append_drop]
  have h2 : ((List.range i).map sF).take j = (List.range j).map sF := by
    rw [← List.map_take, List.take_range, min_eq_left hj]
  rw [h2] at h1
  have hp := Pv_pos sF hs j hj
  unfold Pv; rw [h1, Nat.mul_div_cancel_left _ (by unfold Pv at hp; omega)]

theorem stgM_append (l1 l2 suf : List (ℕ × ℕ)) :
    stgM (l1 ++ l2) suf = stgM l1 suf ++ stgM l2 (l1.reverse ++ suf) := by
  induction l1 generalizing suf with
  | nil => simp [stgM]
  | cons x l1 ih => simp [stgM, ih, List.reverse_cons, List.append_assoc]

theorem stgAM_append (l1 l2 suf : List (ℕ × ℕ)) :
    stgAM (l1 ++ l2) suf = stgAM l1 suf ++ stgAM l2 (l1.reverse ++ suf) := by
  induction l1 generalizing suf with
  | nil => simp [stgAM]
  | cons x l1 ih => simp [stgAM, ih, List.reverse_cons, List.append_assoc]

theorem stgM_rev : ∀ (ac suf : List (ℕ × ℕ)),
    stgM ac.reverse suf = ((List.range ac.length).map fun j =>
      ((vol (((ac.drop (j + 1)) ++ suf).map Prod.fst) : ℕ) : ℤ)).reverse
  | [], suf => by simp [stgM]
  | y :: ac, suf => by
    rw [List.reverse_cons, stgM_append, stgM_rev ac suf, List.reverse_reverse]
    simp only [stgM, List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map,
      List.reverse_cons, List.drop_succ_cons, List.drop_zero]
    rfl

theorem stgAM_rev : ∀ (ac suf : List (ℕ × ℕ)),
    stgAM ac.reverse suf = ((List.range ac.length).map fun j =>
      ((vol (((ac.drop j) ++ suf).map Prod.fst) : ℕ) : ℤ)).reverse
  | [], suf => by simp [stgAM]
  | y :: ac, suf => by
    rw [List.reverse_cons, stgAM_append, stgAM_rev ac suf, List.reverse_reverse]
    simp only [stgAM, List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map,
      List.reverse_cons, List.drop_succ_cons, List.drop_zero]
    simp [Function.comp_def, vol_cons]

end NLogN.KFUU

end

