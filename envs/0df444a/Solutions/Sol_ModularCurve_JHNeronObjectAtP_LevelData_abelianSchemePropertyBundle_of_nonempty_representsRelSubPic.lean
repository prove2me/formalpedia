  haveI hθ : IsIso (C := Scheme) θ.1 := ⟨⟨θ'.1, h1, h2⟩⟩
  have hf : Λ.f = θ.1 ≫ D.toBase := θ.2.symm
  refine ⟨?_, ?_, ?_, ⟨Λ.L⟩⟩
  · rw [hf]; exact (MorphismProperty.cancel_left_of_respectsIso @Smooth θ.1 D.toBase).mpr hsm
  · rw [hf]; exact (MorphismProperty.cancel_left_of_respectsIso @IsProper θ.1 D.toBase).mpr hpr
  · intro s
    haveI : GeometricallyConnected D.toBase := hgc
    have hc : _root_.IsConnected (D.toBase.base ⁻¹' {s}) := D.toBase.isConnected_preimage_singleton s
    rw [hf]
    have key : (θ.1 ≫ D.toBase).base ⁻¹' {s} = θ.1.base ⁻¹' (D.toBase.base ⁻¹' {s}) := rfl
    rw [key]
    exact (Scheme.Hom.homeomorph θ.1).isConnected_preimage.mpr hc

