        3 / 2 * ((3 / 4 + (n : ℝ) / 2) / S) + (n : ℝ) * Z / (2 * S) ≤
        (Z + 1) * ((n : ℝ) + 1 + 1) ^ 2 / S := by
      have e1 : 3 / 2 * (1 / (2 * S)) * Z + (Z + 1) * ((n : ℝ) + 1) ^ 2 / S + 1 / (2 * S) +
          3 / 2 * ((3 / 4 + (n : ℝ) / 2) / S) + (n : ℝ) * Z / (2 * S) =
          (3 / 4 * Z + (Z + 1) * ((n : ℝ) + 1) ^ 2 + 1 / 2 + 3 / 2 * (3 / 4 + (n : ℝ) / 2) +
            (n : ℝ) * Z / 2) / S := by field_simp; ring
      rw [e1]; apply div_le_div_of_nonneg_right _ hS.le
      have e2 : (Z + 1) * ((n : ℝ) + 1 + 1) ^ 2 - (3 / 4 * Z + (Z + 1) * ((n : ℝ) + 1) ^ 2 + 1 / 2 +
          3 / 2 * (3 / 4 + (n : ℝ) / 2) + (n : ℝ) * Z / 2) =
          3 / 2 * ((n : ℝ) * Z) + 9 / 4 * Z + 5 / 4 * n + 11 / 8 := by ring
      have := mul_nonneg hnn hZ0
      linarith
    linarith

end ge

