/-!
# B5: the contract `PreU6`

`preU6_holds`: for every plan and every table, `PreU6 P pl tab` holds. The family `U` has four
procedures, the native pairs `eCn / tearP` (chunk pass) and `eJn / tearP` (`J` pass), relocated
by the permutation of `nativeLayout`; `Cp = 2`, `A = 0`. Hence `PreNeed6 P pl` (`preNeed6_holds`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function IntMul.Kappa.R6 J6Seg.Side

theorem Znf_val (dA : Fin HS) :
    ((Znf dA).val = 55 ∧ dA.val = 55) ∨ ((Znf dA).val = 49 ∧ dA.val ≠ 55) := by
  unfold Znf; split_ifs with h
  · left; exact ⟨rfl, h⟩
  · right; exact ⟨rfl, h⟩

theorem oNf_inj (ρ : Fin 19 → Fin HS) (hρ : Injective ρ) : Injective (oNf ρ) := by
  have hO55 : ∀ i, (oNf ρ i).val = 55 ↔ (ρ i).val = 55 := by
    intro i; unfold oNf; split_ifs with h
    · simp [h]
    · simp only [h, iff_false]; have := i.2; omega
  intro i j h
  rcases oNf_val ρ i with hi | ⟨hi, hi'⟩ <;> rcases oNf_val ρ j with hj | ⟨hj, hj'⟩
  · exact hρ (Fin.ext (by rw [(hO55 i).mp hi, (hO55 j).mp hj]))
  · have := congrArg Fin.val h; have := j.2; omega
  · have := congrArg Fin.val h; have := i.2; omega
  · have := congrArg Fin.val h; exact Fin.ext (by omega)

theorem rg_vals : ∀ j : Fin HS, j ∈ rg → j.val ≠ 49 ∧ j.val ≠ 55 := by decide

/-- **`PreU6` holds.** -/
theorem preU6_holds_sol_aux (P : Prm) (hP : P.Ok) (pl : Plan6) (tab : Fin 1 → IStmt HS 1) :
    PreU6 P pl tab := by
  intro ρ dA hρ hd h0 hd0 hlt hdlt
  obtain ⟨σ, hσ, hZ, hO⟩ := nativeLayout ρ dA hρ hd hlt hdlt
  set Zn := Znf dA with hZnd
  set oN := oNf ρ with hoNd
  have hZv : Zn.val = 49 ∨ Zn.val = 55 := by
    rcases Znf_val dA with ⟨h, -⟩ | ⟨h, -⟩
    · right; exact h
    · left; exact h
  have hne : ∀ c : Fin HS, c.val ≠ 49 → c.val ≠ 55 → Zn ≠ c := fun c a b h => by
    rw [h] at hZv; omega
  have hinj : Injective oN := oNf_inj ρ hρ
  have hoV : ∀ i, (oN i).val = 55 ∨ (oN i).val ≤ 19 := fun i => by
    rcases oNf_val ρ i with h | ⟨h, -⟩
    · left; exact h
    · right; have h' : (oN i).val = i.val + 1 := h; have := i.2; omega
  have hlt' : ∀ i, (oN i).val < 56 := fun i => by rcases hoV i with h | h <;> omega
  have hon : ∀ i (c : Fin HS), 20 ≤ c.val → c.val ≠ 55 → oN i ≠ c := fun i c a b h => by
    rcases hoV i with h' | h' <;> rw [h] at h' <;> omega
  have hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC := fun i =>
    ⟨hon i _ (by decide) (by decide), hon i _ (by decide) (by decide),
      hon i _ (by decide) (by decide), hon i _ (by decide) (by decide),
      hon i _ (by decide) (by decide)⟩
  have hZo : ∀ i, oN i ≠ Zn := by
    intro i h
    rcases Znf_val dA with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rcases oNf_val ρ i with h3 | ⟨h3, h4⟩
      · have h5 : (ρ i).val = 55 := by
          unfold oNf at h3; split_ifs at h3 with h6
          · exact h6
          · have h7 : i.val + 1 = 55 := h3
            have := i.2; omega
        exact hd i (Fin.ext (by rw [h5, h2]))
      · have e1 : (oN i).val = Zn.val := congrArg Fin.val h
        have e2 : Zn.val = 55 := h1
        have e3 : (oN i).val = i.val + 1 := h3
        have := i.2; omega
    · have e1 : (oN i).val = Zn.val := congrArg Fin.val h
      have e2 : Zn.val = 49 := h1
      rcases hoV i with h3 | h3 <;> omega
  have hZ' : Zn ∉ rg := fun h => by
    have := rg_vals Zn h; omega
  have hZ5 : Zn.val < 56 := by omega
  obtain ⟨nc, hC⟩ := chunk_native P hP pl (Zn := Zn) (oN := oN) hZ' hZ5
    (hne _ (by decide) (by decide)) (hne _ (by decide) (by decide))
    (hne _ (by decide) (by decide))
    ⟨hne _ (by decide) (by decide), hne _ (by decide) (by decide), hne _ (by decide) (by decide),
      hne _ (by decide) (by decide), hne _ (by decide) (by decide), hne _ (by decide) (by decide),
      hne _ (by decide) (by decide), hne _ (by decide) (by decide), hne _ (by decide) (by decide),
      hne _ (by decide) (by decide)⟩
    hinj hlt' hx hZo
  obtain ⟨nj, hJ⟩ := j_native P hP pl (Zn := Zn) (oN := oN) hZ' hZ5
    (hne _ (by decide) (by decide)) (hne _ (by decide) (by decide)) hZv
    (hne _ (by decide) (by decide)) hinj hlt' hx hZo
  refine ⟨4, fun E idx i => (![((eCn pl Zn oN).ren σ).code, ((tearP oN).ren σ).code,
      ((eJn pl.kA pl.kC pl.wA pl.wC Zn oN).ren σ).code, ((tearP oN).ren σ).code] :
      Fin 4 → IStmt HS (7 + E)) i, 0, 1, 2, 3, 2, 0, max nc nj, by norm_num, ?_⟩
  intro n hn src hs D hD k hk E ext idx hU Isym
  obtain ⟨cU, cD, SU, SD, hcu, hcd⟩ := hC n (by omega) src hs D hD k hk 0
  obtain ⟨jU, jD, SJU, SJD, hju, hjd⟩ := hJ n (by omega) src hs D hD k hk 0
  have e2 : (2 : ℝ) * cU6 P n 0 / (D + 1) = 2 * (cU6 P n 0 / (D + 1)) := by ring
  have h0' : (0 : ℝ) ≤ cU6 P n 0 / (D + 1) := le_trans (by positivity) hjd
  constructor
  · exact setup_of_native Isym _ (idx 0) (idx 1) ρ dA _ _ _ σ hσ Zn oN hinj hZ hO _ _
      (by rw [hU]; rfl) (by rw [hU]; rfl) cU cD SU SD (by rw [e2]; exact hcu)
      (by rw [e2]; exact hcd)
  · exact setup_of_native Isym _ (idx 2) (idx 3) ρ dA _ _ _ σ hσ Zn oN hinj hZ hO _ _
      (by rw [hU]; rfl) (by rw [hU]; rfl) jU jD SJU SJD (by rw [e2]; linarith)
      (by rw [e2]; linarith)

end J6Seg.PJ
end

