open ModularCurve

theorem ModularCurve.finrank_adjoin_jqN_sq_of_not_mem (F : IntermediateField ℚ (LaurentSeries ℚ)) (hj : jq ∈ F) (p : ℕ) [hp : Fact (Nat.Prime p)] (hjp : jqN p ∈ F) (hF : jqN (p * p) ∉ F) : Module.finrank F (IntermediateField.adjoin F ({jqN (p * p)} : Set (LaurentSeries ℚ))) = p := by sorry
