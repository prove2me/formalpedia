    (x y z w : ℚ)
    (hnz : NonzeroQuadruple x y z w)
    (hq : canonicalQuadric x y z w = 0)
    (hc : canonicalCubic x y z w = 0)
    (hnc : ¬ IsCanonicalCusp25 x y z w) :
