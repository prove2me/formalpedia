-- Source module: Solutions.R6IL3Top16
/-!
# Round six, item language (I3): the uniform Proposition 14 with explicit size hypotheses

**`p14UH'_of`**: for a configuration `c` (`CfgOK c`), exponents `0 ≤ τ ≤ θ ≤ lamp ≤ 1`, a
level constant `Cc` with the moment condition of `cbRec_of`, and compact-control row additions
`RowUCCP c.m τ tab` in every extension of `kTableP tab`, the uniform Proposition 14
`P14UH' tab (EwH c) lamp` holds, with `K₀ = K0c c = 2^{Zc c}` and `C₀ = C0c c Kc Cc`.

The procedure list `UUH` places the level procedure (`0`), the kernel loop (`1`), the
size loop (`2`), the field-width loop (`3`), the depth loop with the core and the body (`4`),
the entry (`5`), and then the row procedures.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx IntMul.Kappa.R6.IL IntMul.Kappa.R6.IL3

theorem UUH_row (c : Cfg) (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (E : ℕ)
    (idx : Fin (6 + nR) → Fin (7 + E)) (q : Fin nR) :
    UUH c nR UR rowC E idx ⟨q.val + 6, by omega⟩ = UR E (iRH idx) q := by
  unfold UUH
  simp only [Fin.val_mk, show ¬ (q.val + 6 < 6) by omega, dite_false, Nat.add_sub_cancel, Fin.eta]

/-- The hypotheses of `P14NeedH'` bundled as `Hyp14`. -/
theorem hyp14_of {c : Cfg} {K r Z P D S p w : ℕ} {lamp : ℝ} (hl0 : 0 ≤ lamp) (hl1 : lamp ≤ 1)
    (hK6 : 6 ≤ K) (hr : 1 ≤ r) (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (hD : 1 ≤ D) (hZ32 : zsz ((32 * (vol (layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z)
    (hp : zsz (p : ℤ) ≤ Z) (hEw : EwH c D ≤ w + 1) (hwZ : w + EwH c D + 2 < 2 ^ Z)
    (hrZ : 2 * (2 * Z + 4) ^ 3 + 2 ≤ r)
    (h1 : zsz ((vol (layerShape P K D S) * r + w + EwH c D : ℕ) : ℤ) ≤ p)
    (h2 : (p + K0c c) ^ 5 ≤ 2 ^ K)
    (h3 : ((K0c c * D * (zsz (p : ℤ) + 1) : ℕ) : ℝ) ≤ K * (D : ℝ) ^ lamp) :
    Hyp14 c P K D S r p w Z lamp := by
  have hvol : vol (layerShape P K D S) = P * 2 ^ (K * D) * S := KFM.vol_layer_eq P K D S
  rw [hvol] at hZ32 h1
  exact ⟨hK6, hr, hKZ, hS, hP, hD, hZ32, hp, hEw, hwZ, hrZ, h1, h2, h3, hl0, hl1⟩

set_option maxHeartbeats 4000000 in
/-- **The round-six uniform Proposition 14, explicit-hypothesis form.** -/
theorem p14UH'_of_sol_aux (c : Cfg) (hc : CfgOK c) {τ θ Cc lamp : ℝ} (hτ0 : 0 ≤ τ) (hτθ : τ ≤ θ)
    (hθl : θ ≤ lamp) (hl1 : lamp ≤ 1) (hCc0 : 0 ≤ Cc)
    (hCc : ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) + 18 * c.Wr * c.net.length * 2 ^ τ +
      C1H c ≤ Cc * ((c.W : ℝ) - momH c θ))
    (tab : Fin 1 → IStmt HS 1) (hrow : RowUCCP c.m τ tab) : P14UH' tab (EwH c) lamp := by
  obtain ⟨nR, UR, rowC, Kc, hKc, HR⟩ := hrow
  have hl0 : 0 ≤ lamp := by linarith
  have hθ0 : 0 ≤ θ := by linarith
  refine ⟨6 + nR, UUH c nR UR rowC, ⟨5, by omega⟩, 36, K0c c, C0c c Kc Cc, rfl,
    C0c_nonneg c hKc hCc0, ?_⟩
  intro E ext idx hidx Isym
  set tbl := kTableP tab ext
  set jL := idx ⟨0, by omega⟩
  set jK := idx ⟨1, by omega⟩
  set jZ := idx ⟨2, by omega⟩
  set jG := idx ⟨3, by omega⟩
  set jD := idx ⟨4, by omega⟩
  have hL : tbl jL = levCH c jL (rowC E (iRH idx)) := by rw [hidx]; rfl
  have hKt : tbl jK = kerLoopC jK jL := by rw [hidx]; rfl
  have hZt : tbl jZ = zloopC c jZ (zcontC jG) := by rw [hidx]; rfl
  have hGt : tbl jG = gloopC czH jG (gcontC jD) := by rw [hidx]; rfl
  have hDt : tbl jD = dloopC c.m c.W jD (coreCH c (cWc c) (bodyCH c jK jL)) := by rw [hidx]; rfl
  have hM : tbl (idx ⟨5, by omega⟩) = p14CH jZ := by rw [hidx]; rfl
  have hRow : RowUCC c.m τ Isym tbl (rowC E (iRH idx)) Kc :=
    HR E ext (iRH idx) (fun q => by
      show tbl (idx ⟨q.val + 6, by omega⟩) = UR E (iRH idx) q
      rw [hidx]; exact UUH_row c nR UR rowC E idx q) Isym
  -- the representation guarantees (from the frozen KFM table, `E = 0`)
  obtain ⟨A', Kc', hKc', HP⟩ := KFM.prop14Ph_kTable (E := 0) (Fin.elim0)
  intro K r Z P D S ρ p w hρ hK6 hr hKZ hS hP hD hZ32 hp hEw hwZ hrZ hNZ h1 h2 h3 st f zs l xs hx hl
    h0 hdesc hfree hb hdisk
  have h := hyp14_of hl0 hl1 hK6 hr hKZ hS hP hD hZ32 hp hEw hwZ hrZ h1 h2 h3
  have hvol : vol (layerShape P K D S) = P * 2 ^ (K * D) * S := KFM.vol_layer_eq P K D S
  obtain ⟨Cc', E', dC, kC, -, -, -, HPr⟩ := HP Isym hK6 hr hKZ hρ hS hP hD hZ32
  set f0 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (f 0)
  have hf0 : Clean0 f0 := fun j hj => by simp [f0, hj]
  obtain ⟨zs', hzs', hgb, herr, -⟩ := HPr st f0 zs l xs p w hx hl (by simp [f0, h0]) hf0.clN hb hdisk
  have hex : ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
      (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) := ⟨zs', hzs'⟩
  have hch : Classical.choose hex = zs' := recRep_uniq (Classical.choose_spec hex) hzs'
  -- the level claims and the run
  have LV := lvAllH hc hL hRow hKc hτ0 hτθ hCc0 hCc h
  have h36 : f 36 = [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ),
      (Z : ℤ)] := hdesc
  have hfree' : ∀ j : Fin HS, j ≠ 0 → j ≠ 36 → j.val < 50 → f j = [] :=
    fun j a b c' => hfree j ⟨a, b, Or.inl c'⟩
  have hHZ : zsz (((chV c (cWc c) P K D S r w).H : ℕ) : ℤ) ≤ Z :=
    zsz_nat_le_of_lt (by have := h.H_lt; omega)
  have Rc := p14QH (Isym := Isym) (tbl := tbl) hc (cWc c) (W_le_cWc c) jZ jG jD jK jL
    (rowC E (iRH idx)) hZt hGt hDt hKt hL (Zr := 3 * Z) (Bz := 3 * Z)
    (CB := CBc c Kc (chV c (cWc c) P K D S r w).G Cc θ) (LV 1) hρ (by omega) hS hP hr hD
    (h.hKW hc) (h.hGm hc) h.Z32 hHZ (h.VbH_top hc hρ) (h.Mb_lt hc)
    (fun hlt => h.midPre hc hρ LV hlt) (h.Etot_Z hc) (h.body_w hc) hp (by have := h.wZ; omega)
    st f zs l xs hx hl h0 h36 hfree' hb hdisk hex
  rw [hch] at Rc
  refine ⟨zs', cP14 c Kc Cc θ P K D S r w Z, hzs', hgb, herr, IRuns.call (by rw [hM]; exact Rc), ?_⟩
  have HC := h.cost hc hKc hCc0 hθ0 hθl
  rw [hvol]
  push_cast at HC ⊢
  exact HC

end IntMul.Kappa.R6.IL3H

