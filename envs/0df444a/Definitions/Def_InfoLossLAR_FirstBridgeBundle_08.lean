    ((_root_.Integration9_9.LARCoinLayout.queryWireSlots Q.padding word).length + 1)





theorem bodyFlagAddresses_length (Q : _root_.Integration9_9.GenericBody.QueryProgram) (word : Str) :
    (_root_.Integration9_9.GenericBody.bodyFlagAddresses Q word).length = Q.padding.eval word.length + 1 := by
  simp only [_root_.Integration9_9.GenericBody.bodyFlagAddresses,_root_.InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit.generatedAddressRange,List.length_map,List.length_range,
