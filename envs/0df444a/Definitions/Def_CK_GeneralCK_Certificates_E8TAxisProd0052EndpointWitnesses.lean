    centerALowerYBox.Contains (Y (lower E8TAxisProd0052PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0052PaddedInputs.centerAInput.alpha = ((3165742448647063503620071141085134670978008272 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
