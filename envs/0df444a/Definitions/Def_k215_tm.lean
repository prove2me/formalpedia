def haltLabel : Nat := 215

def move (a : Action) (l r : Nat) : State :=
  let w := a.1
  let d := a.2.1
  let t := a.2.2
  if d = 0 then
    { q := t, l := l / 2, r := l % 2 + 2 * w + 4 * (r / 2) }
  else
    { q := t, l := 2 * l + w, r := r / 2 }

def step (s : State) : State :=
  if s.q < haltLabel then move (action s.q (s.r % 2)) s.l s.r else s

def initial : State := { q := 0, l := 0, r := 0 }

def run : Nat → State → State
  | 0, s => s
  | n + 1, s => step (run n s)

def Halts : Prop := ∃ n : Nat, (run n initial).q = haltLabel

