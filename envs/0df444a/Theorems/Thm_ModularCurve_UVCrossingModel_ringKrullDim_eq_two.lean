theorem ModularCurve.UVCrossingModel.ringKrullDim_eq_two {W : Type*} [CommRing W] [IsNoetherianRing W] [IsLocalRing W] [IsDomain W] {π : W} (hW : IsLocalRing.maximalIdeal W = Ideal.span {π}) (hπ0 : π ≠ 0) : ringKrullDim (UVCrossingModel W π) = 2 := by sorry
