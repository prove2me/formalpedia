-- title:
--   Macaulay's bound is attained by a homogeneous ideal
-- statement:
--   Let $n$ and $d$ be natural numbers with $d \ge 1$, let $a$ be a natural number with $a \le \binom{n+d}{n}$ (the dimension of the space of forms of degree $d$ in $n+1$ variables), and let $K$ be a field. Then there is an ideal $J$ of the polynomial ring $K[x_0,\dots,x_n] =$ `MvPolynomial (Fin (n + 1)) K` such that: (i) $J$ is generated by forms of degree $d$, that is, there is a set $s$ of polynomials, each homogeneous of degree $d$, with $J =$ `Ideal.span s`; (ii) the degree-$d$ graded piece of $K[x]/J$, namely the quotient of the $K$-module of degree-$d$ homogeneous polynomials by those lying in $J$, has $K$-dimension exactly $a$; and (iii) the corresponding degree-$(d+1)$ piece has $K$-dimension exactly [`Nat.macaulayPow d a`](def/Nat_MacaulayPow.html#L7), the value $a^{\langle d\rangle}$ computed by the stated recursion in $d$ using greedy binomial coefficients. Although the name refers to monomials, the conclusion asserts only that the generating set consists of degree-$d$ forms.
--
--   This is the sharpness half of Macaulay's theorem on Hilbert functions of graded quotients: the bound $a^{\langle d\rangle}$ on the growth from degree $d$ to degree $d+1$ is realised, classically by a lexicographic segment ideal. It feeds the analysis of maximal Hilbert-function growth used by [`MvPolynomial.finrank_piece_eq_of_maximal_growth`](thm.html#MvPolynomial.finrank_piece_eq_of_maximal_growth), [`MvPolynomial.forall_finrank_piece_succ_eq_macaulayPow_of_finrank_piece_succ_eq_macaulayPow`](thm.html#MvPolynomial.forall_finrank_piece_succ_eq_macaulayPow_of_finrank_piece_succ_eq_macaulayPow) and [`MvPolynomial.exists_forall_finrank_piece_succ_le_eval_and_exists_eq_eval`](thm.html#MvPolynomial.exists_forall_finrank_piece_succ_le_eval_and_exists_eq_eval).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPolynomial_exists_span_monomial_finrank_piece_eq_and_finrank_piece_succ_eq_macaulayPow.lean

import Mathlib
import Definitions.Def_AlgebraicGeometry_HilbertFunctor
import Definitions.Def_Nat_MacaulayPow

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open MvPolynomial AlgebraicGeometry.HilbertFunctor

theorem MvPolynomial.exists_span_monomial_finrank_piece_eq_and_finrank_piece_succ_eq_macaulayPow
    (n d : ℕ) (hd : 1 ≤ d) (a : ℕ) (ha : a ≤ (n + d).choose n) (K : Type) [Field K] :
    ∃ J : Ideal (MvPolynomial (Fin (n + 1)) K),
      (∃ s : Set (MvPolynomial (Fin (n + 1)) K), (∀ p ∈ s, p.IsHomogeneous d) ∧ J = Ideal.span s) ∧
      Module.finrank K (piece J d) = a ∧ Module.finrank K (piece J (d + 1)) = Nat.macaulayPow d a := by sorry
