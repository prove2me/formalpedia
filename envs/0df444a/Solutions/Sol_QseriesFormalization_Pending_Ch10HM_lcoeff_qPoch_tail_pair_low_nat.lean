    lcoeff
        (qPoch (Qpow ((b * s : ℕ) : ℤ)) (Qpow (b : ℤ)) L₁ *
          qPoch (Qpow ((b * t : ℕ) : ℤ)) (Qpow (b : ℤ)) L₂)
        (k : ℤ) =
