-- url     : https://prove2.me/theorems/7bdc18a2-521c-46fb-9f82-05118d5d5a3b
-- title:
--   Proposition A.1(i), p. 500 — (g − h)(x^{k+1}) ≤ (h* − g*)(y^k) − ρ₂/2‖dx^k‖² ≤ (g − h)(x^k) − (ρ₁ + ρ₂)/2‖dx^k‖²
-- statement:
--   Let $g, h\in\Gamma_0(\mathbb R^n)$ satisfy $\operatorname{dom} g\subset\operatorname{dom}h$ and $\operatorname{dom}h^*\subset\operatorname{dom}g^*$, and let $\{x^k\}$, $\{y^k\}$ be generated by the simplified DCA: $x^0\in\operatorname{dom} g$, $y^k\in\partial h(x^k)$, $x^{k+1}\in\partial g^*(y^k)$. Let $\rho_1,\rho_2\ge0$ be such that $g$ is $\rho_1$-convex and $h$ is $\rho_2$-convex, and write $dx^k = x^{k+1} - x^k$. Then for every $k\ge 0$
--   $$(g-h)(x^{k+1})\le(h^*-g^*)(y^k) - \frac{\rho_2}{2}\|dx^k\|^2\le(g-h)(x^k) - \frac{\rho_1+\rho_2}{2}\|dx^k\|^2.$$
--   Moreover, $(g-h)(x^{k+1}) = (g-h)(x^k)$ holds if and only if
--   $$x^k\in\partial g^*(y^k),\qquad y^k\in\partial h(x^{k+1})\qquad\text{and}\qquad(\rho_1+\rho_2)\|dx^k\| = 0.$$
--
--   This is the basic descent estimate of the DCA, from which the descent statements of Theorem 3.7 and Corollary A.2 are derived.
--
--   **Formalization Note.** $(g-h)$ and $(h^*-g^*)$ are evaluated with the convention $+\infty-(+\infty)=+\infty$ (`dcSub`); along a run every value involved is finite. The constants $\rho_i$ are any constants for which $g$ (resp. $h$) is $\rho_i$-convex, which is what p. 487's choice $0\le\rho_i\le\rho(f_i)$ amounts to.
-- source:
--   Pham Dinh & Le Thi, A d.c. optimization algorithm for solving the trust-region subproblem, SIAM J. Optim. 8 (1998), p. 500, Appendix, Proposition A.1(i)

import Mathlib
import Definitions.Def_TaoAnDCA_TRS_Setting

open Filter Topology

namespace TaoAnDCA.TRS

theorem proposition_A_1_i {n : ℕ} (g h : EuclideanSpace ℝ (Fin n) → EReal) (hgh : TaoAnDCA.GlobalOpt.DCStanding g h)
    (x y : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsSimplifiedDCARun g h x y)
    (ρ₁ ρ₂ : ℝ) (h₁ : IsRhoConvex g ρ₁) (h₂ : IsRhoConvex h ρ₂) :
    (∀ k : ℕ,
      TaoAnDCA.GlobalOpt.dcSub g h (x (k + 1)) ≤
          TaoAnDCA.GlobalOpt.dcSub (CondatPD.FinDim.conj h) (CondatPD.FinDim.conj g) (y k) -
            ((ρ₂ / 2 * ‖x (k + 1) - x k‖ ^ 2 : ℝ) : EReal) ∧
        TaoAnDCA.GlobalOpt.dcSub (CondatPD.FinDim.conj h) (CondatPD.FinDim.conj g) (y k) -
            ((ρ₂ / 2 * ‖x (k + 1) - x k‖ ^ 2 : ℝ) : EReal) ≤
          TaoAnDCA.GlobalOpt.dcSub g h (x k) - (((ρ₁ + ρ₂) / 2 * ‖x (k + 1) - x k‖ ^ 2 : ℝ) : EReal)) ∧
    (∀ k : ℕ,
      TaoAnDCA.GlobalOpt.dcSub g h (x (k + 1)) = TaoAnDCA.GlobalOpt.dcSub g h (x k) ↔
        (x k ∈ TaoAnDCA.GlobalOpt.subdiff (CondatPD.FinDim.conj g) (y k) ∧ y k ∈ TaoAnDCA.GlobalOpt.subdiff h (x (k + 1)) ∧
          (ρ₁ + ρ₂) * ‖x (k + 1) - x k‖ = 0)) := by sorry

end TaoAnDCA.TRS
