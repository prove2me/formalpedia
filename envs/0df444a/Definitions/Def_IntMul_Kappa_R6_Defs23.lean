/-- **Exact per-axis resampling maps** (the `A, B, hA, hB, hid` part of the frozen
`KFM.AxisMaps`, without the Lemma 19 fixed-point fields): `‖A_i‖, ‖B_i‖ ≤ 1` and
`P_S(F_s u / s) = 2^{2α²} B_i(P_T(F_t(A_i u) / t))` on every axis. Under `α ≥ 2`,
`α² (t_i/s_i - 1) ≥ 1` these exist by `prop_4_7_i` (`A = S`, `B` = the inverse map). -/
structure AxisMaps6 {d : ℕ} (α : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)]
    [∀ i, NeZero (t i)] where
  A : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ)
  B : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ)
  hA : ∀ i, ‖A i‖ ≤ 1
  hB : ∀ i, ‖B i‖ ≤ 1
  hid : ∀ i u, IntMul.OpenAI.RH.permS (s i) (t i) ((s i : ℂ)⁻¹ • ZMod.dft u) =
    (2 : ℂ) ^ (2 * α ^ 2) • B i (IntMul.OpenAI.RH.permT (s i) (t i) ((t i : ℂ)⁻¹ • ZMod.dft (A i u)))

/-! ## Proposition 14 and Proposition 18 -/

/-- The guard bound the assembly can supply: `Ew D ≤ C D^{C1}`. -/
def EwOK6 (P : Prm) (Ew : ℕ → ℕ) : Prop := ∃ C : ℕ, ∀ D, 1 ≤ D → Ew D ≤ C * D ^ P.C1

/-- **`P14Need6`: the uniform Proposition 14 for round six** (`IL3.P14UH'`, Track D2), produced
from the bit network's canonical Lemma 12 code (`IL.L12Canon`) and a complex network `J` whose
gates lie in the class `IL3H.GClassH J A`, with a guard `Ew = O(D^{C1})` (crude depth guard,
`R6Guard.crude_guard_C1`). Proved by `IL3H.p14Need6_all` (`R6IL3Cfg6`).

Cost row: `ℓ d^λ'` (the `(K+1) D^lamp` factor of `P14NeedH`; margin `ε(1-λ')`). -/
def P14Need6 (P : Prm) : Prop :=
  ∀ (tab : Fin 1 → IStmt HS 1) (l12 : IStmt HS 1), IL.L12Canon tab l12 P.τ →
  ∀ (T : ℕ) (J : Cx.Prop8IfaceH 207387136 T 576 Jain.cxR6) (A : ℕ), IL3H.GClassH J A →
    histMoment Jain.cxR6 576 P.σ < 207387136 →
    2 + 576 * Real.log (histRankSum Jain.cxR6) ≤ P.C1 →
    ∃ Ew : ℕ → ℕ, EwOK6 P Ew ∧ IL3.P14UH' tab Ew P.lamp

end

end IntMul.Kappa.R6

