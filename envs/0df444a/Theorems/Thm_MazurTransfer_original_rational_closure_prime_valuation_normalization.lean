theorem MazurTransfer.original_rational_closure_prime_valuation_normalization : (∀ (q : ℕ) [Fact q.Prime] (z : ℤ) (hz : z ≠ 0), (rationalPrime q).intValuation (z : 𝓞 RationalField) = WithZero.exp (-(padicValInt q z : ℤ))) ∧ (∀ (q : ℕ) [Fact q.Prime] (z : ℤ) (hz : z ≠ 0), (rationalPrime q).valuation RationalField (z : RationalField) = WithZero.exp (-(padicValInt q z : ℤ))) ∧ (∀ (q : ℕ) [Fact q.Prime] (a : ℚ) (ha : a ≠ 0), (rationalPrime q).valuation RationalField (algebraMap ℚ RationalField a) = WithZero.exp (-padicValRat q a)) ∧ (∀ (q : ℕ) [Fact q.Prime] (a : ℚˣ), Multiplicative.toAdd ((rationalPrime q).valuationOfNeZero (rationalUnits a)) = -padicValRat q (a : ℚ)) := by sorry
