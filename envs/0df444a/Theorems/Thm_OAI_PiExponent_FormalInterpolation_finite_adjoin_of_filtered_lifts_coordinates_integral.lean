-- title:
--   Filtered lifts make the coordinates integral
-- statement:
--   For each coordinate, establish integrality over the algebra generated by the original polynomials from finiteness over the algebra generated by their degree-D weighted components. This is the filtered-lifting core: extract homogeneous coordinate power relations, lift them to the original generators, and control lower-degree terms by induction on weighted degree. The statement keeps positive weights, D > 0, and the inclusive support bound, so generators of degree below D remain covered.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_filtered_lifts_coordinates_integral
    {d : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (g : Fin m → MvPolynomial (Fin d) Complex)
    (hbound : ∀ j, ∀ a ∈ (g j).support,
      ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real))
    (hfinite : Module.Finite
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j))))
      (MvPolynomial (Fin d) Complex))
    (i : Fin d) :
    IsIntegral (Algebra.adjoin Complex (Set.range g) : Subalgebra Complex (MvPolynomial (Fin d) Complex))
      (MvPolynomial.X i : MvPolynomial (Fin d) Complex) := by sorry
