        rw [abs_le] at hc
        rcases neg_one_pow_eq_or ℝ t.card with h | h <;> rw [h] <;> linarith [hc.1, hc.2]
    _ = ∑ n ∈ Ioc A (A + H), ∑ t ∈ TS S m, (-1:ℝ) ^ t.card * (if (∏ p ∈ t, p) ∣ n then 1 else 0) := by
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl; intro t _
        rw [← Finset.mul_sum, Finset.sum_boole]
    _ ≤ ∑ n ∈ Ioc A (A + H), (if (∀ p ∈ S, ¬ p ∣ n) then (1:ℝ) else 0) :=
        Finset.sum_le_sum (fun n _ => point S hS m hm n)

