open ModularCurve

theorem solution
    (p : ℕ) [Fact p.Prime] (ℓ : ℕ) [Fact ℓ.Prime] (k : ℕ) (y : JZero p) (hy : ℓ ^ k • y = 0) :
    ∃ s : TateModule ℓ (JZero p), (s : ℕ → JZero p) k = y := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hℓ : ℓ.Prime := Fact.out

  have hsurj := ModularCurve.jZero_zsmul_surjective p (ℓ : ℤ) (by exact_mod_cast hℓ.ne_zero)
  let dv : JZero p → JZero p := fun z => (hsurj z).choose
  have hdv : ∀ z, ℓ • dv z = z := fun z => by
    have := (hsurj z).choose_spec

    rw [← natCast_zsmul]
    exact this

  let chain : ℕ → JZero p := fun j => Nat.rec y (fun _ z => dv z) j
  have chain_zero : chain 0 = y := rfl
  have chain_succ : ∀ j, chain (j + 1) = dv (chain j) := fun _ => rfl
  have hstep : ∀ j, ℓ • chain (j + 1) = chain j := fun j => by rw [chain_succ]; exact hdv _
  have hpow : ∀ j, ℓ ^ j • chain j = y := by
    intro j
    induction j with
    | zero => rw [pow_zero, one_nsmul, chain_zero]
    | succ j ih => rw [pow_succ', mul_nsmul, hstep, ih]

  let seq : ℕ → JZero p := fun n => if n ≤ k then ℓ ^ (k - n) • y else chain (n - k)
  have seq_le : ∀ n, n ≤ k → seq n = ℓ ^ (k - n) • y := fun n hn => if_pos hn
  have seq_gt : ∀ n, k < n → seq n = chain (n - k) := fun n hn => if_neg (not_le.mpr hn)
  have seq_k : seq k = y := by rw [seq_le k le_rfl, Nat.sub_self, pow_zero, one_nsmul]
  have seq_gt' : ∀ j, seq (k + j + 1) = chain (j + 1) := fun j => by
    rw [seq_gt _ (by omega)]
    have hj : k + j + 1 - k = j + 1 := by omega
    rw [hj]
  have htors : ∀ n, ℓ ^ n • seq n = 0 := by
    intro n
    rcases le_or_gt n k with hn | hn
    · rw [seq_le n hn, ← mul_nsmul, ← pow_add, Nat.sub_add_cancel hn, hy]
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_lt hn
      rw [seq_gt' j, show k + j + 1 = (j + 1) + k by omega, pow_add, mul_nsmul, hpow, hy]
  have hcompat : ∀ n, ℓ • seq (n + 1) = seq n := by
    intro n
    rcases lt_or_ge n k with hn | hn
    · rw [seq_le (n + 1) hn, seq_le n hn.le, ← mul_nsmul, ← pow_succ,
        show k - (n + 1) + 1 = k - n by omega]
    · rcases hn.eq_or_lt with rfl | hlt
      · show ℓ • seq (k + 0 + 1) = seq k
        calc ℓ • seq (k + 0 + 1) = ℓ • chain (0 + 1) := by rw [seq_gt' 0]
          _ = chain 0 := hstep 0
          _ = y := by rw [chain_zero]
          _ = seq k := seq_k.symm
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_lt hlt
        show ℓ • seq (k + (j + 1) + 1) = seq (k + j + 1)
        calc ℓ • seq (k + (j + 1) + 1) = ℓ • chain (j + 1 + 1) := by rw [seq_gt' (j + 1)]
          _ = chain (j + 1) := hstep (j + 1)
          _ = seq (k + j + 1) := (seq_gt' j).symm
  refine ⟨⟨seq, fun n => ⟨?_, ?_⟩⟩, seq_k⟩
  · rw [natCast_zsmul]
    exact htors n
  · rw [natCast_zsmul]
    exact hcompat n

