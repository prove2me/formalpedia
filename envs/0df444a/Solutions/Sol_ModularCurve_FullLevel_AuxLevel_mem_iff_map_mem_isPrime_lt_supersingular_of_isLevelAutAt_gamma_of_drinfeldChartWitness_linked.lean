def valSubringEquiv {K : Type} [Field K] (e : K ≃+* K) (S T : ValuationSubring K)
    (h₁ : ∀ x : K, x ∈ S → e x ∈ T) (h₂ : ∀ x : K, x ∈ T → e.symm x ∈ S) : ↥S ≃+* ↥T where
  toFun x := ⟨e (x : K), h₁ _ x.2⟩
  invFun y := ⟨e.symm (y : K), h₂ _ y.2⟩
  left_inv x := Subtype.ext (e.symm_apply_apply (x : K))
  right_inv y := Subtype.ext (e.apply_symm_apply (y : K))
  map_mul' x y := Subtype.ext (map_mul e (x : K) (y : K))
  map_add' x y := Subtype.ext (map_add e (x : K) (y : K))

theorem mem_maximalIdeal_iff_of_forall_mem_iff {K : Type} [Field K] (V : ValuationSubring K)
    (e : K ≃+* K) (τ : K → K) (hτe : ∀ x : K, τ x = e x)
    (hV : ∀ f : K, f ∈ V ↔ τ f ∈ V) (x : K) (hx : x ∈ V) (hex : τ x ∈ V) :
    (⟨x, hx⟩ : ↥V) ∈ maximalIdeal ↥V ↔ (⟨τ x, hex⟩ : ↥V) ∈ maximalIdeal ↥V := by
  have hτe' : τ = ⇑e := funext hτe
  subst hτe'
  let ω : ↥V ≃+* ↥V := valSubringEquiv e V V (fun x hx => (hV x).mp hx)
    (fun x hx => by rw [hV, e.apply_symm_apply]; exact hx)
  have key : (⟨e x, hex⟩ : ↥V) = ω ⟨x, hx⟩ := Subtype.ext rfl
  rw [key]
  simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  constructor
  · intro h hu
    apply h
    have h2 := hu.map ω.symm
    rwa [ω.symm_apply_apply] at h2
  · intro h hu
    exact h (hu.map ω)

theorem exists_valuationSubring_forall_mem_iff_mem_maximalIdeal {A K : Type} [CommRing A] [Field K] [Algebra A K]
    (C : Subalgebra A K) (𝔭 : Ideal ↥C) (h𝔭 : 𝔭.IsPrime) :
    ∃ V : ValuationSubring K, (∀ b : ↥C, (b : K) ∈ V) ∧
      ∀ (b : ↥C) (hb : (b : K) ∈ V), b ∈ 𝔭 ↔ (⟨(b : K), hb⟩ : ↥V) ∈ maximalIdeal ↥V := by
  classical
  let C' : Subring K := C.toSubring
  let ι : ↥C' ≃+* ↥C :=
    { toFun := fun x => ⟨x.1, x.2⟩, invFun := fun x => ⟨x.1, x.2⟩, left_inv := fun _ => rfl,
      right_inv := fun _ => rfl, map_mul' := fun _ _ => rfl, map_add' := fun _ _ => rfl }
  let P : Ideal ↥C' := Ideal.comap ι 𝔭
  haveI hP : P.IsPrime := Ideal.comap_isPrime ι 𝔭
  obtain ⟨V, hle, hloc⟩ := (LocalSubring.ofPrime C' P).exists_le_valuationSubring
  have hCV : C' ≤ V.toSubring := (LocalSubring.le_ofPrime C' P).trans hle
  refine ⟨V, fun b => hCV b.2, fun b hb => ?_⟩
  let b' : ↥C' := ⟨(b : K), b.2⟩
  have hbP : b ∈ 𝔭 ↔ b' ∈ P := by
    rw [Ideal.mem_comap]
    exact Iff.rfl
  rw [hbP]
  have key : Subring.inclusion hle (algebraMap (↥C') (↥(LocalSubring.ofPrime C' P).toSubring) b') =
      ⟨(b : K), hb⟩ := Subtype.ext rfl
  constructor
  · intro hbP'
    have h1 : algebraMap (↥C') (↥(LocalSubring.ofPrime C' P).toSubring) b' ∈
        maximalIdeal ↥(LocalSubring.ofPrime C' P).toSubring := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P]
      exact Ideal.mem_map_of_mem _ hbP'
    have h2 := ((IsLocalRing.local_hom_TFAE (Subring.inclusion hle)).out 0 1).mp hloc
    have h3 := h2 ⟨_, h1, rfl⟩
    rw [key] at h3
    exact h3
  · intro hbm
    by_contra hbP'
    have hu : IsUnit (algebraMap (↥C') (↥(LocalSubring.ofPrime C' P).toSubring) b') :=
      IsLocalization.map_units (↥(LocalSubring.ofPrime C' P).toSubring) (⟨b', hbP'⟩ : P.primeCompl)
    have hu' := hu.map (Subring.inclusion hle)
    rw [key] at hu'
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hbm)) hu'

theorem algebraMap_mem_iff_of_uniformizer_mem_maximalIdeal {A L K : Type} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [Field L] [Algebra A L] [IsFractionRing A L] [Field K] [Algebra L K]
    [Algebra A K] [IsScalarTower A L K]
    (ϖ : A) (hϖ : maximalIdeal A = Ideal.span {ϖ})
    (V : ValuationSubring K) (hAV : ∀ a : A, algebraMap A K a ∈ V)
    (hϖV : ∃ h : algebraMap A K ϖ ∈ V, (⟨algebraMap A K ϖ, h⟩ : ↥V) ∈ maximalIdeal ↥V) :
    ∀ x : L, algebraMap L K x ∈ V ↔ ∃ a : A, algebraMap A L a = x := by
  intro x
  constructor
  · intro hxV
    rcases ValuationRing.isInteger_or_isInteger A x with ⟨a, ha⟩ | ⟨a, ha⟩
    · exact ⟨a, ha⟩
    · by_cases hx0 : x = 0
      · exact ⟨0, by rw [map_zero, hx0]⟩
      by_cases hau : IsUnit a
      · obtain ⟨u, rfl⟩ := hau
        refine ⟨((u⁻¹ : Aˣ) : A), ?_⟩
        have h1 : algebraMap A L (u : A) * algebraMap A L ((u⁻¹ : Aˣ) : A) = 1 := by
          rw [← map_mul, Units.mul_inv, map_one]
        rw [ha] at h1
        calc algebraMap A L ((u⁻¹ : Aˣ) : A) = x * (x⁻¹ * algebraMap A L ((u⁻¹ : Aˣ) : A)) := by
                rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
          _ = x := by rw [h1, mul_one]
      · exfalso
        have hamem : a ∈ maximalIdeal A := hau
        rw [hϖ, Ideal.mem_span_singleton] at hamem
        obtain ⟨b, rfl⟩ := hamem
        obtain ⟨hϖV', hϖm⟩ := hϖV
        have h1 : algebraMap L K x * algebraMap A K (ϖ * b) = 1 := by
          rw [IsScalarTower.algebraMap_apply A L K, ha, ← map_mul, mul_inv_cancel₀ hx0, map_one]
        have hunit : IsUnit (⟨algebraMap A K ϖ, hϖV'⟩ : ↥V) := by
          refine isUnit_iff_exists_inv.mpr ⟨⟨algebraMap A K b * algebraMap L K x, V.mul_mem _ _ (hAV b) hxV⟩, ?_⟩
          apply Subtype.ext
          show algebraMap A K ϖ * (algebraMap A K b * algebraMap L K x) = 1
          rw [← mul_assoc, ← map_mul, mul_comm, h1]
        exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hϖm)) hunit
  · rintro ⟨a, rfl⟩
    rw [← IsScalarTower.algebraMap_apply]
    exact hAV a

theorem exists_forall_monic_aeval_not_mem {A K : Type} [CommRing A] [Field K] [Algebra A K]
    [IsLocalRing A] (ϖ : A) (hϖ : maximalIdeal A = Ideal.span {ϖ})
    (C : Subalgebra A K) (𝔭 : Ideal ↥C) (h𝔭 : 𝔭.IsPrime) (hϖ𝔭 : algebraMap A ↥C ϖ ∈ 𝔭)
    (hnm : ¬ 𝔭.IsMaximal) :
    ∃ c : ↥C, ∀ p : Polynomial A, p.Monic → Polynomial.aeval c p ∉ 𝔭 := by
  classical
  by_contra H
  push Not at H
  apply hnm
  haveI := h𝔭
  have hf : ((Ideal.Quotient.mk 𝔭).comp (algebraMap A ↥C)).IsIntegral := by
    intro x
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p, hp, hpc⟩ := H c
    refine ⟨p, hp, ?_⟩
    rw [← Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem, ← Polynomial.aeval_def]
    exact hpc
  haveI hbp : (⊥ : Ideal (↥C ⧸ 𝔭)).IsPrime := Ideal.isPrime_bot
  have hker : Ideal.comap ((Ideal.Quotient.mk 𝔭).comp (algebraMap A ↥C)) ⊥ = maximalIdeal A := by
    symm
    apply (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le
    · intro htop
      have h1 : (1 : A) ∈ Ideal.comap ((Ideal.Quotient.mk 𝔭).comp (algebraMap A ↥C)) ⊥ := by
        rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_comap, Ideal.mem_bot, map_one] at h1
      exact one_ne_zero h1
    · rw [hϖ, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_bot,
        RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hϖ𝔭
  have hbot : (⊥ : Ideal (↥C ⧸ 𝔭)).IsMaximal := by
    refine Ideal.isMaximal_of_isIntegral_of_isMaximal_comap' _ hf ⊥ ?_
    rw [hker]; exact IsLocalRing.maximalIdeal.isMaximal A
  have h := Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk 𝔭) Ideal.Quotient.mk_surjective (K := ⊥)
  rwa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at h

