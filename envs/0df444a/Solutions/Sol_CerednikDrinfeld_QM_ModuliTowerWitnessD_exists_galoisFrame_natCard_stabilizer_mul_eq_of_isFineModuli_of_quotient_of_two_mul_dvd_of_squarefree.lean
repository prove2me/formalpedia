theorem germToFunctionField_eq_algebraMap_germ {X : Scheme} [IsIntegral X] (U : X.Opens) [Nonempty U]
    (x : X) (hx : x ∈ U) (t : Γ(X, U)) :
    X.germToFunctionField U t =
      algebraMap (X.presheaf.stalk x) X.functionField (X.presheaf.germ U x hx t) := by
  letI : Algebra Γ(X, U) (X.presheaf.stalk x) := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hx⟩
  haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk x) X.functionField :=
    functionField_isScalarTower X U ⟨x, hx⟩
  change (algebraMap Γ(X, U) X.functionField) t = _
  rw [IsScalarTower.algebraMap_apply Γ(X, U) (X.presheaf.stalk x) X.functionField t]
  rfl

