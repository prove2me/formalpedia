theorem kunpack_bound (B : ℤ) (hB : 0 < B) : ∀ (n : ℕ) (W : ℤ), ∀ y ∈ kunpack B n W, |y| ≤ B
  | 0, _ => by simp [kunpack]
  | n + 1, W => by
    intro y hy
    simp only [kunpack, List.mem_cons] at hy
    rcases hy with rfl | hy
    · have h1 := Int.emod_nonneg (W + B / 2) hB.ne'
      have h2 := Int.emod_lt_of_pos (W + B / 2) hB
      have h3 : 0 ≤ B / 2 := Int.ediv_nonneg hB.le (by norm_num)
      have h4 : B / 2 ≤ B := Int.ediv_le_self _ hB.le
      rw [abs_le]; constructor <;> omega
    · exact kunpack_bound B hB n _ y hy

theorem getD_bound (l : List ℤ) (c : ℕ) (B : ℤ) (hB : 0 ≤ B) (h : ∀ y ∈ l, |y| ≤ B) :
    |l.getD c 0| ≤ B := by
  rw [List.getD_eq_getElem?_getD]
  rcases hc : l[c]? with _ | y
  · simpa using hB
  · simp only [Option.getD_some]; exact h y (List.mem_of_getElem? hc)

theorem decBlk_bound (F : ℤ) (P r : ℕ) (z : ℤ) :
    ∀ p ∈ Ref.decBlk F P r z, |p.1| ≤ 2 * 2 ^ P ∧ |p.2| ≤ 2 * 2 ^ P := by
  intro p hp
  simp only [Ref.decBlk, List.mem_map] at hp
  obtain ⟨c, _, rfl⟩ := hp
  have hB : (0 : ℤ) < 2 ^ P := by positivity
  have hk := kunpack_bound (2 ^ P) hB (4 * r) (balMod F z)
  have g := fun c => getD_bound _ c _ hB.le hk
  constructor
  · exact (abs_add_le _ _).trans (by linarith [g c, g (c + r)])
  · exact (abs_add_le _ _).trans (by linarith [g (2 * r + c), g (3 * r + c)])

end NLogN.FW

