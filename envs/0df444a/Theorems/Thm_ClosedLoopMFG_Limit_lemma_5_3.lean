-- title:
--   Lemma 5.3 — Markovian projection of a randomized Fokker–Planck equation onto a semi-Markov relaxed control
-- statement:
--   Assume Assumption A. Let $\bar{\boldsymbol\mu}$ be a $\mathcal P(\mathcal C^d\times\mathcal V)$-valued random variable and $\mu=(\mu_t)_{t\in[0,T]}$ its measure flow, $\mu_t=\bar{\boldsymbol\mu}\circ[(x,q)\mapsto x_t]^{-1}$. Assume $\mu_0=\lambda$ almost surely, and that with probability one, for every $t\in[0,T]$ and $\varphi\in C_c^\infty(\mathbb R^d)$,
--   $$\langle\mu_t,\varphi\rangle=\langle\mu_0,\varphi\rangle+\int_{\mathcal C^d\times\mathcal V}\Big[\int_0^t\int_A L\varphi(s,x_s,\mu_s,a)\,q_s(da)\,ds\Big]\bar{\boldsymbol\mu}(dx,dq). \tag{5.4}$$
--   Then there is a semi-Markov $\Lambda^*:[0,T]\times\mathbb R^d\times C([0,T];\mathcal P(\mathbb R^d))\to\mathcal P(A)$ such that:
--
--   1. (a) almost surely, for every $t\in[0,T]$ and $\varphi\in C_c^\infty(\mathbb R^d)$,
--   $$\langle\mu_t,\varphi\rangle=\langle\mu_0,\varphi\rangle+\int_0^t\Big\langle\mu_s,\int_AL\varphi(s,\cdot,\mu_s,a)\,\Lambda^*(s,\cdot,\mu)(da)\Big\rangle ds;$$
--   2. (b) for every bounded measurable $\psi$ on $[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)\times A$,
--   $$\mathbb E\Big[\int_{\mathcal C^d\times\mathcal V}\int_0^T\int_A\psi(t,x_t,\mu_t,a)\,q_t(da)\,dt\,\bar{\boldsymbol\mu}(dx,dq)\Big]=\mathbb E\Big[\int_0^T\int_{\mathbb R^d}\int_A\psi(t,x,\mu_t,a)\,\Lambda^*(t,x,\mu)(da)\,\mu_t(dx)\,dt\Big];$$
--   3. (c) on an enlarged probability space there are a flow with the law of $\mu$ and continuous processes $X$, $W$ satisfying (i)–(v): $X_0$, $W$, $\mu$ independent; $W$ a Brownian motion for the completed filtration generated by $(X_0,\mu_t,W_t)$; $X$ adapted to it with $X_0\sim\lambda$; $dX_t=\int_Ab(t,X_t,\mu_t,a)\Lambda^*(t,X_t,\mu)(da)dt+dW_t$; and $\mu_t=\mathcal L(X_t\mid\mathcal F^\mu_t)$ a.s. for each $t$.
--
--   The lemma realizes a randomized Fokker–Planck equation as the conditional law of a state process driven by a semi-Markov relaxed control.
--
--   **Formalization Note** The paper states Lemma 5.3 without the hypothesis $\mu_0=\lambda$ a.s.; we add it. Conclusion (c) forces $X_0\sim\lambda$, $X_0$ independent of $\mu$, and $\mu_0=\mathcal L(X_0\mid\mathcal F^\mu_0)$, hence $\mu_0=\lambda$ a.s., so without the hypothesis the lemma is false (take $\mu$ deterministic with $\mu_0\ne\lambda$); Corollary A.7, which proves (c), assumes $\langle\lambda,\varphi\rangle$ in place of $\langle\mu_0,\varphi\rangle$, and the application in Theorem 5.4 satisfies it. The paper prints $\Lambda^*(t,\cdot,\mu)$ under $\int_0^t\cdots ds$ in (a); we state $\Lambda^*(s,\cdot,\mu)$. "By enlarging the probability space" is stated as the existence of a probability space carrying a flow with the same law as $\mu$ together with $X$ and $W$; only laws enter the statement. The flow $\mu$ is carried with its defining equation; $q_s(da)\,ds$ integrals are integrals against $q$ restricted to $\{s\le t\}$.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 26, Lemma 5.3 and footnote 7

import Mathlib
import Definitions.Def_ClosedLoopMFG_Limit_Model
import Definitions.Def_ClosedLoopMFG_Limit_Game
import Definitions.Def_ClosedLoopMFG_Limit_Equilibrium
import Definitions.Def_ClosedLoopMFG_Limit_Relaxed

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Limit

/-- **Lemma 5.3** (pp. 26–27), with the hypothesis `μ_0 = λ` a.s. made explicit. Let `μ̄` be a
`P(𝒞^d × V)`-valued random variable with measure flow `μ` (footnote 7) satisfying the randomized
Fokker–Planck identity (5.4) a.s. Then there is a `P(A)`-valued semi-Markov `Λ*` such that
(a) the projected Fokker–Planck identity holds a.s., (b) the occupation identity holds for every
bounded measurable `ψ`, and (c) on some probability space there are `X`, `W` and a flow with the
law of `μ` satisfying (i)–(v). -/
theorem lemma_5_3 {d : ℕ} {T : ℝ≥0} (hT : 0 < T) {EA : Type} [NormedAddCommGroup EA]
    [NormedSpace ℝ EA] [MeasurableSpace EA] [BorelSpace EA] (A : Set EA) (lam : PR d)
    (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ)
    (hA : AssumptionA T A b f g)
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (μbar : Ω → PCV d T A) (hμbar : Measurable μbar)
    (μ : Ω → Flow d T) (hμ : Measurable μ) (hflow : ∀ ω t, μ ω t = margAt (μbar ω) t)
    (hμ0 : ∀ᵐ ω ∂P, ev (μ ω) 0 = lam)
    (h54 : ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T, ∀ φ : E d → ℝ, IsTestFn φ →
      pair (μ ω t) φ = pair (ev (μ ω) 0) φ +
        ∫ p, qInt p.2 t (fun s a => Lgen b φ s (ev p.1 s) (ev (μ ω) s) a) ∂(μbar ω).meas) :
    ∃ Λ : ℝ → E d → Flow d T → PA A, IsSemiMarkov Λ ∧
      (∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T, ∀ φ : E d → ℝ, IsTestFn φ →
        pair (μ ω t) φ = pair (ev (μ ω) 0) φ +
          ∫ s in (0 : ℝ)..t, pair (ev (μ ω) s)
            (fun x => ∫ a, Lgen b φ s x (ev (μ ω) s) (a : EA) ∂(Λ s x (μ ω)).meas)) ∧
      (∀ ψ : ℝ → E d → PR d → EA → ℝ,
        Measurable (fun p : ℝ × E d × PR d × EA => ψ p.1 p.2.1 p.2.2.1 p.2.2.2) →
        (∃ C : ℝ, ∀ t x m a, |ψ t x m a| ≤ C) →
        ∫ ω, (∫ p, qInt p.2 T (fun s a => ψ s (ev p.1 s) (ev (μ ω) s) a) ∂(μbar ω).meas) ∂P =
          ∫ ω, (∫ t in (0 : ℝ)..T, pair (ev (μ ω) t)
            (fun x => ∫ a, ψ t x (ev (μ ω) t) (a : EA) ∂(Λ t x (μ ω)).meas)) ∂P) ∧
      ∃ (Ω' : Type) (_ : MeasurableSpace Ω') (P' : Measure Ω') (W' : ℝ≥0 → Ω' → E d)
        (X' : Ω' → Path d T) (μ' : Ω' → Flow d T),
        P'.map μ' = P.map μ ∧ IsRelaxedRealization lam b Λ P' W' X' μ' := by sorry

end ClosedLoopMFG.Limit
