-- title:
--   Submultiplicative topology implies invariance of all analytic functionals
-- statement:
--   Let $\mathfrak g$ be a real Hausdorff locally convex Lie algebra with continuous bracket, and let $E$ be Banach. Assume the topology of $\mathfrak g$ is generated by continuous submultiplicative seminorms. If $\beta:U(\mathfrak g)\to E$ is analytic in Definition 3.2, then
--
--   $$
--   L_x\beta\text{ and }R_x\beta\text{ are analytic for every }x\in\mathfrak g,
--   $$
--
--   where $(L_x\beta)(D)=-\beta(xD)$ and $(R_x\beta)(D)=\beta(Dx)$. This is the definite assertion in Remark 3.8(a); no assertion is made for arbitrary locally convex Lie algebras.
-- source:
--   On Analytic Vectors for Unitary Representations of Infinite Dimensional Lie Groups, arXiv:1002.4792v2, PDF p. 13, Remark 3.8

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P25

noncomputable section

open Set Filter Topology

open scoped Classical ENNReal

namespace QAlgorithms.Papers.Independent.Next46.P25

universe u v w z

attribute [local instance 100] LieRing.ofAssociativeRing

section Functionals

variable {g : Type u} [LieRing g] [LieAlgebra ℝ g]

variable [gUniform : UniformSpace g] [gAdd : IsUniformAddGroup g] [gHaus : T2Space g]

variable [gScalar : ContinuousSMul ℝ g] [gLC : LocallyConvexSpace ℝ g]

variable {E : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E]

include gAdd gHaus gScalar gLC

/-- Remark 3.8(a), PDF pp.13--14: invariance of all analytic elements
    when the topology is generated by submultiplicative seminorms. -/
theorem analytic_regular_invariance [CompleteSpace E]
    (hBracket : Continuous (fun xy : g × g => ⁅xy.1, xy.2⁆))
    (hGenerated : SubmultiplicativelyGenerated (g := g))
    (beta : UniversalEnvelopingAlgebra ℝ g →ₗ[ℝ] E)
    (hAnalytic : AnalyticFunctional beta) :
    ∀ x : g, AnalyticFunctional (leftRegular x beta) ∧
      AnalyticFunctional (rightRegular x beta) := by sorry

end Functionals

end QAlgorithms.Papers.Independent.Next46.P25

end
