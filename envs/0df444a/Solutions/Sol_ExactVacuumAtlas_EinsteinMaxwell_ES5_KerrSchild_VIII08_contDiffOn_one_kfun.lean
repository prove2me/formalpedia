-- ==== solution ====
open Set Filter Topology MeasureTheory intervalIntegral
open scoped ContDiff Interval
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08
set_option maxHeartbeats 4000000
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
theorem solution {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 1 (kfun j q) (Ioo (0:ℝ) aG) := by
  have hB : ContDiffOn ℝ 1 (Bfun j q) (Ioo (0:ℝ) aG) := contDiffOn_one_Bfun (j := j) hq
  have hid : ContDiffOn ℝ 1 (fun x : ℝ => x) (Ioo (0:ℝ) aG) := contDiffOn_id
  have hnum : ContDiffOn ℝ 1 (fun x : ℝ => x * Bfun j q x) (Ioo (0:ℝ) aG) :=
    ContDiffOn.mul (f := fun x : ℝ => x) (g := Bfun j q) hid hB
  have hA := contDiffOn_two_AcK.of_le (m := 1) (by norm_num)
  have hone : ContDiffOn ℝ 1 (fun x : ℝ => 1 - x) (Ioo (0:ℝ) aG) :=
    ContDiffOn.sub (f := fun _ : ℝ => (1:ℝ)) contDiffOn_const hid
  have hden : ContDiffOn ℝ 1 (fun x : ℝ => (1 - x) * AcK x ^ 2) (Ioo (0:ℝ) aG) :=
    ContDiffOn.mul (f := fun x : ℝ => 1 - x) (g := fun x : ℝ => AcK x ^ 2) hone (hA.pow 2)
  have hne : ∀ x ∈ Ioo (0:ℝ) aG, (1 - x) * AcK x ^ 2 ≠ 0 := by
    intro x hx
    have hxa : x < 1 / 3 := by have ha : aG = 1 / 3 := rfl; linarith [hx.2]
    have hxg : x ∈ KG := ⟨le_of_lt hx.1, le_of_lt hxa⟩
    have h1 : (0:ℝ) < 1 - x := by linarith
    have hA2 : (0:ℝ) < AcK x := lt_of_lt_of_le (by norm_num) (AcK_ge_third hxg)
    exact mul_ne_zero (ne_of_gt h1) (pow_ne_zero 2 (ne_of_gt hA2))
  have h := ContDiffOn.div hnum hden hne
  refine h.congr ?_
  intro x _
  simp only [kfun, Pi.div_apply]
