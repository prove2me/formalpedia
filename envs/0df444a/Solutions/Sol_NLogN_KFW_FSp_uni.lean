theorem HRef.sim {p p' : RS} {X : ℕ} (h : HRef p p' X) :
    ∀ s, p.ok s → p'.ok s ∧ p'.run s = p.run s ∧ fcost p' s ≤ fcost p s + X := by
  induction h with
  | refl p => intro s h; exact ⟨h, rfl, by omega⟩
  | seq _ _ iha ihb =>
    intro s h
    obtain ⟨o1, r1, c1⟩ := iha s h.1
    obtain ⟨o2, r2, c2⟩ := ihb _ h.2
    refine ⟨⟨o1, by rw [r1]; exact o2⟩, by simp only [RS.run, r1, r2], ?_⟩
    simp only [fcost, r1]; omega
  | @ite c a a' b b' X Y _ _ iha ihb =>
    intro s h
    obtain ⟨hc, hco, hbr⟩ := h
    refine ⟨⟨hc, hco, ?_⟩, ?_, ?_⟩
    · split_ifs at hbr ⊢
      · exact (iha s hbr).1
      · exact (ihb s hbr).1
    · simp only [RS.run]; split_ifs at hbr ⊢
      · exact (iha s hbr).2.1
      · exact (ihb s hbr).2.1
    · simp only [fcost]; split_ifs at hbr ⊢
      · have := (iha s hbr).2.2; omega
      · have := (ihb s hbr).2.2; omega
  | @push i v e X hr hv hok hc =>
    intro s h
    obtain ⟨hi, -, -⟩ := h
    refine ⟨⟨hi, fun j hj => by simp [hr] at hj, hok s⟩, by simp only [RS.run, Ex.eval, hv], ?_⟩
    simp only [fcost, hv, Ex.cost, Ex.eval]
    have := hc s; omega
  | mono _ hXY ih =>
    intro s h
    obtain ⟨o, r, c⟩ := ih s h
    exact ⟨o, r, by omega⟩

theorem FSp.of_href {p p' : RS} {X : ℕ} (h : HRef p p' X) {s t : IState HS} {c : ℕ}
    (H : FSp p s t c) : FSp p' s t (c + X) := by
  obtain ⟨o, r, co⟩ := h.sim s H.1
  have := H.2.2
  exact ⟨o, r.trans H.2.1, by omega⟩

