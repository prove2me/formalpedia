open PairsToBound
open Sat3 (CNF)
namespace PairsToBound
theorem _root_.solution {l : List ℕ} {a x : ℕ} (h : x ∈ l) : x ≤ l.foldr max a := by
  induction l with
  | nil => simp at h
  | cons b l ih =>
    rw [List.foldr_cons]
    rcases List.mem_cons.1 h with rfl | h
    · exact le_max_left _ _
    · exact (ih h).trans (le_max_right _ _)
end PairsToBound
