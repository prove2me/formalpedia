  rw [P1_split, L1_u_eq, S7_1_eq, H1_u_eq, bernstein1, bern1_lo_eq, bern1_hi_eq]
  ring

private theorem P1_nonneg (φ : ℝ) (hlo : splitPoint ≤ φ) (hhi : φ ≤ top) :
    0 ≤ P1 φ := by
  let u : ℝ := (φ - splitPoint) / (top - splitPoint)
  have hwidth : 0 < top - splitPoint := by norm_num [splitPoint, top]
  have hu0 : 0 ≤ u := div_nonneg (sub_nonneg.mpr hlo) hwidth.le
  have hu1 : u ≤ 1 := (div_le_iff₀ hwidth).2 (by linarith only [hhi])
  have hparam : splitPoint + (top - splitPoint) * u = φ := by
    dsimp only [u]; field_simp [ne_of_gt hwidth]; ring
  have hcert := certificate1 u
  rw [hparam] at hcert
  have hnonneg := bernstein1_nonneg u hu0 hu1
  rw [← hcert] at hnonneg
  linarith only [hnonneg]

theorem low_left (φ : ℝ) (hlo : 2 ≤ φ) (hhi : φ ≤ splitPoint) :
    Q φ - AT φ + AR φ ≤ target := by
  have hp := P0_nonneg φ hlo hhi
  have hd := D_pos φ hlo
  have hq := Q_mul_D φ hlo
  dsimp only [P0] at hp
  have hmul : D φ * (Q φ - AT φ + AR φ) ≤ D φ * target := by linarith [hp, hq]
  exact le_of_mul_le_mul_left hmul hd

theorem low_right (φ : ℝ) (hlo : splitPoint ≤ φ) (hhi : φ ≤ top) :
    Q φ - AT φ ≤ target := by
  have htwo : (2 : ℝ) ≤ splitPoint := by norm_num [splitPoint]
  have hp := P1_nonneg φ hlo hhi
  have hd := D_pos φ (htwo.trans hlo)
  have hq := Q_mul_D φ (htwo.trans hlo)
  dsimp only [P1] at hp
  have hmul : D φ * (Q φ - AT φ) ≤ D φ * target := by linarith [hp, hq]
  exact le_of_mul_le_mul_left hmul hd

def capAffine (φ : ℝ) : ℝ :=
  if φ ≤ splitPoint then AT φ - AR φ else AT φ

theorem low (φ : ℝ) (hlo : 2 ≤ φ) (hhi : φ ≤ top) :
    Q φ - capAffine φ ≤ target := by
  by_cases hsplit : φ ≤ splitPoint
  · simp only [capAffine, if_pos hsplit]
    linarith only [low_left φ hlo hsplit]
  · simpa only [capAffine, if_neg hsplit] using
      low_right φ (le_of_lt (lt_of_not_ge hsplit)) hhi

def scalarSimpson : ℝ := w / 6 * (1 / a + 4 / mid + 1 / b)
def Wupper : ℝ := scalarSimpson ^ 4 / (24 * a)

theorem high : (5 / 6 : ℝ) * Q top + Wupper / 6 < target := by
  norm_num [Q, Wupper, scalarSimpson, w, mid, a, b, top, target]

theorem high_le : (5 / 6 : ℝ) * Q top + Wupper / 6 ≤ target := high.le

