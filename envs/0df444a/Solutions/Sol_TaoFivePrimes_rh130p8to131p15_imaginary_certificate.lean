attribute [local irreducible] a r b
lemma ratio_positive (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : (654/5:ℝ) ≤ s.im) (hb : s.im ≤ (2623/20:ℝ)) :
    2 ≤ CertifiedLocalPolynomial.bivariatePowerValue 10 20 a
      (4*(s.re-1/2)^2) ((20/7)*(s.im-(654/5))) := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(20/7)*(s.im-(654/5)),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 20 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 10
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, (2:ℝ)≤(b i j:ℝ) := by
    intro i j
    exact_mod_cast bernstein_checked.2.2 i j
  exact CertifiedLocalPolynomial.bivariate_bernstein_lower 10 20 a r b hr hc 2 hl x y
end Imag107

theorem solution (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : (654/5:ℝ) ≤ s.im) (hb : s.im ≤ (2623/20:ℝ)) :
    (2:ℝ)*|s.re-1/2| ≤
      |(TaoFivePrimes_RHLocalRationalPolynomial TaoFivePrimes_RH128RoundedCoefficients14 (10^14)
        40 (256/2) s).im| := by
  have hp := Imag107.ratio_positive s h0 h1 ha hb
  rw [Imag107.imaginary_identity,abs_neg,abs_mul,abs_of_nonneg (by linarith :
    0 ≤ CertifiedLocalPolynomial.bivariatePowerValue 10 20 Imag107.a
      (4*(s.re-1/2)^2) ((20/7)*(s.im-(654/5))))]
  simpa only [mul_comm] using mul_le_mul_of_nonneg_left hp (abs_nonneg (s.re-1/2))
