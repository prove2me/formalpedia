open Real

namespace ExactVacuumAtlas.RNDeriv

theorem div_cube (K r : ℝ) (hr : r ≠ 0) : HasDerivAt (fun u => K / u ^ 3) (-3 * K / r ^ 4) r := by
  refine ((hasDerivAt_const r K).fun_div ((hasDerivAt_id' r).fun_pow 3)
    (pow_ne_zero 3 hr)).congr_deriv ?_
  push_cast
  field_simp
