section
-- Source module: Solutions.R6ChkCx
/-!
# Reflective checker for nested nondegenerate `F₂` label pairs (complex round six)

Data: a list of **groups**. A group is one natural number read as 32-bit fields (LSB first):
`kV, cnt, B (kV rows), H (n-kV), D (kV), E (n-kV)`, then `cnt` entries `kU, U (kU), EU (kU),
R (kV-kU)`. Rows are vectors of `F₂^n` (`n ≤ 24`).

* `grpChk n bad G : Bool` — two packed products for the label `V = span B`
  (`H·[B;E]ᵀ = [0 | I]`, `D·[H;B]ᵀ = [0 | I]`) and two per entry
  (`U·[H;EU]ᵀ = [0 | I]`, `R·[H;U;R]ᵀ = [0 | 0 | I]`), plus row range checks.
* `grpChk_sound`: if `grpChk n (BADf n) G = true` then `V` is nondegenerate of dimension `kV`,
  and for every entry `(U, kU)`, `PairOK n U kU V kV`: `span U ≤ span V`, `dim span U = kU`,
  `span U` nondegenerate, and `span U = span V` or some `w ∈ span V` has `w·w = 1`, `w ⊥ U`
  (i.e. `NetComplexP8.Up (span U) (span V)` with `Fd = kV - kU`; see `R6ChkCxBridge`).
-/

namespace R6Chk

open Matrix Module

/-! ## Stream decoding -/

theorem pow768 {k : ℕ} (hk : k ≤ 24) {X : ℕ} (h : X < 2 ^ (32 * k)) : X < 2 ^ 768 :=
  lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num) (by omega))

theorem cat_eq (X a Y : ℕ) : cat X a Y = X + (Y <<< (32 * a)) := rfl

theorem cat_lt {X Y a b : ℕ} (hX : X < 2 ^ (32 * a)) (hY : Y < 2 ^ (32 * b)) :
    cat X a Y < 2 ^ (32 * (a + b)) := append_lt hX hY

theorem vr_cat {n X a Y : ℕ} (hX : X < 2 ^ (32 * a)) (i : ℕ) :
    vr n (cat X a Y) i = if i < a then vr n X i else vr n Y (i - a) := by
  rw [vr, cat_eq, row_append hX]; split_ifs <;> rfl

theorem okR_spec {n bad X : ℕ} (hbad : bad = BADf n) (hn : n ≤ 32) (h : okR bad X = true)
    {i : ℕ} (hi : i < 48) : row X i < 2 ^ n := by
  rw [okR, nland, Nat.beq_eq, hbad] at h
  exact row_lt_of_bad hn h hi

/-! ## The checker -/

/-! ## Semantics -/

/-! ## Soundness -/

section Sound

variable {n bad : ℕ}

/-- Dot products against a two-block concatenation. -/
theorem dot_cat {A X a Y o k j i : ℕ} (hn : n ≤ 32) (hA : A < 2 ^ 768) (hX : X < 2 ^ (32 * a))
    (hc : cat X a Y < 2 ^ 768) (h : dotsF A (cat X a Y) = tgtF o k) (hok : o + k ≤ 24)
    (hj : j < 24) (hi : i < 24) (hr : row A j < 2 ^ n) :
    vr n A j ⬝ᵥ (if i < a then vr n X i else vr n Y (i - a)) =
      if j < k ∧ i = o + j then 1 else 0 := by
  rw [← vr_cat hX]
  rw [dotsF_eq, tgtF_eq] at h
  exact dot_of_dotsP_tgt hn hA hc h hok hj hi hr

theorem entsChk_sound (hbad : bad = BADf n) (hn : n ≤ 24) {kV nH H : ℕ} (hnk : nH + kV = n)
    (hH : H < 2 ^ (32 * nH)) (hHr : ∀ i < nH, row H i < 2 ^ n) (B : ℕ)
    (hmem : ∀ x, x ∈ spanP n B kV ↔ ∀ i : Fin nH, vr n H i ⬝ᵥ x = 0)
    (hV : NondegF (spanP n B kV)) (hVd : finrank (ZMod 2) (spanP n B kV) = kV) :
    ∀ cnt s, entsChk bad kV nH H cnt s = true → ∀ p ∈ entsDec kV cnt s, PairOK n p.1 p.2 B kV
  | 0, s, _, p, hp => by simp [entsDec] at hp
  | cnt + 1, s, h, p, hp => by
    have h' : entChk bad kV nH H s = true ∧ entsChk bad kV nH H cnt (entNext kV s) = true := by
      simpa [entsChk] using h
    have hp' : p = (tk (nx s) (f32 s), f32 s) ∨ p ∈ entsDec kV cnt (entNext kV s) := by
      simpa [entsDec] using hp
    rcases hp' with rfl | hp'
    · obtain ⟨a, b, c, d⟩ := entChk_sound hbad hn hnk hH hHr hmem hV hVd h'.1
      exact ⟨a, b, hVd, c, hV, d⟩
    · exact entsChk_sound hbad hn hnk hH hHr B hmem hV hVd cnt _ h'.2 p hp'

theorem grpBody_sound_sol_aux (hbad : bad = BADf n) (hn : n ≤ 24) {kV cnt B H D E s5 : ℕ}
    (hB : B < 2 ^ (32 * kV)) (hH : H < 2 ^ (32 * (n - kV))) (hD : D < 2 ^ (32 * kV))
    (hE : E < 2 ^ (32 * (n - kV))) (h : grpBody n bad kV cnt B H D E s5 = true) :
    finrank (ZMod 2) (spanP n B kV) = kV ∧ NondegF (spanP n B kV) ∧
      ∀ p ∈ entsDec kV cnt s5, PairOK n p.1 p.2 B kV := by
  simp only [grpBody, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, nsub] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hkv, hokB⟩, hokH⟩, hokD⟩, hokE⟩, h1⟩, h2⟩, h3⟩ := h
  generalize hnH : n - kV = nH at hH hE h1 h2 h3
  have hn32 : n ≤ 32 := by omega
  have hHr : ∀ j < 24, row H j < 2 ^ n := fun j hj => okR_spec hbad hn32 hokH (by omega)
  have hDr : ∀ j < 24, row D j < 2 ^ n := fun j hj => okR_spec hbad hn32 hokD (by omega)
  have d1 := fun {j i : ℕ} (hj : j < 24) (hi : i < 24) =>
    dot_cat (Y := E) hn32 (pow768 (by omega) hH) hB
      (pow768 (k := kV + nH) (by omega) (cat_lt hB hE)) h1 (by omega) hj hi (hHr j hj)
  have d2 := fun {j i : ℕ} (hj : j < 24) (hi : i < 24) =>
    dot_cat (Y := B) hn32 (pow768 (by omega) hD) hH
      (pow768 (k := nH + kV) (by omega) (cat_lt hH hB)) h2 (by omega) hj hi (hDr j hj)
  have hHB : ∀ (i : Fin nH) (j : Fin kV), vr n H i ⬝ᵥ vr n B j = 0 := by
    intro i j
    have := d1 (j := i) (i := j) (by omega) (by omega)
    rw [if_pos j.2, if_neg (by omega)] at this
    exact this
  have hHE : ∀ (i j : Fin nH), vr n H i ⬝ᵥ vr n E j = if i = j then 1 else 0 := by
    intro i j
    have := d1 (j := i) (i := kV + j) (by omega) (by omega)
    rw [if_neg (by omega), show kV + (j : ℕ) - kV = j by omega] at this
    rw [this]
    by_cases hij : i = j
    · subst hij; simp
    · rw [if_neg (by intro hh; exact hij (Fin.ext (by omega))), if_neg hij]
  have hDH : ∀ (j : Fin kV) (i : Fin nH), vr n D j ⬝ᵥ vr n H i = 0 := by
    intro j i
    have := d2 (j := j) (i := i) (by omega) (by omega)
    rw [if_pos i.2, if_neg (by omega)] at this
    exact this
  have hDB : ∀ (j i : Fin kV), vr n D j ⬝ᵥ vr n B i = if i = j then 1 else 0 := by
    intro j i
    have := d2 (j := j) (i := nH + i) (by omega) (by omega)
    rw [if_neg (by omega), show nH + (i : ℕ) - nH = i by omega] at this
    rw [this]
    by_cases hij : i = j
    · subst hij; simp
    · rw [if_neg (by intro hh; exact hij (Fin.ext (by omega))), if_neg hij]
  obtain ⟨hmem, hdim, hnd⟩ := label_of_cert (n := n) (k := kV) (m := nH)
    (b := fun i : Fin kV => vr n B i) (d := fun i : Fin kV => vr n D i)
    (h := fun i : Fin nH => vr n H i) (e := fun i : Fin nH => vr n E i)
    (by omega) hHB hHE hDH hDB
  exact ⟨hdim, hnd, entsChk_sound hbad hn (by omega) hH (fun i hi => hHr i (by omega)) B hmem hnd
    hdim _ _ h3⟩

end Sound

end R6Chk

end

theorem solution : type_of% @R6Chk.grpBody_sound_sol_aux := @R6Chk.grpBody_sound_sol_aux
