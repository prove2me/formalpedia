-- Proof module: Solutions.PruneOutputScalar

set_option autoImplicit false
namespace NearlyOptimalPPR.Computation
noncomputable section

set_option maxHeartbeats 2000000 in
lemma prune_output_clip_exec (m : SolveModel) {n : ℕ} (g : InputGraph n) (ω : ℕ → Bool)
    (st : MachineState) (hh : st.scalar.halted=false) (x c : ℝ)
    (hx : st.scalar.core.regs 10=x) (hc : st.scalar.core.regs 32=c) :
    ∃ out, MachineEval m g ω pruneOutputClipCode st 3 out ∧
      out.scalar.core.regs 10=max (x-c) 0 ∧
      out.scalar.integerMemory=st.scalar.integerMemory ∧ out.scalar.core.mem=st.scalar.core.mem ∧
      out.work=st.work+3 ∧ out.output=st.output ∧ out.scalar.halted=false := by
  let mid := payUnit (realWrite st 10 (x-c))
  have ea : MachineEval m g ω (coreCode (.sub 10 10 32)) st 1 mid := by
    simpa only [coreCode,RealOperation.instruction,RealOperation.value,hx,hc,mid] using binary_eval m g ω st .sub 10 10 32 hh
  have hm10 : mid.scalar.core.regs 10=x-c := by simp [mid,payUnit,pcSet,realWrite]
  have hmH : mid.scalar.halted=false := hh
  by_cases hxc : x-c ≤ 0
  · let out := payUnit (realWrite (payUnit mid) 10 0)
    have eb : MachineEval m g ω (coreCode (.const 10 0)) (payUnit mid) 1 out := const_eval m g ω (payUnit mid) 10 0 hmH
    refine ⟨out,MachineEval.seq ea (MachineEval.realNonpos hmH (by rw [hm10]; exact hxc) eb),?_,rfl,rfl,?_,rfl,hh⟩
    · simp [out,payUnit,pcSet,realWrite,max_eq_right hxc]
    · change st.work+1+1+1=st.work+3
      norm_num; ring
  · let out := payUnit (payUnit mid)
    have eb : MachineEval m g ω (.branchReal 10 (coreCode (.const 10 0)) .skip) mid 2 out :=
      MachineEval.realPos hmH (by rw [hm10]; exact hxc) (MachineEval.skip (payUnit mid))
    refine ⟨out,MachineEval.seq ea eb,?_,rfl,rfl,?_,rfl,hh⟩
    · change x-c=max (x-c) 0
      exact (max_eq_left (le_of_not_ge hxc)).symm
    · change st.work+1+1+1=st.work+3
      norm_num; ring

end
end NearlyOptimalPPR.Computation

-- Proof module: Solutions.PrunedOutputBody

set_option autoImplicit false
set_option maxRecDepth 10000
namespace NearlyOptimalPPR.Computation
noncomputable section

set_option maxHeartbeats 2200000 in
lemma pruned_output_body_exec (m : SolveModel) {n : ℕ} (g : InputGraph n) (ω : ℕ → Bool)
    (st : MachineState) (hh : st.scalar.halted=false) (width : ℕ) (head next : ℤ) (v : Fin n) (α z clip : ℝ)
    (h0 : st.scalar.core.ptrs 0=0) (h41 : st.scalar.core.ptrs 41=(width : ℤ)) (hhead : st.scalar.core.ptrs 94=head)
    (hkey : st.scalar.integerMemory head=(v.val : ℤ)) (hnext : st.scalar.integerMemory (head+2)=next)
    (hdeg : st.scalar.integerMemory (vertexRecordAddress width v.val 0)=((g.neighbors v).length : ℤ))
    (ha : st.scalar.core.regs 30=α) (hClip : st.scalar.core.regs 32=clip) (hz : st.scalar.core.mem (vertexRecordAddress width v.val 0)=z) :
    ∃ out, MachineEval m g ω prunedOutputBodyCode st (8*width+29) out ∧ out.scalar.core.ptrs 94=next ∧
      out.scalar.integerMemory=st.scalar.integerMemory ∧ out.scalar.core.mem=st.scalar.core.mem ∧
      out.scalar.queries=st.scalar.queries ∧ out.work=st.work+(8*width+29 : ℕ) ∧
      out.output=st.output++[((v.val : ℤ),α*((g.neighbors v).length : ℝ)*max (z-clip) 0)] ∧ out.scalar.halted=false := by
  obtain ⟨a,ea,a40,a94,a44,aI,aR,aQ,aW,aO,aH⟩ := push_output_read_exec m g ω st hh head next v hhead hkey hnext
  have a0 := (ea.pointer_frame 0 (by decide)).trans h0
  have a41 := (ea.pointer_frame 41 (by decide)).trans h41
  obtain ⟨b,eb,b10,bI,bR,bW,bO,bH⟩ := vertex_real_load_exec m g ω a aH width v.val 0 a0 a40 a41 a44
  have b0 := (eb.pointer_frame 0 (by decide)).trans a0
  have b40 := (eb.pointer_frame 40 (by decide)).trans a40
  have b41 := (eb.pointer_frame 41 (by decide)).trans a41
  have b10' : b.scalar.core.regs 10=z := by rw [b10,aR]; exact hz
  obtain ⟨c,ec,c60,cI,cR,cQ,cW,cO,cH⟩ := vertex_field_read_exec m g ω b bH width v.val 0 60 b0 b40 b41
  have c60' : c.scalar.core.ptrs 60=((g.neighbors v).length : ℤ) := by rw [c60,bI,aI]; exact hdeg
  have c40 := (ec.pointer_frame 40 (by decide)).trans b40
  have c10 := (ec.real_register_frame 10 (by decide)).trans b10'
  have c30 := (ec.real_register_frame 30 (by decide)).trans ((eb.real_register_frame 30 (by decide)).trans ((ea.real_register_frame 30 (by decide)).trans ha))
  have c32 : c.scalar.core.regs 32=clip :=
    (ec.real_register_frame 32 (by decide)).trans ((eb.real_register_frame 32 (by decide)).trans ((ea.real_register_frame 32 (by decide)).trans hClip))
  obtain ⟨d,ed,d10,dI,dR,dW,dO,dH⟩ := prune_output_clip_exec m g ω c cH z clip c10 c32
  have d40 := (ed.pointer_frame 40 (by decide)).trans c40
  have d60 := (ed.pointer_frame 60 (by decide)).trans c60'
  have d30 := (ed.real_register_frame 30 (by decide)).trans c30
  obtain ⟨out,ef,fI,fR,fQ,fW,fO,fH⟩ := push_output_scalar_exec m g ω d dH v α (max (z-clip) 0) (g.neighbors v).length d40 d60 d30 d10
  have ex : MachineEval m g ω prunedOutputBodyCode st (8*width+29) out := by
    have e := MachineEval.seq ea (MachineEval.seq eb (MachineEval.seq ec (MachineEval.seq ed ef)))
    convert e using 1 <;> (first | rfl | ring)
  refine ⟨out,ex,?_,fI.trans (dI.trans (cI.trans (bI.trans aI))),fR.trans (dR.trans (cR.trans (bR.trans aR))),ex.query_frame (by decide),?_,?_,fH⟩
  · exact (ef.pointer_frame 94 (by decide)).trans ((ed.pointer_frame 94 (by decide)).trans ((ec.pointer_frame 94 (by decide)).trans ((eb.pointer_frame 94 (by decide)).trans a94)))
  · rw [fW,dW,cW,bW,aW]; push_cast; ring
  · rw [fO,dO,cO,bO,aO]

end
end NearlyOptimalPPR.Computation

