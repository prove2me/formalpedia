--   Algorithm to compute the rank and a Cartan subalgebra of a matrix Lie algebra with Mathematica, arXiv:math/0205235v1, PDF p. 14, compact g2: rank 2 and Cartan from b1+5b5

import Definitions.Def_QAlgorithms_Papers_Independent_Gap48_P15

namespace QAlgorithms.Papers.Independent.Gap48.P15

attribute [local instance 100] LieRing.ofAssociativeRing

-- Reuse Mathlib Matrix and Matrix.single directly. Natural one-based
-- coordinates are restricted to Fin coordinates with Matrix.submatrix.

/-- Compact g2 has rank 2 and the distinct Cartan basis [b1+5b5,b1+5b9].
Source: PDF p. 14, second RankOfg2 output. -/
theorem compactG2_mixed_rank_cartan :
    LieAlgebra.rank ℝ compactG2 = 2 ∧
    isCartanBasisFor compactG2 ![bG2 0 + (5 : ℝ) • bG2 4,
      bG2 0 + (5 : ℝ) • bG2 8] := by sorry

end QAlgorithms.Papers.Independent.Gap48.P15
