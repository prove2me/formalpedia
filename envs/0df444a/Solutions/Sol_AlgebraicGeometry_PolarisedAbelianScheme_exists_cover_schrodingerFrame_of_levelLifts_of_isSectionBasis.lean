theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

theorem appLE_top_top {X Y : Scheme.{0}} (f : X ⟶ Y) : f.appLE ⊤ ⊤ le_top = f.appTop :=
  (Scheme.Hom.app_eq_appLE f).symm

theorem bijective_iff_isSectionBasis {S : Type} [CommRing S] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of S)) (𝓛 : A.Modules)
    {R : Type} [CommRing R] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))
    {H : Type} [Fintype H] {m : ℕ} (e : Fin m ≃ H)
    (σ : H → Γ((Scheme.Modules.pullback (pullback.fst f t)).obj 𝓛, ⊤)) :
    Function.Bijective (fun c : H → R => ∑ h, baseScalar f t (c h) • σ h) ↔
      Scheme.Modules.IsSectionBasis (pullback.snd f t) ((Scheme.Modules.pullback (pullback.fst f t)).obj 𝓛) (σ ∘ e) := by
  classical
  have key : (fun c : Fin m → R => ∑ i, ((pullback.snd f t).appLE ⊤ ⊤ le_top).hom
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (c i)) • (σ ∘ e) i) =
      (fun c : H → R => ∑ h, baseScalar f t (c h) • σ h) ∘ (fun c : Fin m → R => c ∘ e.symm) := by
    funext c
    simp only [Function.comp_apply, appLE_top_top]
    rw [← e.sum_comp]
    simp [baseScalar]
  show _ ↔ Function.Bijective (fun c : Fin m → R => ∑ i, ((pullback.snd f t).appLE ⊤ ⊤ le_top).hom
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (c i)) • (σ ∘ e) i)
  rw [key]
  have hb : Function.Bijective (fun c : Fin m → R => c ∘ e.symm) :=
    (⟨fun c => c ∘ e.symm, fun c => c ∘ e, fun c => by funext i; simp, fun c => by funext h; simp⟩ : (Fin m → R) ≃ (H → R)).bijective
  exact (Function.Bijective.of_comp_iff _ hb).symm

theorem app_baseScalar {S : Type} [CommRing S] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of S))
    {R R' : Type} [CommRing R] [CommRing R'] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))
    (t' : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of S)) (ψ : R →+* R')
    (b : pullback f t' ⟶ pullback f t) (hb₂ : b ≫ pullback.snd f t = pullback.snd f t' ≫ Spec.map (CommRingCat.ofHom ψ)) (r : R) :
    (b.app ⊤).hom (baseScalar f t r) = baseScalar f t' (ψ r) := by
