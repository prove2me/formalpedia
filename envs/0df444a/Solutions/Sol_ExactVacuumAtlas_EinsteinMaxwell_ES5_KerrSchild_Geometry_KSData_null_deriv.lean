variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (c : Fin 5) :
    ∑ p, ∑ q, pd c (b p q) x * k x p * k x q
      + 2 * ∑ p, lowerK b k x p * pd c (fun y => k y p) x = 0 := by
  have h0 : pd c (fun y => ∑ p, ∑ q, b p q y * k y p * k y q) x = 0 := by
    rw [pd_congr_of_eqOn hD.isOpen hx (f := fun y => ∑ p, ∑ q, b p q y * k y p * k y q)
      (h := fun _ => (0 : ℝ)) (fun y hy => hD.null y hy) c]
    exact pd_const 0 c x
  rw [pd_quad (hD.diff_b hx) (hD.diff_k hx) c] at h0
  simp only [Finset.sum_add_distrib] at h0
  have e1 : ∑ p, ∑ q, b p q x * pd c (fun y => k y p) x * k x q =
      ∑ p, lowerK b k x p * pd c (fun y => k y p) x := by
    refine Finset.sum_congr rfl fun p _ => ?_
    unfold lowerK
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun q _ => by ring
  have e2 : ∑ p, ∑ q, b p q x * k x p * pd c (fun y => k y q) x =
      ∑ p, lowerK b k x p * pd c (fun y => k y p) x := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [← hD.sum_k_mul_b hx q, Finset.sum_mul]
    exact Finset.sum_congr rfl fun p _ => by ring
  rw [e1, e2] at h0
  linarith
