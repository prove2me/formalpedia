theorem gauss_of_intPoly_units
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀]
    (ι : A₀ →+* ↥A) [IsLocalHom ι] (hι : Function.Injective ι)
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι))
    (ϖ₀ : A₀) (hϖ₀ : maximalIdeal A₀ = Ideal.span {ϖ₀})
    (F₀ : Subfield ↥(fieldBar q M')) [Algebra A₀ ↥F₀]
    (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀)
    (V : ValuationSubring ↥F₀) (hconstV : ∀ a : A₀, algebraMap A₀ ↥F₀ a ∈ V)
    (hϖV : (⟨algebraMap A₀ ↥F₀ ϖ₀, hconstV ϖ₀⟩ : ↥V) ∈ maximalIdeal ↥V)
    (hĵV : (⟨_, hjF₀⟩ : ↥F₀) ∈ V)
    (hA_V : ∀ M : Polynomial ℤ, M.map (Int.castRingHom (ResidueField ↥A)) ≠ 0 →
      IsUnit (M.eval₂ (Int.castRingHom ↥V) ⟨(⟨_, hjF₀⟩ : ↥F₀), hĵV⟩)) :
    ∀ P : Polynomial A₀, P.map (IsLocalRing.residue A₀) ≠ 0 →
      ∃ h : Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P ∈ V, IsUnit (⟨_, h⟩ : ↥V) := by
  intro P hP
  classical
  have hloc : ∀ m ∈ maximalIdeal A₀, (⟨algebraMap A₀ ↥F₀ m, hconstV m⟩ : ↥V) ∈ maximalIdeal ↥V := by
    intro m hm
    rw [hϖ₀] at hm
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hm
    have : (⟨algebraMap A₀ ↥F₀ (r * ϖ₀), hconstV _⟩ : ↥V) =
        ⟨algebraMap A₀ ↥F₀ r, hconstV r⟩ * ⟨algebraMap A₀ ↥F₀ ϖ₀, hconstV ϖ₀⟩ :=
      Subtype.ext (by simp only [MulMemClass.coe_mul, map_mul])
    rw [this]; exact Ideal.mul_mem_left _ _ hϖV

  let φV : A₀ →+* ↥V :=
    { toFun := fun a => ⟨algebraMap A₀ ↥F₀ a, hconstV a⟩
      map_one' := Subtype.ext (by simp only [OneMemClass.coe_one, map_one])
      map_mul' := fun a b => Subtype.ext (by simp only [MulMemClass.coe_mul, map_mul])
      map_zero' := Subtype.ext (by simp only [ZeroMemClass.coe_zero, map_zero])
      map_add' := fun a b => Subtype.ext (by simp only [AddMemClass.coe_add, map_add]) }
  have hlocφ : ∀ a ∈ maximalIdeal A₀, φV a ∈ maximalIdeal ↥V := fun a ha => hloc a ha

  haveI hκA : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField_of_isAlgClosed A
  haveI hκA₀ : IsAlgClosed (ResidueField A₀) := by
    let rι : ResidueField A₀ →+* ResidueField ↥A := IsLocalRing.ResidueField.map ι
    have hrι : Function.Bijective rι := by
      refine ⟨rι.injective, fun y => ?_⟩
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨a, ha⟩ := hres (IsLocalRing.residue ↥A x)
      exact ⟨IsLocalRing.residue A₀ a, by rw [← ha]; rfl⟩
    exact IsAlgClosed.of_ringEquiv (ResidueField ↥A) _ (RingEquiv.ofBijective rι hrι).symm
  haveI hchar : CharP (ResidueField ↥A) q := by
    apply (CharP.charP_iff_prime_eq_zero (Fact.out : q.Prime)).mpr
    have hqmax : ((q : ℕ) : ↥A) ∈ maximalIdeal ↥A := by
      apply (ValuationSubring.coe_mem_nonunits_iff).mp
      have : ((q : ↥A) : AlgebraicClosure ℚ) = (q : AlgebraicClosure ℚ) := by push_cast; rfl
      rw [this]; exact hA
    rw [← map_natCast (IsLocalRing.residue ↥A), IsLocalRing.residue_eq_zero_iff]; exact hqmax
  set t : ↥V := ⟨(⟨_, hjF₀⟩ : ↥F₀), hĵV⟩ with ht

  have hB : ∀ c : A₀, IsUnit (t - φV c) := by
    intro c
    have halg : IsAlgebraic ℤ ((ι c : ↥A) : AlgebraicClosure ℚ) :=
      (IsFractionRing.isAlgebraic_iff ℤ ℚ (AlgebraicClosure ℚ)).mpr ((AlgebraicClosure.isAlgebraic ℚ).isAlgebraic _)
    obtain ⟨M₀, hM₀0, hM₀⟩ := halg
    have hMroot : Polynomial.aeval ((ι c : ↥A) : AlgebraicClosure ℚ) M₀.primPart = 0 := by
      have h := hM₀
      rw [M₀.eq_C_content_mul_primPart, map_mul, Polynomial.aeval_C, mul_eq_zero] at h
      rcases h with h | h
      · exfalso
        exact hM₀0 (Polynomial.content_eq_zero_iff.mp
          ((map_eq_zero_iff (algebraMap ℤ (AlgebraicClosure ℚ)) (algebraMap ℤ (AlgebraicClosure ℚ)).injective_int).mp h))
      · exact h
    have hMbar : M₀.primPart.map (Int.castRingHom (ResidueField ↥A)) ≠ 0 := by
      intro h0
      have hdvd : Polynomial.C (q : ℤ) ∣ M₀.primPart := by
        rw [Polynomial.C_dvd_iff_dvd_coeff]
        intro i
        apply (CharP.intCast_eq_zero_iff (ResidueField ↥A) q _).mp
        have := congrArg (fun p => Polynomial.coeff p i) h0
        simpa [Polynomial.coeff_map] using this
      have hu := M₀.isPrimitive_primPart (q : ℤ) hdvd
      rw [Int.isUnit_iff] at hu
      have hq2 := (Fact.out : q.Prime).two_le
      omega
    have hMt := hA_V _ hMbar
    have hMc : M₀.primPart.eval₂ (Int.castRingHom A₀) c = 0 := by
      apply hι
      rw [map_zero, map_eval₂_intCast]
      apply Subtype.ext
      change A.subtype (M₀.primPart.eval₂ (Int.castRingHom ↥A) (ι c)) = ((0 : ↥A) : AlgebraicClosure ℚ)
      rw [map_eval₂_intCast, ZeroMemClass.coe_zero, ← hMroot, Polynomial.aeval_def]
      congr 1
    have hdvd : t - φV c ∣ M₀.primPart.eval₂ (Int.castRingHom ↥V) t := by
      have h := Polynomial.sub_dvd_eval_sub t (φV c) (M₀.primPart.map (Int.castRingHom ↥V))
      rw [Polynomial.eval_map, Polynomial.eval_map, ← map_eval₂_intCast _ φV c, hMc, map_zero, sub_zero] at h
      exact h
    exact isUnit_of_dvd_unit hdvd hMt
  have hu : IsUnit (P.eval₂ φV t) := isUnit_eval₂_of_map_residue_ne_zero φV hlocφ t hB P hP
  have hval : ((P.eval₂ φV t : ↥V) : ↥F₀) = Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P := by
    change V.subtype (P.eval₂ φV t) = _
    rw [Polynomial.hom_eval₂, Polynomial.aeval_def]
    congr 1
  refine ⟨hval ▸ (P.eval₂ φV t).2, ?_⟩
  have : (⟨Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P, hval ▸ (P.eval₂ φV t).2⟩ : ↥V) = P.eval₂ φV t := Subtype.ext hval.symm
  rw [this]; exact hu

