    have e3 : ((Q.b : ℝ) ^ 6) ≤ Q.T := by exact_mod_cast hQ.hb6
    rw [e2] at e1; linarith
  -- the linear part
  have hFB : F + BN6 Q + 1 ≤ (32500 * C + 6) * (Q.p * Lg ^ 2) := by
    have h1 : (BN6 Q : ℝ) + 1 ≤ 6 * (Q.p * Lg ^ 2) := by
