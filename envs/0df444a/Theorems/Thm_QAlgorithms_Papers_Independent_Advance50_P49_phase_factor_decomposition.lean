/-- PDF pp.26–28, Theorem 3/G18. G17's printed range is corrected to all
physical even l, as required by G32–G33. No uniqueness is claimed. -/
theorem phase_factor_decomposition (n : ℕ) :
    (finitePhaseGroup n : Set (Op n)).Finite ∧
    (∀ A B : Op n, A ∈ finitePhaseGroup n → B ∈ finitePhaseGroup n → A*B=B*A) ∧
    ∀ V : Op n, SymUnitary V →
      ∃ Vtilde Vzero : Op n, Special Vtilde ∧
        Vtilde ∈ exchangeGroup n false false ∧ Vzero ∈ finitePhaseGroup n ∧
        V = Vtilde*Vzero*centralPhaseFactor V ∧
        Vtilde*Vzero=Vzero*Vtilde ∧
        Vtilde*centralPhaseFactor V=centralPhaseFactor V*Vtilde ∧
        Vzero*centralPhaseFactor V=centralPhaseFactor V*Vzero := by sorry

end QAlgorithms.Papers.Independent.Advance50.P49

end
