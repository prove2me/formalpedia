lemma bucketList_ordered : bucketList.IsChain ReciprocalMassOrdered.ordered := by decide +kernel

def buckets : Finset Bucket := ReciprocalMassOrdered.finsetOfChain bucketList bucketList_ordered

lemma bucketList_eq : bucketList.toFinset = buckets :=
  ReciprocalMassOrdered.toFinset_eq_finsetOfChain bucketList bucketList_ordered

lemma positive : ∀ b ∈ buckets, 1 ≤ b.lower := by decide +kernel

lemma separated : ∀ a ∈ buckets, ∀ b ∈ buckets, a ≠ b →
    a.upper < b.lower ∨ b.upper < a.lower := by
  rw [← bucketList_eq]
  exact ReciprocalMassOrdered.disjoint_of_chain bucketList (by decide +kernel)

lemma valid_union (S : ℕ) (a b : Finset Bucket)
    (ha : Valid S a) (hb : Valid S b) : Valid S (a ∪ b) := by
  intro x hx
  rcases Finset.mem_union.mp hx with h | h
  · exact ha x h
  · exact hb x h

