section SC6b_sec

open MeasureTheory Set Filter Topology

namespace MasulloGRH

attribute [local instance] kms

lemma pow_bound (u v : ℝ) (hu : 0 ≤ u) (hv : 0 ≤ v) (q : ℕ) :
    (1 + u + v) ^ q ≤ 3 ^ q * (1 + u ^ q + v ^ q) := by
  have hM1 := le_max_left 1 (max u v)
  have hM2 := le_max_right 1 (max u v)
  have hu' := le_max_left u v
  have hv' := le_max_right u v
  have hmax : 1 + u + v ≤ 3 * max 1 (max u v) := by linarith
  have hM : max 1 (max u v) ^ q ≤ 1 + u ^ q + v ^ q := by
    have h1 : 0 ≤ u ^ q := pow_nonneg hu q
    have h2 : 0 ≤ v ^ q := pow_nonneg hv q
    rcases max_cases 1 (max u v) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h]
    · simp; linarith
    · rcases max_cases u v with ⟨h', _⟩ | ⟨h', _⟩ <;> rw [h'] <;> linarith
  calc (1 + u + v) ^ q ≤ (3 * max 1 (max u v)) ^ q :=
        pow_le_pow_left₀ (by positivity) hmax q
    _ = 3 ^ q * max 1 (max u v) ^ q := mul_pow _ _ _
    _ ≤ 3 ^ q * (1 + u ^ q + v ^ q) := by gcongr

lemma norm_wf {m n r s : ℕ} {d : Fin s → ℕ} (g : ElemGroup m n r s d → ℂ) (p : ℕ × ℕ × ℕ) (q) :
    ‖wf g p q‖ = ‖q.1‖ ^ p.2.1 * ‖q.2.2.1‖ ^ p.1 *
      ‖iteratedFDeriv ℝ p.2.2 (elemLift g q.1 q.2.1) q.2.2‖ := by
  unfold wf
  rw [norm_smul, Real.norm_of_nonneg (by positivity)]

end MasulloGRH

end SC6b_sec

section SC6c_sec

open MeasureTheory Set Filter Topology

namespace MasulloGRH

attribute [local instance] kms

theorem schwartz_correspondence_main
    (P : Type*) [CommGroup P] [TopologicalSpace P] [IsTopologicalGroup P] [T2Space P]
    [LocallyCompactSpace P] (P₀ : Subgroup P) (hP₀ : IsOpen (P₀ : Set P))
    (m n r s : ℕ) (d : Fin s → ℕ) (hd : ∀ i, d i ≠ 0)
    (α : ↥P₀ →* Multiplicative (ElemGroup m n r s d)) (hαc : Continuous α) (hαo : IsOpenMap α)
    (hαk : IsCompact {x : ↥P₀ | α x = 1})
    (m' n' r' s' : ℕ) (d' : Fin s' → ℕ)
    (β : P →* Multiplicative (ElemGroup m' n' r' s' d')) (hβc : Continuous β)
    (hβo : IsOpenMap β) (hβk : IsCompact {x : P | β x = 1}) :
    ∃ T : ElemSchwartz m n r s d →ₗ[ℂ] ElemSchwartz m' n' r' s' d', Continuous T ∧
      ∀ g : ElemSchwartz m n r s d,
        (∀ p : P, (T g).toFun (Multiplicative.toAdd (β p)) =
          schwartzBruhatAverage ⊤ β.ker (extendPullback P₀ α g.toFun) p) ∧
        ∀ e : ElemGroup m' n' r' s' d',
          e ∉ Set.range (fun p : P => Multiplicative.toAdd (β p)) → (T g).toFun e = 0 := by
  classical
  let K := β.ker
  have hK : IsCompact (K : Set P) := hβk
  haveI : CompactSpace K := isCompact_iff_compactSpace.1 hK
  haveI := subgroupHaar_isProb K hK
  have hμreal : (subgroupHaar K).real univ = 1 := by simp [Measure.real]
  obtain ⟨Λ, hΛ⟩ := exists_linear_lift P₀ hP₀ α hαc β hβc hβo hβk
  let Λc : (Fin m' → ℝ) × (Fin n' → ℝ) →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ) :=
    LinearMap.toContinuousLinearMap Λ
  have hΛc : ∀ w, Λc w = Λ w := fun _ => rfl
  obtain ⟨C₁, hC₁⟩ := proper_bound P₀ hP₀ hd α hαc hαo hαk β hβc
  let ea : P₀ → ElemGroup m n r s d := fun p => Multiplicative.toAdd (α p)
  let eb : P → ElemGroup m' n' r' s' d' := fun p => Multiplicative.toAdd (β p)
  have ea_mul : ∀ p q, ea (p * q) = ea p + ea q := fun p q => by simp [ea]
  have ea_inv : ∀ p, ea p⁻¹ = - ea p := fun p => by simp [ea]
  have eb_mul : ∀ p q, eb (p * q) = eb p + eb q := fun p q => by simp [eb]
  have eb_inv : ∀ p, eb p⁻¹ = - eb p := fun p => by simp [eb]
  have ebK : ∀ y : K, eb y = 0 := fun y => by
    show Multiplicative.toAdd (β y) = 0
    rw [(MonoidHom.mem_ker).1 y.2]; rfl
  -- the transported function
  let hfun : (ElemGroup m n r s d → ℂ) → ElemGroup m' n' r' s' d' → ℂ := fun g e' =>
    if h : ∃ p : P, eb p = e' then Fav K (extendPullback P₀ α g) h.choose else 0
  have hfun_β : ∀ g p, hfun g (eb p) = Fav K (extendPullback P₀ α g) p := by
    intro g p
    have h : ∃ p' : P, eb p' = eb p := ⟨p, rfl⟩
    simp only [hfun, dif_pos h]
    have hp' : β h.choose = β p := Multiplicative.toAdd.injective h.choose_spec
    have hk : h.choose⁻¹ * p ∈ K := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hp', inv_mul_cancel]
    have := Fav_inv K hK (extendPullback P₀ α g) h.choose ⟨_, hk⟩
    simp only [mul_inv_cancel_left] at this
    exact this.symm
  -- the open subgroup `β(P₀)`
  let βP₀ : AddSubgroup (ElemGroup m' n' r' s' d') :=
    { carrier := {e | ∃ p : P₀, eb p = e}
      add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, eb_mul a b⟩
      zero_mem' := ⟨1, by simp [eb]⟩
      neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨a⁻¹, eb_inv a⟩ }
  have hβP₀o : IsOpen (βP₀ : Set (ElemGroup m' n' r' s' d')) := by
    have : (βP₀ : Set (ElemGroup m' n' r' s' d')) =
        Multiplicative.toAdd '' (β '' (Subtype.val '' (univ : Set P₀))) := by
      ext e
      constructor
      · rintro ⟨p, rfl⟩; exact ⟨β p, ⟨p, ⟨p, trivial, rfl⟩, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨_, ⟨p, -, rfl⟩, rfl⟩, rfl⟩; exact ⟨p, rfl⟩
    rw [this]
    exact LCA.isOpenMap_toAdd' _ (hβo _ (hP₀.isOpenMap_subtype_val _ isOpen_univ))
  -- the integrand
  let I : (ElemGroup m n r s d → ℂ) → P₀ → (Fin m' → ℝ) × (Fin n' → ℝ) → K → ℂ :=
    fun g p₀ w y => extendPullback P₀ α (fun e => g (e + expE (Λc w))) ((p₀ : P) * y)
  -- key formula
  have KF : ∀ g (p₀ : P₀) w, hfun g (eb p₀ + expE w) = ∫ y : K, I g p₀ w y ∂subgroupHaar K := by
    intro g p₀ w
    obtain ⟨pw, hpw, q, hq, hα⟩ := hΛ w
    have e1 : eb p₀ + expE w = eb ((p₀ : P) * pw) := by
      rw [eb_mul]; congr 1; exact hpw.symm
    rw [e1, hfun_β]
    have hqK : (q : P) ∈ K := (MonoidHom.mem_ker).2 hq
    rw [← integral_shift K hK _ ⟨q, hqK⟩]
    unfold Fav
    congr 1; funext y
    simp only [I, extendPullback]
    have e2 : (p₀ : P) * pw * y = (p₀ : P) * ((q : P) * y) * ((pw : P) * (q : P)⁻¹) := by
      calc (p₀ : P) * pw * y = (p₀ : P) * (((pw : P) * (q : P)⁻¹) * ((q : P) * y)) := by group
        _ = (p₀ : P) * (((q : P) * y) * ((pw : P) * (q : P)⁻¹)) := by
            rw [mul_comm ((pw : P) * (q : P)⁻¹)]
        _ = _ := by group
    have hmem : ((p₀ : P) * pw * y ∈ P₀) ↔ ((p₀ : P) * ((q : P) * y) ∈ P₀) := by
      rw [e2]
      constructor
      · intro h
        have h2 : ((pw : P) * (q : P)⁻¹) ∈ P₀ := P₀.mul_mem pw.2 (P₀.inv_mem q.2)
        have := P₀.mul_mem h (P₀.inv_mem h2)
        rwa [mul_inv_cancel_right] at this
      · intro h
        exact P₀.mul_mem h (P₀.mul_mem pw.2 (P₀.inv_mem q.2))
    by_cases hy : (p₀ : P) * ((q : P) * y) ∈ P₀
    · have hy' := hmem.2 hy
      simp only [Subgroup.coe_mul, dif_pos hy', dif_pos hy]
      congr 1
      have e3 : (⟨(p₀ : P) * pw * y, hy'⟩ : P₀) =
          ⟨(p₀ : P) * ((q : P) * y), hy⟩ * (pw * q⁻¹) := by
        apply Subtype.ext
        simp only [Subgroup.coe_mul, Subgroup.coe_inv]
        exact e2
      have := congrArg ea e3
      simp only [ea_mul, ea_inv] at this
      have hα' : ea pw = expE (Λ w) + ea q := hα
      show ea _ = ea _ + expE (Λc w)
      rw [this, hα', hΛc]; abel
    · have hy' : ¬ ((p₀ : P) * pw * y ∈ P₀) := fun h => hy (hmem.1 h)
      simp only [Subgroup.coe_mul, dif_neg hy', dif_neg hy]
  -- vanishing off `β(P₀)`
  have VAN : ∀ g e', e' ∉ βP₀ → hfun g e' = 0 := by
    intro g e' he'
    by_cases h : ∃ p : P, eb p = e'
    · obtain ⟨p, rfl⟩ := h
      rw [hfun_β]
      unfold Fav
      have : (fun y : K => extendPullback P₀ α g (p * y)) = fun _ => 0 := by
        funext y
        simp only [extendPullback]
        rw [dif_neg]
        intro hpy
        apply he'
        refine ⟨⟨_, hpy⟩, ?_⟩
        show eb (p * y) = eb p
        rw [eb_mul, ebK, add_zero]
      rw [this, integral_zero]
    · simp only [hfun, dif_neg h]
  -- slices
  have hslice : ∀ g (a' : Fin r' → ℤ) (b' : (i : Fin s') → ZMod (d' i)) w,
      elemLift (hfun g) a' b' w = hfun g (((0, 0, a', b') : ElemGroup m' n' r' s' d') + expE w) := by
    intro g a' b' w
    unfold elemLift
    congr 1
    ext <;> simp [expE]
  -- properties of the integrand
  have Iprops : ∀ g (hg : IsRapidDecay g) (p₀ : P₀),
      (∀ y, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun w => I g p₀ w y)) ∧
      (∀ k : ℕ, Continuous (fun pr : ((Fin m' → ℝ) × (Fin n' → ℝ)) × K =>
        iteratedFDeriv ℝ k (fun w => I g p₀ w pr.2) pr.1)) ∧
      (∀ (k : ℕ) w (y : K), ∀ hy : (p₀ : P) * y ∈ P₀,
        iteratedFDeriv ℝ k (fun w => I g p₀ w y) w =
          Ψb g Λc k (ea ⟨_, hy⟩ + expE (Λc w))) ∧
      (∀ (k : ℕ) w (y : K), (p₀ : P) * y ∉ P₀ →
        iteratedFDeriv ℝ k (fun w => I g p₀ w y) w = 0) := by
    intro g hg p₀
    let S : Set K := {y | (p₀ : P) * y ∈ P₀}
    have hP₀cl : IsClosed (P₀ : Set P) := Subgroup.isClosed_of_isOpen P₀ hP₀
    have hSc : IsClopen S := ⟨hP₀cl.preimage (continuous_const.mul continuous_subtype_val),
      hP₀.preimage (continuous_const.mul continuous_subtype_val)⟩
    let et : K → ElemGroup m n r s d := fun y =>
      if h : (p₀ : P) * y ∈ P₀ then ea ⟨_, h⟩ else 0
    have het : ContinuousOn et S := by
      rw [continuousOn_iff_continuous_domRestrict]
      have : S.domRestrict et = fun y : S => ea ⟨(p₀ : P) * y, y.2⟩ := by
        funext y
        show (if h : (p₀ : P) * ((y : K) : P) ∈ P₀ then ea ⟨_, h⟩ else 0) = _
        rw [dif_pos (show (p₀ : P) * ((y : K) : P) ∈ P₀ from y.2)]
      rw [this]
      exact (continuous_toAdd.comp hαc).comp
        ((continuous_const.mul (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _)
    have hIeq : ∀ w (y : K), I g p₀ w y =
        if y ∈ S then g (et y + expE (Λc w)) else 0 := by
      intro w y
      simp only [I, extendPullback, et, S, mem_setOf_eq]
      split_ifs <;> rfl
    have hIy_in : ∀ (y : K) (hy : (p₀ : P) * y ∈ P₀),
        (fun w => I g p₀ w y) = fun w => g (ea ⟨_, hy⟩ + expE (Λc w)) := by
      intro y hy; funext w
      rw [hIeq]
      have hyS : y ∈ S := hy
      simp only [hyS, if_true, et, dif_pos hy]
    have hIy_out : ∀ (y : K), (p₀ : P) * y ∉ P₀ → (fun w => I g p₀ w y) = fun _ => 0 := by
      intro y hy; funext w
      rw [hIeq]
      have hyS : y ∉ S := hy
      simp only [hyS, if_false]
    have hD : ∀ (k : ℕ) w (y : K), iteratedFDeriv ℝ k (fun w => I g p₀ w y) w =
        if y ∈ S then Ψb g Λc k (et y + expE (Λc w)) else 0 := by
      intro k w y
      by_cases hy : (p₀ : P) * y ∈ P₀
      · have hyS : y ∈ S := hy
        rw [hIy_in y hy, phi_iter_Ψb hg]
        simp only [hyS, if_true, et, dif_pos hy]
      · have hyS : y ∉ S := hy
        rw [hIy_out y hy, iteratedFDeriv_fun_zero]
        simp only [hyS, if_false]
        rfl
    refine ⟨fun y => ?_, fun k => ?_, fun k w y hy => ?_, fun k w y hy => ?_⟩
    · by_cases hy : (p₀ : P) * y ∈ P₀
      · rw [hIy_in y hy]; exact phi_contDiff hg Λc _
      · rw [hIy_out y hy]; exact contDiff_const
    · have : (fun pr : ((Fin m' → ℝ) × (Fin n' → ℝ)) × K =>
          iteratedFDeriv ℝ k (fun w => I g p₀ w pr.2) pr.1) =
          fun pr => if pr ∈ {pr : ((Fin m' → ℝ) × (Fin n' → ℝ)) × K | pr.2 ∈ S} then
            Ψb g Λc k (et pr.2 + expE (Λc pr.1)) else 0 := by
        funext pr; rw [hD]; rfl
      rw [this]
      refine continuous_ite_clopen (hSc.preimage continuous_snd) ?_ continuous_const
      refine (continuous_Ψb hg Λc k).comp_continuousOn ?_
      refine ContinuousOn.add (het.comp continuous_snd.continuousOn fun pr hpr => hpr)
        (continuous_expE.comp (Λc.continuous.comp continuous_fst)).continuousOn
    · rw [hIy_in y hy, phi_iter_Ψb hg]
    · rw [hIy_out y hy, iteratedFDeriv_fun_zero]; rfl
  -- representation on slices
  have hrep : ∀ g (a' : Fin r' → ℤ) (b' : (i : Fin s') → ZMod (d' i)) (p₀ : P₀),
      eb p₀ = ((0, 0, a', b') : ElemGroup m' n' r' s' d') →
      elemLift (hfun g) a' b' = fun w => ∫ y : K, I g p₀ w y ∂subgroupHaar K := by
    intro g a' b' p₀ hp₀; funext w; rw [hslice, ← hp₀, KF]
  have hzero : ∀ g (a' : Fin r' → ℤ) (b' : (i : Fin s') → ZMod (d' i)),
      ((0, 0, a', b') : ElemGroup m' n' r' s' d') ∉ βP₀ →
      elemLift (hfun g) a' b' = fun _ => 0 := by
    intro g a' b' hb; funext w; rw [hslice]; apply VAN
    intro hmem; apply hb
    have := βP₀.sub_mem hmem (expE_mem_of_isOpen βP₀ hβP₀o w)
    simpa using this
  have hsmooth : ∀ g (hg : IsRapidDecay g) (a' : Fin r' → ℤ) (b' : (i : Fin s') → ZMod (d' i)),
      ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (elemLift (hfun g) a' b') := by
    intro g hg a' b'
    by_cases hb : ((0, 0, a', b') : ElemGroup m' n' r' s' d') ∈ βP₀
    · obtain ⟨p₀, hp₀⟩ := hb
      rw [hrep g a' b' p₀ hp₀]
      obtain ⟨h1, h2, -, -⟩ := Iprops g hg p₀
      exact (integral_iteratedFDeriv (subgroupHaar K) (I g p₀) h1 h2).2
    · rw [hzero g a' b' hb]; exact contDiff_const
  have hcore : ∀ g (hg : IsRapidDecay g) (i j k : ℕ) (M : ℝ), 0 ≤ M →
      (∀ a b xt, ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖ ≤ M) →
      (∀ a b xt, ‖xt.1‖ ^ (i + j) * ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖ ≤ M) →
      (∀ a b xt, ‖a‖ ^ (i + j) * ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖ ≤ M) →
      ∀ (a' : Fin r' → ℤ) (b' : (i : Fin s') → ZMod (d' i)) w,
        ‖a'‖ ^ j * ‖w.1‖ ^ i * ‖iteratedFDeriv ℝ k (elemLift (hfun g) a' b') w‖ ≤
          |C₁| ^ (i + j) * 3 ^ (i + j) * ‖Λc‖ ^ k * (3 * M) := by
    intro g hg i j k M hM0 hM₀ hM₁ hM₂ a' b' w
    have hB0 : 0 ≤ |C₁| ^ (i + j) * 3 ^ (i + j) * ‖Λc‖ ^ k * (3 * M) := by positivity
    by_cases hb : ((0, 0, a', b') : ElemGroup m' n' r' s' d') ∈ βP₀
    · obtain ⟨p₀, hp₀⟩ := hb
      obtain ⟨h1, h2, h3, h4⟩ := Iprops g hg p₀
      rw [hrep g a' b' p₀ hp₀, (integral_iteratedFDeriv (subgroupHaar K) (I g p₀) h1 h2).1 k]
      have hc0 : 0 ≤ ‖a'‖ ^ j * ‖w.1‖ ^ i := by positivity
      have key : ‖a'‖ ^ j * ‖w.1‖ ^ i *
          ‖∫ y : K, iteratedFDeriv ℝ k (fun w => I g p₀ w y) w ∂subgroupHaar K‖ =
          ‖∫ y : K, (‖a'‖ ^ j * ‖w.1‖ ^ i) •
            iteratedFDeriv ℝ k (fun w => I g p₀ w y) w ∂subgroupHaar K‖ := by
        rw [integral_smul, norm_smul, Real.norm_of_nonneg hc0]
      rw [key]
      refine (norm_integral_le_of_norm_le_const (Eventually.of_forall fun y => ?_)).trans
        (by rw [hμreal, mul_one])
      rw [norm_smul, Real.norm_of_nonneg hc0]
      by_cases hy : (p₀ : P) * y ∈ P₀
      · rw [h3 k w y hy, ← phi_iter_Ψb hg]
        set e0 := ea ⟨_, hy⟩ with he0
        have hphi := phi_bound hg Λc e0 k w
        set pt := ((e0.1, liftT e0.2.1) + Λc w) with hpt
        set Dn := ‖iteratedFDeriv ℝ k (elemLift g e0.2.2.1 e0.2.2.2) pt‖ with hDn
        obtain ⟨pw, hpw, q, hq, hα⟩ := hΛ w
        let z : P₀ := ⟨_, hy⟩ * pw * q⁻¹
        have hqb : eb q = 0 := by show Multiplicative.toAdd (β q) = 0; rw [hq]; rfl
        have hzb : eb z = ((0, 0, a', b') : ElemGroup m' n' r' s' d') + expE w := by
          show eb ((p₀ : P) * y * pw * (q : P)⁻¹) = _
          rw [eb_mul, eb_mul, eb_mul, eb_inv, ebK, hqb, hp₀]
          have : eb pw = expE w := hpw
          rw [this]; abel
        have hza : ea z = e0 + expE (Λc w) := by
          have hα' : ea pw = expE (Λ w) + ea q := hα
          simp only [z, ea_mul, ea_inv, hα', hΛc]
          rw [he0]; abel
        have hC := hC₁ z
        have hnb : nc (Multiplicative.toAdd (β z)) = ‖w.1‖ + ‖a'‖ := by
          show nc (eb z) = _
          rw [hzb]; simp [nc, expE]
        have hna : nc (Multiplicative.toAdd (α z)) = ‖pt.1‖ + ‖e0.2.2.1‖ := by
          show nc (ea z) = _
          rw [hza, hpt]; simp [nc, expE]
        rw [hnb, hna] at hC
        set u := ‖pt.1‖
        set v := ‖e0.2.2.1‖
        have hu0 : 0 ≤ u := norm_nonneg _
        have hv0 : 0 ≤ v := norm_nonneg _
        set N' := ‖w.1‖ + ‖a'‖
        have hN'0 : 0 ≤ N' := by positivity
        have hN' : N' ≤ |C₁| * (1 + u + v) := by
          have : C₁ * (1 + (u + v)) ≤ |C₁| * (1 + u + v) := by
            rw [← add_assoc]; exact mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
          linarith
        have hw1 : ‖a'‖ ^ j * ‖w.1‖ ^ i ≤ N' ^ (i + j) := by
          rw [pow_add, mul_comm (N' ^ i)]
          exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) (by linarith [norm_nonneg w.1]) j)
            (pow_le_pow_left₀ (norm_nonneg _) (by linarith [norm_nonneg a']) i) (by positivity)
            (by positivity)
        have hNq : N' ^ (i + j) ≤ |C₁| ^ (i + j) * (3 ^ (i + j) * (1 + u ^ (i + j) + v ^ (i + j))) := by
          calc N' ^ (i + j) ≤ (|C₁| * (1 + u + v)) ^ (i + j) := pow_le_pow_left₀ hN'0 hN' _
            _ = |C₁| ^ (i + j) * (1 + u + v) ^ (i + j) := mul_pow _ _ _
            _ ≤ _ := by gcongr; exact pow_bound u v hu0 hv0 _
        have hD3 : (1 + u ^ (i + j) + v ^ (i + j)) * Dn ≤ 3 * M := by
          have a1 := hM₀ e0.2.2.1 e0.2.2.2 pt
          have a2 := hM₁ e0.2.2.1 e0.2.2.2 pt
          have a3 := hM₂ e0.2.2.1 e0.2.2.2 pt
          nlinarith
        have hDn0 : 0 ≤ Dn := norm_nonneg _
        have hΛ0 : 0 ≤ ‖Λc‖ ^ k := by positivity
        calc ‖a'‖ ^ j * ‖w.1‖ ^ i * ‖iteratedFDeriv ℝ k (fun w => g (e0 + expE (Λc w))) w‖
            ≤ N' ^ (i + j) * (Dn * ‖Λc‖ ^ k) :=
              mul_le_mul hw1 hphi (norm_nonneg _) (by positivity)
          _ ≤ (|C₁| ^ (i + j) * (3 ^ (i + j) * (1 + u ^ (i + j) + v ^ (i + j)))) *
              (Dn * ‖Λc‖ ^ k) := mul_le_mul_of_nonneg_right hNq (by positivity)
          _ = |C₁| ^ (i + j) * 3 ^ (i + j) * ‖Λc‖ ^ k * ((1 + u ^ (i + j) + v ^ (i + j)) * Dn) := by
              ring
          _ ≤ |C₁| ^ (i + j) * 3 ^ (i + j) * ‖Λc‖ ^ k * (3 * M) :=
              mul_le_mul_of_nonneg_left hD3 (by positivity)
      · rw [h4 k w y hy, norm_zero, mul_zero]; exact hB0
    · rw [hzero g a' b' hb, iteratedFDeriv_fun_zero]
      simpa using hB0
  have hrapid : ∀ g, IsRapidDecay g → IsRapidDecay (hfun g) := by
    intro g hg
    refine ⟨hsmooth g hg, fun i j k => ?_⟩
    obtain ⟨M₀, hM₀⟩ := hg.2 0 0 k
    obtain ⟨M₁, hM₁⟩ := hg.2 (i + j) 0 k
    obtain ⟨M₂, hM₂⟩ := hg.2 0 (i + j) k
    refine ⟨_, hcore g hg i j k (max (max M₀ M₁) (max M₂ 0)) (le_max_of_le_right (le_max_right _ _))
      (fun a b xt => ?_) (fun a b xt => ?_) (fun a b xt => ?_)⟩
    · have := hM₀ a b xt
      simp only [pow_zero, one_mul] at this
      exact this.trans (le_max_of_le_left (le_max_left _ _))
    · have := hM₁ a b xt
      simp only [pow_zero, one_mul] at this
      exact this.trans (le_max_of_le_left (le_max_right _ _))
    · have := hM₂ a b xt
      simp only [pow_zero, mul_one] at this
      exact this.trans (le_max_of_le_right (le_max_left _ _))
  -- linearity
  have hEP_add : ∀ g₁ g₂ : ElemGroup m n r s d → ℂ,
      extendPullback P₀ α (g₁ + g₂) = extendPullback P₀ α g₁ + extendPullback P₀ α g₂ := by
    intro g₁ g₂; funext x
    simp only [extendPullback, Pi.add_apply]
    split_ifs <;> simp
  have hEP_smul : ∀ (c : ℂ) (g : ElemGroup m n r s d → ℂ),
      extendPullback P₀ α (c • g) = c • extendPullback P₀ α g := by
    intro c g; funext x
    simp only [extendPullback, Pi.smul_apply]
    split_ifs <;> simp
  have hint : ∀ g, IsRapidDecay g → ∀ x : P,
      Integrable (fun y : K => extendPullback P₀ α g (x * y)) (subgroupHaar K) := fun g hg x =>
    integrable_of_cont_compact _ _ ((continuous_extendPullback P₀ hP₀ α hαc
      (continuous_of_isRapidDecay hg)).comp (continuous_const.mul continuous_subtype_val))
  have hfun_add : ∀ g₁ g₂, IsRapidDecay g₁ → IsRapidDecay g₂ →
      hfun (g₁ + g₂) = hfun g₁ + hfun g₂ := by
    intro g₁ g₂ h₁ h₂; funext e'
    simp only [hfun, Pi.add_apply]
    split_ifs with h
    · unfold Fav
      rw [hEP_add]
      exact integral_add (hint g₁ h₁ _) (hint g₂ h₂ _)
    · simp
  have hfun_smul : ∀ (c : ℂ) g, hfun (c • g) = c • hfun g := by
    intro c g; funext e'
    simp only [hfun, Pi.smul_apply]
    split_ifs with h
    · unfold Fav
      rw [hEP_smul]
      exact integral_smul c _
    · simp
  let T : ElemSchwartz m n r s d →ₗ[ℂ] ElemSchwartz m' n' r' s' d' :=
    { toFun := fun g => ⟨hfun g.toFun, (mem_elemSchwartz_iff _).2 (hrapid _ g.isRapidDecay)⟩
      map_add' := fun g₁ g₂ => Subtype.ext
        (hfun_add g₁.toFun g₂.toFun g₁.isRapidDecay g₂.isRapidDecay)
      map_smul' := fun c g => Subtype.ext (hfun_smul c g.toFun) }
  have hT : ∀ g, (T g).toFun = hfun g.toFun := fun _ => rfl
  refine ⟨T, ?_, fun g => ⟨fun p => ?_, fun e he => ?_⟩⟩
  · refine continuous_of_wf_bound T fun p' => ⟨{(0, 0, p'.2.2), (p'.1 + p'.2.1, 0, p'.2.2),
      (0, p'.1 + p'.2.1, p'.2.2)}, |C₁| ^ (p'.1 + p'.2.1) * 3 ^ (p'.1 + p'.2.1) * ‖Λc‖ ^ p'.2.2 * 3,
      fun g M hM q' => ?_⟩
    obtain ⟨i, j, k⟩ := p'
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM (0, 0, k) (by simp) (0, 0, 0))
    have h0 : ∀ a b xt, ‖iteratedFDeriv ℝ k (elemLift g.toFun a b) xt‖ ≤ M := by
      intro a b xt
      have := hM (0, 0, k) (by simp) (a, b, xt)
      rw [norm_wf] at this
      simpa using this
    have h1 : ∀ a b xt, ‖xt.1‖ ^ (i + j) * ‖iteratedFDeriv ℝ k (elemLift g.toFun a b) xt‖ ≤ M := by
      intro a b xt
      have := hM (i + j, 0, k) (by simp) (a, b, xt)
      rw [norm_wf] at this
      simpa using this
    have h2 : ∀ a b xt, ‖a‖ ^ (i + j) * ‖iteratedFDeriv ℝ k (elemLift g.toFun a b) xt‖ ≤ M := by
      intro a b xt
      have := hM (0, i + j, k) (by simp) (a, b, xt)
      rw [norm_wf] at this
      simpa using this
    rw [norm_wf, hT]
    have := hcore g.toFun g.isRapidDecay i j k M hM0 h0 h1 h2 q'.1 q'.2.1 q'.2.2
    calc _ ≤ _ := this
      _ = _ := by ring
  · show hfun g.toFun (eb p) = _
    rw [hfun_β, sba_eq]
  · show hfun g.toFun e = 0
    simp only [hfun]
    rw [dif_neg]
    rintro ⟨p, hp⟩
    exact he ⟨p, hp⟩

end MasulloGRH

end SC6c_sec

open MasulloGRH in
theorem solution
    (P : Type*) [CommGroup P] [TopologicalSpace P] [IsTopologicalGroup P] [T2Space P]
    [LocallyCompactSpace P] (P₀ : Subgroup P) (hP₀ : IsOpen (P₀ : Set P))
    (m n r s : ℕ) (d : Fin s → ℕ) (hd : ∀ i, d i ≠ 0)
    (α : ↥P₀ →* Multiplicative (ElemGroup m n r s d)) (hαc : Continuous α) (hαo : IsOpenMap α)
    (hαk : IsCompact {x : ↥P₀ | α x = 1})
    (m' n' r' s' : ℕ) (d' : Fin s' → ℕ)
    (β : P →* Multiplicative (ElemGroup m' n' r' s' d')) (hβc : Continuous β)
    (hβo : IsOpenMap β) (hβk : IsCompact {x : P | β x = 1}) :
    ∃ T : ElemSchwartz m n r s d →ₗ[ℂ] ElemSchwartz m' n' r' s' d', Continuous T ∧
      ∀ g : ElemSchwartz m n r s d,
        (∀ p : P, (T g).toFun (Multiplicative.toAdd (β p)) =
          schwartzBruhatAverage ⊤ β.ker (extendPullback P₀ α g.toFun) p) ∧
        ∀ e : ElemGroup m' n' r' s' d',
          e ∉ Set.range (fun p : P => Multiplicative.toAdd (β p)) → (T g).toFun e = 0 := by
  exact MasulloGRH.schwartz_correspondence_main P P₀ hP₀ m n r s d hd α hαc hαo hαk m' n' r' s' d'
    β hβc hβo hβk
