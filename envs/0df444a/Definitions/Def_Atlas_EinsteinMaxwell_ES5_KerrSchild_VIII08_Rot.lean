/-! ## The reparametrised potential `beta(t) = b_s(1/t)` -/

/-- `beta(t) = b_s(1/t)`, with the continuous value `beta 0 = 0`. -/
noncomputable def beta (j : ℝ) (q : ℝ → ℝ) (t : ℝ) : ℝ :=
  if t = 0 then 0 else bfun j q (1 / t)

/-! ## Continuity of `beta` on the compact window `[0, 1/3]` -/

/-! ## The rotation integrand and the rotation itself -/

/-- `t (2j + 6 beta(t) - t r(t))`. -/
noncomputable def Gfun (j : ℝ) (q r : ℝ → ℝ) (t : ℝ) : ℝ :=
  t * (2 * j + 6 * beta j q t - t * r t)

/-- `v(R) = ∫₀^{1/R} t (2j + 6 beta(t) - t r(t)) dt`. -/
noncomputable def vfun (j : ℝ) (q r : ℝ → ℝ) (R : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..(1 / R), Gfun j q r t

