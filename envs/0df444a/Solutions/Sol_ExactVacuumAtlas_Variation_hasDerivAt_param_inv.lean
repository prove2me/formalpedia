open Filter Topology
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
theorem solution {g ginv : ℝ → Metric n} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hg : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => g p.1 i j p.2) W)
    (hinv : ∀ p ∈ W, metricMatrix (ginv p.1) p.2 * metricMatrix (g p.1) p.2 = 1)
    {ε₀ : ℝ} {y : Pt n} (hy : (ε₀, y) ∈ W) {h : Metric n}
    (hh : ∀ i j, HasDerivAt (fun ε => g ε i j y) (h i j y) ε₀) (a b : Fin n) :
    HasDerivAt (fun ε => ginv ε a b y)
      (-∑ c, ∑ d, ginv ε₀ a c y * h c d y * ginv ε₀ d b y) ε₀ := by
  have hgi := contDiffOn_inv_joint hg hinv
  -- genuine derivatives of the inverse entries
  set D : Matrix (Fin n) (Fin n) ℝ := Matrix.of fun i j => deriv (fun ε => ginv ε i j y) ε₀ with hDdef
  have hD : ∀ i j, HasDerivAt (fun ε => ginv ε i j y) (D i j) ε₀ := fun i j =>
    hasDerivAt_param_of_joint hW (hgi i j) hy
  -- differentiate `Σ_c G_{ic} g_{cj} = δ_{ij}` (eventually constant in `ε`)
  have hc : ContinuousAt (fun ε : ℝ => (ε, y)) ε₀ := (continuous_id.prodMk continuous_const).continuousAt
  have hev : ∀ i j, (fun ε => ∑ c, ginv ε i c y * g ε c j y) =ᶠ[𝓝 ε₀]
      fun _ => (1 : Matrix (Fin n) (Fin n) ℝ) i j := by
    intro i j
    filter_upwards [hc.preimage_mem_nhds (hW.mem_nhds hy)] with ε hε
    have := congrFun (congrFun (hinv (ε, y) hε) i) j
    simpa only [Matrix.mul_apply, metricMatrix, Matrix.of_apply] using this
  have hzero : ∀ i j, ∑ c, (D i c * g ε₀ c j y + ginv ε₀ i c y * h c j y) = 0 := by
    intro i j
    have h1 : HasDerivAt (fun ε => ∑ c, ginv ε i c y * g ε c j y)
        (∑ c, (D i c * g ε₀ c j y + ginv ε₀ i c y * h c j y)) ε₀ :=
      HasDerivAt.fun_sum fun c _ => (hD i c).mul (hh c j)
    have h2 : HasDerivAt (fun ε => ∑ c, ginv ε i c y * g ε c j y) 0 ε₀ :=
      (hasDerivAt_const ε₀ ((1 : Matrix (Fin n) (Fin n) ℝ) i j)).congr_of_eventuallyEq (hev i j)
    exact h1.unique h2
  -- matrix form: `D g + G h = 0`, hence `D = -G h G`
  have hm : D * metricMatrix (g ε₀) y = -(metricMatrix (ginv ε₀) y * Matrix.of fun i j => h i j y) := by
    ext i j
    have := hzero i j
    simp only [Matrix.mul_apply, Matrix.neg_apply, metricMatrix, Matrix.of_apply]
    rw [Finset.sum_add_distrib] at this
    linarith
  have hgG : metricMatrix (g ε₀) y * metricMatrix (ginv ε₀) y = 1 := mul_eq_one_comm.mp (hinv _ hy)
  have hDe : D = -(metricMatrix (ginv ε₀) y * (Matrix.of fun i j => h i j y) * metricMatrix (ginv ε₀) y) := by
    calc D = D * (metricMatrix (g ε₀) y * metricMatrix (ginv ε₀) y) := by rw [hgG, Matrix.mul_one]
      _ = (D * metricMatrix (g ε₀) y) * metricMatrix (ginv ε₀) y := by rw [Matrix.mul_assoc]
      _ = _ := by rw [hm, Matrix.neg_mul]
  refine (hD a b).congr_deriv ?_
  rw [hDe]
  simp only [Matrix.neg_apply, Matrix.mul_apply, metricMatrix, Matrix.of_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
