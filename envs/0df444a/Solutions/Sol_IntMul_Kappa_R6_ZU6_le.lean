noncomputable section

theorem cU6_eq (Q : Q6) (A : ℕ) : cU6 Q.P Q.n A =
    (Q.T : ℝ) * Q.p * Ncost6 Q.P Q.n * (Real.log (IntMul.lg Q.n) + 1) ^ A := by
  unfold cU6 VP6; rfl

theorem cU6_ge (Q : Q6) (hP : Q.P.Ok) (A : ℕ) :
    (Q.T : ℝ) * Q.p * (Real.log (IntMul.lg Q.n) + 1) ^ 2 ≤ cU6 Q.P Q.n (A + 2) := by
  rw [cU6_eq]
  have hL := lgn_ge Q.n
  have hN := Ncost6_ge_one Q.P hP Q.n
  have h0 : (0 : ℝ) ≤ (Q.T : ℝ) * Q.p := by positivity
  have h1 : (Real.log (IntMul.lg Q.n) + 1) ^ 2 ≤ (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) :=
    pow_le_pow_right₀ hL (by omega)
  have h2 : (0 : ℝ) ≤ (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) := by positivity
  calc (Q.T : ℝ) * Q.p * (Real.log (IntMul.lg Q.n) + 1) ^ 2
      ≤ (Q.T : ℝ) * Q.p * (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) :=
        mul_le_mul_of_nonneg_left h1 h0
    _ ≤ (Q.T : ℝ) * Q.p * Ncost6 Q.P Q.n * (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) := by
        have h3 : (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) ≤
            Ncost6 Q.P Q.n * (Real.log (IntMul.lg Q.n) + 1) ^ (A + 2) := by nlinarith
        have := mul_le_mul_of_nonneg_left h3 h0
        calc _ ≤ _ := this
          _ = _ := by ring

theorem ZU6_le_sol_aux {Q : Q6} (hQ : QOk Q) (hP : Q.P.Ok) (A : ℕ) :
    (ZU6 Q : ℝ) ≤ Kz6 Q.P * cU6 Q.P Q.n (A + 2) := by
  have hb := hQ.hb
  have hp1 : 1 ≤ Q.p := by rw [Q.p_eq]; omega
  have hF := NLogN.KFZ.fmB_le_log Q.p (8 * Q.p) hp1 (by omega)
  have hLp := lgp_le Q.P Q.n
  have hLn := lgn_ge Q.n
  have hU := cU6_ge Q hP A
  set Ln := Real.log (IntMul.lg Q.n) + 1 with hLnd
  set Lp := Real.log (pP6 Q.P Q.n) + 1 with hLpd
  have hLp1 : 1 ≤ Lp := by
    have : (1 : ℝ) ≤ pP6 Q.P Q.n := by exact_mod_cast hp1
    have := Real.log_nonneg this; rw [hLpd]; linarith
  have hT1 : (1 : ℝ) ≤ Q.T := by exact_mod_cast (Nat.one_le_two_pow : 1 ≤ 2 ^ Q.L)
  have hpR : (1 : ℝ) ≤ Q.p := by exact_mod_cast hp1
  have h6 : (((Q.b + 1) ^ 6 : ℕ) : ℝ) ≤ 64 * Q.T := by
    have h := hQ.hb6
    have : Q.b + 1 ≤ 2 * Q.b := by omega
    have : (Q.b + 1) ^ 6 ≤ 64 * Q.T :=
      calc (Q.b + 1) ^ 6 ≤ (2 * Q.b) ^ 6 := Nat.pow_le_pow_left this 6
        _ = 64 * Q.b ^ 6 := by ring
        _ ≤ 64 * Q.T := Nat.mul_le_mul_left _ h
    exact_mod_cast this
  have hnV : (Q.n : ℝ) ≤ (Q.T : ℝ) * Q.p := by
    have h := T_lower Q.P Q.n
    have : Q.n ≤ Q.T * Q.p := by
      have : Q.T * Q.b ≤ Q.T * Q.p := Nat.mul_le_mul_left _ (by rw [Q.p_eq]; omega)
      show Q.n ≤ TP6 Q.P Q.n * pP6 Q.P Q.n
      have : TP6 Q.P Q.n * b'P6 Q.P Q.n ≤ TP6 Q.P Q.n * pP6 Q.P Q.n := this
      omega
    exact_mod_cast this
  have hC : (0 : ℝ) ≤ NLogN.KFZ.Cfm := by positivity
  set T := (Q.T : ℝ)
  set p := (Q.p : ℝ)
  set X := ((Q.P.x : ℝ) + 4)
  have hX1 : (1 : ℝ) ≤ X := by have : (0 : ℝ) ≤ Q.P.x := Nat.cast_nonneg _; rw [show X = (Q.P.x : ℝ) + 4 from rfl]; linarith
  have hTp : 1 ≤ T * p := one_le_mul_of_one_le_of_one_le hT1 hpR
  have hLn2 : 1 ≤ Ln ^ 2 := one_le_pow₀ hLn
  have hLL : Lp ^ 2 ≤ X ^ 2 * Ln ^ 2 := by
    rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) hLp 2
  have hX2 : 1 ≤ X ^ 2 := one_le_pow₀ hX1
  have hW1 : 1 ≤ T * p * Ln ^ 2 := one_le_mul_of_one_le_of_one_le hTp hLn2
  have hF' : ((KFM.fmB (8 * Q.p) : ℕ) : ℝ) ≤ 32500 * (NLogN.KFZ.Cfm : ℝ) * p * (X ^ 2 * Ln ^ 2) := by
    calc _ ≤ 32500 * (NLogN.KFZ.Cfm : ℝ) * p * Lp ^ 2 := hF
      _ ≤ _ := by gcongr
  have hX : (ZU6 Q : ℝ) ≤ (32500 * (NLogN.KFZ.Cfm : ℝ) + 200) * X ^ 2 * (T * p * Ln ^ 2) := by
    unfold ZU6
    push_cast
    push_cast at h6
    have a1 : T * ((KFM.fmB (8 * Q.p) : ℕ) : ℝ) ≤
        32500 * (NLogN.KFZ.Cfm : ℝ) * X ^ 2 * (T * p * Ln ^ 2) := by
      have := mul_le_mul_of_nonneg_left hF' (by linarith : (0 : ℝ) ≤ T)
      calc _ ≤ T * (32500 * (NLogN.KFZ.Cfm : ℝ) * p * (X ^ 2 * Ln ^ 2)) := this
        _ = _ := by ring
    have a2 : T * (p + 1) ≤ 2 * (T * p * Ln ^ 2) := by
      have : T * (p + 1) ≤ 2 * (T * p) := by nlinarith
      have : T * p ≤ T * p * Ln ^ 2 := by nlinarith
      linarith
    have a3 : 64 * T ≤ 64 * (T * p * Ln ^ 2) := by
      have : T ≤ T * p := by nlinarith
      have : T * p ≤ T * p * Ln ^ 2 := by nlinarith
      linarith
    have a4 : (Q.n : ℝ) ≤ T * p * Ln ^ 2 := by
      have : T * p ≤ T * p * Ln ^ 2 := by nlinarith
      linarith
    have a5 : 200 * (T * p * Ln ^ 2) ≤ 200 * X ^ 2 * (T * p * Ln ^ 2) := by nlinarith
    have e : T * (p + 1 + ((KFM.fmB (8 * Q.p) : ℕ) : ℝ)) =
        T * (p + 1) + T * ((KFM.fmB (8 * Q.p) : ℕ) : ℝ) := by ring
    rw [e]
    have e2 : (32500 * (NLogN.KFZ.Cfm : ℝ) + 200) * X ^ 2 * (T * p * Ln ^ 2) =
        32500 * (NLogN.KFZ.Cfm : ℝ) * X ^ 2 * (T * p * Ln ^ 2) + 200 * X ^ 2 * (T * p * Ln ^ 2) := by
      ring
    rw [e2]
    linarith
  unfold Kz6
  have hK0 : (0 : ℝ) ≤ (32500 * (NLogN.KFZ.Cfm : ℝ) + 200) * X ^ 2 := by positivity
  calc (ZU6 Q : ℝ) ≤ _ := hX
    _ ≤ (32500 * (NLogN.KFZ.Cfm : ℝ) + 200) * X ^ 2 * cU6 Q.P Q.n (A + 2) :=
        mul_le_mul_of_nonneg_left hU hK0

end

