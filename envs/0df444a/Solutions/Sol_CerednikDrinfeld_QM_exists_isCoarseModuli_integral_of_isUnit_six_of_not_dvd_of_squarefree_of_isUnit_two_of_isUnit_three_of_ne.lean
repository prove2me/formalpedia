theorem ReduceINT.isUnit_qq'_of_six {𝒪 : Type} [CommRing 𝒪] {q q' : ℕ} (h : IsUnit ((6 * q * q' : ℕ) : 𝒪)) :
    IsUnit ((q * q' : ℕ) : 𝒪) := by
