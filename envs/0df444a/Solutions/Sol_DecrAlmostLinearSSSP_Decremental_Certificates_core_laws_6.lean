  ⟨by simp [NatFrame,store,writesNat],by simp [NatFrame,nadd,writesNat,Ne.symm h620],CoreOutput.nat_frame k h622⟩
lemma real_frame (k : ℕ) (h620 : k ≠ 620) (h624 : k ≠ 624) : RealFrame code k :=
  ⟨by simp [RealFrame,store,writesReal],by simp [RealFrame,nadd,writesReal],CoreOutput.real_frame k h620 h624⟩
