variable {A : Type} [CommRing A] {n : Type} [Fintype n]

theorem Formalism.UG.P.csScale_hform_add_right (σ : A →+* A) (J : Matrix n n A) (x y y' : n → A) :
    hform σ J x (y + y') = hform σ J x y + hform σ J x y' := by sorry
