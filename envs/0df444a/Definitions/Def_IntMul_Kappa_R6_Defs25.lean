-- Source module: Solutions.R6CxNetInvoc
/-!
# One stage invocation in global terms

* `triOK`, `dataOK`: the data facts (from the kernel checks);
* `G1 b` / `G2 a`: the global chunk programs of stage-one invocation `b` / stage-two invocation `a`
  (the checked local program mapped by `ι1 b` / `ι2 a` with the frames of `R6CxNetFrame`);
* `inv1` / `inv2`: validity and labels (from `prog_valid`);
* `log1` / `log2`: the logical effect (from `NetEff.stage1/2` via `runOps_map`);
* `wid1` / `wid2`: the child widths are the nonzero checked move widths (independent of `b`/`a`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

/-! ## Data facts -/

/-! ## Local-to-global plumbing -/

/-! ## Role lemmas -/

/-! ## The two invocation programs -/

/-- The checked local programs. -/
def cs1 : List LChunk := (progRun (specs1 dat) S1_0).1
def cs2 : List LChunk := (progRun (specs2 dat) S2_0).1

/-- Stage-one invocation `b`. -/
noncomputable def G1 (b : ℕ) : List (GChunk Rl 576) :=
  mapProg (ι1 b) (labV1 dat b) (fun _ c => labV1 dat b c) cs1

/-- Stage-two invocation `a`. -/
noncomputable def G2 (a : ℕ) : List (GChunk Rl 576) :=
  mapProg (ι2 a) (labV2 dat a) (lab2 dat a) cs2

/-! ## Widths -/

/-- The nonzero move widths of the two local programs. -/
def W1 : List ℕ := (progMvW wd1 cs1).filter (fun x => x != 0)
def W2 : List ℕ := (progMvW wd2 cs2).filter (fun x => x != 0)

end IntMul.Kappa.R6.Cx.NetG

end

section
-- Source module: Solutions.R6CxNetGlobL
/-!
# The global chunk program and its labels

`CH = S1 ++ E4s ++ S2 ++ KK`:
* `S1`: stage-one invocations `G1 b` (`b < v`);
* `E4s`: for every `b`, the scratch outputs `A1(b, ·)` moved `𝔽₂^24 ⊗ t_b → ⊤` (E4, width 552);
* `S2`: stage-two invocations `G2 a`;
* `KK`: per `(a, b)` the sign corrections `τ += X` (at `⊤`), `Y += τ` (at `⟨u_{ab}⟩^⊥`, moving `τ`
  by E5, width 1), `X ← -X` (at `⊤`).

`progValid_CH`: the program is valid from the initial labels `g0`; `gF_*`: the final labels.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

/-! ## Numeric role codes -/

/-! ## Initial labels -/

/-- The initial labels: stage-one roles get the stage-one initial codes, stage-two scratch roles
the stage-two initial codes, the correction temporaries `⊤`. -/
noncomputable def g0 (r : Rl) : Lab 576 :=
  if rc r < 2 * NN + NV * NR ∨ (Wn ≤ rc r ∧ rc r < Wn + 24 * NV) then
    labV1 dat (d1 (rc r)).1 (init1 dat (d1 (rc r)).2)
  else if (2 * NN + NV * NR ≤ rc r ∧ rc r < Wn) ∨ (Wn + 24 * NV ≤ rc r ∧ rc r < Wn + 48 * NV) then
    lab2 dat (d2 (rc r)).1 (d2 (rc r)).2 (init2 dat (d2 (rc r)).2)
  else ⊤

/-! ## Distinctness -/

/-! ## Kernel-checked boundary codes -/

/-! ## Moves to distinct roles -/

/-! ## The program -/

/-- The E4 chunk of `b`: the scratch outputs `A1(b, ·)` to `⊤`. -/
noncomputable def E4mv (b : ℕ) : List (Rl × Lab 576) :=
  (List.range NR).map (fun q => (A1r b q, lift1 (tb dat b) ⊤))

attribute [local irreducible] E4mv

noncomputable def E4c (b : ℕ) : GChunk Rl 576 := ⟨⊤, E4mv b, []⟩

/-- The correction vector `u_{ab} = t_a ⊗ t_b`. -/
def Uv (a b : ℕ) : V576 := NetT.tens (tb dat a) (tb dat b)

/-- `⟨u_{ab}⟩^⊥`. -/
def Up (a b : ℕ) : Lab 576 := orth 1 (lineM (Uv a b))

noncomputable def C1 (a b : ℕ) : GChunk Rl 576 := ⟨⊤, [], [⟨τr a b, Xr a b, 1⟩]⟩
noncomputable def C2 (a b : ℕ) : GChunk Rl 576 := ⟨Up a b, [(τr a b, ⊤)], [⟨Yr a b, τr a b, 1⟩]⟩
noncomputable def C3 (a b : ℕ) : GChunk Rl 576 := ⟨⊤, [], [⟨Xr a b, Xr a b, -2⟩]⟩

/-- The corrections of `(a, b)`. -/
noncomputable def K (p : ℕ × ℕ) : List (GChunk Rl 576) := [C1 p.1 p.2, C2 p.1 p.2, C3 p.1 p.2]

/-- All pairs. -/
def PL : List (ℕ × ℕ) := List.product (List.range NV) (List.range NV)

noncomputable def S1 : List (GChunk Rl 576) := (List.range NV).flatMap G1
noncomputable def E4s : List (GChunk Rl 576) := (List.range NV).map E4c
noncomputable def S2 : List (GChunk Rl 576) := (List.range NV).flatMap G2
noncomputable def KK : List (GChunk Rl 576) := PL.flatMap K

/-- **The global chunk program.** -/
noncomputable def CH : List (GChunk Rl 576) := S1 ++ E4s ++ S2 ++ KK

attribute [local irreducible] S1 E4s S2 KK PL

/-! ## Stage one -/

/-- Labels after stage-one invocations `b < k`. -/
def P1 (k : ℕ) (g : Rl → Lab 576) : Prop :=
  (∀ b < NV, ∀ w < NL, g (ι1 b w) = labV1 dat b (gget (if b < k then S1_14 else S1_0) w)) ∧
  (∀ r, (∀ b < NV, ∀ w < NL, ι1 b w ≠ r) → g r = g0 r)

/-- Labels after stage one. -/
noncomputable def gS1 : Rl → Lab 576 := progLab S1 g0

/-! ## E4 -/

/-- Labels after the E4 chunks `b < k`. -/
def Q4 (k : ℕ) (g : Rl → Lab 576) : Prop :=
  (∀ b < NV, ∀ q < NR, g (A1r b q) = if b < k then ⊤ else gS1 (A1r b q)) ∧
  (∀ r, (∀ b < k, ∀ q < NR, A1r b q ≠ r) → g r = gS1 r)

/-- Labels after the E4 chunks. -/
noncomputable def gE : Rl → Lab 576 := progLab E4s gS1

/-! ## Stage two -/

/-- Labels after stage-two invocations `a < k`. -/
def P2 (k : ℕ) (g : Rl → Lab 576) : Prop :=
  (∀ a < NV, ∀ w < NL, g (ι2 a w) = lab2 dat a w (gget (if a < k then S2_14 else S2_0) w)) ∧
  (∀ r, (∀ a < NV, ∀ w < NL, ι2 a w ≠ r) → g r = gE r)

/-- Labels after stage two. -/
noncomputable def gS2 : Rl → Lab 576 := progLab S2 gE

/-! ## Corrections -/

/-- Final labels. -/
noncomputable def gF : Rl → Lab 576 := progLab CH g0

/-! ## Initial labels of the data roles -/

end IntMul.Kappa.R6.Cx.NetG

