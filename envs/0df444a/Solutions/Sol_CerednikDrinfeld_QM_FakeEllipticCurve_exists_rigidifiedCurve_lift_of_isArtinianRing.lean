  let x : FakeEllipticCurve.RigidifiedCurve r π A₀ A ψ := ⟨E, ρ⟩

  obtain ⟨j, t'', hj, ht''X, htr'', hadm'', hΞx⟩ := hΞdef A ψ hA hconn hAr x t.X θ hEX
  have htadm₀' : t.IsAdmissible ι ((frobTwist Onr Fr (-(j₀ : ℤ)) ψ : Onr →ₐ[𝒪] A) : Onr →+* A) := by
