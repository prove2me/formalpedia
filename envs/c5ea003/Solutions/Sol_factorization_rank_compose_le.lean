/-
For ℕ, multiplication distributes over Finset.sup (which is max).
-/
theorem nat_mul_finset_sup {β : Type*} [DecidableEq β]
    (a : ℕ) (s : Finset β) (f : β → ℕ) :
    a * s.sup f = s.sup (fun x => a * f x) := by
  induction' s using Finset.cons_induction with x s ih;
  · simp +decide;
  · simp +decide [ *, mul_max_of_nonneg ]

