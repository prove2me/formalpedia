theorem foldl_mul_strict_lt {α : Type*} {xs : List α} (hnd : xs.Nodup)
    {k : α} (hk : k ∈ xs) (f g : α → Nat)
    (hpos : ∀ i ∈ xs, 0 < f i)
    (heq : ∀ i ∈ xs, i ≠ k → f i = g i)
    (hlt : g k < f k) :
    ∀ a, 0 < a →
      xs.foldl (fun acc i => acc * g i) a <
        xs.foldl (fun acc i => acc * f i) a := by sorry
