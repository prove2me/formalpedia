-- title:
--   The network pricing model with inventory and a run of TS-fixed (Algorithm 1)
-- statement:
--   This file formalizes the discrete price model of Section 2.1 and the algorithm TS-fixed (Algorithm 1) of Ferreira, Simchi-Levi and Wang, and the Bayesian regret against the LP benchmark of Section 3.1.1.
--
--   **Model.** There are $N$ products, $M$ resources with initial inventories $I_1,\dots,I_M$ and no replenishment, $T$ periods, a consumption matrix $a_{ij}$, and $K$ price vectors $p_1,\dots,p_K$ plus a shut-off price $p_\infty$ under which every product's demand is zero with probability one. Demand under $p_k$ has law $F(\cdot\,;p_k,\theta)$ on $\mathbb R^N_+$, indexed by an unknown parameter $\theta\in\Theta$ drawn from a known prior $\mu_0$. The mean demand under a parameter $\rho$ is $d_{ik}(\rho)=\mathbb E[D_i]$ for $D\sim F(\cdot\,;p_k,\rho)$. Demand in a period is independent of the past given the posted price and $\theta$.
--
--   **Fulfilment (Section 2.1, (a)/(b)).** Let $I_j(t)$ be the inventory at the end of period $t$, $I_j(0)=I_j$. (a) If inventory covers all demand, $\sum_i D_i(t)a_{ij}\le I_j(t-1)$ for all $j$, then all demand is satisfied: $\tilde D(t)=D(t)$. (b) Otherwise the satisfied demand satisfies $0\le\tilde D_i(t)\le D_i(t)$ for all $i$, $I_j(t)=I_j(t-1)-\sum_i\tilde D_i(t)a_{ij}\ge0$ for all $j$, and at least one resource has $I_{j'}(t)=0$. No further rule is imposed.
--
--   **TS-fixed.** Let $c_j=I_j/T$. In each period $t=1,\dots,T$:
--
--   1. sample $\theta(t)$ from the posterior distribution of $\theta$ given the history $\mathcal H_{t-1}=(P(1),D(1),\dots,P(t-1),D(t-1))$;
--   2. let $x(t)$ be an optimal solution of $\mathrm{LP}(d(\theta(t)))$;
--   3. post $P(t)=p_k$ with probability $x_k(t)$ and $p_\infty$ with probability $1-\sum_k x_k(t)$;
--   4. observe the demand $D(t)$ and update the history.
--
--   A **run of TS-fixed** is a family of random variables on a probability space $(\Omega,\mathbb P)$ — the true parameter $\theta$, the samples $\theta(t)$, the posted prices $P(t)$, the demands $D(t)$ and the satisfied demands $\tilde D(t)$ — such that $\theta\sim\mu_0$; given everything that happened before period $t$ (including $\theta$), $\theta(t)$ has the conditional law of $\theta$ given $\mathcal H_{t-1}$; given that and $\theta(t)$, $P(t)=p_k$ with probability $x_k(\theta(t))$, where $\rho\mapsto x(\rho)$ is a measurable map returning an optimal solution of $\mathrm{LP}(d(\rho))$; given all that and $P(t)$, $D(t)$ has law $F(\cdot\,;P(t),\theta)$ (the point mass at $0$ under $p_\infty$); and $\tilde D$ obeys (a)/(b) almost surely.
--
--   The revenue is $\mathrm{Rev}(T)=\sum_{t=1}^T\sum_{i=1}^N\tilde D_i(t)P_i(t)$, and the **Bayesian regret against the LP benchmark** is
--
--   $$
--   \mathbb E\bigl[\mathrm{OPT}(d(\theta))\bigr]\cdot T-\mathbb E\bigl[\mathrm{Rev}(T)\bigr],
--   $$
--
--   the right-hand side of the last display of Section 3.1.1.
--
--   **Formalization Note** Periods are 0-based in Lean: $t=0,\dots,T-1$ stands for the paper's $t=1,\dots,T$, and `inventory … t` is the inventory at the start of Lean period $t$. The posted price is an element of `Option (Fin K)`, with `none` the shut-off price $p_\infty$; its price vector is taken as $0$ (revenue under $p_\infty$ is zero since demand is zero). Conditional probabilities are conditional expectations of indicators, stated almost surely. "Everything before period $t$" is the σ-algebra generated by $\theta$ and by $\theta(s),P(s),D(s)$ for $s<t$; the history $\mathcal H$ is generated by $P(s),D(s)$ for $s<t$ — the full demand, as printed, not the satisfied demand. "The optimal solution" is any measurable optimal selection, so every measurable tie-break is covered. The price set carries the discrete σ-algebra.
-- source:
--   Ferreira, Simchi-Levi, Wang, Online Network Revenue Management Using Thompson Sampling, Oper. Res. 66(6), 2018, pp. 1589-1590, Section 2.1 (model, fulfilment (a)/(b), prior); pp. 1590-1591, Section 2.2 and Algorithm 1 (TS-fixed); p. 1593, Section 3.1.1 (benchmark, BayesRegret); p. 1593, Section 3.1.2 (bounded demand)

import Mathlib
import Definitions.Def_OnlineNRM_TSFixed_LP

namespace OnlineNRM.TSFixed

open MeasureTheory ProbabilityTheory
open scoped BigOperators

/-- The set of posted prices `{p_1, …, p_K, p_∞}` is encoded as `Option (Fin K)` (`none` is
the shut-off price `p_∞`); it is a finite set with the discrete σ-algebra. -/
scoped instance measurableSpaceOptionFin (K : ℕ) : MeasurableSpace (Option (Fin K)) := ⊤

variable {N M K : ℕ} {Θ : Type*} [MeasurableSpace Θ] {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- Mean demand under parameter `ρ`: `d i k (ρ) = E[D_i]` when `D ∼ F(· ; p_k, ρ)`. -/
noncomputable def meanDemand (F : Kernel (Θ × Fin K) (Fin N → ℝ)) (ρ : Θ) :
    Fin N → Fin K → ℝ :=
  fun i k => ∫ x, x i ∂(F (ρ, k))

/-- Law of the demand vector given parameter `ρ` and posted price: `F(· ; p_k, ρ)` for the
price vector `p_k` (`some k`), and the point mass at `0` for the shut-off price `p_∞`
(`none`), under which every product has zero demand with probability one. -/
noncomputable def demandLaw (F : Kernel (Θ × Fin K) (Fin N → ℝ)) (ρ : Θ) :
    Option (Fin K) → Measure (Fin N → ℝ)
  | some k => F (ρ, k)
  | none => Measure.dirac 0

/-- Price of product `i` under the posted price: `p i k` for `p_k`, and `0` for `p_∞`
(revenue under `p_∞` is zero because its demand is zero almost surely). -/
def postedPrice (p : Fin N → Fin K → ℝ) : Option (Fin K) → Fin N → ℝ
  | some k => fun i => p i k
  | none => fun _ => 0

/-- Inventory at the end of (0-based) period `t`: `inv 0 = I` and
`inv (t+1) j = inv t j - ∑ᵢ Dsat t i * a i j`, where `Dsat` is the satisfied demand. -/
def inventory (a : Fin N → Fin M → ℝ) (I : Fin M → ℝ) (Dsat : ℕ → Ω → Fin N → ℝ) :
    ℕ → Ω → Fin M → ℝ
  | 0 => fun _ => I
  | t + 1 => fun ω j => inventory a I Dsat t ω j - ∑ i : Fin N, Dsat t ω i * a i j

/-- History σ-algebra `ℋ` before 0-based period `t`: generated by the posted prices and
the (full, not satisfied) demands of periods `s < t`. -/
def histSigma (A : ℕ → Ω → Option (Fin K)) (D : ℕ → Ω → Fin N → ℝ) (t : ℕ) :
    MeasurableSpace Ω :=
  ⨆ s < t, (MeasurableSpace.comap (A s) inferInstance ⊔ MeasurableSpace.comap (D s) inferInstance)

/-- Everything that has happened before 0-based period `t`: the true parameter `θ`, and the
posterior samples, posted prices and demands of periods `s < t`. -/
def pastSigma (θ : Ω → Θ) (θs : ℕ → Ω → Θ) (A : ℕ → Ω → Option (Fin K))
    (D : ℕ → Ω → Fin N → ℝ) (t : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap θ inferInstance ⊔
    ⨆ s < t, (MeasurableSpace.comap (θs s) inferInstance ⊔
      MeasurableSpace.comap (A s) inferInstance ⊔ MeasurableSpace.comap (D s) inferInstance)

/-- Conditional probability of the event `S` given the σ-algebra `m`, as a real-valued
random variable. -/
noncomputable def condProb (P : Measure Ω) (m : MeasurableSpace Ω) (S : Set Ω) : Ω → ℝ :=
  P[S.indicator (fun _ => (1 : ℝ)) | m]

/-- The satisfied demand `Dsat` follows the fulfilment rules (a)/(b) of Section 2.1 in
(0-based) period `t` at outcome `ω`, with inventory `inventory a I Dsat`:
(a) if the inventory covers all demand, `Dsat = D`;
(b) otherwise `0 ≤ Dsat ≤ D` componentwise, the end-of-period inventory is nonnegative, and
at least one resource has end-of-period inventory zero. No further rule is imposed. -/
def FulfilmentRule (a : Fin N → Fin M → ℝ) (I : Fin M → ℝ) (D Dsat : ℕ → Ω → Fin N → ℝ)
    (t : ℕ) (ω : Ω) : Prop :=
  if ∀ j : Fin M, ∑ i : Fin N, D t ω i * a i j ≤ inventory a I Dsat t ω j then
    Dsat t ω = D t ω
  else
    (∀ i : Fin N, 0 ≤ Dsat t ω i ∧ Dsat t ω i ≤ D t ω i) ∧
      (∀ j : Fin M, 0 ≤ inventory a I Dsat (t + 1) ω j) ∧
      ∃ j : Fin M, inventory a I Dsat (t + 1) ω j = 0

/-- A run of TS-fixed (Algorithm 1) over `T` periods (0-based `t = 0, …, T-1`) on the
probability space `(Ω, P)`, with prices `p`, consumption matrix `a`, initial inventory `I`,
demand kernel `F`, prior `μ₀` and LP solution map `xsel`:

* `θ` is the true parameter, with law `μ₀`;
* (step 1) given everything before period `t`, the sample `θs t` has the posterior law of
  `θ` given the history `ℋ` (so it is drawn independently of `θ` given the history);
* (step 2) `xsel ρ` is an optimal solution of `LP(d(ρ))` with `c j = I j / T`, for every `ρ`;
* (step 3) given everything before `t` and `θs t`, the price `p_k` is posted with
  probability `xsel (θs t) k` (and `p_∞` with the remaining probability);
* (§2.1) given everything before `t`, `θs t` and the posted price, the demand `D t` has law
  `F(· ; P(t), θ)`;
* (§2.1, (a)/(b)) the satisfied demand `Dsat` obeys the fulfilment rule almost surely;
* all random variables and `xsel` are measurable. -/
structure IsTSFixedRun (p : Fin N → Fin K → ℝ) (a : Fin N → Fin M → ℝ) (I : Fin M → ℝ)
    (F : Kernel (Θ × Fin K) (Fin N → ℝ)) (μ₀ : Measure Θ) (T : ℕ) (P : Measure Ω)
    (θ : Ω → Θ) (θs : ℕ → Ω → Θ) (A : ℕ → Ω → Option (Fin K))
    (D Dsat : ℕ → Ω → Fin N → ℝ) (xsel : Θ → Fin K → ℝ) : Prop where
  measurable_θ : Measurable θ
  measurable_θs : ∀ t, Measurable (θs t)
  measurable_A : ∀ t, Measurable (A t)
  measurable_D : ∀ t, Measurable (D t)
  measurable_Dsat : ∀ t, Measurable (Dsat t)
  measurable_xsel : Measurable xsel
  prior : P.map θ = μ₀
  posterior_sample : ∀ t < T, ∀ C : Set Θ, MeasurableSet C →
    condProb P (pastSigma θ θs A D t) (θs t ⁻¹' C) =ᵐ[P] condProb P (histSigma A D t) (θ ⁻¹' C)
  lp_optimal : ∀ ρ : Θ, IsLPOptimal p a (meanDemand F ρ) (fun j => I j / (T : ℝ)) (xsel ρ)
  offer_price : ∀ t < T, ∀ k : Fin K,
    condProb P (pastSigma θ θs A D t ⊔ MeasurableSpace.comap (θs t) inferInstance)
      (A t ⁻¹' {some k}) =ᵐ[P] fun ω => xsel (θs t ω) k
  demand : ∀ t < T, ∀ B : Set (Fin N → ℝ), MeasurableSet B →
    condProb P (pastSigma θ θs A D t ⊔ MeasurableSpace.comap (θs t) inferInstance ⊔
        MeasurableSpace.comap (A t) inferInstance) (D t ⁻¹' B)
      =ᵐ[P] fun ω => (demandLaw F (θ ω) (A t ω) B).toReal
  fulfilment : ∀ t < T, ∀ᵐ ω ∂P, FulfilmentRule a I D Dsat t ω

/-- Total revenue over `T` periods: `Rev(T) = ∑_{t} ∑ᵢ D̃ᵢ(t) Pᵢ(t)`. -/
def revenue (p : Fin N → Fin K → ℝ) (A : ℕ → Ω → Option (Fin K))
    (Dsat : ℕ → Ω → Fin N → ℝ) (T : ℕ) (ω : Ω) : ℝ :=
  ∑ t ∈ Finset.range T, ∑ i : Fin N, Dsat t ω i * postedPrice p (A t ω) i

/-- Bayesian regret against the LP benchmark of Section 3.1.1:
`E[OPT(d)] · T - E[Rev(T)]`, where `d = d(θ)` is the mean demand under the true parameter
and `c j = I j / T`. -/
noncomputable def lpBayesRegret (p : Fin N → Fin K → ℝ) (a : Fin N → Fin M → ℝ)
    (I : Fin M → ℝ) (F : Kernel (Θ × Fin K) (Fin N → ℝ)) (T : ℕ) (P : Measure Ω)
    (θ : Ω → Θ) (A : ℕ → Ω → Option (Fin K)) (Dsat : ℕ → Ω → Fin N → ℝ) : ℝ :=
  (∫ ω, lpOpt p a (meanDemand F (θ ω)) (fun j => I j / (T : ℝ)) ∂P) * (T : ℝ)
    - ∫ ω, revenue p A Dsat T ω ∂P

end OnlineNRM.TSFixed


