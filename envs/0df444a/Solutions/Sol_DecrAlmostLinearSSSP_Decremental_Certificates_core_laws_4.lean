open Structured
lemma Image.nat_register (B R N k value : ℕ) (g : Machine) (s : Data)
    (h : Image B R N g s) (hk : k%2 = 0)
    (h74 : k ≠ 74) (h112 : k ≠ 112) (h106 : k ≠ 106) (h50 : k ≠ 50) (h56 : k ≠ 56) :
    Image B R N g {s with natReg := Function.update s.natReg k value} := by
  have hn (j : ℕ) (hj : j ≠ k) : Function.update s.natReg k value j = s.natReg j := Function.update_of_ne hj _ _
  refine ⟨(hn 74 (Ne.symm h74)).trans h.base,(hn 112 (Ne.symm h112)).trans h.factor,
    (hn 106 (Ne.symm h106)).trans h.record,(hn 50 (Ne.symm h50)).trans h.savedBase,
    (hn 56 (Ne.symm h56)).trans h.zero,h.realMem,h.natMem,h.work,?_,?_⟩
  · constructor
    · intro j hj
      change s.natMem (Function.update s.natReg k value 50+2*j) = _
      rw [hn 50 (Ne.symm h50)]
      exact h.saved.nat j hj
    · intro j hj
      change s.realMem (Function.update s.natReg k value 50+2*j) = _
      rw [hn 50 (Ne.symm h50)]
      exact h.saved.real j hj
  · intro j hj
    have hs : shadowReg j ≠ k := by
      have ho : shadowReg j%2 = 1 := by simp [shadowReg]
      omega
    exact ⟨(hn _ hs).trans (h.tail j hj).1,(h.tail j hj).2⟩
lemma Image.real_register (B R N k : ℕ) (value : ℝ) (g : Machine) (s : Data)
    (h : Image B R N g s) (hk : k%2 = 0) :
    Image B R N g {s with realReg := Function.update s.realReg k value} := by
  refine ⟨h.base,h.factor,h.record,h.savedBase,h.zero,h.realMem,h.natMem,h.work,⟨h.saved.nat,h.saved.real⟩,?_⟩
  intro j hj
  have hs : shadowReg j ≠ k := by
    have ho : shadowReg j%2 = 1 := by simp [shadowReg]
    omega
  exact ⟨(h.tail j hj).1,(Function.update_of_ne hs _ _).trans (h.tail j hj).2⟩
lemma Image.tagged (B R N tag : ℕ) (g : Machine) (s : Data)
    (h : Image B R N g s) (hodd : ∃ r, R = B+2*r+1) :
    Image B R N {g with natReg := Function.update g.natReg 5 tag} (CoreRequest.tagged tag s) := by
  apply Image.nat_patch B R N 5 632 tag g _ _ hodd (by omega) (by simp)
  exact h.nat_register B R N 632 (2*tag) g s (by decide) (by omega) (by omega) (by omega) (by omega) (by omega)
