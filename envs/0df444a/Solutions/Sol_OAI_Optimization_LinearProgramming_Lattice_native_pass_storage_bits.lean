theorem nativeReach_upper_frame {n m : ℕ} {c d : ReductionCursor n m} (h : c.Reaches d)
    (i j : Fin n) (hij : i ≤ j) :
    (d.state.ν.getRow i).get j = (c.state.ν.getRow i).get j := by
  induction h with
  | refl => rfl
  | @step d e _ hn ih =>
    apply Eq.trans _ ih
