-- title:
--   Pair form of Kronecker's congruence at level (N,ℓ)
-- statement:
--   Let $N$ be a nonzero natural number and $\ell$ a prime not dividing $N$. Inside the Laurent series field $\mathbb{Q}(\!(q)\!)$ let `jq` denote the series $q^{-1}$ times the power series `jNumQ` obtained from the integral numerator series `jNum` by base change to $\mathbb{Q}$ (the $q$-expansion of $j$), let `qExpand ℚ n` denote the ring endomorphism of $\mathbb{Q}(\!(q)\!)$ induced by multiplication by $n$ on exponents, that is the substitution $q \mapsto q^{n}$, and set $\mathtt{jqN}\,\ell = \mathtt{qExpand}\ \mathbb{Q}\ \ell\ \mathtt{jq}$, the expansion of $j$ in $q^{\ell}$. Write $u = \mathtt{jqN}\,\ell - \mathtt{jq}^{\ell}$ and $v = \mathtt{jq} - (\mathtt{jqN}\,\ell)^{\ell}$. The theorem asserts, as a conjunction of two statements, that both mixed products divided by $\ell$, namely $\ell^{-1}\,u\cdot(\mathtt{qExpand}\ \mathbb{Q}\ N\ v)$ and $\ell^{-1}\,v\cdot(\mathtt{qExpand}\ \mathbb{Q}\ N\ u)$, where $\ell^{-1}$ is the inverse of the constant series $\ell$ in $\mathbb{Q}(\!(q)\!)$, are integral over the $\mathbb{Z}$-subalgebra $\mathbb{Z}[\mathtt{jq}]$ of $\mathbb{Q}(\!(q)\!)$ generated by `jq`.
--
--   For $N = 1$ both products coincide with $u\cdot v$ and the assertion is the classical Kronecker congruence $\Phi_{\ell}(X,Y) \equiv (X - Y^{\ell})(X^{\ell} - Y) \bmod \ell$ for the modular polynomial of prime level $\ell$, in the $q$-expansion form asserting that $\ell^{-1}(j(q^{\ell}) - j(q)^{\ell})(j(q) - j(q^{\ell})^{\ell})$ is integral over $\mathbb{Z}[j(q)]$; the statement here is the pair-twisted version obtained by substituting $q \mapsto q^{N}$ in one factor. It is used in the analysis of the characteristic-$p$ fibre models of the modular curves, in the computation of special places with nonvanishing derivative at a given level.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_kroneckerPairIntegral.lean

import Definitions.Def_ModularCurve_X0

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve

theorem ModularCurve.kroneckerPairIntegral (N ℓ : ℕ) [NeZero N] [Fact ℓ.Prime]
    (hℓN : ¬ ℓ ∣ N) :
    IsIntegral (Algebra.adjoin ℤ ({jq} : Set (LaurentSeries ℚ)))
        ((ℓ : LaurentSeries ℚ)⁻¹ * ((jqN ℓ - jq ^ ℓ) * qExpand ℚ N (jq - (jqN ℓ) ^ ℓ)))
      ∧ IsIntegral (Algebra.adjoin ℤ ({jq} : Set (LaurentSeries ℚ)))
        ((ℓ : LaurentSeries ℚ)⁻¹ * ((jq - (jqN ℓ) ^ ℓ) * qExpand ℚ N (jqN ℓ - jq ^ ℓ))) := by sorry
