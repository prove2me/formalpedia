  have c1 := push_cost u 28 (.reg hPp) Bt (by simp only [Ex.Bnd, top_of hp]; omega)
  set u1 := NLogN.CR.pushV u 28 p with hu1
  have h2 := push_sp u1 29 (by decide) (.reg hM2) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide)) (by simp +decide [hu1, Ex.ok, isInt_of' hm]) R
    (by simp +decide [hu1, Ex.eval, top_of hm])
  have c2 := push_cost u1 29 (.reg hM2) Bt (by simp +decide [hu1, Ex.Bnd, top_of hm]; omega)
  set u2 := NLogN.CR.pushV u1 29 R with hu2
  have h3 := push_sp u2 53 (by decide) (.reg hC) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide)) (by simp +decide [hu2, hu1, Ex.ok, isInt_of' hc]) c
    (by simp +decide [hu2, hu1, Ex.eval, top_of hc])
  have c3 := push_cost u2 53 (.reg hC) Bt (by simp +decide [hu2, hu1, Ex.Bnd, top_of hc]; omega)
  set u3 := NLogN.CR.pushV u2 53 c with hu3
  obtain ⟨o4, r4, c4⟩ := twDP_spec p R c u3 (u.G 28) (u.G 29) (u.G 53)
    (by simp +decide [hu3, hu2, hu1]) (by simp +decide [hu3, hu2, hu1]) (by simp +decide [hu3, hu2, hu1])
  set u4 := (u3.upd 15 (.int (twD p R c).1 :: u3.G 15)).upd 16 (.int (twD p R c).2 :: u3.G 16) with hu4
  have g5 : u4.G 53 = .int c :: u.G 53 := by simp +decide [hu4, hu3, hu2, hu1]
  have h5 := pop_sp u4 53 (by decide) _ _ g5
  have c5 := pop_cost u4 53 Bt (by rw [top_of g5]; omega)
  set u5 := u4.upd 53 (u.G 53) with hu5
  have g6 : u5.G 29 = .int R :: u.G 29 := by simp +decide [hu5, hu4, hu3, hu2, hu1]
  have h6 := pop_sp u5 29 (by decide) _ _ g6
  have c6 := pop_cost u5 29 Bt (by rw [top_of g6]; omega)
  set u6 := u5.upd 29 (u.G 29) with hu6
  have g7 : u6.G 28 = .int p :: u.G 28 := by simp +decide [hu6, hu5, hu4, hu3, hu2, hu1]
  have h7 := pop_sp u6 28 (by decide) _ _ g7
  have c7 := pop_cost u6 28 Bt (by rw [top_of g7]; omega)
  have fin : u6.upd 28 (u.G 28) = (u.upd hVA (.int (twD p R c).1 :: u.G hVA)).upd hVB
      (.int (twD p R c).2 :: u.G hVB) := by
    apply IState.ext' _ (by simp [hu6, hu5, hu4, hu3, hu2, hu1]) (by simp [hu6, hu5, hu4, hu3, hu2, hu1])
    intro y
    clear_value u1 u2 u3 u4 u5 u6
    subst hu6 hu5 hu4 hu3 hu2 hu1
    fin_cases y <;> simp +decide <;> rfl
  rw [fin] at h7
  have hmono : twDCost p (zsz (R : ℤ)) (zsz (c : ℤ)) ≤ twDCost p (zsz (R : ℤ)) (zsz (R : ℤ)) := by
    unfold twDCost; gcongr
  unfold twW
  simp only [seqL]
  have hall := seq_spec h1 (seq_spec h2 (seq_spec h3 (seq_spec ⟨o4, r4⟩ (seq_spec h5 (seq_spec h6 h7)))))
  refine ⟨hall.1, hall.2, ?_⟩
  refine le_trans (seq_cost h1.2 c1 (seq_cost h2.2 c2 (seq_cost h3.2 c3 (seq_cost r4 c4
    (seq_cost h5.2 c5 (seq_cost h6.2 c6 c7)))))) ?_
  simp only [Ex.size, twCost]
  rw [← hBt] at *
  have : Bt + 2 = zsz (p : ℤ) + zsz (R : ℤ) + 3 := by omega
  rw [this]
  generalize (zsz (p : ℤ) + zsz (R : ℤ) + 3) ^ 2 = X at *
  omega

end NLogN.CR

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.CR
open IntMul RS IntMul.HvdH IntMul.HvdH.Ref
theorem solution (M : NLogN.MulSpec) (p R : ℕ) : NLogN.CR.TwSpec M NLogN.CR.twR p R (NLogN.CR.twCost p R) := by
  refine ⟨?_, ?_⟩
  · simp only [NLogN.CR.twR, NLogN.RM.writes_ren, NLogN.RM.writes, NLogN.CR.twσ]
    decide
  · intro t c L LP LM hc hp hm hcR
    have hσ : NLogN.FixHi twσ := by decide
    set u := t.rn NLogN.CR.twσ⁻¹ with hu
    have e : ∀ i : Fin NLogN.HS, i ≠ 10 → i ≠ 54 → u.G i = t.G i := by
      intro i h1 h2
      simp only [hu, NLogN.IState.rn_G', NLogN.CR.twσ, Equiv.Perm.inv_def, Equiv.symm_symm]
      rw [Equiv.swap_apply_of_ne_of_ne h1 h2]
    obtain ⟨o, r, co⟩ := NLogN.CR.twW_spec u p R c L LP LM hcR (by rw [e _ (by decide) (by decide)]; exact hc)
      (by rw [e _ (by decide) (by decide)]; exact hp) (by rw [e _ (by decide) (by decide)]; exact hm)
    refine ⟨(NLogN.RM.ok_ren_any M hσ (.rs NLogN.CR.twW) t).2 o, ?_, ?_⟩
    · rw [NLogN.CR.twR, NLogN.RM.run_ren_any]
      show (NLogN.CR.twW.run u).rn NLogN.CR.twσ = _
      rw [r, NLogN.IState.rn_upd, NLogN.IState.rn_upd, hu, NLogN.IState.rn_rn_inv]
      have f15 : NLogN.CR.twσ NLogN.CR.hVA = hVA := by decide
      have f16 : NLogN.CR.twσ NLogN.CR.hVB = hVB := by decide
      rw [f15, f16, e _ (by decide) (by decide), e _ (by decide) (by decide)]
    · rw [NLogN.CR.twR, NLogN.RM.cost_ren_any]; exact co
end
