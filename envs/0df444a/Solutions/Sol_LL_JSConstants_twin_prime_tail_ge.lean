  have hg_nonneg : ∀ p ∈ Grid, 0 ≤ gFun p := by
    intro p hp
    rcases Finset.mem_product.mp hp with ⟨hk, _⟩
    have hk28 : 28 ≤ p.1 := (Finset.mem_Ico.mp hk).1
    have hk_real : (28 : ℝ) ≤ (p.1 : ℝ) := by exact_mod_cast hk28
    dsimp [gFun]
    have hdiff : 0 ≤ 1 / ((p.1 : ℝ) - 1 / 2) - 1 / ((p.1 : ℝ) + 1 / 2) := by
      rw [sub_nonneg]
      exact one_div_le_one_div_of_le (by linarith) (by linarith)
    positivity
  have htail_inj :
      (∑ n ∈ S_tail, termReal n) ≤ ∑ p ∈ Grid, gFun p := by
    let emb : ℕ → ℕ × ℕ := fun n => (n / 2310, n % 2310)
    have hemb_mem : ∀ n ∈ S_tail, emb n ∈ Grid := by
      intro n hn
      rcases Finset.mem_filter.mp hn with ⟨hnS, hnlt⟩
      have h64 : 64680 ≤ n := by omega
      rcases hS n hnS with ⟨hp, _⟩
      dsimp [emb]
      refine Finset.mem_product.mpr ⟨Finset.mem_Ico.mpr ⟨by omega, ?_⟩, ?_⟩
      · have hsup : n / 2310 ≤ S_tail.sup (fun m => m / 2310) :=
          Finset.le_sup (f := fun m => m / 2310) hn
        have hmax : S_tail.sup (fun m => m / 2310) + 1 ≤ KTop := le_max_right _ _
        omega
      · refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.mod_lt n (by norm_num)), ?_⟩
        rw [Nat.coprime_iff_gcd_eq_one]
        by_contra hne
        obtain ⟨q, hqp, hq_r, hq_m⟩ := Nat.Prime.not_coprime_iff_dvd.mp hne
        have hqn : q ∣ n := by
