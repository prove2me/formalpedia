private theorem seqπ_seqπ (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (k : ℕ) :
    seqπ p f hfin (seqπ p f hfin x hx) (seqπ_mem p f hfin x hx) k = seqπ p f hfin x hx k := by
  haveI := hfin k
  have h := fitProj_fitProj (flvl p f k) ⟨x k, hx k⟩
