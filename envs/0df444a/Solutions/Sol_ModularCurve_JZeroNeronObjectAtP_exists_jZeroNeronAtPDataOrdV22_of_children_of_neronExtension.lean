theorem galois_smul_heckeAlg_smul' {M : ℕ} [NeZero M] (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (t : HeckeAlg)
    (x : JZero M) : (letI := heckeModuleBar M; σ • (t • x) = t • (σ • x)) := by
  letI := heckeModuleBar M
  exact ModularCurve.heckeAlg_smul_comm_of_forall_gen (DistribSMul.toAddMonoidHom (JZero M) σ)
    (fun q y => (ModularCurve.heckeGen_smul_galois_smul M σ q y).symm) t x

theorem smul_mem_inertiaInvariants' (A : ValuationSubring (AlgebraicClosure ℚ)) {M : ℕ} [NeZero M]
    (t : HeckeAlg) {x : JZero M} (hx : x ∈ inertiaInvariants A M) :
    (letI := heckeModuleBar M; t • x) ∈ inertiaInvariants A M := by
  letI := heckeModuleBar M
  rw [mem_inertiaInvariants] at hx ⊢
  intro σ hσ
  rw [galois_smul_heckeAlg_smul', hx σ hσ]

def heckeEndInv (A : ValuationSubring (AlgebraicClosure ℚ)) (M : ℕ) [NeZero M] (t : HeckeAlg) :
    ↥(inertiaInvariants A M) →+ ↥(inertiaInvariants A M) :=
  letI := heckeModuleBar M
  { toFun := fun x => ⟨t • (x : JZero M), smul_mem_inertiaInvariants' A t x.2⟩
    map_zero' := Subtype.ext (smul_zero t)
    map_add' := fun x y => Subtype.ext (smul_add t (x : JZero M) y) }

theorem coe_heckeEndInv (A : ValuationSubring (AlgebraicClosure ℚ)) (M : ℕ) [NeZero M] (t : HeckeAlg) (x : ↥(inertiaInvariants A M)) :
    (heckeEndInv A M t x : JZero M) = (letI := heckeModuleBar M; t • (x : JZero M)) := rfl

scoped instance instSMulInv (A : ValuationSubring (AlgebraicClosure ℚ)) (M : ℕ) [NeZero M] : SMul HeckeAlg ↥(inertiaInvariants A M) :=
  ⟨fun t x => heckeEndInv A M t x⟩

theorem coe_smul_inertiaInvariants (A : ValuationSubring (AlgebraicClosure ℚ)) {M : ℕ} [NeZero M] (t : HeckeAlg)
    (x : ↥(inertiaInvariants A M)) : ((t • x : ↥(inertiaInvariants A M)) : JZero M) = (letI := heckeModuleBar M; t • (x : JZero M)) :=
  rfl

scoped instance instModuleInv (A : ValuationSubring (AlgebraicClosure ℚ)) (M : ℕ) [NeZero M] : Module HeckeAlg ↥(inertiaInvariants A M) :=
  letI := heckeModuleBar M
  Function.Injective.module HeckeAlg (inertiaInvariants A M).subtype Subtype.val_injective (fun _ _ => rfl)

def kerExt (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : AddSubgroup ↥(inertiaInvariants A (N₀ * p)) :=
  O.extPts.comap (inertiaInvariants A (N₀ * p)).subtype

theorem mem_kerExt (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x : ↥(inertiaInvariants A (N₀ * p))) :
    x ∈ kerExt O ↔ (x : JZero (N₀ * p)) ∈ O.extPts := Iff.rfl

theorem mem_kerExt_iff_comp (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x : ↥(inertiaInvariants A (N₀ * p))) :
    x ∈ kerExt O ↔ O.comp x = 0 := (O.comp_eq_zero_iff x).symm

abbrev Φq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Type := ↥(inertiaInvariants A (N₀ * p)) ⧸ kerExt O

abbrev toΦq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : ↥(inertiaInvariants A (N₀ * p)) →+ Φq O :=
  QuotientAddGroup.mk' (kerExt O)

theorem toΦq_surjective (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Function.Surjective (toΦq O) :=
  QuotientAddGroup.mk'_surjective _

theorem toΦq_eq_zero_iff (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x : ↥(inertiaInvariants A (N₀ * p))) :
    toΦq O x = 0 ↔ (x : JZero (N₀ * p)) ∈ O.extPts := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, mem_kerExt]

theorem toΦq_eq_toΦq_iff (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x y : ↥(inertiaInvariants A (N₀ * p))) :
    toΦq O x = toΦq O y ↔ (x : JZero (N₀ * p)) - y ∈ O.extPts := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_iff_sub_mem, mem_kerExt,
    AddSubgroup.coe_sub]

theorem sub_mem_extPts_of_comp_eq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {y y' : ↥(inertiaInvariants A (N₀ * p))}
    (h : O.comp y = O.comp y') : (y : JZero (N₀ * p)) - y' ∈ O.extPts :=
  (O.comp_eq_zero_iff (y - y')).mp ((map_sub O.comp y y').trans (sub_eq_zero.mpr h))

theorem comp_eq_of_sub_mem_extPts (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {y y' : ↥(inertiaInvariants A (N₀ * p))}
    (h : (y : JZero (N₀ * p)) - y' ∈ O.extPts) : O.comp y = O.comp y' :=
  sub_eq_zero.mp ((map_sub O.comp y y').symm.trans ((O.comp_eq_zero_iff (y - y')).mpr h))

theorem toΦq_congr (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {y y' : ↥(inertiaInvariants A (N₀ * p))}
    (h : O.comp y = O.comp y') : toΦq O y = toΦq O y' :=
  (toΦq_eq_toΦq_iff O y y').mpr (sub_mem_extPts_of_comp_eq O h)

def heckeEndΦ (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (t : HeckeAlg) : Φq O →+ Φq O :=
  QuotientAddGroup.map (kerExt O) (kerExt O) (heckeEndInv A (N₀ * p) t) (by
    intro x hx
    rw [AddSubgroup.mem_comap, mem_kerExt, coe_heckeEndInv]
    exact O.smul_mem_extPts t ((mem_kerExt O x).mp hx))

theorem heckeEndΦ_toΦq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (t : HeckeAlg) (y : ↥(inertiaInvariants A (N₀ * p))) :
    heckeEndΦ O t (toΦq O y) = toΦq O (heckeEndInv A (N₀ * p) t y) := rfl

scoped instance instSMulΦq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : SMul HeckeAlg (Φq O) :=
  ⟨fun t φ => heckeEndΦ O t φ⟩

scoped instance instModuleΦq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Module HeckeAlg (Φq O) :=
  Function.Surjective.module HeckeAlg (toΦq O) (toΦq_surjective O) (fun _ _ => rfl)

theorem toΦq_smul (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (t : HeckeAlg) (x : ↥(inertiaInvariants A (N₀ * p))) :
    toΦq O (t • x) = t • toΦq O x :=
  rfl

def liftΦ (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : componentGroup O.width →+ Φq O where
  toFun φ := toΦq O (O.comp_surjective φ).choose
  map_zero' := (toΦq_eq_zero_iff O _).mpr ((O.comp_eq_zero_iff _).mp (O.comp_surjective 0).choose_spec)
  map_add' := by
    intro φ ψ
    refine ((toΦq_congr O (y' := (O.comp_surjective φ).choose + (O.comp_surjective ψ).choose) ?_)).trans
      (map_add (toΦq O) _ _)
    exact (O.comp_surjective (φ + ψ)).choose_spec.trans
      ((congrArg₂ (· + ·) (O.comp_surjective φ).choose_spec (O.comp_surjective ψ).choose_spec).symm.trans
        (map_add O.comp _ _).symm)

theorem liftΦ_apply (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (φ : componentGroup O.width) :
    liftΦ O φ = toΦq O (O.comp_surjective φ).choose := rfl

theorem liftΦ_comp (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (y : ↥(inertiaInvariants A (N₀ * p))) :
    liftΦ O (O.comp y) = toΦq O y :=
  toΦq_congr O (O.comp_surjective (O.comp y)).choose_spec

theorem liftΦ_injective (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Function.Injective (liftΦ O) := by
  intro φ ψ h
  have h' : ((O.comp_surjective φ).choose : JZero (N₀ * p)) - (O.comp_surjective ψ).choose ∈ O.extPts :=
    (toΦq_eq_toΦq_iff O _ _).mp h
  exact (O.comp_surjective φ).choose_spec.symm.trans
    ((comp_eq_of_sub_mem_extPts O h').trans (O.comp_surjective ψ).choose_spec)

theorem liftΦ_surjective (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Function.Surjective (liftΦ O) :=
  fun φ => (toΦq_surjective O φ).elim fun y hy => ⟨O.comp y, (liftΦ_comp O y).trans hy⟩

