    (d : β → List Item) (f : α → β) (s : IState HS) (L : List α) (R : List Item)
    (C N Bc : ℕ) (n : Ex HS)
    (hd : [A, dA, B, dB, c].Nodup) (h1 : s.G A = L.flatMap e ++ R) (hl : L.length = N)
