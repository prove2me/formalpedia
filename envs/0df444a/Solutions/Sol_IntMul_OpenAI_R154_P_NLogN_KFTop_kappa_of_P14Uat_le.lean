open _root_.IntMul _root_.IntMul.OpenAI.Glue _root_.IntMul.OpenAI.RCost _root_.P8Lift
theorem ewb_core (G D : ℕ) (hG : G ≤ 10 ^ 48) :
    2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
      G ^ (Nat.log (100 ^ 3) D + 2)) +
    20 * (Nat.log (100 ^ 3) D + 1) ^ 3 * G ^ (Nat.log (100 ^ 3) D + 2) + 2 ≤
      2 * D + Cw * (D + 1) ^ 11 + 2 := by
  generalize hk : Nat.log (100 ^ 3) D = k
  have hk1 : (100 ^ 3) ^ k ≤ D + 1 := by
    rw [← hk]
    exact (Nat.pow_le_pow_right (by norm_num) (Nat.log_mono_right (Nat.le_succ D))).trans
      (Nat.pow_log_le_self _ (Nat.succ_ne_zero D))
  have hk2 : k + 1 ≤ D + 1 := Nat.lt_pow_self (by norm_num : 1 < 100 ^ 3) |>.trans_le hk1
  have hGk : G ^ (k + 2) ≤ 10 ^ 96 * (D + 1) ^ 8 := by
    calc G ^ (k + 2) ≤ (10 ^ 48) ^ (k + 2) := Nat.pow_le_pow_left hG _
      _ = 10 ^ 96 * ((100 ^ 3) ^ k) ^ 8 := by
          have e1 : ((10 : ℕ) ^ 48) ^ k = ((100 ^ 3) ^ k) ^ 8 := by
            rw [show ((10 : ℕ) ^ 48) = (100 ^ 3) ^ 8 by norm_num]
            generalize (100 : ℕ) ^ 3 = a
            rw [← pow_mul, ← pow_mul, mul_comm]
          rw [pow_add, e1, mul_comm]
          norm_num
      _ ≤ 10 ^ 96 * (D + 1) ^ 8 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hk1 _)
  have e : 2 * D + (k + 1) * 100 ^ 3 * (4 * (k + 1) ^ 2 * G ^ (k + 2)) +
      20 * (k + 1) ^ 3 * G ^ (k + 2) + 2 = 2 * D + 4000020 * ((k + 1) ^ 3 * G ^ (k + 2)) + 2 := by
    ring
  rw [e]
  have h3 : (k + 1) ^ 3 * G ^ (k + 2) ≤ (D + 1) ^ 3 * (10 ^ 96 * (D + 1) ^ 8) :=
    Nat.mul_le_mul (Nat.pow_le_pow_left hk2 _) hGk
  have e2 : 4000020 * ((D + 1) ^ 3 * (10 ^ 96 * (D + 1) ^ 8)) = Cw * (D + 1) ^ 11 := by
    unfold Cw; ring
  have := Nat.mul_le_mul_left 4000020 h3
  omega

theorem ewb_le (A D : ℕ)
    (hG : KFN.Gb complexIface.net.length sc Wc A ≤ 10 ^ 48) :
    KFM.EwB A D ≤ 2 * D + Cw * (D + 1) ^ 11 + 2 :=
  ewb_core _ D hG

