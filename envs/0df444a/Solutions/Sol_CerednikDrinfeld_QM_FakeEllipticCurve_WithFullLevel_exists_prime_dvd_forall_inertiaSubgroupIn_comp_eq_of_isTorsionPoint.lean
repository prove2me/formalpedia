theorem exists_prime_pow_dvd_three_le {m : ℕ} (hm : 3 ≤ m) :
    ∃ ℓ k : ℕ, ℓ.Prime ∧ 0 < k ∧ ℓ ^ k ∣ m ∧ 3 ≤ ℓ ^ k := by
  by_cases h : ∃ ℓ : ℕ, ℓ.Prime ∧ ℓ ∣ m ∧ 3 ≤ ℓ
  · obtain ⟨ℓ, hℓ, hdvd, h3⟩ := h
    exact ⟨ℓ, 1, hℓ, one_pos, by rwa [pow_one], by rwa [pow_one]⟩
  ·
    push Not at h
    have hm0 : m ≠ 0 := by omega
    have h2 : ∀ p : ℕ, p.Prime → p ∣ m → p = 2 := by
      intro p hp hpd
      have := h p hp hpd
      have := hp.two_le
      omega
    obtain ⟨j, rfl⟩ : ∃ j, m = 2 ^ j :=
      ⟨_, (Nat.eq_prime_pow_of_unique_prime_dvd hm0 fun hp hpd => h2 _ hp hpd)⟩
    refine ⟨2, 2, Nat.prime_two, two_pos, ?_, by norm_num⟩
    have hj : 2 ≤ j := by
      by_contra hj
      push Not at hj
      interval_cases j <;> simp at hm
    exact pow_dvd_pow 2 hj

theorem nsmulPt_eq_nsmul {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, ← ih]; rfl

theorem smul_eq_of_mem_torsionBy_of_fullLevel
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N m : ℕ}
    {K : Type} [Field K] (u : FakeEllipticCurve.WithFullLevel Λ N m K)
    (Ω : Type) [Field Ω] [IsAlgClosed Ω] [Algebra K Ω]
    (σ : Ω ≃ₐ[K] Ω) (P : u.1.L.AlgPoints u.1.comm Ω)
    (hP : P ∈ Submodule.torsionBy ℤ (u.1.L.AlgPoints u.1.comm Ω) ((m : ℕ) : ℤ)) : σ • P = P := by

  have htors : nsmulPt u.1.L (geomPoint Ω (algebraMap K Ω)) m (RelativeGroupLaw.AlgPoints.toPoint P) =
      u.1.L.one (geomPoint Ω (algebraMap K Ω)) := by
    rw [nsmulPt_eq_nsmul]
    exact (RelativeGroupLaw.isTorsionPoint_def _ _ _ _).mp ((RelativeGroupLaw.AlgPoints.mem_torsionBy_iff m P).mp hP)
  obtain ⟨x, hxP⟩ := u.2.generates Ω (algebraMap K Ω) (RelativeGroupLaw.AlgPoints.toPoint P) htors
  apply RelativeGroupLaw.AlgPoints.toPoint_injective
  apply Subtype.ext
  rw [RelativeGroupLaw.AlgPoints.toPoint_smul_coe]
  rw [← hxP]
  show Spec.map (CommRingCat.ofHom (σ : Ω →ₐ[K] Ω).toRingHom) ≫
      ((Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ u.2.P.1) ≫ u.1.act x) =
    (Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ u.2.P.1) ≫ u.1.act x
  simp only [← Category.assoc]
  rw [RelativeGroupLaw.AlgPoints.specMap_comp_algebraMap]

theorem smul_eq_of_rep_eq_one
    {a b : ℚ} {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ}
    {K : Type} [Field K] (E : FakeEllipticCurve Λ N K)
    (Ω : Type) [Field Ω] [IsAlgClosed Ω] [Algebra K Ω] [Algebra.IsAlgebraic K Ω]
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓK : (ℓ : K) ≠ 0)
    (σ : Ω ≃ₐ[K] Ω) (hrep : TateModule.rep ℓ (E.L.AlgPoints E.comm Ω) (Ω ≃ₐ[K] Ω) σ = 1)
    (v : ℕ) (P : E.L.AlgPoints E.comm Ω) (hP : ℓ ^ v • P = 0) : σ • P = P := by
  obtain ⟨x, hx⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_tateModule_algPoints_forall_generator_torsion_of_isMaximalOrder_of_prime
      hB Λ hΛ E Ω ℓ hℓK
  obtain ⟨mΛ, hm⟩ := (hx v).1 P hP
  obtain ⟨-, hequiv, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.nonempty_basis_tateModule_and_smul_pushPt_act_and_rep_sub_mem_of_prime E Ω ℓ hℓK
  have hxv : σ • ((x : ℕ → E.L.AlgPoints E.comm Ω) v) = (x : ℕ → E.L.AlgPoints E.comm Ω) v := by
    have h := TateModule.rep_apply (p := ℓ) (M := E.L.AlgPoints E.comm Ω) (G := Ω ≃ₐ[K] Ω) σ x v
    rw [hrep] at h
    exact h.symm.trans rfl
  have hP' : P = RelativeGroupLaw.AlgPoints.ofPoint
      (pushPt (E.act mΛ) (E.act_over mΛ) (RelativeGroupLaw.AlgPoints.toPoint ((x : ℕ → E.L.AlgPoints E.comm Ω) v))) := by
    apply RelativeGroupLaw.AlgPoints.toPoint_injective
    rw [RelativeGroupLaw.AlgPoints.toPoint_ofPoint]
    exact hm
  rw [hP', hequiv σ mΛ, hxv]

