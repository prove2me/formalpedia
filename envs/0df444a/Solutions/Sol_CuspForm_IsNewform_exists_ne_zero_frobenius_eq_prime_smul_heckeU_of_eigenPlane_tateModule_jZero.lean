  have hmemE : ∀ p ∈ s, p.1 ∈ E := fun p hp => Submodule.subset_span ⟨p, hp, rfl⟩
  let vE : E ⊗[R] M := ∑ p ∈ s.attach, (⟨p.1.1, hmemE p.1 p.2⟩ : E) ⊗ₜ[R] p.1.2
