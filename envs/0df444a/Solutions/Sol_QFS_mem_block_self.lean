end QFS

open QFS

variable {d : ℕ}

/-- A block contains its centre, when that is a lattice point. -/
lemma solution {ℓ : ℝ} (hℓ : 0 ≤ ℓ) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ QFS.lattice d) : x ∈ QFS.block ℓ x := by
  refine ⟨hx, ?_⟩
  have he : QFS.infNorm (x - x) = 0 :=
    le_antisymm (QFS.infNorm_le le_rfl (fun i => by rw [sub_self]; simp)) (QFS.infNorm_nonneg _)
  simp only [QFS.closedCube, Set.mem_ofPred_eq, he]
  linarith
