    · exact ⟨by dsimp only; decide, hz _ hbE⟩
    · exact ⟨by dsimp only; decide, hz _ hbL⟩
    · exact ⟨by dsimp only; decide, hz _ hbA⟩
    · exact ⟨by dsimp only; decide, hz _ hbB⟩
    · exact ⟨by dsimp only; decide, hz _ hbC⟩)
  have hfst : evl.map Prod.fst = [dJ, dT, dL, dA, dB, dC] := rfl
  rw [hfst] at S3
  have H := S1.toIRuns (I := I) (iprog := iprog) |>.seq ((IRuns.call h2).seq S3.toIRuns)
  refine H.mono' rfl ?_
  simp only [cCallR, hevl, List.length_cons, List.length_nil]
