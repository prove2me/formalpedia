-- Source module: Solutions.KFNImpl
/-!
# KFN: implementations of selected-bit operators and of network steps

* `ClN f`: the clean scratch used by all KFN programs (`KFB.Cl`, `KFG.ClP`, `KFG.ClT`, and the
  block counter `cO`).
* `SImpl r st n T code e dw cost`: on a clean managed state whose data stack starts with a record
  array `zs` (scale `F`, width `w`) representing `xs` (`n` records of `r` entries), `code` leaves
  an array representing `selOpF st n T xs` at scale `F + e`, width `w + dw`, at fine cost
  `cost w`.  This is `KFH.LImpl` with the layout given by record strides (`lImpl_of_sImpl`).
* `RImpl r n st A code e dw cost`: the same for a network operator `A` acting on `W` role streams
  stored one after the other (`flatR X`), through `roleOpF`.
* `RImpl.comp`, `rImpl_list` (a list of steps implements `denListR`), and
  `sImpl_of_rImpl_roleDiag`: an implementation of `roleDiag T` is one of `T` on the
  concatenated streams (strides inside the role blocks, `selOpF_flatR`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

/-! ## Clean scratch -/

/-- The clean scratch of the KFN programs. -/
structure ClN (f : Fin HS → List ℤ) : Prop where
  cl : KFB.Cl f
  p : KFG.ClP f
  t : KFG.ClT f
  o : f NLogN.KFN.cO = []

/-! ## Role streams stored one after the other -/

/-- The streams one after the other. -/
def flatR {α : Type*} {W : ℕ} (X : Fin W → List α) : List α := (List.finRange W).flatMap X

/-! ## Implementations -/

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- `code` implements the selected-bit operator `T` (record strides `st`, `n` records). -/
def SImpl {ι : Type*} [Fintype ι] [DecidableEq ι] (r : ℕ) (st : ι → ℕ) (n : ℕ)
    (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (code : RS) (e dw : ℕ) (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (F w : ℕ), ClN f → f 0 = gflat zs ++ l → RecRep r F zs xs → xs.length = n → NLogN.KFB.GB w zs →
    ∃ zs', RecRep r (F + e) zs' (selOpF st n T xs) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      FSp code (encK s f) (encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

section SImplLemmas

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ}

end SImplLemmas

section RImplDefs

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- `code` implements the network operator `A` on `W` role streams of `n` records each. -/
def RImpl (r n : ℕ) (st : Fin m × κ → ℕ) (A : ROp (Fin W) m κ) (code : RS) (e dw : ℕ)
    (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (X : Fin W → List (Fin r → ℂ)) (F w : ℕ), ClN f → f 0 = gflat zs ++ l →
    RecRep r F zs (flatR X) → (∀ v, (X v).length = n) → NLogN.KFB.GB w zs →
    ∃ zs', RecRep r (F + e) zs' (flatR (roleOpF st n A X)) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      FSp code (encK s f) (encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

variable {r n : ℕ} {st : Fin m × κ → ℕ}

/-- Sequence of programs. -/
def seqL : List RS → RS
  | [] => .skip
  | c :: cs => .seq c (seqL cs)

/-- Cost of a list of steps. -/
def costL {α : Type*} (cost : α → ℕ → ℕ) (dw : α → ℕ) : List α → ℕ → ℕ
  | [], _ => 1
  | a :: l, w => cost a w + costL cost dw l (w + dw a)

end RImplDefs

/-! ## Operators acting inside the role blocks -/

