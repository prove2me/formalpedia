namespace DecrAlmostLinearSSSP.Decremental
lemma RuntimeRepairStep.preserves (b : Core) (K : ℝ) (hK : 32 ≤ K)
    {s t : State b} (h : RuntimeRepairStep b K s t) (hs : RuntimeInvariant b K s) :
    RuntimeInvariant b K t := by
  cases h with
  | refresh e es hrun hp => exact hs.refresh b K (by linarith) s e
  | toggle r reports hrun hp hq ht hc => exact hs.toggle b K hK s hp r hq ht reports hc
  | stop hrun hp ht =>
    refine ⟨?_,hs.counter,hs.sample,hs.output,hs.energy⟩
    exact ⟨hs.cache.model,hs.cache.gradient_eq,hs.cache.detector⟩
lemma RuntimeRepairStep.decreases (b : Core) (K : ℝ) (hK : 0 < K)
    {s t : State b} (h : RuntimeRepairStep b K s t) (hs : RuntimeInvariant b K s) :
    Prod.Lex Nat.lt Nat.lt (runtimeRepairRank b K t) (runtimeRepairRank b K s) := by
  cases h with
  | refresh e es hrun hp => exact runtimeRank_refresh b K s e es hrun hp
  | toggle r reports hrun hp hq ht hc => exact runtimeRank_toggle b K hK s hs hrun r reports
  | stop hrun hp ht => exact runtimeRank_stop b K s hrun
lemma runtime_repair_wellFounded (b : Core) (K : ℝ) (hK : 0 < K) :
    WellFounded (fun t s : State b => RuntimeInvariant b K s ∧ RuntimeRepairStep b K s t) := by
  apply (runtimeRank_wellFounded b K).mono
  intro t s h
  exact h.2.decreases b K hK h.1
lemma RuntimeRepairStep.completed (b : Core) (K : ℝ) (hK : 32 ≤ K)
    {s t : State b} (h : RuntimeRepairStep b K s t) (hs : RuntimeInvariant b K s)
    (hstopped : t.stopped = true) : ReadoutCertificate b t := by
  cases h with
  | refresh e es hrun hp =>
    change s.stopped = true at hstopped
    rw [hrun] at hstopped
    contradiction
  | toggle r reports hrun hp hq ht hc =>
    change s.stopped = true at hstopped
    rw [hrun] at hstopped
    contradiction
  | stop hrun hp ht =>
    have hh := hs.readout_certificate b K hK s hp ht
    exact ⟨hh.targets,hh.samples,hh.output⟩
end DecrAlmostLinearSSSP.Decremental
