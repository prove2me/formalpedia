theorem balBody_cost (t : IState HS) (P Q : ℕ) (d c : ℤ) (LE LY LB : List Item)
    (hE : t.G KE = .int d :: LE) (hY : t.G KY = .int c :: LY) (hB : t.G KB = .int (2 ^ P) :: LB)
    (hd : 0 ≤ d ∧ d < 2 ^ P) (hc : c = 0 ∨ c = 1) (hPQ : P ≤ Q) :
    balBody.cost t ≤ 80000 * (Q + 5) := by
  set X : ℤ := 2 ^ P with hX
  have hX1 : 1 ≤ X := one_le_pow₀ (by norm_num)
  have hX8 : (2 : ℤ) ^ (P + 3) = 8 * X := by rw [hX]; ring
  simp only [balBody, RS.seqL, RS.cost]
  have h1 := RS.pushCost_le_lin (.sel balCnd (.add balT (.neg (.reg KB))) balT) t (Q + 3)
    (by simp [balCnd, balT, Ex.Lin]) (by
      simp only [Ex.Bnd, balCnd, balT, Ex.eval, IState.top, hE, hY, hB]
      split_ifs <;> (repeat' apply And.intro) <;>
        exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega))
  set t1 := (RS.push KG (.sel balCnd (.add balT (.neg (.reg KB))) balT)).run t with ht1
  have e1 : t1.G KE = .int d :: LE := by simp +decide [ht1, RS.run, IState.upd_G, hE]
  have e2 : t1.G KY = .int c :: LY := by simp +decide [ht1, RS.run, IState.upd_G, hY]
  have e3 : t1.G KB = .int X :: LB := by simp +decide [ht1, RS.run, IState.upd_G, hB]
  have h2 := RS.asgCost_le_lin KY (.sel balCnd (.lit 1) (.lit 0)) t1 (Q + 3)
    (by simp [balCnd, balT, Ex.Lin]) (by
      simp only [Ex.Bnd, balCnd, balT, Ex.eval, IState.top, e1, e2, e3]
      split_ifs <;> (repeat' apply And.intro) <;>
        exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega))
    (by simp only [IState.top, e2]
        exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega))
  have h3 : zsz (((RS.asg KY (.sel balCnd (.lit 1) (.lit 0))).run t1).top KE) ≤ Q + 3 := by
    simp +decide only [RS.run, IState.top, IState.upd_G, e1, if_false]
    exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega)
  have s1 : (Ex.sel balCnd (.add balT (.neg (.reg KB))) balT).size = 22 := rfl
  have s2 : (Ex.sel balCnd (.lit 1) (.lit 0)).size = 15 := rfl
  rw [s1] at h1; rw [s2] at h2
  omega

theorem foldBody_cost (t : IState HS) (P Q : ℕ) (a b c d : ℤ) (L₁ L₂ L₃ L₄ : List Item)
    (h1 : t.G KQ1 = .int a :: L₁) (h2 : t.G KQ2 = .int b :: L₂) (h3 : t.G KQ3 = .int c :: L₃)
    (h4 : t.G KQ4 = .int d :: L₄) (ha : |a| ≤ 2 ^ P) (hb : |b| ≤ 2 ^ P) (hc : |c| ≤ 2 ^ P)
    (hd : |d| ≤ 2 ^ P) (hPQ : P ≤ Q) :
    foldBody.cost t ≤ 40000 * (Q + 5) := by
  set X : ℤ := 2 ^ P with hX
  have hX1 : 1 ≤ X := one_le_pow₀ (by norm_num)
  have hX8 : (2 : ℤ) ^ (P + 3) = 8 * X := by rw [hX]; ring
  rw [abs_le] at ha hb hc hd
  simp only [foldBody, RS.seqL, RS.cost]
  have k1 := RS.pushCost_le_lin (.add (.reg KQ3) (.reg KQ4)) t (Q + 3) ⟨trivial, trivial⟩ (by
    simp only [Ex.Bnd, Ex.eval, IState.top, h3, h4]
    (repeat' apply And.intro) <;>
      exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega))
  set t1 := (RS.push KO (.add (.reg KQ3) (.reg KQ4))).run t with ht1
  have k2 := RS.pushCost_le_lin (.add (.reg KQ1) (.reg KQ2)) t1 (Q + 3) ⟨trivial, trivial⟩ (by
    simp +decide only [Ex.Bnd, Ex.eval, IState.top, ht1, RS.run, IState.upd_G, if_false, h1, h2]
    (repeat' apply And.intro) <;>
      exact le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega))
  have za : zsz a ≤ Q + 3 :=
    le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega)
  have zb : zsz b ≤ Q + 3 :=
    le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega)
  have zc : zsz c ≤ Q + 3 :=
    le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega)
  have zd : zsz d ≤ Q + 3 :=
    le_trans (zsz_le_of_abs (by rw [hX8, abs_lt]; constructor <;> omega)) (by omega)
  simp only [Ex.size] at k1 k2
  have f1 : t1.G KQ1 = .int a :: L₁ := by simp +decide [ht1, RS.run, IState.upd_G, h1]
  have f2 : t1.G KQ2 = .int b :: L₂ := by simp +decide [ht1, RS.run, IState.upd_G, h2]
  have f3 : t1.G KQ3 = .int c :: L₃ := by simp +decide [ht1, RS.run, IState.upd_G, h3]
  have f4 : t1.G KQ4 = .int d :: L₄ := by simp +decide [ht1, RS.run, IState.upd_G, h4]
  simp +decide only [RS.run, IState.top, IState.upd_G, if_false, if_true, ← ht1]
  simp only [f1, f2, f3, f4, List.tail_cons]
  omega

theorem zsz_01 {c : ℤ} (h : c = 0 ∨ c = 1) : zsz c ≤ 1 := by
  rcases h with rfl | rfl
  · simp [zsz_zero]
  · simp [zsz_one]

theorem balPass_cost (s : IState HS) (P Q : ℕ) (dl : List ℤ) (RE LB LR : List Item) (r : ℕ)
    (hE : s.G KE = ints dl ++ RE) (hB : s.G KB = .int (2 ^ P) :: LB) (hR : s.G KR = .int r :: LR)
    (hn : fourR.eval s = dl.length) (hd : ∀ d ∈ dl, 0 ≤ d ∧ d < 2 ^ P) (hPQ : P ≤ Q)
    (hrQ : zsz (r : ℤ) ≤ Q) :
    balPass.cost s ≤ 10000 * (Q + 5) + dl.length * (90000 * (Q + 5)) := by
  have hst := balPass_states s (2 ^ P) dl RE LB hE hB hn
  have hn' : fourR.eval (s.upd KY (.int 0 :: s.G KY)) = fourR.eval s := by
    simp +decide [fourR, Ex.eval, IState.top, IState.upd_G]
  have e : (RS.push KY (.lit 0)).run s = s.upd KY (.int 0 :: s.G KY) := by
    simp [RS.run, Ex.eval]
  have hc : balPass.cost s = (RS.push KY (.lit 0)).cost s +
      ((RS.rep KC fourR balBody).cost ((RS.push KY (.lit 0)).run s) +
        (RS.pop KY).cost ((RS.rep KC fourR balBody).run ((RS.push KY (.lit 0)).run s))) := rfl
  have c1 : (RS.push KY (.lit 0)).cost s = 103 := by
    simp [RS.cost, Ex.cost, Ex.eval, zsz_zero, moveCost]
  rw [hc, c1, e, hst.run]
  have hrep := hst.cost_le_lin (Q + 3) (80000 * (Q + 5)) fourR_lin
    (fourR_bnd _ r Q LR (by simp +decide [IState.upd_G, hR]) hrQ) (by
      intro k hk
      rw [hn', hn] at hk
      have hk' : k < dl.length := by simpa using hk
      obtain ⟨d, rest, hdr⟩ : ∃ d rest, dl.drop k = d :: rest :=
        ⟨_, _, List.drop_eq_getElem_cons hk'⟩
      have hdm : d ∈ dl := List.mem_of_mem_drop (by rw [hdr]; simp)
      exact balBody_cost _ P Q d (bcar (2 ^ P) (dl.take k) 0) (ints rest ++ RE) (s.G KY) LB
        (by simp +decide [withCtr, balSt, IState.upd_G, hdr])
        (by simp +decide [withCtr, balSt, IState.upd_G])
        (by simp +decide [withCtr, balSt, IState.upd_G, hB]) (hd d hdm)
        (bcar_01 _ _ _ (Or.inl rfl)) hPQ)
  rw [hn', hn, Int.toNat_natCast, fourR_size] at hrep
  have hy : zsz ((balSt s (2 ^ P) dl RE (fourR.eval (s.upd KY (.int 0 :: s.G KY))).toNat).top KY)
      ≤ 1 := by
    simp +decide only [balSt, IState.top, IState.upd_G, if_true]
    exact zsz_01 (bcar_01 _ _ _ (Or.inl rfl))
  rw [show ∀ X, (RS.pop KY).cost X = 2 * zsz (X.top KY) + 2 from fun _ => rfl]
  nlinarith

theorem foldPass_cost (s : IState HS) (P Q r : ℕ) (q₁ q₂ q₃ q₄ : List ℤ)
    (R₁ R₂ R₃ R₄ LR : List Item)
    (h1 : s.G KQ1 = ints q₁ ++ R₁) (h2 : s.G KQ2 = ints q₂ ++ R₂) (h3 : s.G KQ3 = ints q₃ ++ R₃)
    (h4 : s.G KQ4 = ints q₄ ++ R₄) (hR : s.G KR = .int r :: LR) (l1 : q₁.length = r)
    (l2 : q₂.length = r) (l3 : q₃.length = r) (l4 : q₄.length = r)
    (hb : ∀ q ∈ [q₁, q₂, q₃, q₄], ∀ y ∈ q, |y| ≤ 2 ^ P) (hPQ : P ≤ Q) (hrQ : zsz (r : ℤ) ≤ Q) :
    foldPass.cost s ≤ 10000 * (Q + 5) + r * (50000 * (Q + 5)) := by
  have hst := foldPass_states s r q₁ q₂ q₃ q₄ R₁ R₂ R₃ R₄ LR h1 h2 h3 h4 hR l1 l2 l3 l4
  have hev : (Ex.eval s (.reg KR)).toNat = r := by simp [Ex.eval, IState.top, hR]
  have hrep := hst.cost_le_lin (Q + 3) (40000 * (Q + 5)) trivial
    (by simp only [Ex.Bnd, IState.top, hR]; omega) (by
      intro k hk
      rw [hev] at hk
      have g : ∀ q : List ℤ, q ∈ [q₁, q₂, q₃, q₄] → |q.getD k 0| ≤ 2 ^ P := by
        intro q hq
        rcases Nat.lt_or_ge k q.length with hk' | hk'
        · rw [List.getD_eq_getElem _ _ hk']; exact hb q hq _ (List.getElem_mem _)
        · rw [List.getD_eq_default _ _ hk']; simp
      exact foldBody_cost _ P Q (q₁.getD k 0) (q₂.getD k 0) (q₃.getD k 0) (q₄.getD k 0)
        (ints (q₁.drop (k + 1)) ++ R₁) (ints (q₂.drop (k + 1)) ++ R₂) (ints (q₃.drop (k + 1)) ++ R₃)
        (ints (q₄.drop (k + 1)) ++ R₄)
        (by simp +decide only [withCtr, foldSt, IState.upd_G, drop_getD_cons q₁ k (by omega),
          if_true, if_false, ints_cons, List.cons_append])
        (by simp +decide only [withCtr, foldSt, IState.upd_G, drop_getD_cons q₂ k (by omega),
          if_true, if_false, ints_cons, List.cons_append])
        (by simp +decide only [withCtr, foldSt, IState.upd_G, drop_getD_cons q₃ k (by omega),
          if_true, if_false, ints_cons, List.cons_append])
        (by simp +decide only [withCtr, foldSt, IState.upd_G, drop_getD_cons q₄ k (by omega),
          if_true, if_false, ints_cons, List.cons_append])
        (g _ (by simp)) (g _ (by simp)) (g _ (by simp)) (g _ (by simp)) hPQ)
  rw [hev] at hrep
  simp only [foldPass, Ex.size] at hrep ⊢
  nlinarith

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul IntMul.HvdH IntMul.HvdH.Ref
set_option maxHeartbeats 4000000
theorem solution (M : MulSpec) (s : IState HS) (P r Q : ℕ) (hP : 1 ≤ P) (z : ℤ) (hz : 0 ≤ z)
    (hzF : z < 2 ^ (4 * r * P) + 1) (LZ LB LN LR : List Item)
    (hZ : s.G KZ = .int z :: LZ) (hB : s.G KB = .int (2 ^ P) :: LB)
    (hN : s.G KN = .int (2 ^ (4 * r * P)) :: LN) (hR : s.G KR = .int r :: LR)
    (hPQ : P ≤ Q) (hrQ : zsz (r : ℤ) ≤ Q) :
    decP.cost M s ≤ 1000000 * (r + 1) * (Q + 5) + 200000 * (r * P + 1) := by
  -- the asg
  have hN8 : (2 : ℤ) ^ (4 * r * P + 3) = 8 * 2 ^ (4 * r * P) := by ring
  have hNpos : (1 : ℤ) ≤ 2 ^ (4 * r * P) := one_le_pow₀ (by norm_num)
  have c1 : (NLogN.RS.asg NLogN.KZ NLogN.decXE).cost s ≤ 14 * 2000 * (4 * r * P + 3 + 2) := by
    have := NLogN.RS.asgCost_le_lin NLogN.KZ NLogN.decXE s (4 * r * P + 3) (by simp [NLogN.decXE, NLogN.Ex.Lin]) (by
      simp only [NLogN.decXE, NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top, hZ, hN]
      split_ifs <;> (repeat' apply And.intro) <;>
        exact NLogN.zsz_le_of_abs (by rw [hN8, abs_lt]; constructor <;> omega))
      (by simp only [NLogN.IState.top, hZ]; exact NLogN.zsz_le_of_abs (by rw [hN8, abs_lt]; constructor <;> omega))
    exact this
  set N : ℤ := 2 ^ (4 * r * P) with hNdef
  have hN0 : 0 ≤ N := by positivity
  set x := NLogN.decX N z with hx
  have hx0 : 0 ≤ x := NLogN.decX_nonneg N z hN0 hz
  set xn := x.toNat with hxn
  have hxx : (xn : ℤ) = x := Int.toNat_of_nonneg hx0
  simp only [NLogN.decP, NLogN.RM.seqL, NLogN.RM.cost, NLogN.RM.run_seq, NLogN.RM.run_rs]
  -- step 1
  have e1 : (NLogN.RS.asg NLogN.KZ NLogN.decXE).run s = s.upd NLogN.KZ (.int (xn : ℤ) :: LZ) := by
    simp only [NLogN.RS.run, NLogN.decXE_eval s N z LZ LN hZ hN, hZ, List.tail_cons, ← hx, hxx]
  rw [e1]
  set s1 := s.upd NLogN.KZ (.int (xn : ℤ) :: LZ) with hs1
  have f1 : NLogN.fourR.eval s1 = ((4 * r : ℕ) : ℤ) :=
    NLogN.fourR_eval s1 r LR (by simp +decide [hs1, NLogN.IState.upd_G, hR])
  -- step 2
  rw [NLogN.chunkP_run NLogN.KZ NLogN.KB NLogN.KD NLogN.KC NLogN.fourR s1 P xn LZ LB (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by simp [hs1]) (by simp +decide [hs1, NLogN.IState.upd_G, hB])
    (by rw [f1]; omega), f1, Int.toNat_natCast]
  set ch := chunksL P (4 * r) xn with hch
  have hchl : ch.length = 4 * r := NLogN.length_chunksL _ _ _
  -- step 3
  set s3 := (s1.upd NLogN.KZ LZ).upd NLogN.KD (NLogN.ints ch.reverse ++ s1.G NLogN.KD) with hs3
  have e3 : (NLogN.RS.pop NLogN.KZ).run (NLogN.chunkSt NLogN.KZ NLogN.KD s1 P xn LZ (4 * r)) = s3 := by
    simp only [NLogN.chunkSt, NLogN.RS.run, hs3, ← hch]
    simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_upd_same, if_true, if_false, List.tail_cons]
    rw [NLogN.IState.upd_comm _ (show NLogN.KD ≠ NLogN.KZ by decide), NLogN.IState.upd_upd_same]
  rw [e3]
  have f3 : NLogN.fourR.eval s3 = ((4 * r : ℕ) : ℤ) :=
    NLogN.fourR_eval s3 r LR (by simp +decide [hs3, hs1, NLogN.IState.upd_G, hR])
  rw [NLogN.mvList_run NLogN.KD NLogN.KE NLogN.KC NLogN.fourR s3 ch.reverse (s.G NLogN.KD) (by decide) (by decide) (by decide)
    (by simp +decide [hs3, hs1, NLogN.IState.upd_G]) (by rw [f3, List.length_reverse, hchl]),
    List.reverse_reverse]
  set s4 := (s3.upd NLogN.KD (s.G NLogN.KD)).upd NLogN.KE (NLogN.ints ch ++ s3.G NLogN.KE) with hs4
  -- step 4
  rw [NLogN.balPass_run s4 (2 ^ P) ch (s.G NLogN.KE) LB (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G, hB])
    (by rw [NLogN.fourR_eval s4 r LR (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G, hR]), hchl])]
  set dg := NLogN.balConv (2 ^ P) ch 0 with hdg
  have hdg' : dg = kunpack (2 ^ P) (4 * r) (balMod (N + 1) z) := by
    rw [hdg, hch, hxn, hx, hNdef, NLogN.kunpack_decX P r hP z hz hzF]
  have hdgl : dg.length = 4 * r := by rw [hdg', NLogN.length_kunpack]
  have hq := NLogN.kunpack_quarters dg r
  set q₁ := dg.take r
  set q₂ := (dg.drop r).take r
  set q₃ := (dg.drop (2 * r)).take r
  set q₄ := dg.drop (3 * r)
  have l1 : q₁.length = r := by simp [q₁, hdgl]; omega
  have l2 : q₂.length = r := by simp [q₂, hdgl]; omega
  have l3 : q₃.length = r := by simp [q₃, hdgl]; omega
  have l4 : q₄.length = r := by simp [q₄, hdgl]; omega
  set s5 := (s4.upd NLogN.KE (s.G NLogN.KE)).upd NLogN.KG (NLogN.ints dg.reverse ++ s4.G NLogN.KG) with hs5
  have rR : ∀ t : NLogN.IState NLogN.HS, t.G NLogN.KR = .int r :: LR → NLogN.Ex.eval t (.reg NLogN.KR) = (r : ℤ) := by
    intro t ht; simp [NLogN.Ex.eval, NLogN.IState.top, ht]
  -- step 5: quarters
  rw [NLogN.mvList_run NLogN.KG NLogN.KQ4 NLogN.KC (.reg NLogN.KR) s5 q₄.reverse
    (NLogN.ints (q₃.reverse ++ q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hq, NLogN.ints_append]; try rfl)
    (by rw [rR _ (by simp +decide [hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]), List.length_reverse, l4]),
    List.reverse_reverse]
  set s6 := (s5.upd NLogN.KG (NLogN.ints (q₃.reverse ++ q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG)).upd NLogN.KQ4
    (NLogN.ints q₄ ++ s5.G NLogN.KQ4) with hs6
  rw [NLogN.mvList_run NLogN.KG NLogN.KQ3 NLogN.KC (.reg NLogN.KR) s6 q₃.reverse
    (NLogN.ints (q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs6, NLogN.IState.upd_G, NLogN.ints_append])
    (by rw [rR _ (by simp +decide [hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]), List.length_reverse,
      l3]), List.reverse_reverse]
  set s7 := (s6.upd NLogN.KG (NLogN.ints (q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG)).upd NLogN.KQ3
    (NLogN.ints q₃ ++ s6.G NLogN.KQ3) with hs7
  rw [NLogN.mvList_run NLogN.KG NLogN.KQ2 NLogN.KC (.reg NLogN.KR) s7 q₂.reverse
    (NLogN.ints q₁.reverse ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs7, NLogN.IState.upd_G, NLogN.ints_append])
    (by rw [rR _ (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]),
      List.length_reverse, l2]), List.reverse_reverse]
  set s8 := (s7.upd NLogN.KG (NLogN.ints q₁.reverse ++ s.G NLogN.KG)).upd NLogN.KQ2 (NLogN.ints q₂ ++ s7.G NLogN.KQ2) with hs8
  rw [NLogN.mvList_run NLogN.KG NLogN.KQ1 NLogN.KC (.reg NLogN.KR) s8 q₁.reverse (s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs8, NLogN.IState.upd_G])
    (by rw [rR _ (by simp +decide [hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]),
      List.length_reverse, l1]), List.reverse_reverse]
  set s9 := (s8.upd NLogN.KG (s.G NLogN.KG)).upd NLogN.KQ1 (NLogN.ints q₁ ++ s8.G NLogN.KQ1) with hs9
  have hP1 : (2 : ℤ) ^ P < 2 ^ (P + 1) := pow_lt_pow_right₀ (by norm_num) (by omega)
  have hchB : ∀ d ∈ ch, 0 ≤ d ∧ d < 2 ^ P := NLogN.chunksL_bound _ _ _
  have hdgB : ∀ y ∈ dg, |y| ≤ 2 ^ P :=
    NLogN.balConv_bound _ (by positivity) ch 0 hchB (Or.inl rfl)
  have zdg : ∀ y ∈ dg, NLogN.zsz y ≤ Q + 3 := fun y hy =>
    le_trans (NLogN.zsz_le_of_abs (lt_of_le_of_lt (hdgB y hy) hP1)) (by omega)
  have zch : ∀ y ∈ ch.reverse, NLogN.zsz y ≤ Q + 3 := fun y hy => by
    have h := hchB y (List.mem_reverse.1 hy)
    exact le_trans (NLogN.zsz_le_of_abs (m := P) (by rw [abs_lt]; constructor <;> omega)) (by omega)
  have m1 : ∀ y ∈ q₁, y ∈ dg := fun y hy => List.mem_of_mem_take hy
  have m2 : ∀ y ∈ q₂, y ∈ dg := fun y hy => List.mem_of_mem_drop (List.mem_of_mem_take hy)
  have m3 : ∀ y ∈ q₃, y ∈ dg := fun y hy => List.mem_of_mem_drop (List.mem_of_mem_take hy)
  have m4 : ∀ y ∈ q₄, y ∈ dg := fun y hy => List.mem_of_mem_drop hy
  have zR : ∀ t : NLogN.IState NLogN.HS, t.G NLogN.KR = .int r :: LR → (NLogN.Ex.reg NLogN.KR).Bnd t (Q + 3) := by
    intro t ht; simp only [NLogN.Ex.Bnd, NLogN.IState.top, ht]; omega
  have c2 := NLogN.chunkP_cost M NLogN.KZ NLogN.KB NLogN.KD NLogN.KC NLogN.fourR s1 P xn LZ LB (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by simp [hs1]) (by simp +decide [hs1, NLogN.IState.upd_G, hB])
    (by rw [f1]; omega) (Q + 3) NLogN.fourR_lin
    (NLogN.fourR_bnd s1 r Q LR (by simp +decide [hs1, NLogN.IState.upd_G, hR]) hrQ)
  rw [f1, Int.toNat_natCast, NLogN.fourR_size] at c2
  have c3 : (NLogN.RS.pop NLogN.KZ).cost (NLogN.chunkSt NLogN.KZ NLogN.KD s1 P xn LZ (4 * r)) ≤ 2 * (4 * r * P + 3) + 2 := by
    show 2 * NLogN.zsz _ + 2 ≤ _
    simp +decide only [NLogN.chunkSt, NLogN.IState.top, NLogN.IState.upd_G, if_true, if_false]
    have h1 : xn / 2 ^ (P * (4 * r)) ≤ xn := Nat.div_le_self _ _
    have h2 : x ≤ z := by rw [hx]; unfold NLogN.decX; split_ifs <;> omega
    have h3 : (((xn / 2 ^ (P * (4 * r)) : ℕ) : ℤ)) ≤ xn := by exact_mod_cast h1
    have h4 : (0 : ℤ) ≤ ((xn / 2 ^ (P * (4 * r)) : ℕ) : ℤ) := by positivity
    have : NLogN.zsz (((xn / 2 ^ (P * (4 * r)) : ℕ) : ℤ)) ≤ 4 * r * P + 3 :=
      NLogN.zsz_le_of_abs (by rw [hN8, abs_lt]; constructor <;> omega)
    omega
  have c4 := NLogN.mvList_cost NLogN.KD NLogN.KE NLogN.KC NLogN.fourR s3 ch.reverse (s.G NLogN.KD) (by decide) (by decide) (by decide)
    (by simp +decide [hs3, hs1, NLogN.IState.upd_G]) (by rw [f3, List.length_reverse, hchl])
    (Q + 3) NLogN.fourR_lin (NLogN.fourR_bnd s3 r Q LR (by simp +decide [hs3, hs1, NLogN.IState.upd_G, hR]) hrQ) zch
  rw [List.length_reverse, hchl, NLogN.fourR_size] at c4
  have c5 := NLogN.balPass_cost s4 P Q ch (s.G NLogN.KE) LB LR r (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G, hB])
    (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G, hR])
    (by rw [NLogN.fourR_eval s4 r LR (by simp +decide [hs4, hs3, hs1, NLogN.IState.upd_G, hR]), hchl])
    hchB hPQ hrQ
  rw [hchl] at c5
  have c6 := NLogN.mvList_cost NLogN.KG NLogN.KQ4 NLogN.KC (.reg NLogN.KR) s5 q₄.reverse
    (NLogN.ints (q₃.reverse ++ q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hq, NLogN.ints_append]; try rfl)
    (by rw [rR _ (by simp +decide [hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]), List.length_reverse, l4])
    (Q + 3) trivial (zR _ (by simp +decide [hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]))
    (fun y hy => zdg y (m4 y (List.mem_reverse.1 hy)))
  have c7 := NLogN.mvList_cost NLogN.KG NLogN.KQ3 NLogN.KC (.reg NLogN.KR) s6 q₃.reverse
    (NLogN.ints (q₂.reverse ++ q₁.reverse) ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs6, NLogN.IState.upd_G, NLogN.ints_append])
    (by rw [rR _ (by simp +decide [hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]),
      List.length_reverse, l3])
    (Q + 3) trivial (zR _ (by simp +decide [hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]))
    (fun y hy => zdg y (m3 y (List.mem_reverse.1 hy)))
  have c8 := NLogN.mvList_cost NLogN.KG NLogN.KQ2 NLogN.KC (.reg NLogN.KR) s7 q₂.reverse
    (NLogN.ints q₁.reverse ++ s.G NLogN.KG) (by decide) (by decide) (by decide)
    (by simp +decide [hs7, NLogN.IState.upd_G, NLogN.ints_append])
    (by rw [rR _ (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]),
      List.length_reverse, l2])
    (Q + 3) trivial (zR _ (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]))
    (fun y hy => zdg y (m2 y (List.mem_reverse.1 hy)))
  have c9 := NLogN.mvList_cost NLogN.KG NLogN.KQ1 NLogN.KC (.reg NLogN.KR) s8 q₁.reverse (s.G NLogN.KG) (by decide) (by decide)
    (by decide) (by simp +decide [hs8, NLogN.IState.upd_G])
    (by rw [rR _ (by simp +decide [hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]),
      List.length_reverse, l1])
    (Q + 3) trivial (zR _ (by simp +decide [hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]))
    (fun y hy => zdg y (m1 y (List.mem_reverse.1 hy)))
  rw [List.length_reverse, l4] at c6
  rw [List.length_reverse, l3] at c7
  rw [List.length_reverse, l2] at c8
  rw [List.length_reverse, l1] at c9
  have c10 := NLogN.foldPass_cost s9 P Q r q₁ q₂ q₃ q₄ (s.G NLogN.KQ1) (s.G NLogN.KQ2) (s.G NLogN.KQ3) (s.G NLogN.KQ4) LR
    (by simp +decide [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G])
    (by simp +decide [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs1, NLogN.IState.upd_G, hR]) l1 l2 l3 l4
    (by
      intro q hq y hy
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl | rfl
      · exact hdgB y (m1 y hy)
      · exact hdgB y (m2 y hy)
      · exact hdgB y (m3 y hy)
      · exact hdgB y (m4 y hy))
    hPQ hrQ
  simp only [NLogN.Ex.size, NLogN.splitCost, NLogN.moveCost, NLogN.takeCost] at c2 c4 c6 c7 c8 c9
  nlinarith
end
