  have hsl : ∀ y < D * qq ℓ K, NLogN.KFV.srcP D ℓ K y < D * qq ℓ K := fun y hy => srcP_lt D ℓ K hy
  have hinj : ∀ a < D * qq ℓ K, ∀ b < D * qq ℓ K, NLogN.KFV.srcP D ℓ K a = NLogN.KFV.srcP D ℓ K b → a = b :=
