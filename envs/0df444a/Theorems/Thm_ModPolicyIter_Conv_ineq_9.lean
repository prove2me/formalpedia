-- name    : ModPolicyIter.Conv.ineq_9
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-06T14:15:09.147589+00:00
-- url     : https://prove2.me/theorems/b809fb26-9494-4b0a-907e-6adbcdcd6de5
-- title:
--   (9), p. 1132 — ‖v* − v_{n+1}‖ ≤ (λ[1 − λ^k]/(1 − λ)‖P_n − P*‖ + λ^{k+1})‖v* − v_n‖
-- statement:
--   Throughout, $S$ is a set of states with a $\sigma$-algebra; each policy $P\in\mathcal P$ is a Markov transition kernel on $S$ with a measurable one-period reward $c_P$, $\sup_P\sup_s|c_P(s)|\le M$; $0\le\lambda<1$; $V$ is the space of bounded measurable functions with $\|v\|=\sup_s|v(s)|$; and the maximum in $Bv=\max_P\{c_P+(\lambda P-I)v\}$ is attained for every $v\in V$, a maximizer being written $P_v$.
--
--   Let $k\ge 0$ and let $\{v_n\}$ be generated by modified policy iteration of order $k$, recursion (4): $v_{n+1}=v_n+A^k_{P_n}Bv_n$ with $A^k_P=\sum_{i=0}^k(\lambda P)^i$, where $P_n$ attains the maximum in (1) at $v_n$. Assume $v_0\in V$ and $Bv_0\ge 0$. Let $v^*\in V$ satisfy $Bv^*=0$ and let $P^*=P_{v^*}$ be a policy attaining the maximum in (1) at $v^*$.
--
--   Then for every $n\ge 0$
--
--   $$\|v^*-v_{n+1}\|\ \le\ \Big(\frac{\lambda[1-\lambda^k]}{1-\lambda}\,\|P_n-P^*\|+\lambda^{k+1}\Big)\,\|v^*-v_n\|,$$
--
--   where $\|P_n-P^*\|$ is the operator norm on $V$. This is the policy-dependent half of the rate bound (8); its constant tends to $\lambda^{k+1}$ when the policies settle on $P^*$.
--
--   **Formalization Note** The policies are indexed by a type $\iota$ (policy $i$ is a pair of a Markov kernel and a measurable reward), $V$ is encoded by the predicate `IsBM` and $\|\cdot\|$ by `supNorm`. The run is a pair of sequences `v : ℕ → S → ℝ`, `pol : ℕ → ι` in which `pol n` attains the maximum at `v n`. The hypothesis $Bv_0\ge 0$ is Theorem 1's; the paper's proof of Theorem 2 uses it through Theorem 1 ($v_n\le v^*$).
-- source:
--   Puterman and Shin, Modified policy iteration algorithms for discounted Markov decision problems, Management Science 24 (1978), DOI 10.1287/mnsc.24.11.1127, p. 1132, (9) in the proof of Theorem 2

import Mathlib
import Definitions.Def_ModPolicyIter_Conv_Setting

open MeasureTheory ProbabilityTheory

namespace ModPolicyIter.Conv

/-- Inequality (9) (Puterman–Shin 1978, proof of Theorem 2, p. 1132): for the run (4) of order
`k` from `v₀` with `Bv₀ ≥ 0`, a solution `v*` of `Bv* = 0` and a maximizer `P*` at `v*`,
`‖v* − v_{n+1}‖ ≤ (λ[1 − λ^k]/(1 − λ) ‖P_n − P*‖ + λ^{k+1}) ‖v* − v_n‖`. -/
theorem ineq_9 {S : Type*} [MeasurableSpace S] {ι : Type*} (m : Model S ι)
    (hmax : MaxAttained m) (k : ℕ) (v : ℕ → S → ℝ) (pol : ℕ → ι)
    (hrun : IsRun m k v pol) (hv0 : IsBM (v 0)) (hB0 : ∀ s, 0 ≤ B m (v 0) s)
    (vstar : S → ℝ) (hvstar : IsBM vstar) (hBstar : ∀ s, B m vstar s = 0)
    (Pstar : ι) (hPstar : Attains m vstar Pstar) :
    ∀ n, supNorm (vstar - v (n + 1)) ≤
      (m.lam * (1 - m.lam ^ k) / (1 - m.lam) * opNormDiff m (pol n) Pstar + m.lam ^ (k + 1)) *
        supNorm (vstar - v n) := by sorry

end ModPolicyIter.Conv
