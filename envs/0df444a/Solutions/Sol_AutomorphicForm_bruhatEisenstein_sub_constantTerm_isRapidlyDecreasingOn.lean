              * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i))
          * (psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w) + y)))
              * c i (angle (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w) + y))) := by
  rw [slice_eq hw hφ x (a + E y), ringEquiv_fst_translate hw a hEw y, awayFrom_translate a hEv hE2 x y,
    hexp, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

private theorem iteratedDeriv_sum_const_mul_shift {m : ℕ} (F₀ : Fin m → ℂ) (mf : Fin m → ℝ → ℂ)
    (hm : ∀ i, ContDiff ℝ ∞ (mf i)) (n : ℕ) (u₀ y : ℝ) :
    iteratedDeriv n (fun y => ∑ i, F₀ i * mf i (u₀ + y)) y = ∑ i, F₀ i * iteratedDeriv n (mf i) (u₀ + y) := by
  have hsh : ∀ i, ContDiff ℝ ∞ (fun y => mf i (u₀ + y)) := fun i => (hm i).comp (contDiff_const.add contDiff_id)
  have hle : (n : ℕ∞ω) ≤ ∞ := by exact_mod_cast le_top
  rw [iteratedDeriv_fun_sum (fun i _ => ((contDiff_const.mul (hsh i)).of_le hle).contDiffAt)]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [iteratedDeriv_const_mul (F₀ i) (((hsh i).of_le hle).contDiffAt), iteratedDeriv_comp_const_add n (mf i) u₀]

private theorem exists_uniform_coeff_bound {m : ℕ} {c : Fin m → ℝ → ℂ}
    (h : ∀ (i : Fin m) (j : ℕ), ∃ C, ∀ θ : ℝ, ‖iteratedDeriv j (c i) θ‖ ≤ C) (n : ℕ) :
    ∃ Cc, 0 ≤ Cc ∧ ∀ i, ∀ j, j ≤ n → ∀ θ : ℝ, ‖iteratedDeriv j (c i) θ‖ ≤ Cc := by
  choose C hC using h
  refine ⟨∑ i, ∑ j ∈ Finset.range (n + 1), max (C i j) 0, by positivity, fun i j hj θ => ?_⟩
  calc ‖iteratedDeriv j (c i) θ‖ ≤ max (C i j) 0 := (hC i j θ).trans (le_max_left _ _)
    _ ≤ ∑ j ∈ Finset.range (n + 1), max (C i j) 0 :=
        Finset.single_le_sum (f := fun j => max (C i j) 0) (fun _ _ => le_max_right _ _)
          (Finset.mem_range.2 (Nat.lt_succ_of_le hj))
    _ ≤ ∑ i, ∑ j ∈ Finset.range (n + 1), max (C i j) 0 :=
        Finset.single_le_sum (f := fun i => ∑ j ∈ Finset.range (n + 1), max (C i j) 0)
          (fun _ _ => Finset.sum_nonneg fun _ _ => le_max_right _ _) (Finset.mem_univ i)

end Slice
