-- Source module: Solutions.KFNNode
/-!
# KFN: one node of the recursive `C`-layer

A node runs the steps of an interface `J : Prop8IfaceR W m s` on `W` role streams of `n`
records; its bits are `Fin m × κ` (rows × the bits of a child), at record strides `st`.

* **`sImpl_node`**: implementations of the steps compose to an implementation of `tens Cm`
  on the `W · n` records (`rImpl_list`, `J.correct`, `sImpl_of_rImpl_roleDiag`).
* Step builders on power-of-two strides `st p = 2^{pos p} · S₀` (`n = B · 2^t · S₀`):
  `rImpl_phaseStep` (phase pass on one role), `rImpl_fixG` (a `±1` role diagonal as a list of
  phase steps), `rImpl_rowStep` (a row addition from any single-stream implementation),
  `rImpl_childStep` (forward child from an implementation of the child, the inverse child via
  `tens Cinv = (-i)^{|κ|} ZD · tens Cm · ZD`, `sImpl_cinv`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

section Node

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-! ## Phase steps -/

/-- Code of a phase pass with exponents `u + Σ a'_i x_i` on strides `2^{pos i} S₀`. -/
def phC {ι : Type*} [Fintype ι] (pos : ι → ℕ) (S0 r t B u : ℕ) (a' : ι → ℕ) : RS :=
  phL (S0 * r) t B u (aEof pos a')

/-- The phase steps negating the roles of a list. -/
def negSteps (l : List (Fin W)) : List (RStep (Fin W) m) := l.map fun w => RStep.phase w 2 0 0

/-! ## Row additions and child calls -/

/-- The inverse child: `ZD`, then the forward child, then `(-i)^{|κ|} ZD`. -/
def cinvC (pos : κ → ℕ) (S0 r t B : ℕ) (code : ℕ → IStmt HS Pp) (dw : ℕ) : ℕ → IStmt HS Pp :=
  seqI (seqI (fun _ => fcode (phC pos S0 r t B 0 (fun _ => 2))) code 0)
    (fun _ => fcode (phC pos S0 r t B (3 * Fintype.card κ) (fun _ => 2))) (0 + dw)

end Node

end NLogN.KFN

end

section
-- Source module: Solutions.KFNRec
/-!
# KFN: the recursive `C`-layer — local step bounds

Parameters: an interface `J : Prop8IfaceR W m s` whose gates are atom lists (at most `A`
atoms) or `±1` role diagonals (`GClass`), records of `r` entries, a size bound `Z`, and a
monotone "log-size" cost profile `Ψ ≥ Z + 2`.  The row additions are an abstract hypothesis
(`RowHyp`, e.g. Lemma 13): cost `CR · n · (r (w+1) (e+1)^τ + Ψ w)` on `n` records whose rows have
`e` bits.

Unit of cost: `Xf r Ψ v = r (v + 1) + Ψ v` per record at width `v`.

This file: the recursion constants (`Eb` scale, `DWb` width, `Ob` offsets, `Whb` cumulative
widths, `cb` cost coefficients), the per-step cost bounds, and **`step_ok`**: every step of
`J.net` at level `k+1` has an implementation with the bounds, given the level-`k` claim `Lv`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

/-! ## Constants of the recursion -/

/-- Scale bound: the leaf kernel has scale `1`; a node adds `≤ 1` per local step. -/
def Eb (L s : ℕ) : ℕ → ℕ
  | 0 => 1
  | k + 1 => L + s * Eb L s k

/-- Width increase of a local step. -/
def dwloc (W A : ℕ) : ℕ := 3 * A + 3 * W + 2 * W * W + 2 * W

/-- Width bound of a level. -/
def DWb (L s W A : ℕ) : ℕ → ℕ
  | 0 => 2
  | k + 1 => s * (DWb L s W A k + (Eb L s k + 2) * W) + L * dwloc W A

/-- Width offset of the cost arguments inside the steps of level `k+1`. -/
def Ob (L s W A k : ℕ) : ℕ :=
  DWb L s W A k + (Eb L s k + 2) * W + Eb L s k + dwloc W A + 10

/-- Cumulative width offset of a level. -/
def Whb (L s W A : ℕ) : ℕ → ℕ
  | 0 => 2
  | k + 1 => DWb L s W A (k + 1) + Ob L s W A k + Whb L s W A k

/-- The local cost constant. -/
def alN (W A : ℕ) : ℕ := 10000000 * (W + A + 10) ^ 3

/-- Cost coefficients (per record, per unit `Xf`). -/
noncomputable def cb (L s W A m : ℕ) (CR τ : ℝ) : ℕ → ℝ
  | 0 => 100000
  | k + 1 => (s / W : ℝ) * cb L s W A m CR τ k +
      ((s + L : ℕ) : ℝ) * ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) + 1

/-- Cost unit per record. -/
def Xf (r : ℕ) (Ψ : ℕ → ℕ) (v : ℕ) : ℕ := r * (v + 1) + Ψ v

/-! ## Classes and hypotheses -/

/-- The gates of an interface: atom lists (at most `A` atoms) or `±1` role diagonals. -/
def GClass {W m s : ℕ} (J : Prop8IfaceR W m s) (A : ℕ) : Prop :=
  ∀ G, RStep.gate G ∈ J.net →
    (∃ as : List KFG.Atom, as.length ≤ A ∧ (∀ a ∈ as, a.Ok W ∧ a.h ≤ 1) ∧ KFG.NoTS as ∧
        G = KFG.gateMat W as) ∨
      (∃ U : Finset (Fin W), G = Matrix.diagonal fun w => if w ∈ U then -1 else 1)

/-- Positions of the bits of a row family at stride `K` (descending): `pos i + K i = e`, with
the top chunk `[e - e % K, e - e % K + K)` below `t`. -/
def AffK (K t : ℕ) {N : ℕ} (pos : Fin N → ℕ) : Prop :=
  ∃ e, (∀ i, pos i + K * i.val = e) ∧ e - e % K + K ≤ t

/-- The same for `Fin m × Fin (m^k)` (row `a`, bit `b` at index `b + m^k a`). -/
def AffK2 (K t m k : ℕ) (pos : Fin m × Fin (m ^ k) → ℕ) : Prop :=
  ∃ e, (∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) ∧ e - e % K + K ≤ t

/-- **Row additions** (abstract; e.g. Lemma 13): on the stride-`K` layouts of the bits
`Fin m × Fin (m^k)` (`AffK2`), as produced by the layer layout of stride `K`. -/
def RowHyp {Pp : ℕ} (Isym : List Sym) (iprog : Fin Pp → IStmt HS Pp) (K m r Z : ℕ)
    (Ψ : ℕ → ℕ) (CR τ : ℝ) : Prop :=
  ∀ (k : ℕ) (pos : Fin m × Fin (m ^ k) → ℕ) (t S0 B : ℕ), Function.Injective pos →
    (∀ p, pos p < t) → AffK2 K t m k pos → 1 ≤ S0 → 1 ≤ B →
    zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z →
    ∀ (i j : Fin m) (hij : i ≠ j), ∃ (code : ℕ → IStmt HS Pp) (cost : ℕ → ℕ),
      SImplI Isym iprog r (fun p => 2 ^ pos p * S0) (B * 2 ^ t * S0)
        (Pm i j : Butterfly.Op (Fin m × Fin (m ^ k))) code 0 0 cost ∧
      ∀ w, (cost w : ℝ) ≤ CR * ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        ((r : ℝ) * (w + 1) * ((m : ℝ) ^ k + 1) ^ τ + Ψ w)

/-- The level claim: `tens Cm` on `m^k` bits at power-of-two strides. -/
def Lv {Pp : ℕ} (Isym : List Sym) (iprog : Fin Pp → IStmt HS Pp) (K W m r Z : ℕ) (Ψ : ℕ → ℕ)
    (k Ek DWk Wk : ℕ) (ck : ℝ) : Prop :=
  ∀ (pos : Fin (m ^ k) → ℕ) (t S0 B : ℕ), Function.Injective pos → (∀ i, pos i < t) →
    AffK K t pos →
    1 ≤ S0 → 1 ≤ B → W ^ k ∣ B → zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z →
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      SImplI Isym iprog r (fun i => 2 ^ pos i * S0) (B * 2 ^ t * S0) (Butterfly.tens Cm : Butterfly.Op (Fin (m ^ k)))
        code e dw cost ∧ e ≤ Ek ∧ dw ≤ DWk ∧
      ∀ w, (cost w : ℝ) ≤ ck * ((B * 2 ^ t * S0 : ℕ) : ℝ) * (Xf r Ψ (w + Wk) : ℝ)

/-! ## Local cost bounds -/

section LocalBounds

variable {r Z : ℕ} {Ψ : ℕ → ℕ}

end LocalBounds

end NLogN.KFN

end

