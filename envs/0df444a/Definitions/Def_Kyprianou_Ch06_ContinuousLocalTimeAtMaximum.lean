-- title:
--   Definition 6.1: local time at the running maximum
-- statement:
--   A continuous non-decreasing, nonzero local-time clock adapted to the given right-continuous complete filtration is supported exactly on the closure of the times when a Lévy path attains its running maximum. At every finite stopping time that occurs at a maximum, the shifted triple of increments, reflected process and local-time increments is independent of the information available at the stopping time and has the original triple's law. Includes auxiliary constructions of the stopped sigma-algebra and the shifted path.
-- source:
--   Kyprianou (2006), first edition, Definition 6.1, printed pp. 140–141; physical two-up PDF pp. 75–76.

import Mathlib
import Definitions.Def_Kyprianou_Ch06_RunningMaximumAndContact
open MeasureTheory Filter
open scoped NNReal ENNReal
set_option autoImplicit false

namespace Kyprianou.Ch06

/-- A filtration consists of increasing sub-sigma-algebras of ambient events. -/
def IsFiltration
    {Omega : Type} [MeasurableSpace Omega]
    (F : NNReal → MeasurableSpace Omega) : Prop :=
  Monotone F ∧ ∀ t : NNReal, F t ≤ (inferInstance : MeasurableSpace Omega)

/-- Stopping times are allowed to be infinite. -/
def IsStopTime
    {Omega : Type} (F : NNReal → MeasurableSpace Omega)
    (T : Omega → WithTop NNReal) : Prop :=
  ∀ t : NNReal,
    @MeasurableSet Omega (F t) {omega | T omega ≤ (t : WithTop NNReal)}

/-- The sigma-algebra at a stopping time, generated by events whose
restrictions to {T <= t} are observable by time t. -/
noncomputable def InformationAtStop
    {Omega : Type} (F : NNReal → MeasurableSpace Omega)
    (T : Omega → WithTop NNReal) : MeasurableSpace Omega :=
  MeasurableSpace.generateFrom
    {A : Set Omega | ∀ t : NNReal,
       @MeasurableSet Omega (F t)
         (A ∩ {omega | T omega ≤ (t : WithTop NNReal)})}

/-- The trivariate original process (X, reflected process, local time). -/
noncomputable def OriginalLocalTimeTriple
    {Omega : Type} (X : NNReal → Omega → Real)
    (L : NNReal → Omega → NNReal)
    (omega : Omega) : NNReal → Real × Real × NNReal :=
  fun u => (X u omega, drawdown X u omega,
    L u omega - L 0 omega)

/-- The trivariate process shifted to the stopping epoch. Its value on
the event {T = infinity} is irrelevant to stopped conditional laws. -/
noncomputable def ShiftedLocalTimeTriple
    {Omega : Type} (X : NNReal → Omega → Real)
    (L : NNReal → Omega → NNReal)
    (T : Omega → WithTop NNReal)
    (omega : Omega) : NNReal → Real × Real × NNReal :=
  if T omega = ⊤ then fun _ => (0, 0, 0) else
    let start := (T omega).untopD 0
    fun u =>
      (X (start + u) omega - X start omega,
       drawdown X (start + u) omega,
       L (start + u) omega - L start omega)

/-- The stopping-time regeneration condition: conditional on stopping
at a finite moment of maximum contact, the restarted triple has the
original law and is independent of the stopped information sigma-algebra.
The full cylinder-law factorisation is required for each stopped event. -/
def LocalTimeRegeneration
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) (F : NNReal → MeasurableSpace Omega)
    (X : NNReal → Omega → Real) (L : NNReal → Omega → NNReal) : Prop :=
  ∀ T : Omega → WithTop NNReal,
    IsStopTime F T →
    P {omega | T omega ≠ ⊤ ∧
      X ((T omega).untopD 0) omega ≠
        runningMaximum X ((T omega).untopD 0) omega} = 0 →
    ∀ A : Set Omega,
      @MeasurableSet Omega (InformationAtStop F T) A →
      ∀ B : Set (NNReal → Real × Real × NNReal),
        MeasurableSet B →
        P {omega | T omega ≠ ⊤ ∧ omega ∈ A ∧
              ShiftedLocalTimeTriple X L T omega ∈ B} =
          P {omega | T omega ≠ ⊤ ∧ omega ∈ A} *
          P {omega | OriginalLocalTimeTriple X L omega ∈ B}

/-- Definition 6.1: nonzero continuous adapted increasing local-time clock
with support equal to the closure of maximum-contact times, and the
stopping-time independence/regeneration law. -/
def IsContinuousLocalTimeAtMaximum
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (F : NNReal → MeasurableSpace Omega)
    (X : NNReal → Omega → Real)
    (L : NNReal → Omega → NNReal) : Prop :=
  IsFiltration F ∧
  (∀ t : NNReal,
    @Measurable Omega NNReal (F t) inferInstance (L t)) ∧
  (∀ᵐ omega ∂P,
     Continuous (fun t : NNReal => L t omega) ∧
     Monotone (fun t : NNReal => L t omega) ∧
     L 0 omega = 0 ∧
     HasLocalTimeSupportAtMaximum X L omega) ∧
  (∃ t : NNReal, 0 < P {omega | L t omega ≠ 0}) ∧
  LocalTimeRegeneration P F X L

end Kyprianou.Ch06


