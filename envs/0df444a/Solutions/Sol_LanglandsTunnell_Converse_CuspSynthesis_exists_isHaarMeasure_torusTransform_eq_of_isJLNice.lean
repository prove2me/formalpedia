variable [MeasurableSpace (v.adicCompletion K)] [BorelSpace (v.adicCompletion K)] (μ : Measure (v.adicCompletion K))
  [μ.IsAddHaarMeasure]

private theorem t0643 (a : v.adicCompletion K) {n : ℤ} (hn : n ≤ 0) :
    IntegrableOn (fun x => StandardAddChar.psiLocal K v (a * x)) (d067 v n) μ := by
  have hsub : d067 v n ⊆ d067 v 0 := fun x hx =>
    (t0636 v).2 ((t0636 v).1 hx |>.trans (WithZero.exp_le_exp.2 hn))
  refine IntegrableOn.mono_set ?_ hsub
  rw [t0639]
  have hK : IsCompact (v.adicCompletionIntegers K : Set (v.adicCompletion K)) := by
    rw [isCompact_iff_compactSpace]
    exact inferInstanceAs (CompactSpace (v.adicCompletionIntegers K))
  exact ((StandardAddChar.continuous_psiLocal K v).comp (continuous_mul_left a)).continuousOn.integrableOn_compact hK

private theorem t0644 {n : ℤ} (hn : n ≤ 0) : μ (d067 v n) ≠ ⊤ := by
  have hsub : d067 v n ⊆ (v.adicCompletionIntegers K : Set (v.adicCompletion K)) := by
    rw [← t0639]
    exact fun x hx => (t0636 v).2 (((t0636 v).1 hx).trans (WithZero.exp_le_exp.2 hn))
  have hK : IsCompact (v.adicCompletionIntegers K : Set (v.adicCompletion K)) := by
    rw [isCompact_iff_compactSpace]
    exact inferInstanceAs (CompactSpace (v.adicCompletionIntegers K))
  exact ((measure_mono hsub).trans_lt hK.measure_lt_top).ne

private theorem t0645 : μ {x : v.adicCompletion K | Valued.v x = 1} ≠ ⊤ := by
  have hsub : {x : v.adicCompletion K | Valued.v x = 1} ⊆ d067 v 0 := by
    rw [t0640]
    exact Set.subset_union_left
  exact ((measure_mono hsub).trans_lt (lt_top_iff_ne_top.2 (t0644 v μ le_rfl))).ne

private theorem t0646 {a : v.adicCompletion K} {k n : ℤ}
    (ha : Valued.v a ≤ WithZero.exp k) (hkn : k + n ≤ d040 (K := K) v) :
    ∫ x in d067 v n, StandardAddChar.psiLocal K v (a * x) ∂μ = ((μ.real (d067 v n) : ℝ) : ℂ) := by
  have htriv : ∀ x ∈ d067 v n, StandardAddChar.psiLocal K v (a * x) = 1 := by
    intro x hx
    refine (t0360 (K := K) v).1 _ ?_
    rw [Valuation.map_mul]
    calc Valued.v a * Valued.v x ≤ WithZero.exp k * WithZero.exp n := mul_le_mul' ha hx
      _ = WithZero.exp (k + n) := (WithZero.exp_add k n).symm
      _ ≤ WithZero.exp (d040 (K := K) v) := WithZero.exp_le_exp.2 hkn
  rw [setIntegral_congr_fun (t0642 v n) htriv, setIntegral_const, Complex.real_smul, mul_one]

private theorem t0647 {a : v.adicCompletion K} {k n : ℤ}
    (ha : Valued.v a = WithZero.exp k) (hkn : d040 (K := K) v + 1 ≤ k + n) :
    ∫ x in d067 v n, StandardAddChar.psiLocal K v (a * x) ∂μ = 0 := by
  obtain ⟨x₀, hx₀, hne⟩ := (t0360 (K := K) v).2
  have ha0 : a ≠ 0 := by
    intro h
    rw [h, Valuation.map_zero] at ha
    exact WithZero.exp_ne_zero ha.symm
  set u₀ : v.adicCompletion K := a⁻¹ * x₀ with hu₀
  have hu₀mem : u₀ ∈ d067 v n := by
    show Valued.v (a⁻¹ * x₀) ≤ WithZero.exp n
    rw [Valuation.map_mul, map_inv₀, ha, ← WithZero.exp_neg]
    calc WithZero.exp (-k) * Valued.v x₀ ≤ WithZero.exp (-k) * WithZero.exp (d040 (K := K) v + 1) :=
          mul_le_mul_right hx₀ _
      _ = WithZero.exp (-k + (d040 (K := K) v + 1)) := (WithZero.exp_add _ _).symm
      _ ≤ WithZero.exp n := WithZero.exp_le_exp.2 (by omega)
  have hau₀ : a * u₀ = x₀ := by
    rw [hu₀, mul_inv_cancel_left₀ ha0]
  rw [← integral_indicator (t0642 v n)]
  refine t0386 μ ((d067 v n).indicator fun x => StandardAddChar.psiLocal K v (a * x))
    (fun x => u₀ + x) (integral_add_left_eq_self _ u₀) (c := StandardAddChar.psiLocal K v x₀) (fun x => ?_) hne
  by_cases hx : x ∈ d067 v n
  · rw [Set.indicator_of_mem (t0637 v hu₀mem hx), Set.indicator_of_mem hx, mul_add, hau₀,
      AddChar.map_add_eq_mul]
  · have hx' : u₀ + x ∉ d067 v n := fun h => hx (t0638 v hu₀mem h)
    rw [Set.indicator_of_notMem hx', Set.indicator_of_notMem hx, mul_zero]

private theorem t0648 (a : v.adicCompletion K) :
    ∫ x in {x : v.adicCompletion K | Valued.v x = 1}, StandardAddChar.psiLocal K v (a * x) ∂μ =
      (∫ x in d067 v 0, StandardAddChar.psiLocal K v (a * x) ∂μ) -
        ∫ x in d067 v (-1), StandardAddChar.psiLocal K v (a * x) ∂μ := by
  have hunion := setIntegral_union (μ := μ) (f := fun x => StandardAddChar.psiLocal K v (a * x))
    (t0641 v) (t0642 v (-1))
    ((t0643 v μ a le_rfl).mono_set
      (t0640 v ▸ Set.subset_union_left))
    (t0643 v μ a (by norm_num))
  rw [← t0640] at hunion
  rw [hunion]
  ring

private theorem t0649 :
    μ.real {x : v.adicCompletion K | Valued.v x = 1} = μ.real (d067 v 0) - μ.real (d067 v (-1)) := by
  rw [t0640 v,
    measureReal_union (t0641 v) (t0642 v (-1)) (t0645 v μ)
      (t0644 v μ (by norm_num))]
  ring

private theorem t0650 {a : v.adicCompletion K} {k : ℤ} (ha : Valued.v a = WithZero.exp k) :
    ∫ x in {x : v.adicCompletion K | Valued.v x = 1}, StandardAddChar.psiLocal K v (a * x) ∂μ =
      if k ≤ d040 (K := K) v then ((μ.real {x : v.adicCompletion K | Valued.v x = 1} : ℝ) : ℂ)
      else if k = d040 (K := K) v + 1 then -((μ.real (d067 v (-1)) : ℝ) : ℂ) else 0 := by
  rw [t0648]
  by_cases hk : k ≤ d040 (K := K) v
  · rw [if_pos hk, t0646 v μ ha.le (by omega),
      t0646 v μ ha.le (by omega), t0649, Complex.ofReal_sub]
  · rw [if_neg hk]
    by_cases hk1 : k = d040 (K := K) v + 1
    · rw [if_pos hk1, t0647 v μ ha (by omega),
        t0646 v μ ha.le (by omega), zero_sub]
    · rw [if_neg hk1, t0647 v μ ha (by omega),
        t0647 v μ ha (by omega), sub_zero]

end Integrals
