namespace CappedPolicyIndependence

def demandPast (t : ℕ) (d : DemandPath) : Fin t → ℝ≥0 := fun i => d i

def demandFuture (t : ℕ) (d : DemandPath) : DemandPath := fun k => d (t + k)

def futureDemand (t : ℕ) (ω : Sample) : DemandPath := demandFuture t ω.1

lemma measurable_demandPast (t : ℕ) : Measurable (demandPast t) := by
  unfold demandPast
  fun_prop

lemma measurable_demandFuture (t : ℕ) : Measurable (demandFuture t) := by
  unfold demandFuture
  fun_prop

lemma measurable_futureDemand (t : ℕ) : Measurable (futureDemand t) :=
  (measurable_demandFuture t).comp measurable_fst

lemma map_demandFuture (P : DemandLaw) (t : ℕ) :
    (demandPathLaw P).map (demandFuture t) = demandPathLaw P := by
  exact Measure.map_infinitePi_infinitePi_of_inj
    (P := fun _ : ℕ => P.law) (f := fun k : ℕ => t + k) (by intro a b h; exact Nat.add_left_cancel h)

lemma indep_demandPast_demandFuture (P : DemandLaw) (t : ℕ) :
    IndepFun (demandPast t) (demandFuture t) (demandPathLaw P) := by
  let M : ℕ → MeasurableSpace DemandPath :=
    fun k => MeasurableSpace.comap (fun d : DemandPath => d k) inferInstance
  have hI : iIndep M (demandPathLaw P) := by
    exact (iIndepFun_iff_iIndep _ _ _).mp
      (iIndepFun_infinitePi (P := fun _ : ℕ => P.law)
        (X := fun _ (d : ℝ≥0) => d) (by fun_prop))
  have hInd := indep_iSup_of_disjoint
    (m := M) (μ := demandPathLaw P)
    (fun k => (measurable_pi_apply k).comap_le) hI
    (S := {k : ℕ | k < t}) (T := {k : ℕ | t ≤ k})
    (by exact Set.disjoint_left.mpr (by intro k hk1 hk2; exact Nat.not_lt_of_ge hk2 hk1))
  have hPast : @Measurable DemandPath (Fin t → ℝ≥0)
      (⨆ k ∈ {k : ℕ | k < t}, M k) inferInstance (demandPast t) := by
    rw [measurable_iff_comap_le, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    apply iSup_le
    intro i
    exact le_iSup_of_le i.val (le_iSup_of_le i.isLt (by rw [MeasurableSpace.comap_comp]; exact le_rfl))
  have hFuture : @Measurable DemandPath DemandPath
      (⨆ k ∈ {k : ℕ | t ≤ k}, M k) inferInstance (demandFuture t) := by
    rw [measurable_iff_comap_le, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    apply iSup_le
    intro k
    exact le_iSup_of_le (t + k) (le_iSup_of_le (Nat.le_add_right t k) (by rw [MeasurableSpace.comap_comp]; exact le_rfl))
  exact indep_of_indep_of_le hInd hPast.comap_le hFuture.comap_le

lemma map_demandPast_demandFuture (P : DemandLaw) (t : ℕ) :
    (demandPathLaw P).map (fun d => (demandPast t d, demandFuture t d)) =
      ((demandPathLaw P).map (demandPast t)).prod (demandPathLaw P) := by
  rw [(indep_demandPast_demandFuture P t).map_prod_eq_prod_map_map
    (measurable_demandPast t).aemeasurable (measurable_demandFuture t).aemeasurable,
    map_demandFuture]

lemma map_futureDemand (P : DemandLaw) (t : ℕ) :
    (sampleLaw P).map (futureDemand t) = demandPathLaw P := by
  change ((demandPathLaw P).prod seedLaw).map (demandFuture t ∘ Prod.fst) = _
  rw [← Measure.map_map (measurable_demandFuture t) measurable_fst,
    Measure.map_fst_prod, measure_univ, one_smul, map_demandFuture]

lemma map_history (P : DemandLaw) (t : ℕ) :
    (sampleLaw P).map (history t) =
      ((demandPathLaw P).map (demandPast t)).prod seedLaw := by
  change ((demandPathLaw P).prod seedLaw).map (Prod.map (demandPast t) id) = _
  rw [← Measure.map_prod_map _ _ (measurable_demandPast t) measurable_id, Measure.map_id]

lemma map_history_futureDemand (P : DemandLaw) (t : ℕ) :
    (sampleLaw P).map (fun ω => (history t ω, futureDemand t ω)) =
      ((sampleLaw P).map (history t)).prod (demandPathLaw P) := by
  let ν := (demandPathLaw P).map (demandPast t)
  have : IsProbabilityMeasure ν :=
    Measure.isProbabilityMeasure_map (measurable_demandPast t).aemeasurable
  have hpair : MeasurePreserving
      (fun d => (demandPast t d, demandFuture t d))
      (demandPathLaw P) (ν.prod (demandPathLaw P)) :=
    ⟨(measurable_demandPast t).prodMk (measurable_demandFuture t),
      map_demandPast_demandFuture P t⟩
  have hfirst := hpair.prod (MeasurePreserving.id seedLaw)
  have hsecond := measurePreserving_prodAssoc ν (demandPathLaw P) seedLaw
  have hthird := (MeasurePreserving.id ν).prod
    (Measure.measurePreserving_swap (μ := demandPathLaw P) (ν := seedLaw))
  have hfourth := MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc ν seedLaw (demandPathLaw P))
  have hfinal := hfourth.comp (hthird.comp (hsecond.comp hfirst))
  rw [map_history]
  exact hfinal.map_eq

lemma indep_history_futureDemand (P : DemandLaw) (t : ℕ) :
    IndepFun (history t) (futureDemand t) (sampleLaw P) := by
  apply (indepFun_iff_map_prod_eq_prod_map_map
    (measurable_history t).aemeasurable (measurable_futureDemand t).aemeasurable).mpr
  rw [map_futureDemand]
  exact map_history_futureDemand P t

lemma indep_policyWindowInput_futureDemand (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (t : ℕ) :
    IndepFun (policyWindowInput c π t) (futureDemand t) (sampleLaw P) := by
  have hψ : Measurable (fun a => policyWindowInput c π t (completeHistory t a)) :=
    (measurable_policyWindowInput c π t).comp (measurable_completeHistory t)
  have h := (indep_history_futureDemand P t).comp hψ measurable_id
  simpa only [Function.comp_def, id_eq, policyWindowInput_completeHistory] using h

lemma map_policyWindowInput_futureDemand (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (t : ℕ) :
    (sampleLaw P).map (fun ω => (policyWindowInput c π t ω, futureDemand t ω)) =
      ((sampleLaw P).map (policyWindowInput c π t)).prod (demandPathLaw P) := by
  rw [(indep_policyWindowInput_futureDemand P c π t).map_prod_eq_prod_map_map
    (measurable_policyWindowInput c π t).aemeasurable
    (measurable_futureDemand t).aemeasurable, map_futureDemand]

lemma lintegral_windowInventory_policyWindowInput (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (t m : ℕ) (hm : m ≤ c.L + 1) :
    (∫⁻ wd : WindowInput (c.L + 1) × DemandPath,
      (windowInventory wd.1 wd.2 m : ℝ≥0∞)
      ∂(((sampleLaw P).map (policyWindowInput c π t)).prod (demandPathLaw P))) =
      ∫⁻ ω, ((run c π ω (t + m)).1 : ℝ≥0∞) ∂sampleLaw P := by
  rw [← map_policyWindowInput_futureDemand P c π t]
  rw [lintegral_map (CappedWindowIntegrals.measurable_windowInventory (c.L + 1) m).coe_nnreal_ennreal
    ((measurable_policyWindowInput c π t).prodMk (measurable_futureDemand t))]
  apply lintegral_congr
  intro ω
  exact congrArg (fun x : ℝ≥0 => (x : ℝ≥0∞))
    (windowInventory_policyWindowInput c π ω t m hm)

end CappedPolicyIndependence
