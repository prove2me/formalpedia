-- Source module: Solutions.KFMMv
/-!
# KFM: counted moves and the conjugation pass

* **`mvNU Cn X Y`**: move `N` items (count on `Cn`) from `X` to `Y` (`mvNU_runs`: the moved block
  arrives reversed). Two of them move a block in order (`mv2_runs`).
* **`conjPU`**: `zs ↦ zs.map gconj` on stack `0` (`N` Gaussian items, counts `N` on `nX` and `2N`
  on `nX2`), as KFM's `itemPU` with a two-item body (`conjPU_runs`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Conjugation pass -/

theorem gflat_map_gconj_length (zs : List GI) : (gflat (zs.map gconj)).length = 2 * zs.length := by
  simp

theorem conjPU_runs_sol_aux (B : ℕ) (s : IState HS) (zs : List GI) (R0 : List Item)
    (h0 : s.G 0 = ints (gflat zs) ++ R0) (hB : GB B zs) (LX LX2 : List Item)
    (hX : s.G nX = .int (zs.length : ℤ) :: LX)
    (hX2 : s.G nX2 = .int ((2 * zs.length : ℕ) : ℤ) :: LX2) :
    IRuns I iprog conjPU s (s.upd 0 (ints (gflat (zs.map gconj)) ++ R0)) (cConj zs.length B) := by
  set N := zs.length with hN
  let T : ℕ → IState HS := fun k =>
    (s.upd 0 (ints (gflat (zs.drop k)) ++ R0)).upd pO
      (ints (gflat ((zs.take k).map gconj)).reverse ++ s.G pO)
  have h1 := rptX_runs (I := I) (iprog := iprog) (X := nX) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    N T (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    conjB (2 * (110 * (B + 1)) + 20)
    (by
      intro k hk LA LC LD
      have hd : zs.drop k = zs[k] :: zs.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      set z := zs[k]
      set rest := ints (gflat (zs.drop (k + 1))) ++ R0
      set st0 := cf3 (T k) pA pC pD LA LC LD
      have g0 : st0.G 0 = .int z.1 :: .int z.2 :: rest := by
        simp +decide only [st0, T, cf3, IState.upd_G, if_true, if_false]; rw [hd]; simp [rest, ints]
      have H1 := IRuns.mv (I := I) (iprog := iprog) (s := st0) (i := 0) (j := pO) (a := z.1)
        (L := .int z.2 :: rest) (by decide) g0
      set st1 := (st0.upd 0 (.int z.2 :: rest)).upd pO (.int z.1 :: st0.G pO)
      have H2 := IRuns.neg (I := I) (iprog := iprog) (s := st1) (i := 0) (a := z.2) (L := rest)
        (by simp +decide [st1])
      set st2 := st1.upd 0 (.int (-z.2) :: rest)
      have H3 := IRuns.mv (I := I) (iprog := iprog) (s := st2) (i := 0) (j := pO) (a := -z.2)
        (L := rest) (by decide) (by simp [st2])
      refine (H1.seq (H2.seq H3)).mono' ?_ ?_
      · have ht : (zs.take (k + 1)).map gconj = (zs.take k).map gconj ++ [gconj z] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]
          simp only [Option.toList_some, List.map_append, List.map_cons, List.map_nil, z]
        have e2 : ints (gflat ((zs.take (k + 1)).map gconj)).reverse =
            .int (-z.2) :: .int z.1 :: ints (gflat ((zs.take k).map gconj)).reverse := by
          rw [ht, gflat_append]; simp [ints, gconj]
        simp only [st2, st1, st0, T, cf3, e2]
        clear H1 H2 H3 e2 ht g0
        ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
        all_goals rfl
      · have := moveIntCost_le (zsz z.1); have := moveIntCost_le (zsz (-z.2))
        rw [zsz_neg] at *; omega)
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.map_nil, gflat_nil, List.reverse_nil]
    rw [← h0]; simp [ints]
  have h1 := h1 LX (by rw [e0]; exact hX)
  have e1 : T N = (s.upd 0 R0).upd pO (ints (gflat (zs.map gconj)).reverse ++ s.G pO) := by
    simp only [T, hN, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at h1
  have hB' : ∀ x ∈ (gflat (zs.map gconj)).reverse, zsz x ≤ B := by
    intro x hx
    obtain ⟨z, hz, h | h⟩ := mem_gflat.1 (List.mem_reverse.1 hx)
    · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hz
      subst h; exact (hB y hy).1
    · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hz
      subst h; simp only [gconj, zsz_neg]; exact (hB y hy).2
  have h2 := mvBackU_runs (I := I) (iprog := iprog) nX2 (by decide) (by decide) (by decide)
    (by decide) (by decide) LX2 (gflat (zs.map gconj)).reverse B hB'
    ((s.upd 0 R0).upd pO (ints (gflat (zs.map gconj)).reverse ++ s.G pO)) (s.G pO) (by simp)
    (by simp +decide [hX2] <;> exact hN)
  rw [List.length_reverse, gflat_map_gconj_length, List.reverse_reverse, ← hN] at h2
  refine (h1.seq h2).mono' ?_ (by unfold cConj; omega)
  simp only [IState.upd_G]
  ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))

end NLogN.KFM

